---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParkStrip from '../../components/ParkStrip.astro';
import Sources from '../../components/Sources.astro';
import { parkModels } from '../../data/parkModels';

// Волна 23. Новая ось сайта — «Парк техники». До этой волны сайт объяснял
// НОРМЫ и ЭТАПЫ монтажа, но нигде не называл конкретную машину: ни одна из
// 19 страниц не содержала модели крана. Раздел закрывает этот разрыв двумя
// реальными моделями (не выдуманным «модельным рядом») и честно объясняет
// место автокрана в том же проекте — он упомянут как вторая услуга сайта
// с самого начала, но до сих пор не имел собственной страницы про технику.
//
// Волна 24. Третья модель — КБ-674А, приставной кран. Не третий вариант той
// же схемы (свободностоящий кран на пути/фундаменте), а качественно другой
// случай: высота, которую не дают первые две модели, набирается креплением
// к самому зданию. Текст ниже пересобран с «двух моделей» на «три случая».
//
// Волна 51. Четвёртая модель — giraFFe SMK-5.66, быстромонтируемый кран без
// фундамента и без пути. Четвёртый качественно иной случай: не выше/тяжелее/
// приставной, а «вообще без основания» — опорный контур на площадке и монтаж
// за 4–6 часов. Текст пересобран с «трёх случаев» на «четыре».
//
// Волна 69. Пятая модель — Potain MCH 175, маховый (луффинговый) кран.
// Пятый качественно иной случай: не высота и не основание, а геометрия
// стрелы — переменный вылет вместо постоянного, ответ на «зоны ограничения»
// с этапа «Проект и ППР». Текст пересобран с «четырёх случаев» на «пять».

const title = 'Парк техники: башенный кран и автокран на Кубани';
const description =
  'Пять моделей башенного крана в парке: топлесс, рельсовый, приставной, быстромонтируемый и маховый — с характеристиками каждой модели.';

const SITE = 'https://kran-kuban.ru';
const CHECKED = '15 августа 2026 года';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: `${SITE}/park/` },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Модели башенного крана в парке техники',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: parkModels.length,
  itemListElement: parkModels.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: SITE + m.href })),
};
---
<BaseLayout title={title} description={description} path="/park/" ldExtra={[breadcrumbLd, itemListLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Парк техники</span>
  </nav>

  {/* Волна мобильной полировки. Порядок раздела был: крошки → указатель
      моделей → атмосферное фото 2:3 → и только потом заголовок с лидом.
      На кадре 375×812 это значило, что h1 стоял в 944 px от верха — второй
      экран телефона, — а первый экран занимали шесть имён моделей и небо.
      Заголовок поднят над указателем: сначала «что это за раздел», потом
      «какие в нём машины», потом атмосфера. */}
  <header class="dossier wrap" style="padding-block:clamp(18px,3vw,28px) 0">
    <span class="eyebrow">Раздел</span>
    {/* Неразрывный пробел перед тире — не украшение: на кадре 375 px тире
        начинало третью строку заголовка («башенный кран / — и где в нём»),
        а тире, открывающее строку, в русском наборе читается как знак списка.
        Привязка к предыдущему слову оставляет его на конце второй строки.
        Слова не тронуты. */}
    <h1>Парк техники: башенный кран&nbsp;— и где в нём место автокрана</h1>
    {/* Хвост «от рельсового КБ-408.21 до махового Potain MCH 175» — не
        украшение: без него в лиде не остаётся ни одного числа (перечень пяти
        моделей ушёл в список ниже), и проверка geo-answer-first справедливо
        загорается — лид перестаёт отвечать сам по себе. Обе модели и их типы
        взяты из того же перечня, ни одного нового факта. */}
    <p class="dossier__lead">
      Ниже — не рекламный каталог, а разбор пяти моделей башенного крана, которые чаще всего
      закрывают запросы по краю: от рельсового КБ-408.21 до махового Potain MCH 175.
    </p>
    {/* Ставка — те же две цифры, что в смете на главной. На странице
        «что арендуем» цены не было вовсе: ни одного знака ₽ на 8 183 px
        высоты. Разметка и оговорка — общий компонентный словарь досье. */}
    <div class="dossier__rate">
      <dl class="dossier__rate-rows">
        <div>
          <dt>Башенный кран</dt>
          <dd><b>от 240 000 ₽</b> <span>в месяц</span></dd>
        </div>
        <div>
          <dt>Автокран</dt>
          <dd><b>от 4 000 ₽</b> <span>в час, смена 8 часов</span></dd>
        </div>
      </dl>
      <p class="dossier__rate-note">
        Ориентир «от» с <time datetime="2026-08-12">12 августа 2026 года</time>, не публичная оферта:
        точная цифра зависит от модели, вылета, высоты подъёма и площадки.
        <a href="/#smeta">Собрать смету владения <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </header>

  <div class="wrap"><ParkStrip /></div>

  {/* Продолжение лида: перечень пяти моделей стоял внутри лида и давал на
      375 px абзац в 22 строки — заголовок раздела при этом уезжал на 944 px.
      Ни одно слово не выброшено и не переписано: перечисление через запятую
      раскрыто в перечень (тот же приём, что на /documents/), а фраза про
      автокран осталась абзацем. Стоит перечень сразу под указателем моделей —
      там, где те же пять имён уже висят ссылками. */}
  <div class="wrap">
    {/* Первая фраза лида — про сайт, а не про технику, и в первом экране она
        стоила две строки. Перенесена сюда, где работает как подводка к самому
        перечню машин: указатель имён выше, перечень с разбором ниже. */}
    <p class="park-lead-rest">Сайт про этапы и нормы до сих пор ни разу не называл машину по имени.</p>
    <ol class="doc-chain park-cases">
      <li>безоголовочный <a href="/park/potain-mdt-219-j10/">Potain MDT 219 J10</a> — для стеснённой площадки</li>
      <li>рельсовый <a href="/park/kb-408-21/">КБ-408.21</a> российского производства — для набора высоты по секциям</li>
      <li>приставной <a href="/park/kb-674a/">КБ-674А</a> — для объектов выше того, что дают первые два</li>
      <li>быстромонтируемый <a href="/park/giraffe-smk-5-66/">giraFFe SMK-5.66</a> — для короткого объекта без места под путь или фундамент</li>
      <li>маховый <a href="/park/potain-mch-175/">Potain MCH 175</a> — единственная модель с переменным вылетом стрелы</li>
    </ol>
    <p class="park-lead-rest">
      Автокран здесь тоже участвует — но не как альтернатива башенному, а как соседняя машина внутри
      того же монтажа.
    </p>
  </div>

  <figure class="park-atmo wrap">
    {/* WebP рядом с оригиналом: <source> отдаёт .webp тем, кто его понимает,
           остальным достаётся прежний JPEG из <img>. width/height/alt остаются
           на <img> — иначе браузер потеряет соотношение сторон (CLS) и подпись
           для скринридера. Файлы .webp собирает scripts/to-webp.mjs. */}
    <picture>
      <source type="image/webp" srcset="/images/hero/park-hero.webp" />
      <img
        src="/images/hero/park-hero.jpg"
        width="1920"
        height="2880"
        loading="lazy"
        decoding="async"
        alt="Стрелы нескольких башенных кранов на фоне ясного неба — атмосферное фото, не съёмка объекта в Краснодарском крае и не техника нашего парка"
      />
    </picture>
    <figcaption>Атмосферное фото раздела (не съёмка нашей площадки и не единица нашего парка). Автор: Abdulvahap Demir, <a href="https://www.pexels.com/license/" target="_blank" rel="noopener">Pexels License</a>, <a href="https://www.pexels.com/photo/17297091/" target="_blank" rel="noopener">Pexels</a>.</figcaption>
  </figure>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Пять моделей — не «весь парк», а пять разных ответов</h2>
    <p>
      Пять машин решают пять разных задач, а не варианты одной. Топлесс-кран без оголовка ставят
      там, где рядом работает ещё один кран или где вылет стрелы важнее высоты; рельсовый кран с
      классической схемой наращивания секций — там, где нужен подъём выше, а площадка допускает
      крановый путь нужной длины; приставной кран — там, где объект уже выше того, что могут дать
      первые два свободностоящих крана, и высоту берут не у грунта под путём или фундаментом, а у
      самой растущей конструкции здания; быстромонтируемый кран — там, где ни путь, ни фундамент, ни
      анкеровка не оправданы сроком стройки, и решает не высота, а скорость постановки крана на площадку;
      маховый кран — там, где сама геометрия участка не позволяет стреле проходить над соседней
      территорией, и решает не высоту и не скорость, а форму рабочей зоны.
    </p>
    {/* Волна мобильного взгляда. Пять колонок в экран 375 px не помещаются
        никакой вёрсткой: на кадре была видна строка «10 т максиму|», а вылет
        и высота подъёма не попадали в кадр вовсе — при том что горизонтальной
        прокрутки страницы линтер честно не показывал (она локальная, внутри
        .rule-table-wrap, и наложенной полосы на телефоне не видно).
        Поэтому на телефоне таблица становится СТОПКОЙ ЗАПИСЕЙ: имя модели —
        заголовок записи, четыре характеристики — пары «рубрика → значение».
        Это не новая идиома, а та же, что у .factline и .dossier__meta, где
        колонка dt/dd на 640 px превращается в одну колонку.
        role="table|row|rowheader|cell" стоят не для красоты: display:block
        снимает у табличных элементов их неявные роли, и без явных ролей
        стопка перестала бы быть таблицей для скринридера. С ними структура
        сохраняется на обеих ширинах. data-label — источник подписи в ячейке
        (::before), подписи дословно повторяют шапку таблицы. */}
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Сравнение пяти моделей башенного крана парка</caption>
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader">Модель</th>
            <th scope="col" role="columnheader">Тип</th>
            <th scope="col" role="columnheader">Г/п максимум</th>
            <th scope="col" role="columnheader">Вылет</th>
            <th scope="col" role="columnheader">Высота подъёма</th>
          </tr>
        </thead>
        <tbody>
          {parkModels.map((m) => (
            <tr role="row">
              <th scope="row" role="rowheader"><a href={m.href} style="color:var(--accent);font-weight:700">{m.short}</a></th>
              <td role="cell" data-label="Тип">{m.type}</td>
              <td role="cell" data-label="Г/п максимум">{m.capacity.split('·')[0].trim()}</td>
              <td role="cell" data-label="Вылет">{m.reach}</td>
              <td role="cell" data-label="Высота подъёма">{m.hookHeight}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Разница в вылете — 65 м у топлесс-крана против 40 м у рельсового — не случайна: у первой модели
      это способ дотянуться до дальнего угла площадки без переезда, у второй высота набирается не
      вылетом, а секциями мачты. Какая логика подходит конкретному объекту, решается на этапе
      <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">«Проект и ППР»</a>, а не по каталогу.
    </p>
    <p style="margin-top:20px">
      Третья модель, КБ-674А, не конкурирует с первыми двумя ни по вылету, ни по логике набора высоты
      секциями — у неё другой потолок и другой способ его пробить. Обе свободностоящие модели упираются
      в высоту подъёма около 70 м под крюком; выше этой отметки задачу решает не более длинный путь и не
      больший фундамент, а крепление башни к самому строящемуся зданию — разбор нагрузки на конструкции
      и когда это единственный вариант — на странице
      <a href="/park/kb-674a/" style="color:var(--accent)">«КБ-674А»</a>.
    </p>
    <p style="margin-top:20px">
      Четвёртая модель, giraFFe SMK-5.66, решает не вопрос высоты, а вопрос основания: единственная в
      парке машина, которой не нужен ни путь, ни фундамент, ни анкеровка к зданию — только собственный
      опорный контур 4×4 м и 4–6 часов на монтаж. Она не заменяет первые три модели на высоких объектах,
      а закрывает случай короткого объекта на стеснённой площадке, для которого месячный цикл монтажа
      тяжёлого крана экономически не оправдан — разбор на странице
      <a href="/park/giraffe-smk-5-66/" style="color:var(--accent)">«giraFFe SMK-5.66»</a>.
    </p>
    <p style="margin-top:20px">
      Пятая модель, Potain MCH 175, не решает вопрос высоты, скорости монтажа или основания — у неё тот
      же путь или фундамент, что у топлесс-крана, и близкая грузоподъёмность. Она решает вопрос формы
      рабочей зоны: стрела маховая, наклоняется гидравликой, и вылет сокращается вплоть до нескольких
      метров от мачты. Там, где горизонтальная стрела постоянного вылета прошла бы над соседним
      участком или чужим зданием, MCH 175 туда физически не заходит — разбор на странице
      <a href="/park/potain-mch-175/" style="color:var(--accent)">«Potain MCH 175»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Где в этом парке место автокрана</h2>
    <p>
      Автокран — вторая услуга сайта, и в парке техники у него две самостоятельные роли, а не одна.
      Первая: он приезжает на смену и уезжает — без монтажа, без кранового пути, без месячной ставки.
      Эта роль решает вопрос там, где высотный регламент площадки ограничивает застройку и делает
      башенный кран избыточным — например, в историческом центре Краснодара, разобранном на том же
      этапе <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">«Проект и ППР»</a>. Вторая роль —
      служебная: секции мачты, стрелу и противовес любого башенного крана из парка поднимает не он сам,
      а автокран, выходящий на площадку при монтаже и демонтаже. Обе роли и приёмка после сборки
      разобраны на этапе <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Что мы уточняем, прежде чем предложить конкретную модель</h2>
    <dl class="factline" style="max-width:none">
      <div>
        <dt>Высоту объекта и дальнюю точку подачи груза</dt>
        <dd>Разводят топлесс-схему (вылет) и рельсовую (набор секциями) — цифры из таблицы выше редко решают сами по себе, без границ конкретной площадки.</dd>
      </div>
      <div>
        <dt>Тип и несущую способность основания</dt>
        <dd>Рельсовый путь требует длины и подготовленного земляного полотна; фундамент под топлесс-кран — своего расчёта; у giraFFe SMK-5.66 достаточно точечной проверки под опорным контуром 4×4 м. Разбор — на этапе <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>.</dd>
      </div>
      <div>
        <dt>Расчётную сейсмичность площадки</dt>
        <dd>Все пять моделей технически рассчитываются под сейсмическую нагрузку — это вопрос проекта монтажа, а не паспорта конкретного крана. Подробнее — в разделе <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны края»</a>.</dd>
      </div>
      <div>
        <dt>Возможность анкеровки к конструкциям здания</dt>
        <dd>Только приставной КБ-674А берёт часть нагрузки не от грунта, а от самого объекта — расчёт, которого нет у остальных моделей. Разбор — на странице <a href="/park/kb-674a/" style="color:var(--accent)">«КБ-674А»</a>.</dd>
      </div>
      <div>
        <dt>Границы участка и соседние объекты</dt>
        <dd>Только маховая стрела Potain MCH 175 умеет сокращать вылет и не проходить над чужой территорией — у остальных моделей вылет постоянен. Разбор — на странице <a href="/park/potain-mch-175/" style="color:var(--accent)">«Potain MCH 175»</a>.</dd>
      </div>
    </dl>

    <p class="honest" style="margin-top:28px">
      Пять моделей здесь — не полный перечень возможной техники, а пять случаев, которые закрывают
      большинство запросов по краю. Под нестандартную задачу подбираем технику отдельно и не
      ограничиваем себя этими марками; выдуманный «модельный ряд на 20 позиций» на сайте
      молодого проекта был бы неправдой, поэтому его здесь нет. Что именно это означает для
      гусеничного крана, манипулятора, автовышки, экскаватора, самосвала и трала для негабаритного
      груза — на странице
      <a href="/partnerskaya-set/" style="color:var(--accent)">«Кроме башенного крана: остальная техника через партнёрскую сеть»</a>.
    </p>

    <Sources
      checked={CHECKED}
      seeAlso={parkModels.map((m) => ({ href: m.href, label: m.short }))}
      note="Общая норма сейсмостойкого исполнения грузоподъёмной техники — на страницах всех пяти моделей. Фото модели (не единица нашего парка, честная атрибуция Wikimedia Commons) есть на страницах КБ-408.21, КБ-674А и Potain MDT 219 J10 — 3 из 5; для giraFFe SMK-5.66 и Potain MCH 175 свободно лицензированного фото на Commons не нашлось, подставлять фото другой модели мы не стали."
