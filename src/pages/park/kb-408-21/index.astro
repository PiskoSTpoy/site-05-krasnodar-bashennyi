---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParkStrip from '../../../components/ParkStrip.astro';
import Sources from '../../../components/Sources.astro';

const title = 'КБ-408.21 — рельсовый башенный кран в парке техники';
const description =
  'КБ-408.21: грузоподъёмность 10 т, вылет 40 м, высота подъёма до 72,7 м, база 7,5×7,5 м, противовес 45 т. Монтаж на рельсовый путь, требования к основанию.';

const SITE = 'https://kran-kuban.ru';
const CHECKED = '17 августа 2026 года';

const specs = [
  { p: 'Максимальная грузоподъёмность', v: '10 т' },
  { p: 'Максимальный вылет стрелы', v: '40 м' },
  { p: 'Высота подъёма крюка', v: '54,0–72,7 м в зависимости от исполнения' },
  { p: 'База / колея пути', v: '7,5 × 7,5 м' },
  { p: 'Масса крана', v: '63,5 т' },
  { p: 'Противовес', v: '45 т, десять железобетонных блоков' },
  { p: 'Прибор безопасности', v: '4-го поколения, с координатной защитой' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: `${SITE}/park/` },
    { '@type': 'ListItem', position: 3, name: 'КБ-408.21', item: `${SITE}/park/kb-408-21/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/park/kb-408-21/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/park/">Парк техники</a><span aria-hidden="true">/</span><span aria-current="page">КБ-408.21</span>
  </nav>

  <div class="wrap"><ParkStrip current="kb-408-21" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Парк техники · рельсовый ход</span>
    <h1>КБ-408.21: рельсовый кран для набора высоты по секциям</h1>
    <p class="dossier__lead">
      Там, где топлесс-кран решает вопрос соседства вылетом, КБ-408.21 решает вопрос высоты классической
      схемой: мачта наращивается секциями, кран стоит на рельсовом пути весь срок стройки, а запас по
      подъёму крюка — до 72,7 м — рассчитан на объект, растущий месяцами, а не на разовый выезд.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <figure class="model-photo">
      {/* WebP рядом с оригиналом: <source> отдаёт .webp тем, кто его понимает,
           остальным достаётся прежний JPEG из <img>. width/height/alt остаются
           на <img> — иначе браузер потеряет соотношение сторон (CLS) и подпись
           для скринридера. Файлы .webp собирает scripts/to-webp.mjs. */}
      <picture>
        <source type="image/webp" srcset="/images/park/kb-408-21.webp" />
        <img
          src="/images/park/kb-408-21.jpg"
          width="1280"
          height="1707"
          loading="lazy"
          decoding="async"
          alt="Башенный кран КБ-408.21 с оголовком на монтаже жилого дома в Новосибирске — фото модели, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции). Новосибирск, 2010. Автор: Centurion198, лицензия <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener">CC BY 3.0</a>, <a href="https://commons.wikimedia.org/wiki/File:%D0%9A%D0%91-408-21.JPG" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <h2 style="margin-bottom:18px">Что за машина</h2>
    <p>
      КБ-408.21 — модификация серии КБ-408 российского краностроения, кран с оголовком и классической
      схемой наращивания мачты секциями, на наземном рельсовом ходу. В отличие от безоголовочных моделей
      вроде Potain MDT 219 J10, вылет стрелы у неё скромнее — 40 м против 65 м, — зато высота подъёма
      крюка растёт вместе с числом смонтированных секций мачты, а не упирается в паспортный лимит одной
      конфигурации. Поворотная платформа несёт противовес из десяти железобетонных блоков общей массой
      45 тонн — при собственной массе крана 63,5 тонны это больше трети веса конструкции, приходящейся
      на балансировку груза и стрелы.
    </p>

    <h2 style="margin:36px 0 18px">Характеристики</h2>
    <div class="rule-table-wrap">
      <table class="rule-table">
        <caption class="sr-only">Технические характеристики КБ-408.21</caption>
        <thead><tr><th scope="col">Параметр</th><th scope="col">Значение</th></tr></thead>
        <tbody>
          {specs.map((s) => (<tr><th scope="row">{s.p}</th><td>{s.v}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2 style="margin:36px 0 18px">Рыночная цена аренды</h2>
    <p>
      Эта модель встречается в открытых прайсах чаще двух других моделей парка — цена не всегда
      «по запросу». В Сочи, ближайшем к базе городе края, объявление на КБ-408.21-02 с оголовком под
      монтаж стеновых панелей стоит 280 000 ₽/мес; в Москве та же модель сдаётся за 290 000 ₽/мес, а
      при почасовой форме аренды — от 900 ₽/час. Для крана этого класса — 10 т, 40 м вылета, рельсовый
      ход — 280 000–290 000 ₽/мес по краю ближе к реальности, чем витринное «от», которое компании
      обычно указывают для самой лёгкой комплектации. Точную цифру под свою площадку и срок удобно
      прикинуть в <a href="/#smeta" style="color:var(--accent)">смете владения</a> на главной.
    </p>

    <h2 style="margin:36px 0 18px">Рельсовый ход: путь — отдельный документ, не аксессуар</h2>
    <p>
      База и колея пути у КБ-408.21 совпадают — 7,5 × 7,5 м, — и это не случайное число, а размер,
      который целиком укладывается в норму СП 12-103-2002 «Пути наземные рельсовые крановые»: свод
      правил допускает нагрузку колеса на рельс до 325 кН, а конкретную геометрию для 63,5-тонного
      крана с 45-тонным противовесом считает проектировщик под каждую площадку отдельно. С 1 января
      2026 года технические требования к самому пути задаёт ГОСТ 35321-2025, а готовый путь принимается
      в эксплуатацию актом сдачи-приёмки по рекомендуемой форме РД 22-28-35-99 — до подписания этого
      акта кран по пути не ездит, независимо от того, насколько плотным выглядит балласт. Полный разбор
      процедуры приёмки — на этапе <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Основание под путь начинается с изысканий</h2>
    <p>
      Рельсовый путь длиной в несколько десятков метров ложится на подготовленное земляное полотно, и
      его несущая способность — вопрос не крана, а грунта под ним. На рыхлом прибрежном песке или
      мягких глинистых грунтах III категории балластную призму и шпальную решётку готовят иначе, чем на
      плотном основании II категории — и выясняется это на этапе
      <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>, до того,
      как путь и кран приедут на площадку, а не после первой осадки одной из ниток рельса.
    </p>

    <h2 style="margin:36px 0 18px">Масса и база в сейсмическом расчёте</h2>
    <p>
      63,5 тонны собственной массы плюс 45 тонн противовеса — это не только вопрос устойчивости от
      ветра. На площадке с расчётной сейсмичностью 7–9 баллов та же масса участвует в расчёте
      горизонтальной нагрузки на путь и его основание: чем тяжелее конструкция наверху, тем больше
      сила при том же пиковом ускорении. Прибор безопасности 4-го поколения с координатной защитой
      контролирует рабочую зону крана, но за расчёт основания под сейсмическую нагрузку отвечает не
      электроника крана, а проект монтажа конкретной площадки — общий принцип для любой модели, разбор
      цифр по баллам в разделе <a href="/seysmozony/8-ballov/" style="color:var(--accent)">«Площадка 8 баллов»</a>
      — самой частой расчётной сейсмичности прибрежной части края.
    </p>

    <h2 style="margin:36px 0 18px">Когда эта модель — не лучший выбор</h2>
    <dl class="factline" style="max-width:none">
      <div>
        <dt>Площадка без места под путь нужной длины</dt>
        <dd>7,5-метровая колея плюс концевые упоры требуют пространства, которого может не быть в стеснённой застройке — тогда логичнее топлесс-схема на фундаменте.</dd>
      </div>
      <div>
        <dt>Нужен вылет больше 40 м без переезда крана</dt>
        <dd>Здесь решает не высота подъёма, а дальность — сравнение со второй моделью парка в разделе <a href="/park/" style="color:var(--accent)">«Парк техники»</a>.</dd>
      </div>
      <div>
        <dt>Высота застройки ограничена регламентом</dt>
        <dd>Там, где градостроительный регламент не даёт использовать башенный кран вовсе, решает автокран — граница разобрана на этапе <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">«Проект и ППР»</a>.</dd>
      </div>
      <div>
        <dt>Нужна высота за пределами 72,7 м</dt>
        <dd>Секциями мачты этот потолок не пробить — дальше высоту берут не у пути, а у самого здания. Третья модель парка — <a href="/park/kb-674a/" style="color:var(--accent)">приставной КБ-674А</a>.</dd>
      </div>
    </dl>

    <p style="margin-top:26px">
      Другие модели парка: <a href="/park/potain-mdt-219-j10/" style="color:var(--accent)">Potain MDT 219 J10 — топлесс-кран для стеснённой площадки</a>
      и <a href="/park/kb-674a/" style="color:var(--accent)">КБ-674А — приставной кран для высотных объектов</a>.
    </p>

    <Sources checked={CHECKED} items={[
      { href: 'https://exkavator.ru/excapedia/technic/kranovie_tehnologii_kb-40821-02', label: 'exkavator.ru — КБ-408.21: технические характеристики и обзор' },
      { href: 'https://www.kranauto.ru/public/specs/460_KB_408.21.PDF', label: 'kranauto.ru — паспортные характеристики КБ-408.21 (PDF)' },
      // Единственная ссылка сайта, оставленная по http://. Не забывчивость:
      // у krantrek.ru на https самоподписанный сертификат — браузер покажет
      // полноэкранное предупреждение об угрозе вместо страницы. Http-ссылка
      // на внешний источник (не подгружаемый ресурс) безопаснее для читателя,
      // чем ссылка, которая гарантированно упирается в экран об ошибке.
      { href: 'http://krantrek.ru/catalog/bashenyi-kran-kb/bashenyi-kran-kb408', label: 'krantrek.ru — серия башенных кранов КБ-408, модификации' },
      { href: 'https://files.stroyinf.ru/Data1/11/11357/index.htm', label: 'files.stroyinf.ru — СП 12-103-2002: нагрузка колеса на рельс до 325 кН' },
      { href: 'https://www.kran-mash.ru/poleznoe/13-sejsmostojkoe-ispolnenie-kranov', label: 'kran-mash.ru — сейсмостойкое исполнение кранов для районов свыше 6 баллов' },
      { href: 'https://perevozka24.com/sochi-23/arenda-stroitelnogo-oborudovaniya-bashennye-krany', label: 'perevozka24.com — аренда КБ-408.21-02 в Сочи, 280 000 ₽/мес' },
      { href: 'https://gpm-service.su/crane-rental/arenda-kb-408-21', label: 'gpm-service.su — аренда КБ-408.21, от 900 ₽/час' },
      { href: 'https://arendaspectehniki-msk.ru/arenda-bashennogo-krana/kb-408-21', label: 'arendaspectehniki-msk.ru — аренда КБ-408.21 в Москве, 290 000 ₽/мес' },
    ]} />

    <p style="margin-top:26px"><a class="btn" href="/#order">Прислать параметры площадки <span aria-hidden="true">→</span></a></p>
  </section>
</main>
</BaseLayout>
