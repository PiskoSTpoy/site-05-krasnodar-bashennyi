---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParkStrip from '../../../components/ParkStrip.astro';
import Sources from '../../../components/Sources.astro';

// Волна 24. Третья модель парка — и качественно иной случай, а не третий
// вариант той же схемы. Первые две модели (Волна 23) свободностоящие: высоту
// им даёт либо вылет (Potain), либо секции мачты на рельсовом пути (КБ-408.21).
// Обе упираются в потолок около 70 м под крюком. КБ-674А решает случай выше
// этого потолка — не увеличением фундамента или пути, а креплением башни к
// самому зданию. Тема упирается прямо в закреплённый за этим сайтом дифференциатор
// (ТСН 22-302-2000, анкеровка) новым углом: нагрузку от анкерной опоры несёт
// не грунт, а конструкция здания — расчёт, которого не было ни у одной из
// первых двух моделей.

const title = 'КБ-674А — приставной башенный кран для высотных объектов';
const description =
  'КБ-674А: 12,5 т, вылет 50,5 м, высота до 60 м своб. и до 116–120 м приставным способом — крепится к зданию, а не к пути или фундаменту.';

const SITE = 'https://kran-kuban.ru';
const CHECKED = '17 августа 2026 года';

const specs = [
  { p: 'Максимальная грузоподъёмность', v: '12,5 т (на вылете до 24 м)' },
  { p: 'Грузоподъёмность на максимальном вылете', v: '5,6 т на 50,5 м' },
  { p: 'Вылет стрелы', v: '3,5–50,5 м' },
  { p: 'Высота подъёма, свободностоящим', v: 'до 60 м' },
  { p: 'Высота подъёма, приставным способом', v: '116–120 м в зависимости от числа настенных опор и исполнения' },
  { p: 'Максимальная нагрузка на настенную опору', v: '37,8 т' },
  { p: 'Масса крана', v: '135 т конструктивная / 148 т общая' },
  { p: 'Противовес', v: '12,6 т' },
  { p: 'Скорость подъёма груза', v: 'до 35 м/мин под максимальным грузом, до 100 м/мин на крюке без груза' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: `${SITE}/park/` },
    { '@type': 'ListItem', position: 3, name: 'КБ-674А', item: `${SITE}/park/kb-674a/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/park/kb-674a/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/park/">Парк техники</a><span aria-hidden="true">/</span><span aria-current="page">КБ-674А</span>
  </nav>

  <div class="wrap"><ParkStrip current="kb-674a" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Парк техники · приставной кран</span>
    <h1>КБ-674А: высота, которую не даёт ни один свободностоящий кран парка</h1>
    <p class="dossier__lead">
      У Potain MDT 219 J10 и КБ-408.21 — двух свободностоящих моделей парка — есть общий потолок:
      обе упираются в высоту подъёма около 70 м под крюком, дальше их не пускает либо паспорт, либо
      устойчивость собственного фундамента. КБ-674А решает задачу за этим потолком не увеличением
      фундамента или рельсового пути, а креплением башни к самому строящемуся зданию — приставным
      способом, при котором нагрузку держит не грунт, а конструкция объекта.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <figure class="model-photo">
      {/* WebP рядом с оригиналом: <source> отдаёт .webp тем, кто его понимает,
           остальным достаётся прежний JPEG из <img>. width/height/alt остаются
           на <img> — иначе браузер потеряет соотношение сторон (CLS) и подпись
           для скринридера. Файлы .webp собирает scripts/to-webp.mjs. */}
      <picture>
        <source type="image/webp" srcset="/images/park/kb-674a.webp" />
        <img
          src="/images/park/kb-674a.jpg"
          width="1280"
          height="960"
          loading="lazy"
          decoding="async"
          alt="Приставной башенный кран КБ-674а, закреплённый к строящемуся жилому дому в Новосибирске — фото модели того же семейства, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой серии крана — модификация КБ-674а грузоподъёмностью 25 т по описанию автора (наша модель КБ-674А — 12,5 т; тот же принцип приставного крепления к зданию, честно указываем разницу класса; не единица нашего парка, иллюстрация конструкции). Новосибирск, июнь 2010. Автор: Sskz, лицензия <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener">CC BY-SA 3.0</a>, <a href="https://commons.wikimedia.org/wiki/File:KB-674a_-_on_building_(crane_25t).JPG" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <h2 style="margin-bottom:18px">Что за машина</h2>
    <p>
      КБ-674А — модификация серии КБ-674/675/676 российского и советского краностроения, спроектированной
      на Никопольском краностроительном заводе в конце 1960-х годов; серийный выпуск модификации 674А-13
      начался в 1984 году. Конструктивно это верхнеповоротный кран с наращиваемой неповоротной башней и
      балочной стрелой — тот же принцип секционного набора высоты, что и у КБ-408.21 в этом же парке, но
      с ключевым отличием: помимо рельсового хода серия допускает стационарную установку на фундамент с
      креплением башни к стенам возводимого сооружения. Эта конфигурация в семье моделей выделена под
      индекс КБ-676 — кран без ходовой части, рассчитанный целиком на приставной монтаж.
    </p>
    <p>
      Управляющая кабина смонтирована на поворотной платформе в верхней части башни — оператор поднимается
      вместе с рабочим органом, а не остаётся у основания, как на кранах с неподвижной низкорасположенной
      кабиной. Это решение типично для всей линейки высотных приставных кранов независимо от бренда: чем
      выше кран, тем важнее обзор с верхней точки, а не только паспортная грузоподъёмность.
    </p>

    <h2 style="margin:36px 0 18px">Характеристики</h2>
    <div class="rule-table-wrap">
      <table class="rule-table">
        <caption class="sr-only">Технические характеристики КБ-674А</caption>
        <thead><tr><th scope="col">Параметр</th><th scope="col">Значение</th></tr></thead>
        <tbody>
          {specs.map((s) => (<tr><th scope="row">{s.p}</th><td>{s.v}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Разброс по массе и высоте между источниками (135–148 т конструктивной массы у одних дилерских
      паспортов, до 245,5 т общей массы у других; 116–120 м высоты приставным способом) объясняется тем
      же, чем и у КБ-408.21 — семейство существует в нескольких исполнениях с разным числом секций мачты
      и комплектацией противовеса, и конкретная цифра зависит от исполнения, а не от паспорта производителя
      в целом.
    </p>

    <h2 style="margin:36px 0 18px">Рыночная цена аренды</h2>
    <p>
      Приставные краны реже других называют цену открыто: у профильных арендодателей КБ-674 стоит
      «по запросу» и на час, и на смену — открытую цифру для этой конкретной модели в крае не
      публикует никто. Ориентир приходится брать по классу грузоподъёмности: 12-тонные Potain MD 265B
      и MC 310 K12 сдаются от 700 000–750 000 ₽/мес на московском рынке, а сама приставная схема
      технически рассчитана на высоту крепления к зданию до 183 м у ближайших аналогов на рынке — чем
      больше настенных опор требуется на такой высоте, тем заметнее итоговая ставка отрывается от
      цифры «за голый кран». Разброс между регионами и моделями здесь шире, чем у двух свободностоящих
      моделей парка выше, — точную цифру для площадки обсуждаем напрямую через форму ниже.
    </p>

    <h2 style="margin:36px 0 18px">Приставной режим: нагрузку держит здание, а не грунт</h2>
    <p>
      У обеих свободностоящих моделей парка — Potain MDT 219 J10 и КБ-408.21 — вся нагрузка от массы
      крана, груза и ветра уходит в основание: рельсовый путь или монолитный фундамент, рассчитанные под
      несущую способность грунта. У КБ-674А в приставном режиме появляется второй путь передачи нагрузки:
      часть усилия — паспортный максимум 37,8 т на одну настенную опору — передаётся напрямую в
      конструкцию здания через анкерные крепления башни к стенам. Это не альтернатива расчёту грунта, а
      дополнительный расчёт, которого не было ни у одной из первых двух моделей: несущие конструкции
      объекта должны быть подтверждены проектировщиком здания на восприятие этой горизонтальной нагрузки
      — отдельно от того, что делает изыскатель площадки на этапе
      <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>.
    </p>
    <p>
      Количество настенных опор растёт вместе с высотой подъёма: чем выше работает кран без ходовой
      части, тем больше точек крепления к стволу здания требуется для устойчивости против опрокидывания
      и ветровой раскачки. Сама процедура монтажа секций мачты и установки креплений — тот же автокран
      на площадке, что поднимает секции и у двух других моделей парка, и тот же акт готовности перед
      первым рабочим подъёмом, разобранные на этапе
      <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Сейсмика: горизонтальная нагрузка складывается дважды</h2>
    <p>
      Для свободностоящего крана сейсмическая добавка по ТСН 22-302-2000 ложится на фундамент и грунт
      под ним. У приставного крана та же добавка распределяется между основанием и настенными опорами —
      при колебании грунта здание и кран, закреплённый на нём в нескольких точках, раскачиваются не
      независимо друг от друга, а связанно. Расчёт этого взаимодействия — задача проекта монтажа
      конкретного высотного объекта, а не паспортная характеристика крана; нижняя граница, с которой
      сейсмический расчёт вообще включается в проект, разобрана в разделе
      <a href="/seysmozony/7-ballov/" style="color:var(--accent)">«Площадка 7 баллов»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Когда нужна третья модель, а не первые две</h2>
    <p>
      Пока объект укладывается в высоту подъёма около 70 м под крюком, выбор идёт между топлесс-краном
      и рельсовым — вопрос вылета против набора секциями, разобранный на хабе
      <a href="/park/" style="color:var(--accent)">«Парк техники»</a>. Как только высотный регламент
      площадки — вопрос, который проверяется на этапе
      <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">«Проект и ППР»</a> — допускает здание
      выше этого потолка, а рельсовый путь такой длины и такое основание на площадке разместить негде,
      приставной монтаж становится не опцией, а единственным техническим решением: высоту даёт не грунт,
      а сама растущая конструкция.
    </p>

    <h2 style="margin:36px 0 18px">Когда эта модель — не лучший выбор</h2>
    <dl class="factline" style="max-width:none">
      <div>
        <dt>Объект ниже 60 м под крюком</dt>
        <dd>Свободностоящая схема проще в монтаже и не требует согласования нагрузки на конструкции здания — уместнее первые две модели парка.</dd>
      </div>
      <div>
        <dt>Несущие стены не подтверждены на нагрузку от анкеров</dt>
        <dd>Без расчёта проектировщика здания на 37,8 т на опору приставной монтаж не начинают — тогда либо пересчёт конструкций, либо рельсовая схема КБ-408.21.</dd>
      </div>
      <div>
        <dt>Площадка допускает обычный рельсовый путь нужной длины</dt>
        <dd>Если объект укладывается в высоту КБ-408.21, приставной монтаж — избыточное усложнение и лишняя строка в смете за крепления.</dd>
      </div>
    </dl>

    <p style="margin-top:26px">
      Две другие модели парка: <a href="/park/potain-mdt-219-j10/" style="color:var(--accent)">Potain MDT 219 J10 — топлесс-кран для стеснённой площадки</a>
      и <a href="/park/kb-408-21/" style="color:var(--accent)">КБ-408.21 — рельсовый кран для набора высоты по секциям</a>.
    </p>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9A%D0%91-674', label: 'ru.wikipedia.org — КБ-674: история, завод-изготовитель, модификации 675/676' },
      { href: 'https://www.stroy-kran.ru/kb/kb-674', label: 'stroy-kran.ru — КБ-674А-РК: грузоподъёмность, вылет, высота подъёма приставным способом, нагрузка на опору' },
      { href: 'https://kran-vertikal.ru/arenda/bashennye-krany/kb-674/', label: 'kran-vertikal.ru — КБ-674: характеристики, база и колея, скорость подъёма' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://www.kran-mash.ru/poleznoe/13-sejsmostojkoe-ispolnenie-kranov', label: 'kran-mash.ru — сейсмостойкое исполнение кранов для районов свыше 6 баллов' },
      { href: 'https://cpec-teh.ru/catalog/bashennye-krany/bashennyi-kran-kb-674/', label: 'cpec-teh.ru — аренда КБ-674, цена по запросу (час/смена)' },
      { href: 'https://www.glavarendakran.com/arenda-kranov/potain/', label: 'glavarendakran.com — аренда 12-тонных Potain MD 265B и MC 310 K12, от 700 000–750 000 ₽/мес' },
      { href: 'https://giraffecrane.ru/arenda-bashennogo-krana/', label: 'giraffecrane.ru — высота при креплении к зданию до 183 м' },
    ]} />

    <p style="margin-top:26px"><a class="btn" href="/#order">Прислать параметры площадки <span aria-hidden="true">→</span></a></p>
  </section>
</main>
</BaseLayout>
