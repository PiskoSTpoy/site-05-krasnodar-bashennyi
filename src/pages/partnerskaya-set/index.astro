---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';

// Волна 30: честное расширение охвата. Сайт специализируется на башенном
// кране и, отдельной строкой, на автокране на том же объекте (парк техники,
// волны 23-24) — но на реальной стройке в крае периодически нужна техника,
// которая в специализацию не входит вовсе: гусеничный кран, манипулятор,
// автовышка. Страница «Парк техники» уже честно оговаривала эту границу
// («под нестандартную задачу подбираем технику отдельно и не ограничиваем
// себя этими тремя марками») — здесь эта фраза раскрыта в отдельный раздел,
// а не повторена дословно. Автокран НЕ включён в список «техники вне
// специализации»: он уже прямо описан по всему сайту (index.astro, /etapy/,
// /faq/, /park/) как вторая собственная услуга, а не партнёрская подборка —
// перечислять его здесь как партнёрскую технику значило бы противоречить
// уже опубликованному содержанию сайта.
//
// Волна 31: расширение до полного спектра категорий строительной аренды —
// добавлены экскаватор, самосвал, трал и негабарит. Экскаватор и самосвал чистые
// добавления (сайт нигде их не упоминал). Трал — особый случай: сайт уже
// многократно говорит о «трале с секциями крана» (index.astro, Smeta.astro,
// /etapy/demontazh-i-perebazirovka/, /etapy/izyskaniya-i-grunt/) как о
// перебазировке СОБСТВЕННОГО башенного крана, включённой в ставку аренды —
// это первая сторона, не партнёрская подборка. Новая категория здесь — про
// ДРУГОЕ: негабаритный груз заказчика (не секции нашего крана), который мы
// не возим сами и подбираем через партнёров. Граница проведена явно, чтобы
// не противоречить уже опубликованному «входит в ставку».
//
// Волна 32 (переопределена после отменённой первой попытки — см. deploy-plan.md,
// «КОРРЕКЦИЯ после Волны 31»): не собственный парк, а подвиды/разновидности ВНУТРИ
// каждой из шести уже честно помеченных «партнёрская сеть» категорий — списком в
// том же <dd>, без новых URL и без единой выдуманной модели/ТТХ/цены. Автокран
// (собственная услуга монтажа/демонтажа) и разграничение трала (груз заказчика
// vs секции башенного крана, зафиксированное волной 31) не тронуты — подвиды
// добавлены только внутрь шести партнёрских категорий. Оси — общеотраслевые,
// подтверждены WebSearch: гусеничный кран — тип стрелы (решётчатая/телескопическая)
// + класс по тоннажу; манипулятор — грузовой момент (тм); автовышка — высота
// подъёма; экскаватор — тип ходовой (гусеничный/колёсный); самосвал — тип рамы
// и грузоподъёмность; трал — низкорамный/модульный тяжеловоз.

const title = 'Кроме башенного крана: техника через партнёрскую сеть';
const description =
  'Гусеничный кран, манипулятор, автовышка, экскаватор, самосвал, трал — не наш парк. Как подбираем такую технику в Краснодарском крае через партнёрскую сеть.';

const SITE = 'https://kran-kuban.example';
const CHECKED = '17 августа 2026 года';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Партнёрская сеть', item: `${SITE}/partnerskaya-set/` },
  ],
};

// Волна 33 (GEO). Сводка тех же шести категорий, что расписаны ниже в <dl>:
// по какому параметру партнёры выбирают машину и в каком диапазоне. Ни одного
// нового числа — каждое значение взято из соответствующего пункта categories.
const axes = [
  { name: 'Гусеничный кран', task: 'Тяжёлый монтаж на большом вылете там, где нет ни дорог, ни места под крановый путь', axis: 'Конструкция стрелы и класс по тоннажу', range: 'Лёгкий до 10 т · средний 10–25 т · тяжёлый от 25 т' },
  { name: 'Манипулятор', task: 'Доставка и разгрузка материалов одной машиной с бортом', axis: 'Грузовой момент, тонны на метр вылета', range: 'Лёгкий до 5 тм · средний до 25–30 тм · тяжёлый от 25–30 тм' },
  { name: 'Автовышка', task: 'Рабочая площадка для человека на высоте: фасад, отделка, обслуживание', axis: 'Высота подъёма платформы', range: 'До 18 м · 20–30 м · от 32 до 50 м' },
  { name: 'Экскаватор', task: 'Земляные работы до захода крана: котлован, траншеи, планировка', axis: 'Тип ходовой части', range: 'Гусеничный или колёсный' },
  { name: 'Самосвал', task: 'Вывоз грунта и подвоз сыпучих материалов', axis: 'Грузоподъёмность и проходимость шасси', range: 'Дорожный 10–25 т · сочленённый 10–50 т · карьерный от 23 т' },
  { name: 'Трал и негабарит', task: 'Перевозка тяжеловесного груза заказчика (не секций нашего крана)', axis: 'Тип платформы', range: 'Низкорамный 20–90 т · модульный тяжеловоз от 100 т' },
];

const categories = [
  {
    name: 'Гусеничный кран',
    text: 'Там, где грузоподъёмность нужна на большом вылете или площадка не держит выносные опоры автокрана, а рельсовый путь башенного крана ставить не под что — тяжёлый монтаж вне зоны дорог общего пользования, промышленная площадка, объект с плохим грунтом под точечной нагрузкой.' +
      ' Партнёры перебирают вариант по двум осям — конструкция стрелы и класс по тоннажу:' +
      '<ul style="margin-top:10px">' +
      '<li>Решётчатая стрела — тяжелее и дольше в монтаже на площадке, зато держит больший груз на дальнем вылете; обычный выбор для промышленного объекта.</li>' +
      '<li>Телескопическая стрела — разворачивается быстрее и с меньшим числом операций, но проигрывает решётчатой на предельных вылетах.</li>' +
      '<li>Класс по тоннажу — от лёгкого (примерно до 10 т) через средний (10–25 т) до тяжёлого (от 25 т); чем массивнее конструкция и дальше точка подъёма, тем выше класс ищут партнёры.</li>' +
      '</ul>',
  },
  {
    name: 'Манипулятор (кран-манипуляторная установка)',
    text: 'Не подъём, а логистика: доставка и погрузка-разгрузка стройматериалов, оборудования, мелких конструкций там, где не нужен ни башенный, ни автокран целиком — задача решается одной машиной с бортом и небольшой КМУ.' +
      ' Внутри категории машины разводит грузовой момент — тонны на метр вылета стрелы:' +
      '<ul style="margin-top:10px">' +
      '<li>Лёгкие, примерно до 5 тм — груз около 1–2 т, разовая разгрузка небольшой партии.</li>' +
      '<li>Средние, примерно до 25–30 тм — самый частый запрос, груз в пределах 2–10 т.</li>' +
      '<li>Тяжёлые, от 25–30 тм и выше — груз от 10 т, под крупногабаритные конструкции и оборудование.</li>' +
      '</ul>',
  },
  {
    name: 'Автовышка',
    text: 'Рабочая площадка для человека, а не для груза: фасадные, отделочные и обслуживающие работы на высоте — в том числе на объектах курортной инфраструктуры Сочи и Анапы, где грузоподъёмный кран для такой задачи избыточен.' +
      ' Партнёры подбирают модель по высоте подъёма платформы:' +
      '<ul style="margin-top:10px">' +
      '<li>До 18 м — одно- и двухэтажные объекты, локальные фасадные и отделочные работы.</li>' +
      '<li>20–30 м — самый массовый запрос под жилую и коммерческую застройку.</li>' +
      '<li>От 32 до 50 м — высотные фасады и объекты курортной зоны, где своей вышки такой высоты у нас нет.</li>' +
      '</ul>',
  },
  {
    name: 'Экскаватор',
    text: 'Земляные работы до того, как на площадку заходит башенный кран: выемка грунта под фундамент, устройство траншей, планировка территории под будущий крановый путь. Что именно нужно узнать о грунте до этого этапа — на странице <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>.' +
      ' Партнёры предлагают два типа ходовой части под разную площадку:' +
      '<ul style="margin-top:10px">' +
      '<li>Гусеничный — устойчивее на рыхлом и переувлажнённом грунте, но своим ходом по асфальту не идёт: переезд на объект — тоже через трал.</li>' +
      '<li>Колёсный — быстрее перемещается между точками площадки и по дорогам общего пользования, удобнее в стеснённой городской застройке.</li>' +
      '</ul>',
  },
  {
    name: 'Самосвал',
    text: 'Вывоз грунта из котлована и подвоз сыпучих материалов на площадку — задача не подъёмная, а транспортная: самосвал не поднимает груз, а перемещает его по земле, обычно в связке с экскаватором на этапе земляных работ.' +
      ' Ось подбора здесь — грузоподъёмность и проходимость шасси:' +
      '<ul style="margin-top:10px">' +
      '<li>Дорожный — 10–25 т, ездит по дорогам общего пользования без ограничений.</li>' +
      '<li>С шарнирно-сочленённой рамой — 10–50 т, для бездорожья самой стройплощадки, где обычный самосвал буксует.</li>' +
      '<li>Карьерный внедорожный — от 23 т и выше, под большие объёмы вывоза на масштабных объектах; на типовой городской стройке нужен редко.</li>' +
      '</ul>',
  },
  {
    name: 'Трал и негабарит',
    text: 'Перевозка тяжеловесного или негабаритного груза заказчика — не секций нашего башенного крана: их перебазировка тралом уже включена в ставку аренды и описана на этапе <a href="/etapy/demontazh-i-perebazirovka/" style="color:var(--accent)">«Демонтаж и перебазировка»</a>. Речь о другом грузе на объекте, и здесь действует то же летнее ограничение движения тяжеловесов по дорогам края с 20 мая по 31 августа.' +
      ' Под груз заказчика партнёры держат два типа платформы:' +
      '<ul style="margin-top:10px">' +
      '<li>Низкорамный трал — примерно 20–90 т, заниженная погрузочная высота под габаритную технику и конструкции.</li>' +
      '<li>Модульный тяжеловоз — от 100 т, платформа наращивается по длине и ширине под груз, который низкорамник уже не берёт.</li>' +
      '</ul>',
  },
];
---
<BaseLayout title={title} description={description} path="/partnerskaya-set/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Партнёрская сеть</span>
  </nav>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Раздел</span>
    <h1>Кроме башенного крана: остальная техника — через партнёрскую сеть</h1>
    <p class="dossier__lead">
      6 категорий техники — гусеничный кран, манипулятор, автовышка, экскаватор, самосвал и трал для
      негабаритного груза — в наш парк не входят, и под конкретную задачу мы подбираем их через
      партнёрскую сеть операторов Краснодарского края. Собственная специализация сайта — башенный
      кран и, отдельной услугой, автокран на том же объекте, это разобрано в разделе
      <a href="/park/" style="color:var(--accent)">«Парк техники»</a>. Такой техники у нас нет и парка
      под неё мы не собирали: честнее назвать её партнёрской, чем выдать желаемое за собственный парк.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Зачем на сайте про башенный кран есть страница про другую технику</h2>
    <p>
      На странице «Парк техники» уже сказано прямо: три модели башенного крана и роль автокрана — не
      полный перечень возможной техники, и под нестандартную задачу мы подбираем её отдельно, не
      ограничивая себя тремя марками. Здесь — что именно это означает на практике для шести категорий,
      которые в специализацию сайта не входят вовсе: гусеничного крана, манипулятора, автовышки,
      экскаватора, самосвала и трала для негабаритного груза. Идея простая: заказчик описывает задачу
      один раз, а поиск подходящей машины и оператора под неё — уже наша часть работы, а не его.
    </p>

    <h2 style="margin:36px 0 18px">Шесть категорий техники, которые подбираем через партнёров</h2>
    <p>
      Внутри почти каждой категории у партнёров есть на выбор не одна машина, а подвид — и то,
      какой из них предложат под конкретный объект, обычно решают один-два понятных параметра.
      Ниже эти подвиды перечислены при каждой категории — без марок и цифр из паспорта конкретной
      машины, только тип конструкции или диапазон, по которому партнёры её выбирают. Сводка целиком:
    </p>
    <div class="rule-table-wrap">
      {/* Четыре колонки прозаического текста в экран телефона не помещаются:
          замер дал 462 px при 375 — правая колонка «Диапазон» срезалась.
          На ≤560 px таблица становится стопкой записей (.rule-table--stack,
          см. BaseLayout), подписи в ячейках дословно повторяют шапку.
          role=* обязательны: display:block снимает у таблицы её неявные роли. */}
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Шесть партнёрских категорий техники: задача, параметр подбора и диапазон</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Категория</th><th scope="col" role="columnheader">Какую задачу закрывает</th><th scope="col" role="columnheader">По какому параметру подбирают</th><th scope="col" role="columnheader">Диапазон</th></tr>
        </thead>
        <tbody>
          {axes.map((a) => (
            <tr role="row"><th scope="row" role="rowheader">{a.name}</th><td role="cell" data-label="Какую задачу закрывает">{a.task}</td><td role="cell" data-label="По какому параметру подбирают">{a.axis}</td><td role="cell" data-label="Диапазон">{a.range}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <dl class="factline" style="max-width:none;margin-top:22px">
      {categories.map((c) => (
        <div>
          <dt>{c.name}</dt>
          <dd set:html={c.text} />
        </div>
      ))}
    </dl>

    <h2 style="margin:36px 0 18px">Новороссийск как ориентир масштаба спроса на Кубани</h2>
    <p>
      По итогам 2025 года Новороссийский морской торговый порт перевалил 168 млн тонн грузов — рост на
      1,9% к 2024 году, и это около 19% всего грузооборота морских портов России, по данным Ассоциации
      морских торговых портов России. Терминалы порта — не наш профиль: там работает своя портовая
      техника, и сайт её не подбирает. Но масштаб грузопотока через один только Новороссийск показывает
      то же самое, что мы видим и на менее заметных объектах края: спрос на технику для стройки в
      Краснодарском крае — подъёмную, земляную, транспортную — шире, чем ниша башенного крана, и
      закрыть его парком из нескольких машин одной специализации нельзя — только сетью операторов,
      каждый из которых силён в своей.
    </p>

    <h2 style="margin:36px 0 18px">Чем это отличается от автокрана и трала в парке техники</h2>
    <p>
      Автокран на этом сайте — не партнёрская подборка, а вторая собственная услуга, которая с самого
      начала стоит рядом с башенным краном: он приезжает на смену и уезжает, а на монтаже башенного
      крана поднимает его секции, стрелу и противовес — обе роли разобраны на этапе
      <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.
      Похожая граница — у трала: перебазировка секций нашего башенного крана тралом уже входит в
      ставку аренды, это не партнёрская услуга, а часть собственного процесса монтажа и демонтажа
      (этап <a href="/etapy/demontazh-i-perebazirovka/" style="color:var(--accent)">«Демонтаж и
      перебазировка»</a>). Категория «Трал и негабарит» выше — про другой груз: собственное
      оборудование или конструкции заказчика, а не наш кран. Гусеничный кран, манипулятор, автовышка,
      экскаватор и самосвал — другой случай во всех смыслах: здесь у нас нет ни своей машины, ни
      фиксированного парка, и мы говорим об этом прямо, а не подписываем автокран, башенный кран и
      собственный трал под одну обложку с техникой, которой не владеем.
    </p>

    <h2 style="margin:36px 0 18px">Как проходит подбор техники не из нашей специализации</h2>
    <dl class="factline" style="max-width:none">
      <div>
        <dt>1. Заявка с параметрами объекта</dt>
        <dd>Какую задачу решает техника — поднять, выкопать, вывезти, довезти, дать рабочую площадку на высоте, — грузоподъёмность, объём или высота, адрес площадки и сроки. Решение о том, какая техника вообще нужна объекту, обычно принимается на этапе <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">«Проект и ППР»</a>, вместе с остальными параметрами монтажа.</dd>
      </div>
      <div>
        <dt>2. Уточнение у партнёров в крае</dt>
        <dd>Мы не гадаем и не обещаем технику, которую не проверили: узнаём у операторов в Краснодарском крае, у кого есть нужная машина и когда она реально свободна под сроки объекта.</dd>
      </div>
      <div>
        <dt>3. Прямое согласование условий</dt>
