---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneStrip from '../../../components/ZoneStrip.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Площадка 9 баллов: вчетверо большее воздействие, чем при 7';
const description =
  'Расчётная сейсмичность 9 баллов под башенный кран: пиковое ускорение 0,4g, два пути попадания в зону, требования ТСН 22-302-2000 к застройке 8–9 баллов.';
const SITE = 'https://kran-kuban.ru';
const CHECKED = '12 августа 2026 года';

// Волна 33 (GEO). Прогрессия ускорений уже стояла в тексте раздела
// «Что означает 0,4g» одной фразой — здесь она же таблицей, чтобы соотношение
// баллов читалось без пересчёта в уме. Новых величин нет: 0,1g / 0,2g / 0,4g
// и кратности взяты из того же абзаца и подтверждены источником внизу страницы.
const accel = [
  { ball: '7 баллов', a: '0,1g', ratio: 'база сравнения', href: '/seysmozony/7-ballov/' },
  { ball: '8 баллов', a: '0,2g', ratio: 'вдвое больше, чем при 7', href: '/seysmozony/8-ballov/' },
  { ball: '9 баллов', a: '0,4g', ratio: 'вчетверо больше, чем при 7, и вдвое — чем при 8', href: null },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Сейсмические зоны', item: `${SITE}/seysmozony/` },
    { '@type': 'ListItem', position: 3, name: 'Площадка 9 баллов', item: `${SITE}/seysmozony/9-ballov/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/seysmozony/9-ballov/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/seysmozony/">Сейсмические зоны</a><span aria-hidden="true">/</span><span aria-current="page">9 баллов</span>
  </nav>

  <div class="wrap"><ZoneStrip current={9} /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Расчётная сейсмичность · 0,4g</span>
    <h1>Площадка 9 баллов: верхняя ступень, на которую проектируют</h1>
    <p class="dossier__lead">
      Девять баллов — максимум диапазона, на который распространяется свод правил по строительству в
      сейсмических районах. Пиковое ускорение здесь 0,4g: вдвое больше, чем при восьми баллах, и
      вчетверо больше, чем при семи. В расчёте основания башенного крана это самая тяжёлая из
      кубанских ситуаций.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Два пути попасть в девятибалльную зону</h2>
    <p>
      Первый путь — карта. Черноморское побережье края находится в верхней части краевого диапазона
      7–9 баллов, и для объектов повышенного уровня ответственности расчёт ведут по картам В или С —
      с более редким и более сильным расчётным событием, чем на карте А. Второй путь — грунт: баллы
      карт даны для средних условий (грунты II категории), а рыхлые пески и мягкие глинистые грунты
      III категории усиливают колебания, поднимая расчётную сейсмичность площадки относительно карты.
    </p>
    <p>
      Оба пути ведут к одному и тому же выводу для заказчика: девять баллов — это чаще всего не
      «плохая карта», а сочетание уровня ответственности объекта с фактическим основанием. Спорить с
      этим сочетанием на площадке поздно, поэтому балл выясняют до проекта монтажа.
    </p>

    <h2 style="margin:36px 0 18px">Что означает 0,4g для анкеровки и фундамента</h2>
    <p>
      Пиковое сейсмическое ускорение растёт вдвое на каждый балл: 0,1g при семи, 0,2g при восьми,
      0,4g при девяти на средних грунтах. Башенный кран — сооружение с высоко расположенной массой,
      закреплённое на весь срок строительства; горизонтальное воздействие такой величины приходится
      на фундамент, крепления кранового пути и узлы анкеровки к возводимому зданию. На девяти баллах
      разница с восемью — не строчка в пояснительной записке, а вдвое большая расчётная нагрузка на
      те же самые узлы.
    </p>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Пиковое сейсмическое ускорение на средних грунтах по баллам площадки</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Расчётная сейсмичность</th><th scope="col" role="columnheader">Пиковое ускорение</th><th scope="col" role="columnheader">Во сколько раз больше</th></tr>
        </thead>
        <tbody>
          {accel.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader">{r.href ? <a href={r.href} style="color:var(--accent)">{r.ball}</a> : r.ball}</th>
              <td role="cell" data-label="Пиковое ускорение">{r.a}</td>
              <td role="cell" data-label="Во сколько раз больше">{r.ratio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Значения даны для средних грунтовых условий — грунтов II категории. Фактический грунт площадки
      сдвигает балл относительно карты, и тогда по этой же таблице меняется строка.
    </p>
    <p>
      Отсюда практика, которую мы не считаем перестраховкой: для таких площадок расчёт основания с
      сейсмической нагрузкой закладывается в проект монтажа сразу, независимо от того, спросил ли
      заказчик про сейсмику. Подробнее о самом этапе — в разборе
      <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Требования, которые выходят за пределы конструкции</h2>
    <p>
      Территориальные нормы ТСН 22-302-2000 обязательны для площадок сейсмичностью 7, 8 и 9 баллов, но
      часть их требований для районов 8–9 баллов относится уже не к отдельному сооружению, а к
      планировке: крупные массивы застройки в таких районах разделяют транспортными магистралями или
      полосами зелёных насаждений. Для крана это не прямое требование, а контекст, влияющий на
      компоновку площадки: разрывы между массивами задают проезды, границы участка и, в конечном
      счёте, точку привязки крана и конфигурацию его пути.
    </p>

    <h2 style="margin:36px 0 18px">Что меняется в графике и в смете</h2>
    <dl class="factline">
      <div>
        <dt>Сроки проектирования</dt>
        <dd>Расчётный этап нельзя пропустить и нельзя сжать: он идёт до выхода техники, параллельно с разработкой ППР.</dd>
      </div>
      <div>
        <dt>Требования к исходным данным</dt>
        <dd>Балл «по слухам о районе» не годится: нужен документ — карта СМР либо отчёт по изысканиям, и в расчёте указывают, откуда взято значение.</dd>
      </div>
      <div>
        <dt>Строка сметы</dt>
        <dd>Удорожание по сейсмике мы считаем отдельной строкой, а не растворяем в ставке: заказчик должен видеть, за что платит. Выдуманную цифру для этой строки на сайте не публикуем — объём работы задают балл и категория грунта.</dd>
      </div>
    </dl>
    <p style="margin-top:22px">
      Посчитать эту строку вместе с мобилизацией, арендой и демонтажем можно в
      <a href="/#smeta" style="color:var(--accent)">смете владения</a>: там же видно, как разовые
      расходы влияют на фактическую стоимость месяца.
    </p>

    <p style="margin-top:26px">
      Соседние зоны: <a href="/seysmozony/8-ballov/" style="color:var(--accent)">8 баллов — 0,2g</a>,
      <a href="/seysmozony/7-ballov/" style="color:var(--accent)">7 баллов — 0,1g</a>.
    </p>

    <Sources checked={CHECKED} items={[
      { href: 'https://files.stroyinf.ru/Data2/1/4293736/4293736459.htm', label: 'files.stroyinf.ru — СП 14.13330.2018: пиковое ускорение 0,4g при 9 баллах, область применения 7–9 баллов' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018, карты ОСР-2015' },
      { href: 'https://files.stroyinf.ru/Data2/1/4294848/4294848212.htm', label: 'files.stroyinf.ru — ТСН 22-302-2000: площадки 7–9 баллов, разделение массивов застройки в районах 8–9 баллов' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
    ]} />
  </section>
</main>
</BaseLayout>
