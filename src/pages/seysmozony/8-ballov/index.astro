---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneStrip from '../../../components/ZoneStrip.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Площадка 8 баллов: выбор карты ОСР решает больше адреса';
const description =
  'Сейсмичность 8 баллов под башенный кран: пиковое ускорение 0,2g, карты А, В и С СП 14.13330.2018, уровень ответственности объекта, побережье Кубани.';
const SITE = 'https://kran-kuban.example';
const CHECKED = '12 августа 2026 года';

const maps = [
  { map: 'Карта А', period: 'около 500 лет', use: 'Объекты нормального и пониженного уровня ответственности — обычная жилая и коммерческая застройка' },
  { map: 'Карта В', period: 'около 1000 лет', use: 'Объекты повышенного уровня ответственности' },
  { map: 'Карта С', period: 'около 5000 лет', use: 'Объекты повышенного уровня ответственности с наиболее тяжёлыми последствиями отказа' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Сейсмические зоны', item: `${SITE}/seysmozony/` },
    { '@type': 'ListItem', position: 3, name: 'Площадка 8 баллов', item: `${SITE}/seysmozony/8-ballov/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/seysmozony/8-ballov/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/seysmozony/">Сейсмические зоны</a><span aria-hidden="true">/</span><span aria-current="page">8 баллов</span>
  </nav>

  <div class="wrap"><ZoneStrip current={8} /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Расчётная сейсмичность · 0,2g</span>
    <h1>Площадка 8 баллов: зона, где спор идёт не про адрес, а про карту</h1>
    <p class="dossier__lead">
      Расчётная сейсмичность 8 баллов — пиковое ускорение 0,2g, вдвое больше, чем при семи, — самая
      частая величина для прибрежной части края и единственная зона, где один и тот же участок
      регулярно оказывается «то восемь, то девять». Причина не в разночтениях: карт общего
      сейсмического районирования в комплекте ОСР-2015 три — А, В и С со средним интервалом между
      расчётными событиями около 500, 1000 и 5000 лет, — и применяются они к объектам разного уровня
      ответственности.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Три карты — три разных ответа для одной точки</h2>
    <p>
      Комплект ОСР-2015 в составе СП 14.13330.2018 состоит из карт А, В и С. Они различаются средним
      интервалом между землетрясениями расчётной интенсивности и, соответственно, назначением: чем
      тяжелее последствия отказа сооружения, тем более редкое и сильное событие берут в расчёт.
    </p>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Карты ОСР-2015: интервал повторяемости и назначение</caption>
        <thead><tr role="row"><th scope="col" role="columnheader">Карта</th><th scope="col" role="columnheader">Средний интервал</th><th scope="col" role="columnheader">Для каких объектов</th></tr></thead>
        <tbody>
          {maps.map((m) => (
            <tr role="row"><th scope="row" role="rowheader">{m.map}</th><td role="cell" data-label="Средний интервал">{m.period}</td><td role="cell" data-label="Для каких объектов">{m.use}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Практический вывод для заказчика: прежде чем спорить о балле, нужно договориться об уровне
      ответственности объекта. Для обычной жилой и коммерческой застройки это карта А; если объект
      отнесён к повышенному уровню ответственности, расчёт ведут по В или С, и балл площадки может
      оказаться на единицу выше — со всеми последствиями для основания крана.
    </p>

    <h2 style="margin:36px 0 18px">Что стоит за 0,2g</h2>
    <p>
      Пиковое сейсмическое ускорение на средних грунтах при восьми баллах — 0,2g, вдвое больше, чем
      при семи. Для башенного крана это не абстракция: он представляет собой высокое сооружение с
      большой парусностью и высоко расположенной массой, закреплённое на фундаменте или крановом пути
      на весь срок стройки. Горизонтальное воздействие такой величины считают вместе с ветровым, а не
      вместо него — и именно на этом этапе становится понятно, потребуется ли усиление основания или
      достаточно типового решения.
    </p>
    <p>
      Территориальные нормы ТСН 22-302-2000 обязательны для площадок 7, 8 и 9 баллов, так что
      восьмибалльная площадка попадает под них полностью — вместе с федеральными требованиями свода
      правил, а не вместо них.
    </p>

    <h2 style="margin:36px 0 18px">Почему грунт может увести площадку из восьми в девять</h2>
    <p>
      Баллы карт даны для средних грунтовых условий — грунтов II категории по сейсмическим свойствам.
      Прибрежная полоса Кубани редко бывает «средней»: рыхлые пески и мягкие глинистые грунты
      относятся к III категории и усиливают колебания. Площадка на таком основании при карте с
      восемью баллами может получить расчётную сейсмичность выше, и узнать об этом лучше из карты
      микрорайонирования или отчёта по изысканиям, а не из пересчёта проекта после начала работ.
      Как это устроено — на этапе
      <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Что мы делаем с восьмибалльной площадкой</h2>
    <dl class="factline">
      <div>
        <dt>Спрашиваем уровень ответственности</dt>
        <dd>Он определяет, по какой карте ОСР-2015 берётся балл, и это первый вопрос, а не второй.</dd>
      </div>
      <div>
        <dt>Сверяем грунт</dt>
        <dd>Категория грунта может сдвинуть расчётную сейсмичность вверх относительно карты — на побережье это не редкость.</dd>
      </div>
      <div>
        <dt>Закладываем расчётный этап</dt>
        <dd>Расчёт основания на сейсмическую нагрузку входит в проект монтажа и занимает дни, которые видны в графике заранее.</dd>
      </div>
    </dl>

    <p style="margin-top:26px">
      Соседние зоны: <a href="/seysmozony/7-ballov/" style="color:var(--accent)">7 баллов — 0,1g</a>,
      <a href="/seysmozony/9-ballov/" style="color:var(--accent)">9 баллов — 0,4g</a>.
    </p>

    <Sources checked={CHECKED} items={[
      { href: 'https://files.stroyinf.ru/Data2/1/4293736/4293736459.htm', label: 'files.stroyinf.ru — СП 14.13330.2018: пиковое ускорение 0,2g при 8 баллах, категории грунтов' },
      { href: 'https://base.garant.ru/71985096/53f89421bbdaf741eb2d1ecc4ddb4c33/', label: 'ГАРАНТ — приложение А к СП 14.13330.2018: карты А, В, С и интервалы 500, 1000, 5000 лет' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
    ]} />
  </section>
</main>
</BaseLayout>
