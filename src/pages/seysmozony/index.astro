---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';

// Волна 16. Раздел заменил географию по городам (/geo/sochi, /geo/krasnodar,
// /geo/anapa, /geo/novorossiysk). Причина содержательная: для башенного крана
// решает расчётная сейсмичность ПЛОЩАДКИ и категория её грунта, а не название
// населённого пункта. Города остались внутри зон перекрёстными ссылками —
// каждый на тот этап, где его фактор реально работает.

const title = 'Сейсмические зоны Краснодарского края: расчёт балла площадки';
const description =
  'Как определяют сейсмичность площадки под башенный кран: карты ОСР-2015 в СП 14.13330.2018, категория грунта, микрорайонирование и нормы ТСН 22-302-2000.';
const SITE = 'https://kran-kuban.example';
const CHECKED = '12 августа 2026 года';

const zones = [
  {
    href: '/seysmozony/7-ballov/',
    ball: '7 баллов',
    accel: '0,1g',
    what: 'Нижняя граница, с которой вообще начинается сейсмическое проектирование',
    note: 'Ниже семи баллов сейсмические нагрузки в расчёт не вводят. Но категория грунта может поднять площадку с шести до семи — и включить требования, которых по карте не ожидали.',
  },
  {
    href: '/seysmozony/8-ballov/',
    ball: '8 баллов',
    accel: '0,2g',
    what: 'Самая частая расчётная сейсмичность прибрежной части края',
    note: 'Здесь чаще всего решает выбор карты: один и тот же участок по карте А и по карте В получает разный балл, и зависит это от уровня ответственности объекта.',
  },
  {
    href: '/seysmozony/9-ballov/',
    ball: '9 баллов',
    accel: '0,4g',
    what: 'Максимум, на который проектируют по своду правил',
    note: 'Вчетверо большее расчётное воздействие, чем при семи баллах. Требования ТСН при 8–9 баллах касаются уже не только конструкции, но и компоновки застройки.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Сейсмические зоны', item: `${SITE}/seysmozony/` },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Расчётная сейсмичность площадки: разборы по баллам',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: zones.length,
  itemListElement: zones.map((z, i) => ({ '@type': 'ListItem', position: i + 1, name: `Площадка ${z.ball}`, url: SITE + z.href })),
};
---
<BaseLayout title={title} description={description} path="/seysmozony/" ldExtra={[breadcrumbLd, itemListLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Сейсмические зоны</span>
  </nav>

  <header class="dossier wrap" style="padding-top:8px">
    <span class="eyebrow">Раздел</span>
    <h1>Сейсмические зоны края: балл считают по площадке, а не по городу</h1>
    <p class="dossier__lead">
      Расчётная сейсмичность площадок Краснодарского края лежит в диапазоне 7–9 баллов, и каждый
      балл удваивает расчётное воздействие: 0,1g при семи, 0,2g при восьми, 0,4g при девяти.
      Определяют её по конкретной площадке, а не по городу — балл карт ОСР-2015 дан для средних
      грунтов II категории, и фактический грунт участка сдвигает его вверх или вниз. Поэтому раздел
      разложен по баллам, а города внутри — перекрёстные ссылки на этапы, где работает их
      собственный фактор.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Из чего складывается расчётная сейсмичность</h2>
    <p>
      Исходная величина — фоновая сейсмичность района по комплекту карт общего сейсмического
      районирования ОСР-2015, включённому в СП 14.13330.2018 «Строительство в сейсмических районах».
      Карт три, и они отличаются не точностью, а горизонтом: карты А, В и С отвечают средним
      интервалам между землетрясениями расчётной интенсивности примерно в 500, 1000 и 5000 лет.
      Карта А применяется для объектов нормального и пониженного уровня ответственности, карты В и С —
      для объектов повышенного уровня. Один и тот же участок на разных картах получает разный балл, и
      это не противоречие, а разные сроки службы и разная цена отказа.
    </p>
    <p>
      Вторая составляющая — грунт. Баллы карт даны для средних грунтовых условий, то есть для грунтов
      II категории по сейсмическим свойствам. Рыхлые пески и мягкие глинистые грунты относятся к III
      категории, склонные к разжижению разновидности — к IV, и площадка на таком основании ведёт себя
      хуже, чем показывает карта. Самый точный ответ даёт карта сейсмического микрорайонирования
      участка; при её отсутствии балл берут по списку населённых пунктов из того же свода правил —
      с оговоркой, что это оценка по городу, а не по вашей площадке. Подробнее об этом — на этапе
      <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>.
    </p>
    <p>
      Третья составляющая — территориальные нормы. В крае поверх федеральных требований действуют
      ТСН 22-302-2000 (СНКК 22-301-2000) «Строительство в сейсмических районах Краснодарского края»,
      введённые постановлением главы администрации края от 04.04.2001 №244. Они применяются при
      проектировании на площадках сейсмичностью 7, 8 и 9 баллов — ровно в том же диапазоне, что и
      федеральный свод правил.
    </p>

    <h2 style="margin:36px 0 18px">Что меняет каждый балл</h2>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Расчётная сейсмичность, пиковое ускорение и последствия для основания крана</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Расчётная сейсмичность</th><th scope="col" role="columnheader">Пиковое ускорение</th><th scope="col" role="columnheader">Что это значит на площадке</th></tr>
        </thead>
        <tbody>
          <tr role="row"><th scope="row" role="rowheader">6 баллов и ниже</th><td role="cell" data-label="Пиковое ускорение">—</td><td role="cell" data-label="Что это значит на площадке">Сейсмические нагрузки в расчёт основания не вводят: свод правил распространяется на площадки от 7 баллов</td></tr>
          {zones.map((z) => (
            <tr role="row">
              <th scope="row" role="rowheader"><a href={z.href} style="color:var(--accent);font-weight:700">{z.ball}</a></th>
              <td role="cell" data-label="Пиковое ускорение">{z.accel}</td>
              <td role="cell" data-label="Что это значит на площадке">{z.what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Главное в этой таблице — не сами числа, а шаг между ними. Пиковое ускорение удваивается на
      каждый балл: 0,1g при семи, 0,2g при восьми, 0,4g при девяти на средних грунтах. Разница между
      «восемь» и «девять» в документе выглядит как единица, а в расчёте анкеровки и фундамента — как
      двукратная горизонтальная нагрузка. Именно поэтому уточнять балл площадки дешевле на этапе
      заявки, чем пересчитывать проект после.
    </p>

    <h2 style="margin:36px 0 18px">Города края внутри зон</h2>
    <p>
      Таблицу баллов по населённым пунктам мы не перепечатываем: она есть в приложении к
      СП 14.13330.2018, различается от карты к карте, а для проекта всё равно нужен балл площадки, а
      не города. По краю в целом картина такая: Краснодарский край относится к сейсмоопасным
      регионам с расчётной сейсмичностью в диапазоне 7–9 баллов в зависимости от площадки и уровня
      ответственности объекта, причём Черноморское побережье — включая Сочи и прилегающие районы —
      находится в верхней части этого диапазона, а равнинная часть края в нижней.
    </p>
    <p>
      При этом у каждого города края есть свой фактор, который решает не меньше сейсмичности, и живёт
      он на соответствующем этапе:
    </p>
    <ul>
      <li><b>Сочи и побережье</b> — высокая расчётная сейсмичность площадок и курортное окружение стройки: <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">монтаж и анкеровка</a>, <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">режим тишины в высокий сезон</a>.</li>
      <li><b>Анапа</b> — рыхлый прибрежный песок III категории и соседство с ООПТ пересыпи: <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">изыскания и грунт</a>.</li>
      <li><b>Новороссийск</b> — норд-ост, который отбирает у графика дни целиком: <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">эксплуатация</a>.</li>
      <li><b>Краснодар</b> — градостроительный регламент исторического поселения, определяющий сам выбор техники: <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">проект и ППР</a>.</li>
      <li><b>Армавир</b> — не побережье, но по Приложению Б ТСН 22-302-2000 расчётная сейсмичность площадки почти как в Сочи: <a href="/blog/kran-dlya-promzony-armavira/" style="color:var(--accent)">кран для промзоны Армавира</a>.</li>
      <li><b>Горячий Ключ</b> — фоновая сейсмичность как на побережье, но на оползневых склонах юга города генплан предписывает поднимать балл ещё выше: <a href="/blog/kran-dlya-goryachego-klyucha/" style="color:var(--accent)">кран для Горячего Ключа</a>.</li>
      <li><b>Апшеронский район</b> — генплан Нефтегорского поселения делит площадки на три категории сложности освоения и поимённо называет улицы в оползневой зоне: <a href="/blog/kran-dlya-apsheronskogo-rayona/" style="color:var(--accent)">кран для Апшеронского района</a>.</li>
      <li><b>Мостовской район</b> — карта А даёт 7 баллов, карта В — 8, но региональный СНКК 22-301-2000 закрывает развилку фиксированной восьмёркой для всего поселения: <a href="/blog/kran-dlya-mostovskogo-rayona/" style="color:var(--accent)">кран для Мостовского района</a>.</li>
    </ul>

    <h2 style="margin:36px 0 18px">Разборы по баллам</h2>
    <dl class="factline" style="max-width:none">
      {zones.map((z) => (
        <div>
          <dt><a href={z.href} style="color:var(--accent)">Площадка {z.ball}</a></dt>
          <dd>{z.note}</dd>
        </div>
      ))}
    </dl>

    <!-- Волна 20: раздел — оглавление трёх страниц ниже, и раньше здесь стоял тот
         же полный список источников ещё раз почти дословно. Вместо копии — ссылки
         на страницы, где каждая цитата уже есть целиком. -->
    <Sources
      checked={CHECKED}
      seeAlso={zones.map((z) => ({ href: z.href, label: `Площадка ${z.ball}` }))}
      note="Карты ОСР-2015 и ТСН 22-302-2000 общие для всех трёх зон и процитированы на каждой странице."
    />
    <p class="honest">
      Балл конкретного адреса по телефону мы не называем: без карты микрорайонирования или отчёта по
      изысканиям это была бы догадка. Мы говорим, какой из трёх источников у вас есть и что из него
      следует для проекта монтажа.
    </p>

    <p style="margin-top:26px"><a class="btn" href="/#order">Прислать данные по площадке <span aria-hidden="true">→</span></a></p>
  </section>
</main>
</BaseLayout>
