---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneStrip from '../../../components/ZoneStrip.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Площадка 7 баллов: нижняя граница сейсмического расчёта';
const description =
  'Что значит расчётная сейсмичность 7 баллов для монтажа крана: пиковое ускорение 0,1g, граница применения СП 14.13330.2018 и ТСН 22-302-2000, роль грунта.';
const SITE = 'https://kran-kuban.ru';
const CHECKED = '12 августа 2026 года';

// Волна 33 (GEO). Три пути в семибалльную зону были списком — переведены в
// таблицу без единого нового факта: источник, что он даёт и насколько ему
// можно верить как исходным данным для расчёта. Ниже по странице тот же
// порядок точности повторён в разделе про источники балла.
const paths = [
  {
    src: 'Карта ОСР-2015 в составе СП 14.13330.2018',
    gives: 'Фоновый балл района для средних грунтовых условий (II категория)',
    trust: 'Ориентир на этапе заявки. Конкретный балл зависит от применяемой карты, то есть от уровня ответственности объекта',
  },
  {
    src: 'Отчёт по инженерно-геологическим изысканиям площадки',
    gives: 'Фактическую категорию грунта участка вместо средней',
    trust: 'Годится как исходные данные: рыхлые пески и мягкие глины III категории сдвигают оценку вверх относительно карты',
  },
  {
    src: 'Карта сейсмического микрорайонирования (СМР)',
    gives: 'Балл конкретного участка, а не населённого пункта целиком',
    trust: 'Самый точный источник. Он же объясняет, почему соседние площадки получают разные значения',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Сейсмические зоны', item: `${SITE}/seysmozony/` },
    { '@type': 'ListItem', position: 3, name: 'Площадка 7 баллов', item: `${SITE}/seysmozony/7-ballov/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/seysmozony/7-ballov/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/seysmozony/">Сейсмические зоны</a><span aria-hidden="true">/</span><span aria-current="page">7 баллов</span>
  </nav>

  <div class="wrap"><ZoneStrip current={7} /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Расчётная сейсмичность · 0,1g</span>
    <h1>Площадка 7 баллов: там, где сейсмический расчёт только начинается</h1>
    <p class="dossier__lead">
      Расчётная сейсмичность 7 баллов — нижняя граница, с которой сейсмику вообще вводят в расчёт:
      пиковое ускорение на средних грунтах 0,1g, и площадка попадает под СП 14.13330.2018 и краевые
      ТСН 22-302-2000, действующие в диапазоне 7–9 баллов. Ниже семи баллов сейсмические нагрузки в
      расчёт основания крана не вводят вовсе — начиная с семи в проекте монтажа появляется отдельный
      раздел и отдельные дни работы.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Порог, а не оттенок</h2>
    <p>
      СП 14.13330.2018 распространяется на проектирование зданий и сооружений на площадках с
      расчётной сейсмичностью 7, 8 и 9 баллов по шкале MSK-64. Краевые нормы ТСН 22-302-2000
      применяются в том же диапазоне — 7, 8 и 9 баллов. То есть переход площадки с шести баллов на
      семь не увеличивает нагрузку «немного»: он превращает расчёт без сейсмики в расчёт с сейсмикой,
      добавляя в проект монтажа крана отдельный раздел и отдельные дни работы.
    </p>
    <p>
      Пиковое сейсмическое ускорение для семи баллов на средних грунтах — 0,1g. Это вчетверо меньше,
      чем при девяти баллах, но не ноль: горизонтальная составляющая нагрузки на анкеровку и
      фундамент башенного крана считается наравне с ветровой.
    </p>

    <h2 style="margin:36px 0 18px">Как площадка попадает в семь баллов</h2>
    <p>
      Равнинная часть Краснодарского края лежит в нижней части общего краевого диапазона 7–9 баллов,
      но откуда именно взят балл конкретной площадки — вопрос источника. Их три, и они дают разный
      по надёжности ответ.
    </p>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Три источника расчётной сейсмичности площадки и их надёжность</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Источник</th><th scope="col" role="columnheader">Что даёт</th><th scope="col" role="columnheader">Насколько годится как исходные данные</th></tr>
        </thead>
        <tbody>
          {paths.map((p) => (
            <tr role="row"><th scope="row" role="rowheader">{p.src}</th><td role="cell" data-label="Что даёт">{p.gives}</td><td role="cell" data-label="Насколько годится как исходные данные">{p.trust}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Именно поэтому «в этом районе шесть баллов» — не аргумент до того, как посмотрели на грунт.
      Самая неприятная ситуация — обнаружить сейсмический раздел в проекте уже после того, как
      подписан срок: расчёт основания добавляет к этапу проектирования дни, а не часы.
    </p>

    <h2 style="margin:36px 0 18px">Что это меняет для башенного крана</h2>
    <dl class="factline">
      <div>
        <dt>Проект монтажа</dt>
        <dd>В расчёт основания входит сейсмическая нагрузка рядом с ветровой. Это не отдельная услуга и не опция «по запросу», а часть базового проекта для площадки в зоне.</dd>
      </div>
      <div>
        <dt>Исходные данные</dt>
        <dd>Нужен документ, из которого взят балл: карта СМР, отчёт по изысканиям или список населённых пунктов свода правил — с указанием источника прямо в расчёте.</dd>
      </div>
      <div>
        <dt>Автокран на этой же площадке</dt>
        <dd>Сейсмики не касается вовсе: у него нет капитального основания. Его вопрос — несущая способность грунта под выносной опорой здесь и сейчас.</dd>
      </div>
      <div>
        <dt>График</dt>
        <dd>Появляется дополнительный расчётный этап до выхода техники. Его закладывают в срок заранее — вместе с пятидневной передачей ППР на площадку.</dd>
      </div>
    </dl>

    <p style="margin-top:26px">
      Соседние зоны: <a href="/seysmozony/8-ballov/" style="color:var(--accent)">8 баллов — 0,2g</a>,
      <a href="/seysmozony/9-ballov/" style="color:var(--accent)">9 баллов — 0,4g</a>. Что происходит с
      основанием дальше по циклу — на этапе
      <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.
    </p>

    <Sources checked={CHECKED} items={[
      { href: 'https://files.stroyinf.ru/Data2/1/4293736/4293736459.htm', label: 'files.stroyinf.ru — СП 14.13330.2018: область применения 7–9 баллов, категории грунтов, пиковое ускорение 0,1g при 7 баллах' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018, карты ОСР-2015' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края: площадки 7, 8 и 9 баллов' },
    ]} />
  </section>
</main>
</BaseLayout>
