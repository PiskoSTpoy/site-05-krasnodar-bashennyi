---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 82. Семнадцатая статья блога — Сочи. Курортный город блог упоминал
// косвенно (сейсмика 8-9 баллов уже задокументирована в статье «Инженерные
// изыскания перед монтажом крана»), но собственной страницы, в отличие от
// десяти других городов и районов края, у него не было — при том что это
// самый очевидный по названию город сети.
//
// Причина, почему страница не была написана раньше, видна по итогу
// исследования: очевидный угол «курортный бум, много строек» оказался бы
// НЕЧЕСТНЫМ. С 1 июля 2021 года в Сочи действует мораторий на точечное
// строительство многоквартирных домов (источник: РБК-Недвижимость), почти
// пять лет спустя всё ещё в силе (источник: sochi1.ru, 18.07.2026) — за
// последние полтора года выдано всего ОДНО разрешение на многоквартирный
// дом (ул. Виноградная, Мамайка, 93 квартиры). Новый генплан (утверждён в
// конце 2023 года, источник: Коммерсантъ Краснодар) разрешает многоэтажную
// застройку точечно — только в Хостинском районе, Кудепсте и на северном
// склоне Бытхи, и только там, где уже есть проект планировки. Ноябрьский
// (2025) статус «курорт федерального значения» и расширение нацпарка снова
// требуют актуализации генплана (источник: sochi1.ru). Статья построена
// вокруг этой честной, менее очевидной картины, а не вокруг предположения
// о буме — ровно тот же принцип честности, что применён к сейсмике Туапсе
// (Волна 77) и ветру Ейска (Волна 76).
//
// Сейсмика 8-9 баллов для Сочи в статье НЕ новое утверждение — оно уже
// стоит (со ссылками на СП 14.13330.2018 и ТСН 22-302-2000) в статье
// «Инженерные изыскания перед монтажом крана», сюда перенесено с той же
// ссылкой, не как отдельно проверяемый факт этой волны.

const CHECKED = '7 сентября 2026 года';

const title = 'Кран для Сочи: мораторий на многоэтажки и где сейчас реально строят';
const description = 'В Сочи почти пять лет мораторий на многоэтажки — за полтора года одно разрешение. Где по генплану можно строить и при чём тут башенный кран.';
const h1 = 'Кран для Сочи: мораторий на многоэтажки и где сейчас реально строят';
const crumbTitle = 'Кран для Сочи';
const slug = 'kran-dlya-sochi';

const H2 = [
  'Сочи — не стройплощадка «по умолчанию»: что изменилось с 2021 года',
  'Одно разрешение за полтора года: Виноградная улица в Мамайке',
  'Где по новому генплану всё-таки можно строить выше: Хостинский район, Кудепста, склон Бытхи',
  'Курорт федерального значения: почему генплан снова пересматривают',
  'Сейсмика и закон о тишине — общие для края нормы, действуют и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Если в Сочи мораторий на многоэтажки, кран сюда вообще имеет смысл заказывать?',
    a: 'Да, но профиль спроса другой, чем на остальном побережье края. Массовой точечной жилой застройки почти нет — под мораторий она и вводилась. Спрос смещён в сторону крупных объектов внутри уже утверждённых проектов планировки (Хостинский район, Кудепста, склон Бытхи), КРТ-проектов и единичных разрешений вроде дома на Виноградной улице в Мамайке, а также объектов, которые не подпадают под мораторий на многоквартирные дома напрямую — инфраструктуры, соцобъектов, индивидуального строительства площадью и высотой в установленных пределах. Для башенного крана это чаще означает не короткий эпизод на одном доме, а более длительный контракт на площадке с уже согласованным проектом — что как раз укладывается в помесячную логику расчёта, разобранную в разделе «Смета владения» на главной странице.',
  },
  {
    q: 'Какая расчётная сейсмичность площадки в Сочи?',
    a: 'Сочи — часть территории края с сейсмичностью 8-9 баллов по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, как уже разобрано в статье «Инженерные изыскания перед монтажом крана». Расчёт основания и анкеровки крана должен учитывать сейсмическую нагрузку в дополнение к ветровой. Точный балл для конкретной площадки без карты сейсмического микрорайонирования не назначается автоматически по общему диапазону — см. статью «Сейсмическое микрорайонирование площадки».',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Сочи', item: `${SITE}/blog/kran-dlya-sochi/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-sochi/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-sochi/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Сочи — самый очевидный по названию город в зоне обслуживания края, и самый обманчивый по контенту блога: страницы про него до сих пор не было. Причина видна из фактов ниже — очевидный угол «курортный город, вечная стройка» оказался бы прямо неверным. С 2021 года в Сочи действует один из самых жёстких в стране мораториев на точечную жилую застройку, и это меняет не то, нужен ли здесь башенный кран, а то, где именно и на каких объектах он нужен.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>С 1 июля 2021 года в Сочи приостановлена выдача разрешений на строительство многоквартирных домов — временный мораторий должен был действовать «не менее двух лет», пока город разрабатывает новый генеральный план (источник: РБК-Недвижимость). По факту прошло почти пять лет, и по данным на июль 2026 года ограничение всё ещё в силе (источник: sochi1.ru). До утверждения новых правил землепользования и застройки без общественных слушаний в городе можно строить только индивидуальные дома площадью до 300 м² и высотой не более 12 м — многоквартирный формат по умолчанию закрыт.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Масштаб ограничения — не риторика, а конкретная цифра: за последние полтора года (на июль 2026 года) в Сочи выдано всего одно разрешение на строительство многоквартирного дома — на улице Виноградной в Мамайке, 93 квартиры и детский сад (источник: sochi1.ru). За тот же период строительство многоквартирных домов в городе сократилось на треть. Для подрядчика, который ищет объект с краном на несколько месяцев, это означает: типового «дом на районе» на выбор здесь почти нет, и каждый такой проект — событие, а не рутина.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Мораторий не абсолютный — генплан Сочи, утверждённый в конце 2023 года, прямо разрешает многоэтажную застройку в нескольких названных локациях: Хостинском районе, Кудепсте и на северном склоне горы Бытха, а среднеэтажную — в микрорайоне КСМ, той же Кудепсте и селе Верхний Юрт Хостинского района (источник: «Коммерсантъ Краснодар»). Условие для этих зон одно и то же: строить можно там, где уже утверждён проект планировки территории и выдано разрешение на строительство — то есть не в любой точке названного района, а в конкретных, заранее согласованных границах. Для крана это значит, что спрос концентрируется не по всему городу равномерно, а в нескольких предсказуемых точках, которые стоит знать заранее, а не искать по факту звонка заказчика.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Генплан 2023 года снова пересматривается — и снова по внешней, а не строительной причине. В ноябре 2025 года Сочи официально признан курортом федерального значения, параллельно расширены границы Сочинского национального парка, и оба изменения статуса требуют актуализации генплана и подготовки новых правил землепользования и застройки в согласовании с региональными властями (источник: sochi1.ru, со ссылкой на мэра города Андрея Прошунина). Ориентир по срокам — до конца 2026 года, но дата не единожды сдвигалась уже внутри самого 2026 года. Практический вывод для планирования: границы разрешённой застройки в Сочи — не статичная карта на годы вперёд, а документ, который стоит перепроверять перед каждым новым проектом, а не полагаться на состояние 2023 года.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>На фоне местных ограничений по застройке действуют и общекраевые нормы, одинаковые для всего побережья. Сочи входит в часть территории края с расчётной сейсмичностью 8-9 баллов по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000 — подробный разбор в статье <a href="/blog/izyskaniya-pered-montazhom-krana/" style="color:var(--accent)">«Инженерные изыскания перед монтажом крана»</a> и в разделе <a href="/seysmozony/9-ballov/" style="color:var(--accent)">«Сейсмозона 9 баллов»</a>. Режим тишины по закону края №608-КЗ (в редакции №5423-КЗ, действующей с 1 марта 2026 года) в Сочи такой же, как в Туапсе, Ейске или Анапе: рабочие окна 08:00–13:00 и 15:00–23:00 в будни, 10:00–13:00 и 15:00–23:00 в выходные — подробности и штрафы в статье <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a>. Курортный статус города добавляет не отдельную норму, а более высокую вероятность жалобы в разгар сезона — та же логика, что уже разобрана для других городов побережья в статье <a href="/blog/seysmika-i-zakon-o-tishine/" style="color:var(--accent)">«Сейсмика и закон о тишине на Кубани»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>С 1 июля 2021 года в Сочи действует мораторий на точечное строительство многоквартирных домов — спустя почти пять лет всё ещё в силе (на июль 2026 года).</li>
      <li>За последние полтора года выдано одно разрешение на многоквартирный дом — ул. Виноградная, Мамайка, 93 квартиры; строительство многоквартирных домов в целом сократилось на треть.</li>
      <li>Генплан 2023 года разрешает многоэтажную застройку точечно — в Хостинском районе, Кудепсте и на склоне горы Бытха, только там, где уже утверждён проект планировки.</li>
      <li>Статус «курорт федерального значения» (ноябрь 2025) и расширение нацпарка снова требуют актуализации генплана — границы разрешённой застройки стоит перепроверять перед каждым проектом.</li>
      <li>Сейсмика 8-9 баллов и закон о тишине №608-КЗ (ред. №5423-КЗ) — общекраевые нормы, действующие в Сочи так же, как на остальном побережье.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://realty.rbc.ru/news/60db35e99a79478c83af6285', label: 'РБК-Недвижимость — введение моратория на многоквартирную застройку в Сочи с 1 июля 2021 года' },
      { href: 'https://sochi1.ru/text/gorod/2026/07/18/76541470/', label: 'sochi1.ru (18.07.2026) — сокращение стройки многоквартирных домов на треть, одно разрешение за полтора года (ул. Виноградная, Мамайка), актуализация генплана' },
      { href: 'https://www.kommersant.ru/doc/6562686', label: 'Коммерсантъ Краснодар — генплан Сочи 2023 года: где разрешена многоэтажная застройка (Хостинский район, Кудепста, склон Бытхи)' },
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/', label: 'приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026) — нормы работы башенного крана' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — закон №5423-КЗ, границы режима тишины с 01.03.2026 и размеры штрафов по ст. 3.3' },
    ]} />
</BlogArticleLayout>
