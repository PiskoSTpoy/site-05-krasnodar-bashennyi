---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 115. Девяносто первая статья блога — угол (c) региональный.
// Кавказский район — восток края, райцентр Кропоткин (отдельная статья
// kran-dlya-kropotkina). Структура блоков: от земли и транспорта к границам.
//
// Фактура — один источник (curl -sk, проверено 18.10.2026):
// smokk.ru/about/association-members/kavkazskiy-rayon — население 117 857 (01.01.2022),
// 116 926 (2023), 115 971 (2024), 115 168 (01.01.2025); администрация — г. Кропоткин,
// ул. Красная, 37; Кропоткинское городское и 8 сельских поселений (Дмитриевское,
// Кавказское, Казанское, Лосевское, Мирское, Привольное, им. М. Горького, Темижбекское);
// границы: Тихорецкий и Новопокровский районы, Ставропольский край, река Кубань
// (юго-восток), Тбилисский район; общая площадь 122 745 га, сельхозугодья 92 507 га;
// зерновые и зернобобовые 43 654 га (48,6 %), кукуруза 14 756 га, сахарная свёкла 8421 га
// (9,6 %), подсолнечник 11 721 га (13 %), соя 4680 га (5,3 %); 8 крупных и средних
// хозяйств, 235 КФХ, 16 897 ЛПХ; станция «Кавказская» (г. Кропоткин), магистраль
// «Кавказ», «Темрюк—Краснодар—Ставрополь»; история: 02.06.1924 Кропоткинский район,
// 26 сельсоветов; 31.12.1934 выделены Гулькевичский и Тифлисский; 25.01.1944
// переименован в Кавказский; 11.02.1963 включены Гулькевичский и Тбилисский;
// 30.12.1966 Тбилисский восстановлен; 20.10.1980 Гулькевичский выделен;
// 01.01.2006 статус муниципального района; 08.08.2008 Кропоткин — городское поселение.
// Расчёты: площадь 1227,45 км²; доля угодий 75,4 %; убыль 2022→2025 = 2689 чел. (2,3 %);
// плотность ≈ 93,8 чел./км² (с городом Кропоткином).
// НЕ названо: грунт, климат, расстояние до Краснодара, балл сейсмичности, цены.

const CHECKED = '18 октября 2026 года';
const PUBLISHED = '2026-10-18';

const title = 'Кран для Кавказского района: 1227 км² и 115 168 жителей';
const description = 'Кавказский район — 1227 км², 115 168 жителей на 01.01.2025, 9 поселений, узел «Кавказ». Где нужен башенный кран и какую модель выбрать под объект.';
const h1 = 'Кран для Кавказского района: какой башенный кран нужен на востоке края';
const crumbTitle = 'Кран для Кавказского района';
const slug = 'kran-dlya-kavkazskogo-rayona';

const H2 = [
  '75 % земли — угодья: что это значит для стройки',
  '9 поселений и 115 168 жителей: плотность 93,8 чел./км²',
  'Транспортный узел: станция «Кавказская» и магистраль «Кавказ»',
  'Границы района и Кубань на юго-востоке',
  'Хронология 1924–2008: 84 года смены границ',
  'Что район не сообщает: грунт, сейсмика и тишина',
  'Какую модель брать под объект района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Кавказского района?',
    a: '122 745 га, то есть около 1227 км² по данным ассоциации «Совет муниципальных образований Краснодарского края» (СМОКК). Из них 92 507 га — сельскохозяйственные угодья, около 75,4 %. Пересчёт в км² и доля — расчёт КРАН-КУБАНЬ.',
  },
  {
    q: 'Сколько людей живёт в Кавказском районе?',
    a: '115 168 человек на 1 января 2025 года по данным СМОКК. На 1 января 2022 года было 117 857, за три года население уменьшилось на 2689 человек, или на 2,3 %. Плотность — около 93,8 человека на км² вместе с городом Кропоткином.',
  },
  {
    q: 'Из чего состоит Кавказский район?',
    a: 'Из Кропоткинского городского поселения и 8 сельских: Дмитриевского, Кавказского, Казанского, Лосевского, Мирского, Привольного, поселения имени М. Горького и Темижбекского. Администрация района находится в Кропоткине на улице Красной, 37.',
  },
  {
    q: 'Какая сейсмичность в Кавказском районе?',
    a: 'СМОКК балл сейсмичности района не приводит, и КРАН-КУБАНЬ не называет его без первоисточника. Значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000, а при необходимости уточняют микрорайонированием.',
  },
  {
    q: 'Какой башенный кран подойдёт для объекта в районе?',
    a: 'Выбор зависит от высоты, вылета и основания. Для невысокого объекта до 41,7 м КРАН-КУБАНЬ предлагает giraFFe SMK-5.66, для длинного корпуса — КБ-408.21 или Potain MDT 219 J10 на рельсовом пути, для груза до 12,5 т — КБ-674А.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Восток края"
  published={PUBLISHED}
>
    <p slot="intro">Кавказский район занимает 122 745 га, около 1227 км², на востоке Краснодарского края, и на 1 января 2025 года в нём жили 115 168 человек. Для башенного крана КРАН-КУБАНЬ из описания района важны три числа: 75,4 % земли занимают сельхозугодья, 9 поселений входят в район вместе с Кропоткином и 2689 человек — убыль населения за три года.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Из 122 745 га общей площади района сельскохозяйственные угодья занимают 92 507 га, то есть 75,4 % (расчёт КРАН-КУБАНЬ по данным СМОКК). Основа растениеводства — зерновые и технические культуры: зерновые и зернобобовые на 43 654 га (48,6 % посевной площади), подсолнечник на 11 721 га (13 %), сахарная свёкла на 8421 га (9,6 %), соя на 4680 га (5,3 %), кукуруза на 14 756 га.</p>
    <p>Для башенного крана из этого вытекает типичный заказ района: зернохранилище, цех переработки или жилой корпус при центре, которые строят рядом с полями, а не в плотной застройке. Хозяйства района — 8 крупных и средних, 235 крестьянских хозяйств и 16 897 личных подсобных — названы в источнике, но КРАН-КУБАНЬ не приписывает им строек: сведений о заказах нет.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>В районе девять муниципальных образований: Кропоткинское городское и 8 сельских, Дмитриевское, Кавказское, Казанское, Лосевское, Мирское, Привольное, имени М. Горького и Темижбекское. Население за три года уменьшилось со 117 857 до 115 168 человек, динамика по датам — в таблице; убыль и плотность рассчитаны инженерной службой, в источнике их нет.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Дата</th><th>Население, чел.</th><th>Изменение к 2022 году</th></tr></thead>
      <tbody>
        <tr><td>01.01.2022</td><td>117 857</td><td>—</td></tr>
        <tr><td>01.01.2023</td><td>116 926</td><td>−931</td></tr>
        <tr><td>01.01.2024</td><td>115 971</td><td>−1886</td></tr>
        <tr><td>01.01.2025</td><td>115 168</td><td>−2689 (−2,3 %)</td></tr>
      </tbody>
    </table></div>
    <p>Плотность — около 93,8 человека на км²: в 5 раз больше, чем у Новопокровского района (≈18,9), хотя два района граничат. Причина понятна из состава: в Кавказский район по СМОКК входит город Кропоткин, и без него плотность сельской части была бы ниже. Отдельно город разобран в статье <a href="/blog/kran-dlya-kropotkina/">«Кран для Кропоткина»</a>; КРАН-КУБАНЬ при заявке уточняет поселение и адрес участка.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Кавказский район по описанию СМОКК — транспортный узел с выходом ко всем регионам края: через железнодорожную станцию «Кавказская» в городе Кропоткине идут грузопотоки юга России, а в автодорожный узел сходятся федеральная автомагистраль «Кавказ» и дорога краевого и регионального значения «Темрюк—Краснодар—Ставрополь». Для КРАН-КУБАНЬ это логистический довод.</p>
    <p>Железнодорожная станция и две магистрали означают, что секции башенного крана и рельсовый путь доставляют по имеющимся федеральным и региональным дорогам, а не по просёлкам. Негабаритный груз всё равно требует согласования маршрута, и расчёт КРАН-КУБАНЬ делает по адресу объекта. Расстояния до Краснодара и сроки доставки в источнике не названы, поэтому в статье их нет.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Район расположен на востоке края: на севере граничит с Тихорецким и Новопокровским районами, на востоке — со Ставропольским краем, на юго-востоке граница идёт по руслу реки Кубань, на западе — Тбилисский район. Эти границы заданы естественными межевыми урочищами, как сказано в источнике, поэтому для объектов у реки заказчику нужна отдельная проверка отметок и уровня воды.</p>
    <p>Для башенного крана у русла Кубани КРАН-КУБАНЬ рекомендует начинать с изысканий: грунт и грунтовые воды определяют, ставить кран на рельсовый путь или на монолитный фундамент. Состав работ описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>, а выбор основания — в <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Данных о грунтах района СМОКК не даёт.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Район образован 2 июня 1924 года под названием Кропоткинский, в 26 сельских советов, и за 84 года неоднократно менял состав и имя. Хронология из описания СМОКК — в таблице; она нужна, когда архивные документы по участку могут лежать в архиве соседнего района.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Дата</th><th>Что произошло</th></tr></thead>
      <tbody>
        <tr><td>02.06.1924</td><td>Образован Кропоткинский район, 26 сельских советов</td></tr>
        <tr><td>31.12.1934</td><td>Выделены Гулькевичский и Тифлисский районы</td></tr>
        <tr><td>25.01.1944</td><td>Центр перенесён в станицу Кавказскую, район переименован в Кавказский</td></tr>
        <tr><td>11.02.1963</td><td>Включены территории Гулькевичского и Тбилисского районов</td></tr>
        <tr><td>30.12.1966</td><td>Тбилисский район восстановлен в прежних границах</td></tr>
        <tr><td>20.10.1980</td><td>Гулькевичский район вновь выделен, центр — станица Кавказская</td></tr>
        <tr><td>01.01.2006</td><td>Статус муниципального района, 8 сельских поселений</td></tr>
        <tr><td>08.08.2008</td><td>Город Кропоткин — городское поселение в составе района</td></tr>
      </tbody>
    </table></div>
    <p>Практический вывод КРАН-КУБАНЬ — рекомендация, а не норма: если участок на западе или юго-западе района, проверка архивных схем коммуникаций может вести в Тбилисский или Гулькевичский район. Соседние районы разобраны в статьях <a href="/blog/kran-dlya-tbilisskogo-rayona/">«Кран для Тбилисского района»</a> и <a href="/blog/kran-dlya-gulkevichey/">«Кран для Гулькевичей»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Описание Кавказского района в СМОКК не содержит балла сейсмичности, данных о грунтах и климате, и КРАН-КУБАНЬ не подставляет на их место цифры из других источников. Сейсмичность площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000 (<a href="/blog/seysmicheskoe-mikrorayonirovanie/">разбор микрорайонирования</a>).</p>
    <p>Краевой закон № 608-КЗ о тишине действует на всей территории района, включая Кропоткин и сельские поселения. График монтажа и подъёмов КРАН-КУБАНЬ согласует с заказчиком до выезда, а исключения для строительных работ описаны в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Модель под объект в Кавказском районе КРАН-КУБАНЬ выбирает по высоте, вылету и основанию; ориентиры инженерной службы — в таблице. Если корпус невысокий и вытянутый, первыми рассматривают модели с большим вылетом и без набора высоты свыше 54 м.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Задача на участке</th><th>Модель парка КРАН-КУБАНЬ</th><th>Параметр из реестра</th></tr></thead>
      <tbody>
        <tr><td>Невысокий корпус до 41,7 м</td><td>giraFFe SMK-5.66</td><td>Контур 4×4 м, монтаж 4–6 часов</td></tr>
        <tr><td>Длинный склад или цех</td><td>Potain MDT 219 J10</td><td>Вылет 65 м, 1,9 т на конце</td></tr>
        <tr><td>Корпус с набором секций</td><td>КБ-408.21</td><td>Вылет 40 м, крюк 54,0–72,7 м</td></tr>
        <tr><td>Тяжёлые блоки до 12,5 т</td><td>КБ-674А</td><td>5,6 т на 50,5 м</td></tr>
      </tbody>
    </table></div>
    <p>Вылеты всех пяти моделей сравниваются в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>, а соседний район на севере — в статье <a href="/blog/kran-dlya-novopokrovskogo-rayona/">«Кран для Новопокровского района»</a>. Адрес и параметры объекта можно прислать через <a href="/#order">форму на главной</a> — КРАН-КУБАНЬ назовёт модель и маршрут доставки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/kavkazskiy-rayon', label: 'smokk.ru — Кавказский муниципальный район: население, география, история, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
