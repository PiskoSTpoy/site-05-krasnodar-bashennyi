---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 110. Семьдесят шестая статья блога — угол (c) региональный.
// Щербиновский район — самая северная точка края (хутор Молчановка), побережье
// Ейского лимана и Таганрогского залива; соседи Староминский, Каневской и Ейский
// районы уже разобраны. Район в списке «не удалось проверить» волны 108 — найден
// источник: smokk.ru.
//
// Фактура — один источник (проверено 12.10.2026):
// - smokk.ru/about/association-members/shcherbinovskiy-rayon (Совет муниципальных
//   образований края; текст описания района без даты): население 34 029 (01.01.2022),
//   33 624, 33 422, 33 043 чел. (01.01.2025); площадь 1377 км²; Азово-Кубанская
//   низменность; отметка береговой полосы на 0,4 м ниже уровня моря; береговая линия
//   90 км; Глафировская коса 7 км; глина, песок, ракушечник; 481 мм осадков в год,
//   редкие и короткие дожди, преобладают северо-восточные ветры; трасса Краснодар —
//   Ейск, ветка Староминская — Ейск, станция Старощербиновская; дороги районного
//   значения 125,5 км; ОАО «Керамик» — кирпич марки 100, до 17 млн штук в год;
//   СПК «Родник» (молочная продукция); АПК: зерновые >50 % посевов.
// Расстояния до Краснодара на странице нет — не называется. Балл сейсмичности
// не назван (конвенция сайта с Волны 79). Цифры урожайности и «рейтинга хозяйств»
// на странице датированы 2005 годом — в статью не вынесены.

const CHECKED = '12 октября 2026 года';
const PUBLISHED = '2026-10-12';

const title = 'Кран для Щербиновского района: 1377 км² у Ейского лимана';
const description = 'В Щербиновском районе 1377 км², 33 043 жителя (на 01.01.2025) и берег на 0,4 м ниже уровня моря. Грунт, ветер и доставка для башенного крана.';
const h1 = 'Кран для Щербиновского района: какой башенный кран нужен на севере края у Ейского лимана';
const crumbTitle = 'Кран для Щербиновского района';
const slug = 'kran-dlya-shcherbinovskogo-rayona';

const H2 = [
  'Что известно о районе: площадь, люди, экономика',
  'Грунт: низменность, глина, песок и ракушечник',
  'Ветер и осадки: 481 мм и северо-восточный ветер',
  'Доставка: трасса Краснодар — Ейск и станция Старощербиновская',
  'Тишина и сейсмика: что считать на площадке',
  'Что проверить до заказа крана в районе',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Щербиновского района?',
    a: '1377 км² — такую цифру приводит ассоциация «Совет муниципальных образований Краснодарского края» (СМОКК) в описании района. Это общая площадь земель в границах муниципального образования, установленных краевым законом от 23 июня 2004 года.',
  },
  {
    q: 'Сколько людей живёт в Щербиновском районе?',
    a: '33 043 человека на 1 января 2025 года по данным СМОКК. За три года с 1 января 2022 года, когда было 34 029, население сократилось на 986 человек, или на 2,9 %. Плотность — около 24 человек на км².',
  },
  {
    q: 'Какой грунт в Щербиновском районе?',
    a: 'Район лежит на Азово-Кубанской низменности со спокойным рельефом. В описании района названы залежи глины, песка и ракушечника, а отметка береговой полосы — на 0,4 м ниже уровня моря. Несущую способность под путём или фундаментом определяют изыскания на конкретной площадке.',
  },
  {
    q: 'Как добраться до Щербиновского района из Краснодара?',
    a: 'По автодороге краевого значения «Краснодар — Ейск» и железнодорожной магистрали через станцию Староминскую; в районе есть станция Старощербиновская. Расстояние до Краснодара в описании района не указано, поэтому доставку считают по фактическому маршруту.',
  },
  {
    q: 'Нужен ли особый кран для работы у берега Ейского лимана?',
    a: 'Отдельной модели нет. У воды на низменности важны основание и ветровой расчёт, а не тип крана: путь или фундамент подбирают по изысканиям, ветровую зону — по проекту. КРАН-КУБАНЬ предлагает пять моделей парка и подбирает под высоту и вылет объекта.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Северо-запад края"
  published={PUBLISHED}
>
    <p slot="intro">Щербиновский район занимает 1377 км² на севере Краснодарского края, и 33 043 жителя на 1 января 2025 года делают его одним из малолюдных: около 24 человек на км². Для башенного крана КРАН-КУБАНЬ здесь важны три факта из описания района — низменность, берег на 0,4 м ниже уровня моря и северо-восточный ветер.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Щербиновский район по данным Совета муниципальных образований Краснодарского края имеет площадь 1377 км² и административный центр в станице Старощербиновской. С востока он граничит со Староминским районом, с юга — с Каневским, с юго-запада — с Ейским, а на северо-востоке — с Азовским районом Ростовской области. Хутор Молчановка — крайняя северная точка края.</p>
    <p>Население сокращается: 34 029 человек на 1 января 2022 года, 33 624 — в 2023-м, 33 422 — в 2024-м и 33 043 — в 2025-м. За три года минус 986 человек, или 2,9 %. Для заказчика башенного крана КРАН-КУБАНЬ вывод практический: при малой плотности населения бригаду и допуски крановщиков оговаривают в договоре заранее, а не набирают на месте.</p>
    <p>Промышленность района по описанию — пищевая и стеновые материалы. СМОКК называет три крупных и средних предприятия: СПК «Родник» (молочная промышленность), «Комбинат кооперативной промышленности» (хлебопечение) и ОАО «Керамик» (стеновые строительные материалы). Описание не датировано, и действующий статус этих предприятий перед заказом стоит проверить отдельно. Основа экономики — сельское хозяйство: зерновые и зернобобовые занимают свыше 50 % посевных площадей.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Территория Щербиновского района — часть Азово-Кубанской низменности со спокойным рельефом, который нарушают только долины рек, балки и курганы. Для башенного крана КРАН-КУБАНЬ ровная поверхность упрощает укладку рельсового пути под Potain MDT 219 J10 или КБ-408.21, но не отменяет изысканий: низменность — это не гарантия несущей способности.</p>
    <p>Описание района называет залежи природных строительных материалов — глины, песка и ракушечника — и указывает, что отметка береговой полосы лежит на 0,4 м ниже уровня моря. О грунтовых водах и несущей способности под фундаментом источник ничего не сообщает. Эти параметры даёт только бурение на площадке, и порядок работ описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Инженерные изыскания перед монтажом крана»</a>.</p>
    <p>Практическое следствие для площадок у лимана: путь или фундамент считают с запасом по водонасыщению, а осмотр пути проводят чаще. Как это делают после дождя, разобрано в статье <a href="/blog/vneocherednaya-proverka-relsovogo-puti-posle-livnya/">«Рельсовый путь крана после ливня»</a>, а выбор между двумя основаниями — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Щербиновский район относится к Приазовской климатической провинции недостаточного увлажнения: в среднем за год здесь выпадает 481 мм осадков, дожди редкие и короткие, а снежный покров зимой незначительный. Отсюда следует, что простоев крана из-за снега здесь почти нет, а главным фактором остаётся ветер.</p>
    <p>В описании района отмечено преобладание в течение года северо-восточных ветров. Для башенного крана КРАН-КУБАНЬ ветер определяет остановку работ и положение стрелы на стоянке: порядок действий записан в паспорте модели и в производственной инструкции. Как ветровая нагрузка связана с паспортом крана, разобрано в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>
    <p>На открытом берегу лимана и косы препятствий для ветра мало — это общее свойство ровной местности, а не данные источника. Конкретные скорости в источнике не названы, поэтому расчётные значения берут из проекта площадки и данных метеостанции, а не из описания района.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Связь района с Краснодаром идёт по автодороге краевого значения «Краснодар — Ейск» и железнодорожной ветке «Староминская — Ейск»; в самом районе есть станция Старощербиновская. Протяжённость дорог общего пользования районного значения — 125,5 км. Расстояние до краевого центра в описании района не указано, и КРАН-КУБАНЬ считает доставку по фактическому маршруту от базы до объекта.</p>
    <p>Для башенного крана доставка складывается из секций мачты, стрелы и противовеса, а не из одной машины. giraFFe SMK-5.66, который собирают за 4–6 часов с одним 25-тонным автокраном, на малонаселённом севере края часто оказывается оправданным: объекты небольшие, а подготовка тяжёлого основания окупается не всегда. Сравнение двух подходов — в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>
    <p>Стеновые материалы у района свои: ОАО «Керамик» по описанию выпускает кирпич марки 100, до 17 млн штук в год. Для объекта это означает короткое плечо подвоза кирпича, и плотность поставок определяет вылет, на котором работает кран. Расчёт вылета под график подачи приведён в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края № 608-КЗ о тишине действует во всех районах края, и Щербиновский не исключение. Часы работы крана и монтажной техники планируют по закону, а не по привычке бригады. Подробный разбор часов и исключений для строительных работ — в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>
    <p>Балл сейсмичности Щербиновского района в источнике района не назван, и в статье он не указан намеренно. Расчётное значение для площадки берут из карт ОСР и ТСН 22-302-2000, а при необходимости — из сейсмического микрорайонирования. Порядок и сроки заказа карты описаны в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Район сельскохозяйственный, и высотных объектов в описании района не названо. Когда высота объекта не выше 41,7 м, подходит giraFFe SMK-5.66, а КБ-674А с высотой 116–120 м приставным способом оправдан только для объекта, которому нужна такая высота.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Заказ крана в Щербиновском районе упирается в пять проверок, и первая из них — состав основания. КРАН-КУБАНЬ рекомендует пройти их до подачи заявки, а не после выезда техники.</p>
    <ol>
      <li>Заказать изыскания: глубина залегания воды и несущая способность — в описании района их нет.</li>
      <li>Определить высоту объекта и вылет подачи: от них зависит модель, а не от района.</li>
      <li>Проверить ветровую зону по проекту и метеоданным: открытый берег и северо-восточный ветер.</li>
      <li>Согласовать часы работы по закону № 608-КЗ и подъездной график техники.</li>
      <li>Уточнить расстояние и маршрут от базы до объекта, чтобы закрыть сроки доставки.</li>
    </ol>
    <p>Адрес и характеристики площадки можно прислать через <a href="/#order">форму на главной</a>; инженерная служба КРАН-КУБАНЬ подберёт модель из парка. Соседние районы разобраны в статьях <a href="/blog/kran-dlya-starominskogo-rayona/">«Кран для Староминского района»</a> и <a href="/blog/kran-dlya-eyska/">«Кран для Ейска»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/shcherbinovskiy-rayon', label: 'smokk.ru — Щербиновский муниципальный район: население, площадь, география, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
