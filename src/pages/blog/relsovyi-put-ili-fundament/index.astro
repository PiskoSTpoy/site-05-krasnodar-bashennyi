---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';
import { parkModels } from '../../../data/parkModels';

// Волна 98. Тридцать девятая статья блога — угол (b) коммерческий/
// сравнительный. «Быстромонтируемый или классический» (Волна 97) сравнивал
// типы кранов; эта статья — следующий выбор внутри классического крана:
// рельсовый ход или стационарный фундамент. Карточки Potain MDT 219 J10 и
// Potain MCH 175 прямо говорят «путь или фундамент — решение проекта», но
// критериев выбора на сайте не было.
//
// Фактура — только уже проверенная на сайте:
// - parkModels.ts: способы установки пяти моделей (таблица строится из реестра);
// - карточка КБ-408.21: база и колея 7,5×7,5 м, масса 63,5 т, противовес 45 т;
//   СП 12-103-2002 — нагрузка колеса на рельс до 325 кН;
// - этап «Монтаж и анкеровка»: ГОСТ 35321-2025 с 01.01.2026 вместо
//   ГОСТ Р 51248-99; РД 22-28-35-99 — форма акта сдачи-приёмки пути.
// Сроков набора прочности бетона, стоимости фундамента и пути НЕ приводим:
// зависят от проекта, первоисточника с краевыми цифрами нет.

const CHECKED = '27 сентября 2026 года';
const PUBLISHED = '2026-09-27';

const title = 'Башенный кран на рельсах или на фундаменте: что выбрать';
const description = 'Рельсовый путь или фундамент для башенного крана: КБ-408.21 ходит по пути, Potain MDT 219 J10 и MCH 175 ставят на оба основания. Как выбрать по площадке.';
const h1 = 'Башенный кран на рельсовом пути или на фундаменте: что выбрать для объекта';
const crumbTitle = 'Рельсовый путь или фундамент';
const slug = 'relsovyi-put-ili-fundament';

const H2 = [
  'Основания пяти моделей парка КРАН-КУБАНЬ',
  'Рельсовый путь: один кран на длинный объект',
  'Фундамент: неподвижный кран на тесной площадке',
  'Сравнение рельсового пути и фундамента',
  'Документы: акт на путь и проект фундамента',
  'Сейсмичность и грунт на Кубани',
  'Как выбрать: пять вопросов к площадке',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Что лучше для башенного крана: рельсовый путь или фундамент?',
    a: 'Универсального ответа нет: рельсовый путь выгоден на длинном объекте, где один кран, двигаясь вдоль здания, заменяет два неподвижных. Фундамент выгоден на тесной площадке, где нет прямой полосы под путь. КРАН-КУБАНЬ выбирает основание по генплану, длине здания и изысканиям, а для Potain MDT 219 J10 и MCH 175 доступны оба варианта.',
  },
  {
    q: 'Какой нормативный документ регулирует крановые пути в 2026 году?',
    a: 'С 1 января 2026 года технические требования к наземным рельсовым крановым путям задаёт ГОСТ 35321-2025, заменивший ГОСТ Р 51248-99. Практику устройства и эксплуатации пути описывает СП 12-103-2002, форма акта сдачи-приёмки пути башенного крана приведена в РД 22-28-35-99. КРАН-КУБАНЬ не пускает кран по пути до подписания акта.',
  },
  {
    q: 'Можно ли поставить КБ-408.21 на фундамент?',
    a: 'В парке КРАН-КУБАНЬ КБ-408.21 работает на наземном рельсовом пути: база и колея 7,5×7,5 м, масса крана 63,5 т, противовес 45 т. Если площадка не позволяет уложить путь, инженерная служба подбирает модель, которую ставят на монолитный фундамент, — Potain MDT 219 J10 или Potain MCH 175.',
  },
  {
    q: 'Нужен ли фундамент быстромонтируемому крану?',
    a: 'Нет, giraFFe SMK-5.66 стоит на собственном опорном контуре 4×4 м без фундамента и без рельсового пути. Под четырьмя опорами проверяют покрытие и грунт, при слабом основании ставят подкладки. Этот кран КРАН-КУБАНЬ предлагает для невысоких объектов, где основание классического крана экономически избыточно.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Выбор крана · Сравнение"
  published={PUBLISHED}
>
    <p slot="intro">Рельсовый путь выгоден, когда объект длинный и один кран должен пройти вдоль всего здания, а фундамент — когда площадка тесная и кран стоит на одном месте весь срок стройки. В парке КРАН-КУБАНЬ КБ-408.21 работает только на рельсовом пути, Potain MDT 219 J10 и Potain MCH 175 ставят и на путь, и на монолитный фундамент, КБ-674А — на фундамент с анкеровкой к зданию. Выбор делает проект по генплану и изысканиям, а не каталог.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пять моделей парка КРАН-КУБАНЬ покрывают все три варианта основания башенного крана: рельсовый путь, монолитный фундамент и собственный опорный контур. Таблица собрана из реестра парка — тех же данных, что на карточках моделей:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Тип</th><th>Основание</th><th>Высота крюка</th></tr></thead>
      <tbody>
        {parkModels.map((m) => (
          <tr><td><a href={m.href}>{m.short}</a></td><td>{m.type}</td><td>{m.mount}</td><td>{m.hookHeight}</td></tr>
        ))}
      </tbody>
    </table></div>
    <p>Выбор между путём и фундаментом реально стоит у двух моделей КРАН-КУБАНЬ — Potain MDT 219 J10 и Potain MCH 175. Для КБ-408.21 основание задано конструкцией, для КБ-674А высота набирается креплением к зданию, а giraFFe SMK-5.66 обходится без фундамента. Поэтому вопрос «путь или фундамент» часто превращается в вопрос «какая модель», и отвечать на него начинают с площадки.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Главное преимущество рельсового пути — подвижность: башенный кран КРАН-КУБАНЬ на путях проходит вдоль здания и обслуживает объект длиннее, чем круг его вылета. Для КБ-408.21 с вылетом 40 м неподвижная установка закрывает круг диаметром 80 м, а путь вдоль фасада растягивает рабочую зону в полосу. На длинном жилом доме или цехе один кран на путях может заменить два неподвижных.</p>
    <p>Цена подвижности — прямая ровная полоса земли вдоль объекта и подготовленное основание под балластную призму и шпалы. У КБ-408.21 база и колея — 7,5×7,5 м, масса крана — 63,5 т с противовесом 45 т, и СП 12-103-2002 допускает нагрузку колеса на рельс до 325 кН. Геометрию пути под эти нагрузки КРАН-КУБАНЬ считает под каждую площадку отдельно, а путь занимает землю весь срок стройки.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Монолитный фундамент ставят, когда башенному крану КРАН-КУБАНЬ не нужно двигаться или некуда уложить путь: на точечной высотке, в плотной застройке, в котловане. Фундамент занимает пятно под мачтой, а не полосу вдоль здания, и оставляет место для складирования и проездов. Potain MDT 219 J10 с вылетом 65 м на фундаменте закрывает круг диаметром 130 м — для компактного здания этого хватает без передвижения.</p>
    <p>Цена неподвижности — бетонные работы до монтажа и время, пока бетон набирает прочность по проекту фундамента. Фундамент КРАН-КУБАНЬ проектируют под конкретную модель, нагрузки и грунт, а после стройки его закладную часть демонтируют или оставляют по решению проекта. Для Potain MCH 175 фундамент особенно логичен: маховая стрела сама сокращает вылет над соседями, и передвигать кран обычно не требуется.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Рельсовый путь и монолитный фундамент различаются по шести параметрам, которые КРАН-КУБАНЬ сверяет с генпланом каждого объекта:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>Рельсовый путь</th><th>Монолитный фундамент</th></tr></thead>
      <tbody>
        <tr><td>Рабочая зона</td><td>Полоса вдоль пути</td><td>Круг радиусом вылета</td></tr>
        <tr><td>Место на площадке</td><td>Прямая полоса по длине пути</td><td>Пятно под мачтой</td></tr>
        <tr><td>Подготовка</td><td>Земляное полотно, балласт, шпалы, рельсы</td><td>Котлован, арматура, бетон, закладная часть</td></tr>
        <tr><td>Приёмка</td><td>Акт сдачи-приёмки пути (РД 22-28-35-99)</td><td>Исполнительная документация на фундамент</td></tr>
        <tr><td>В эксплуатации</td><td>Проверка геометрии пути и упоров</td><td>Контроль анкерного узла</td></tr>
        <tr><td>Модели КРАН-КУБАНЬ</td><td>КБ-408.21, MDT 219 J10, MCH 175</td><td>MDT 219 J10, MCH 175, КБ-674А</td></tr>
      </tbody>
    </table></div>
    <p>Решающий параметр почти всегда первый: если рабочей зоны неподвижного крана КРАН-КУБАНЬ хватает на весь объект, путь не нужен. Если не хватает — выбирают между путём и вторым краном, и тогда в расчёт входят место на площадке и срок стройки.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Рельсовый путь — самостоятельный объект с собственной приёмкой: с 1 января 2026 года технические требования к нему задаёт ГОСТ 35321-2025, заменивший ГОСТ Р 51248-99. Практику устройства пути описывает СП 12-103-2002, а форма акта сдачи-приёмки пути башенного крана приведена в РД 22-28-35-99. До подписания акта кран КРАН-КУБАНЬ по пути не ездит, как бы плотно ни выглядел балласт.</p>
    <p>Фундамент под башенный кран КРАН-КУБАНЬ входит в проект производства работ: проектировщик считает его на вертикальную, ветровую и сейсмическую нагрузку от конкретной модели. Разница для заказчика в том, что путь проверяют и после монтажа — его геометрия меняется от осадок и погоды, а фундамент после приёмки меняется мало. Полный порядок — на этапе <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Расчётная сейсмичность площадки в Краснодарском крае — 7–9 баллов по СП 14.13330.2018 и ТСН 22-302-2000, и она входит в расчёт любого основания крана КРАН-КУБАНЬ. Для рельсового пути сейсмическая нагрузка учитывается в устойчивости крана на рельсах и в основании пути, для фундамента — в размерах плиты и анкерном узле. Выбор основания не отменяет расчёт, а меняет место, где его делают.</p>
    <p>Грунт решает не меньше сейсмики: на мягких глинистых грунтах III категории балластную призму пути готовят иначе, чем на плотном основании II категории, а слабый грунт под фундаментом увеличивает плиту. Поэтому КРАН-КУБАНЬ выбирает основание после изысканий, а не до них. Порядок — на этапе <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a>, про балл площадки — в разделе <a href="/seysmozony/">«Сейсмозоны»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Инженерная служба КРАН-КУБАНЬ выбирает между рельсовым путём и фундаментом по пяти вопросам к площадке:</p>
    <ol>
      <li>Закрывает ли круг вылета неподвижного крана весь объект, включая зону складирования?</li>
      <li>Есть ли вдоль здания прямая полоса под путь, свободная от котлована, сетей и проездов?</li>
      <li>Что показали изыскания: какой грунт под полосой пути и под пятном фундамента?</li>
      <li>Сколько длится стройка: путь занимает полосу земли весь срок, фундамент — только пятно.</li>
      <li>Нужна ли высота выше потолка свободностоящих кранов — тогда вариант один: КБ-674А с анкеровкой к зданию.</li>
    </ol>
    <p>Пример: восьмиэтажный дом длиной вдвое больше рабочего диаметра крана КРАН-КУБАНЬ с прямой полосой вдоль фасада — случай для пути. Точечная башня в квартале без свободной полосы — случай для фундамента. Как считать высоту крюка и вылет, разобрано в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>, а сравнение с быстромонтируемым краном — в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>
    <p>Генплан объекта можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ предложит модель и основание под вашу площадку.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://base.garant.ru/413264615/', label: 'ГОСТ 35321-2025 — приказ Росстандарта от 17.11.2025 №1400-ст, действует с 01.01.2026 вместо ГОСТ Р 51248-99' },
      { href: 'https://files.stroyinf.ru/Data1/11/11357/index.htm', label: 'files.stroyinf.ru — СП 12-103-2002 «Пути наземные рельсовые крановые»' },
      { href: 'https://files.stroyinf.ru/Data2/1/4293850/4293850237.htm', label: 'files.stroyinf.ru — РД 22-28-35-99, рельсовые пути башенных кранов и форма акта сдачи-приёмки' },
      { href: 'https://www.kranauto.ru/public/specs/460_KB_408.21.PDF', label: 'kranauto.ru — технические характеристики КБ-408.21' },
      { href: 'https://files.stroyinf.ru/Data2/1/4293736/4293736459.htm', label: 'files.stroyinf.ru — СП 14.13330.2018 «Строительство в сейсмических районах»' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
    ]} />
</BlogArticleLayout>
