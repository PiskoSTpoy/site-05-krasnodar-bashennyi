---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 99. Сорок первая статья блога — угол (a) информационный/how-to.
// Опасная зона крана на сайте упоминалась только мимоходом (сосульки в статье
// «Кран зимой»), а расчёт её границы — частый вопрос заказчика до ППР.
//
// Фактура — только проверенная 28.09.2026:
// - СНиП 12-03-2001, Приложение Г, п. Г.1 и таблица Г.1 (отлёт груза: до 10 м
//   — 4 м, до 20 м — 7 м, до 70 м — 10 м, до 120 м — 15 м, до 200 м — 20 м;
//   предметы со здания 3,5/5/7/10/15 м; интерполяция допускается);
// - СНиП 12-03-2001 п. 4.9 (места перемещения грузов кранами — зоны
//   потенциально опасных факторов), п. 6.1.5 (средства искусственного
//   ограничения зоны работы башенных кранов), п. 7.2.1 (знаки безопасности);
// - разъяснение Ростехнадзора (kostroma-diagnostika.ru): ближе 7 м от груза
//   до границы опасной зоны — ограничение скорости поворота до минимальной;
// - вылеты моделей — parkModels.ts.
// Примеры расчёта — иллюстрация формулы п. Г.1, а не проектное решение.

const CHECKED = '28 сентября 2026 года';
const PUBLISHED = '2026-09-28';

const title = 'Опасная зона башенного крана: как рассчитать границу';
const description = 'Опасная зона башенного крана по СНиП 12-03-2001: вылет + габарит груза + отлёт 4–20 м по таблице Г.1. Примеры для Potain MDT 219 J10 и giraFFe SMK-5.66.';
const h1 = 'Как рассчитать опасную зону башенного крана на стройплощадке';
const crumbTitle = 'Опасная зона крана';
const slug = 'opasnaya-zona-bashennogo-krana';

const H2 = [
  'Опасная зона крана по СНиП 12-03-2001',
  'Отлёт груза по таблице Г.1',
  'Пример расчёта для двух моделей КРАН-КУБАНЬ',
  'Опасная зона выходит за участок: что делают',
  'Опасная зона в ППР и на площадке',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Как определить опасную зону работы башенного крана?',
    a: 'По пункту Г.1 СНиП 12-03-2001: от крайней точки перемещаемого груза прибавляют его наибольший габарит и минимальный отлёт при падении по таблице Г.1. Отлёт зависит от высоты возможного падения — от 4 м при высоте до 10 м до 20 м при высоте до 200 м. КРАН-КУБАНЬ считает границу для каждой площадки в ППР.',
  },
  {
    q: 'Чему равен отлёт груза при падении с высоты 20 и 70 метров?',
    a: 'По таблице Г.1 СНиП 12-03-2001 груз, перемещаемый краном, при высоте падения до 20 м отлетает минимум на 7 м, до 70 м — на 10 м, до 120 м — на 15 м. Для промежуточных высот норма допускает интерполяцию. Эти числа инженерная служба КРАН-КУБАНЬ закладывает в схему опасных зон ППР.',
  },
  {
    q: 'Что делать, если опасная зона крана выходит на дорогу или соседний участок?',
    a: 'Зону сокращают: СНиП 12-03-2001 (п. 6.1.5) предусматривает средства искусственного ограничения зоны работы башенных кранов, а у самой границы ограничивают скорость поворота. Второй путь — модель с меньшим рабочим вылетом, например Potain MCH 175 с маховой стрелой из парка КРАН-КУБАНЬ.',
  },
  {
    q: 'Кто отвечает за границы опасной зоны крана?',
    a: 'Границы опасной зоны крана определяет разработчик проекта производства работ, он же отвечает за их соответствие требованиям промышленной безопасности. На площадке зону обозначают знаками безопасности. КРАН-КУБАНЬ передаёт разработчику ППР паспортные вылеты и высоты своей модели.',
  },
  {
    q: 'Входит ли падение самого крана в опасную зону по СНиП?',
    a: 'Нет, по разъяснению Ростехнадзора границы опасной зоны по Приложению Г СНиП 12-03-2001 считают от перемещаемого груза, а падение крана и его узлов в них не учитывают. Устойчивость башенного крана КРАН-КУБАНЬ обеспечивают расчётом основания и анкеровки, а не размером зоны.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Безопасность · Как рассчитать"
  published={PUBLISHED}
>
    <p slot="intro">Граница опасной зоны башенного крана равна вылету до крайней точки груза плюс наибольший габарит груза плюс отлёт при падении — от 4 до 20 м по таблице Г.1 СНиП 12-03-2001. У Potain MDT 219 J10 с вылетом 65 м зона получается почти 90 м от оси крана и почти всегда выходит за городской участок. Инженерная служба КРАН-КУБАНЬ считает эту границу до монтажа и передаёт её в ППР.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>СНиП 12-03-2001 относит места перемещения грузов кранами к зонам потенциально опасных факторов (п. 4.9). Границы этих зон задаёт Приложение Г. По пункту Г.1 границу отсчитывают от крайней точки горизонтальной проекции наименьшего габарита груза и прибавляют два слагаемых: наибольший габаритный размер груза и минимальное расстояние его отлёта при падении. Для башенного крана КРАН-КУБАНЬ крайняя точка — это груз на максимальном рабочем вылете.</p>
    <p>Приложение Г СНиП 12-03-2001 описывает только падение груза, а не крана: по разъяснению Ростехнадзора падение самого крана и его узлов в границы опасной зоны не входит. Устойчивость крана КРАН-КУБАНЬ обеспечивают расчётом фундамента, пути и анкеровки, а опасная зона отвечает за людей и технику под траекторией груза. Поэтому одна и та же модель на разных объектах даёт разную зону: её задают вылет, длина груза и высота подъёма.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Таблица Г.1 СНиП 12-03-2001 связывает высоту возможного падения груза с минимальным расстоянием его отлёта. Для груза, перемещаемого краном, отлёт больше, чем для предмета, упавшего со здания, — груз раскачивается на стропах и уходит дальше от вертикали. Значения, которыми пользуется инженерная служба КРАН-КУБАНЬ:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Высота возможного падения</th><th>Отлёт груза, перемещаемого краном</th><th>Отлёт предмета, падающего со здания</th></tr></thead>
      <tbody>
        <tr><td>до 10 м</td><td>4 м</td><td>3,5 м</td></tr>
        <tr><td>до 20 м</td><td>7 м</td><td>5 м</td></tr>
        <tr><td>до 70 м</td><td>10 м</td><td>7 м</td></tr>
        <tr><td>до 120 м</td><td>15 м</td><td>10 м</td></tr>
        <tr><td>до 200 м</td><td>20 м</td><td>15 м</td></tr>
      </tbody>
    </table></div>
    <p>Для промежуточных высот примечание к таблице Г.1 допускает интерполяцию: груз на высоте 40 м получает отлёт около 8,2 м вместо 10 м по строке «до 70 м». Высоту возможного падения берут по наибольшей высоте, на которую кран КРАН-КУБАНЬ поднимает груз на этом объекте, а не по паспортному максимуму крюка. Приставной КБ-674А на высоте свыше 70 м уже попадает в строку «до 120 м» с отлётом 15 м.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Расчёт по пункту Г.1 СНиП 12-03-2001 укладывается в одну строку: вылет до крайней точки груза + наибольший габарит груза + отлёт по таблице Г.1. Ниже — два условных примера для кранов КРАН-КУБАНЬ с разным вылетом; длина груза и высота подъёма взяты для иллюстрации, на объекте их задаёт технологическая карта:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>Potain MDT 219 J10</th><th>giraFFe SMK-5.66</th></tr></thead>
      <tbody>
        <tr><td>Максимальный вылет</td><td>65 м</td><td>43 м</td></tr>
        <tr><td>Наибольший габарит груза</td><td>12 м</td><td>6 м</td></tr>
        <tr><td>Высота подъёма груза</td><td>до 70 м → отлёт 10 м</td><td>до 20 м → отлёт 7 м</td></tr>
        <tr><td>Граница опасной зоны от оси крана</td><td>≈ 87 м</td><td>≈ 56 м</td></tr>
      </tbody>
    </table></div>
    <p>Круг радиусом 87 м вокруг Potain MDT 219 J10 — это почти 2,4 га, больше типичного городского квартала под одним домом. У быстромонтируемого giraFFe SMK-5.66 круг радиусом 56 м тоже редко помещается в границы участка. Вывод для заказчика КРАН-КУБАНЬ: опасная зона почти всегда шире забора, и решение о её ограничении принимают на этапе <a href="/etapy/proekt-i-ppr/">«Проект и ППР»</a>, а не после монтажа.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>СНиП 12-03-2001 в пункте 6.1.5 прямо предусматривает средства искусственного ограничения зоны работы башенных кранов и защитные сооружения для людей. На практике кран КРАН-КУБАНЬ программно не пускают поворачивать стрелу и выдвигать грузовую тележку за заданный контур, а над тротуаром и входами ставят защитные козырьки. Опасная зона после такого ограничения считается уже от нового контура работы, а не от паспортного вылета.</p>
    <p>По разъяснению Ростехнадзора, когда груз проходит ближе 7 м от границы опасной зоны, скорость поворота стрелы ограничивают до минимальной, а на таких участках нужны предохранительные или страховочные устройства. Второй путь — модель с меньшим рабочим вылетом: маховая стрела <a href="/park/potain-mch-175/">Potain MCH 175</a> сокращает вылет наклоном почти до мачты и уменьшает зону геометрией. КРАН-КУБАНЬ выбирает между ограничителями и такой моделью по плану соседних зданий и дорог.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Граница опасной зоны башенного крана — обязательная часть проекта производства работ, и за её соответствие требованиям промышленной безопасности отвечает разработчик ППР. На стройгенплане зону показывают для каждой стоянки крана с учётом ограничений, а на площадке по пункту 7.2.1 СНиП 12-03-2001 обозначают знаками безопасности. КРАН-КУБАНЬ передаёт разработчику паспортные вылеты, высоты и грузовую характеристику модели, чтобы расчёт опирался на реальные данные крана.</p>
    <p>На площадке опасная зона крана КРАН-КУБАНЬ меняется вместе со стройкой: с ростом здания растёт высота подъёма и отлёт по таблице Г.1, а зимой к ней добавляется лёд, который срывается со стрелы, — об этом статья <a href="/blog/bashennyi-kran-zimoy/">«Башенный кран зимой»</a>. Схему пересматривают при каждом наращивании мачты. Как вылет и высота крюка связаны с выбором модели, разобрано в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>
    <p>Генплан участка и границы соседних объектов можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ предложит модель и способ ограничения зоны под вашу площадку.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://docs.cntd.ru/document/901794520', label: 'docs.cntd.ru — СНиП 12-03-2001 «Безопасность труда в строительстве. Часть 1», постановление Госстроя России от 23.07.2001 №80' },
      { href: 'https://zakonbase.ru/content/part/266653?print=1', label: 'zakonbase.ru — СНиП 12-03-2001, Приложение Г: границы опасных зон, таблица Г.1' },
      { href: 'https://kostroma-diagnostika.ru/news/1461317128/', label: 'kostroma-diagnostika.ru — «Ростехнадзор разъясняет: определение границ опасной зоны работы башенного крана»' },
      { href: 'https://base.garant.ru/400165076/', label: 'base.garant.ru — ФНП «Правила безопасности ОПО, на которых используются подъёмные сооружения», приказ Ростехнадзора от 26.11.2020 №461' },
    ]} />
</BlogArticleLayout>
