---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 95. Тридцатая статья блога — первая по новому правилу «3 статьи в
// день», угол (a) how-to. Тема — жара как самостоятельный фактор графика
// крана на Кубани. До этой волны на сайте про неё не было ни строки: закон
// о тишине разобран как «окна работы», норд-ост — как ветровой простой, а
// температура воздуха не фигурировала вовсе.
//
// Фактура (WebSearch/WebFetch 24.09.2026):
// - Краснодар, 12 мая 2026: +41 °C при прежнем рекорде дня +32,6 °C 65-летней
//   давности (kubnews.ru со ссылкой на «Погоду и климат»). Цифру +42 °C за
//   8 мая, выданную поисковым суммаризатором, НЕ берём — первоисточник не
//   открыт, а «+11,9 к рекорду» выглядит как ошибка пересказа.
// - ГОСТ 15150-69: исполнение У1 — рабочий диапазон −45…+40 °C, предельный
//   −50…+45 °C (sertrb.ru). Исполнение конкретного крана — в его паспорте,
//   поэтому пишем «многие краны», не «все».
// - Роспотребнадзор, 29.05.2024 (garant.ru): при +32,5 °C и выше на открытом
//   воздухе — 15-20 минут работы и 10-12 минут отдыха в прохладе, перенос
//   работ на утро и вечер, вода ~0,5 л в час. Статус — РЕКОМЕНДАЦИИ, так и
//   пишем. Таблицу «часов пребывания» из СанПиН не приводим: источники
//   разошлись в том, действует ли она после отмены СанПиН 2.2.4.3359-16.
// - Закон №608-КЗ: окна 08:00-13:00 и 15:00-23:00, в выходные с 10:00 —
//   сверено в Волне 94 (Коммерсантъ), совпадает с этапом «Эксплуатация».

const CHECKED = '24 сентября 2026 года';

const title = 'Башенный кран в жару: как собрать смену на Кубани';
const description = 'Жара +40 °C на Кубани и закон о тишине: как сдвинуть подъёмы на утро и вечер, что делать с кабиной крановщика и перерывами стропальщиков.';
const h1 = 'Башенный кран в жару: как собрать смену между +40 °C и законом о тишине';
const crumbTitle = 'Башенный кран в жару';
const slug = 'bashennyi-kran-v-zharu';

const H2 = [
  'Жара на Кубани больше не только июльская',
  'Шаг 1. Проверьте температурный диапазон крана по паспорту',
  'Шаг 2. Сдвиньте тяжёлые подъёмы в прохладные часы',
  'Шаг 3. Используйте тихий час как паузу в пик жары',
  'Шаг 4. Кабина крановщика — рабочее место с микроклиматом',
  'Шаг 5. Перерывы нужны прежде всего стропальщикам',
  'Шаг 6. Заложите жаркие дни в график заранее',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Можно ли в жару начать подъёмы в 6 утра, пока прохладно?',
    a: 'Нет. Закон Краснодарского края №608-КЗ запрещает шумные строительные работы с 23:00 до 08:00, а в выходные и праздники — до 10:00. Работа башенного крана на стройке под этот запрет подпадает, и исключение сделано только для аварийных и неотложных работ. Поэтому «прохладное утро» на Кубани начинается в 08:00, а не на рассвете.',
  },
  {
    q: 'Обязан ли работодатель сокращать смену при +35 °C на улице?',
    a: 'Для работ на открытом воздухе обязательной таблицы сокращения смены по температуре нет. Роспотребнадзор даёт рекомендации: при +32,5 °C и выше — работать отрезками по 15-20 минут с отдыхом 10-12 минут в прохладе и переносить работу на утро и вечер. Это рекомендации, а не норма с прямой ответственностью, но на практике их закладывают в ППР и в инструкции по охране труда.',
  },
  {
    q: 'Останавливают ли кран, если на улице выше +40 °C?',
    a: 'Зависит от конкретной машины. Многие краны выпускаются в исполнении У1 по ГОСТ 15150-69 с верхней рабочей температурой +40 °C, но решающая цифра стоит в паспорте крана. Если прогноз выше паспортного значения, это вопрос к эксплуатирующей организации до начала смены, а не к крановщику в кабине.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>О погоде для башенного крана обычно говорят в одном смысле — о ветре. На Кубани есть второй фактор, который отнимает у графика не меньше часов: жара. Он хитрее ветра. Кран в жару формально работать может, а люди вокруг него — уже с ограничениями. И сдвинуть смену на рассвет, как делают в жарких странах, здесь нельзя: мешает краевой закон о тишине. Ниже — пошаговый порядок, как собрать рабочий день крана, когда термометр подходит к +40 °C.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Весна 2026 года показала, что планировать жару только на июль и август уже нельзя. 12 мая в Краснодаре воздух прогрелся до +41 °C. Прежний рекорд этого дня держался 65 лет и составлял +32,6 °C. Это был уже третий температурный рекорд за первые две недели мая. Для стройки вывод практический: объект, график которого рассчитан на «комфортный май», может попасть в режим летней жары задолго до лета.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Первый вопрос — не к людям, а к машине. Стандарт ГОСТ 15150-69 делит технику по климатическому исполнению. Для исполнения У1 (умеренный климат, работа на открытом воздухе) рабочий диапазон температур — от −45 до +40 °C, а предельный, при котором допускается кратковременная работа с ухудшением характеристик, — до +45 °C. Многие башенные краны выпускаются именно в таком исполнении, но не все. Решающая цифра стоит в паспорте конкретной машины.</p>
    <p>Что с этим делать: до начала сезона сверить паспортный диапазон крана с прогнозом на месяц. Если в прогнозе дни выше верхней рабочей температуры, порядок действий в такие дни согласуют с эксплуатирующей организацией заранее, а не решают на площадке в 14 часов дня. Отдельно стоит спросить про электрооборудование: шкафы управления и частотные преобразователи греются сильнее воздуха вокруг них.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Самые длинные и ответственные операции — подъём крупных армокаркасов, монтаж тяжёлых конструкций, работа с парусными грузами — лучше ставить на часы, когда людям на площадке легче всего. На Кубани это начало разрешённого окна и вечер. Закон №608-КЗ разрешает шумные работы с 08:00 до 13:00 и с 15:00 до 23:00 в будни. В выходные и праздники утреннее окно начинается только в 10:00.</p>
    <p>Получается простое правило. Утро с 08:00 до 11:00 — для самых тяжёлых подъёмов, пока воздух ещё не прогрелся. Вечер после спада жары — для второй волны тяжёлых операций. Середина дня — для лёгких подъёмов, подачи мелкого груза и работ, где стропальщику не нужно долго стоять на открытом солнце. Для вечерних часов нужно заранее продумать освещение площадки: в сентябре темнеет раньше, чем заканчивается разрешённое окно.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>С 1 марта 2026 года краевой закон запрещает шумные работы с 13:00 до 15:00. Обычно этот перерыв воспринимают как потерю двух рабочих часов. В жару у него есть и полезная сторона: он приходится почти на самые жаркие часы дня. Паузу, которую всё равно нужно было бы делать ради людей, закон делает обязательной и одинаковой для всех соседних площадок.</p>
    <p>Поэтому обеденный перерыв, отдых бригады в прохладном помещении и пересменку удобно ставить именно на 13:00-15:00. Тогда в разрешённые часы бригада работает, а не отдыхает. Подробный разбор окон и штрафов — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a> и в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине на Кубани»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Крановщик башенного крана сидит в кабине на высоте, под прямым солнцем, и не может выйти из неё за пару минут. Поэтому кабина в жару — это не вопрос удобства, а рабочее место, для которого микроклимат задаёт СанПиН 1.2.3685-21. Практически это значит три вещи. Кондиционер кабины проверяют до начала жаркого сезона, а не после первой жалобы. В кабине есть запас питьевой воды на смену. План подъёма и спуска крановщика на перерыв согласован заранее: подниматься по лестнице башни в пик жары тяжело, и это тоже нагрузка.</p>
    <p>На этом этапе важно проверить, что именно входит в аренду: исправный кондиционер кабины и его обслуживание — пункт, который лучше закрепить в договоре письменно.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Тяжелее всего в жару не крановщику в кабине, а стропальщикам и сигнальщику. Они весь день на открытой площадке, часто на бетоне или металле, которые нагреваются сильнее воздуха. Для них Роспотребнадзор даёт рекомендации (именно рекомендации, не обязательную норму). При температуре +32,5 °C и выше на открытом воздухе советуют работать отрезками по 15-20 минут и отдыхать по 10-12 минут в прохладном помещении, переносить работы на утро и вечер, пить примерно по 0,5 литра воды в час.</p>
    <p>Для крана из этого следует простая вещь: если на площадке один стропальщик, кран будет простаивать во время каждого его перерыва. Если стропальщиков двое и они работают посменно, темп подъёмов почти не падает. Решение о составе бригады в жаркий период дешевле принять в ППР, чем компенсировать простоем крана, за который платят помесячно.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Жаркий день — это не полный простой, но и не полноценная смена. Честный способ учесть его в графике: заранее принять, что часть дней с мая по сентябрь даст меньше подъёмов, чем обычный день, и заложить запас. То же самое проектировщики делают с днями норд-оста на побережье: там ветер отнимает дни целиком, здесь жара отнимает часы. Если объект стоит в Новороссийске или рядом, в графике окажутся оба фактора сразу. Как работает кран при сильном ветре, разобрано в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>
    <p>Когда площадку и сроки уже понятно, их можно прислать через <a href="/#order">форму на главной</a> — посчитаем этапы под конкретный объект.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <ul>
      <li>Жара на Кубани приходит раньше лета: 12 мая 2026 года в Краснодаре было +41 °C при прежнем рекорде дня +32,6 °C.</li>
      <li>Верхнюю рабочую температуру крана смотрят в паспорте. Для исполнения У1 по ГОСТ 15150-69 это +40 °C.</li>
      <li>Начать раньше 08:00 (в выходные — 10:00) нельзя: закон №608-КЗ. Тяжёлые подъёмы ставят на утро и вечер.</li>
      <li>Запрет на шум с 13:00 до 15:00 совпадает с пиком жары. Перерывы бригады удобно ставить именно туда.</li>
      <li>Кондиционер кабины и вода для крановщика — пункты, которые проверяют до сезона и фиксируют в договоре.</li>
      <li>Стропальщикам при +32,5 °C и выше Роспотребнадзор рекомендует работать по 15-20 минут с отдыхом 10-12 минут. Второй стропальщик спасает темп крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kubnews.ru/obshchestvo/2026/05/13/v-krasnodare-12-maya-zhara-obnovila-65-letniy-rekord/', label: 'kubnews.ru — в Краснодаре 12 мая жара обновила 65-летний рекорд, 13.05.2026' },
      { href: 'http://www.pogodaiklimat.ru/monitor.php?id=34927', label: 'pogodaiklimat.ru — климатический монитор, Краснодар' },
      { href: 'https://docs.cntd.ru/document/1200003320', label: 'docs.cntd.ru — ГОСТ 15150-69: исполнения для различных климатических районов' },
      { href: 'https://www.sertrb.ru/laboratory/klimaticheskoe-ispolnenie-temperatury/', label: 'sertrb.ru — рабочие и предельные температуры исполнений У1, УХЛ1, Т1 по ГОСТ 15150-69' },
      { href: 'https://www.garant.ru/news/1721382/', label: 'garant.ru — Роспотребнадзор дал рекомендации по работе в жару, 29.05.2024' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
