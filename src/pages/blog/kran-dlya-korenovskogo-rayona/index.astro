---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 117. Девяносто седьмая статья блога — угол (c) практический / региональный.
// Кореновский район — географический центр края; город Кореновск разобран отдельно
// (kran-dlya-korenovska, Волна 90: молочно-консервный комбинат и сахарный завод),
// поэтому здесь слой района: площадь, транспорт, население, поселения, история.
// Структура блоков отличается от Курганинского/Кавказского: от географии и дорог
// к населению, поселениям и истории, модель — чек-листом, а не таблицей задач.
//
// Фактура — один источник (curl -sk, проверено 22.10.2026):
// smokk.ru/about/association-members/korenovskiy-rayon — географический центр края,
// 1426 км², климат умеренно-континентальный; население 84 335 (01.01.2022), 83 363 (2023),
// 83 194 (2024), 82 494 (01.01.2025); администрация — г. Кореновск, ул. Красная, 41;
// 10 МО: Кореновское городское + 9 сельских (Братковское, Бураковское, Дядьковское,
// Журавское, Новоберезанское, Платнировское, Пролетарское, Раздольненское, Сергиевское);
// история: 02.06.1924 образован (19 сельсоветов) в Кубанском округе Юго-Восточной области,
// 16.11.1924 Северо-Кавказский край, 10.01.1934 Азово-Черноморский край, 28.12.1934 выделены
// Выселковский и Пластуновский районы, 13.09.1937 Краснодарский край, 11.02.1963 упразднён
// (в Усть-Лабинский район), 03.03.1964 восстановлен, 1993 сельские округа, 2005 — 10 МО;
// экономика: преимущественно аграрный, «Кореновск МКК», «Кореновск сахар»; транспорт —
// ж/д «Краснодар I — Кореновск — Тихорецкая», автострада «Дон».
// Расчёты КРАН-КУБАНЬ: −972, −169, −700; итого −1841 (−2,2 %); 82 494 / 1426 ≈ 57,9 чел./км².
// НЕ названо: грунт, расстояния, балл сейсмичности, стройки предприятий, цены.

const CHECKED = '22 октября 2026 года';
const PUBLISHED = '2026-10-22';

const title = 'Кран для Кореновского района: 1426 км² в центре края';
const description = 'Кореновский район — 1426 км² в центре края, 82 494 жителя на 01.01.2025, трасса «Дон» и железная дорога на Тихорецкую. Какой башенный кран выбрать.';
const h1 = 'Кран для Кореновского района: что учесть на объекте в центре Кубани';
const crumbTitle = 'Кран для Кореновского района';
const slug = 'kran-dlya-korenovskogo-rayona';

const H2 = [
  'Географический центр края: 1426 км² равнины',
  'Трасса «Дон» и железная дорога на Тихорецкую',
  '82 494 жителя и плотность 57,9 человека на км²',
  'Город и 9 сельских поселений: где искать участок',
  '1924–1964: от 19 сельсоветов до упразднения и возврата',
  'Сейсмика, тишина и грунт для площадки района',
  'Порядок выбора башенного крана для района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Кореновского района?',
    a: '1426 км² по описанию района на сайте ассоциации «Совет муниципальных образований Краснодарского края» (СМОКК). Район расположен в географическом центре края, климат — умеренно-континентальный. При 82 494 жителях на 1 января 2025 года плотность составляет около 57,9 человека на км², по расчёту КРАН-КУБАНЬ.',
  },
  {
    q: 'Сколько человек живёт в Кореновском районе?',
    a: '82 494 человека на 1 января 2025 года по данным СМОКК. На 1 января 2022 года было 84 335 жителей, за три года население уменьшилось на 1841 человека, или на 2,2 %. Годовые разницы и итоговую убыль рассчитала инженерная служба КРАН-КУБАНЬ.',
  },
  {
    q: 'Какие поселения входят в Кореновский район?',
    a: 'Кореновское городское поселение и девять сельских: Братковское, Бураковское, Дядьковское, Журавское, Новоберезанское, Платнировское, Пролетарское, Раздольненское и Сергиевское. Десять муниципальных образований созданы в 2005 году. Администрация района находится в Кореновске на улице Красной, 41.',
  },
  {
    q: 'Какие дороги проходят через Кореновский район?',
    a: 'Через Кореновский район проходят федеральная автострада «Дон» и железная дорога «Краснодар I — Кореновск — Тихорецкая», по данным СМОКК. Для доставки секций башенного крана КРАН-КУБАНЬ строит маршрут от трассы до конкретного поселения и участка.',
  },
  {
    q: 'Какой балл сейсмичности в Кореновском районе?',
    a: 'Описание района на сайте СМОКК балл сейсмичности не приводит, и КРАН-КУБАНЬ не называет его без первоисточника. Значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000, а при необходимости уточняют сейсмическим микрорайонированием.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Центр края"
  published={PUBLISHED}
>
    <p slot="intro">Кореновский район занимает 1426 км² в географическом центре Краснодарского края, а на 1 января 2025 года в нём жили 82 494 человека. Через район проходят автострада «Дон» и железная дорога «Краснодар I — Кореновск — Тихорецкая», поэтому для КРАН-КУБАНЬ доставка секций башенного крана сюда — вопрос последних километров до поселения, а не магистрали.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Кореновский район, по описанию ассоциации «Совет муниципальных образований Краснодарского края» (СМОКК), расположен в географическом центре края и занимает 1426 км². Климат источник называет умеренно-континентальным. Для КРАН-КУБАНЬ центральное положение означает короткое плечо доставки крана из любой части края, но списка соседних районов источник не даёт, и здесь он не приводится.</p>
    <p>Равнинный рельеф упрощает подъезд трала и установку башенного крана, но не снимает вопроса основания: несущую способность грунта под рельсовым путём КБ-408.21 или опорами giraFFe SMK-5.66 определяют изыскания на конкретном участке. Данных о грунтах района СМОКК не приводит. Состав работ описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Через Кореновский район проходят федеральная автострада «Дон» и железная дорога «Краснодар I — Кореновск — Тихорецкая», по данным СМОКК. Для доставки башенного крана это значит, что магистральная часть маршрута у КРАН-КУБАНЬ одинакова для большинства поселений, а различается съезд с трассы к участку: ширина улиц, мосты и линии электропередачи над дорогой.</p>
    <p>Самый длинный груз при перевозке — секции башни и стрелы, поэтому КРАН-КУБАНЬ проверяет маршрут от трассы «Дон» до площадки заранее, ещё на этапе заявки. Для объектов у железной дороги отдельно согласуют работу крана рядом с путями: опасная зона не должна выходить на полосу отвода. Расчёт границы — в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Население Кореновского района за три года сократилось с 84 335 до 82 494 человек — на 1841, или 2,2 %, а плотность на 1 января 2025 года — около 57,9 человека на км². Численности по датам приводит СМОКК; годовые разницы, убыль и плотность рассчитала инженерная служба КРАН-КУБАНЬ.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>На дату</th><th>Жителей</th><th>За год</th><th>Плотность, чел./км²</th></tr></thead>
      <tbody>
        <tr><td>01.01.2022</td><td>84 335</td><td>—</td><td>59,1</td></tr>
        <tr><td>01.01.2023</td><td>83 363</td><td>−972</td><td>58,5</td></tr>
        <tr><td>01.01.2024</td><td>83 194</td><td>−169</td><td>58,3</td></tr>
        <tr><td>01.01.2025</td><td>82 494</td><td>−700</td><td>57,9</td></tr>
      </tbody>
    </table></div>
    <p>Для строительного спроса Кореновского района КРАН-КУБАНЬ делает осторожный вывод: убыль небольшая, но рост жилья не подкреплён ростом населения. Район СМОКК описывает как преимущественно аграрный, с пищевыми предприятиями «Кореновск МКК» и «Кореновск сахар», поэтому типичный заказ — производственный или складской корпус. Расчёт крана под такой корпус — в статье <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Кореновский район состоит из 10 муниципальных образований: Кореновского городского поселения и девяти сельских — Братковского, Бураковского, Дядьковского, Журавского, Новоберезанского, Платнировского, Пролетарского, Раздольненского и Сергиевского. Администрация района находится в Кореновске на улице Красной, 41. Для заявки КРАН-КУБАНЬ нужен адрес участка с названием поселения.</p>
    <p>От поселения зависят местные согласования и подъездные пути, а от адреса — схема установки крана на участке. Объекты в самом Кореновске КРАН-КУБАНЬ разобрал в статье <a href="/blog/kran-dlya-korenovska/">«Кран для Кореновска»</a>: там описаны молочно-консервный комбинат и сахарный завод. Выселковский район, выделенный из Кореновского в 1934 году, — в статье <a href="/blog/kran-dlya-vyselkovskogo-rayona/">«Кран для Выселковского района»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Кореновский район образован 2 июня 1924 года из 19 сельских советов, а в 1934 году из него выделили Выселковский и Пластуновский районы. Хронология из описания СМОКК собрана КРАН-КУБАНЬ в таблицу: она подсказывает, в каком архиве искать старые документы по участку.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Дата</th><th>Событие</th><th>Что это значит для документов</th></tr></thead>
      <tbody>
        <tr><td>02.06.1924</td><td>Образован в Кубанском округе, 19 сельсоветов</td><td>Исходные границы шире нынешних</td></tr>
        <tr><td>28.12.1934</td><td>Выделены Выселковский и Пластуновский районы</td><td>Часть земель ушла соседям</td></tr>
        <tr><td>13.09.1937</td><td>В составе Краснодарского края</td><td>Текущая краевая принадлежность</td></tr>
        <tr><td>11.02.1963</td><td>Упразднён, территория в Усть-Лабинском районе</td><td>Документы 1963 года — в соседнем районе</td></tr>
        <tr><td>03.03.1964</td><td>Восстановлен в прежних границах</td><td>Границы стабильны с 1964 года</td></tr>
        <tr><td>2005</td><td>10 муниципальных образований</td><td>Современная сетка поселений</td></tr>
      </tbody>
    </table></div>
    <p>Третий столбец — рекомендация инженерной службы КРАН-КУБАНЬ, а не данные СМОКК: для участков со старой застройкой проверка архивных схем коммуникаций иногда ведёт в Усть-Лабинский или Выселковский район. Уточнять место хранения документов лучше до начала изысканий, чтобы не сдвигать монтаж крана.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Балл сейсмичности Кореновского района СМОКК не приводит, и КРАН-КУБАНЬ не называет его без первоисточника: значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000. Если объект ответственный, балл уточняют сейсмическим микрорайонированием — сроки и место в графике разобраны в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Закон Краснодарского края № 608-КЗ о тишине действует во всех десяти поселениях района: в будни шумные работы разрешены с 08:00 до 13:00 и с 15:00 до 23:00. Вечерняя часть окна зимой приходится на темноту, и для работы башенного крана площадку освещают по ГОСТ 12.1.046-2014; нормы — в статье КРАН-КУБАНЬ <a href="/blog/osveshchenie-ploshchadki-bashennogo-krana/">«Освещение площадки башенного крана»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Модель под объект в Кореновском районе КРАН-КУБАНЬ подбирает в четыре шага, начиная с ширины здания, а не с марки крана. Порядок — практика инженерной службы, а не норма.</p>
    <ol>
      <li>Ширина и длина здания: для корпуса шириной до 34–37 м подходят КБ-408.21 или giraFFe SMK-5.66, для более широкого — Potain MDT 219 J10 с вылетом 65 м.</li>
      <li>Высота: до 41,7 м — giraFFe SMK-5.66 с наклонной стрелой, до 72,7 м — КБ-408.21, выше 73 м — приставной КБ-674А.</li>
      <li>Соседние здания и границы участка: при тесной застройке — Potain MCH 175 с маховой стрелой.</li>
      <li>Основание: рельсовый путь, фундамент, анкеровка или опорный контур 4 × 4 м — по данным изысканий.</li>
    </ol>
    <p>Адрес с названием поселения и размеры объекта можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель, основание и маршрут от трассы «Дон». Цены и сроки зависят от площадки, поэтому без исходных данных они не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/korenovskiy-rayon/', label: 'smokk.ru — Кореновский муниципальный район: население, география, история, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
