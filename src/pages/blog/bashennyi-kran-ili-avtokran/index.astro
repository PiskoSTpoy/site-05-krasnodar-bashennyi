---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 99. Сорок вторая статья блога — угол (b) коммерческий/сравнительный.
// Выбор «автокран или башенный кран» — самый первый вопрос заказчика, но на
// сайте он был разобран только одним ответом в /faq/ (про основание).
//
// Фактура — только проверенная 28.09.2026:
// - gakz.ru (Галичский автокрановый завод), КС-55713-1В-1: 25 т, грузовой
//   момент 86 т·м, стрела 9,5–28,2 м, вылет до 26 м (с гуськом 34 м),
//   высота подъёма 28,3 м основной стрелой / 37,0 м с гуськом, опорный
//   контур 5,1×6,1 м (минимальный 5,1×2,27 м), масса 20,6 т;
// - parkModels.ts и карточка SMK-5.66: монтаж за 4–6 часов силами двух
//   человек и одного 25-тонного автокрана; опорный контур 4×4 м;
// - /faq/: автокран стоит на выносных опорах через подкладки — вопрос
//   несущей способности грунта под опорой.
// Цен аренды автокрана и башенного крана НЕ приводим: смета — в отдельной
// статье, краевого первоисточника с тарифами нет.

const CHECKED = '28 сентября 2026 года';
const PUBLISHED = '2026-09-28';

const title = 'Башенный кран или автокран: что выбрать для стройки';
const description = 'Автокран 25 т поднимает на 28–37 м с вылетом до 26 м, башенный кран — выше 70 м с вылетом до 65 м. Когда хватит автокрана, а когда нужен башенный кран.';
const h1 = 'Башенный кран или автокран: что выбрать для строительного объекта';
const crumbTitle = 'Башенный кран или автокран';
const slug = 'bashennyi-kran-ili-avtokran';

const H2 = [
  'Автокран 25 т и башенные краны КРАН-КУБАНЬ в цифрах',
  'Когда автокрана хватает',
  'Когда нужен башенный кран',
  'Основание: выносные опоры против фундамента и пути',
  'Автокран и башенный кран на одной площадке',
  'Как выбрать: четыре вопроса к объекту',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Что выгоднее на стройке: башенный кран или автокран?',
    a: 'Автокран выгоднее на коротких работах и невысоких объектах: он приезжает своим ходом и не требует основания. Башенный кран выгоднее на многомесячной стройке выше 8–9 этажей, где автокрану не хватает высоты и вылета. КРАН-КУБАНЬ сравнивает варианты по высоте здания, вылету до дальнего угла и сроку работ.',
  },
  {
    q: 'На какую высоту поднимает груз автокран 25 тонн?',
    a: 'Автокран КС-55713-1В-1 грузоподъёмностью 25 т поднимает груз на 28,3 м основной стрелой и на 37,0 м с гуськом по данным Галичского автокранового завода, вылет — до 26 м. Башенные краны КРАН-КУБАНЬ работают на высоте до 70,4 м свободностоящими и до 116–120 м приставным КБ-674А.',
  },
  {
    q: 'Можно ли построить многоэтажный дом автокраном?',
    a: 'Невысокий дом автокраном построить можно, многоэтажный — как правило, нет: на 16 этажах высота крюка уходит за 50 м, а грузоподъёмность автокрана на большом вылете резко падает. Для такого дома КРАН-КУБАНЬ предлагает башенный кран — Potain MDT 219 J10 или КБ-408.21, а выше 70 м — приставной КБ-674А.',
  },
  {
    q: 'Нужен ли автокран для монтажа башенного крана?',
    a: 'Да, секции башенного крана поднимают автокраном. Быстромонтируемый giraFFe SMK-5.66 монтируют за 4–6 часов силами двух человек и одного 25-тонного автокрана, секции классических моделей КРАН-КУБАНЬ — автокраном по ППР. Поэтому автокран и башенный кран чаще работают вместе, чем вместо друг друга.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Выбор крана · Сравнение"
  published={PUBLISHED}
>
    <p slot="intro">Автокран 25 т поднимает груз на 28–37 м при вылете до 26 м, а башенный кран — на 70 м и выше при вылете до 65 м, поэтому граница выбора проходит по высоте здания и сроку работ. Автокран хорош для разовых подъёмов и невысоких объектов, башенный кран КРАН-КУБАНЬ — для многомесячной стройки, где груз нужно каждый день подавать на верхние этажи и в дальний угол площадки.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Типичный автокран класса 25 т — «Галичанин» КС-55713 — по паспорту исполнения 1В-1 даёт стрелу 9,5–28,2 м и грузовой момент 86 т·м. Башенные краны КРАН-КУБАНЬ работают в другом диапазоне высот и вылетов, и разница видна по четырём параметрам:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>Автокран КС-55713-1В-1</th><th>giraFFe SMK-5.66</th><th>Potain MDT 219 J10</th></tr></thead>
      <tbody>
        <tr><td>Максимальный груз</td><td>25 т</td><td>5 т</td><td>10 т</td></tr>
        <tr><td>Максимальный вылет</td><td>26 м (34 м с гуськом)</td><td>43 м</td><td>65 м</td></tr>
        <tr><td>Груз на максимальном вылете</td><td>по таблице завода, кратно меньше 25 т</td><td>1,05 т на 43 м</td><td>1,9 т на 65 м</td></tr>
        <tr><td>Высота подъёма</td><td>28,3 м (37,0 м с гуськом)</td><td>до 27 м (41,7 м с наклоном стрелы)</td><td>до 70,4 м</td></tr>
        <tr><td>Основание</td><td>выносные опоры 5,1×6,1 м</td><td>опорный контур 4×4 м</td><td>путь или фундамент</td></tr>
      </tbody>
    </table></div>
    <p>Главная ловушка сравнения — 25 т автокрана против 5–10 т башенного крана. Грузовой момент 86 т·м означает, что на вылете 20 м автокран КС-55713-1В-1 даже теоретически поднимет не больше 4,3 т, а по заводской таблице — меньше. Башенный кран КРАН-КУБАНЬ сохраняет 1–2 т на вылете 43–65 м, куда стрела автокрана не дотягивается вовсе.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Автокран 25 т закрывает задачу, когда объект ниже 25–30 м, а подъёмов немного: разгрузка металлоконструкций, монтаж ферм склада, установка оборудования на действующем заводе. Автокран приезжает своим ходом, раскладывает выносные опоры и работает в тот же день, без проекта основания и акта на путь. Для таких работ КРАН-КУБАНЬ сам советует автокран, а не башенный кран с его монтажом и демонтажем.</p>
    <p>Предел автокрана — высота и дальний угол: здание выше 8–9 этажей или широкий корпус, до середины которого стрела не дотягивается с проезда. Автокран КС-55713-1В-1 с гуськом поднимает груз на 37,0 м, но на большом вылете с гуськом его грузоподъёмность составляет малую долю от паспортных 25 т. Если на объекте каждый день нужен подъём бетона, арматуры и опалубки наверх, автокран превращается в самую дорогую часть сметы.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Башенный кран КРАН-КУБАНЬ нужен, когда стройка длится месяцами, а груз каждый день идёт на верхние этажи и в любую точку площадки. Potain MDT 219 J10 закрывает круг радиусом 65 м и высоту до 70,4 м, КБ-408.21 на рельсовом пути проходит вдоль длинного дома, а приставной КБ-674А набирает до 116–120 м креплением к зданию. Ни один автокран класса 25 т не работает в таких координатах.</p>
    <p>Для невысокого объекта граница проходит по giraFFe SMK-5.66: этот быстромонтируемый кран КРАН-КУБАНЬ поднимает 1,05 т на вылете 43 м и стоит на опорном контуре 4×4 м без фундамента. Там, где автокрану не хватает вылета до дальнего угла, а классический башенный кран избыточен, SMK-5.66 закрывает разрыв. Подробное сравнение — в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Автокран КС-55713-1В-1 стоит на выносных опорах с контуром 5,1×6,1 м, и каждая опора передаёт нагрузку на грунт через инвентарные подкладки. Вопрос автокрана — несущая способность грунта под опорой на каждой новой стоянке, особенно на свежей засыпке у котлована. Башенному крану КРАН-КУБАНЬ основание готовят один раз: фундамент или рельсовый путь проектируют по изысканиям, а для SMK-5.66 проверяют покрытие под опорным контуром.</p>
    <p>Сейсмичность Краснодарского края в 7–9 баллов по ТСН 22-302-2000 касается прежде всего башенного крана: его основание рассчитывают на сейсмическую нагрузку на весь срок стройки. Автокран на выносных опорах работает часами, и для него решающим остаётся грунт под опорой. Как выбирают основание башенного крана, разобрано в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Автокран и башенный кран на стройке чаще работают вместе, чем вместо друг друга: без автокрана башенный кран КРАН-КУБАНЬ не смонтировать. giraFFe SMK-5.66 собирают за 4–6 часов силами двух человек и одного 25-тонного автокрана, секции Potain MDT 219 J10 и КБ-408.21 поднимают автокраном по ППР на этапе <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>. Тот же автокран возвращается на демонтаж в конце стройки.</p>
    <p>Разделение работы между двумя кранами на площадке КРАН-КУБАНЬ обычно такое: башенный кран подаёт материалы на этажи весь срок стройки, а автокран приезжает на разовые тяжёлые подъёмы — трансформатор, крупное оборудование, элементы кровли, которые тяжелее грузовой характеристики башенного крана на нужном вылете. Закон Краснодарского края №608-КЗ ограничивает шумные работы у жилья для обоих кранов одинаково.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Инженерная служба КРАН-КУБАНЬ выбирает между автокраном и башенным краном по четырём вопросам:</p>
    <ol>
      <li>Какая высота подъёма нужна с учётом строповки: до 25–30 м хватает автокрана, выше — нужен башенный кран.</li>
      <li>Какой вылет до дальнего угла здания и какой груз на этом вылете — не максимальный, а реальный.</li>
      <li>Сколько длится работа: разовые подъёмы — автокран, ежедневная подача материалов месяцами — башенный кран.</li>
      <li>Есть ли на площадке место под выносные опоры автокрана у каждой точки подъёма.</li>
    </ol>
    <p>Пример: склад высотой 12 м и фермами по 3 т закрывает автокран 25 т с двух стоянок за несколько смен. Десятиэтажный дом с подачей бетона и арматуры каждый день — задача для башенного крана КРАН-КУБАНЬ. Как посчитать высоту крюка и вылет, разобрано в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>, а статьи сметы — в статье <a href="/blog/smeta-arendy-bashennogo-krana/">«Смета аренды башенного крана»</a>.</p>
    <p>Параметры объекта можно прислать через <a href="/#order">форму на главной</a> — КРАН-КУБАНЬ скажет, хватит ли автокрана или нужен башенный кран.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.gakz.ru/rus/catalog/25tonn/kc-55713-1b-1', label: 'gakz.ru — Галичский автокрановый завод, КС-55713-1В-1: стрела 28,2 м, вылет, высота подъёма, опорный контур' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
