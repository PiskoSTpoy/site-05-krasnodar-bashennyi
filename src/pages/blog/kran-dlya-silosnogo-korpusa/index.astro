---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 118. Девяносто девятая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «силосный корпус 30 × 30 м высотой 48 м» (иллюстрация, помечена в тексте):
// высокий компактный объект — главный параметр высота крюка, а не вылет (в отличие от
// статьи о производственном корпусе 144 × 48 м, где решал вылет).
// Фактура — только parkModels.ts и карточки /park/*: MDT 219 J10 — крюк до 70,4 м, вылет 65 м;
// MCH 175 — до 58,5 м, вылет до 55 м; КБ-408.21 — 54,0–72,7 м, вылет 40 м, груз на конце
// в реестре не указан; КБ-674А — до 60 м свободно / до 116–120 м приставным, вылет 50,5 м,
// 5,6 т на 50,5 м; SMK-5.66 — до 27 м (горизонт.) / 41,7 м (наклон 20°), вылет 43 м.
// ФНП № 461 п. 114 (legalacts.ru, проверено 23.10.2026): горизонтальное перемещение груза
// на 0,5 м выше встречающихся на пути предметов — единственная норма в расчёте.
// Допущения КРАН-КУБАНЬ (помечены в тексте): стоянка у середины стороны в 6 м от стены;
// груз высотой 3 м; стропы 4 м; высота крюка = H + 0,5 + 3 + 4.
// Расчёты: дальний угол √((6 + 30)² + 15²) = √1521 = 39,0 м; потребная высота крюка
// 48 + 0,5 + 3 + 4 = 55,5 м; для 60 м — 67,5 м; запасы: MCH 58,5 − 55,5 = 3,0 м;
// КБ-674А (до 60 м) 4,5 м; MDT 70,4 − 55,5 = 14,9 м; КБ-408.21 вылет 40 − 39 = 1 м;
// SMK по высоте 41,7 < 55,5 (дефицит 13,8 м); при 60 м: MCH 58,5 < 67,5 (−9,0),
// MDT 70,4 − 67,5 = 2,9 м, КБ-408.21 до 72,7 (запас 5,2 м).
// НЕ названо: цены, сроки, реальные размеры силосов, вес секций, ветровые расчёты.

const CHECKED = '23 октября 2026 года';
const PUBLISHED = '2026-10-23';

const title = 'Кран для силосного корпуса: расчёт высоты по 5 моделям';
const description = 'Силосный корпус 48 м: нужен крюк от 55,5 м — это Potain MCH 175, КБ-674А, MDT 219 J10 и КБ-408.21; giraFFe SMK-5.66 не дотянется. Расчёт КРАН-КУБАНЬ.';
const h1 = 'Какой башенный кран нужен для силосного корпуса или элеватора: расчёт высоты';
const crumbTitle = 'Кран для силосного корпуса';
const slug = 'kran-dlya-silosnogo-korpusa';

const H2 = [
  'Исходные данные примера: корпус 30 × 30 м высотой 48 м',
  'Как считать потребную высоту крюка: формула с запасом 0,5 м',
  'Вылет до дальнего угла: ровно 39 м',
  'giraFFe SMK-5.66: дефицит 13,8 м по высоте',
  'Potain MCH 175, КБ-674А и MDT 219 J10: запас по высоте',
  'КБ-408.21: высота есть, вылет на пределе',
  'Если корпус выше: пример для 60 м',
  'Сводка: модель, высота, вылет и вывод',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой башенный кран нужен для строительства силоса или элеватора?',
    a: 'Для компактного высокого корпуса главный параметр — высота крюка. В расчёте КРАН-КУБАНЬ для корпуса высотой 48 м потребный крюк составил 55,5 м; его даёт Potain MCH 175 (до 58,5 м), КБ-674А (до 60 м), Potain MDT 219 J10 (до 70,4 м) и КБ-408.21 (54,0–72,7 м).',
  },
  {
    q: 'Хватит ли быстромонтируемого крана для здания высотой 48 м?',
    a: 'Нет. giraFFe SMK-5.66 поднимает крюк до 27 м с горизонтальной стрелой и до 41,7 м с наклонной на 20°. При потребных 55,5 м дефицит составляет 13,8 м даже в лучшем исполнении, поэтому SMK-5.66 подходит для невысоких зданий и стеснённых площадок.',
  },
  {
    q: 'Как рассчитать высоту крюка башенного крана под здание?',
    a: 'Складывают высоту здания, запас 0,5 м над препятствиями по пункту 114 ФНП № 461, высоту самого груза и длину строп. Для примера КРАН-КУБАНЬ: 48 + 0,5 + 3 + 4 = 55,5 м. Высоту груза и строп берут по реальному элементу, поэтому в проекте цифры свои.',
  },
  {
    q: 'Что делать, если здание выше 60 метров?',
    a: 'Свободностоящий кран КБ-674А достигает 60 м, выше нужна анкеровка к конструкции здания: приставной вариант по реестру КРАН-КУБАНЬ — до 116–120 м. Для корпуса 60 м потребный крюк равен 67,5 м: подходят Potain MDT 219 J10 и КБ-408.21, но не Potain MCH 175.',
  },
  {
    q: 'Влияет ли вылет на выбор крана для компактного корпуса?',
    a: 'Влияет, но слабее высоты. В примере 30 × 30 м дальний угол находится в 39 м от стоянки в 6 м от стены, и вылет 40 м у КБ-408.21 закрывает его с запасом всего 1 м. У Potain MDT 219 J10 вылет 65 м, у MCH 175 — до 55 м, запас значительный.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Высотный объект"
  published={PUBLISHED}
>
    <p slot="intro">Для силосного корпуса высотой 48 м потребный крюк башенного крана — 55,5 м, и четыре модели парка КРАН-КУБАНЬ его дают: Potain MCH 175, КБ-674А, Potain MDT 219 J10 и КБ-408.21. Быстромонтируемый giraFFe SMK-5.66 не дотягивается на 13,8 м. Размеры корпуса — иллюстрация, расчёт показывает метод: у компактного высокого объекта решает высота, а не вылет.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Для расчёта КРАН-КУБАНЬ взял условный силосный корпус: квадрат 30 × 30 м в плане и высота 48 м. Цифры выбраны для иллюстрации и не относятся к реальному объекту; метод от них не зависит. Кран стоит в 6 м от стены напротив середины стороны — допущение, которое в проекте заменяют фактическим расстоянием по ППР.</p>
    <p>Отличие от широкого цеха, разобранного в статье <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>, принципиальное. Там корпус 144 × 48 м упирался в вылет и длину рельсового пути, а здесь пятно застройки мало и вылет почти не ограничивает: вопрос в том, достанет ли крюк до верха и на какой высоте пройдёт груз.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Потребная высота крюка равна высоте здания плюс 0,5 м запаса, плюс высота груза, плюс длина строп. Запас 0,5 м взят из пункта 114 ФНП № 461: горизонтально груз перемещают на 0,5 м выше встречающихся предметов. Остальные слагаемые — допущения КРАН-КУБАНЬ: груз высотой 3 м и стропы 4 м.</p>
    <p>Расчёт для примера: 48 + 0,5 + 3 + 4 = 55,5 м. Если строп короче или груз ниже, цифра уменьшается, а при тяжёлых секциях со стропами в 6 м — растёт. Поэтому КРАН-КУБАНЬ просит у заказчика не только высоту здания, но и самый высокий монтируемый элемент вместе с оснасткой, а выбор стропов разобран в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Расстояние от стоянки крана до дальнего угла корпуса составляет ровно 39 м: √((6 + 30)² + 15²) = √1521 = 39,0 м. Здесь 36 м — расстояние от крана до дальней стены (6 м до ближней и 30 м корпуса), 15 м — половина стороны, на которую сдвинут угол от оси крана. Совпадение с целым числом — свойство взятых размеров, а не округление.</p>
    <p>Вылет 39 м закрывают почти все модели парка КРАН-КУБАНЬ: Potain MDT 219 J10 (65 м), Potain MCH 175 (до 55 м), КБ-674А (50,5 м), giraFFe SMK-5.66 (43 м) и КБ-408.21 (40 м). Различие в запасе: у КБ-408.21 остаётся 1 м, у остальных — от 4 до 26 м. Груз на дальнем вылете определяют по грузовой характеристике — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>giraFFe SMK-5.66 поднимает крюк до 27 м с горизонтальной стрелой и до 41,7 м с наклонной на 20°, а потребно 55,5 м, поэтому дефицит составляет 13,8 м даже в лучшем исполнении. Быстромонтируемый кран остаётся незаменимым для невысоких объектов на стеснённой площадке, но для силосного корпуса в 48 м он не подходит по первому же параметру.</p>
    <p>Вылет 43 м у giraFFe SMK-5.66 при этом достаточен, и это иллюстрирует общий вывод: сравнивать модели по одному параметру нельзя. Модель, выигрывающая по вылету, проигрывает по высоте. Сводное сравнение пяти моделей парка по высоте подъёма — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Potain MCH 175 с крюком до 58,5 м закрывает потребные 55,5 м с запасом 3,0 м, КБ-674А со свободной высотой до 60 м — с запасом 4,5 м, а Potain MDT 219 J10 с высотой до 70,4 м — с запасом 14,9 м. Все три модели проходят и по вылету: 55, 50,5 и 65 м против 39 м. Запас у MCH 175 мал для будущего наращивания: при росте корпуса на 3 м он исчерпан.</p>
    <p>КБ-674А интересен тем, что запас по высоте свободно стоящего крана 4,5 м можно превратить в большой: анкеровка к конструкциям силоса поднимает высоту до 116–120 м по реестру парка. Это решение для сооружения, которое строят по высоте поэтапно; детали разобраны в статье <a href="/blog/svobodnostoyashchiy-ili-pristavnoy-bashennyi-kran/">«Свободностоящий или приставной башенный кран»</a>. Рабочая зона маховой стрелы MCH 175 описана на странице <a href="/park/potain-mch-175/">модели</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>КБ-408.21 набирает высоту наращиванием секций мачты от 54,0 до 72,7 м, поэтому потребные 55,5 м достигаются добавлением секций к минимальной конфигурации. По вылету запас у модели минимальный: 40 м против 39 м до дальнего угла, то есть 1 м. Груз на конце стрелы в реестре парка у КБ-408.21 не указан, и КРАН-КУБАНЬ не называет его без паспорта.</p>
    <p>Практический вывод: КБ-408.21 подходит, когда дальний угол корпуса находится ближе максимального вылета, а стоянку можно сдвинуть к центру стороны. Если рельсовый путь можно положить вдоль стены, дальний угол приближается, и запас растёт. Устройство и основание рельсового пути описаны в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Для корпуса высотой 60 м потребный крюк составляет 60 + 0,5 + 3 + 4 = 67,5 м, и состав подходящих моделей меняется. Potain MCH 175 с крюком до 58,5 м выбывает с дефицитом 9,0 м, КБ-674А без анкеровки — до 60 м — тоже, а Potain MDT 219 J10 (до 70,4 м) проходит с запасом 2,9 м, КБ-408.21 (до 72,7 м) — с запасом 5,2 м.</p>
    <p>Для такого объекта КРАН-КУБАНЬ рассматривает два пути: свободностоящий MDT 219 J10 или КБ-408.21 с наращиванием секций либо приставной КБ-674А с креплением к стенам силоса. Выбор определяют основание под кран, ветровой район и график строительства. Состав изысканий для площадки — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Сводка показывает расчёт КРАН-КУБАНЬ для условного корпуса 48 м (потребный крюк 55,5 м, вылет до дальнего угла 39 м) и для варианта 60 м (потребный крюк 67,5 м). Знак «+» означает запас, «−» — дефицит по высоте крюка.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Высота крюка</th><th>Запас при 48 м (55,5 м)</th><th>Запас при 60 м (67,5 м)</th><th>Вылет против 39 м</th></tr></thead>
      <tbody>
        <tr><td>giraFFe SMK-5.66</td><td>до 41,7 м</td><td>−13,8 м</td><td>−25,8 м</td><td>43 м (+4 м)</td></tr>
        <tr><td>Potain MCH 175</td><td>до 58,5 м</td><td>+3,0 м</td><td>−9,0 м</td><td>до 55 м (+16 м)</td></tr>
        <tr><td>КБ-674А</td><td>до 60 м свободно</td><td>+4,5 м</td><td>−7,5 м (с анкеровкой — выше)</td><td>50,5 м (+11,5 м)</td></tr>
        <tr><td>КБ-408.21</td><td>54,0–72,7 м</td><td>+17,2 м</td><td>+5,2 м</td><td>40 м (+1 м)</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>до 70,4 м</td><td>+14,9 м</td><td>+2,9 м</td><td>65 м (+26 м)</td></tr>
      </tbody>
    </table></div>
    <p>Для КБ-408.21 запас считан от верхней границы диапазона 72,7 м, потому что крюк набирают секциями. Цены, сроки и вес секций для реального корпуса зависят от проекта и здесь не называются. Размеры здания и самый высокий груз можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и высоту мачты.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: высота крюка, вылет и грузоподъёмность пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, п. 114 (перемещение груза на 0,5 м выше препятствий)' },
      { href: 'https://kran-kuban.ru/blog/vysota-podema-bashennogo-krana-po-modelyam/', label: 'kran-kuban.ru — высота подъёма башенного крана по моделям' },
    ]} />
</BlogArticleLayout>
