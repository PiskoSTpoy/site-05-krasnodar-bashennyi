---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 104. Пятьдесят восьмая статья блога — угол (b) коммерческий/сравнительный.
// Пара моделей, которую ещё не сравнивали: КБ-674А (приставной, крепится к
// зданию — третий «качественно иной случай» в комментарии parkModels.ts) и
// Potain MCH 175 (луффинговый, переменный вылет — пятый случай). Контраст:
// КБ-674А решает задачу ВЫСОТЫ (дом выше свободностоящего крана), MCH 175 —
// задачу ГРАНИЦЫ УЧАСТКА (соседние здания сокращают доступный вылет).
//
// Фактура — только реестр parkModels.ts и карточки /park/ (проверено 03.10.2026):
// - КБ-674А: 12,5 т максимум, 5,6 т на 50,5 м, вылет 50,5 м, крюк до 60 м
//   своб. / до 116-120 м приставным climbing, основание — фундамент + анкеровка
//   к зданию;
// - Potain MCH 175: 10 т максимум, 1,5 т на 55 м (сокращается наклоном),
//   вылет до 55 м, крюк до 58,5 м, основание — рельсовый путь или фундамент.
// Цен и сроков поставки нет — только паспортные параметры моделей.

const CHECKED = '3 октября 2026 года';
const PUBLISHED = '2026-10-03';

const title = 'КБ-674А или Potain MCH 175: какой кран для тесной площадки';
const description = 'КБ-674А крепится к зданию и растёт climbing-механизмом до 116–120 м, Potain MCH 175 сокращает вылет наклоном стрелы. Какой кран для тесной площадки.';
const h1 = 'КБ-674А или Potain MCH 175: какой башенный кран выбрать для стеснённой площадки';
const crumbTitle = 'КБ-674А или Potain MCH 175';
const slug = 'kb-674a-ili-mch-175';

const H2 = [
  'Чем КБ-674А отличается от Potain MCH 175',
  'Сравнение КБ-674А и Potain MCH 175 по шести параметрам',
  'Когда нужна анкеровка КБ-674А к зданию',
  'Когда нужна маховая стрела Potain MCH 175',
  'Как выбрать кран для объекта в плотной застройке',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем отличается КБ-674А от Potain MCH 175?',
    a: 'КБ-674А из парка КРАН-КУБАНЬ — приставной кран, который крепится к зданию и растёт climbing-механизмом по мере строительства этажей, до 116–120 м. Potain MCH 175 — безоголовочный кран с маховой (луффинговой) стрелой, которая наклоняется и сокращает рабочий вылет почти до самой мачты, а основание у него — рельсовый путь или фундамент, без крепления к зданию.',
  },
  {
    q: 'У какого крана больше грузоподъёмность: у КБ-674А или у Potain MCH 175?',
    a: 'Максимальная грузоподъёмность выше у КБ-674А — 12,5 т против 10 т у Potain MCH 175 из парка КРАН-КУБАНЬ. На предельном вылете разрыв меньше: КБ-674А несёт 5,6 т на 50,5 м, а Potain MCH 175 — 1,5 т на 55 м, причём у второго вылет можно сократить наклоном стрелы.',
  },
  {
    q: 'Можно ли поставить Potain MCH 175 без рельсового пути?',
    a: 'Да, Potain MCH 175 из парка КРАН-КУБАНЬ монтируют на рельсовый путь или на монолитный фундамент — крепление к зданию, как у КБ-674А, этой модели не требуется. Фундамент выгоден на стеснённом участке, где рельсовый путь негде проложить вдоль здания.',
  },
  {
    q: 'До какой высоты может подняться КБ-674А?',
    a: 'КБ-674А из парка КРАН-КУБАНЬ работает свободностоящим до 60 м, а дальше растёт climbing-механизмом вместе со зданием — вплоть до 116–120 м при креплении к конструкции. Potain MCH 175 такой возможности не имеет: его высота подъёма крюка ограничена паспортными 58,5 м.',
  },
  {
    q: 'Зачем башенному крану маховая (луффинговая) стрела?',
    a: 'Маховая стрела Potain MCH 175 наклоняется и сокращает рабочий вылет почти до самой мачты — кран обслуживает узкую рабочую зону без выхода за границы участка. КРАН-КУБАНЬ использует это свойство там, где соседние здания или границы площадки не позволяют развернуть кран с постоянным горизонтальным вылетом на полный круг.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">КБ-674А и Potain MCH 175 из парка КРАН-КУБАНЬ решают разные задачи стеснённой площадки. КБ-674А крепится к зданию и растёт climbing-механизмом до 116–120 м, когда дом выше любого свободностоящего крана парка. Potain MCH 175 наклоняет маховую стрелу и сокращает вылет почти до мачты, когда в тесноту упирается не высота, а соседние здания и границы участка. Грузоподъёмность у КБ-674А выше — 12,5 т против 10 т у Potain MCH 175.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>КБ-674А и Potain MCH 175 из парка КРАН-КУБАНЬ различаются не грузоподъёмностью, а тем, какое именно ограничение площадки каждый кран снимает. КБ-674А — приставной кран: выше 60 м он крепится к конструкции самого здания и дальше растёт climbing-механизмом по мере строительства этажей. Potain MCH 175 остаётся на собственном основании — рельсовом пути или фундаменте — но его маховая (луффинговая) стрела наклоняется и сокращает рабочий вылет почти до самой мачты.</p>
    <p>Второе отличие пары — в самой геометрии стрелы. У обычного крана с горизонтальной стрелой, включая КБ-674А, рабочая зона — это круг постоянного радиуса. У Potain MCH 175 радиус переменный: кран сокращает вылет наклоном стрелы, когда нужно обойти соседнее здание или не выйти за границу участка. КРАН-КУБАНЬ приводит паспортные данные обеих моделей в карточках <a href="/park/kb-674a/">КБ-674А</a> и <a href="/park/potain-mch-175/">Potain MCH 175</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>КБ-674А</th><th>Potain MCH 175</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>приставной, крепится к зданию</td><td>безоголовочный, маховая стрела</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>12,5 т</td><td>10 т</td></tr>
        <tr><td>Предельный вылет</td><td>50,5 м</td><td>до 55 м, сокращается наклоном</td></tr>
        <tr><td>Груз на предельном вылете</td><td>5,6 т на 50,5 м</td><td>1,5 т на 55 м</td></tr>
        <tr><td>Высота подъёма крюка</td><td>до 60 м своб. / до 116–120 м приставным</td><td>до 58,5 м</td></tr>
        <tr><td>Основание</td><td>фундамент + анкеровка к зданию</td><td>рельсовый путь или монолитный фундамент</td></tr>
      </tbody>
    </table></div>
    <p>Таблица парка КРАН-КУБАНЬ показывает, что КБ-674А выигрывает по грузоподъёмности и по верхней границе высоты, а Potain MCH 175 — по гибкости рабочей зоны за счёт переменного вылета. На предельном вылете оба крана несут похожий груз в тоннах, но именно высота подъёма расходится сильнее всего: 116–120 м у приставного КБ-674А против фиксированных 58,5 м у Potain MCH 175.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Анкеровка КБ-674А к зданию нужна КРАН-КУБАНЬ там, где высота объекта превышает предел любого свободностоящего крана парка. До 60 м кран работает на собственном фундаменте, а дальше новую секцию заводят в опорный «стакан» под кабиной, и гидравлика поднимает верхнюю часть крана на одну секцию вверх. Цикл повторяют по мере готовности очередных этажей, пока башня не дойдёт до отметки, предусмотренной проектом анкеровки.</p>
    <p>Высотный жилой дом или гостиничный комплекс курортной зоны — типичный объект для КБ-674А из парка КРАН-КУБАНЬ: высота растёт быстрее, чем успевает окупаться перестановка свободностоящего крана. Climbing синхронизируют с темпом бетонирования здания, а не с отдельным календарным графиком — поднять кран можно только после того, как перекрытие набрало прочность для очередной точки крепления.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Маховая стрела Potain MCH 175 нужна КРАН-КУБАНЬ там, где не высота, а соседние здания или границы участка сокращают доступный вылет. Кран с постоянным горизонтальным вылетом держит круг на полный радиус независимо от того, что происходит рядом, и рискует задеть стрелой соседний корпус или чужую территорию. Potain MCH 175 наклоняет стрелу и уводит крюк ближе к мачте именно в той части разворота, где нужно обойти препятствие.</p>
    <p>Плотная застройка Краснодара, Сочи и Новороссийска — рабочая среда для Potain MCH 175 из парка КРАН-КУБАНЬ: соседний корпус, линия электропередачи или граница соседнего участка задают переменную зону, которую горизонтальная стрела не обслужит без риска столкновения. Основание у этой модели не требует анкеровки к зданию — рельсовый путь или фундамент выбирают по тем же правилам, что и для других моделей парка с горизонтальной стрелой.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Гостиничный комплекс в 18 этажей на участке с соседними корпусами по трём сторонам — пример, где выбор между КБ-674А и Potain MCH 175 проявляется сразу по двум параметрам. Если высота превышает 60 м, КБ-674А снимает ограничение climbing-механизмом, а Potain MCH 175 с фиксированной высотой подъёма 58,5 м для такого дома может не хватить. Пример условный и показывает логику выбора, а не параметры конкретного объекта.</p>
    <ol>
      <li>Сверьте высоту объекта с паспортным пределом Potain MCH 175 — 58,5 м по крюку.</li>
      <li>Если высота больше, переходите к КБ-674А и считайте цикл анкеровки climbing вместе с темпом стройки.</li>
      <li>Если высота в пределах 58,5 м, но рядом стоят другие здания, проверьте, не обойтись ли наклоном стрелы Potain MCH 175.</li>
      <li>Уточните, есть ли на участке место под рельсовый путь или фундамент для Potain MCH 175.</li>
      <li>Для КБ-674А заранее согласуйте узлы крепления к конструкции здания с проектировщиком объекта.</li>
    </ol>
    <p>Итоговый выбор между КБ-674А и Potain MCH 175 КРАН-КУБАНЬ делает на стадии проекта производства работ, когда известны высота объекта и расстояние до соседней застройки. Как считают узлы крепления приставного крана к зданию, разобрано в статье <a href="/blog/kb-408-21-ili-kb-674a/">«КБ-408.21 или КБ-674А»</a>. Чертёж и адрес объекта можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/kb-674a/', label: 'kran-kuban.ru — карточка модели КБ-674А: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/potain-mch-175/', label: 'kran-kuban.ru — карточка модели Potain MCH 175: паспортные характеристики' },
      { href: 'https://www.manitowoc.com/', label: 'manitowoc.com — производитель Potain, серия MCH' },
      { href: 'https://www.stroy-kran.ru/kb/kb-674', label: 'stroy-kran.ru — КБ-674 (КБ-674А): технические характеристики и модификации' },
    ]} />
</BlogArticleLayout>
