---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 119. Сто вторая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «жилой дом из трёх секций 20 × 15 м в линию, длина фасада 60 м, высота 42 м»
// (иллюстрация, помечена в тексте): ключевой вопрос — где можно ставить один кран, чтобы он
// доставал все углы, то есть ширина «полосы допустимых стоянок» вдоль фасада.
// Отличие от силоса (высота) и производственного корпуса (вылет и длина пути): здесь длинный
// узкий дом и считается ПОЛОСА, в которой стоянка крана допустима.
// Фактура — только parkModels.ts и карточки /park/*: MDT 219 J10 — крюк до 70,4 м, вылет 65 м,
// 1,9 т на 65 м; MCH 175 — до 58,5 м, вылет до 55 м, 1,5 т на 55 м; КБ-408.21 — 54,0–72,7 м,
// вылет 40 м; КБ-674А — до 60 м свободно, вылет 50,5 м, 5,6 т на 50,5 м; SMK-5.66 — до 27 м
// (гориз.) / 41,7 м (наклон 20°), вылет 43 м, 1,05 т на 43 м.
// ФНП № 461 п. 114 (legalacts.ru, проверено 25.10.2026): 0,5 м над встречающимися предметами.
// Допущения КРАН-КУБАНЬ: ось пути/стоянка параллельна фасаду на расстоянии 6 м от стены;
// глубина дома 15 м; груз 3 м; стропы 4 м; потребный крюк 42 + 0,5 + 3 + 4 = 49,5 м.
// Расчёты: дальний угол при стоянке у середины: √((6 + 15)² + 30²) = √1341 = 36,6 м.
// Полуширина полосы w = √(R² − 21²), допустимая стоянка x ∈ [60 − w; w] при w < 60:
// R = 40: w = √1159 = 34,04 → полоса 25,96…34,04 (8,1 м); R = 43: √1408 = 37,52 → 22,48…37,52 (15,0 м);
// R = 50,5: √2109,25 = 45,93 → 14,07…45,93 (31,9 м); R = 55: √2584 = 50,83 → 9,17…50,83 (41,7 м);
// R = 65: √3784 = 61,51 ≥ 60 → вся длина фасада (0…60 м).
// Запасы по высоте: SMK 41,7 − 49,5 = −7,8; MCH +9,0; КБ-674А +10,5; МDT +20,9; КБ-408.21 54,0 − 49,5 = +4,5.
// НЕ названо: цены, сроки, ветровые расчёты, реальные размеры домов, масса секций.

const CHECKED = '25 октября 2026 года';
const PUBLISHED = '2026-10-25';

const title = 'Кран для жилого дома из трёх секций: расчёт полосы стоянки';
const description = 'Дом из трёх секций, фасад 60 м, высота 42 м: нужен крюк от 49,5 м, а у КБ-408.21 допустимая стоянка — полоса всего 8,1 м. Расчёт КРАН-КУБАНЬ по 5 моделям.';
const h1 = 'Какой башенный кран нужен для жилого дома из трёх секций и где его ставить';
const crumbTitle = 'Кран для жилого дома из трёх секций';
const slug = 'kran-dlya-zhilogo-doma-iz-treh-sekciy';

const H2 = [
  'Исходные данные примера: фасад 60 м, глубина 15 м, высота 42 м',
  'Потребная высота крюка 49,5 м и кто её не даёт',
  'Один кран у середины фасада: дальний угол в 36,6 м',
  'Полоса допустимой стоянки: формула и ширина по моделям',
  'КБ-408.21: полоса 8,1 м и точная стоянка',
  'Potain MDT 219 J10 и MCH 175: стоянка почти в любом месте',
  'Грузоподъёмность на дальнем углу: что остаётся на крюке',
  'Сводка: модель, высота, полоса стоянки и вывод',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Хватит ли одного башенного крана на дом из трёх секций?',
    a: 'Хватит, если вылет закрывает дальние углы. В примере КРАН-КУБАНЬ дом 60 × 15 м, кран стоит в 6 м от фасада, и до дальнего угла от середины 36,6 м. Этот вылет есть у всех пяти моделей парка, но у КБ-408.21 запас всего 3,4 м, и стоянка допустима только в полосе 8,1 м.',
  },
  {
    q: 'Как рассчитать, где ставить башенный кран у длинного дома?',
    a: 'Для вылета R и расстояния от стоянки до дальней стены 21 м допустимый сдвиг от оси углов равен √(R² − 21²). Для R = 40 м это 34,04 м: стоянка допустима в полосе от 25,96 до 34,04 м, считая от начала фасада. Размеры в проекте заменяют фактическими.',
  },
  {
    q: 'Достанет ли быстромонтируемый кран до верха дома в 14 этажей?',
    a: 'Нет, при допущениях КРАН-КУБАНЬ. Для 14 этажей по 3 м потребный крюк равен 49,5 м, а giraFFe SMK-5.66 поднимает его до 41,7 м с наклонной стрелой, дефицит 7,8 м. С теми же допущениями по высоте SMK-5.66 хватает для дома до 34,2 м (41,7 − 7,5).',
  },
  {
    q: 'Какие модели подходят для дома высотой 42 метра?',
    a: 'Потребный крюк 49,5 м даёт Potain MCH 175 (до 58,5 м), КБ-674А (до 60 м свободно), Potain MDT 219 J10 (до 70,4 м) и КБ-408.21 (от 54,0 до 72,7 м). giraFFe SMK-5.66 с крюком до 41,7 м не подходит. Окончательный выбор делают по основанию, грузам и соседям.',
  },
  {
    q: 'Зачем считать грузоподъёмность на дальнем углу дома?',
    a: 'Грузоподъёмность падает с ростом вылета: у КБ-674А 5,6 т на 50,5 м против 12,5 т максимума, у Potain MDT 219 J10 1,9 т на 65 м против 10 т. Дальний угол в 36,6 м попадает между максимумом и концом стрелы, и тяжёлые панели лучше раскладывать ближе к крану.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Жилой дом"
  published={PUBLISHED}
>
    <p slot="intro">Для жилого дома из трёх секций с фасадом 60 м и высотой 42 м потребный крюк башенного крана — 49,5 м, а вылет до дальнего угла от середины фасада — 36,6 м. Пять моделей парка КРАН-КУБАНЬ закрывают вылет, но не высоту: giraFFe SMK-5.66 не дотягивает на 7,8 м. Главная цифра примера — ширина полосы, где кран можно ставить: у КБ-408.21 она всего 8,1 м, у Potain MDT 219 J10 — весь фасад.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Для расчёта КРАН-КУБАНЬ взял условный дом: три одинаковые секции 20 × 15 м, поставленные в линию, то есть фасад 60 м и глубина 15 м. Высота 42 м соответствует 14 этажам по 3 м. Размеры выбраны для иллюстрации и не относятся к реальному объекту; метод от них не зависит. Кран стоит параллельно фасаду в 6 м от стены — допущение, которое в проекте заменяют расстоянием из ППР.</p>
    <p>Отличие от компактного корпуса, разобранного в статье <a href="/blog/kran-dlya-silosnogo-korpusa/">«Кран для силосного корпуса»</a>, в форме здания. Там решала высота при малом пятне, здесь пятно вытянуто на 60 м, и вопрос звучит иначе: на каком участке фасада кран ещё достаёт оба крайних угла.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Потребная высота крюка равна высоте дома плюс 0,5 м запаса над препятствиями, высота груза и длина строп: 42 + 0,5 + 3 + 4 = 49,5 м. Запас 0,5 м взят из пункта 114 ФНП № 461, высота груза 3 м и стропы 4 м — допущения КРАН-КУБАНЬ, в проекте их берут по самому высокому элементу.</p>
    <p>giraFFe SMK-5.66 поднимает крюк только до 27 м с горизонтальной стрелой и до 41,7 м с наклонной на 20°, поэтому дефицит достигает 7,8 м и в лучшем исполнении. Остальные модели проходят: Potain MCH 175 (до 58,5 м) с запасом 9,0 м, КБ-674А (до 60 м свободно) — 10,5 м, Potain MDT 219 J10 (до 70,4 м) — 20,9 м, КБ-408.21 (минимум 54,0 м) — 4,5 м. Сравнение высот по моделям — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Кран, поставленный напротив середины фасада, находится в 6 м от ближней стены и в 21 м от дальней стены (6 + 15). До дальнего угла по горизонтали ему нужно достать на √(21² + 30²) = √1341 = 36,6 м, где 30 м — половина фасада. Это вылет, который должна обеспечивать стрела при стоянке по центру.</p>
    <p>Вылет 36,6 м перекрывают все модели парка КРАН-КУБАНЬ: КБ-408.21 (40 м), giraFFe SMK-5.66 (43 м), КБ-674А (50,5 м), Potain MCH 175 (до 55 м) и Potain MDT 219 J10 (65 м). Запас колеблется от 3,4 до 28,4 м. Различие проявляется, когда стоянку нельзя поставить в середину — например, там проезд или подземные сети.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Допустимая стоянка крана вдоль фасада — отрезок, на котором расстояние до обоих дальних углов не больше вылета R. Дальние углы лежат на расстоянии 21 м от линии крана по глубине, поэтому предельный сдвиг по фасаду равен w = √(R² − 21²), а стоянка допустима при x от 60 − w до w, если w меньше 60 м. Формула — расчёт КРАН-КУБАНЬ на плоской схеме без учёта габаритов противовеса и соседних зданий.</p>
    <p>Для КБ-408.21 с вылетом 40 м получается w = √1159 = 34,04 м и полоса 25,96…34,04 м шириной 8,1 м. Для giraFFe SMK-5.66 с R = 43 м: w = 37,52 м, полоса 22,48…37,52 м, ширина 15,0 м. Для КБ-674А с R = 50,5 м: w = 45,93 м, полоса 14,07…45,93 м, ширина 31,9 м. Для Potain MCH 175 с R = 55 м: w = 50,83 м, полоса 9,17…50,83 м, ширина 41,7 м. Для Potain MDT 219 J10 с R = 65 м: w = 61,51 м ≥ 60 м, полоса — весь фасад.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>КБ-408.21 имеет самый короткий вылет в парке КРАН-КУБАНЬ — 40 м, поэтому ставить его у этого дома можно только в полосе от 25,96 до 34,04 м от начала фасада, то есть в центре плюс-минус 4 м. Любой сдвиг дальше оставляет один из крайних углов за пределами стрелы, и его придётся обслуживать другим краном или автокраном.</p>
    <p>На рельсовом пути ограничение смягчается: кран ездит вдоль фасада, и стоянку выбирают под конкретную секцию. Но тогда в расчёт входит длина пути и его основание, а условие «достать углы» применяют к каждой позиции. Состав основания и ограничения путей — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>; КБ-408.21 как модель — на странице <a href="/park/kb-408-21/">парка</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Potain MDT 219 J10 с вылетом 65 м достаёт оба дальних угла с любой точки вдоль фасада 60 м: w = 61,51 м превышает длину дома. Это даёт проектировщику свободу разместить фундамент там, где нет коммуникаций, и не привязываться к центру. Потребное для этого основание описано на странице <a href="/park/potain-mdt-219-j10/">модели</a>.</p>
    <p>Potain MCH 175 с маховой стрелой допускает полосу 41,7 м, а вылет сокращается наклоном стрелы, когда рядом соседние здания. Для узкого двора между домами это решающее свойство. КБ-674А с полосой 31,9 м занимает промежуточное положение; его приставной вариант интересен, когда дом будет выше 60 м — разбор в статье <a href="/blog/svobodnostoyashchiy-ili-pristavnoy-bashennyi-kran/">«Свободностоящий или приставной башенный кран»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Вылет — это не груз: грузоподъёмность падает по мере удаления от мачты, и у дальнего угла кран поднимает не максимальную массу. По реестру КРАН-КУБАНЬ у КБ-674А это 5,6 т на 50,5 м против 12,5 т максимума, у Potain MDT 219 J10 — 1,9 т на 65 м против 10 т, у Potain MCH 175 — 1,5 т на 55 м, у giraFFe SMK-5.66 — 1,05 т на 43 м. Для КБ-408.21 масса на конце стрелы в реестре не указана, и КРАН-КУБАНЬ не называет её без паспорта.</p>
    <p>Дальний угол в 36,6 м лежит внутри вылета всех моделей, но не на самом конце стрелы, поэтому реальная грузоподъёмность там выше табличной «на конце». Её определяют по грузовой характеристике из паспорта; методика и примеры — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>. Тяжёлые панели и лестничные марши раскладывают ближе к крану, лёгкие — к дальним углам.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Сводка показывает расчёт КРАН-КУБАНЬ для условного дома 60 × 15 м высотой 42 м (потребный крюк 49,5 м, вылет до дальнего угла от середины 36,6 м). Знак «+» означает запас, «−» — дефицит по высоте крюка; полоса — отрезок фасада, где стоянка допустима.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Высота крюка</th><th>Запас по высоте (49,5 м)</th><th>Вылет</th><th>Полоса стоянки</th></tr></thead>
      <tbody>
        <tr><td>giraFFe SMK-5.66</td><td>до 41,7 м</td><td>−7,8 м</td><td>43 м</td><td>15,0 м</td></tr>
        <tr><td>КБ-408.21</td><td>54,0–72,7 м</td><td>+4,5 м (от минимума)</td><td>40 м</td><td>8,1 м</td></tr>
        <tr><td>КБ-674А</td><td>до 60 м свободно</td><td>+10,5 м</td><td>50,5 м</td><td>31,9 м</td></tr>
        <tr><td>Potain MCH 175</td><td>до 58,5 м</td><td>+9,0 м</td><td>до 55 м</td><td>41,7 м</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>до 70,4 м</td><td>+20,9 м</td><td>65 м</td><td>весь фасад (60 м)</td></tr>
      </tbody>
    </table></div>
    <p>Для SMK-5.66 полоса указана справочно: по высоте модель не подходит. Цены, сроки и масса секций для реального дома зависят от проекта и здесь не называются. Размеры дома, число секций и расстояние до фасада можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и точку стоянки. Если на площадке потребуются два крана, схема — в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: высота крюка, вылет и грузоподъёмность пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, п. 114 (перемещение груза на 0,5 м выше препятствий)' },
      { href: 'https://kran-kuban.ru/blog/vylet-bashennogo-krana-po-modelyam/', label: 'kran-kuban.ru — вылет башенного крана по моделям' },
    ]} />
</BlogArticleLayout>
