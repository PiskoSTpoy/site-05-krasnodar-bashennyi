---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 119. Сто третья статья блога — угол (c) практический / региональный.
// Ейский район (муниципальный район вокруг города): город Ейск и порт разобраны отдельно
// (kran-dlya-eyska: порт, элеватор, азовский ветер, сезон), поэтому здесь слой района:
// площадь, береговая линия, косы, население и убыль, 11 поселений, пашня, соседи.
//
// Фактура — один источник (curl, cp1251, проверено 25.10.2026):
// smokk.ru/about/association-members/eyskiy-rayon — район на полуострове, восточный берег
// Таганрогского залива, у основания Ейской косы; омывается Таганрогским и Ясенским заливами,
// Ейским и Бейсугским лиманами, Азовским морем; самая удалённая точка на северо-западе края;
// граничит с Щербиновским, Каневским и Приморско-Ахтарским районами; площадь 2120,3 км²;
// Ейск — порт, 247 км к северо-западу от Краснодара и 172 км к юго-западу от Ростова-на-Дону;
// 11 поселений, 32 населённых пункта: 1 город, 4 станицы, 27 сёл, посёлков, хуторов;
// пашня (включая ЛПХ) на 01.01.2011 — 143,2 тыс. га (колхозы 97,3, КФХ 27,9, малые и прочие 15,4,
// ЛПХ 2,6); три песчаные косы — Ейская, Долгая, Камышеватская; Долгая — ландшафтный памятник
// природы края; климат умеренно континентальный, 170 солнечных дней, купальный сезон с конца мая
// по сентябрь; население 134 657 (01.01.2022), 134 379 (2023), 134 117 (2024), 132 763 (2025).
// Расчёты КРАН-КУБАНЬ: −278, −262, −1354; итого −1894 (−1,4 %); 132 763 / 2120,3 ≈ 62,6 чел./км²;
// 143,2 тыс. га = 1432 км² ≈ 67,5 % площади района; 97,3 + 27,9 + 15,4 + 2,6 = 143,2 (сходится);
// 2120,3 / 11 ≈ 192,8 км² на поселение; 132 763 / 32 ≈ 4149 жителей на населённый пункт (среднее).
// В источнике несовпадение: «2120,08 тыс. га» против 2120,3 км² и «более 140 тыс. жителей в 40
// населённых пунктах» против 32 населённых пунктов — эти строки НЕ использованы.
// НЕ названо: грунт, балл сейсмичности, ветер в цифрах, цены, состав застройки по годам.

const CHECKED = '25 октября 2026 года';
const PUBLISHED = '2026-10-25';

const title = 'Кран для Ейского района: 2120 км² у Азовского моря';
const description = 'Ейский район — 2120,3 км² между заливами и лиманами, 132 763 жителя на 01.01.2025, 11 поселений и три косы. Какой башенный кран нужен на азовской площадке.';
const h1 = 'Кран для Ейского района: что учесть на площадке между заливами и лиманами';
const crumbTitle = 'Кран для Ейского района';
const slug = 'kran-dlya-eyskogo-rayona';

const H2 = [
  '2120,3 км² на полуострове между заливами и лиманами',
  '11 поселений и 32 населённых пункта: где искать площадку',
  '132 763 жителя и убыль 1,4 % за три года',
  'Три косы и вода со всех сторон: что это для основания',
  'Климат: 170 солнечных дней и купальный сезон с конца мая',
  '1432 км² пашни: агрохолдинги, склады и элеваторы',
  'Сейсмика, тишина и грунт для площадки района',
  'Порядок выбора башенного крана для азовского района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Ейского района?',
    a: '2120,3 км² по описанию района на сайте ассоциации «Совет муниципальных образований Краснодарского края» (СМОКК). Район расположен на полуострове у основания Ейской косы, на восточном берегу Таганрогского залива. Расчёт КРАН-КУБАНЬ при 132 763 жителях даёт плотность около 62,6 человека на км².',
  },
  {
    q: 'Сколько человек живёт в Ейском районе?',
    a: '132 763 человека на 1 января 2025 года по данным СМОКК. На 1 января 2022 года было 134 657 жителей: за три года население уменьшилось на 1894 человека, или на 1,4 %. Годовые разницы и итоговую убыль рассчитала инженерная служба КРАН-КУБАНЬ.',
  },
  {
    q: 'Сколько поселений в Ейском районе?',
    a: 'Одиннадцать: Ейское городское и десять сельских — Александровское, Должанское, Ейское, Камышеватское, Копанское, Красноармейское, Кухаривское, Моревское, Трудовое и Ясенское. Вместе они объединяют 32 населённых пункта — один город, четыре станицы и 27 сёл, посёлков и хуторов, по данным СМОКК.',
  },
  {
    q: 'Какой климат в Ейском районе?',
    a: 'Умеренно континентальный: по описанию СМОКК, солнце освещает пляжи 170 дней в году, а купальный сезон идёт с конца мая по сентябрь. Ветер и осадки в цифрах источник не приводит, и КРАН-КУБАНЬ их не называет; предел ветра для крана берут из паспорта модели.',
  },
  {
    q: 'Какой балл сейсмичности в Ейском районе?',
    a: 'Описание района на сайте СМОКК балл сейсмичности не приводит, и КРАН-КУБАНЬ не называет его без первоисточника. Значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000, а для ответственных объектов уточняют сейсмическим микрорайонированием.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Азовское побережье"
  published={PUBLISHED}
>
    <p slot="intro">Ейский район занимает 2120,3 км² на полуострове между Таганрогским и Ясенским заливами, лиманами и Азовским морем, и на 1 января 2025 года в нём жили 132 763 человека. Вода окружает район почти со всех сторон, поэтому КРАН-КУБАНЬ начинает подбор башенного крана с основания и ветра, а не с высоты. Ниже — цифры района по данным СМОКК и расчёты инженерной службы.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>По описанию ассоциации «Совет муниципальных образований Краснодарского края» (СМОКК), Ейский район лежит на полуострове у основания Ейской косы, на восточном берегу Таганрогского залива, и занимает 2120,3 км². С разных сторон к нему подходят два залива — Таганрогский и Ясенский, лиманы Ейский и Бейсугский, а также Азовское море. СМОКК называет район самой дальней точкой северо-запада края.</p>
    <p>Для КРАН-КУБАНЬ это значит три вещи: подвоз секций тралом приходится планировать от самой площадки, вода подступает к району с нескольких сторон, а сам район граничит с тремя соседями — Щербиновским, Каневским и Приморско-Ахтарским. Соседние территории разобраны в статьях <a href="/blog/kran-dlya-shcherbinovskogo-rayona/">«Кран для Щербиновского района»</a>, <a href="/blog/kran-dlya-kanevskogo-rayona/">«Кран для Каневского района»</a> и <a href="/blog/kran-dlya-primorsko-ahtarskogo-rayona/">«Кран для Приморско-Ахтарского района»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>В районе, по данным СМОКК, 11 поселений, объединяющих 32 населённых пункта: один город, четыре станицы и 27 сёл, посёлков и хуторов. Поселения такие: Ейское городское, а также сельские — Александровское, Должанское, Ейское, Камышеватское, Копанское, Красноармейское, Кухаривское, Моревское, Трудовое и Ясенское. Расчёт КРАН-КУБАНЬ даёт в среднем 192,8 км² на поселение: район широко разбросан, а не сосредоточен в одном городе.</p>
    <p>Для заказчика КРАН-КУБАНЬ из этого следует практический вывод: адрес объекта в Ейском районе почти никогда не совпадает с адресом города Ейска, и расстояние до площадки влияет на перебазировку. Город Ейск с портом и элеватором разобран в статье <a href="/blog/kran-dlya-eyska/">«Кран для Ейска»</a>; здесь речь о районе вокруг него. Цену и срок перебазировки КРАН-КУБАНЬ не называет без адреса и модели.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Население Ейского района за три года сократилось со 134 657 до 132 763 человек — на 1894, или на 1,4 %, а плотность на 1 января 2025 года — около 62,6 человека на км². Численности по датам приводит СМОКК; годовые разницы, убыль и плотность рассчитала инженерная служба КРАН-КУБАНЬ.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>На дату</th><th>Жителей</th><th>За год</th><th>Плотность, чел./км²</th></tr></thead>
      <tbody>
        <tr><td>01.01.2022</td><td>134 657</td><td>—</td><td>63,5</td></tr>
        <tr><td>01.01.2023</td><td>134 379</td><td>−278</td><td>63,4</td></tr>
        <tr><td>01.01.2024</td><td>134 117</td><td>−262</td><td>63,3</td></tr>
        <tr><td>01.01.2025</td><td>132 763</td><td>−1354</td><td>62,6</td></tr>
      </tbody>
    </table></div>
    <p>Для КРАН-КУБАНЬ интересен скачок: за два года убыль была около 270 человек в год, а за год до 1 января 2025 года — 1354, примерно в пять раз больше. Причины источник не называет, и КРАН-КУБАНЬ их не домысливает. Осторожный вывод для строительного спроса: население не растёт, и КРАН-КУБАНЬ не опирается на прирост жителей при оценке загрузки района.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>В районе, по описанию СМОКК, находятся три уникальные песчаные косы — Ейская, Долгая и Камышеватская. Коса Долгая является ландшафтным памятником природы Краснодарского края; её описание — ракушечные пляжи, глубокое море и пресноводные озёра. Для башенного крана это не декоративная деталь: рядом с водой и на песке основание под рельсовый путь или фундамент определяют изыскания, а охраняемый статус отдельных территорий, например косы Долгой, может накладывать собственные ограничения; их выясняют до заказа крана.</p>
    <p>Гидрогеологию района СМОКК не описывает, и КРАН-КУБАНЬ не называет глубину грунтовых вод или несущую способность. Для Potain MDT 219 J10 и КБ-408.21 основание проектируют по данным изысканий, а для giraFFe SMK-5.66 с опорным контуром 4 × 4 м без фундамента подготовка площадки проще, но ровное твёрдое основание всё равно нужно. Состав изысканий — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Климат района умеренно континентальный: по описанию СМОКК, солнце освещает песчаные пляжи 170 дней в году, а купальный сезон идёт с конца мая по сентябрь. Температуры, осадки и ветер в цифрах источник не приводит, и КРАН-КУБАНЬ не подставляет чужих значений.</p>
    <p>Для башенного крана важнее другое: на открытом берегу ветер ограничивает работу, а его предел определяет паспорт модели, а не климатическая справка. Порядок остановки работ и связь предела с паспортом — в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>, а приморские особенности — соль, влага и бризы — в статье <a href="/blog/bashennyi-kran-u-morya/">«Башенный кран у моря»</a>. Курортный сезон ограничивает шумные работы по закону № 608-КЗ, о чём в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Ейский район, по данным СМОКК, — один из крупных сельскохозяйственных районов края. На 1 января 2011 года пашня района вместе с подсобными хозяйствами граждан занимала 143,2 тыс. га. Основная часть — 97,3 тыс. га — приходилась на коллективные хозяйства, 27,9 тыс. га обрабатывали фермеры, 15,4 тыс. га — малые и прочие предприятия, ещё 2,6 тыс. га — личные подворья. Слагаемые КРАН-КУБАНЬ сложил сам: 97,3 + 27,9 + 15,4 + 2,6 = 143,2, итог сходится.</p>
    <p>Расчёт КРАН-КУБАНЬ: 143,2 тыс. га — это 1432 км², около 67,5 % площади района. Данные на 2011 год старые, и КРАН-КУБАНЬ не утверждает, что структура сохранилась. Но масштаб показывает, откуда у района объекты хранения: склады, элеваторные корпуса и зернохранилища. Для них подход к выбору крана разобран в статьях <a href="/blog/kran-dlya-silosnogo-korpusa/">«Кран для силосного корпуса»</a> и <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Балл сейсмичности Ейского района СМОКК не приводит, и КРАН-КУБАНЬ не называет его без первоисточника: значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000. Если объект ответственный, балл уточняют сейсмическим микрорайонированием — сроки и место в графике разобраны в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Закон Краснодарского края № 608-КЗ о тишине действует во всех поселениях района: в будни шумные работы разрешены с 08:00 до 13:00 и с 15:00 до 23:00. Вечернее окно в сезон с коротким днём приходится на темноту, поэтому площадку освещают по ГОСТ 12.1.046-2014; нормы — в статье <a href="/blog/osveshchenie-ploshchadki-bashennogo-krana/">«Освещение площадки башенного крана»</a>. Грунт района в описании СМОКК не упомянут, его определяют изысканиями.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Модель под объект в Ейском районе КРАН-КУБАНЬ подбирает в четыре шага, начиная с воды и основания. Порядок — практика инженерной службы, а не норма.</p>
    <ol>
      <li>Основание: если площадка у воды или на песке, сначала изыскания; при слабом и неровном основании giraFFe SMK-5.66 с опорным контуром 4 × 4 м без фундамента упрощает подготовку, но высота его крюка — до 27 м с горизонтальной стрелой и до 41,7 м с наклонной.</li>
      <li>Высота здания: до 58,5 м — Potain MCH 175, до 60 м свободно — КБ-674А, до 70,4 м — Potain MDT 219 J10, до 72,7 м — КБ-408.21.</li>
      <li>Ветер: предельное значение берут из паспорта модели и сопоставляют с открытым берегом; ограничение определяет график, а не обязательно модель.</li>
      <li>Подъезд и перебазировка: трал с секциями идёт по дорогам района, и маршрут проверяют до подтверждения даты.</li>
    </ol>
    <p>Адрес с названием поселения и размеры объекта можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель, основание и проверит подъезд. Цены и сроки зависят от площадки, поэтому без исходных данных они не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/eyskiy-rayon/', label: 'smokk.ru — Ейский муниципальный район: население, география, поселения, климат, сельское хозяйство' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
