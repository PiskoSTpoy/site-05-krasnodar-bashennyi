---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 122. Сто двенадцатая статья блога — угол (c) практический / региональный.
// Источник: smokk.ru/about/association-members/belorechenskiy-rayon (curl, проверено 28.10.2026).
// Факты источника: население 107 047 (01.01.2022) → 105 803 → 104 745 → 104 863 (01.01.2025);
// расчёт КРАН-КУБАНЬ: убыль за три года 107 047 − 104 863 = 2184 чел., 2184 / 107 047 = 2,04 % ≈ 2,0 %;
// 2022→2023: −1244 (1,16 %); 2023→2024: −1058 (1,00 %); 2024→2025: +118 (+0,11 %);
// площадь района 1326 км²; плотность 104 863 / 1326 = 79,08 ≈ 79,1 чел./км² (для сравнения: Славянский район 56,8);
// реки Белая и Пшеха текут с юга на север; восточная часть — равнина с повышением к Гиагинскому району на 20–25 м, западная уходит на понижение;
// бальнеоклиматическая курортная местность Великовечное; район образован 2 июня 1924 (Майкопский округ), 12 сельсоветов;
// 28.12.1934 выделен Рязанский район, 22.08.1953 вернулась его территория, 01.02.1963 вошли сельсоветы Апшеронского и Горячеключевского районов,
// 12.01.1965 район восстановлен в прежних границах, 29.11.1979 Белореченск — город краевого подчинения, остаётся центром,
// 2005 — 11 муниципальных образований (список источника пересчитан: 11, включая город);
// экономика: химическая и перерабатывающая промышленность, стройматериалы; пищевая — более 45 % объёма промпроизводства
// (растительное масло, кондитерские и хлебопекарные изделия, консервы); сельхозугодья 67 тыс. га (= 670 км², 50,5 % от 1326 км²),
// из них пашня 54 тыс. га (= 540 км², 40,7 %); узловая ж/д станция, федеральные маршруты к портам и курортам Черноморского побережья.
// Грунт, сейсмика, ветер, подтопление в источнике НЕТ — не названы. Город Белореченск разобран отдельно (kran-dlya-belorechenska);
// здесь акцент на район: 11 поселений, две реки, Великовечное, пищепром. Модели — только parkModels.ts.

const CHECKED = '28 октября 2026 года';
const PUBLISHED = '2026-10-28';

const title = 'Кран для Белореченского района: 1326 км², реки и пищепром';
const description = '104 863 жителя на 01.01.2025, 11 поселений, пищевая промышленность свыше 45 % выпуска по данным СМОКК. Какой башенный кран нужен в районе.';
const h1 = 'Какой башенный кран выбрать для объекта в Белореченском районе Краснодарского края?';
const crumbTitle = 'Кран для Белореченского района';
const slug = 'kran-dlya-belorechenskogo-rayona';

const H2 = [
  'Река Белая, Пшеха и равнина: 1326 км² района',
  '11 муниципальных образований и город-центр',
  '104 863 жителя: убыль остановилась в 2025 году',
  'Две реки рядом с площадкой: что это значит для основания',
  'История: от 12 сельсоветов до 11 поселений',
  'Пищепром, пашня и курорт Великовечное: кому нужен кран',
  'Железная дорога и подвоз секций',
  'Порядок выбора башенного крана для Белореченского района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько жителей в Белореченском районе и как меняется население?',
    a: 'По данным СМОКК, на 1 января 2025 года в районе 104 863 жителя. На 1 января 2022 года было 107 047, убыль за три года — 2184 человека, около 2,0 %. Последний год принёс рост на 118 человек, около 0,1 %. Для застройщика это ровный спрос на замену и точечное строительство.',
  },
  {
    q: 'Какая площадь Белореченского района и сколько в нём поселений?',
    a: 'Площадь района — 1326 км². С 2005 года в районе образовано 11 муниципальных образований, включая Белореченское городское поселение и 10 сельских. КРАН-КУБАНЬ просит указывать в заявке поселение, потому что разрешение на строительство и обращения по закону № 608-КЗ рассматривает местная администрация.',
  },
  {
    q: 'Чем Белореченский район отличается от города Белореченска?',
    a: 'Район — это 1326 км² с 11 поселениями, а город является его центром и с 1979 года относится к городам краевого подчинения. Промышленность и жильё города разобраны в отдельной статье КРАН-КУБАНЬ. Здесь рассматриваются станицы, пищевые производства, пашня и курортная местность Великовечное.',
  },
  {
    q: 'Влияют ли реки Белая и Пшеха на выбор основания под башенный кран?',
    a: 'СМОКК данных о грунтах и уровне вод не приводит, и КРАН-КУБАНЬ их не называет. Две реки текут через район с юга на север, поэтому для площадки рядом с руслом основание выбирают по изысканиям, а не по аналогии. Метод описан в статье КРАН-КУБАНЬ об изысканиях перед монтажом.',
  },
  {
    q: 'Какая модель подходит для корпуса пищевого производства в районе?',
    a: 'Для низких цехов и складов хватает giraFFe SMK-5.66 или КБ-408.21, для высоких корпусов берут Potain MCH 175 до 58,5 м, КБ-674А до 60 м свободно или Potain MDT 219 J10 до 70,4 м. Решает форма здания и место стоянки: расчёт для ангара и корпуса приведён в статьях о складе и производственном корпусе.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Долины Белой и Пшехи"
  published={PUBLISHED}
>
    <p slot="intro">Белореченский район занимает 1326 км², насчитывает 104 863 жителя на 1 января 2025 года и 11 муниципальных образований, а пищевая промышленность, по данным СМОКК, формирует более 45 % его промышленного производства. Для башенного крана КРАН-КУБАНЬ это объекты двух типов: жильё и социальные здания в станицах и цеха переработки, а главный вопрос — основание рядом с реками Белой и Пшехой.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Площадь Белореченского района, по данным СМОКК, составляет 1326 км², и КРАН-КУБАНЬ берёт её за основу расчёта. Рельеф разнообразен: в восточной части лежит равнина с повышением в сторону Гиагинского района на 20–25 м, западная часть уходит на понижение. С юга на север по низменной равнине текут две реки — Белая и Пшеха, и обе проходят через территорию, где ведётся строительство.</p>
    <p>Расчёт КРАН-КУБАНЬ: плотность населения 104 863 человека на 1326 км² — около 79,1 человека на квадратный километр, то есть в 1,4 раза выше, чем в Славянском районе (56,8). Для заказчика цифра означает более плотную сеть станиц и более короткие перебазировки между объектами. Соседние районы края разобраны в статьях <a href="/blog/kran-dlya-apsheronskogo-rayona/">«Кран для Апшеронского района»</a> и <a href="/blog/kran-dlya-kurganinskogo-rayona/">«Кран для Курганинского района»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>С 2005 года в Белореченском районе действуют 11 муниципальных образований: Белореченское городское и 10 сельских — Бжедуховское, Великовечненское, Дружненское, Первомайское, Пшехское, Родниковское, Рязанское, Черниговское, Школьненское и Южненское. Число КРАН-КУБАНЬ пересчитал по списку СМОКК, и оно совпало с итогом 11.</p>
    <p>Город Белореченск с 1979 года относится к городам краевого подчинения, но остаётся центром района. В заявке на КРАН-КУБАНЬ указывают поселение, а не только район: администрация поселения выдаёт разрешения и принимает обращения по закону № 608-КЗ. Сам город с химическим заводом и предгорьем разобран отдельно в статье <a href="/blog/kran-dlya-belorechenska/">«Кран для Белореченска»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Население района, по данным СМОКК, сокращалось два года подряд и потом выросло: 107 047 человек на 1 января 2022 года, 105 803 на 1 января 2023, 104 745 на 1 января 2024 и 104 863 на 1 января 2025. Расчёт КРАН-КУБАНЬ: убыль за три года 107 047 − 104 863 = 2184 человека, около 2,0 %, но за последний год численность прибавила 118 человек, около 0,1 %.</p>
    <p>Для застройки, по оценке КРАН-КУБАНЬ, это сигнал о ровном спросе: заменяют фонд, строят школы, склады и цеха, а потоков нового жилья нет. Под такие объекты подходит весь парк от лёгкого giraFFe SMK-5.66 до КБ-674А, и выбор определяют высота и вылет конкретного объекта. Подход — в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Белая и Пшеха пересекают район с юга на север, и в станицах вдоль русел строят дома, магазины и производственные здания. СМОКК данных о грунтах, глубине подземных вод и паводках не приводит, и КРАН-КУБАНЬ их не называет: значение для площадки получают изысканиями. Метод описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Практический вывод для Potain MDT 219 J10 и КБ-408.21, которым нужен рельсовый путь или фундамент, в том, что основание закладывают в проект до выбора модели; сравнение вариантов — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. После ливня путь проверяют внепланово, и порядок разобран в статье <a href="/blog/vneocherednaya-proverka-relsovogo-puti-posle-livnya/">«Внеочередная проверка рельсового пути после ливня»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>КРАН-КУБАНЬ напоминает: Белореченский район образован 2 июня 1924 года в составе Майкопского округа Юго-Восточной области из территорий шести упразднённых волостей и первоначально включал 12 сельских советов. 28 декабря 1934 года из него выделили Рязанский район, 22 августа 1953 года территорию упразднённого Рязанского района вернули.</p>
    <p>1 февраля 1963 года к району присоединили сельские советы упразднённых Апшеронского и Горячеключевского районов, а 12 января 1965 года его восстановили в прежних границах. 29 ноября 1979 года Белореченск стал городом краевого подчинения, в 1993 году прекратили деятельность сельских советов, в 2005 году образовали 11 муниципальных образований. Практический вывод КРАН-КУБАНЬ: в старых документах на землю названия и границы могут отличаться от нынешних, и это проверяют до заявки на монтаж.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>СМОКК называет основой экономики района химическую и перерабатывающую промышленность, производство стройматериалов и рынок услуг; пищевая промышленность формирует более 45 % объёма промышленного производства. В районе выпускают растительное масло, кондитерские и хлебопекарные изделия, консервы. Для башенного крана это цеха, склады и силосные объекты, высота и форма которых определяются технологией.</p>
    <p>Сельскохозяйственных угодий в районе, для КРАН-КУБАНЬ значимых как фон застройки, 67 тыс. га, из них пашни 54 тыс. га. В квадратных километрах это 670 и 540 км²: угодья занимают около 50,5 % площади района, пашня — около 40,7 %. Для застройки это значит, что станицы окружены полями, а площадки часто открыты ветру. Порядок работы кранов КБ-674А и Potain MDT 219 J10 в ветер описан в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>
    <p>На территории района СМОКК отмечает бальнеоклиматическую курортную местность Великовечное. Рядом с курортом и жильём действуют ограничения по шуму и времени работы, которые вытекают из закона № 608-КЗ; нормы шума — в статье <a href="/blog/uroven-shuma-v-decibelah/">«Уровень шума в децибелах»</a>. Методика для широкого низкого цеха и высокого корпуса — в статьях <a href="/blog/kran-dlya-sklada-angara/">«Кран для склада-ангара»</a> и <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Через район проходят важнейшие железнодорожные маршруты федерального значения к портам и курортам Черноморского побережья, расположена узловая железнодорожная станция. Для КРАН-КУБАНЬ это возможность доставлять груз по железной дороге и затем автотранспортом, но секции башни, стрела и противовесы всё равно идут тралом, и маршрут от базы до поселения проверяют до подтверждения даты монтажа.</p>
    <p>Выгрузку материалов со станции регулируют нормы ФНП, разобранные в статье <a href="/blog/pogruzka-razgruzka-transporta-bashennym-kranom/">«Погрузка и разгрузка транспорта башенным краном»</a>. Тару для бетона и кирпича на объектах района описывает статья <a href="/blog/tara-dlya-bashennogo-krana-po-fnp/">«Тара для башенного крана по ФНП»</a>. Сроки монтажа — в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Модель под объект в Белореченском районе КРАН-КУБАНЬ подбирает в четыре шага, начиная с типа здания. Порядок — практика инженерной службы, а не норма.</p>
    <ol>
      <li>Тип объекта: жилой дом, школа или цех — кран на низкий корпус до 27 м по крюку даёт giraFFe SMK-5.66, на высокий корпус — Potain MCH 175, КБ-674А или Potain MDT 219 J10.</li>
      <li>Основание: изыскания определяют, рельсовый путь, фундамент или опорный контур 4 × 4 м без фундамента; грунт района СМОКК не описывает, а рядом с Белой и Пшехой его выясняют отдельно.</li>
      <li>Ветер и шум: предел определяет паспорт модели, часы работы — закон № 608-КЗ.</li>
      <li>Подвоз и перебазировка: маршрут трала и точка разгрузки согласуются заранее.</li>
    </ol>
    <p>Адрес с названием поселения и размеры объекта можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и основание. Балл сейсмичности района СМОКК не приводит, поэтому его берут по ТСН 22-302-2000 и картам районирования. Цены и сроки зависят от площадки и без исходных данных не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/belorechenskiy-rayon/', label: 'smokk.ru — Белореченский муниципальный район: население, география, история, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
