---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 73. Восьмая статья блога — последняя попытка перед честным потолком
// (см. Волну 72: 0 из 3 городов, ненадёжный ТСН 22-302-2000 при повторных
// запросах к base.garant.ru/docs.cntd.ru, Ейск отклонён по военной теме).
// Задание — качественно новая ось, не «третий курортный/степной город»:
// предгорная специфика (оползневая опасность / курортный статус Горячего
// Ключа). Сработало. Первоисточник — не WebSearch-саммари, а прямой WebFetch
// обоснования генерального плана городского округа Горячий Ключ
// (gorkluch.ru/Arch2/obosn_gp.doc), извлечённый через antiword в сыром виде
// (текст сильно искажался стандартным WebFetch-суммаризатором — та же
// галлюцинация, что поймали Волны 65/72, — поэтому .doc скачан и прочитан
// напрямую, без модели-посредника). Документ: фоновая сейсмичность
// территории 8 баллов (карта ОСР-97(А), СНиП 11-07-87-2000*/СНКК
// 22-301-2000*) — как на побережье; но для площадок «в зоне возможных
// оползневых подвижек и на территориях подтопления» балл прямо предписано
// увеличивать сверх фонового (со ссылкой на тот же ТСН 22-302-2000 и на
// СНиП II-7-81*). Южная часть города — задокументированная с 1983 года
// (ГУП «Кубаньгеология») оползневая зона: улицы Лермонтова, Шевченко,
// Зелёная, Достоевского, Нагорная; катастрофа 1997 года на Нагорной (5
// домов, 1 погибший — факт из официального документа генплана, приведён
// сдержанно, без сенсации, как обоснование норматива, а не как отдельная
// тема). Независимо перепроверено прямым WebFetch (два разных СМИ, РИА
// Новости + REGNUM, взаимно согласованные даты/детали) — оползень 7-20
// февраля 2019 года в ст. Бакинской (тот же городской округ): обрушение
// дороги и части улиц Овражная/Окрайная/Набережная, режим ЧС главы города
// А. Кильганкина. Второй, отдельный слой — курортный статус (постановление
// главы администрации края от 06.12.2006 №1098) и округ горно-санитарной
// охраны в 3 пояса (ООО «Геоминвод», 2010, утверждён постановлением от
// 19.07.2011 №771) — упомянут как самостоятельный, не смешанный с оползневым
// расчётом фактор. base.garant.ru для текста самого закона №41-КЗ повторно
// оказался нечитаемым (та же порча кодировки, что и в Волне 72) — не
// процитирован как источник, использован только факт даты/номера постановления
// из независимо читаемого документа генплана.

const CHECKED = '20 августа 2026 года';

const title = 'Кран для Горячего Ключа: где балл сейсмики выше базового';
const description = 'Оползневая зона юга Горячего Ключа поднимает балл сейсмики для крана выше базовых восьми: генплан округа, ГУП «Кубаньгеология», факты с 1983 года.';
const h1 = 'Кран для Горячего Ключа: не везде в городе «просто восемь баллов»';
const crumbTitle = 'Кран для Горячего Ключа';
const slug = 'kran-dlya-goryachego-klyucha';

const H2 = [
  'Южная часть города: не гипотеза, а тридцать лет наблюдений',
  'Норматив: почему балл увеличивают, а не оставляют «восемь»',
  'Что это меняет в проекте монтажа',
  'Второй слой: курортный статус и округ охраны',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Если фоновая сейсмичность Горячего Ключа — 8 баллов, как на побережье, зачем отдельно говорить про оползни?',
    a: '8 баллов — это фоновое значение по карте ОСР-97(А) для территории в целом, а не потолок для каждой конкретной площадки. Материалы генерального плана городского округа прямо указывают: на территориях в зоне возможных оползневых подвижек и подтопления расчётный балл должен быть увеличен сверх фонового. Для южной части города, где с 1983 года документированы неоднократные активизации оползней, это не гипотетическое, а действующее требование к проекту основания.',
  },
  {
    q: 'Как понять, что конкретный адрес попадает в зону риска, а не просто «где-то на юге города»?',
    a: 'По границам, которые устанавливают инженерные изыскания с расчётом устойчивости склона, а не по общему описанию района. Этот документ мы запрашиваем на этапе заявки; если отдельного отчёта по площадке нет, закладываем расчёт основания как для повышенного балла — до начала монтажа, а не после того, как проект придётся пересчитывать.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Горячего Ключа', item: `${SITE}/blog/kran-dlya-goryachego-klyucha/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-goryachego-klyucha/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-goryachego-klyucha/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Заявка на башенный кран в Горячем Ключе часто начинается с одной и той же короткой справки: «у нас как на побережье — восемь баллов». Это правда, но не вся правда: для конкретных улиц южной части города действующий норматив требует не оставлять этот балл как есть, а поднимать его дальше — потому что площадка стоит не просто в сейсмической зоне, а в задокументированной оползневой. Ниже — что именно наблюдают на этих склонах почти сорок лет, откуда берётся требование повышать балл и что это значит для проекта монтажа.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Оползневые процессы в Горячем Ключе сосредоточены в южной части города, а наибольшая поражённость — на юго-западной окраине, вдоль тектонической трещины (надвига). С 1983 по 2007 год ГУП «Кубаньгеология» фиксировало неоднократные активизации оползней по улицам Лермонтова, Шевченко, Зелёной, Достоевского и Нагорной — это результат многолетних инженерно-геологических наблюдений, вошедших в материалы генерального плана городского округа, а не оценка «на глаз». Самый изученный участок — склон водораздела между улицами Лермонтова и Шевченко, между ручьём Школьным и безымянной балкой; в феврале 2003 года там сошёл новый оползень-поток, а активизации на этом же склоне отмечались в 1993, 1997 и 2002 годах.</p>
    <p>Самый тяжёлый задокументированный случай — 1997 год, улица Нагорная: катастрофическая активизация оползневых процессов уничтожила пять жилых домов, погиб один человек. Причина — переувлажнение склона затяжными дождями, а не разовая авария на ровном месте. Активизации на этих же улицах повторялись в 2003, 2005–2007 годах (на Достоевского оползень продвинулся на 10–15 м вверх по склону), в 2006-м — на юго-восточной окраине, и в 2007-м — на улице Щорса, где новый блоковый оползень шириной 20 м был связан уже с техногенной нагрузкой на склон, а не только с погодой.</p>
    <p>Это не только история XX века. В феврале 2019 года в станице Бакинской — том же городском округе — оползень на берегу реки Псекупс частично разрушил дорогу и участки улиц Овражная, Окрайная и Набережная; глава города Александр Кильганкин ввёл режим чрезвычайной ситуации и организовал объезд по улице Октябрьской, пока решался вопрос с укреплением берега. Независимо от генплана эту хронику подтверждают два разных источника — РИА Новости и REGNUM — с совпадающими датами и деталями.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Материалы генерального плана прямо формулируют, что это значит для проекта: «Балл сейсмичности на территориях, расположенных в зоне возможных оползневых подвижек и на территориях подтопления, должен быть увеличен» — сверх фоновой сейсмичности территории, которая по картам ОСР-97(А) и СНиП 11-07-87-2000*/СНКК 22-301-2000* составляет 8 баллов, как и на большей части побережья края (подробнее о том, что стоит за этим значением — на странице <a href="/seysmozony/8-ballov/" style="color:var(--accent)">«Площадка 8 баллов»</a>). Требование опирается на тот же территориальный норматив, ТСН 22-302-2000 (СНКК 22-301-2000), и на федеральный СНиП II-7-81* «Строительство в сейсмических районах» — оба уже не раз цитировались на этом сайте, но здесь впервые применяются не к площадке на побережье, а к конкретному городскому склону в 40 км от моря.</p>
    <p>Разница с обычной восьмибалльной площадкой не в названии зоны, а в исходных данных для расчёта: проектировщик обязан взять не средний балл по карте, а балл, поднятый под конкретный склон, — а значит, основание должно выдержать бóльшую горизонтальную нагрузку, чем стандартная восьмибалльная площадка в другой части того же города.</p>

    <h2 id={headings[2].id} style="margin:36px 0 18px">{headings[2].text}</h2>
    <p>Практически это означает, что заявка на кран для площадки в южной части Горячего Ключа не может опираться на общий балл по городу — нужен документ, который фиксирует, входит ли конкретный адрес в границы оползнеопасной территории. Эти границы устанавливают по данным инженерных изысканий с расчётом устойчивости склона, а не по факту «дом стоит на возвышенности» — та же логика, что применяется к категории грунта на равнинной площадке и разобрана в разделе <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>. Мы запрашиваем этот документ на этапе заявки: если отдельного отчёта по площадке нет, а адрес — в южной части города, закладываем расчёт как для повышенного балла, а не как для базовой восьмёрки.</p>
    <p>Для башенного крана на фундаменте или рельсовом пути это означает более тяжёлую анкеровку — расчёт на сейсмическую нагрузку и его место в проекте монтажа разобраны на этапе <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>. А там, где склон реально нестабилен, а сама задача — не многомесячная стройка, а точечный объект (кровля, надстройка, короткий монтаж), капитальное основание может оказаться избыточным риском само по себе: для таких случаев в парке есть <a href="/park/giraffe-smk-5-66/" style="color:var(--accent)">giraFFe SMK-5.66</a> — единственная модель, которой не нужен ни путь, ни фундамент, ни анкеровка к склону.</p>

    <h2 id={headings[3].id} style="margin:36px 0 18px">{headings[3].text}</h2>
    <p>Оползневая зона — не единственный региональный слой требований в Горячем Ключе. Городу присвоен статус курорта краевого значения постановлением главы администрации края от 06.12.2006 №1098, а вокруг Псекупского месторождения минеральных вод и лечебных грязей действует округ горно-санитарной охраны из трёх поясов: его последнюю редакцию в 2010 году подготовило ООО «Геоминвод» (Москва) как корректировку работы 1982 года, а утверждена она постановлением главы администрации (губернатора) края от 19.07.2011 №771. В границах самого города в этот периметр особо охраняемых территорий также попадают Дантово ущелье, скала Петушок и массив сосны Крымской.</p>
    <p>Для площадки рядом с такими объектами или в поясах округа санитарной охраны вопрос обычно не про фундамент, а про согласование маршрута подачи техники и точек стоянки — тот же принцип, что уже разобран для анапской Пересыпи на этапе <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>. Это отдельная проверка, которая не заменяет и не отменяет расчёт основания на оползневом склоне: на площадке в южной части города оба фактора вполне могут действовать одновременно.</p>

    <h2 id={headings[4].id} style="margin:36px 0 18px">{headings[4].text}</h2>
    <ul>
      <li>Фоновая сейсмичность Горячего Ключа — 8 баллов, как на большей части побережья, но не потолок для всех площадок города.</li>
      <li>В зоне возможных оползневых подвижек и подтопления норматив требует поднимать расчётный балл выше фоновых восьми — со ссылкой на ТСН 22-302-2000 и СНиП II-7-81*.</li>
      <li>Южная часть города — задокументированная зона с историей активизаций с 1983 года, включая катастрофу 1997 года на улице Нагорной и недавний оползень 2019 года в ст. Бакинской.</li>
      <li>Курортный статус и округ горно-санитарной охраны — отдельный, самостоятельный слой согласований, не заменяющий расчёт основания.</li>
    </ul>
    <p>Что стоит за самим баллом площадки и откуда его берут в целом по краю — в разделе <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны»</a>; похожий случай, когда официальный норматив даёт более тяжёлый балл, чем подсказывает интуиция, — в статье <a href="/blog/kran-dlya-promzony-armavira/" style="color:var(--accent)">«Кран для промзоны Армавира»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://gorkluch.ru/Arch2/obosn_gp.doc', label: 'gorkluch.ru — обоснование генерального плана г.о. Горячий Ключ: оползневые процессы южной части города, требование увеличивать балл сейсмичности, округ горно-санитарной охраны' },
      { href: 'https://ria.ru/20190207/1550557300.html', label: 'РИА Новости (07.02.2019) — оползень и обрушение дороги в ст. Бакинской, режим ЧС' },
      { href: 'https://regnum.ru/news/2576758.html', label: 'REGNUM (20.02.2019) — продолжение оползня в ст. Бакинской, угроза жилым домам' },
    ]} />
</BlogArticleLayout>
