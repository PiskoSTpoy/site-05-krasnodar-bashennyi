---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 69. Шестая статья блога. TOPIC-REGISTRY.md закрепляет норд-ост
// (новороссийскую бору) за этим сайтом как «самостоятельное региональное
// метеоявление» — отдельно от паспортного норматива скорости ветра
// (15/10 м/с), закреплённого за site-07. До этой статьи явление было
// упомянуто в трёх местах сайта одной-двумя фразами: этап «Эксплуатация
// и режим тишины» (60 м/с, свыше 40 дней в году), хаб блога («местное
// явление, которое мы ведём сами») и FAQ («в нерабочем состоянии стрела
// ставится в режим флюгирования») — но ни разу не разобрано, ЧТО именно
// происходит с краном технически. Проверено grep-ом по src/ перед
// началом: ни «флюгирование» как отдельная тема, ни «противоугонн»,
// ни «анемометр», ни конкретный эпизод боры с датой на сайте не
// раскрывались — только упоминания. Это недостающий технический разбор,
// а не пересказ уже опубликованных абзацев.

const CHECKED = '20 августа 2026 года';

const title = 'Кран и норд-ост: флюгирование и противоугонные захваты';
const description = 'Что физически происходит с краном при новороссийской боре: флюгирование стрелы, противоугонные захваты рельсового хода и требование к анемометру.';
const h1 = 'Кран во время норд-оста: флюгирование и противоугонные захваты';
const crumbTitle = 'Кран во время норд-оста';
const slug = 'kran-vo-vremya-nord-osta';

const H2 = [
  '«Больше 40 дней в году» — это режим, а не аномалия',
  'Разгон на Маркотхском перевале: откуда берётся скорость',
  '7–8 февраля 2012 года: так выглядит настоящий эпизод',
  'Анемометр на кране — требование, а не опция',
  'Флюгирование: почему стрелу отпускают, а не блокируют',
  'Противоугонные захваты: та же задача для крана на рельсах',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Можно ли просто закрепить стрелу тормозом, чтобы её не мотало ветром при норд-осте?',
    a: 'Нет, и это не перестраховка, а прямая инструкция по эксплуатации: при усилении ветра поворотный механизм растормаживают, а не блокируют. Зафиксированная стрела ловит всю ветровую нагрузку как жёсткий рычаг на мачте — при порывах боры, которые в Новороссийской бухте фиксировали до 60 м/с, это разрушительный изгибающий момент. Свободный поворот превращает кран в подобие флюгера: стрела сама разворачивается по ветру и нагрузка перестаёт расти со сменой направления.',
  },
  {
    q: 'Нужны ли противоугонные захваты всем четырём моделям парка?',
    a: 'Нет — они относятся только к рельсовому ходу. У КБ-408.21 захваты держат кран на пути: без них ветер способен покатить кран вдоль рельсов. У Potain MDT 219 J10 на монолитном фундаменте этот сценарий физически исключён — кран не может сместиться. КБ-674А анкерован не к рельсам, а к конструкциям здания. giraFFe SMK-5.66 стоит на опорном контуре 4×4 м без пути вообще — вопрос угона по рельсам для него не возникает.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран во время норд-оста', item: `${SITE}/blog/kran-vo-vremya-nord-osta/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-vo-vremya-nord-osta/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-vo-vremya-nord-osta/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Этап <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a> называет норд-ост в одном абзаце: местное явление, которое отбирает у графика не часы, а дни. Хаб блога добавляет вторую фразу — что это «явление, которое мы ведём сами», в отличие от паспортного норматива скорости ветра, закреплённого за другим сайтом сети. Здесь — то, что осталось за скобками в обеих версиях: что физически происходит с краном на площадке, пока бора не утихнет, и почему стрелу в этот момент не блокируют, а, наоборот, отпускают.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>По данным Гидрометцентра России, боры Новороссийской и Геленджикской бухт дуют свыше 40 дней в году, и это число — не редкий рекорд, а обычная многолетняя статистика холодного сезона: с октября по март норд-ост на побережье скорее правило, чем исключение. Один эпизод длится от суток до недели — то есть простой на площадке в это время года планируют не как риск, а как заранее известную часть графика, ровно так, как на самой странице этапа предлагается закладывать резерв на дни, а не на часы.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Механика боры простая физически и жестокая по результату: холодный воздушный фронт с северо-востока натыкается на невысокий прибрежный хребет, перетекает через него и дальше падает по склону к морю, набирая скорость под действием одной только силы тяжести — чем круче перепад высот, тем сильнее разгон. У Новороссийска этим хребтом служит Маркотхский перевал, и именно там фиксируют самые высокие скорости в акватории: средняя зимняя скорость ветра в районе — свыше 20 м/с, а абсолютный зафиксированный рекорд на самом перевале датирован ещё 1928 годом — порыв 80 м/с. Первое задокументированное упоминание явления в этих местах ещё старше: в 1848 году бора в Цемесской бухте застигла военные суда на рейде и стала причиной их гибели — задолго до появления в бухте портовых кранов, но с той же физикой ветра, что действует и сегодня.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Чтобы «более 40 дней в году» не оставалось абстрактным числом, полезен один конкретный случай. 7–8 февраля 2012 года береговые метеостанции Новороссийска зафиксировали скорость ветра 52 м/с, а судовые станции на рейде — до 60 м/с (эта же цифра, без даты, стоит на странице этапа «Эксплуатация»). Температура воздуха при этом упала до −19 °C, без электричества остались около 250 тысяч жителей города, в порту были остановлены работы, а участок федеральной трассы «Дон» — перекрыт. Бора в тот раз охватила не только сам город, а всю северо-восточную акваторию Чёрного моря на 200–300 км. Для площадки это значит одно: во время такого эпизода останавливается не только кран — встаёт логистика, энергоснабжение и подъезд, и планировать резерв нужно на весь этот контур, а не только на паспортный предел техники.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Ветер, который превращается в решение «работать / остановиться / уходить во флюгер», кран не оценивает на глаз. Приказ Ростехнадзора №533 прямо требует: башенный кран как высотное сооружение должен быть оборудован анемометром. Тип прибора нормативно не закреплён — на практике встречаются ультразвуковые (без подвижных частей, для высотных кранов предпочтительны), трёхчашечные и крыльчатые датчики, — но требование к сигналу единое: по ГОСТ 32575.3-2013 сигнализатор обязан выдавать непрерывные усреднённые показания скорости ветра с интервалом осреднения 5 секунд, чтобы короткий порыв не терялся и не давал ложной тревоги на каждом случайном всплеске. Опасен для крана при этом не только сам порыв, а и его перепад: если средняя скорость варьируется, скажем, от 20 до 60 км/ч при среднем значении 40 км/ч, интенсивность турбулентности составляет 50 % — такая рваная нагрузка тяжелее для конструкции, чем ровный, пусть и более сильный ветер.</p>

    <h2 id={headings[4].id} style="margin:36px 0 18px">{headings[4].text}</h2>
    <p>По отраслевой практике эксплуатации в экстремальную погоду порядок действий крановщика при усилении ветра описан пошагово: опустить груз на землю, поднять крюк, отвести кран на стояночную площадку, поставить стрелу горизонтально и развернуть в направлении ветра, растормозить механизм поворота и отключить контактор. Именно растормаживание, а не фиксация, — центральный момент: стрела остаётся свободной и разворачивается по ветру сама, как флюгер, вместо того чтобы принимать всю нагрузку жёстким рычагом на мачту. Если стрелу всё же заклинить в одном положении, конструкция получает знакопеременный изгибающий момент от каждого порыва — при затяжной боре это кумулятивная усталостная нагрузка, а не разовый пик, который кран способен выдержать по паспорту. Самое опасное направление — когда ветер бьёт в борт крана там, где парусность стрелы и противовеса наибольшая, поэтому разворот именно «по ветру», а не «поперёк», не формальность. При этом норматив даёт технике коридор задолго до аварийного предела: движение крана и тележки ограничивают уже на 12–15 м/с, а свыше 20–22 м/с (тот же порог, что уже назван на этапе «Эксплуатация») работы прекращают независимо от типа операции. И крановщику не нужно ждать формального превышения порога: если он видит угрозу раньше цифры на анемометре, у него есть полномочие остановиться самостоятельно — с ответом уже потом, а не наоборот.</p>

    <h2 id={headings[5].id} style="margin:36px 0 18px">{headings[5].text}</h2>
    <p>Флюгирование решает задачу свободностоящего крана на фундаменте — Potain MDT 219 J10 или giraFFe SMK-5.66 из парка сместить ветром физически некуда, у них решается только поворот стрелы. У кранов на рельсовом ходу — а в парке это <a href="/park/kb-408-21/" style="color:var(--accent)">КБ-408.21</a> — к ветровой нагрузке на стрелу добавляется вторая: давление на весь корпус крана, способное покатить его вдоль пути, если ничего не держит колёса на месте. Для этого случая существует отдельный класс устройств — противоугонные захваты, определённые ГОСТ 1451-77: стопорные фиксаторы, останавливающие кран о жёсткий упор, прижимные устройства трения между колесом и рельсом и клещевые захваты, зажимающие головку рельса с боков. Ручной захват обязан быть самозатягивающимся — усилие фиксации создают силы трения между рельсом и элементами захвата, а не мускульная сила крановщика, — при этом усилие для приведения устройства в действие и снятия с фиксации не должно превышать 100 Н. По отраслевой практике сигнал на срабатывание такого захвата у открытых рельсовых кранов подают уже при скорости ветра около 12,5 м/с — заметно раньше порога полной остановки работ, потому что задача захвата другая: не прекратить операцию, а не дать крану уехать, пока он стоит без движения.</p>

    <h2 id={headings[6].id} style="margin:36px 0 18px">{headings[6].text}</h2>
    <ul>
      <li>Норд-ост в Новороссийской и Геленджикской бухтах — не редкое явление, а свыше 40 дней в году, преимущественно в холодный сезон, с эпизодами от суток до недели.</li>
      <li>Скорость набирается на перепаде высот Маркотхского перевала: средняя зимняя — свыше 20 м/с, зафиксированный максимум на рейде — 60 м/с, исторический рекорд перевала 1928 года — 80 м/с.</li>
      <li>7–8 февраля 2012 года — задокументированный пример: 52–60 м/с, −19 °C, 250 тысяч жителей без электричества, остановка порта и федеральной трассы «Дон».</li>
      <li>Анемометр на башенном кране обязателен по приказу Ростехнадзора №533, сигнал усредняется по ГОСТ 32575.3-2013 с интервалом 5 секунд.</li>
      <li>При опасном ветре стрелу не блокируют, а растормаживают и разворачивают по ветру — флюгирование снимает жёсткий изгибающий момент с мачты.</li>
      <li>У рельсового хода (КБ-408.21) отдельная задача — не дать крану уехать по пути: её решают противоугонные захваты по ГОСТ 1451-77.</li>
    </ul>
    <p>Как эти дни простоя закладываются в общий график монтажа рядом с режимом тишины по закону №608-КЗ — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a>. Какая модель парка вообще не требует рельсового хода, а значит, и вопроса с противоугонными захватами не возникает в принципе, — на странице <a href="/park/giraffe-smk-5-66/" style="color:var(--accent)">giraFFe SMK-5.66</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://meteoinfo.ru/glossary/4652-2012-02-11-09-58-19', label: 'Гидрометцентр России — боры Новороссийской бухты: свыше 40 дней в году, до 60 м/с' },
      { href: 'https://ru.wikipedia.org/wiki/%D0%91%D0%BE%D1%80%D0%B0_(%D0%B2%D0%B5%D1%82%D0%B5%D1%80)', label: 'ru.wikipedia.org — механизм боры, Маркотхский перевал, рекорд 80 м/с (1928), Цемесская бухта (1848)' },
      { href: 'https://www.vesti.ru/article/1941067', label: 'Вести.ru — эпизод 7–8 февраля 2012 года: 52–60 м/с, −19 °C, 250 тыс. без электричества, трасса «Дон»' },
      { href: 'https://os1.ru/article/26210-bashennye-krany-i-veter-velikany-i-uragany', label: 'os1.ru — приказ Ростехнадзора №533, ГОСТ 32575.3-2013, требования к анемометру' },
      { href: 'https://os1.ru/article/28220-ekspluatiruem-bashenniy-kran-v-ekstremalnyh-pogodnyh-usloviyah-chto-nam-veter-chto-nam-znoy', label: 'os1.ru — порядок действий крановщика при сильном ветре, флюгирование, пороги 12–22 м/с' },
      { href: 'https://rulaws.ru/acts/RD-24.090.102-01.-Osnovnye-trebovaniya-bezopasnosti-k-ustroystvu-i-ekspluatatsii-vetrozaschitnyh-sistem-/', label: 'РД 24.090.102-01 — требования к противоугонным устройствам, усилие захвата до 100 Н' },
      { href: 'https://stroy-technics.ru/article/protivougonnye-ustroistva-kranov', label: 'stroy-technics.ru — ГОСТ 1451-77, типы противоугонных захватов, порог срабатывания ~12,5 м/с' },
    ]} />
</BlogArticleLayout>
