---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 109. Семьдесят вторая статья блога — угол (c) региональный.
// Староминский район — северные ворота края на границе с Ростовской областью;
// соседи Кущёвский, Каневский и Ленинградский районы уже разобраны.
//
// Фактура — только два источника (проверено 09.10.2026):
// - starominvest.ru/ru/presentation/district/ (инвестиционный портал района):
//   182 км от Краснодара в тексте и 180 км на схеме страницы — расхождение, в статье
//   оговорено; площадь 1060 км² (1,4 % территории края); население 40,9 тыс. чел.
//   (дата не указана); экономически активных 21,2 тыс.; 102,2 тыс. га плодородных
//   черноземов; климат умеренно континентальный с недостаточным увлажнением;
//   станция Староминская — крупная узловая, направления Ейск — Краснодар —
//   Ростов-на-Дону — Тихорецк; агропромышленная специализация, отрасли:
//   промышленность, АПК, строительство, транспорт; Ейск 60 км на схеме портала;
// - smokk.ru/about/association-members/starominskiy-rayon: 39 043 чел. на 01.01.2025,
//   граница с Ростовской областью по реке Ея в 20 км от райцентра, соседи — Кущёвский,
//   Каневский, Ленинградский, Щербиновский районы и Азовский район Ростовской области.
// Названий предприятий нет: на портале их не удалось проверить. Балл сейсмичности
// района не назван (конвенция сайта с Волны 79): в источниках его нет.

const CHECKED = '9 октября 2026 года';
const PUBLISHED = '2026-10-09';

const title = 'Кран для Староминского района: 1060 км² и чернозём';
const description = 'В Староминском районе 1060 км², 102,2 тыс. га чернозёмов и узловая станция Староминская по порталу района. Что это значит для башенного крана.';
const h1 = 'Кран для Староминского района: какой башенный кран нужен на северной границе края';
const crumbTitle = 'Кран для Староминского района';
const slug = 'kran-dlya-starominskogo-rayona';

const H2 = [
  'Что известно о районе: площадь, люди, экономика',
  'Грунт: 102,2 тыс. га чернозёмов и путь под краном',
  'Доставка: 182 км от Краснодара и узловая станция',
  'Климат: недостаточное увлажнение и жара',
  'Тишина и сейсмика: что считать на площадке',
  'Что проверить до заказа крана в районе',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Староминского района?',
    a: '1060 квадратных километров, или 1,4 % территории Краснодарского края — по инвестиционному порталу района. Эту цифру портал приводит в тексте о географическом положении; расхождений по площади в этом источнике нет.',
  },
  {
    q: 'Сколько жителей в Староминском районе?',
    a: 'Портал района называет 40,9 тыс. человек без даты публикации. Ассоциация СМОКК даёт 39 043 человека на 1 января 2025 года. Разные цифры объясняются, вероятно, разными годами, поэтому для расчётов берут значение с датой.',
  },
  {
    q: 'Далеко ли Староминский район от Краснодара?',
    a: 'Портал района пишет 182 км в тексте и 180 км на своей схеме. Расхождение небольшое, но точный километраж зависит от маршрута, поэтому доставку секций крана КРАН-КУБАНЬ считает по пути от завода до площадки, а не от Краснодара.',
  },
  {
    q: 'Какой грунт в Староминском районе?',
    a: 'Портал указывает 102,2 тыс. га плодородных чернозёмов и природные материалы — глину и песок. Несущую способность под рельсовым путём или фундаментом определяет изыскание на конкретном участке, а не показатель по району.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Староминский район"
  published={PUBLISHED}
>
    <p slot="intro">Староминский район занимает 1060 км², или 1,4 % территории края, и на 102,2 тыс. га лежат плодородные чернозёмы — это цифры инвестиционного портала района. Для башенного крана главный вопрос здесь грунт под рельсовым путём или фундаментом, поэтому КРАН-КУБАНЬ начинает подбор модели с изысканий, а уже потом сверяет высоту и вылет.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Административный центр Староминского района — станица Староминская. Портал района называет 40,9 тыс. жителей без даты публикации и 21,2 тыс. экономически активных, а ассоциация СМОКК приводит 39 043 человека на 1 января 2025 года. Две цифры отличаются, и для расчётов КРАН-КУБАНЬ берёт ту, у которой есть дата.</p>
    <p>Район расположен на севере края: по данным СМОКК, граница с Ростовской областью проходит по реке Ея в 20 км от районного центра. Соседи по краю — Кущёвский, Каневский, Ленинградский и Щербиновский районы. Для двух из них в блоге уже есть разборы: <a href="/blog/kran-dlya-kushchyovskogo-rayona/">Кущёвский район</a> и <a href="/blog/kran-dlya-leningradskogo-rayona/">Ленинградский район</a>.</p>
    <p>Портал называет район агропромышленным и перечисляет ведущие отрасли: промышленность, АПК, строительство, транспорт. Названий предприятий в проверенных источниках нет, и статья их не приводит. Для застройщика это значит: данных о крупной стройке портал не даёт, а высоту и сроки каждого объекта придётся брать из его проекта.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Чернозёмы занимают в Староминском районе 102,2 тыс. га, и портал отдельно упоминает глину и песок как природные материалы. Для крана это означает одно: показатель по району не заменяет изыскания на площадке, потому что слои под участком могут отличаться от среднего по району.</p>
    <p>Изыскание определяет и тип основания. Для моделей парка КРАН-КУБАНЬ выбор такой: КБ-408.21 ставят только на наземный рельсовый путь, а Potain MCH 175 — на путь или монолитный фундамент. Что выбирать в конкретном грунте, разобрано в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>, а что именно измеряют до монтажа — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Инженерные изыскания перед монтажом крана»</a>.</p>
    <p>Если участок небольшой, а объект невысокий, рассматривают giraFFe SMK-5.66: ему нужен опорный контур 4×4 м без фундамента. Грунт под опорами всё равно проверяют, потому что давление на землю у быстромонтируемого крана никуда не исчезает.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Портал района указывает расстояние до Краснодара 182 км, но на собственной схеме проставляет 180 км. Расхождение в два километра небольшое, однако оно показывает, что единой цифры у источника нет. Поэтому КРАН-КУБАНЬ считает доставку по маршруту от места отгрузки секций до площадки.</p>
    <p>Станция Староминская названа в портале крупной узловой: здесь пересекаются направления Ейск — Краснодар — Ростов-на-Дону — Тихорецк. Ейск на схеме портала отстоит на 60 км. Сравнить условия подъезда можно с соседним городом в статье <a href="/blog/kran-dlya-eyska/">«Кран для Ейска»</a>.</p>
    <p>Для длинномерных секций башенного крана важен не километраж, а габарит на маршруте: повороты, путепроводы, ограничения по высоте. Проверку маршрута КРАН-КУБАНЬ делает до подачи заявки на доставку, а не в день отгрузки.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Климат района портал описывает как умеренно континентальный с недостаточным увлажнением. Для работы крана это летняя жара и сухой грунт, а зимой — мороз и ветер на открытой степи. График смен и подъёмов под температуру разобран в статьях <a href="/blog/bashennyi-kran-v-zharu/">«Башенный кран в жару»</a> и <a href="/blog/bashennyi-kran-zimoy/">«Башенный кран зимой»</a>.</p>
    <p>Ветер в степи ограничивает работу крана по паспорту: общего порога в нормах нет, он задаётся документами на конкретную машину. Порядок действий при усилении ветра описан в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Шумные работы на объекте в районе подчиняются закону Краснодарского края № 608-КЗ о тишине, и часы работы крана считают по нему. Как закон применяется к башенному крану, показано в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине на Кубани»</a>.</p>
    <p>Балл сейсмичности Староминского района статья не называет: в проверенных источниках его нет. Откуда берут балл для площадки и чем он отличается от общего районирования, объясняет статья <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>. Для проекта значение выбирает проектировщик по ТСН 22-302-2000 и данным изысканий.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Перед заказом крана в Староминском районе проверяют пять пунктов, и каждый влияет на модель или на сроки.</p>
    <ol>
      <li>Изыскание под путь или фундамент: слои грунта и уровень грунтовых вод на самом участке.</li>
      <li>Высота верха строения и вылет до дальней точки груза — по паспорту выбранной модели.</li>
      <li>Маршрут доставки секций от места отгрузки до площадки и его габариты.</li>
      <li>График смен под жару, мороз и ветер на открытой местности.</li>
      <li>Часы шумных работ по закону № 608-КЗ и выбранный график подъёмов.</li>
    </ol>
    <p>Сроки монтажа по дням разобраны в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сколько дней занимает сборка»</a>. Если объект пока только в плане, срок стоит пересчитать после утверждения проекта.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://starominvest.ru/ru/presentation/district/', label: 'starominvest.ru — презентация Староминского района: площадь, население, климат, транспорт (проверено 09.10.2026)' },
      { href: 'https://www.smokk.ru/about/association-members/starominskiy-rayon', label: 'smokk.ru — Староминский муниципальный район: население на 01.01.2025, граница, соседи' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — статья «Сейсмика и закон о тишине на Кубани»' },
    ]} />
</BlogArticleLayout>
