---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 93. Двадцать восьмая статья блога — Усть-Лабинский район, равнинный
// город на слиянии Кубани и Лабы в 62 км восточнее Краснодара. Не новая
// ось, а сочетание уже знакомых блогу элементов в новом месте: действующий
// сахарный завод (как в Тимашевске и Кореновске, но здесь — единственное
// узнаваемое предприятие города, без второго пищевого гиганта по соседству)
// и речной берег, требующий внимания к грунту (как в Крымском районе и
// Славянске-на-Кубани, но здесь — не поёмное подтопление и не катастрофа
// многолетней давности, а свежий, майский 2026 года оползень на конкретном
// участке дороги).
//
// Экономический слой: АО «Сахарный завод «Свобода»» (ИНН 2356030749) —
// завод запущен в 1958 году (65-летие отмечено в 2023-м), в 1995 году
// перерегистрирован как акционерное общество; входит в холдинг «Прогресс
// Агро». Численность персонала снижается: с 401 человека в 2020 году до 332
// в 2025-м (rusprofile). Сезон-2024: переработано свыше 713 тыс. тонн
// сахарной свёклы, произведено около 92 тыс. тонн сахара-песка и 32 тыс.
// тонн гранулированного жома — цифра подтверждена независимо в двух разных
// выдачах WebSearch со ссылкой на ustlabinfo.ru. Цифру «мощность выросла с
// 4,5 до 7,5-7,7 тыс. т/сутки на 2 млрд руб. инвестиций» в статью
// сознательно не включили — параллельно нашлась другая, от самого холдинга
// («Прогресс Агро»): рост с 3,6 до 7 тыс. т/сутки с 2007 года. Источники
// расходятся и не хронологически совместимы без дополнительной проверки,
// прямой доступ к progressagro.com egress сессии заблокировал — та же
// логика, что и в Волне 85 с цифрой Выселковского сахарного завода.
//
// Оползень: вечером 19 мая 2026 года после ливня грунт сошёл на дорогу
// ст. Ладожская — х. Братский по мосту через Кубань; пострадавших нет,
// уборку завершили и движение по мосту восстановили днём 20 мая. Факт
// подтверждён независимо РИА Новости (19.05.2026) и 93.ru (20.05.2026).
//
// Балл сейсмики для площадки не найден в доступных источниках — та же
// честная развилка, что и в Волнах 76-80, 83-92. Egress снова не пропускал
// docs.cntd.ru, base.garant.ru, rusprofile.ru, progressagro.com и 93.ru
// напрямую — фактура взята из сводок WebSearch по нескольким независимым
// источникам.

const CHECKED = '20 сентября 2026 года';

const title = 'Кран для Усть-Лабинского района: сахарный завод и берег Кубани у Ладожской';
const description = 'Усть-Лабинский район на слиянии Кубани и Лабы: действующий сахарный завод «Свобода» и майский оползень 2026 года на берегу Кубани у станицы Ладожской — что это значит для монтажа башенного крана.';
const h1 = 'Кран для Усть-Лабинского района: сахарный завод и берег Кубани у Ладожской';
const crumbTitle = 'Кран для Усть-Лабинского района';
const slug = 'kran-dlya-ust-labinskogo-rayona';

const H2 = [
  'Усть-Лабинский район — где Лаба впадает в Кубань',
  'Сахарный завод «Свобода»: работает с 1958 года',
  'Оползень у Ладожской 19-20 мая 2026 года: берег Кубани и вопрос к грунту',
  'Сейсмика: почему балл для площадки в статье не назван',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Оползень у Ладожской в мае 2026 года — разовый эпизод или регулярная история для района?',
    a: 'В открытых источниках это не единичный случай: район в целом регулярно попадает в сводки МЧС и СМИ о подтоплениях после сильных ливней — не только у Ладожской, но и в других поселениях по берегам Кубани. Конкретный эпизод 19-20 мая 2026 года интересен тем, что у него есть точная привязка к месту (мост Ладожская — хутор Братский) и дата, а не общая формулировка «угроза подтопления». Для площадки в непосредственной близости от берега это повод заказать изыскания под конкретный участок, а не полагаться на то, что «пронесло в прошлый раз».',
  },
  {
    q: 'Кран для завода «Свобода» — это одна большая стройка или череда мелких работ?',
    a: 'Действующий сахарный завод с многолетней историей модернизируется постепенно, а не через одну капитальную стройку с нуля: реконструкция и замена отдельных технологических линий, ремонт и наращивание складских мощностей под жом и сахар — сезонные и внесезонные работы разного масштаба. Это отличает такую площадку от, например, строительства курортного объекта с нуля: спрос на технику здесь регулярный, но не всегда крупный по отдельному эпизоду.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Усть-Лабинского района', item: `${SITE}/blog/kran-dlya-ust-labinskogo-rayona/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-ust-labinskogo-rayona/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-ust-labinskogo-rayona/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал равнинные степные районы с пищевой промышленностью — Тимашевск, Кореновск, Выселковский район — и реки, из-за которых площадка требует отдельного взгляда на грунт, — Крымский район, Славянск-на-Кубани. Усть-Лабинский район соединяет оба сюжета в одном месте: здесь стоит завод с почти семидесятилетней историей, а сам город вырос на мысу, где в Кубань впадает её левый приток Лаба — и весной 2026 года это слияние двух рек напомнило о себе не абстрактной картой, а размытой дорогой.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Город Усть-Лабинск стоит на правом берегу Кубани, у впадения в неё Лабы, в 62 километрах восточнее Краснодара. В марте 1778 года на этом месте по указанию А. В. Суворова заложили Александровское укрепление, в 1793 году под руководством генерала И. В. Гудовича возвели земляную крепость Усть-Лабинскую, а годом позже переселённые с Дона казаки основали станицу Усть-Лабинскую. Статус города станица получила 28 мая 1958 года; сегодня население — около 40 180 человек. Курортной функции у района нет: спрос на технику формируют промышленность, сельское хозяйство и обычная городская застройка растущего райцентра на трассе, связывающей восточную часть края с Краснодаром.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>АО «Сахарный завод «Свобода»» (ИНН 2356030749) — действующее предприятие, отсчитывающее историю с 1958 года: 65-летие завод отмечал в 2023 году. В 1995 году предприятие зарегистрировано как акционерное общество и сегодня входит в агрохолдинг «Прогресс Агро». По сезону 2024 года завод переработал свыше 713 тысяч тонн сахарной свёклы, произведя около 92 тысяч тонн сахара-песка и 32 тысячи тонн гранулированного жома. Численность персонала при этом постепенно снижается — с 401 человека в 2020 году до 332 в 2025-м, что для отрасли типично: современная переработка сахарной свёклы всё сильнее опирается на автоматизацию, а не на рост штата. Для арендодателя крана такой завод — не разовая стройка с нуля, а стабильный, регулярно модернизируемый заказчик: замена технологических линий, ремонт и расширение складов под сахар и жом.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Вечером 19 мая 2026 года после сильного ливня грунт сошёл на дорогу, ведущую от станицы Ладожской к хутору Братскому, — на участке у моста через Кубань, на крутом берегу реки. Пострадавших не было, но движение по мосту перекрыли; уборку грунта завершили и проезд восстановили днём 20 мая. Эпизод независимо подтверждён РИА Новости и региональными изданиями Кубани, а сама Ладожская стоит в том же Усть-Лабинском районе, что и город с заводом «Свобода», — на том же крутом правом берегу Кубани, только выше по течению. Для площадки в подобном месте это не гипотетический риск: инженерно-геологические изыскания перед монтажом крана, о которых подробно рассказывает статья «Инженерные изыскания перед монтажом крана», для берега с уже задокументированным сходом грунта — не формальность, а прямое следствие рельефа, а не только теоретическая осторожность.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Как и в статьях про Абинский, Северский, Крымский и ряд других районов, мы сознательно не приводим здесь конкретный балл сейсмичности. Территориальные нормы ТСН 22-302-2000 задают расчётную сейсмичность по Приложению Б для отдельных населённых пунктов края, но прямой цитаты строки Усть-Лабинского района в доступных источниках найти не удалось: egress сессии не пропускал прямой доступ к docs.cntd.ru и base.garant.ru, а в сводках поисковика конкретная цифра для района не встретилась. Расчётный балл для площадки в итоге определяет проектировщик на этапе изысканий — называть цифру без подтверждения источником мы не считаем правильным.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины действует в Усть-Лабинском районе так же, как в Краснодаре или на побережье: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дневным перерывом, а в выходные и праздничные дни утренняя граница сдвинута до 10:00. Удалённость от моря и от курортных территорий края здесь ничего не меняет — норма одна на весь регион. Подробный разбор часов и сумм штрафов по статье 3.3 — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Усть-Лабинск стоит на слиянии Кубани и Лабы, в 62 км восточнее Краснодара; город с 1958 года, население около 40 180 человек, без курортной функции.</li>
      <li>АО «Сахарный завод «Свобода»» (ИНН 2356030749) работает с 1958 года, входит в холдинг «Прогресс Агро»: сезон-2024 — свыше 713 тыс. тонн переработанной свёклы, около 92 тыс. тонн сахара.</li>
      <li>Вечером 19 мая 2026 года грунт сошёл на дорогу ст. Ладожская — х. Братский у моста через Кубань; проезд восстановили днём 20 мая — свежий, задокументированный повод для внимания к грунту берега в районе.</li>
      <li>Балл сейсмичности площадки в статье сознательно не назван — доступные источники не подтвердили строку района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон №608-КЗ о тишине действует в Усть-Лабинском районе так же, как во всём крае.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/Усть-Лабинск', label: 'ru.wikipedia.org — Усть-Лабинск: география, история основания, население' },
      { href: 'https://ru.wikipedia.org/wiki/Усть-Лабинский_район', label: 'ru.wikipedia.org — Усть-Лабинский район' },
      { href: 'https://www.rusprofile.ru/id/1006444', label: 'rusprofile.ru — АО «Сахарный завод «Свобода»», ИНН 2356030749, численность персонала' },
      { href: 'https://ustlabinfo.ru/news/2023-10-17-tri-dva-odin-pusk-sakharnomu-zavodu-svoboda-65-let-/', label: 'ustlabinfo.ru — 65 лет заводу «Свобода» (пуск в 1958 году)' },
      { href: 'https://ustlabinfo.ru/news/2024-11-21-ust-labinskiy-sakharnyy-zavod-svoboda-zavershil-sezon-pererabotki-svekly/', label: 'ustlabinfo.ru — итоги сезона переработки свёклы: 713 тыс. тонн, 92 тыс. тонн сахара' },
      { href: 'https://ria.ru/20260519/chp-2093422773.html', label: 'ria.ru — оползень перекрыл дорогу в Усть-Лабинском районе, 19.05.2026' },
      { href: 'https://93.ru/text/incidents/2026/05/20/76430161/', label: '93.ru — оползень у станицы Ладожской, движение по мосту восстановлено 20.05.2026' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
