---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 106. Шестьдесят четвёртая статья блога — угол (b) коммерческий/сравнительный.
// Пара, которую ещё не сравнивали: КБ-408.21 (классический с оголовком, рельсовый
// ход) и giraFFe SMK-5.66 (быстромонтируемый без фундамента). Самая «далёкая» пара
// парка по времени монтажа и основанию.
//
// Фактура — только реестр parkModels.ts, карточки /park/ и статья-сосед
// «Монтаж башенного крана: сроки» (проверено 06.10.2026):
// - КБ-408.21: 10 т максимум, вылет 40 м, крюк 54,0–72,7 м, наземный
//   рельсовый крановый путь, оголовок, наращивание секций мачты; монтаж
//   40-метрового крана — 2–3 дня, 10–12 секций (glavkran.by, по статье-соседу);
// - giraFFe SMK-5.66: 5 т максимум, 1,05 т на 43 м, вылет 2,8–43 м, крюк до
//   27 м (гориз.) / до 41,7 м (наклон 20°), опорный контур 4×4 м, без
//   фундамента, монтаж 4–6 часов силами двух человек и автокрана 25 т.
// Цен и сроков поставки нет — только паспортные параметры моделей.

const CHECKED = '6 октября 2026 года';
const PUBLISHED = '2026-10-06';

const title = 'КБ-408.21 или giraFFe SMK-5.66: какой кран выбрать';
const description = 'КБ-408.21 поднимает 10 т и крюк до 72,7 м на рельсах, giraFFe SMK-5.66 — 5 т и до 41,7 м без фундамента за 4–6 часов монтажа. Как выбрать.';
const h1 = 'КБ-408.21 или giraFFe SMK-5.66: какой башенный кран выбрать для объекта';
const crumbTitle = 'КБ-408.21 или giraFFe SMK-5.66';
const slug = 'kb-408-21-ili-giraffe-smk-5-66';

const H2 = [
  'Чем КБ-408.21 отличается от giraFFe SMK-5.66',
  'Сравнение двух кранов по семи параметрам',
  'Когда хватает giraFFe SMK-5.66',
  'Когда нужен КБ-408.21',
  'Как выбрать между двумя кранами по высоте и сроку',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем КБ-408.21 отличается от giraFFe SMK-5.66?',
    a: 'КБ-408.21 из парка КРАН-КУБАНЬ — кран с оголовком на наземном рельсовом пути: 10 т максимум, вылет 40 м, крюк 54,0–72,7 м. giraFFe SMK-5.66 — быстромонтируемый кран на собственном опорном контуре 4×4 м: 5 т, вылет 2,8–43 м, крюк до 41,7 м, фундамент не нужен, монтаж 4–6 часов.',
  },
  {
    q: 'Какой кран выше: КБ-408.21 или giraFFe SMK-5.66?',
    a: 'Выше КБ-408.21: паспортная высота крюка 54,0–72,7 м против 27 м (горизонтальная стрела) и 41,7 м (наклон 20°) у giraFFe SMK-5.66. Для здания выше 41,7 м быстромонтируемая модель из парка КРАН-КУБАНЬ не подходит, а КБ-408.21 наращивают секциями мачты.',
  },
  {
    q: 'Какой кран тяжелее поднимает груз?',
    a: 'КБ-408.21 поднимает до 10 т, giraFFe SMK-5.66 — до 5 т, то есть вдвое меньше. На предельном вылете giraFFe SMK-5.66 несёт 1,05 т на 43 м; для КБ-408.21 парк КРАН-КУБАНЬ приводит максимум 10 т при вылете 40 м, поэтому сравнивайте груз по крановой характеристике.',
  },
  {
    q: 'Нужен ли фундамент для КБ-408.21 и giraFFe SMK-5.66?',
    a: 'КБ-408.21 из парка КРАН-КУБАНЬ идёт по наземному рельсовому крановому пути, который нужно проложить и принять. giraFFe SMK-5.66 стоит на собственном опорном контуре 4×4 м и фундамента не требует, но грунт под четырьмя опорами проверяют до установки.',
  },
  {
    q: 'Когда выгоднее быстромонтируемый кран, а когда классический?',
    a: 'Быстромонтируемый giraFFe SMK-5.66 выгоден на коротком объекте до 27–41 м и на участке без места под путь: он приезжает и работает к вечеру. КБ-408.21 нужен для высокого или тяжёлого объекта, когда срок стройки оправдывает прокладку пути и монтаж 10–12 секций за 2–3 дня.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">КБ-408.21 поднимает 10 т и крюк на 54,0–72,7 м, но стоит на наземном рельсовом пути, а giraFFe SMK-5.66 берёт 5 т и крюк до 41,7 м без фундамента и монтируется за 4–6 часов. КРАН-КУБАНЬ выбирает между этими двумя кранами по высоте здания, массе самых тяжёлых элементов и тому, есть ли на участке место под рельсовый путь.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>КБ-408.21 и giraFFe SMK-5.66 — две крайние точки парка КРАН-КУБАНЬ по времени монтажа и по основанию. КБ-408.21 — классический кран с оголовком и увеличенной базой: тяжёлый противовес даёт устойчивость, а высоту набирают наращиванием секций мачты. Он требует рельсового пути и полноценного проекта производства работ.</p>
    <p>giraFFe SMK-5.66 из парка КРАН-КУБАНЬ отвечает на противоположную задачу: короткий объект на тесном участке, где нет места под путь и невыгодно разворачивать многодневный монтаж. У него собственный опорный контур 4×4 м, фундамента нет, монтаж — 4–6 часов силами двух человек и одного 25-тонного автокрана. Паспортные данные приведены в карточках <a href="/park/kb-408-21/">КБ-408.21</a> и <a href="/park/giraffe-smk-5-66/">giraFFe SMK-5.66</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>КБ-408.21</th><th>giraFFe SMK-5.66</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>с оголовком, рельсовый ход</td><td>быстромонтируемый, без фундамента</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>10 т</td><td>5 т</td></tr>
        <tr><td>Вылет</td><td>40 м</td><td>2,8–43 м</td></tr>
        <tr><td>Груз на предельном вылете</td><td>10 т максимум при вылете 40 м</td><td>1,05 т на 43 м</td></tr>
        <tr><td>Высота подъёма крюка</td><td>54,0–72,7 м</td><td>до 27 м (гориз.) / до 41,7 м (наклон 20°)</td></tr>
        <tr><td>Основание</td><td>наземный рельсовый крановый путь</td><td>опорный контур 4×4 м</td></tr>
        <tr><td>Монтаж</td><td>2–3 дня для 40-метрового крана, 10–12 секций</td><td>4–6 часов, два человека и автокран 25 т</td></tr>
      </tbody>
    </table></div>
    <p>Таблица парка КРАН-КУБАНЬ показывает, что КБ-408.21 выигрывает у giraFFe SMK-5.66 по грузу вдвое и по высоте крюка на 27–45,7 м (54,0–72,7 м против 27 м с горизонтальной стрелой). giraFFe SMK-5.66 выигрывает основанием и скоростью: разница между 4–6 часами и 2–3 днями ощутима, если кран нужен на короткую работу. Срок монтажа 40-метрового крана — по отраслевым данным, разобранным в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>giraFFe SMK-5.66 хватает КРАН-КУБАНЬ на здании до 27 м и на реконструкции в плотной застройке, где рельсовый путь проложить негде. Груз до 1,05 т на 43 м — кирпич, арматурные каркасы, опалубка, но не тяжёлые панели. Наклон стрелы на 20° поднимает крюк до 41,7 м ценой сокращённого вылета, так что потолок модели — 41,7 м.</p>
    <p>Главный довод в пользу SMK-5.66 — время. Монтаж за 4–6 часов означает, что кран приезжает утром и работает к вечеру, а на объекте с коротким сроком стоимость простоя и подготовки основания не набегает. Перед установкой КРАН-КУБАНЬ проверяет грунт под четырьмя опорами, как описано в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КБ-408.21 нужен КРАН-КУБАНЬ, когда объект выше 41,7 м или груз тяжелее 5 т. Крюк на 54,0–72,7 м закрывает многоэтажные жилые дома и промышленные корпуса, а 10 т максимума позволяют поднимать бетонные бадьи и крупные элементы. Вылет 40 м даёт круг диаметром 80 м — для протяжённого фронта работ вдоль рельсового пути этого достаточно.</p>
    <p>Цена за возможности КБ-408.21 в парке КРАН-КУБАНЬ — основание: наземный рельсовый путь нужно проложить, принять и содержать. Для вытянутого участка это удобно: кран ездит вдоль здания, а для тесного двора путь может не поместиться, как разобрано в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Если высота и вес задачи диктуют КБ-408.21, место под путь закладывают в проект сразу.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Условный пример для КРАН-КУБАНЬ: двухэтажный склад высотой около 12 м на участке без свободной полосы под путь. Здесь giraFFe SMK-5.66 закрывает высоту с большим запасом, а монтаж за 4–6 часов не задерживает остальные работы. Для двенадцатиэтажного дома высотой около 40 м SMK-5.66 с наклоном стрелы ещё допустим, но для дома в 60 м КРАН-КУБАНЬ берёт КБ-408.21. Пример условный и показывает логику выбора, а не параметры конкретного объекта.</p>
    <ol>
      <li>Сверьте высоту объекта с пределом giraFFe SMK-5.66: 27 м с горизонтальной стрелой, 41,7 м с наклоном 20°.</li>
      <li>Если высота больше 41,7 м, КРАН-КУБАНЬ переходит к КБ-408.21 с крюком 54,0–72,7 м.</li>
      <li>Проверьте массу самых тяжёлых элементов: больше 5 т — только КБ-408.21 из этой пары.</li>
      <li>Найдите на участке полосу под рельсовый путь; если её нет, а объект низкий, выбирайте giraFFe SMK-5.66.</li>
      <li>Оцените срок: на работу в несколько дней быстромонтируемый кран выгоднее, на многомесячную стройку — классический.</li>
    </ol>
    <p>Окончательный выбор КРАН-КУБАНЬ делает в проекте производства работ, когда известны высота, масса элементов и план участка. Если дом выше 72,7 м, стоит посмотреть приставной кран — сравнение в статье <a href="/blog/kb-408-21-ili-kb-674a/">«КБ-408.21 или КБ-674А»</a>. Адрес и чертёж можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/kb-408-21/', label: 'kran-kuban.ru — карточка КБ-408.21: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — карточка giraFFe SMK-5.66: паспортные характеристики' },
      { href: 'https://giraffecrane.ru/', label: 'giraffecrane.ru — производитель быстромонтируемых кранов giraFFe' },
      { href: 'https://kran-kuban.ru/blog/montazh-bashennogo-krana-sroki/', label: 'kran-kuban.ru — статья «Монтаж башенного крана: сроки» (источники по срокам монтажа)' },
    ]} />
</BlogArticleLayout>
