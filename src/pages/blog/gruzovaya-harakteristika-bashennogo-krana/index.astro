---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 100. Сорок четвёртая статья блога — угол (a) информационный/how-to.
// Грузовая характеристика (грузовысотная кривая) на сайте до сих пор
// упоминалась только числами в карточках парка; сам принцип «груз падает с
// вылетом» и как им пользоваться при подборе не разбирался. Частый вопрос
// заказчика: «почему кран 10 т поднимает на краю стрелы меньше тонны».
//
// Фактура — только проверенная и уже опубликованная на сайте:
// - грузоподъёмности и вылеты пяти моделей — parkModels.ts (реестр парка);
// - грузовой момент как произведение груза на вылет — общий принцип механики
//   грузоподъёмных кранов; числовые моменты в тексте помечены как расчёт по
//   паспортным парам «груз × вылет», а не как отдельная паспортная величина;
// - терминология «грузовой момент» (М = вылет × грузоподъёмность) и «вылет» —
//   ГОСТ 33709.1-2015 «Краны грузоподъёмные. Словарь. Часть 1».
// Пример подбора построен на паспортных парах реестра, без выдуманных значений
// на промежуточных вылетах: там, где значение не паспортное, прямо сказано,
// что его читают по кривой в паспорте модели.

const CHECKED = '29 сентября 2026 года';
const PUBLISHED = '2026-09-29';

const title = 'Грузовая характеристика башенного крана: вылет и груз';
const description = 'Почему башенный кран 10 т на конце стрелы поднимает меньше тонны: грузовой момент, форма кривой и грузовые характеристики пяти моделей парка КРАН-КУБАНЬ.';
const h1 = 'Грузовая характеристика башенного крана: почему грузоподъёмность падает с вылетом';
const crumbTitle = 'Грузовая характеристика';
const slug = 'gruzovaya-harakteristika-bashennogo-krana';

const H2 = [
  'Что такое грузовая характеристика крана',
  'Почему груз падает с ростом вылета',
  'Грузовые характеристики пяти моделей КРАН-КУБАНЬ',
  'Как по характеристике подобрать кран под груз',
  'Что ограничивает подъём помимо характеристики',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Почему башенный кран 10 тонн на конце стрелы поднимает меньше тонны?',
    a: 'Максимальную грузоподъёмность кран держит только на малом вылете у мачты. Дальше груз ограничивает грузовой момент — произведение массы на вылет. У Potain MDT 219 J10 паспортные 10 т доступны вблизи мачты, а на предельных 65 м остаётся 1,9 т: момент почти тот же, но плечо втрое больше. Точное значение на нужном вылете КРАН-КУБАНЬ читает по кривой в паспорте модели.',
  },
  {
    q: 'Что такое грузовой момент башенного крана?',
    a: 'Грузовой момент — это масса груза, умноженная на вылет, в тонно-метрах; он показывает опрокидывающее усилие на кран. Для Potain MDT 219 J10 пара «1,9 т на 65 м» даёт около 124 тм, для КБ-674А «5,6 т на 50,5 м» — около 283 тм. Чем больше грузовой момент модели, тем тяжелее груз она держит на дальнем вылете. КРАН-КУБАНЬ сравнивает модели именно по этой величине.',
  },
  {
    q: 'Как узнать, поднимет ли кран груз на нужном расстоянии?',
    a: 'По грузовой характеристике модели: на оси вылета находят рабочее расстояние до груза, поднимаются до кривой и читают допустимую массу на этом вылете. Если масса груза с учётом строповки ниже кривой — кран подходит. КРАН-КУБАНЬ проверяет это по паспорту модели ещё до выезда, чтобы не привезти кран, которому не хватит момента на дальней точке.',
  },
  {
    q: 'Какой кран парка КРАН-КУБАНЬ сильнее всех на дальнем вылете?',
    a: 'КБ-674А: он держит 5,6 т на вылете 50,5 м — это около 283 тм грузового момента, больше любой другой модели парка. Potain MDT 219 J10 тянется дальше, до 65 м, но на пределе оставляет 1,9 т. Выбор между «дальше» и «тяжелее на дальней точке» КРАН-КУБАНЬ делает по массе самого тяжёлого груза и его положению на площадке.',
  },
  {
    q: 'Учитывается ли масса строп и траверсы в грузовой характеристике?',
    a: 'Да, грузовая характеристика задаёт массу груза вместе со съёмным грузозахватным приспособлением. Стропы, траверсу и тару вычитают из паспортного значения на вылете, а не прибавляют к нему. КРАН-КУБАНЬ закладывает массу оснастки в расчёт подбора, поэтому полезная масса груза всегда меньше цифры на кривой на вес строповки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Техника · Как читать паспорт"
  published={PUBLISHED}
>
    <p slot="intro">Грузовая характеристика показывает, какую массу башенный кран поднимает на каждом вылете, и почти всегда она падает с расстоянием: Potain MDT 219 J10 держит паспортные 10 т у мачты и только 1,9 т на предельных 65 м. Причина — грузовой момент, произведение массы на вылет. КРАН-КУБАНЬ подбирает модель по массе груза на самой дальней точке площадки, а не по одной цифре максимума.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Грузовая характеристика (грузовысотная кривая) башенного крана КРАН-КУБАНЬ — это зависимость допустимой массы груза от вылета крюка, один из основных паспортных параметров крана. Вылет по ГОСТ 33709.1-2015 «Краны грузоподъёмные. Словарь» — расстояние по горизонтали от оси вращения крана до вертикали через центр захвата груза. Для башенного крана КРАН-КУБАНЬ характеристику печатают таблицей и графиком в паспорте: по одной оси вылет в метрах, по другой — масса в тоннах.</p>
    <p>Максимальная грузоподъёмность в названии модели — это значение только для малого вылета, а не для всей стрелы. У КБ-674А в реестре парка КРАН-КУБАНЬ стоит «12,5 т максимум · 5,6 т на 50,5 м»: первая цифра работает у мачты, вторая — на дальнем краю. Поэтому «кран на 10 тонн» и «кран поднимет 10 тонн куда угодно» — не одно и то же, и грузовая характеристика существует именно для того, чтобы связать массу с расстоянием.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>На вылете 65 м Potain MDT 219 J10 держит 1,9 т вместо 10 т у мачты, потому что кран ограничивает грузовой момент — массу груза, умноженную на вылет, в тонно-метрах. Момент — это опрокидывающее усилие: чем дальше от мачты висит тот же груз, тем сильнее он стремится повалить кран и тем выше нагрузка на стрелу и опору. У Potain MDT 219 J10 пара «1,9 т на 65 м» даёт около 124 тм — это расчёт по паспортной паре, а не отдельная строка паспорта. Модель КРАН-КУБАНЬ удерживает примерно постоянный предельный момент, поэтому при росте плеча масса вынужденно снижается.</p>
    <p>Кривая грузовой характеристики состоит из двух участков, и это видно у любой модели парка КРАН-КУБАНЬ. На малых вылетах у мачты линия горизонтальна: массу ограничивает механизм подъёма и прочность канатов, а не момент, — здесь держится паспортный максимум. После переломного вылета линия идёт вниз по закону «момент делить на вылет»: удвоили расстояние — примерно вдвое уменьшили допустимую массу. Именно этот второй участок объясняет, почему у giraFFe SMK-5.66 из 5 т максимума на предельных 43 м остаётся 1,05 т.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пять моделей парка КРАН-КУБАНЬ различаются не только максимумом, но и тем, сколько груза остаётся на конце стрелы. В таблице — паспортный максимум, груз на предельном вылете из реестра и грузовой момент на этом вылете (расчёт «груз × вылет», для сравнения моделей между собой):</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Максимум у мачты</th><th>Груз на предельном вылете</th><th>Момент на краю, тм (расчёт)</th></tr></thead>
      <tbody>
        <tr><td>КБ-674А</td><td>12,5 т</td><td>5,6 т на 50,5 м</td><td>≈ 283</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>10 т</td><td>1,9 т на 65 м</td><td>≈ 124</td></tr>
        <tr><td>Potain MCH 175</td><td>10 т</td><td>1,5 т на 55 м</td><td>≈ 83</td></tr>
        <tr><td>КБ-408.21</td><td>10 т</td><td>вылет до 40 м</td><td>по паспорту</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>5 т</td><td>1,05 т на 43 м</td><td>≈ 45</td></tr>
      </tbody>
    </table></div>
    <p>Сравнение по краю стрелы переворачивает картину «по максимуму». Potain MDT 219 J10 и КБ-408.21 в реестре КРАН-КУБАНЬ имеют одинаковый максимум 10 т, но это разные краны: у первого длинная стрела до 65 м, у второго вылет до 40 м с более тяжёлым противовесом. КБ-674А с моментом около 283 тм держит на дальнем вылете втрое больше, чем Potain MDT 219 J10, — это цена приставного исполнения с анкеровкой к зданию. У giraFFe SMK-5.66 самый скромный момент, и это ожидаемо для быстромонтируемого крана без фундамента.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пакет 1,5 т на вылет 55 м показывает, как устроен подбор по грузовой характеристике: нужны масса самого тяжёлого груза и вылет до самой дальней точки, куда его подают. На такой площадке КРАН-КУБАНЬ сравнивает модели по кривой, а не по максимуму. Potain MCH 175 даёт ровно 1,5 т на 55 м — модель работает на пределе, без запаса. Potain MDT 219 J10 на 55 м оставляет больше, чем свои 1,9 т на 65 м, — здесь запас есть, а точное значение читают по кривой паспорта. giraFFe SMK-5.66 отпадает сразу: её стрела не достаёт до 55 м.</p>
    <p>Работать на самом пределе кривой КРАН-КУБАНЬ не рекомендует: к массе груза добавляется вес строп и траверсы, а грузовая характеристика задаёт массу вместе с грузозахватным приспособлением. Если пакет 1,5 т подвешен на траверсе 200 кг, кран на вылете 55 м должен держать 1,7 т, и модель «ровно 1,5 т» уже не подходит. Инженерная служба КРАН-КУБАНЬ закладывает запас на оснастку и на возможный рост груза, а не подгоняет модель впритык к паспортной цифре. Общая логика подбора — высота крюка, вылет и груз на вылете — разобрана в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Грузовая характеристика задаёт верхний предел массы, но на площадке подъём ограничивают ещё три фактора, которые КРАН-КУБАНЬ проверяет отдельно. Первый — ветер: при усилении до предельной скорости рабочего состояния кран прекращает подъём независимо от того, сколько показывает кривая; для побережья и норд-оста это разобрано в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>. Второй — вылет за границу опасной зоны, из-за которого модель с длинной стрелой иногда заменяют на маховую Potain MCH 175 или ограничивают контур работы.</p>
    <p>Третий фактор — основание и высота: грузовая характеристика верна, только когда кран КРАН-КУБАНЬ стоит на расчётном фундаменте или пути и не превышает паспортную высоту крюка. Приставной КБ-674А сохраняет свои 5,6 т на 50,5 м лишь при штатной анкеровке к зданию; свободностоящая высота у него ограничена 60 м. Как высота набирается за счёт основания или креплений, показано в статье <a href="/blog/relsovyi-put-ili-fundament/">«Кран на рельсах или на фундаменте»</a>.</p>
    <p>Массу самого тяжёлого груза и вылет до дальней точки можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ проверит их по грузовым характеристикам моделей и предложит кран с запасом по моменту.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://docs.cntd.ru/document/1200135709', label: 'docs.cntd.ru — ГОСТ 33709.1-2015 «Краны грузоподъёмные. Словарь. Часть 1» (вылет, грузовой момент М = вылет × грузоподъёмность)' },
      { href: 'https://base.garant.ru/400165076/', label: 'base.garant.ru — ФНП «Правила безопасности ОПО, на которых используются подъёмные сооружения», приказ Ростехнадзора от 26.11.2020 №461' },
      { href: '/park/', label: 'kran-kuban.ru — парк техники КРАН-КУБАНЬ: паспортные грузоподъёмности и вылеты пяти моделей' },
    ]} />
</BlogArticleLayout>
