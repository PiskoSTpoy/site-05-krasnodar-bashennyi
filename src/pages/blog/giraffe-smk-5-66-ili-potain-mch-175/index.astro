---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 105. Шестьдесят первая статья блога — угол (b) коммерческий/сравнительный.
// Пара, которую ещё не сравнивали: giraFFe SMK-5.66 (быстромонтируемый, без
// фундамента — четвёртый «качественно иной случай» в parkModels.ts) и
// Potain MCH 175 (маховая стрела — пятый случай). Обе модели парка отвечают на
// тесноту, но по-разному: SMK-5.66 — малым основанием и скоростью монтажа,
// MCH 175 — переменным вылетом и высотой.
//
// Фактура — только реестр parkModels.ts и карточки /park/ (проверено 05.10.2026):
// - giraFFe SMK-5.66: 5 т максимум, 1,05 т на 43 м, вылет 2,8–43 м, крюк до
//   27 м (гориз. стрела) / до 41,7 м (наклон 20°), опорный контур 4×4 м,
//   фундамент не требуется, монтаж за 4–6 часов силами двух человек и
//   одного 25-тонного автокрана;
// - Potain MCH 175: 10 т максимум, 1,5 т на 55 м, вылет до 55 м (сокращается
//   наклоном стрелы), крюк до 58,5 м, основание — рельсовый путь или фундамент.
// Цен и сроков поставки нет — только паспортные параметры моделей.

const CHECKED = '5 октября 2026 года';
const PUBLISHED = '2026-10-05';

const title = 'giraFFe SMK-5.66 или Potain MCH 175: что выбрать в тесноте';
const description = 'SMK-5.66 монтируют за 4–6 часов на контуре 4×4 м без фундамента, MCH 175 поднимает крюк до 58,5 м и сокращает вылет наклоном. Какой кран выбрать.';
const h1 = 'giraFFe SMK-5.66 или Potain MCH 175: какой кран выбрать для стройки в тесноте';
const crumbTitle = 'giraFFe SMK-5.66 или Potain MCH 175';
const slug = 'giraffe-smk-5-66-ili-potain-mch-175';

const H2 = [
  'Чем giraFFe SMK-5.66 отличается от Potain MCH 175',
  'Сравнение двух кранов по семи параметрам',
  'Когда хватает giraFFe SMK-5.66',
  'Когда нужен Potain MCH 175',
  'Как выбрать между двумя кранами для тесной стройки',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем giraFFe SMK-5.66 отличается от Potain MCH 175?',
    a: 'giraFFe SMK-5.66 из парка КРАН-КУБАНЬ — быстромонтируемый кран с собственным опорным контуром 4×4 м, которому не нужен фундамент, а монтаж занимает 4–6 часов. Potain MCH 175 — безоголовочный кран с маховой стрелой, которая наклоном сокращает вылет, но он стоит на рельсовом пути или монолитном фундаменте и поднимает крюк выше.',
  },
  {
    q: 'Какой кран выше: giraFFe SMK-5.66 или Potain MCH 175?',
    a: 'Выше Potain MCH 175 — до 58,5 м по крюку. giraFFe SMK-5.66 поднимает крюк до 27 м с горизонтальной стрелой и до 41,7 м с наклоном 20°, причём наклон сокращает вылет. Для здания выше 41,7 м быстромонтируемая модель из парка КРАН-КУБАНЬ не подходит.',
  },
  {
    q: 'Какой кран тяжелее поднимает груз?',
    a: 'Potain MCH 175 несёт больше: 10 т максимум против 5 т у giraFFe SMK-5.66. На предельном вылете разница меньше, но сохраняется: 1,5 т на 55 м у Potain MCH 175 и 1,05 т на 43 м у giraFFe SMK-5.66 из парка КРАН-КУБАНЬ.',
  },
  {
    q: 'Нужен ли фундамент для giraFFe SMK-5.66?',
    a: 'Нет, giraFFe SMK-5.66 из парка КРАН-КУБАНЬ стоит на собственном опорном контуре 4×4 м и фундамента не требует. Перед установкой инженерная служба проверяет грунт под четырьмя опорами: если грунт слабый или талый, площадку готовят отдельно.',
  },
  {
    q: 'Когда выгоднее быстромонтируемый кран, а когда кран с маховой стрелой?',
    a: 'Быстромонтируемый giraFFe SMK-5.66 выгоден на коротком объекте до 27–41 м и на участке, где нет места под рельсовый путь или фундамент. Potain MCH 175 нужен, когда дом выше или соседние здания требуют сократить вылет наклоном стрелы, а срок стройки оправдывает основание и монтаж тяжёлого крана.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">giraFFe SMK-5.66 монтируют за 4–6 часов на опорном контуре 4×4 м без фундамента, но крюк у него поднимается лишь до 27 м (до 41,7 м с наклоном стрелы 20°). Potain MCH 175 поднимает крюк до 58,5 м и сокращает вылет наклоном маховой стрелы, однако ему нужен рельсовый путь или монолитный фундамент. КРАН-КУБАНЬ выбирает между ними по высоте объекта и по тому, есть ли на участке место под основание.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>giraFFe SMK-5.66 и Potain MCH 175 из парка КРАН-КУБАНЬ отвечают на тесноту участка с противоположных сторон. Быстромонтируемый SMK-5.66 экономит место и время: у него собственный опорный контур 4×4 м, фундамент не требуется, а монтаж занимает 4–6 часов силами двух человек и одного 25-тонного автокрана. Потеря в высоте и в грузоподъёмности — плата за это удобство.</p>
    <p>Potain MCH 175 решает другую задачу: он экономит радиус. Маховая (луффинговая) стрела наклоняется и сокращает рабочий вылет почти до самой мачты, поэтому кран не выходит за границу участка и не задевает соседний корпус. За это приходится платить основанием — рельсовым путём или монолитным фундаментом — и монтажом тяжёлого крана. Паспортные данные обеих моделей приведены в карточках <a href="/park/giraffe-smk-5-66/">giraFFe SMK-5.66</a> и <a href="/park/potain-mch-175/">Potain MCH 175</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>giraFFe SMK-5.66</th><th>Potain MCH 175</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>быстромонтируемый, без фундамента</td><td>безоголовочный, маховая стрела</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>5 т</td><td>10 т</td></tr>
        <tr><td>Груз на предельном вылете</td><td>1,05 т на 43 м</td><td>1,5 т на 55 м</td></tr>
        <tr><td>Вылет</td><td>2,8–43 м</td><td>до 55 м, сокращается наклоном</td></tr>
        <tr><td>Высота подъёма крюка</td><td>до 27 м (гориз.) / до 41,7 м (наклон 20°)</td><td>до 58,5 м</td></tr>
        <tr><td>Основание</td><td>опорный контур 4×4 м</td><td>рельсовый путь или монолитный фундамент</td></tr>
        <tr><td>Монтаж</td><td>4–6 часов, два человека и автокран 25 т</td><td>тяжёлый монтаж с проектом производства работ</td></tr>
      </tbody>
    </table></div>
    <p>Таблица парка КРАН-КУБАНЬ показывает, что Potain MCH 175 выигрывает у giraFFe SMK-5.66 по всем силовым параметрам: вдвое по максимальному грузу и на 31,5 м по высоте крюка в сравнении с горизонтальной стрелой. giraFFe SMK-5.66 выигрывает единственным, но весомым пунктом — основанием и временем монтажа. Выбор сводится к тому, нужны ли объекту параметры, ради которых терпят фундамент.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>giraFFe SMK-5.66 хватает КРАН-КУБАНЬ на коротком объекте: малоэтажный дом, склад, пристройка к существующему зданию, реконструкция в плотной городской среде. Крюк до 27 м с горизонтальной стрелой задаёт потолок для невысоких зданий, а наклон стрелы на 20° поднимает крюк до 41,7 м ценой сокращённого вылета. Груз до 1,05 т на 43 м — подача кирпича, арматурных каркасов и опалубки, но не тяжёлых панелей.</p>
    <p>Главное преимущество SMK-5.66 проявляется там, где некуда ставить рельсовый путь или лить фундамент: опорный контур 4×4 м занимает площадь небольшого двора. Монтаж за 4–6 часов окупается и на объекте с коротким сроком: кран приезжает утром и работает к вечеру. Перед установкой КРАН-КУБАНЬ проверяет грунт под четырьмя опорами, как описано в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Potain MCH 175 нужен КРАН-КУБАНЬ, когда объект выше 41,7 м или требует груза тяжелее 5 т. Крюк до 58,5 м закрывает высотные секции жилых домов и гостиниц, а 10 т максимума позволяют поднимать бетонные бадьи и крупные элементы. Соседний корпус вплотную к границе участка — второй довод: наклон стрелы уводит крюк от стены и не даёт выйти за границу.</p>
    <p>Основание для Potain MCH 175 КРАН-КУБАНЬ выбирает между рельсовым путём и монолитным фундаментом по форме участка. Фундамент удобнее в тесном дворе, где путь вдоль здания проложить негде, как разобрано в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Если объект высокий и тесный одновременно, Potain MCH 175 — единственная из двух моделей, которая закрывает оба условия.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Условный пример: пятиэтажная пристройка высотой около 18 м на дворе без места под путь. Здесь giraFFe SMK-5.66 с крюком до 27 м закрывает высоту с запасом, а монтаж за 4–6 часов не останавливает работу соседей. Для шестнадцатиэтажного дома высотой около 55 м SMK-5.66 уже не подходит, и КРАН-КУБАНЬ берёт Potain MCH 175. Пример условный и показывает логику выбора, а не параметры конкретного объекта.</p>
    <ol>
      <li>Сверьте высоту объекта с пределом giraFFe SMK-5.66: 27 м с горизонтальной стрелой, 41,7 м с наклоном 20°.</li>
      <li>Если высота больше 41,7 м, КРАН-КУБАНЬ переходит к Potain MCH 175 с крюком до 58,5 м.</li>
      <li>Проверьте массу самых тяжёлых элементов: больше 5 т — только Potain MCH 175 из парка КРАН-КУБАНЬ.</li>
      <li>Найдите на участке место под рельсовый путь или фундамент; если места нет, а объект низкий, выбирайте giraFFe SMK-5.66.</li>
      <li>Для высокого объекта впритык к соседям закладывайте Potain MCH 175 и наклон стрелы.</li>
    </ol>
    <p>Окончательный выбор КРАН-КУБАНЬ делает на этапе проекта производства работ, когда известны высота здания, масса элементов и план участка. Если дом выше 60 м, стоит посмотреть и на приставной кран — сравнение в статье <a href="/blog/kb-674a-ili-mch-175/">«КБ-674А или Potain MCH 175»</a>. Чертёж и адрес можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — карточка giraFFe SMK-5.66: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/potain-mch-175/', label: 'kran-kuban.ru — карточка Potain MCH 175: паспортные характеристики' },
      { href: 'https://www.manitowoc.com/', label: 'manitowoc.com — производитель Potain, серия MCH' },
      { href: 'https://giraffecrane.ru/', label: 'giraffecrane.ru — производитель быстромонтируемых кранов giraFFe' },
    ]} />
</BlogArticleLayout>
