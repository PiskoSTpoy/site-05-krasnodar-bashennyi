---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 84. Девятнадцатая статья блога — Тимашевск, первый разбор пищевого
// промышленного профиля вместо уже закрытых нефтепереработки (Северский),
// металлургии (Абинский) и химии (Белореченск). Район — равнинная степь
// севернее Краснодара, без гор и моря, и без курортной функции.
//
// Экономический слой, два независимых предприятия:
// 1) Молочный комбинат в Тимашевске работает как филиал АО «Вимм-Билль-Данн»
//    (ИНН головной организации 7713085659, ОГРН 1027739768924), открыт в
//    1990 году, с 2000 года — в составе «Вимм-Билль-Данн», с 2011 года
//    компания в составе группы PepsiCo. Ключевой региональный бренд —
//    «Кубанская буренка». В 2012 году предприятие прошло международную
//    сертификацию по стандарту безопасности производства AIB.
// 2) ООО «ТСЗ» (Тимашевский сахарный завод, ИНН 2334024068,
//    ОГРН 1122363000121) — с конца 2015 года в составе агрохолдинга
//    «Концерн Покровский», который выкупил простаивавший три предыдущих
//    сезона завод и модернизировал его в 2016-2018 годах: мощность
//    переработки сахарной свёклы выросла до 6500 тонн в сутки, гранулированного
//    жома — до 300 тонн в сутки.
// Оба факта сверены через WebSearch по нескольким независимым источникам
// (dairynews.ru, rossahar.ru, industrials.ru, agrobook.ru, rusprofile,
// list-org, РБК Компании) — egress сессии не пропускал прямой доступ ни к
// одному из этих доменов (WebFetch отбит EGRESS_BLOCKED на каждом), поэтому
// цифры даны как опубликованные отраслевые данные, а не как прямая цитата
// первоисточника предприятия.
//
// Как и в Волнах 76-80, сетевой egress не пропускал docs.cntd.ru и
// base.garant.ru (Приложение Б ТСН 22-302-2000) напрямую — WebSearch тоже не
// дал прямой цитаты строки Тимашевского района. Балл сейсмики для площадки в
// статье сознательно не назван — та же честная развилка, что и в пяти
// предыдущих статьях подряд.

const CHECKED = '9 сентября 2026 года';

const title = 'Кран для Тимашевска: молочный комбинат и сахарный завод на равнине';
const description = 'Тимашевск — степной райцентр Кубани без гор и моря: филиал «Вимм-Билль-Данн» и сахарный завод «Концерна Покровский» формируют спрос на кран иначе, чем побережье или предгорье.';
const h1 = 'Кран для Тимашевска: молочный комбинат и сахарный завод на равнине';
const crumbTitle = 'Кран для Тимашевска';
const slug = 'kran-dlya-timashevska';

const H2 = [
  'Тимашевск — степной райцентр без гор и моря',
  'Молочный комбинат: полвека переработки молока под кубанским брендом',
  'Сахарный завод: вторая жизнь после простоя и модернизация 2016-2018 годов',
  'Сейсмика: что можно сказать про Тимашевский район, а что нет',
  'Закон о тишине действует и здесь — без региональной скидки',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Раз в Тимашевске есть два крупных перерабатывающих предприятия, значит кран нужен только на их площадках?',
    a: 'Нет. Молочный комбинат и сахарный завод — крупнейшие, но не единственные заказчики техники в районе: жилая застройка самого Тимашевска и станиц района, объекты сельхозинфраструктуры (элеваторы, зернохранилища, тепличные комплексы) и коммерческая недвижимость формируют отдельный, более мелкий и разрозненный спрос — с другими требованиями к грузоподъёмности и графику, чем реконструкция цеха действующего завода.',
  },
  {
    q: 'Правда ли, что сейсмика Тимашевского района ниже, чем у предгорных районов края?',
    a: 'Скорее всего да — район равнинный, вдали от Кавказских гор, и логика такая же, как у Кропоткина и Тихорецка (расчётная сейсмичность А-6, то есть ниже порога, при котором сейсмический расчёт обязателен). Но мы сознательно не называем в статье конкретный балл: доступные источники не подтвердили прямой цитатой строку Тимашевского района в Приложении Б ТСН 22-302-2000, а предполагать цифру по аналогии с равнинными соседями мы считаем менее честным, чем не называть её вовсе.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Тимашевска', item: `${SITE}/blog/kran-dlya-timashevska/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-timashevska/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-timashevska/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье (Анапа, Новороссийск, Сочи, Ейск, Туапсе), предгорную ось (Армавир, Горячий Ключ, Апшеронский и Мостовской районы) и степные промышленные территории с металлургией и нефтепереработкой (Абинский и Северский районы). Тимашевск продолжает степную линию, но с иным экономическим профилем: здесь спрос на кран формирует не металл и не нефть, а пищевая промышленность — молоко и сахар, два предприятия с разной, но одинаково длинной историей.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Тимашевск — административный центр Тимашевского района, расположенный на равнине примерно в 50 километрах к северу от Краснодара, вдали от Кавказских гор и черноморского или азовского побережья. Курортной функции у города нет: сюда не едут ради моря или здравниц, а сезонных всплесков спроса, характерных для Сочи или Анапы, в графике монтажа крана можно не закладывать. Зато есть устойчивый, круглогодичный промышленный спрос — вокруг двух перерабатывающих предприятий, каждое из которых работает не первое десятилетие.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Молочный комбинат в Тимашевске открылся в 1990 году и стал одним из крупнейших предприятий по переработке молока на юге страны, а также первым в стране производителем ультрапастеризованного молока. В 2000 году он вошёл в состав компании «Вимм-Билль-Данн» — это укрепило позиции регионального бренда «Кубанская буренка», под которым комбинат хорошо известен в крае. С 2011 года «Вимм-Билль-Данн» входит в группу компаний PepsiCo, и сегодня предприятие в Тимашевске работает как филиал АО «Вимм-Билль-Данн» (ИНН головной организации — 7713085659, ОГРН 1027739768924). В 2012 году комбинат прошёл международную сертификацию по стандарту безопасности производства AIB — свидетельство того, что площадка продолжает модернизироваться, а не работает по инерции советского оборудования. Для арендодателя крана действующий пищевой комбинат с непрерывным циклом означает специфику, отличную от промзоны НПЗ: более жёсткие требования к чистоте площадки и графику работ, синхронизированному с производственным циклом, а не только с погодой.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Вторая опора экономики города — ООО «ТСЗ», Тимашевский сахарный завод (ИНН 2334024068, ОГРН 1122363000121). История этого предприятия менее ровная, чем у молочного комбината: по опубликованным отраслевым данным, к концу 2015 года завод простаивал три сезона подряд, прежде чем его выкупил агрохолдинг «Концерн Покровский». Инвестиции нового собственника пошли не на консервацию, а на модернизацию: в 2016–2018 годах мощность переработки сахарной свёклы выросла до 6500 тонн в сутки, а производство гранулированного жома — сопутствующего продукта переработки, который идёт на корм скоту, — до 300 тонн в сутки. Для монтажа крана история завода читается прямо: площадка, которая была законсервирована и затем модернизирована с ростом мощности почти вдвое, — это площадка с реальным опытом капитального строительства и реконструкции корпусов, а не гипотетическим спросом на технику.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Здесь мы, как и в статьях про Абинский, Северский, Славянск-на-Кубани, Ейск и Туапсе, сознательно не приводим конкретный балл сейсмичности. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Тимашевского района доступные источники надёжно не подтвердили. По географической логике равнинный район вдали от гор скорее ближе к соседним Кропоткину и Тихорецку — населённым пунктам, для которых, как отмечено в статье про Армавир, сейсмический расчёт по действующему нормативу не требуется, — чем к предгорному Горячему Ключу или Апшеронскому району с их поднятым баллом. Но аналогия с соседями — не подтверждённый факт, а только направление рассуждения, и мы не выдаём одно за другое. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Тимашевске так же, как в Сочи или Краснодаре: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дополнительным дневным перерывом, а ответственность по статье 3.3 одинакова для всего края независимо от того, стоит рядом промышленная площадка или частный дом. У технологических площадок молочного комбината и сахарного завода, удалённых от плотной жилой застройки, риск жалобы соседей ниже, чем у стройки в самом Тимашевске или в одной из станиц района, — но само требование к часам работы это не отменяет. Подробный разбор часов и сумм штрафов — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Тимашевск — равнинный степной райцентр севернее Краснодара, без гор, моря и курортной функции; спрос на кран здесь круглогодичный, а не сезонный.</li>
      <li>Молочный комбинат работает как филиал АО «Вимм-Билль-Данн» (входит в PepsiCo с 2011 года) — предприятие с 1990 года и региональным брендом «Кубанская буренка».</li>
      <li>Сахарный завод ООО «ТСЗ» (ИНН 2334024068) с 2015 года в составе «Концерна Покровский»: модернизация 2016-2018 годов подняла мощность переработки свёклы до 6500 тонн в сутки.</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Тимашевского района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Тимашевске так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://dairynews.ru/dia/russia/yufo/krasnodarskiy-kray/timashevskiy-molochnyy-kombinat-oao/', label: 'dairynews.ru — Тимашевский молочный комбинат, филиал АО «ВБД»' },
      { href: 'https://www.wiki-prom.ru/122zavod.html', label: 'wiki-prom.ru — Тимашевский молочный комбинат (ТМК), продукция и контакты' },
      { href: 'https://wbd.ru/news/2869/', label: 'wbd.ru — новости группы «Вимм-Билль-Данн» о заводах в Краснодарском крае' },
      { href: 'https://www.rusprofile.ru/id/6014879', label: 'rusprofile.ru — ООО «ТСЗ» (Тимашевский сахарный завод), ИНН 2334024068' },
      { href: 'https://companies.rbc.ru/id/1122363000121-ooo-obschestvo-s-ogranichennoj-otvetstvennostyu-timashevskij-saharnyij-zavod/', label: 'РБК Компании — ООО «ТСЗ», ОГРН 1122363000121' },
      { href: 'http://www.rossahar.ru/rynok/istoriya-zavodov/timashevskiy-sakharnyy-zavod/', label: 'rossahar.ru — история завода, покупка «Концерном Покровский», модернизация 2016-2018' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
    ]} />
</BlogArticleLayout>
