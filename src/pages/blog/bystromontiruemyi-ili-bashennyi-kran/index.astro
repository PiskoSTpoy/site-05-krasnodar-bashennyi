---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 97. Тридцать шестая статья блога — угол (b) коммерческий/
// сравнительный. «Смета аренды» (Волна 95) одной фразой советует смотреть
// на быстромонтируемый кран для коротких объектов; эта статья разворачивает
// выбор полностью: giraFFe SMK-5.66 против двух классических кранов парка
// по основанию, монтажу, высоте, вылету и сроку объекта.
//
// Фактура — только проверенные данные парка (src/data/parkModels.ts и
// карточка /park/giraffe-smk-5-66/, источник giraffecrane.ru): 5 т / 1,05 т
// на 43 м, вылет 2,8–43 м, крюк до 27 м (горизонтально) / 41,7 м (наклон
// 20°), опорный контур 4×4 м, монтаж 4–6 ч силами двух человек и одного
// автокрана 25 т. Ставки — только срез, уже опубликованный на карточке
// (kranauto.ru, Подмосковье, от 240 000 ₽/мес за 5-тонный класс), с
// оговоркой, что краевых цен в открытом доступе нет.

const CHECKED = '26 сентября 2026 года';
const PUBLISHED = '2026-09-26';

const title = 'Быстромонтируемый или классический башенный кран: выбор';
const description = 'giraFFe SMK-5.66 против КБ-408.21 и Potain MDT 219 J10: основание, монтаж за часы или дни, высота, вылет и срок объекта. Когда быстромонтируемый кран выгоднее.';
const h1 = 'Быстромонтируемый или классический башенный кран: что выбрать для объекта на Кубани';
const crumbTitle = 'Быстромонтируемый или классический кран';
const slug = 'bystromontiruemyi-ili-bashennyi-kran';

const H2 = [
  'Чем быстромонтируемый кран отличается от классического',
  'Сравнение трёх кранов парка по пяти параметрам',
  'Основание: опорный контур против фундамента и пути',
  'Монтаж и демонтаж: часы против дней',
  'Где заканчиваются возможности быстромонтируемого крана',
  'Какой кран выбрать под срок и этажность',
  'Сейсмика и закон о тишине действуют на оба класса',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const rows = [
  { p: 'Грузоподъёмность', g: '5 т · 1,05 т на 43 м', k: '10 т', m: '10 т · 1,9 т на 65 м' },
  { p: 'Вылет', g: '2,8–43 м', k: '40 м', m: '65 м' },
  { p: 'Высота крюка', g: 'до 27 м (гориз.) / 41,7 м (наклон 20°)', k: '54,0–72,7 м', m: 'до 70,4 м' },
  { p: 'Основание', g: 'опорный контур 4×4 м, без фундамента', k: 'наземный рельсовый путь', m: 'рельсовый путь или монолитный фундамент' },
  { p: 'Монтаж', g: '4–6 часов, 2 человека и автокран 25 т', k: 'по ППР, после устройства пути', m: 'по ППР, после устройства основания' },
];

const faqs = [
  {
    q: 'Что такое быстромонтируемый башенный кран?',
    a: 'Быстромонтируемый башенный кран разворачивает башню и стрелу собственными гидравлическими механизмами, без такелажных работ на высоте. У giraFFe SMK-5.66 из парка КРАН-КУБАНЬ от доставки до готовности к работе проходит 4–6 часов, нужен один автокран 25 т для установки на опоры, а сам кран стоит на опорном контуре 4×4 м без фундамента.',
  },
  {
    q: 'До какой этажности подходит быстромонтируемый кран?',
    a: 'Предел задаёт высота крюка: giraFFe SMK-5.66 поднимает крюк до 27 м с горизонтальной стрелой и до 41,7 м с наклоном 20°, но наклон сокращает вылет. На практике это малоэтажные и среднеэтажные объекты; точный предел считают по отметке кровли, запасу, строповке и высоте груза. Для объекта выше КРАН-КУБАНЬ предлагает КБ-408.21 или Potain MDT 219 J10.',
  },
  {
    q: 'Быстромонтируемый кран дешевле в аренде?',
    a: 'Открытых цен на аренду быстромонтируемых кранов в Краснодарском крае нет, ставки даются по запросу. Экономия у giraFFe SMK-5.66 обычно не в месячной ставке, а в сопутствующих строках сметы: нет фундамента или рельсового пути, монтаж и демонтаж занимают часы. На объекте на несколько недель эти строки для КРАН-КУБАНЬ часто решают выбор.',
  },
  {
    q: 'Нужен ли сейсмический расчёт для быстромонтируемого крана?',
    a: 'Да. ТСН 22-302-2000 и СП 14.13330.2018 не делают исключения для лёгкого класса техники. Для giraFFe SMK-5.66 это расчёт устойчивости крана на аутригерах против опрокидывания и проверка покрытия под четырьмя опорами, а для классического крана КРАН-КУБАНЬ — расчёт фундамента или рельсового пути.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение для заказчика"
  published={PUBLISHED}
>
    <p slot="intro">Быстромонтируемый башенный кран выгоднее классического на коротком и невысоком объекте, где нет места или смысла готовить фундамент и рельсовый путь. giraFFe SMK-5.66 из парка КРАН-КУБАНЬ встаёт на опорный контур 4×4 м за 4–6 часов, но поднимает до 5 т и крюк максимум на 41,7 м. КБ-408.21 и Potain MDT 219 J10 требуют основания и монтажа по ППР, зато дают 10 т, вылет 40–65 м и высоту крюка за 70 м.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Быстромонтируемый giraFFe SMK-5.66 — кран отдельной конструктивной категории, а не облегчённый башенный кран. Модель челябинского производителя giraFFe раскладывает складную решётчатую башню и стрелу собственными гидравлическими механизмами, без монтажников на высоте. Классические КБ-408.21 и Potain MDT 219 J10 собирают секциями с помощью автокрана по проекту производства работ, на заранее готовом основании.</p>
    <p>Управление giraFFe SMK-5.66 ведут из кабины внизу конструкции или по радио с площадки, в зависимости от исполнения, поэтому машинисту КРАН-КУБАНЬ не нужно подниматься на высоту. У классического крана кабина стоит наверху, у поворотной части. Эта разница отражает назначение: быстромонтируемый кран рассчитан на короткие объекты, классический — на многомесячный высотный цикл.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Три крана парка КРАН-КУБАНЬ показывают разницу классов на одних и тех же параметрах. Цифры взяты из карточек моделей, где указаны первоисточники.</p>

    <div class="rule-table-wrap" style="margin-bottom:24px">
      <table class="rule-table">
        <caption style="text-align:left;margin-bottom:8px">Быстромонтируемый и классические краны КРАН-КУБАНЬ</caption>
        <thead>
          <tr><th scope="col">Параметр</th><th scope="col"><a href="/park/giraffe-smk-5-66/">giraFFe SMK-5.66</a></th><th scope="col"><a href="/park/kb-408-21/">КБ-408.21</a></th><th scope="col"><a href="/park/potain-mdt-219-j10/">Potain MDT 219 J10</a></th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.p}</td><td>{r.g}</td><td>{r.k}</td><td>{r.m}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <p>Таблица кранов КРАН-КУБАНЬ читается просто: giraFFe SMK-5.66 проигрывает по всем «силовым» параметрам и выигрывает в двух строках — основании и монтаже. Если объект укладывается в его высоту, вылет и грузоподъёмность, именно эти две строки определяют смету и сроки.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Основание — главное практическое отличие giraFFe SMK-5.66 от классических кранов парка. КБ-408.21 ходит по наземному рельсовому пути, Potain MDT 219 J10 ставят на путь или монолитный фундамент, и оба варианта требуют изысканий, подготовки грунта и времени на набор прочности бетона. SMK-5.66 опирается на четыре аутригера опорного контура 4×4 м и передаёт нагрузку на существующее покрытие площадки.</p>
    <p>Для быстромонтируемого крана КРАН-КУБАНЬ вопрос основания сводится к точечной проверке несущей способности под четырьмя опорами. Это не отменяет расчёта: если покрытие слабое, под опоры готовят подкладки или локальное усиление. Но проект фундамента или пути на весь срок аренды не нужен — и не нужен его демонтаж после стройки. Подробнее о подготовке основания классических кранов — на этапе <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>giraFFe SMK-5.66 от доставки до готовности к подъёму разворачивается за 4–6 часов: нужны двое монтажников и один автокран на 25 тонн. Монтаж КБ-408.21 или Potain MDT 219 J10 — многодневная работа: сначала основание, затем сборка секций мачты, стрелы и противовесов автокраном по ППР, затем испытания. Демонтаж и перебазировка классического крана — такой же цикл в обратную сторону.</p>
    <p>Для заказчика КРАН-КУБАНЬ разница в монтаже превращается в деньги двумя путями. Первый — отдельные строки сметы на монтаж, демонтаж и основание, которых у быстромонтируемого крана почти нет. Второй — дни, когда аренда уже идёт, а кран ещё не работает. На объекте длиной в несколько недель эти дни составляют заметную долю срока; как их учитывать, разобрано в статье <a href="/blog/smeta-arendy-bashennogo-krana/">«Смета аренды башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Предел giraFFe SMK-5.66 задают высота крюка и грузоподъёмность на вылете. С горизонтальной стрелой крюк поднимается до 27 м при полном вылете 43 м; наклон стрелы на 20° даёт 41,7 м, но сокращает вылет. На конце стрелы кран поднимает 1,05 т, поэтому массу каждого тяжёлого груза вместе с тарой сверяют с грузовой характеристикой на том вылете, где его подают.</p>
    <p>Когда объект выше или грузы тяжелее, КРАН-КУБАНЬ переходит к классическим кранам. КБ-408.21 даёт 10 т и высоту крюка 54,0–72,7 м, Potain MDT 219 J10 — 10 т и вылет 65 м с 1,9 т на конце стрелы. Для зданий выше 70 м в парке есть приставной КБ-674А, который крепится к конструкции здания и набирает высоту до 116–120 м.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Выбор между классами кранов КРАН-КУБАНЬ сводится к трём вопросам к объекту. Если на все три ответ «да», экономичнее giraFFe SMK-5.66; если хотя бы на один «нет» — классический кран.</p>
    <ul>
      <li>Укладывается ли высота крюка в 27 м, а с наклоном стрелы — в 41,7 м ценой вылета?</li>
      <li>Не тяжелее ли самые тяжёлые грузы того, что SMK-5.66 поднимает на нужном вылете (5 т у мачты, 1,05 т на 43 м)?</li>
      <li>Короткий ли срок работы крана — недели, а не многие месяцы, — чтобы экономия на основании и монтаже была заметной?</li>
    </ul>
    <p>Типичные объекты giraFFe SMK-5.66 в практике КРАН-КУБАНЬ — одноэтажные сельскохозяйственные и складские здания с широким пролётом, малоэтажное жильё и реконструкция в стеснённом центре, где негде разместить рельсовый путь. Многоэтажный жилой дом, промышленный корпус с тяжёлым оборудованием и стройка на год и больше — задача для КБ-408.21, Potain MDT 219 J10 или Potain MCH 175. Пошаговый подбор по трём параметрам — в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран под объект»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Краевые нормы ТСН 22-302-2000 и СП 14.13330.2018 не делают исключения для лёгкого класса техники: сейсмическую и ветровую нагрузку считают для любого крана на площадке. Для giraFFe SMK-5.66 это расчёт устойчивости на аутригерах против опрокидывания, для КБ-408.21 и Potain MDT 219 J10 — расчёт фундамента или рельсового пути. Балл площадки КРАН-КУБАНЬ берёт из проекта; как он определяется, разобрано в разделе <a href="/seysmozony/">«Сейсмозоны»</a>.</p>
    <p>Закон Краснодарского края №608-КЗ тоже одинаков для обоих классов: рядом с жильём шумные работы разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Быстромонтируемый кран КРАН-КУБАНЬ выигрывает здесь в другом: его монтаж за 4–6 часов помещается в одно дневное окно, а многодневный монтаж классического крана приходится планировать под окна на несколько дней вперёд.</p>
    <p>Этажность, сроки и адрес объекта можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ скажет, хватит ли быстромонтируемого крана или нужен классический.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://giraffecrane.ru/catalog/bashennye-krany/smk-5-66/', label: 'giraffecrane.ru — giraFFe SMK-5.66: грузоподъёмность, вылет, высота подъёма, опорный контур, время монтажа' },
      { href: 'https://ru.wikipedia.org/wiki/%D0%91%D1%8B%D1%81%D1%82%D1%80%D0%BE%D0%BC%D0%BE%D0%BD%D1%82%D0%B8%D1%80%D1%83%D0%B5%D0%BC%D1%8B%D0%B9_%D0%BA%D1%80%D0%B0%D0%BD', label: 'ru.wikipedia.org — быстромонтируемый кран: принцип сборки собственными механизмами' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018 «Строительство в сейсмических районах»' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
