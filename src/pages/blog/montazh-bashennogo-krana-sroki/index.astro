---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 103. Пятьдесят третья статья блога — угол (a) информационный/how-to.
// Монтаж башенного крана: из каких этапов состоит и сколько занимает по времени.
// Новая тема блога — ни одна статья ещё не разбирала сам процесс сборки крана
// на площадке в привязке ко всем пяти моделям парка. Отраслевой слой (этапы,
// сроки по типу основания) — не федеральная регистрация в Ростехнадзоре, та
// тема закреплена за site-01; здесь только инженерный процесс сборки.
//
// Фактура — проверена 02.10.2026 (WebSearch + WebFetch):
// - 9 этапов монтажа и сроки по грузоподъёмности (1–2 дня / 3–5 дней / до 2 недель
//   climbing), требование к вертикальности башни 1 мм/1 м — kontexgroup.ru;
// - 40-метровый кран — 2–3 дня, 10–12 секций, наращивание самоподъёмом
//   30–40 минут на секцию, климбинг через «стакан» под кабиной — glavkran.by;
// - giraFFe SMK-5.66 — 4–6 часов, опорный контур 4×4 м, монтаж 25-тонным
//   автокраном — собственный факт сайта (parkModels.ts, статьи-соседи).
// Цифры по демонтажу из общих источников не беру — ни один не детализирует
// порядок, пишу как логическое следствие обратного порядка этапов.

const CHECKED = '2 октября 2026 года';
const PUBLISHED = '2026-10-02';

const title = 'Монтаж башенного крана: сколько дней занимает сборка';
const description = 'Монтаж на пути или фундаменте — 1–5 дней, быстромонтируемый giraFFe SMK-5.66 — 4–6 часов, климбинг приставного крана — до 2 недель. Девять этапов сборки.';
const h1 = 'Монтаж башенного крана: сколько времени занимает сборка на площадке';
const crumbTitle = 'Монтаж башенного крана: сроки';
const slug = 'montazh-bashennogo-krana-sroki';

const H2 = [
  'Девять этапов монтажа башенного крана',
  'Сколько длится монтаж: от грузоподъёмности и основания',
  'giraFFe SMK-5.66: монтаж за 4–6 часов без фундамента',
  'КБ-408.21 и Potain MDT 219 J10: путь, секции, автокран',
  'КБ-674А: климбинг и наращивание по мере роста здания',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько времени занимает монтаж башенного крана?',
    a: 'Срок зависит от грузоподъёмности и типа основания: краны 8–10 т на подготовленном пути монтируют за 1–2 дня, краны от 25 т — за 3–5 дней, а стационарные приставные краны с климбингом — до двух недель. КРАН-КУБАНЬ отдельно называет быстромонтируемый giraFFe SMK-5.66: его собирают за 4–6 часов.',
  },
  {
    q: 'Из каких этапов состоит монтаж крана?',
    a: 'Монтаж башенного крана проходит девять этапов: проект производства работ, подготовка основания, завоз и раскладка элементов, сборка ходовой рамы и башни, монтаж поворотной части и стрелы, установка противовеса, монтаж электрооборудования и приборов безопасности, пусконаладка с испытаниями и оформление документов. КРАН-КУБАНЬ проходит каждый этап под контролем инженерной службы.',
  },
  {
    q: 'Нужен ли автокран для монтажа башенного крана?',
    a: 'Да, классический башенный кран сам себя не монтирует: секции мачты, стрелу и противовес поднимает вспомогательный автокран грузоподъёмностью под самый тяжёлый элемент. КРАН-КУБАНЬ использует для этого технику из статьи «Башенный кран или автокран», а быстромонтируемый giraFFe SMK-5.66 собирают одним 25-тонным автокраном.',
  },
  {
    q: 'Сколько времени нужно фундаменту под кран, чтобы набрать прочность?',
    a: 'Монолитный фундамент под башенный кран набирает проектную прочность не менее 28 суток — это общий срок созревания бетона, а не особенность конкретной модели. КРАН-КУБАНЬ планирует монтаж КБ-674А и других кранов на фундаменте с учётом этого срока ещё на стадии графика стройки.',
  },
  {
    q: 'Как кран КБ-674А растёт вместе со зданием?',
    a: 'КБ-674А наращивает высоту climbing-механизмом: новую секцию заводят в опорный «стакан» под кабиной, после чего гидравлика поднимает верхнюю часть крана на одну секцию вверх. КРАН-КУБАНЬ повторяет этот цикл по мере роста этажей, пока башня не достигнет отметки, предусмотренной проектом анкеровки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Эксплуатация · Монтаж"
  published={PUBLISHED}
>
    <p slot="intro">Монтаж башенного крана занимает от 4–6 часов у быстромонтируемого giraFFe SMK-5.66 до двух недель у приставного крана с климбингом. Между этими полюсами — классические краны на рельсовом пути: 1–5 дней в зависимости от грузоподъёмности и числа секций мачты. КРАН-КУБАНЬ проходит с заказчиком все девять этапов сборки от проекта производства работ до ввода крана в эксплуатацию.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Монтаж башенного крана проходит девять этапов в строгом порядке: проект производства работ, подготовка основания, завоз и раскладка элементов, сборка ходовой рамы и башни, монтаж поворотной части и стрелы, установка противовеса, монтаж электрооборудования и приборов безопасности, пусконаладка с испытаниями и оформление документов на ввод в эксплуатацию. КРАН-КУБАНЬ не меняет порядок этапов ради экономии времени: каждый следующий шаг опирается на то, что проверено на предыдущем.</p>
    <p>Вертикальность башни КРАН-КУБАНЬ контролирует на каждой секции монтажа: отклонение не должно превышать 1 мм на 1 метр высоты. На кране высотой 70 м это значит, что верх мачты допускает смещение не больше 7 см от вертикали — отклонение сверх нормы нагружает конструкцию неравномерно и требует остановки монтажа до исправления.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Срок монтажа башенного крана КРАН-КУБАНЬ определяют грузоподъёмность и тип основания, а не марка крана сама по себе. Краны классом 8–10 т на подготовленном пути или фундаменте собирают за 1–2 дня, краны от 25 т — за 3–5 дней, а стационарные приставные краны с климбингом занимают до двух недель, потому что башню наращивают поэтапно по мере роста здания.</p>
    <p>Классический кран высотой 40 м набирают из 10–12 секций мачты, и сама сборка занимает 2–3 дня — на фундамент под такой кран КРАН-КУБАНЬ закладывает отдельный срок на созревание бетона, не менее 28 суток до начала монтажа. Самоподъём одной секции мачты занимает 30–40 минут, поэтому для крана из 10 секций только наращивание мачты складывается в 5–7 часов чистого времени механизма без учёта пауз на проверки.</p>
    <p>Вспомогательный автокран на монтаже башенного крана КРАН-КУБАНЬ подбирает по самому тяжёлому элементу — обычно это секция противовеса или часть стрелы, а не секция мачты. Для giraFFe SMK-5.66 хватает одного 25-тонного автокрана, для классических моделей грузоподъёмность и число выездов техники считают по ведомости монтажных масс; сравнение башенного крана с одним автокраном на площадке разобрано в статье <a href="/blog/bashennyi-kran-ili-avtokran/">«Башенный кран или автокран»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>giraFFe SMK-5.66 КРАН-КУБАНЬ монтирует за 4–6 часов силами двух человек и одного 25-тонного автокрана — это самый короткий срок сборки среди пяти моделей парка. Опорный контур 4×4 м не требует фундамента и не ждёт созревания бетона, поэтому кран может встать на площадку и начать работу в тот же день, когда его привезли.</p>
    <p>Короткий монтаж giraFFe SMK-5.66 меняет экономику короткого объекта: классический кран с фундаментом и путём невыгодно ставить на малоэтажный дом, где сама стройка займёт меньше времени, чем окупается подготовка основания. КРАН-КУБАНЬ предлагает giraFFe SMK-5.66 именно для таких случаев, а логика выбора между двумя типами кранов разобрана в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КБ-408.21 из парка КРАН-КУБАНЬ монтируют на наземном рельсовом пути: сначала укладывают путь под базу 7,5×7,5 м, затем ходовую раму и секции мачты наращивают по порядку снизу вверх. Путь — не быстрый элемент подготовки: балластная призма, рельсы и тупиковые упоры готовятся до того, как на площадку приедет первая секция крана.</p>
    <p>Potain MDT 219 J10 КРАН-КУБАНЬ ставит на рельсовый путь или на монолитный фундамент — выбор основания здесь шире, чем у КБ-408.21, который работает только на пути. Топлесс-геометрия Potain MDT 219 J10 не меняет сам порядок монтажа: кран так же набирается секциями снизу вверх, а разница в сроках между двумя моделями определяет тип основания, а не конструкция стрелы. Сравнение этих двух кранов по вылету и высоте подъёма приведено в статье <a href="/blog/potain-mdt-219-j10-ili-kb-408-21/">«Potain MDT 219 J10 или КБ-408.21»</a>.</p>
    <p>Выбор между рельсовым путём и монолитным фундаментом для крана КРАН-КУБАНЬ зависит от площадки и геометрии объекта: путь даёт перемещение вдоль здания, фундамент — компактную стоянку на стеснённом участке. Подробное сравнение двух оснований и того, что каждое требует от грунта, приведено в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>, а порядок инженерных изысканий под основание — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>КБ-674А КРАН-КУБАНЬ устанавливает в свободностоящем исполнении до высоты 60 м, а дальше кран растёт вместе со зданием climbing-механизмом: новую секцию заводят в опорный «стакан» под кабиной, и гидравлика поднимает верхнюю часть крана на одну секцию вверх. Цикл повторяют по мере готовности очередных этажей, пока башня не дойдёт до отметки, предусмотренной проектом анкеровки, вплоть до 116–120 м.</p>
    <p>Climbing приставного крана КРАН-КУБАНЬ синхронизирует с темпом бетонирования здания, а не с календарным графиком отдельно от стройки: поднять кран можно только после того, как перекрытие набрало прочность для очередной точки крепления. Поэтому у приставного крана нет единого срока монтажа — есть суммарное время всех циклов климбинга за время строительства, которое и укладывается в диапазон до двух недель для стационарных кранов этого типа. Как рассчитывают сами узлы крепления к зданию, показано в статье <a href="/blog/kb-408-21-ili-kb-674a/">«КБ-408.21 или КБ-674А»</a>.</p>
    <p>Демонтаж башенного крана КРАН-КУБАНЬ проводит в обратном порядке монтажа: сначала снимают противовес и стрелу, затем разбирают секции мачты сверху вниз тем же вспомогательным автокраном. Адрес объекта и предполагаемые сроки стройки можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ составит график монтажа под конкретную площадку.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kontexgroup.ru/montazh/etapy-montazha-bashennogo-krana.html', label: 'kontexgroup.ru — девять этапов монтажа, сроки по грузоподъёмности, допуск на вертикальность башни' },
      { href: 'https://glavkran.by/blog/detail/kak-montiruyut-bashennyy-kran-ot-fundamenta-do-probnogo-puska/', label: 'glavkran.by — монтаж 40-метрового крана за 2–3 дня, 10–12 секций, время самоподъёма секции' },
      { href: 'https://top-stm.ru/news/kak-sobirayut-bashennye-krany', label: 'top-stm.ru — порядок сборки башенного крана на площадке' },
      { href: 'https://www.eurohol.ru/about/stati/bashennye-krany/montazh-bashennogo-krana-na-strojke', label: 'eurohol.ru — этапы монтажа башенного крана, фото процесса' },
    ]} />
</BlogArticleLayout>
