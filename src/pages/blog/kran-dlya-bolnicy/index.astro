---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 123. Сто четырнадцатая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «больница П-образной формы с внутренним двором»: иллюстрация, помечена в тексте.
// План: главный корпус x ∈ [0; 60], y ∈ [0; 18]; два крыла шириной 18 м: x ∈ [0; 18] и x ∈ [42; 60], y ∈ [18; 48].
// Двор между крыльями: x ∈ [18; 42], y ∈ [18; 48] — 24 × 30 м, открыт на север (y = 48). Высота 5 этажей × 3,6 м = 18 м.
// Потребный крюк: 18 + 0,5 (п. 114 ФНП № 461) + 3 + 4 = 25,5 м. Запас по высоте (parkModels.ts):
//   КБ-408.21 54,0 → +28,5; SMK-5.66 27 (гориз.) → +1,5; КБ-674А до 60 → +34,5; MCH 175 до 58,5 → +33,0; MDT 219 J10 до 70,4 → +44,9.
// S1 — во дворе (30; 24). Дальние внешние углы (0;0), (60;0), (0;48), (60;48): √(30² + 24²) = √1476 = 38,42 м.
//   Запас: КБ-408.21 (40) +1,58; SMK-5.66 (43) +4,58; КБ-674А (50,5) +12,08; MCH 175 (55) +16,58; MDT 219 J10 (65) +26,58.
// S2 — снаружи у главного корпуса, 10 м от южной стены, на оси: (30; −10). Дальние углы крыльев (0;48), (60;48): √(30² + 58²) = √4264 = 65,30 м.
//   Запас: КБ-408.21 −25,30; SMK-5.66 −22,30; КБ-674А −14,80; MCH 175 −10,30; MDT 219 J10 −0,30 (не достаёт).
// S3 — снаружи, севернее открытой стороны двора, 8 м от линии y = 48, на оси: (30; 56). Дальние углы главного корпуса (0;0), (60;0): √(30² + 56²) = √4036 = 63,53 м.
//   Запас: КБ-408.21 −23,53; SMK-5.66 −20,53; КБ-674А −13,03; MCH 175 −8,53; MDT 219 J10 +1,47.
//   Грузоподъёмность на максимальном вылете: MDT 1,9 т (на 63,53 м каталог значения не даёт — не названо).
// Двор 24 × 30 м открыт на север — вывод КРАН-КУБАНЬ: путь для автокрана при демонтаже остаётся через раскрытую сторону; детали — в ППР.
// НЕ названо: цены, сроки, медицинские требования, нагрузки на грунт, размеры базы моделей (в parkModels.ts только SMK 4 × 4 м),
// ограничения по шуму числами (только отсылка к статьям о 608-КЗ и децибелах).

const CHECKED = '29 октября 2026 года';
const PUBLISHED = '2026-10-29';

const title = 'Кран для больницы П-образной формы: двор даёт вылет 38,42 м';
const description = 'Корпус 60 м с двумя крыльями и двором: во дворе нужен вылет 38,42 м, снаружи — 63,53 м и более. Расчёт КРАН-КУБАНЬ по пяти моделям.';
const h1 = 'Какой башенный кран выбрать для строительства больницы П-образной формы';
const crumbTitle = 'Кран для больницы';
const slug = 'kran-dlya-bolnicy';

const H2 = [
  'Исходные данные примера: корпус 60 м, два крыла и двор',
  'Потребная высота крюка 25,5 м: почти все проходят',
  'Стоянка S1 во дворе: вылет 38,42 м',
  'Стоянка S2 снаружи у главного корпуса: 65,30 м',
  'Стоянка S3 севернее двора: 63,53 м',
  'Двор как ловушка: монтаж и демонтаж крана',
  'Соседство с действующими зданиями и тишина',
  'Сводка: модель, запас по высоте и вылету',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Где ставить башенный кран при строительстве П-образной больницы?',
    a: 'Лучший вариант в расчёте КРАН-КУБАНЬ — внутренний двор: из точки в центре двора до четырёх внешних углов 38,42 м, и достают все пять моделей парка. Снаружи вылет вырастает до 63,53–65,30 м, и проходит максимум одна модель. Окончательное решение зависит от плана площадки, ограждения и подъездов.',
  },
  {
    q: 'Какая высота крюка нужна для пятиэтажной больницы?',
    a: 'Для условных пяти этажей по 3,6 м, то есть 18 м, потребный крюк равен 25,5 м: 18 + 0,5 м запаса по пункту 114 ФНП № 461 + 3 м груз + 4 м стропы. Груз и стропы — допущения КРАН-КУБАНЬ. Горизонтальная стрела giraFFe SMK-5.66 поднимает крюк до 27 м и проходит с запасом 1,5 м.',
  },
  {
    q: 'Хватит ли giraFFe SMK-5.66 для больничного корпуса?',
    a: 'Для пяти этажей по высоте да: крюк 27 м против потребных 25,5 м, запас 1,5 м. По вылету у SMK-5.66 43 м, и из двора до дальних углов нужно 38,42 м, запас 4,58 м. Любой вариант снаружи недоступен. Выше пяти этажей решение пересматривают по паспорту.',
  },
  {
    q: 'Почему Potain MDT 219 J10 не достаёт при стоянке у главного корпуса?',
    a: 'С вылетом 65 м она не достаёт до углов крыльев на 0,30 м: расстояние от точки (30; −10) до (0; 48) равно 65,30 м. Разница мала, и сдвиг стоянки на 1–2 м ближе к крыльям или смена оси решает задачу. Поэтому КРАН-КУБАНЬ рекомендует проверять точку на плане, а не по таблице.',
  },
  {
    q: 'Как демонтировать кран, если он стоит во дворе здания?',
    a: 'Двор 24 × 30 м открыт с севера, и проход автокрана остаётся через эту сторону. Порядок демонтажа и вынос стрелы определяет ППР, поэтому решение «кран во двор» принимают вместе с проектом производства работ. КРАН-КУБАНЬ советует закрывать северную сторону двора последней, когда кран уже снят.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Больница"
  published={PUBLISHED}
>
    <p slot="intro">Для больницы П-образной формы с корпусом 60 м и двумя крыльями по 30 м башенному крану нужен крюк на 25,5 м, а вылет решает место стоянки: 38,42 м из центра внутреннего двора и 63,53–65,30 м снаружи. Из пяти моделей парка КРАН-КУБАНЬ из двора проходят все, а снаружи достаёт максимум одна — Potain MDT 219 J10, и то только с северной стороны.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Для расчёта КРАН-КУБАНЬ взял условную больницу: главный корпус 60 × 18 м и два крыла шириной 18 м, уходящие на 30 м к северу вдоль торцов корпуса. Между крыльями остаётся двор 24 × 30 м, открытый на север. Высота пять этажей по 3,6 м, то есть 18 м. Размеры выбраны для иллюстрации и не относятся к реальному объекту; метод от них не зависит.</p>
    <p>Форма П-образного плана отличается от рассмотренных в блоге случаев. Прямоугольный жилой дом разобран в статье <a href="/blog/kran-dlya-zhilogo-doma-iz-treh-sekciy/">«Кран для жилого дома из трёх секций»</a>, Г-образная школа — в статье <a href="/blog/kran-dlya-shkoly-g-obraznoj-formy/">«Кран для школы Г-образной формы»</a>. У больницы появляется внутренний двор, куда кран можно поставить и откуда он достаёт до всех углов.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Потребная высота крюка равна высоте здания плюс 0,5 м запаса над препятствиями, высота груза и длина строп: 18 + 0,5 + 3 + 4 = 25,5 м. Запас 0,5 м взят из пункта 114 ФНП № 461; груз 3 м и стропы 4 м — допущения КРАН-КУБАНЬ, которые в проекте заменяют по самому высокому элементу, например по технологическому оборудованию крыши.</p>
    <p>Крюк 25,5 м проходят все модели парка. КБ-408.21 поднимает на 54,0–72,7 м (запас от +28,5 м), КБ-674А — до 60 м свободно (+34,5 м), Potain MCH 175 — до 58,5 м (+33,0 м), Potain MDT 219 J10 — до 70,4 м (+44,9 м). giraFFe SMK-5.66 с горизонтальной стрелой достаёт 27 м и проходит с запасом всего 1,5 м. Сравнение высот — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Стоянка S1 расположена во дворе, в точке (30; 24): на оси здания и на 6 м выше линии главного корпуса. Четыре внешних угла комплекса — (0; 0), (60; 0), (0; 48) и (60; 48) — отстоят от неё на одно и то же расстояние √(30² + 24²) = √1476 = 38,42 м. Симметрия делает расчёт простым: вылет для всех углов одинаков.</p>
    <p>Вылет 38,42 м перекрывают все пять моделей КРАН-КУБАНЬ. Запас у КБ-408.21 составляет +1,58 м, у giraFFe SMK-5.66 — +4,58 м, у КБ-674А — +12,08 м, у Potain MCH 175 — +16,58 м, у Potain MDT 219 J10 — +26,58 м. Минимальный запас у КБ-408.21 всего 1,58 м, поэтому точку на плане двора проверяют до подписания схемы. Вылеты по паспортам — в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Стоянка S2 расположена снаружи у южной стены главного корпуса: на оси, в 10 м от стены, в точке (30; −10). Ближний угол (0; 0) отстоит на √(30² + 10²) = 31,62 м, но дальние углы крыльев (0; 48) и (60; 48) — на √(30² + 58²) = √4264 = 65,30 м. Схема нужна, когда двор занят под склад или подъезд скорой помощи, и кран приходится ставить за пределы здания.</p>
    <p>Вылет 65,30 м не проходит ни одна модель. Potain MDT 219 J10 с вылетом 65 м не достаёт 0,30 м, Potain MCH 175 — 10,30 м, КБ-674А — 14,80 м, giraFFe SMK-5.66 — 22,30 м, КБ-408.21 — 25,30 м. Для MDT 219 J10 разница так мала, что сдвиг стоянки на 1–2 м вдоль оси к крыльям превращает отказ в запас; метод изложен в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Стоянка S3 расположена севернее открытой стороны двора, в 8 м от линии концов крыльев, в точке (30; 56). Дальние углы главного корпуса (0; 0) и (60; 0) отстоят на √(30² + 56²) = √4036 = 63,53 м, а концы крыльев — на 31,05 м. Разброс в 32 м показывает, что крыло и корпус разнесены по оси, и вылет определяет самый дальний угол.</p>
    <p>Вылет 63,53 м проходит только Potain MDT 219 J10 с запасом +1,47 м. Остальные модели КРАН-КУБАНЬ не достают: Potain MCH 175 уступает 8,53 м, КБ-674А — 13,03 м, giraFFe SMK-5.66 — 20,53 м, КБ-408.21 — 23,53 м. На максимальном вылете 65 м MDT 219 J10 поднимает 1,9 т, поэтому тяжёлые элементы дальнего корпуса подают с другой точки или другим краном: <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Двор 24 × 30 м даёт вылет 38,42 м, но кран, поставленный внутрь контура, нужно будет когда-то снять. Раскрытая северная сторона оставляет проход шириной 24 м, а замкнутый двор потребовал бы демонтажа до закрытия контура. Это вывод КРАН-КУБАНЬ из геометрии плана; порядок и размеры зон фиксирует ППР — <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«Проект производства работ с башенным краном»</a>.</p>
    <p>Для giraFFe SMK-5.66 с опорным контуром 4 × 4 м двор такого размера избыточен, а монтаж за 4–6 часов (по данным парка) упрощает ход, если кран нужен лишь на первые этажи. Для КБ-408.21 и Potain MDT 219 J10 основание выбирают по изысканиям: <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>. Демонтаж как работа — в статье <a href="/blog/demontazh-bashennogo-krana/">«Демонтаж башенного крана»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Расчёт КРАН-КУБАНЬ плоский: он не учитывает ограждение, воздушные линии, зону падения груза и действующие корпуса рядом. При стройке больницы на территории существующего медгородка стрела проходит над чужой крышей, и граница опасной зоны становится главным ограничением; порядок описан в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>
    <p>Тишину рядом с действующими палатами определяют закон Краснодарского края № 608-КЗ и нормы шума, разобранные в статьях <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a> и <a href="/blog/uroven-shuma-v-decibelah/">«Уровень шума в децибелах»</a>. КРАН-КУБАНЬ числовых ограничений не называет: часы и пределы берут из закона и условий разрешения на строительство. Сейсмичность площадки определяют по ТСН 22-302-2000 и картам районирования.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Сводка показывает расчёт КРАН-КУБАНЬ для условной больницы с потребным крюком 25,5 м. Запас — разность возможности модели и потребности; знак «−» означает, что кран не достаёт.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Крюк, запас к 25,5 м</th><th>Вылет</th><th>S1 во дворе (38,42 м)</th><th>S2 снаружи, юг (65,30 м)</th><th>S3 снаружи, север (63,53 м)</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>+28,5 м (от 54,0 м)</td><td>40 м</td><td>+1,58 м</td><td>−25,30 м</td><td>−23,53 м</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>+1,5 м (27 м)</td><td>43 м</td><td>+4,58 м</td><td>−22,30 м</td><td>−20,53 м</td></tr>
        <tr><td>КБ-674А</td><td>+34,5 м (до 60 м)</td><td>50,5 м</td><td>+12,08 м</td><td>−14,80 м</td><td>−13,03 м</td></tr>
        <tr><td>Potain MCH 175</td><td>+33,0 м (до 58,5 м)</td><td>до 55 м</td><td>+16,58 м</td><td>−10,30 м</td><td>−8,53 м</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>+44,9 м (до 70,4 м)</td><td>65 м</td><td>+26,58 м</td><td>−0,30 м</td><td>+1,47 м</td></tr>
      </tbody>
    </table></div>
    <p>Вывод таблицы: для П-образного плана сначала проверяют двор, и только при невозможности ставить кран внутрь переходят к наружным точкам, где остаётся одна модель. План больницы с размерами, этажностью и свободными зонами можно отправить через <a href="/#order">форму на главной</a>; КРАН-КУБАНЬ назовёт модель и точку. Цены и сроки зависят от площадки и здесь не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: высота крюка, вылет и грузоподъёмность пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, п. 114 (перемещение груза на 0,5 м выше препятствий)' },
      { href: 'https://kran-kuban.ru/blog/vysota-podema-bashennogo-krana-po-modelyam/', label: 'kran-kuban.ru — высота подъёма башенного крана по моделям' },
    ]} />
</BlogArticleLayout>
