---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 123. Сто пятнадцатая статья блога — угол (c) практический / региональный.
// Источник: smokk.ru/about/association-members/labinskiy-rayon (curl, проверено 29.10.2026).
// Факты источника: население 91 087 (01.01.2022) → 89 580 → 88 686 → 88 392 (01.01.2025);
// расчёт КРАН-КУБАНЬ: убыль за три года 91 087 − 88 392 = 2695 чел., 2695 / 91 087 = 2,96 % ≈ 3,0 %;
// по годам: −1507 (1,65 %), −894 (1,0 %), −294 (0,33 %); сумма 1507 + 894 + 294 = 2695;
// район в предгорной зоне северного склона Главного Кавказского хребта; соседи: Курганинский (север), Новокубанский и Отрадненский (восток),
// Мостовский и Кошехабльский район Адыгеи (запад), Карачаево-Черкесия (юг);
// сельхозугодья 148,8 тыс. га (= 1488 км²), пашня 105,2 тыс. га (= 1052 км²), доля пашни 105,2 / 148,8 = 70,7 %;
// хозяйства: 12 крупных сельхозпроизводителей, 295 КФХ, 15 335 ЛПХ; животноводство (молоко, мясо);
// 13 муниципальных образований (Лабинское городское + 12 сельских, список источника пересчитан);
// история: 02.06.1924 образован (Армавирский округ, центр — станица Лабинская), 8 сельсоветов; 1937 — Краснодарский край;
// 21.08.1939–22.08.1953 выделялся Упорненский район; 22.04.1962 вошли Псебайский и Ярославский районы; 11.02.1963–03.03.1964 входил Курганинский;
// 12.01.1965 город Лабинск — краевого подчинения (центр остаётся); 21.02.1975 образован Мостовский район; 1993 — сельские округа; 2005 — 13 МО.
// Площадь района, грунт, сейсмика, ветер в источнике НЕТ — не названы (плотность не считается). Названия предприятий не используются как реестр.
// Город Лабинск разобран отдельно (kran-dlya-labinska). Модели — только parkModels.ts.

const CHECKED = '29 октября 2026 года';
const PUBLISHED = '2026-10-29';

const title = 'Кран для Лабинского района: 88 392 жителя и 13 поселений';
const description = 'Предгорье Кавказа, 148,8 тыс. га угодий, пашня 105,2 тыс. га и убыль населения 3,0 % за три года по данным СМОКК. Какой башенный кран нужен району.';
const h1 = 'Какой башенный кран выбрать для объекта в Лабинском районе Краснодарского края?';
const crumbTitle = 'Кран для Лабинского района';
const slug = 'kran-dlya-labinskogo-rayona';

const H2 = [
  'Предгорье северного склона Кавказа и шесть соседей',
  '13 муниципальных образований вокруг Лабинска',
  '88 392 жителя: убыль замедлилась с 1507 до 294 человек в год',
  'Угодья 148,8 тыс. га и пашня 105,2 тыс. га',
  'История: от 8 сельсоветов до 13 поселений',
  'Переработка зерна, масла, сахара и молока: кому нужен кран',
  'Чего СМОКК не сообщает: грунт, ветер, сейсмика',
  'Порядок выбора башенного крана для Лабинского района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько жителей в Лабинском районе и как меняется население?',
    a: 'По данным СМОКК, на 1 января 2025 года в районе 88 392 жителя. На 1 января 2022 года было 91 087, убыль за три года — 2695 человек, около 3,0 %. Темп падает: минус 1507, затем минус 894 и минус 294 в последний год. Для застройщика это спрос на замену фонда, а не на массовое жильё.',
  },
  {
    q: 'Сколько муниципальных образований в Лабинском районе?',
    a: 'В районе 13 муниципальных образований: Лабинское городское и 12 сельских — Ахметовское, Владимирское, Вознесенское, Зассовское, Каладжинское, Лучевое, Отважненское, Первосинюхинское, Сладковское, Упорненское, Харьковское и Чамлыкское. КРАН-КУБАНЬ просит указывать поселение в заявке, потому что разрешения и обращения по закону № 608-КЗ рассматривает местная администрация.',
  },
  {
    q: 'Какая сейсмичность в Лабинском районе?',
    a: 'СМОКК балл сейсмичности не приводит, и КРАН-КУБАНЬ его не называет. Район лежит в предгорьях северного склона Главного Кавказского хребта, а расчётный балл для площадки определяют по ТСН 22-302-2000 и картам районирования, затем уточняют микрорайонированием. Метод изложен в статье КРАН-КУБАНЬ о сейсмическом микрорайонировании.',
  },
  {
    q: 'Чем Лабинский район отличается от города Лабинска?',
    a: 'Район — это 13 муниципальных образований вокруг центра, а город Лабинск с 1965 года относится к городам краевого подчинения и выведен из состава района, оставаясь его центром. Городская застройка разобрана в отдельной статье КРАН-КУБАНЬ. Здесь рассматриваются станицы, поля и перерабатывающие предприятия.',
  },
  {
    q: 'Какая модель подходит для элеватора или перерабатывающего завода в районе?',
    a: 'Для широкого низкого цеха хватает giraFFe SMK-5.66 или КБ-408.21, для высокого силосного объёма берут Potain MCH 175 до 58,5 м, КБ-674А до 60 м свободно или Potain MDT 219 J10 до 70,4 м. Решает форма здания и место стоянки; расчёты приведены в статьях КРАН-КУБАНЬ о силосном и производственном корпусах.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Предгорья Кавказа"
  published={PUBLISHED}
>
    <p slot="intro">Лабинский район лежит в предгорьях северного склона Главного Кавказского хребта, насчитывает 88 392 жителя на 1 января 2025 года и 13 муниципальных образований, а сельхозугодья занимают 148,8 тыс. га, из них 105,2 тыс. га пашни. Для башенного крана КРАН-КУБАНЬ это объекты переработки зерна, масла, сахара и молока, станичное жильё и социальные здания; грунт, ветер и сейсмику в предгорье определяют отдельно.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Район, по данным СМОКК, расположен в предгорной зоне северного склона Главного Кавказского хребта, и это отличает его природно-климатические условия от равнинных районов края. Границы КРАН-КУБАНЬ перечисляет по источнику: на севере — Курганинский район, на востоке — Новокубанский и Отрадненский, на западе — Мостовский район и Кошехабльский район Адыгеи, на юге — Карачаево-Черкесия.</p>
    <p>Шесть соседей — четыре района края, Адыгея и Карачаево-Черкесия — означают, что транспорт к объекту идёт с севера, а на юге площадки упираются в границу республики. Соседние районы края разобраны в статьях <a href="/blog/kran-dlya-kurganinskogo-rayona/">«Кран для Курганинского района»</a>, <a href="/blog/kran-dlya-novokubanskogo-rayona/">«Кран для Новокубанского района»</a>, <a href="/blog/kran-dlya-otradnenskogo-rayona/">«Кран для Отрадненского района»</a> и <a href="/blog/kran-dlya-mostovskogo-rayona/">«Кран для Мостовского района»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Муниципальных образований в Лабинском районе 13: Лабинское городское поселение и 12 сельских — Ахметовское, Владимирское, Вознесенское, Зассовское, Каладжинское, Лучевое, Отважненское, Первосинюхинское, Сладковское, Упорненское, Харьковское и Чамлыкское. КРАН-КУБАНЬ пересчитал список СМОКК, и он совпал с итогом 13.</p>
    <p>Администрация района находится в городе Лабинске, и в заявке на КРАН-КУБАНЬ нужно указывать поселение, а не только район: разрешения и обращения по закону № 608-КЗ рассматривает местная администрация. Город Лабинск с 1965 года относится к городам краевого подчинения, но остаётся центром района; его застройка разобрана в статье <a href="/blog/kran-dlya-labinska/">«Кран для Лабинска»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Население района, по данным СМОКК, сокращалось все три года: 91 087 человек на 1 января 2022 года, 89 580 на 1 января 2023, 88 686 на 1 января 2024 и 88 392 на 1 января 2025. Расчёт КРАН-КУБАНЬ: убыль за три года 91 087 − 88 392 = 2695 человек, около 3,0 %.</p>
    <p>По годам она шла так: минус 1507 человек (1,65 %), минус 894 (1,0 %) и минус 294 (0,33 %). Сумма 1507 + 894 + 294 = 2695 сошлась с итогом. По оценке КРАН-КУБАНЬ, это сигнал о ровном спросе: заменяют фонд, строят школы, склады и цеха, а потока нового жилья нет. Под такие объекты подходит весь парк от лёгкого giraFFe SMK-5.66 до КБ-674А; подход — в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Сельскохозяйственные угодья района, по данным СМОКК, занимают 148,8 тыс. га, из них пашня — 105,2 тыс. га. В квадратных километрах это 1488 и 1052 км²; расчёт КРАН-КУБАНЬ: пашня составляет 105,2 / 148,8 = 70,7 % угодий. Площадь района СМОКК не указывает, поэтому плотность населения здесь не считается.</p>
    <p>В агропромышленный комплекс района входят 12 крупных сельхозпроизводителей, 295 крестьянско-фермерских хозяйств и 15 335 личных подсобных хозяйств; значимая отрасль — животноводство, молоко и мясо. Для башенного крана это фон: станицы окружены полями, площадки открыты, а решение по ветру принимают по паспорту модели. Порядок работы Potain MDT 219 J10 и КБ-674А в ветер — в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Лабинский район образован 2 июня 1924 года в составе Армавирского округа Юго-Восточной области с центром в станице Лабинской и первоначально включал 8 сельских советов. С 13 сентября 1937 года он входит в Краснодарский край. С 21 августа 1939 по 22 августа 1953 года из его части выделялся Упорненский район.</p>
    <p>22 апреля 1962 года в состав района вошли упразднённые Псебайский и Ярославский районы, а с 11 февраля 1963 по 3 марта 1964 года в него входил Курганинский район. 12 января 1965 года город Лабинск вывели из состава района, 21 февраля 1975 года на части территории образован Мостовский район, в 1993 году прекратили работу сельские Советы, а в 2005 году образовали 13 муниципальных образований. Практический вывод КРАН-КУБАНЬ: в старых документах на землю названия и границы могут отличаться от нынешних, и это проверяют до заявки на монтаж.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>СМОКК перечисляет наиболее крупные промышленные предприятия района, и судя по названиям, это переработка масличных культур, сахара и молока, хлебозавод, элеватор и племенное хозяйство. КРАН-КУБАНЬ не использует эти названия как реестр заказчиков: для башенного крана важна не вывеска, а форма здания — широкий цех, склад или высокий силосный объём.</p>
    <p>Методика для двух типов объектов уже разобрана: низкий широкий склад — в статье <a href="/blog/kran-dlya-sklada-angara/">«Кран для склада-ангара»</a>, высокий силосный объём — в статье <a href="/blog/kran-dlya-silosnogo-korpusa/">«Кран для силосного корпуса»</a>, производственный корпус — в статье <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>. Для КБ-408.21 на длинном цехе важен рельсовый путь; сравнение — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>СМОКК не приводит площадь района, данные о грунтах, подземных водах, ветре и балле сейсмичности, и КРАН-КУБАНЬ эти значения не называет. Для предгорной зоны их получают на месте: изыскания дают грунт и воду, паспорт модели — предельный ветер, а балл сейсмичности определяют по ТСН 22-302-2000 и картам районирования с уточнением микрорайонированием.</p>
    <p>Практический вывод: основание под Potain MDT 219 J10, КБ-408.21 или КБ-674А закладывают в проект до выбора модели. Метод описан в статьях <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a> и <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>. Ограничения по шуму рядом с жильём вытекают из закона № 608-КЗ: <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Модель под объект в Лабинском районе КРАН-КУБАНЬ подбирает в четыре шага, начиная с типа здания. Порядок — практика инженерной службы, а не норма.</p>
    <ol>
      <li>Тип объекта: цех, склад, школа или жилой дом — на низкий корпус до 27 м по крюку подходит giraFFe SMK-5.66, на высокий объём — Potain MCH 175, КБ-674А или Potain MDT 219 J10.</li>
      <li>Основание: изыскания определяют, рельсовый путь, фундамент или опорный контур 4 × 4 м без фундамента; грунт района СМОКК не описывает, и его выясняют отдельно.</li>
      <li>Ветер и шум: предел определяет паспорт модели, часы работы — закон № 608-КЗ.</li>
      <li>Подвоз: маршрут трала от базы до поселения и точка разгрузки согласуются заранее.</li>
    </ol>
    <p>Адрес с названием поселения и размеры объекта можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и основание. Цены и сроки зависят от площадки и без исходных данных не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/labinskiy-rayon/', label: 'smokk.ru — Лабинский муниципальный район: население, география, история, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
