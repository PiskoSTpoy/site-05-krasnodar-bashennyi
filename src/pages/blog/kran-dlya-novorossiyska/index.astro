---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 89. Двадцать четвёртая статья блога — Новороссийск, крупнейший
// порт России на Цемесской бухте. Город уже дважды упоминался в блоге
// (норд-ост разобран отдельной статьёй «Кран во время норд-оста», ветровой
// рекорд боры — в статье «Инженерные изыскания перед монтажом крана»), но
// отдельного разбора экономики и застройки города до сих пор не было —
// недостающая часть, а не дублирование уже написанного про ветер.
//
// Экономический слой: АО «Новороссийский зерновой терминал» (входит в
// холдинг DeloPorts вместе с контейнерным терминалом НУТЭП) — расширение
// грузооборота с 7,2 до более чем 11 млн тонн к концу 2026 года, программа
// развития до 2028 года (новые причалы, ж/д инфраструктура). Второй якорь —
// ОАО «Верхнебаканский цементный завод» (ИНН 2315076504) в одноимённом
// посёлке в границах городского округа: запущен в 1965 году, градообразующее
// предприятие для посёлка Верхнебаканского, выручка 14,9 млрд рублей за
// 2025 год, с мая 2024 года под управлением АО «Газметаллпроект».
//
// Сейсмика для города отдельным запросом не подтвердилась: один вторичный
// источник (donstroyexpert.ru) называет 8 баллов, но сам сайт был заблокирован
// egress-прокси при попытке проверить цитату по первоисточнику (СП 14.13330
// / ТСН 22-302-2000), как и docs.cntd.ru и base.garant.ru — та же блокировка,
// что и в Волне 88. Без прямой цитаты первоисточника цифру в статью не
// включаем — та же честная развилка, что и в Волнах 76-80, 83-88.
// Норд-ост и флюгирование техники в статье не пересказываются — раздел
// ссылается на уже опубликованный разбор, а не дублирует его.

const CHECKED = '16 сентября 2026 года';

const title = 'Кран для Новороссийска: порт, зерновой терминал и цементный завод';
const description = 'Новороссийск — крупнейший порт России на Цемесской бухте: расширение зернового терминала DeloPorts и градообразующий Верхнебаканский цементный завод. Что это значит для монтажа башенного крана, помимо уже разобранного норд-оста.';
const h1 = 'Кран для Новороссийска: порт, зерновой терминал и цементный завод';
const crumbTitle = 'Кран для Новороссийска';
const slug = 'kran-dlya-novorossiyska';

const H2 = [
  'Новороссийск — крупнейший порт России на Цемесской бухте',
  'Зерновой терминал и НУТЭП: расширение под 11 миллионов тонн к 2026 году',
  'Верхнебаканский цементный завод: градообразующее предприятие с 1965 года',
  'Норд-ост уже разобран отдельно — здесь только ссылка',
  'Сейсмика: почему балл для площадки в статье не назван',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Кран в Новороссийске нужен только для порта и цементного завода?',
    a: 'Нет — это два самых заметных, но не единственных источника спроса. Город с населением свыше четверти миллиона человек в границах собственно Новороссийска ведёт обычную городскую застройку — жильё, торговые и социальные объекты, — а промышленная и портовая инфраструктура добавляет к этому отдельный поток объектов: расширение терминалов, реконструкцию цехов, монтаж технологического оборудования.',
  },
  {
    q: 'Норд-ост в Новороссийске останавливает работу крана чаще, чем в других городах края?',
    a: 'Да, и заметно чаще: по данным Гидрометцентра России, бора в Новороссийской бухте дует свыше 40 дней в году, преимущественно в холодный сезон, с отдельными эпизодами длиной от суток до недели. Это не паспортный предел техники по ветру, а отдельное региональное явление — подробный технический разбор (флюгирование стрелы, противоугонные захваты) в статье «Кран во время норд-оста».',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Новороссийска', item: `${SITE}/blog/kran-dlya-novorossiyska/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-novorossiyska/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-novorossiyska/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже дважды писал про Новороссийск мимоходом: статья «Инженерные изыскания перед монтажом крана» называет город рабочим примером ветровой нагрузки, а отдельный разбор «Кран во время норд-оста» раскладывает по шагам, что происходит со стрелой во время боры. Экономики и застройки самого города при этом не было — а именно она определяет, где в Новороссийске вообще нужен кран, помимо того, что там регулярно дует.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Новороссийск стоит на берегу Цемесской бухты Чёрного моря и остаётся крупнейшим торговым портом России по грузообороту. По данным Росстата на 1 января 2025 года, население собственно города составляло 261 973 человека; если считать весь городской округ вместе с посёлками и станицами в его границах, цифра превышает полмиллиона. Это делает Новороссийск одним из трёх крупнейших городов края наравне с Краснодаром и Сочи — но, в отличие от них, спрос здесь формирует не столица региона и не курорт, а порт и промышленность вокруг него.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Самый заметный проект последних лет — расширение АО «Новороссийский зерновой терминал»: по данным отраслевого издания PortNews, к концу 2026 года терминал планирует нарастить перевалку сельскохозяйственных грузов с уже достигнутых 7,2 до более чем 11 миллионов тонн в год. Рост обеспечивают несколько параллельных инвестиционных проектов — дополнительные мощности приёма груза с автомобильного и железнодорожного транспорта, расширение самого терминала и строительство новых причалов; отдельная программа развития рассчитана до 2028 года и включает железнодорожную инфраструктуру и наращивание складских мощностей. Терминал работает в составе стивидорного холдинга DeloPorts вместе с контейнерным терминалом НУТЭП — оба по итогам первого полугодия 2026 года подтвердили лидерство в своих сегментах рынка.</p>
    <p>Для арендодателя крана площадка портового расширения — задача, отличная от разовой стройки: несколько объектов на одной территории (новые причалы, складские корпуса, эстакады подачи груза) означают растянутый во времени спрос, а не один пик монтажа.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Второй промышленный якорь города стоит не у воды, а в посёлке Верхнебаканском в границах Новороссийского городского округа — ОАО «Верхнебаканский цементный завод» (ИНН 2315076504). Производство запущено в 1965 году, и завод официально числится градообразующим предприятием посёлка: по данным открытых реестров, выручка компании за 2025 год составила 14,9 миллиарда рублей, а штат за последний год вырос с 671 до 730 сотрудников — рост числа занятых обычно сопровождает расширение операционной деятельности, а не её сворачивание. С мая 2024 года управление предприятием передано управляющей организации АО «Газметаллпроект». Для монтажа техники такой объект — это не точечная стройка, а действующее производство с полувековой историей, где кран чаще нужен под реконструкцию и модернизацию конкретных цехов и линий, чем под возведение завода с нуля.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Главный фактор, который делает монтаж крана в Новороссийске непохожим на монтаж в любом другом городе края, — не порт и не завод, а ветер. Местная бора (норд-ост) дует, по данным Гидрометцентра России, свыше 40 дней в году, преимущественно в холодный сезон, с зафиксированными порывами до 60 м/с на рейде и историческим рекордом 80 м/с на Маркотхском перевале в 1928 году. Мы уже разбирали это явление отдельной статьёй — что физически происходит со стрелой крана во время боры, почему её не блокируют, а, наоборот, отпускают в свободный поворот, и зачем рельсовому ходу нужны противоугонные захваты, — в статье <a href="/blog/kran-vo-vremya-nord-osta/" style="color:var(--accent)">«Кран во время норд-оста: флюгирование и противоугонные захваты»</a>. Здесь этот разбор не повторяем: для планирования графика в Новороссийске важно просто помнить, что резерв на простой закладывается не на часы, а на дни, — подробнее на этапе <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении. Для Новороссийска в открытой выдаче встретился один вторичный источник с цифрой 8 баллов, но подтвердить её прямой цитатой из самого свода правил или ТСН не удалось: прямой доступ к первоисточникам (docs.cntd.ru, base.garant.ru) и к самому вторичному источнику был заблокирован сетевым egress сессии. Называть цифру без подтверждения из первоисточника мы не считаем правильным, поэтому в этой статье балл сейсмичности площадки не приведён — заказчику стоит уточнять его отдельно на этапе инженерных изысканий, как и описано в статье «Инженерные изыскания перед монтажом крана».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины действует в Новороссийске так же, как в Краснодаре или на курортном побережье: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с двухчасовым дневным перерывом, а в выходные и праздничные дни утренняя граница сдвинута до 10:00. Статус портового и промышленного города здесь ничего не меняет: норма одна на весь край. Подробный разбор часов и сумм штрафов по статье 3.3 — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <ul>
      <li>Новороссийск — крупнейший торговый порт России на Цемесской бухте, население собственно города — 261 973 человека (2025), с городским округом — свыше полумиллиона.</li>
      <li>Зерновой терминал холдинга DeloPorts (вместе с контейнерным терминалом НУТЭП) расширяется с 7,2 до более чем 11 млн тонн грузооборота в год к концу 2026 года, программа развития рассчитана до 2028 года.</li>
      <li>Верхнебаканский цементный завод (ИНН 2315076504) — градообразующее предприятие посёлка Верхнебаканского с 1965 года, выручка 14,9 млрд рублей за 2025 год, штат вырос до 730 человек.</li>
      <li>Норд-ост — главный местный фактор для графика монтажа: свыше 40 дней простоя в году, технический разбор — в отдельной статье «Кран во время норд-оста».</li>
      <li>Балл сейсмичности площадки в статье сознательно не назван — прямых источников подтвердить его не удалось; уточняется отдельно на этапе изысканий.</li>
      <li>Закон №608-КЗ о тишине действует в Новороссийске так же, как во всём крае.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.kommersant.ru/doc/7604147', label: 'kommersant.ru — население Новороссийска превысило 500 тысяч человек в границах городского округа' },
      { href: 'https://ru.wikipedia.org/wiki/Новороссийск', label: 'ru.wikipedia.org — Новороссийск: география, Цемесская бухта, статус крупнейшего порта' },
      { href: 'https://portnews.ru/news/372927/', label: 'portnews.ru — Новороссийский зерновой терминал: рост грузооборота до 11 млн тонн к концу 2026 года' },
      { href: 'https://www.nutep.ru/', label: 'nutep.ru — контейнерный терминал НУТЭП, холдинг DeloPorts' },
      { href: 'https://zachestnyibiznes.ru/company/ul/1022302385808_2315076504_OAO-VERHNEBAKANSKIY-CEMENTNYY-ZAVOD', label: 'zachestnyibiznes.ru — ОАО «Верхнебаканский цементный завод», ИНН 2315076504: реквизиты, выручка, штат' },
      { href: 'https://www.rusprofile.ru/id/2980810', label: 'rusprofile.ru — ОАО «Верхнебаканский цементный завод»: адрес, посёлок Верхнебаканский' },
      { href: 'https://meteoinfo.ru/glossary/4652-2012-02-11-09-58-19', label: 'Гидрометцентр России — боры Новороссийской бухты: свыше 40 дней в году' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
