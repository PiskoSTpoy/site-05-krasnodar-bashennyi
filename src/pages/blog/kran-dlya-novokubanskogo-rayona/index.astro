---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 100. Сорок шестая статья блога — угол (c) практический/региональный.
// Новокубанский район — восток края, сосед уже разобранной промзоны Армавира
// (Волна ранняя), но со своим профилем: сахар, керамический кирпич и глубокая
// переработка зерна, а не машиностроение Армавира.
//
// Фактура — только проверенная 29.09.2026 (WebSearch):
// - Новокубанск на реке Кубань, рядом с Армавиром, ~207–218 км от Краснодара
//   по трассе (проложить-маршрут.рф, rudorogi.ru);
// - промышленность: сахарный завод и Новокубанский завод керамических стеновых
//   материалов (НЗКСМ); с/х предприятия КСП «Хуторок», КСП «Кубань», ОПХ ПЗ
//   «Ленинский путь»; «Прогресс-Агро» — глубокая переработка зерна
//   (business-kuban.ru, novokubanskiy.ru, progressagro.com);
// - название от реки Кубань: село Кубанское + пос. Хуторок → Новокубанск (wiki).
// Балл сейсмичности конкретного района НЕ называю (конвенция с Волны 79):
//   объясняю, откуда его берут — ОСР-2015 + ТСН 22-302-2000 + СМР по проекту.
// Закон о тишине №608-КЗ — в редакции с 1 марта 2026 (как в статьях-соседях).

const CHECKED = '29 сентября 2026 года';
const PUBLISHED = '2026-09-29';

const title = 'Кран для Новокубанского района: башенный кран у Армавира';
const description = 'Новокубанск на Кубани в ~210 км от Краснодара у Армавира: сахарный завод, кирпич и переработка зерна. Где хватит быстромонтируемого крана, а где классический.';
const h1 = 'Кран для Новокубанского района: башенный кран на востоке Кубани у Армавира';
const crumbTitle = 'Кран для Новокубанского района';
const slug = 'kran-dlya-novokubanskogo-rayona';

const H2 = [
  'Новокубанский район: где нужен башенный кран',
  'Промзона: сахар, керамический кирпич и зерно',
  'Жильё Новокубанска и быстромонтируемый кран',
  'Грунт у Кубани и балл сейсмичности',
  'Доставка крана и закон о тишине',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Нужен ли башенный кран в Новокубанском районе или хватит автокрана?',
    a: 'Для четырёх-пятиэтажного жилья и коротких строек в Новокубанске обычно хватает быстромонтируемого крана giraFFe SMK-5.66 или автокрана. Башенный кран КРАН-КУБАНЬ нужен там, где здание выше или объект длинный: цеха и склады сахарного завода, элеваторные ёмкости, многоэтажные дома. Границу определяют по высоте и вылету, а не по статусу стройки.',
  },
  {
    q: 'Сколько километров от Краснодара до Новокубанска для доставки крана?',
    a: 'Новокубанск находится примерно в 207–218 км от Краснодара по автодороге, на реке Кубань рядом с Армавиром. КРАН-КУБАНЬ закладывает это плечо в доставку крана и монтажного автокрана: для быстромонтируемого giraFFe SMK-5.66 это один рейс, для классического крана — несколько рейсов с секциями мачты и противовесом.',
  },
  {
    q: 'Какой балл сейсмичности у Новокубанска для расчёта крана?',
    a: 'Балл берут не «по городу вообще», а из карт ОСР-2015 для нужного уровня ответственности и уточняют сейсмическим микрорайонированием площадки. Требования к сейсмостойкому строительству в крае задаёт ТСН 22-302-2000 вместе с СП 14.13330.2018. КРАН-КУБАНЬ опирается на балл из проекта конкретного объекта, а не называет цифру для района в целом.',
  },
  {
    q: 'Какой кран подойдёт для сахарного завода или склада в Новокубанске?',
    a: 'Для протяжённых цехов и складов сахарного завода или керамического производства подходит кран на рельсовом пути КБ-408.21: он идёт вдоль объекта и закрывает всю длину. Для высотных ёмкостей и элеваторных конструкций КРАН-КУБАНЬ предлагает Potain MDT 219 J10 с вылетом 65 м или приставной КБ-674А. Выбор делают по высоте и вылету до дальней точки.',
  },
  {
    q: 'Действует ли закон о тишине в Новокубанске?',
    a: 'Да, закон Краснодарского края №608-КЗ действует во всём крае, включая Новокубанский район. С 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни; промзона вдали от домов планируется свободнее.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Новокубанский район"
  published={PUBLISHED}
>
    <p slot="intro">Новокубанский район лежит на реке Кубань рядом с Армавиром, примерно в 210 км восточнее Краснодара, и башенный кран здесь нужен на промышленных объектах и высоком жилье, а не на каждой стройке. Для сахарного завода, керамического производства и переработки зерна КРАН-КУБАНЬ подбирает классический кран, для коротких домов хватает быстромонтируемого giraFFe SMK-5.66.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Новокубанск стоит на реке Кубань, от которой и получил имя: село Кубанское и посёлок Хуторок в конце XIX века слились в одно крупное село, ставшее позже Новокубанском. Город лежит рядом с Армавиром, промзону которого КРАН-КУБАНЬ уже разбирал, но профиль у района свой — сахар, керамический кирпич и переработка зерна, а не машиностроение. От Краснодара до Новокубанска по автодороге около 207–218 км, и это плечо доставки инженерная служба КРАН-КУБАНЬ учитывает при расчёте монтажа.</p>
    <p>Башенный кран в Новокубанском районе оправдан не везде, а там, где здание выше потолка автокрана или объект слишком длинный для одной стоянки. Промышленные корпуса, склады и элеваторные ёмкости — это высота и вылет, ради которых ставят башенный кран КРАН-КУБАНЬ; частный сектор и невысокое жильё чаще закрывает автокран. Границу между ними определяют высотой крюка и вылетом до дальней точки, как в статье <a href="/blog/bashennyi-kran-ili-avtokran/">«Башенный кран или автокран»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Промышленность Новокубанского района держится на трёх опорах: сахарный завод, Новокубанский завод керамических стеновых материалов и глубокая переработка зерна. Сахарное производство и керамический цех — это протяжённые корпуса и склады, где груз нужно подавать вдоль всей длины здания. Для такой геометрии КРАН-КУБАНЬ предлагает кран на рельсовом пути КБ-408.21: он перемещается вдоль объекта и закрывает длину, которую башенный кран на фундаменте достаёт только вылетом.</p>
    <p>Зерновая переработка и элеваторные ёмкости добавляют второй сценарий — высоту. Группа «Прогресс-Агро» развивает в районе глубокую переработку зерна, а высокие силосы и башни требуют крана, который поднимает груз выше типового этажа. Здесь КРАН-КУБАНЬ ставит Potain MDT 219 J10 с вылетом 65 м или приставной КБ-674А с анкеровкой к возводимой конструкции. Выбор между «длиной» и «высотой» инженерная служба КРАН-КУБАНЬ делает по чертежу объекта: рельсовый путь для протяжённых цехов, высотный кран для ёмкостей.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Жилая застройка Новокубанска — это в основном малоэтажные и среднеэтажные дома, и для них тяжёлый башенный кран чаще избыточен. Короткий дом на стеснённой площадке в центре закрывает быстромонтируемый giraFFe SMK-5.66: опорный контур 4×4 м без фундамента, монтаж за 4–6 часов и один рейс доставки на 210 км. КРАН-КУБАНЬ выбирает эту модель там, где разворачивать месячный цикл монтажа классического крана невыгодно.</p>
    <p>Классический башенный кран в жилье Новокубанска нужен на многоэтажных домах, где giraFFe SMK-5.66 упирается в предел высоты. Тогда КРАН-КУБАНЬ переходит к Potain MDT 219 J10 или КБ-408.21 с наращиванием секций мачты. Как высота крюка, вылет и груз связаны с выбором модели, разобрано в статьях <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a> и <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Грунт под кран в Новокубанске задаёт близость реки Кубань: в пойме и на низких террасах несущая способность и уровень грунтовых вод отличаются от плотных участков в стороне от реки. Фундамент или рельсовый путь под кран КРАН-КУБАНЬ рассчитывают по инженерно-геологическим изысканиям конкретной площадки, а не по средним данным района. Что входит в изыскания перед монтажом, показано в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Балл сейсмичности для Новокубанского района КРАН-КУБАНЬ не называет одной цифрой: его берут из комплекта карт ОСР-2015 под нужный уровень ответственности объекта и уточняют сейсмическим микрорайонированием площадки. Требования к сейсмостойкому строительству в крае задают ТСН 22-302-2000 и СП 14.13330.2018. Инженерная служба КРАН-КУБАНЬ опирается на балл из проекта конкретного объекта; как устроено микрорайонирование, разобрано в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Доставка крана в Новокубанск — это около 207–218 км от Краснодара по автодороге, и число рейсов зависит от модели. Быстромонтируемый giraFFe SMK-5.66 КРАН-КУБАНЬ везёт одним рейсом и монтирует за смену; классический КБ-408.21 или Potain MDT 219 J10 требуют нескольких рейсов с секциями мачты, стрелой и противовесом плюс монтажный автокран на площадке. Плечо доставки инженерная служба КРАН-КУБАНЬ закладывает в смету отдельной строкой.</p>
    <p>Закон Краснодарского края №608-КЗ действует в Новокубанском районе так же, как в Краснодаре: с 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни, и срок аренды считают от них; промзона сахарного или керамического завода вдали от домов планируется свободнее — подробно в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>
    <p>Адрес объекта в Новокубанском районе и чертёж можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ предложит модель, основание и график доставки под вашу площадку.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'http://www.business-kuban.ru/novokubanskiy-rayon', label: 'business-kuban.ru — Новокубанский район: сахарный завод, завод керамических стеновых материалов, сельхозпредприятия' },
      { href: 'https://novokubanskiy.ru/administratsiya/selhos/predpr/', label: 'novokubanskiy.ru — сельскохозяйственные предприятия Новокубанского района' },
      { href: 'https://ru.wikipedia.org/wiki/Новокубанск', label: 'ru.wikipedia.org — Новокубанск: расположение на реке Кубань, происхождение названия (село Кубанское + Хуторок)' },
      { href: 'https://docs.cntd.ru/document/1200035102', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
      { href: 'https://www.kubzsk.ru/', label: 'kubzsk.ru — Законодательное Собрание Краснодарского края: закон №608-КЗ «Об административных правонарушениях» (режим тишины)' },
    ]} />
</BlogArticleLayout>
