---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 118. Девяносто восьмая статья блога — угол (a) информационный / how-to.
// Порядок подъёма и перемещения груза башенным краном по ФНП № 461: пп. 114–116, 129
// (+ ссылка на п. 123 — связь при высоте более 36 м, разобрано в статье о рации).
// Тема не пересекается с «Строповкой» (выбор стропов) и «ППР» (общий состав документа):
// здесь только действия крановщика и стропальщика с уже зацепленным грузом.
//
// Фактура — сырой текст приказа Ростехнадзора от 26.11.2020 № 461 (legalacts.ru, curl,
// проверено 23.10.2026):
// п. 114 — подъём начинается с высоты не более 0,2–0,3 м и остановки для проверки
// строповки и тормоза; запрещено перемещать груз над людьми; стропальщик возле груза
// допускается при высоте подъёма не более 1 м; мелкоштучные грузы — только в таре (кирпич на
// поддонах без ограждения — только при погрузке/разгрузке на землю); запрет подъёма груза
// неизвестной массы; горизонтальное перемещение на 0,5 м выше препятствий; опускание только
// на предназначенное место, подкладки для извлечения стропов; перерыв и конец работ — без
// груза на крюке, кран в безопасном нерабочем положении; кантовка — на кантовальных
// площадках или на весу по ППР; при кантовке стропальщик сбоку на расстоянии «высота груза
// плюс 1 м», кантовка грузов более 75 % паспортной грузоподъёмности и грузов со смещённым
// центром тяжести — только под руководством ИТР;
// п. 115 — 18 запретов (перечень разобран в таблице); п. 116 — разворот руками при высоте
// груза не более 1 м, иначе оттяжки или багры; п. 129 — запрет находиться между грузом и
// стеной/колонной/штабелем/вагоном при подъёме, опускании и перемещении.
// Расчёты КРАН-КУБАНЬ: 75 % от максимумов по parkModels.ts — 10 т → 7,5 т; 12,5 т → 9,375 т
// (≈9,4 т); 5 т → 3,75 т; пример кантовки: груз 2,4 м → 2,4 + 1 = 3,4 м; пример трассы:
// препятствие 3,2 м → низ груза не ниже 3,7 м.
// НЕ названо: штрафы, сроки, цены; конкретные требования к стропам (тема другой статьи).

const CHECKED = '23 октября 2026 года';
const PUBLISHED = '2026-10-23';

const title = 'Подъём груза башенным краном: порядок и запреты по ФНП';
const description = 'Подъём начинают с 0,2–0,3 м и остановки на проверку строповки; под грузом людей быть не должно. Порядок и 18 запретов по пп. 114–116 ФНП № 461.';
const h1 = 'Как правильно поднимать груз башенным краном: порядок и запреты по ФНП';
const crumbTitle = 'Подъём груза башенным краном по ФНП';
const slug = 'podem-gruza-bashennym-kranom-po-fnp';

const H2 = [
  'Пробный подъём на 0,2–0,3 м: первое действие с грузом',
  'Где может стоять стропальщик: правило 1 метра',
  'Трасса и посадка: 0,5 м над препятствиями',
  '18 запретов пункта 115: что нельзя делать при работе крана',
  'Разворот груза: руками до 1 м, выше — оттяжки и багры',
  'Кантовка груза: 75 % грузоподъёмности и расстояние «высота плюс 1 м»',
  'Работа у стены, перерыв и конец смены',
  'Памятка прорабу: как проверить подъём на площадке',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'На какую высоту поднимают груз при пробном подъёме?',
    a: 'На 0,2–0,3 м от земли с обязательной остановкой. Требование содержится в пункте 114 ФНП № 461: за паузу проверяют правильность строповки и действие тормоза. КРАН-КУБАНЬ рекомендует делать эту паузу при каждом новом грузе, а не один раз за смену.',
  },
  {
    q: 'Можно ли находиться под поднятым грузом?',
    a: 'Нельзя. Пункт 114 ФНП запрещает перемещать груз при нахождении под ним людей. Единственное допущение — стропальщик возле груза во время его подъёма или опускания, если груз поднят не выше 1 м от уровня площадки. Под стрелой при её подъёме и опускании людям находиться тоже запрещено (пункт 115).',
  },
  {
    q: 'Можно ли разворачивать груз руками?',
    a: 'Можно, только пока груз поднят не выше 1 м, — так сказано в пункте 116 ФНП. На большей высоте, а также при развороте длинномерных грузов, разворачивают оттяжками или баграми. Выравнивать уже перемещаемый груз руками пункт 115 запрещает полностью.',
  },
  {
    q: 'Можно ли поднимать груз, вес которого неизвестен?',
    a: 'Нельзя: пункт 114 ФНП прямо запрещает подъём груза, масса которого неизвестна. Для бетонных изделий массу берут из маркировки или паспорта изделия, для сборной арматуры — из спецификации. КРАН-КУБАНЬ советует сверять массу с грузовой характеристикой крана на нужном вылете.',
  },
  {
    q: 'Что делать с грузом при перерыве в работе крана?',
    a: 'Опустить на землю: при перерыве и по окончании работ на грузозахватном органе не должно быть подвешенного груза (пункт 114 ФНП). Кран по окончании работ приводят в безопасное нерабочее положение по руководству по эксплуатации — для каждой модели оно своё.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Работа крана"
  published={PUBLISHED}
>
    <p slot="intro">Каждый подъём груза башенным краном начинается с остановки на высоте 0,2–0,3 м: за эту паузу проверяют строповку и тормоз — так требует пункт 114 ФНП № 461. КРАН-КУБАНЬ разобрал порядок действий крановщика и стропальщика по пунктам 114–116 и 129: высоты, расстояния, 18 запретов и случаи, когда груз можно трогать руками.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пробный подъём — первое действие с зацепленным грузом: его поднимают на 0,2–0,3 м и останавливают. Пункт 114 ФНП № 461 называет цель паузы прямо: проверить правильность строповки и надёжность действия тормоза. Крановщик башенного крана КРАН-КУБАНЬ видит груз сверху и сбоку, а перекос стропа или недожатый зажим заметнее с земли, поэтому оценку делает стропальщик.</p>
    <p>Пауза на башенном кране КРАН-КУБАНЬ занимает секунды, а ошибка, найденная на высоте 0,3 м, обходится дешевле, чем на высоте этажа. Для кранов Potain MDT 219 J10 и КБ-408.21 с грузами до 10 т тормоз лебёдки проверяют этим же подъёмом, без отдельной операции. Выбор самих стропов разобран в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Стропальщику разрешено стоять возле груза при подъёме или опускании только тогда, когда груз поднят не выше 1 м от уровня площадки, — это допущение пункта 114 ФНП. На площадках КРАН-КУБАНЬ над людьми груз перемещать нельзя вообще: запрет безусловный, никаких «короткого прохода» норма не знает. КРАН-КУБАНЬ добавляет к норме практическое правило: после отрыва груза выше 1 м стропальщик отходит и подаёт команды с безопасного места.</p>
    <p>Пункт 115 расширяет запрет для крановщиков КРАН-КУБАНЬ: людям нельзя находиться под стрелой при её подъёме и опускании, с грузом и без груза, а также там, где возможно зажатие между частями крана и конструкциями. Для башенного крана на рельсовом пути это ещё и зона между хвостовой частью и ограждением. Границы опасной зоны считают отдельно — в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Крановщик КРАН-КУБАНЬ выполняет горизонтальное перемещение груза на 0,5 м выше встречающихся на пути предметов — норма пункта 114 ФНП. Если на трассе стоит штабель или опалубка высотой 3,2 м, низ груза должен пройти не ниже 3,7 м. Высоту считают от нижней точки груза, а не от крюка, поэтому длинные стропы добавляют к расчёту ту самую длину, о которой на площадке часто забывают.</p>
    <p>КРАН-КУБАНЬ опускает груз только на место, где исключены падение, опрокидывание и сползание. Чтобы вытащить стропы из-под груза, его кладут на подкладки достаточной прочности и толщины, а штабель укладывают с соблюдением габаритов складирования, не загромождая проходы. Мелкоштучные грузы поднимают только в таре: кирпич на поддонах без ограждения разрешён лишь при погрузке и разгрузке транспорта на землю и с земли.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пункт 115 ФНП № 461 перечисляет 18 запретов при работе подъёмных сооружений. Часть относится к подъёмникам и вышкам, поэтому КРАН-КУБАНЬ сгруппировал только те пункты, которые применимы к башенному крану, и указал, кто контролирует исполнение. Группировка — работа инженерной службы, формулировки запретов — из текста приказа.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Группа</th><th>Запрещено по пункту 115</th><th>Кто контролирует</th></tr></thead>
      <tbody>
        <tr><td>Состояние груза</td><td>Перемещать груз в неустойчивом положении или на одном роге двурогого крюка; поднимать груз, засыпанный землёй, примёрзший, закреплённый болтами или залитый бетоном</td><td>Стропальщик</td></tr>
        <tr><td>Способ работы</td><td>Подтаскивать груз по земле при наклонных канатах; освобождать краном защемлённые стропы; оттягивать груз при подъёме и опускании; выравнивать груз руками и менять положение стропов на весу</td><td>Крановщик и стропальщик</td></tr>
        <tr><td>Люди</td><td>Находиться в местах возможного зажатия; быть под стрелой при её подъёме и опускании; включать механизмы при людях на поворотной платформе вне кабины; перевозить людей в таре</td><td>ИТР, ответственный за безопасное производство работ</td></tr>
        <tr><td>Защита крана</td><td>Работать при отключённых или неработоспособных ограничителях, регистраторах, указателях и тормозах; использовать ограничители как рабочие органы остановки</td><td>Крановщик, механик</td></tr>
        <tr><td>Проёмы</td><td>Подавать груз в оконные проёмы, на балконы и лоджии без приёмных площадок или приспособлений</td><td>Прораб</td></tr>
      </tbody>
    </table></div>
    <p>Отдельный запрет касается ограничителей: у КРАН-КУБАНЬ работа крана КБ-674А или MCH 175 с отключённым ограничителем грузоподъёмности не допускается ни на минуту, даже «для проверки». Какие приборы обязаны быть на башенном кране, перечислено в статье <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>В работе КРАН-КУБАНЬ разворот груза руками допускается только при высоте подъёма не более 1 м; в остальных случаях, включая длинномерные грузы, используют оттяжки или багры, — требование пункта 116 ФНП № 461. Пункт 115 при этом запрещает оттягивать груз во время подъёма, перемещения и опускания, кроме разворота длинномерных и крупногабаритных грузов оттяжками. Два пункта читаются вместе: оттяжка — это инструмент разворота, а не способ подтянуть груз к месту.</p>
    <p>КРАН-КУБАНЬ рекомендует для длинных плит и арматурных пакетов брать оттяжки длиннее габарита груза, чтобы стропальщик оставался вне зоны возможного падения. Расчёт длины оттяжки в приказе не приводится — это решение ППР и технологической карты, описанных в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«Проект производства работ»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Кантовка груза с помощью башенного крана КРАН-КУБАНЬ разрешена только на кантовальных площадках или на весу, по заранее разработанному ППР или технологической документации (пункт 114 ФНП). Стропальщик при кантовке стоит сбоку от груза на расстоянии, равном высоте груза плюс 1 м, и никогда между грузом и стеной. Для груза высотой 2,4 м безопасное расстояние составляет 3,4 м.</p>
    <p>Грузы массой более 75 % паспортной грузоподъёмности и грузы со смещённым центром тяжести кантуют только под руководством инженерно-технического работника, ответственного за безопасное производство работ. Пороги по моделям парка рассчитаны КРАН-КУБАНЬ от максимальной грузоподъёмности:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель парка</th><th>Максимальная грузоподъёмность</th><th>75 % от максимума</th></tr></thead>
      <tbody>
        <tr><td>Potain MDT 219 J10</td><td>10 т</td><td>7,5 т</td></tr>
        <tr><td>Potain MCH 175</td><td>10 т</td><td>7,5 т</td></tr>
        <tr><td>КБ-674А</td><td>12,5 т</td><td>≈9,4 т</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>5 т</td><td>3,75 т</td></tr>
      </tbody>
    </table></div>
    <p>ФНП не уточняет, брать ли максимальную грузоподъёмность или значение на текущем вылете. КРАН-КУБАНЬ рекомендует считать порог от грузовой характеристики на конкретном вылете: на вылете 50 м допустимый груз у любой модели ниже максимума, и порог в 75 % наступает раньше. Как читать такую таблицу — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>При подъёме груза краном, стоящим вблизи стены, колонны, штабеля, вагона или станка, нельзя находиться между грузом и этой преградой, — пункт 129 ФНП № 461 распространяет запрет на подъём, опускание и перемещение. Для башенного крана КРАН-КУБАНЬ рядом с возводимым зданием это значит, что стропальщик принимает груз на перекрытии только с открытой стороны, а не в углу между плитой и стеной.</p>
    <p>При перерыве и по окончании работ на крюке не должно висеть груза, а кран ставят в безопасное нерабочее положение согласно руководству по эксплуатации (пункт 114). Конкретное положение стрелы и порядок остановки у каждой модели парка свои, поэтому их берут из паспорта и руководства. Если здание выше 36 м, добавляется двусторонняя радио- или телефонная связь по пункту 123: подробности — в статье <a href="/blog/raciya-ili-signalshchik-na-bashennom-krane/">«Рация или сигнальщик на башенном кране»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Прораб заказчика КРАН-КУБАНЬ может проверить соблюдение пунктов 114–116 за один обход площадки по пяти вопросам. Список составлен инженерной службой КРАН-КУБАНЬ как рекомендация, а не как норма ФНП: каждый вопрос опирается на конкретный пункт приказа.</p>
    <ol>
      <li>Делает ли крановщик остановку на 0,2–0,3 м перед каждым новым грузом (п. 114).</li>
      <li>Стоит ли стропальщик вне зоны под грузом и выше ли груз 1 м, когда он отходит (п. 114, 116).</li>
      <li>Известна ли масса груза и есть ли на трассе препятствия выше уровня на 0,5 м (п. 114).</li>
      <li>Исправны ли ограничители, регистраторы, указатели и тормоза у крана (п. 115).</li>
      <li>Есть ли оттяжки или багры для разворота и приёмные площадки для подачи груза в проёмы (п. 115, 116).</li>
    </ol>
    <p>Для расчёта модели крана и места стоянки под конкретный объект отправьте адрес и размеры здания через <a href="/#order">форму на главной</a>. Кто допускается на площадку, когда кран работает, описано в статье <a href="/blog/kto-mozhet-byt-na-montazhnoy-ploshchadke-bashennogo-krana/">«Кто может быть на монтажной площадке»</a>.</p>

