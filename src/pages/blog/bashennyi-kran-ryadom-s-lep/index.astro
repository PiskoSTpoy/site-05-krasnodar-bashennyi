---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 111. Семьдесят седьмая статья блога — угол (a) информационный/how-to.
// Башенный кран рядом с воздушной линией электропередачи: расстояния до проводов,
// наряд-допуск, согласование с владельцем линии. На сайте тема ЛЭП до этой
// статьи не разбиралась (в других статьях линия упомянута вскользь).
//
// Фактура — сырой текст ФНП № 461 (legalacts.ru, curl, ред. 16.04.2026),
// проверено 13.10.2026, пункты сверены по тексту, не по пересказам:
// - п. 107: кран на рельсовом пути в охранной зоне ВЛ — установка согласуется
//   с владельцем линии; согласование хранится вместе с ППР;
// - п. 112: установка и работа кранов стрелового типа, манипуляторов, подъёмников
//   на расстоянии менее 30 м от крайнего провода ВЛ напряжением более 50 В —
//   только по наряду-допуску; в охранной зоне наряд выдаётся только при
//   разрешении организации, эксплуатирующей линию; наряд выдаётся крановщику
//   перед работой, сведения — в журнал выдачи нарядов-допусков; работа под
//   непосредственным руководством ИТР, запись о разрешении в вахтенный журнал;
//   время действия наряда определяет выдавшая организация;
// - п. 113: на действующих электростанциях, подстанциях и линиях наряд выдаёт
//   эксплуатирующая организация, расстояние по воздуху — не менее приложений 1 и 2;
// - приложение № 1, таблица 3: минимальное расстояние от стрелы ПС во время
//   работы до проводов под напряжением: до 1 кВ — 1,5 м; 1–35 — 2,0; 35–110 — 3,0;
//   110–220 — 4,0; 220–400 — 5,0; 400–750 — 9,0; 750–1150 — 10,0;
// - приложение № 2, таблица 2: границы зон опасности поражения током от
//   механизмов и ПС в рабочем и транспортном положении: до 1 кВ — 1,0 м;
//   1–35 — 1,0; 60 и 110 — 1,5; 150 — 2,0; 220 — 2,5; 330 — 3,5; 400 и 500 — 4,5;
//   750 — 6,0; 1150 — 10,0;
// - п. 266 и приложение № 9: проверка ограничителя опасного приближения к ЛЭП
//   по макету линии 220/380 В на высоте не менее 6 м, ограничительный канат 1,5 ± 0,1 м.
// Оговорка: п. 112 по тексту относится к кранам «стрелового типа»; башенный кран
// там поимённо не назван. Это сказано в статье, а применение наряда-допуска к
// башенным кранам КРАН-КУБАНЬ помечено как рабочее правило. Размер охранной зоны
// задан не ФНП (а Правилами охраны электрических сетей) — цифры не приводятся.

const CHECKED = '13 октября 2026 года';
const PUBLISHED = '2026-10-13';

const title = 'Башенный кран рядом с ЛЭП: расстояния и наряд-допуск';
const description = 'От стрелы до провода 110 кВ — не ближе 3 м, а в 30 м от линии нужен наряд-допуск: что требует ФНП № 461 и какие бумаги готовят до монтажа.';
const h1 = 'Можно ли ставить башенный кран рядом с ЛЭП и на каком расстоянии от проводов';
const crumbTitle = 'Башенный кран рядом с ЛЭП';
const slug = 'bashennyi-kran-ryadom-s-lep';

const H2 = [
  'Сколько метров до провода: две таблицы ФНП № 461',
  'Когда нужен наряд-допуск: граница в 30 метров',
  'Согласование с владельцем линии для крана на рельсах',
  'Кто руководит работой и что записывают в журнал',
  'Ограничитель опасного приближения к линии',
  'Что подготовить до монтажа около линии',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'На каком расстоянии от ЛЭП можно ставить башенный кран?',
    a: 'ФНП № 461 задаёт не расстояние установки, а минимальный зазор от стрелы до проводов в работе: 1,5 м до 1 кВ, 2 м для 1–35 кВ, 3 м для 35–110 кВ, 4 м для 110–220 кВ. Если до крайнего провода меньше 30 м, нужен наряд-допуск. КРАН-КУБАНЬ считает зазор по вылету модели на плане площадки.',
  },
  {
    q: 'Нужен ли наряд-допуск для башенного крана около линии электропередачи?',
    a: 'Пункт 112 ФНП № 461 требует наряд-допуск в 30 м от крайнего провода линии выше 50 В, но называет краны стрелового типа, манипуляторы и подъёмники. Башенный кран в нём поимённо не указан, поэтому КРАН-КУБАНЬ оформляет наряд-допуск и для него — как рабочее правило площадки.',
  },
  {
    q: 'Кто выдаёт разрешение на работу крана в охранной зоне ЛЭП?',
    a: 'Организация, которая эксплуатирует линию: по пункту 112 ФНП № 461 в охранной зоне наряд-допуск выдаётся только при её разрешении. Для башенного крана на рельсовом пути пункт 107 дополнительно требует согласовать установку с владельцем линии. Согласование хранят вместе с ППР.',
  },
  {
    q: 'Что такое ограничитель опасного приближения к линии электропередачи?',
    a: 'Прибор безопасности, который не даёт стреле подойти к проводу ближе заданного расстояния или подаёт сигнал. Его работоспособность проверяют по пункту 266 ФНП № 461 на макете линии 220/380 В. На кранах КРАН-КУБАНЬ исправность прибора записывают в акт проверки приборов безопасности.',
  },
  {
    q: 'Можно ли работать краном рядом с линией, если её отключили?',
    a: 'Да, но отключение не отменяет документ: порядок работ около линии определяет её владелец, а наряд-допуск описывает условия. ФНП № 461 разрешает работу вблизи неотключённой линии только при соблюдении зазоров и под руководством ИТР, поэтому КРАН-КУБАНЬ запрашивает у владельца линии письменный порядок.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Безопасность"
  published={PUBLISHED}
>
    <p slot="intro">Стрела башенного крана в работе не должна подходить к проводу линии 110 кВ ближе 3 м — это значение таблицы 3 приложения № 1 к ФНП № 461, а для линий до 35 кВ достаточно 1,5–2 м. Если до крайнего провода меньше 30 м, работу ведут по наряду-допуску. КРАН-КУБАНЬ сверяет эти числа с вылетом модели ещё на плане площадки, до монтажа.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Две таблицы ФНП № 461 дают два разных числа, и путать их нельзя. Таблица 3 приложения № 1 задаёт наименьшее расстояние от стрелы подъёмного сооружения во время работы до проводов под напряжением. Таблица 2 приложения № 2 задаёт границы опасной зоны поражения током от механизмов и кранов в рабочем и транспортном положении, включая грузозахватные приспособления и груз.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Напряжение линии, кВ</th><th>Стрела в работе до провода, не менее, м</th><th>Граница опасной зоны от крана и груза, м</th></tr></thead>
      <tbody>
        <tr><td>до 1</td><td>1,5</td><td>1,0</td></tr>
        <tr><td>1–35</td><td>2,0</td><td>1,0</td></tr>
        <tr><td>35–110 (в таблице 2: 60 и 110)</td><td>3,0</td><td>1,5</td></tr>
        <tr><td>110–220 (в таблице 2: 150 и 220)</td><td>4,0</td><td>2,0 и 2,5</td></tr>
        <tr><td>220–400 (в таблице 2: 330, 400 и 500)</td><td>5,0</td><td>3,5 и 4,5</td></tr>
      </tbody>
    </table></div>
    <p>Для башенного крана КРАН-КУБАНЬ берёт большее из двух значений — так зазор перекрывает обе таблицы. Пример: рядом с площадкой проходит линия 110 кВ. Стрела КБ-408.21 с вылетом 40 м не должна подходить к крайнему проводу ближе 3 м, а груз на крюке и сам кран держатся не ближе 1,5 м. Расчёт ведут по самому дальнему положению стрелы, а не по рабочему вылету.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Тридцать метров от крайнего провода — граница, после которой работа краном идёт только по наряду-допуску. Пункт 112 ФНП № 461 применяет её к линиям и воздушным электрическим сетям напряжением выше 50 В: расстояние считают от крайнего провода до крана, а не до опоры. Для площадки КРАН-КУБАНЬ это означает, что измерение по плану делают до установки крана, а не после.</p>
    <p>Важная оговорка по тексту нормы: пункт 112 называет краны стрелового типа, краны-манипуляторы и подъёмники, а башенный кран в нём поимённо не упомянут. КРАН-КУБАНЬ оформляет наряд-допуск и для башенных кранов Potain MDT 219 J10, КБ-408.21, КБ-674А, Potain MCH 175 и giraFFe SMK-5.66 при расстоянии менее 30 м. Это рабочее правило площадки, а не цитата из пункта: таблицы 2 и 3 написаны для подъёмных сооружений в целом.</p>
    <p>Наряд-допуск выдают крановщику перед началом работы, время его действия определяет организация, которая его выдала, а сведения заносят в журнал выдачи нарядов-допусков. Охранная зона — отдельное понятие: размер её задан не ФНП, а Правилами охраны электрических сетей, и цифру для конкретной линии берут из документа владельца.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Башенный кран на рельсовом пути в охранной зоне линии ставят только по согласованию с владельцем линии. Так говорит пункт 107 ФНП № 461: согласование на установку для строительно-монтажных работ хранится вместе с проектом производства работ. Поэтому для КБ-408.21, который работает только на рельсах, письмо владельца линии — такая же обязательная бумага, как акт приёмки пути.</p>
    <p>Для моделей без рельсового пути пункт 107 по буквальному тексту не применяется, но порядок у КРАН-КУБАНЬ одинаков: запрос владельцу линии, ответ с условиями, затем ППР. Согласование нужно не один раз: если после осмотра изменилась ось пути или вылет, условия подтверждают заново. Что входит в проект и в изыскания перед монтажом, разобрано в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>На действующих подстанциях и линиях пункт 113 ФНП № 461 передаёт выдачу наряда эксплуатирующей организации. Расстояние по воздуху от крана, крюковой обоймы и груза до ближайшего провода под напряжением в любом положении не может быть меньше значений приложений № 1 и № 2. Условие относится и к крюку, и к поднимаемому грузу.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Работу у линии ведут под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с подъёмными сооружениями. Пункт 112 ФНП № 461 возлагает на него три действия: указать крановщику место установки, обеспечить условия наряда-допуска и сделать запись в вахтенном журнале крана о разрешении работы. Без записи КРАН-КУБАНЬ смену не начинает.</p>
    <p>Для башенного крана это значит, что в смене двое держат линию в поле зрения: крановщик и руководитель работ. Стропальщик знает границу опасной зоны, а зона вдоль линии обозначена на площадке. Как считают границу опасной зоны от здания и от перемещаемого груза, разобрано в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>
    <p>Журнал выдачи нарядов-допусков и вахтенный журнал — два разных документа, и записи в них не дублируют друг друга. Первый фиксирует, кому и на какие условия выдан наряд, второй — разрешение конкретной смены. Ежесменный осмотр крана и пути проходит по тем же правилам, что и на площадке без линии, — порядок в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Ежесменный осмотр башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Ограничитель опасного приближения к линии электропередачи — прибор безопасности, который включён в перечень защит крана и проверяется отдельно. Пункт 266 ФНП № 461 определяет оценку его работоспособности, а для проверки допускается макет линии: трёхфазная четырёхпроводная линия 220/380 В на опорах высотой не менее 6 м, расстояние между опорами не менее 15 м, вдоль нижнего провода — ограничительный канат на расстоянии 1,5 ± 0,1 м.</p>
    <p>Для КРАН-КУБАНЬ эта проверка входит в общий акт по приборам безопасности, и нормой для площадки около линии служит не само наличие прибора, а его исправность на день работы. Прибор не заменяет наряд-допуск и не отменяет зазоров из таблицы: он страхует от ошибки крановщика на границе. Устройство и проверку остальных приборов описывает статья <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Подготовку площадки у линии КРАН-КУБАНЬ рекомендует вести в таком порядке: сначала расстояния, затем бумаги, затем монтаж. Перечень ниже — рекомендация, а не перечень из ФНП № 461, и каждый пункт опирается на пункты 107, 112, 113 и таблицы приложений № 1 и № 2.</p>
    <ol>
      <li>Нанести линию, её опоры и крайний провод на план площадки и измерить расстояние до оси мачты и до крайней точки стрелы.</li>
      <li>Запросить у владельца линии напряжение, охранную зону и условия работы рядом с ней, оформить согласование для ППР.</li>
      <li>Выбрать модель так, чтобы стрела в самом дальнем положении не заходила в зазор из таблицы 3 приложения № 1.</li>
      <li>Получить наряд-допуск до начала работ и внести его в журнал выдачи.</li>
      <li>Проверить ограничитель опасного приближения и записать результат в акт.</li>
    </ol>
    <p>Вопросы по конкретной площадке — адрес, напряжение линии и высоту объекта — можно прислать через <a href="/#order">форму на главной</a>; инженерная служба КРАН-КУБАНЬ подберёт модель из парка и посчитает зазор. Ветровой предел и паспорт крана для такой площадки разобраны в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора № 461 (ФНП), пункты 107, 112, 113, 266, приложение № 1 (таблица 3), приложение № 2 (таблица 2)' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/pribory-bezopasnosti-bashennogo-krana/', label: 'kran-kuban.ru — приборы безопасности башенного крана' },
    ]} />
</BlogArticleLayout>
