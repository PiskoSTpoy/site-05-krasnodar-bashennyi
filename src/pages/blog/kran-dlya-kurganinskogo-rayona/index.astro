---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 116. Девяносто четвёртая статья блога — угол (c) региональный.
// Курганинский район — юго-восток края, граница с Адыгеей; райцентр Курганинск
// (отдельная статья kran-dlya-kurganinska). Структура блоков: от экономики и
// предприятий к поселениям, динамике населения, границам и истории.
//
// Фактура — один источник (curl -sk, проверено 19.10.2026):
// smokk.ru/about/association-members/kurganinskiy-rayon — население 100 861 (01.01.2022),
// 99 198 (2023), 98 956 (2024), 98 231 (01.01.2025); администрация — г. Курганинск,
// ул. Ленина, 27; 10 муниципальных образований: Курганинское городское и 9 сельских
// (Безводное, Воздвиженское, Константиновское, Михайловское, Новоалексеевское,
// Октябрьское, Петропавловское, Родниковское, Темиргоевское); границы: Кошехабльский и
// Шовгеновский районы Адыгеи (запад), Усть-Лабинский (северо-запад), Тбилисский и
// Гулькевичский (север), Новокубанский (восток), Лабинский (юг); история: 02.06.1924
// образован (4 сельсовета), 16.11.1924 Северо-Кавказский край, 06.11.1929 присоединён
// Петропавловский район, 10.01.1934 Азово-Черноморский край, 31.12.1934 выделен
// Темиргоевский район, 13.09.1937 Краснодарский край, 22.08.1953 часть Темиргоевского
// района, 11.02.1963 упразднён (в Лабинский район), 03.03.1964 восстановлен,
// 1993 сельские округа, 2005 — 10 муниципальных образований; экономика: сельское
// хозяйство и переработка, ЗАО МК «Агрокубань», СПК колхоз «Рассвет», ООО «Агро-Галан»,
// ЗАО «Кавказ», ООО «Сельхоз-Галан», ЗАО «Воздвиженское», СПК колхоз «Новоалексеевский»;
// промышленность: ОАО «Галан», ЗАО «Курганинский сахарный завод», ООО «Хлеб»,
// ЗАО «Курганинский мясоптицекомбинат», ОАО «Курганинский элеватор», ООО «Андреедмитриевский
// щебзавод», ЗАО ПФ «Кубанский бройлер», ООО «Монолит».
// Расчёты КРАН-КУБАНЬ: убыль 2022→2025 = 2630 чел. (2,6 %); по годам −1663, −242, −725.
// НЕ названо: площадь, плотность, грунт, климат, расстояние до Краснодара, сейсмичность, цены.

const CHECKED = '19 октября 2026 года';
const PUBLISHED = '2026-10-19';

const title = 'Кран для Курганинского района: 98 231 житель и 10 поселений';
const description = 'Курганинский район — 98 231 житель на 01.01.2025, 10 муниципальных образований, граница с Адыгеей. Где нужен башенный кран и какую модель взять под объект.';
const h1 = 'Кран для Курганинского района: какой башенный кран нужен на юго-востоке края';
const crumbTitle = 'Кран для Курганинского района';
const slug = 'kran-dlya-kurganinskogo-rayona';

const H2 = [
  '8 промышленных предприятий: откуда берутся стройки',
  '10 муниципальных образований: город и 9 сельских поселений',
  '98 231 житель: убыль 2630 человек за три года',
  'Граница с Адыгеей и пять соседних районов',
  'История 1924–2005: район, который упраздняли и вернули',
  'Что район не сообщает: грунт, климат и сейсмика',
  'Какую модель брать под объект района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько жителей в Курганинском районе?',
    a: '98 231 человек на 1 января 2025 года по данным ассоциации «Совет муниципальных образований Краснодарского края» (СМОКК). На 1 января 2022 года было 100 861, за три года население уменьшилось на 2630 человек, или на 2,6 %. Пересчёт убыли — расчёт КРАН-КУБАНЬ.',
  },
  {
    q: 'Из каких поселений состоит Курганинский район?',
    a: 'Из Курганинского городского и девяти сельских поселений: Безводного, Воздвиженского, Константиновского, Михайловского, Новоалексеевского, Октябрьского, Петропавловского, Родниковского и Темиргоевского. Всего 10 муниципальных образований, образованных в 2005 году. Администрация района — в Курганинске на улице Ленина, 27.',
  },
  {
    q: 'С какими районами граничит Курганинский район?',
    a: 'На западе — с Кошехабльским и Шовгеновским районами Адыгеи, на северо-западе — с Усть-Лабинским, на севере — с Тбилисским и Гулькевичским, на востоке — с Новокубанским и на юге — с Лабинским районом Краснодарского края. Данные взяты из описания района на сайте СМОКК.',
  },
  {
    q: 'Какая сейсмичность в Курганинском районе?',
    a: 'СМОКК балл сейсмичности района не приводит, и КРАН-КУБАНЬ не называет его без первоисточника. Значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000, а при необходимости уточняют сейсмическим микрорайонированием.',
  },
  {
    q: 'Какой башенный кран подойдёт для объекта в районе?',
    a: 'Выбор зависит от высоты, вылета и основания. Для невысокого объекта до 41,7 м КРАН-КУБАНЬ предлагает giraFFe SMK-5.66, для длинного корпуса — Potain MDT 219 J10 или КБ-408.21 на рельсовом пути, для груза до 12,5 т и высоты свыше 73 м — КБ-674А.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Юго-восток края"
  published={PUBLISHED}
>
    <p slot="intro">Курганинский район на юго-востоке Краснодарского края граничит с Адыгеей, а на 1 января 2025 года в нём жили 98 231 человек в 10 муниципальных образованиях. Для башенного крана КРАН-КУБАНЬ из описания района важны три числа: 8 промышленных предприятий в источнике, 9 сельских поселений вокруг города Курганинска и 2630 человек убыли населения за три года.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Население района, по описанию СМОКК, занято в основном в сельскохозяйственном производстве и перерабатывающей промышленности. В источнике названы 8 крупных промышленных предприятий: ОАО «Галан», Курганинский сахарный завод, ООО «Хлеб», мясоптицекомбинат, Курганинский элеватор, Андреедмитриевский щебзавод, «Кубанский бройлер» и ООО «Монолит». Для КРАН-КУБАНЬ это перечень отраслей, где возникают стройки.</p>
    <p>Типичный заказ такого района — элеватор, цех переработки, склад или жилой корпус при предприятии, то есть объект с большим пятном застройки и умеренной высотой. КРАН-КУБАНЬ не приписывает конкретным предприятиям строек: сведений о заказах, площадях и сроках нет. Среди сельхозпредприятий источник называет «Агрокубань», колхозы «Рассвет» и «Новоалексеевский», «Агро-Галан», «Кавказ», «Сельхоз-Галан» и «Воздвиженское».</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>В районе 10 муниципальных образований: Курганинское городское поселение и 9 сельских — Безводное, Воздвиженское, Константиновское, Михайловское, Новоалексеевское, Октябрьское, Петропавловское, Родниковское и Темиргоевское. Администрация находится в Курганинске на улице Ленина, 27. Десять образований возникли в 2005 году, когда ликвидировали администрации сельских округов.</p>
    <p>Для заявки на башенный кран КРАН-КУБАНЬ уточняет поселение и адрес участка: от этого зависят маршрут доставки секций и схема монтажа. Сам город разобран в статье <a href="/blog/kran-dlya-kurganinska/">«Кран для Курганинска»</a>, а данные по соседнему райцентру — в статье <a href="/blog/kran-dlya-ust-labinskogo-rayona/">«Кран для Усть-Лабинского района»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>За три года население Курганинского района уменьшилось со 100 861 до 98 231 человека, то есть на 2630, или 2,6 %. Динамика по датам — в таблице; разницы между годами и общую убыль рассчитала инженерная служба КРАН-КУБАНЬ, в источнике приведены только численности.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Дата</th><th>Население, чел.</th><th>Изменение за год</th><th>К 2022 году</th></tr></thead>
      <tbody>
        <tr><td>01.01.2022</td><td>100 861</td><td>—</td><td>—</td></tr>
        <tr><td>01.01.2023</td><td>99 198</td><td>−1663</td><td>−1663</td></tr>
        <tr><td>01.01.2024</td><td>98 956</td><td>−242</td><td>−1905</td></tr>
        <tr><td>01.01.2025</td><td>98 231</td><td>−725</td><td>−2630 (−2,6 %)</td></tr>
      </tbody>
    </table></div>
    <p>Самый заметный спад — в 2022 году, −1663 человека; в 2023 году он замедлился до −242. Причины СМОКК не называет, и КРАН-КУБАНЬ их не додумывает. Практический вывод для строительства: спрос на новое жильё в районе нельзя выводить из роста населения, а заказы чаще связаны с предприятиями и реконструкцией.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>На западе Курганинский район граничит с Кошехабльским и Шовгеновским районами Адыгеи, на северо-западе — с Усть-Лабинским, на севере — с Тбилисским и Гулькевичским, на востоке — с Новокубанским, на юге — с Лабинским районом. Для КРАН-КУБАНЬ такая граница — повод проверить, в каком субъекте и районе лежит участок: от этого зависят согласования и маршрут доставки секций башенного крана.</p>
    <p>Если участок находится у границы, архивные схемы коммуникаций и проектные данные могут лежать в соседнем районе. Соседей КРАН-КУБАНЬ разобрал в статьях <a href="/blog/kran-dlya-tbilisskogo-rayona/">«Кран для Тбилисского района»</a>, <a href="/blog/kran-dlya-gulkevichey/">«Кран для Гулькевичей»</a>, <a href="/blog/kran-dlya-novokubanskogo-rayona/">«Кран для Новокубанского района»</a> и <a href="/blog/kran-dlya-labinska/">«Кран для Лабинска»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Курганинский район образован 2 июня 1924 года из четырёх сельских советов — Безводных Хуторов, Константиновского, Союза Четырёх Хуторов и Старомихайловского — и в 1963 году был упразднён, а в 1964-м восстановлен в прежних границах. Хронология из описания СМОКК — в таблице; она нужна, когда архивные документы по участку хранятся не в районе.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Дата</th><th>Что произошло</th></tr></thead>
      <tbody>
        <tr><td>02.06.1924</td><td>Образован район, 4 сельских совета</td></tr>
        <tr><td>06.11.1929</td><td>Присоединена территория упразднённого Петропавловского района</td></tr>
        <tr><td>31.12.1934</td><td>Выделен Темиргоевский район</td></tr>
        <tr><td>13.09.1937</td><td>Район в составе Краснодарского края</td></tr>
        <tr><td>22.08.1953</td><td>Присоединена часть упразднённого Темиргоевского района</td></tr>
        <tr><td>11.02.1963</td><td>Район упразднён, территория передана Лабинскому району</td></tr>
        <tr><td>03.03.1964</td><td>Район восстановлен в прежних границах</td></tr>
        <tr><td>2005</td><td>Образованы 10 муниципальных образований</td></tr>
      </tbody>
    </table></div>
    <p>Практический вывод КРАН-КУБАНЬ — рекомендация, а не норма: для участков в бывших границах Темиргоевского и Петропавловского районов проверка архивных данных может вести в архив соседнего района. Номер документа и адрес хранения заказчику лучше уточнить до начала изысканий.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Описание Курганинского района в СМОКК не содержит площади, балла сейсмичности, данных о грунтах и климате, и КРАН-КУБАНЬ не подставляет на их место цифры из других источников. Сейсмичность площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000 (<a href="/blog/seysmicheskoe-mikrorayonirovanie/">разбор микрорайонирования</a>).</p>
    <p>Краевой закон № 608-КЗ о тишине действует на всей территории района, включая Курганинск и сельские поселения. График монтажа и подъёмов КРАН-КУБАНЬ согласует с заказчиком до выезда; исключения для строительных работ описаны в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>. Грунт определяют изыскания: <a href="/blog/izyskaniya-pered-montazhom-krana/">состав работ</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Модель под объект в Курганинском районе КРАН-КУБАНЬ выбирает по высоте, вылету и основанию; ориентиры инженерной службы — в таблице. Для элеватора или склада с большой площадью застройки первым смотрят вылет, для жилого корпуса при предприятии — высоту подъёма.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Задача на участке</th><th>Модель парка КРАН-КУБАНЬ</th><th>Параметр из реестра</th></tr></thead>
      <tbody>
        <tr><td>Невысокий цех или склад до 41,7 м</td><td>giraFFe SMK-5.66</td><td>Контур 4×4 м, монтаж 4–6 часов</td></tr>
        <tr><td>Длинный производственный корпус</td><td>Potain MDT 219 J10</td><td>Вылет 65 м, 1,9 т на конце</td></tr>
        <tr><td>Корпус с набором секций мачты</td><td>КБ-408.21</td><td>Вылет 40 м, крюк 54,0–72,7 м</td></tr>
        <tr><td>Тяжёлые блоки, высота свыше 73 м</td><td>КБ-674А</td><td>12,5 т максимум, крюк до 116–120 м</td></tr>
      </tbody>
    </table></div>
    <p>Основание под каждую модель разобрано в статье <a href="/blog/osnovanie-pod-bashennyi-kran-po-modelyam/">«Основание под башенный кран по моделям»</a>, вылеты — в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>. Адрес и параметры объекта можно прислать через <a href="/#order">форму на главной</a> — КРАН-КУБАНЬ назовёт модель и маршрут доставки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/kurganinskiy-rayon', label: 'smokk.ru — Курганинский муниципальный район: население, география, история, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
