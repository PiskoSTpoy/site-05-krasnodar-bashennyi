---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 96. Тридцать вторая статья блога — угол (a) информационный/how-to.
// До этой волны на сайте не было ни слова о коррозии, хотя пять из
// разобранных городов (Новороссийск, Туапсе, Сочи, Анапа, Геленджик) и Ейск
// стоят на море. Первая статья, написанная по seo-2026-playbook
// (KONTENT-PRAVILA.md создан в этой же волне): answer-first intro, H2 = одно
// свойство, сущность по имени в каждом абзаце, byline с реальными датами.
//
// Фактура (WebSearch/WebFetch 25.09.2026):
// - ГОСТ 15150-69, табл. 8 (jumas.ru): типы атмосферы I условно-чистая,
//   II промышленная, III морская, IV приморско-промышленная; хлориды для
//   I и II — менее 0,3 мг/(м²·сут), для III — от 30 до 300 мг/(м²·сут).
//   Морская атмосфера — моря, океаны и прибрежная территория «в пределах
//   непосредственного воздействия морской воды».
// - ГОСТ 15150-69 п. 4.10: требования стойкости к соляному туману — для
//   исполнений М, ТМ, ОМ, В категорий 1 и 2 и для изделий категорий 1 и 2
//   других исполнений, предназначенных для эксплуатации на побережьях.
// - Исполнение У1 (открытый воздух) и паспортный диапазон −45…+40 °C —
//   перенесено из статьи «Башенный кран в жару» (sertrb.ru).
// Сознательно НЕ приводим: сроки/интервалы осмотров, толщины покрытий,
// скорость коррозии в мкм/год — надёжного первоисточника под кран не нашли;
// эти значения задают паспорт крана и руководство по эксплуатации.

const CHECKED = '25 сентября 2026 года';
const PUBLISHED = '2026-09-25';

const title = 'Башенный кран у моря: защита от коррозии на побережье Кубани';
const description = 'Как работать башенным краном в морской атмосфере Новороссийска, Сочи, Анапы и Ейска: тип атмосферы по ГОСТ 15150-69, приёмка, осмотры, электрика и демонтаж.';
const h1 = 'Башенный кран у моря: как уберечь металл от солёного воздуха';
const crumbTitle = 'Башенный кран у моря';
const slug = 'bashennyi-kran-u-morya';

const H2 = [
  'Морская атмосфера по ГОСТ 15150-69: чем она отличается',
  'Где на Кубани кран работает в морской атмосфере',
  'Приёмка крана на прибрежный объект: что проверить',
  'Осмотры во время аренды у моря',
  'Электрика и приборы безопасности в солёном воздухе',
  'Демонтаж после морского объекта',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const atmos = [
  { type: 'I — условно-чистая', so2: 'не более 20', cl: 'менее 0,3' },
  { type: 'II — промышленная', so2: '20–250', cl: 'менее 0,3' },
  { type: 'III — морская', so2: 'не более 20', cl: '30–300' },
  { type: 'IV — приморско-промышленная', so2: '20–250', cl: 'повышенные, по таблице 8 стандарта' },
];

const faqs = [
  {
    q: 'Можно ли ставить обычный башенный кран в Новороссийске или Сочи?',
    a: 'Да, башенные краны исполнения У1 работают на побережье Кубани, но ГОСТ 15150-69 отдельно выделяет морскую атмосферу и требования стойкости к соляному туману для изделий, предназначенных для побережий. Поэтому при аренде крана КРАН-КУБАНЬ для прибрежной площадки сначала сверяют паспорт машины с условиями площадки, а затем чаще планируют осмотры покрытия, болтовых узлов и электрики.',
  },
  {
    q: 'Как часто осматривать кран, который работает у моря?',
    a: 'Интервалы осмотров задают паспорт и руководство по эксплуатации конкретного крана, а не общий норматив для всех моделей. У моря инженерная служба КРАН-КУБАНЬ добавляет к плановым осмотрам внимание к местам, где скапливается влага и соль: к стыкам секций башни, болтовым соединениям, шкафам управления и разъёмам кабелей.',
  },
  {
    q: 'Какой тип атмосферы у площадки в порту?',
    a: 'Тип атмосферы по ГОСТ 15150-69 определяют по содержанию сернистого газа и хлоридов в воздухе. Рядом с портом и промышленными предприятиями к морским хлоридам может добавиться промышленный сернистый газ, и атмосфера становится приморско-промышленной. Для конкретной площадки в Новороссийске или Туапсе этот вывод делает проектировщик, а не подрядчик по крану.',
  },
  {
    q: 'Влияет ли морской воздух на стоимость аренды крана?',
    a: 'Прямой «морской надбавки» в ставке обычно нет, но береговая площадка добавляет работу: дополнительные осмотры во время аренды и более тщательную проверку крана после демонтажа. В смете КРАН-КУБАНЬ эти пункты обсуждаются вместе с остальными строками — перебазировкой, основанием и сейсмическим расчётом.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Как работать у моря"
  published={PUBLISHED}
>
    <p slot="intro">Башенный кран на побережье Кубани работает в морской атмосфере, которую ГОСТ 15150-69 выделяет в отдельный тип: хлоридов в воздухе там в сто и более раз больше, чем в условно-чистой атмосфере. Для крана КРАН-КУБАНЬ на площадке в Новороссийске, Туапсе, Сочи, Анапе, Геленджике или Ейске это означает три вещи: сверить паспорт машины с условиями площадки, чаще осматривать узлы, где собирается соль, и внимательнее проверить кран после демонтажа.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>ГОСТ 15150-69 делит атмосферу на четыре типа по двум веществам, которые разрушают металл: сернистому газу и хлоридам. Условно-чистая и промышленная атмосферы содержат хлоридов менее 0,3 мг на квадратный метр в сутки. Морская атмосфера — от 30 до 300 мг, то есть минимум в сто раз больше. Промышленная и приморско-промышленная отличаются сернистым газом от 20 до 250 мг на квадратный метр в сутки.</p>

    <div class="rule-table-wrap" style="margin-bottom:24px">
      <table class="rule-table">
        <caption style="text-align:left;margin-bottom:8px">Типы атмосферы по ГОСТ 15150-69, таблица 8, мг/(м²·сут)</caption>
        <thead>
          <tr><th scope="col">Тип атмосферы</th><th scope="col">Сернистый газ</th><th scope="col">Хлориды</th></tr>
        </thead>
        <tbody>
          {atmos.map((r) => (
            <tr><td>{r.type}</td><td>{r.so2}</td><td>{r.cl}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <p>ГОСТ 15150-69 в пункте 4.10 требует стойкости к соляному туману от изделий, предназначенных для эксплуатации на побережьях. Башенный кран исполнения У1 рассчитан на открытый воздух умеренного климата, и береговая площадка для него — не запрет, а повод внимательнее следить за металлом и электрикой.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>ГОСТ 15150-69 относит к морской атмосфере прибрежную территорию «в пределах непосредственного воздействия морской воды». На Кубани под это определение попадают площадки черноморского побережья от Анапы до Сочи и азовский берег у Ейска. Большинство разборов КРАН-КУБАНЬ по этим городам — <a href="/blog/kran-dlya-novorossiyska/">Новороссийск</a>, <a href="/blog/kran-dlya-tuapse/">Туапсе</a>, <a href="/blog/kran-dlya-sochi/">Сочи</a>, <a href="/blog/kran-dlya-anapy/">Анапа</a>, <a href="/blog/kran-dlya-gelendzhika/">Геленджик</a> и <a href="/blog/kran-dlya-eyska/">Ейск</a> — касаются именно таких площадок.</p>
    <p>Портовые города Новороссийск и Туапсе дают особый случай. Рядом с портом и промышленными предприятиями к морским хлоридам может добавиться сернистый газ, и атмосфера по ГОСТ 15150-69 становится приморско-промышленной. Точный тип атмосферы для площадки определяет проектировщик объекта; инженерной службе КРАН-КУБАНЬ этот вывод нужен до выбора крана, а не после монтажа.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Приёмка башенного крана КРАН-КУБАНЬ на прибрежный объект начинается с паспорта: климатическое исполнение и категория размещения указаны в документации машины. Для любой модели парка КРАН-КУБАНЬ — от КБ-408.21 до Potain MDT 219 J10 — перед отправкой на береговую площадку полезно пройти короткий список.</p>
    <ul>
      <li>Климатическое исполнение крана по паспорту и соответствие его условиям площадки.</li>
      <li>Состояние лакокрасочного покрытия секций башни и стрелы: сколы и очаги ржавчины фиксируют в акте до монтажа.</li>
      <li>Болтовые соединения секций башни: крепёж без коррозии на резьбе и под головками.</li>
      <li>Канаты: смазка по руководству по эксплуатации, без сухих участков.</li>
      <li>Шкафы управления и кабельные вводы: уплотнения целы, дверцы закрываются плотно.</li>
    </ul>
    <p>Акт с фотографиями покрытия до монтажа защищает обе стороны: по нему видно, что появилось за время аренды у моря, а что было раньше.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Интервалы осмотров башенного крана КРАН-КУБАНЬ задают его паспорт и руководство по эксплуатации, и у моря их не сокращают «на глаз». Меняется фокус: на прибрежной площадке КРАН-КУБАНЬ смотрит прежде всего туда, где соль задерживается вместе с влагой. Это стыки секций башни, узлы крепления стрелы и противовеса, нижние пояса металлоконструкции, площадки и лестницы, куда стекает вода.</p>
    <p>Норд-ост в Новороссийске и Геленджике добавляет свою задачу. Во время боры кран переводят в режим свободного вращения стрелы, а после ветра полезно осмотреть металлоконструкцию и крепёж вместе с обычной проверкой перед возобновлением работы. Как кран ведёт себя при сильном ветре, разобрано в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Электрооборудование башенного крана КРАН-КУБАНЬ страдает от солёного воздуха раньше металлоконструкции, потому что соль на контактах и разъёмах вместе с влагой проводит ток. На береговой площадке КРАН-КУБАНЬ отдельно проверяет шкафы управления, кабельные вводы, клеммы и разъёмы приборов безопасности. Прибор безопасности КБ-408.21 с координатной защитой, ограничители грузоподъёмности и датчики ветра — это то, от чего зависит допуск крана к работе.</p>
    <p>Практическое правило КРАН-КУБАНЬ для прибрежного объекта: дверцы шкафов после обслуживания закрываются до щелчка, а повреждённые уплотнения меняют сразу, а не «в следующий раз». Ложное срабатывание прибора безопасности из-за окисленного контакта останавливает кран так же, как настоящая перегрузка, и оплаченная смена уходит в простой.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Демонтаж башенного крана после объекта в Сочи или Анапе — удобный момент проверить металл целиком: секции башни опускаются на землю, и доступны места, которые на высоте видно плохо. Инженерная служба КРАН-КУБАНЬ сравнивает состояние покрытия и крепежа с актом приёмки и до следующего объекта устраняет найденное. Порядок самого демонтажа и перебазировки описан на этапе <a href="/etapy/demontazh-i-perebazirovka/">«Демонтаж и перебазировка»</a>.</p>
    <p>Для заказчика КРАН-КУБАНЬ это важно по простой причине: кран, который после морского объекта сразу уехал на следующую площадку без проверки, приносит туда накопленную коррозию. Спросите арендодателя, где работала машина до вашего объекта и что было сделано после демонтажа.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <ul>
      <li>ГОСТ 15150-69 выделяет морскую атмосферу: хлоридов в ней от 30 до 300 мг/(м²·сут) против менее 0,3 в условно-чистой.</li>
      <li>На Кубани в морской атмосфере работают краны побережья от Анапы до Сочи и в Ейске; у портов атмосфера может быть приморско-промышленной.</li>
      <li>До монтажа — паспорт, акт с фото покрытия, болтовые узлы, канаты, шкафы.</li>
      <li>Во время аренды — интервалы по паспорту, фокус на узлах, где задерживается соль, и осмотр после норд-оста.</li>
      <li>Электрика и приборы безопасности страдают первыми; уплотнения меняют сразу.</li>
      <li>После демонтажа — сравнение с актом приёмки до следующего объекта.</li>
    </ul>
    <p>Площадку на побережье и сроки можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ подберёт модель и составит план осмотров.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://jumas.ru/information/gost-15150-69.php', label: 'ГОСТ 15150-69 — типы атмосферы (табл. 8), соляной туман (п. 4.10), исполнение У1' },
      { href: 'https://www.elcn.ru/upload/iblock/95e/GOST_15150_69_Ispolnenie_dlya_razlichnykh_klimaticheskikh_rayonov.pdf', label: 'ГОСТ 15150-69 — полный текст стандарта (PDF)' },
      { href: 'https://allgosts.ru/77/060/gost_9.039-74', label: 'ГОСТ 9.039-74 — коррозионная агрессивность атмосферы' },
    ]} />
</BlogArticleLayout>
