---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 114. Восемьдесят восьмая статья блога — угол (b) сравнительный.
// Не пара моделей (все десять пар уже написаны), а сценарий: серия одинаковых
// невысоких объектов на одном участке — быстромонтируемый giraFFe SMK-5.66
// против рельсовых моделей парка.
//
// Фактура — только реестр parkModels.ts и карточка /park/giraffe-smk-5-66/
// (проверено 16.10.2026):
// - SMK-5.66: 5 т максимум, 1,05 т на 43 м, вылет 2,8–43 м, крюк до 27 м
//   (горизонтальная стрела) / до 41,7 м (наклон 20°, в ущерб вылету), опорный
//   контур 4×4 м, фундамент не нужен, монтаж 4–6 часов, бригада 2 специалиста +
//   автокран 25 т;
// - КБ-408.21: 10 т, вылет 40 м, крюк 54,0–72,7 м, наземный рельсовый путь;
// - Potain MDT 219 J10: 10 т, 1,9 т на 65 м, крюк до 70,4 м, рельсовый путь
//   или фундамент; Potain MCH 175: 10 т, 1,5 т на 55 м, крюк до 58,5 м,
//   рельсовый путь или фундамент.
// Расчёты: 10 домов × 4–6 ч = 40–60 ч монтажа; разрыв по высоте SMK (41,7 м) и
// минимальным крюком КБ-408.21 (54,0 м) = 12,3 м; SMK по грузу = 50 % от 10 т;
// момент SMK на пределе: 1,05 × 43 ≈ 45 тм (КБ-408.21: данных на вылет нет).
// Допущение: серия из 10 домов — иллюстрация, не данные посёлка.
// НЕ приводится: цены, время демонтажа и перевозки SMK, время монтажа
// рельсовых моделей (в реестре нет — отсылка к статье о сроках монтажа).

const CHECKED = '16 октября 2026 года';
const PUBLISHED = '2026-10-16';

const title = 'Кран для коттеджного посёлка: SMK-5.66 или рельсовая модель';
const description = 'Серия из 10 домов: giraFFe SMK-5.66 встаёт за 4–6 часов без фундамента, но поднимает до 41,7 м и 5 т. Когда хватает и когда нужен рельсовый кран.';
const h1 = 'Кран для коттеджного посёлка: быстромонтируемый SMK-5.66 или рельсовая модель';
const crumbTitle = 'Кран для коттеджного посёлка';
const slug = 'kran-dlya-kottedzhnogo-posyolka';

const H2 = [
  'Серия из 10 домов: условия сравнения',
  '5 параметров: SMK-5.66 и рельсовые модели',
  'Время: 40–60 часов монтажа против подготовки пути',
  'Где SMK-5.66 не хватает: 41,7 м и 5 т',
  'Перестановка крана и пункты 44 и 47 ФНП',
  'Правило выбора для посёлка',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой башенный кран подходит для строительства коттеджного посёлка?',
    a: 'Если дома невысокие и грузы лёгкие, КРАН-КУБАНЬ предлагает giraFFe SMK-5.66: 5 т, крюк до 27 м с горизонтальной стрелой и до 41,7 м с наклоном 20°, фундамент не нужен. Для тяжёлых элементов и вытянутой площадки подходят рельсовые КБ-408.21, Potain MDT 219 J10 и Potain MCH 175.',
  },
  {
    q: 'Сколько времени занимает установка giraFFe SMK-5.66?',
    a: 'От доставки до полной готовности — 4–6 часов, бригада из 2 специалистов и один автокран грузоподъёмностью 25 т (данные карточки модели в парке КРАН-КУБАНЬ). Для серии из 10 домов это 40–60 часов монтажа в сумме; время демонтажа и перевозки в карточке не указано.',
  },
  {
    q: 'Нужен ли фундамент под кран на участке коттеджного посёлка?',
    a: 'Для giraFFe SMK-5.66 — нет, он встаёт на собственный опорный контур 4×4 м. Для КБ-408.21 нужен наземный рельсовый путь, для Potain MDT 219 J10 и MCH 175 — рельсовый путь или монолитный фундамент. Основание готовят до приезда крана.',
  },
  {
    q: 'Выдержит ли SMK-5.66 тяжёлые элементы дома?',
    a: 'До 5 т у мачты и 1,05 т на предельном вылете 43 м. Если самый тяжёлый элемент — например, готовый блок или пакет плит — тяжелее, чем позволяет грузовая кривая на нужном вылете, КРАН-КУБАНЬ предлагает модель на 10 т: КБ-408.21, Potain MDT 219 J10 или Potain MCH 175.',
  },
  {
    q: 'Что требует ФНП при монтаже башенного крана на новом месте?',
    a: 'После монтажа металлоконструкций выполняют запасовку канатов и наладку тормозов, ограничителей, указателей и регистраторов, затем наладку системы управления в целом (пункт 47 ФНП № 461). Как это сочетается с порядком освидетельствования быстромонтируемых кранов, определяет документация конкретной машины.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Серия объектов"
  published={PUBLISHED}
>
    <p slot="intro">Для серии из 10 коттеджей подряд giraFFe SMK-5.66 монтируют за 4–6 часов без фундамента, то есть 40–60 часов на всю серию, но он поднимает не выше 41,7 м и не более 5 т. Рельсовые КБ-408.21, Potain MDT 219 J10 и Potain MCH 175 берут 10 т и крюк от 54,0 м, но требуют пути или фундамента. КРАН-КУБАНЬ сравнивает оба варианта по данным реестра парка.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Десять домов — иллюстрация КРАН-КУБАНЬ, а не данные конкретного посёлка: так проще показать, как цена одной перестановки умножается на серию. Предполагаем одинаковые невысокие дома на одном участке, где кран перемещают от дома к дому или от улицы к улице; тип дома и этажность заказчик называет сам.</p>
    <p>Сравниваются две схемы. Первая — быстромонтируемый giraFFe SMK-5.66, который устанавливают заново у каждого дома. Вторая — одна из рельсовых моделей парка КРАН-КУБАНЬ: КБ-408.21, Potain MDT 219 J10 или Potain MCH 175, где путь или фундамент готовят один раз под всю линию домов. Общий разбор типов крана — в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Паспортные параметры двух схем различаются в пяти строках, и КРАН-КУБАНЬ берёт их из реестра парка и карточки модели. Таблица показывает, где каждая схема выигрывает.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>giraFFe SMK-5.66</th><th>Рельсовые модели парка</th></tr></thead>
      <tbody>
        <tr><td>Основание</td><td>Опорный контур 4×4 м, фундамент не нужен</td><td>КБ-408.21 — рельсовый путь; MDT и MCH — путь или монолитный фундамент</td></tr>
        <tr><td>Монтаж</td><td>4–6 часов, 2 специалиста и автокран 25 т</td><td>Срок в реестре не указан (см. статью о сроках)</td></tr>
        <tr><td>Высота крюка</td><td>До 27 м (горизонтальная стрела), до 41,7 м (наклон 20°)</td><td>КБ-408.21: 54,0–72,7 м; MDT: до 70,4 м; MCH: до 58,5 м</td></tr>
        <tr><td>Максимальный груз</td><td>5 т; 1,05 т на 43 м</td><td>10 т у всех трёх моделей</td></tr>
        <tr><td>Вылет</td><td>2,8–43 м</td><td>КБ-408.21: 40 м; MDT: 65 м; MCH: до 55 м</td></tr>
      </tbody>
    </table></div>
    <p>Из таблицы видно: SMK-5.66 выигрывает по основанию и сроку установки, рельсовые модели — по высоте крюка и грузу. Вылет у SMK-5.66 (43 м) больше, чем у КБ-408.21 (40 м), но на пределе кран держит всего 1,05 т.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Десять установок SMK-5.66 по 4–6 часов дают 40–60 часов монтажа за всю серию — это расчёт КРАН-КУБАНЬ по карточке модели. В сумму не входят демонтаж и перевозка между домами: этих времён в карточке нет, и называть их статья не будет. Но для сравнения важна сама шкала: часы против подготовки пути или фундамента, которую у рельсовых моделей делают заранее и целиком.</p>
    <p>У рельсовых моделей КРАН-КУБАНЬ срок монтажа в реестре не приводит, поскольку он зависит от высоты, основания и проекта. Разброс по объектам собран в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>. Если дома стоят в одну линию и кран может ходить вдоль неё, путь укладывают один раз; если участки разбросаны по посёлку, выигрывает схема, которую можно собрать заново.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Разрыв между потолком giraFFe SMK-5.66 и нижней границей КБ-408.21 составляет 12,3 м: 41,7 м против 54,0 м — это расчёт по реестру парка. Если крюку нужна высота в этом промежутке, SMK-5.66 с наклоном не достаёт, а КБ-408.21 в минимальной конфигурации уже выше. Подробные значения по всем моделям — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>
    <p>По грузу у SMK-5.66 максимум в два раза ниже, чем у каждой из трёх рельсовых моделей: 5 т против 10 т. На вылете 43 м кран держит 1,05 т, то есть грузовой момент на пределе — около 45 т·м. Для лёгких материалов и небольших элементов этого хватает; для тяжёлых блоков КРАН-КУБАНЬ сверяет самый тяжёлый элемент с кривой выбранной модели на нужном вылете (<a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">как читать кривую</a>).</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Перестановка крана превращает каждый новый дом в новый монтаж, а значит, к нему применяется пункт 47 ФНП № 461: после монтажа металлоконструкций выполняют запасовку грузовых канатов, наладку тормозов, ограничителей, указателей и регистраторов, затем наладку системы управления в целом. Для SMK-5.66 короткий срок установки не отменяет этот перечень.</p>
    <p>Пункт 44 ФНП относится к другой схеме: сборку и монтаж самомонтируемых башенных кранов ведут на подготовленном участке наземного рельсового пути. Для рельсовых моделей КРАН-КУБАНЬ участок пути проверяют до монтажа, порядок проверки — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Как порядок освидетельствования зависит от документации быстромонтируемого крана, разобрано в статье <a href="/blog/tekhnicheskoe-osvidetelstvovanie-bashennogo-krana/">«Техническое освидетельствование башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Правило выбора КРАН-КУБАНЬ строится на трёх вопросах: насколько высок самый высокий дом, сколько весит самый тяжёлый элемент и сколько раз кран переставляют. Ответы сводятся к четырём случаям.</p>
    <ul>
      <li>Дома до 27 м, элементы до 1 т на дальнем вылете, перестановок много — giraFFe SMK-5.66.</li>
      <li>Дома до 41,7 м, тяжёлых блоков нет — giraFFe SMK-5.66 с наклоном стрелы 20°.</li>
      <li>Дома выше 41,7 м или элементы тяжелее 5 т — КБ-408.21 (от 54,0 м крюка), Potain MDT 219 J10 или Potain MCH 175.</li>
      <li>Участок тесный, дом рядом с соседним — Potain MCH 175 с маховой стрелой.</li>
    </ul>
    <p>Для чистого сравнения двух моделей по всем параметрам есть отдельная статья <a href="/blog/kb-408-21-ili-giraffe-smk-5-66/">«КБ-408.21 или giraFFe SMK-5.66»</a>, а стоимость владения краном описана в статье <a href="/blog/smeta-arendy-bashennogo-krana/">«Смета аренды башенного крана»</a>. Адрес посёлка, число домов и высоту можно прислать через <a href="/#order">форму на главной</a> — КРАН-КУБАНЬ назовёт модель и схему перестановок.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — giraFFe SMK-5.66: паспортные параметры и время монтажа' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: пять моделей и их характеристики' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора от 26.11.2020 № 461, ФНП: пункты 44 и 47' },
    ]} />
</BlogArticleLayout>
