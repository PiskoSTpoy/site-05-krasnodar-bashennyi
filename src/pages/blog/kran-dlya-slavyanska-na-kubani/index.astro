---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 78. Тринадцатая статья блога — Славянск-на-Кубани, первый разбор
// внутренней (равнинной) части края на реке, а не на побережье и не в
// предгорье. Экономический якорь — действующий нефтеперерабатывающий завод
// «Славянск ЭКО», крупнейшее промышленное предприятие города; инженерный
// фактор — пойма реки Протоки, регулярно подтопляемая (последний зафиксированный
// эпизод — июнь 2026 года, режим ЧС районного уровня, 1084 га подтопленных
// сельхозземель у хутора Соболевского), что даёт городу собственный, отличный
// от Мостовского района (эрозия берегов) грунтовый фактор — не эрозия,
// а периодическое подтопление поймы.
//
// Как и в Волнах 76-77 (Ейск, Туапсе), сетевой доступ сессии не пропускал
// прямые запросы к docs.cntd.ru/base.garant.ru/seismos-u.ifz.ru — только
// WebSearch, и строка Славянского района из Приложения Б ТСН 22-302-2000 в
// выдаче не нашлась ни разу. Решение то же: сейсмический балл в статье не
// указан, фактор назван без числа, со ссылкой на первоисточник для
// самостоятельной проверки.
//
// Экономический слой (ООО «Славянск ЭКО», ИНН 2370000496) проверен по
// нескольким независимым реестрам (list-org, zachestnyibiznes) и отраслевым
// изданиям (Коммерсантъ-Кубань, neftegaz.ru, tek-all.ru); паводковый эпизод —
// по нескольким независимым новостным источникам (Кубань Информ, RuNews24,
// u-f.ru), совпадающим в цифрах. ЖК «Аквамарин», всплывавший в предварительном
// поиске, отброшен: по факту это проект в Краснодаре, а не в Славянске-на-Кубани
// — вместо него в статье назван реально найденный местный застройщик
// «Кубанская Крепость» (ул. Комсомольская).

const CHECKED = '4 сентября 2026 года';

const title = 'Кран для Славянска-на-Кубани: нефтезавод у поймы Протоки';
const description = 'Славянск-на-Кубани — степной город на слиянии Кубани и Протоки: действующий нефтеперерабатывающий завод «Славянск ЭКО», регулярно подтопляемая пойма и то, что это значит для монтажа башенного крана.';
const h1 = 'Кран для Славянска-на-Кубани: нефтезавод у поймы Протоки';
const crumbTitle = 'Кран для Славянска-на-Кубани';
const slug = 'kran-dlya-slavyanska-na-kubani';

const H2 = [
  'Славянск-на-Кубани — степной город на двух реках, а не курорт',
  '«Славянск ЭКО»: где на промплощадке чаще всего нужен кран',
  'Протока: пойменный грунт и почему подтопление — не абстракция',
  'Сейсмика: что можно сказать про Славянский район, а что нет',
  'Закон о тишине действует и здесь — без региональной скидки',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Нужен ли для площадки в пойме Протоки другой подход к фундаменту крана, чем на «обычном» грунте?',
    a: 'Прямого норматива «для поймы отдельно» нет — действует общий порядок инженерно-геологических изысканий по СП 446.1325800.2019, разобранный в статье «Инженерные изыскания перед монтажом крана». Но фактическая картина на пойменном участке иная: высокий уровень грунтовых вод и периодическое подтопление означают, что несущая способность и однородность грунта на конкретной точке нужно уточнять по актуальным изысканиям, а не по общему представлению о степном грунте — и закладывать это в график заранее, а не выяснять по факту прибытия техники.',
  },
  {
    q: 'Правда ли, что для Славянска-на-Кубани сейсмический расчёт не нужен вообще?',
    a: 'Мы не можем сказать этого с уверенностью и потому не пишем в статье конкретный балл: доступные в этой волне источники не дали надёжного подтверждения строки Славянского района в Приложении Б ТСН 22-302-2000. Для конкретного объекта расчётную сейсмичность площадки определяет проектировщик по действующей редакции норматива, а не по среднему впечатлению о равнинной части края.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Славянска-на-Кубани', item: `${SITE}/blog/kran-dlya-slavyanska-na-kubani/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-slavyanska-na-kubani/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-slavyanska-na-kubani/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье (Анапа, Новороссийск, Сочи, Ейск, Туапсе) и предгорную ось (Армавир, Горячий Ключ, Апшеронский и Мостовской районы) — но ни разу равнинную часть края на реке. Славянск-на-Кубани закрывает и этот пробел: город стоит не у моря и не в горах, а на слиянии реки Кубань и её рукава Протоки, и обе площадки, которые здесь интересны для монтажа крана — промышленная и жилая, — так или иначе завязаны на эту речную географию.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Славянск-на-Кубани — административный центр Славянского района, расположенный в западной, равнинной части края, в плавневой зоне у слияния Кубани и Протоки. В отличие от Анапы или Ейска, курортной функции у города практически нет: экономика опирается на промышленность и сельское хозяйство, а не на туристический сезон. Это меняет саму логику спроса на кран — не отель к маю, а промышленный объект или жилой дом по мере продажи квартир, без выраженной сезонности побережья.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Крупнейшее предприятие города — нефтеперерабатывающий завод, работающий под брендом «Славянск ЭКО» (ООО «Славянск ЭКО», ИНН 2370000496, ОГРН 1112370000753) — одно из самых динамично развивающихся предприятий края, по оценке отраслевых изданий. По данным «Коммерсантъ-Кубань» и neftegaz.ru, завод годами ведёт программу модернизации по соглашениям с Минэнерго России: реконструкцию установок первичной переработки, строительство комплекса каталитического крекинга и производство дорожного битума, с ростом выручки предприятия год к году. Именно такая площадка — не разовая стройка, а действующий завод с циклом модернизации — регулярно нуждается в кране: не под один жилой корпус на несколько месяцев, а периодически, под монтаж новых технологических установок, эстакад и резервуарного оборудования.</p>
    <p>Жилищное строительство в городе для сравнения точечное: по данным профильных порталов недвижимости, из местных застройщиков на слуху «Кубанская Крепость» с проектом на улице Комсомольской — это далеко не темп Краснодара или Новороссийска, но и не полное отсутствие спроса на аренду техники под жильё.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>В статье про изыскания перед монтажом крана мы уже писали, что рыхлый прибрежный грунт Анапы и эрозия берегов Ходзи и Лабы в Мостовском районе — не абстрактные факторы, а конкретные причины уточнять основание на площадке. У Славянска-на-Кубани свой вариант той же темы: город стоит в пойме, и подтопление здесь не гипотетический сценарий, а регулярно повторяющееся событие. В июне 2026 года в Славянском районе вводили режим чрезвычайной ситуации районного уровня из-за повреждения защитной дамбы у хутора Соболевского: по данным нескольких независимых источников, вода поднялась до опасной отметки у хутора Галицына на Протоке, а подтопленными оказались порядка 1084 гектаров сельхозземель. Для капитального строительства это, прежде всего, вопрос к проектировщику и его изысканиям, а не к арендодателю крана — но для площадки в пойме мы отдельно уточняем актуальность данных о грунте и уровне грунтовых вод перед монтажом, а не полагаемся на общее представление о равнинном крае.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Здесь мы сознательно не приводим конкретный балл сейсмичности для Славянска-на-Кубани. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Славянского района доступные в этой волне источники надёжно не подтвердили. Мы уже показывали на примере Армавира, что интуиция «равнина — значит, тихо» может быть неверной: Армавир, стоящий в 150 км от моря, по официальному приложению к краевому нормативу рассчитывается почти как курортный Сочи. Возможно, что-то похожее верно и для Славянска-на-Кубани, а возможно — нет; называть цифру без прямой цитаты первоисточника мы не готовы, и предпочитаем оставить фактор без числа, чем дать неточное число. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Славянске-на-Кубани так же, как в Сочи или Краснодаре: часы шумных работ и ответственность по статье 3.3 одинаковы для всего края независимо от того, стоит рядом гостиница или промышленная площадка. Разница не в норме, а в вероятности жалобы: у промышленного объекта, удалённого от жилой застройки, риск обращения ниже, чем у стройки в двух шагах от многоквартирного дома в центре города, — но само требование к часам работы это не отменяет. Подробный разбор часов и сумм — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Славянск-на-Кубани — первый разбор блога про равнинную часть края на реке, а не про побережье или предгорье.</li>
      <li>Основной промышленный заказчик — действующий нефтеперерабатывающий завод «Славянск ЭКО» (ИНН 2370000496), с циклом модернизации по соглашениям с Минэнерго России; жилая стройка для сравнения точечная.</li>
      <li>Город стоит в пойме Кубани и Протоки: подтопление — не абстракция, а регулярное событие (последний зафиксированный случай — июнь 2026 года, 1084 га).</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Славянского района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Славянске-на-Кубани так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://zachestnyibiznes.ru/company/ul/1112370000753_2370000496_OOO-SLAVYaNSK-EKO', label: 'zachestnyibiznes.ru — ООО «Славянск ЭКО», ИНН 2370000496, ОГРН 1112370000753' },
      { href: 'https://www.list-org.com/company/6782691', label: 'list-org.com — ООО «Славянск ЭКО», регистрационные данные' },
      { href: 'https://neftegaz.ru/news/neftechim/868950-slavyansk-eko-dinamichno-realizuet-proekty-modernizatsii-predusmotrennye-soglasheniyami-s-minenergo-/', label: 'neftegaz.ru — модернизация «Славянск ЭКО» по соглашениям с Минэнерго России' },
      { href: 'https://www.kommersant.ru/doc/5338443', label: 'kommersant.ru — выручка завода «Славянск ЭКО»' },
      { href: 'https://kub-inform.ru/news/rezhim-chs-obyavili-v-slavyanskom-rayone-zatopleno-1084-ga/', label: 'kub-inform.ru — режим ЧС в Славянском районе, 1084 га подтопленных земель, июнь 2026' },
      { href: 'https://krasnodar.cian.ru/zastroishchik-kubanskaia-krepost-12149/', label: 'cian.ru — застройщик «Кубанская Крепость», проект в Славянске-на-Кубани' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
    ]} />
</BlogArticleLayout>
