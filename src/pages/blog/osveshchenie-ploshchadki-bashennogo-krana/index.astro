---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 117. Девяносто пятая статья блога — угол (a) информационный / how-to.
// Освещение рабочей зоны башенного крана в тёмное время. Не федеральный нормативный
// слой ФНП (закреплён за site-01), а стандарт ССБТ на освещение стройплощадок.
// Фактура — ГОСТ 12.1.046-2014 (текст meganorm.ru, curl, проверено 22.10.2026):
// введён с 01.07.2015 приказом Росстандарта от 18.11.2014 № 1644-ст взамен ГОСТ 12.1.046-85;
// п. 4.2 (машины оборудуют наружным освещением, иначе — установки на корпусах);
// п. 4.4 (рабочее освещение в ночное и сумеречное время; общее равномерное — при норме
// до 10 лк); табл. 1 (периферийная зона 20 лк при 50–100 лк); п. 4.6 (Ra ≥ 20 при 50 лк,
// ≥ 40 свыше 50 лк); табл. 2 (подъём кранами: Г 50 лк на площадках приёма и подачи,
// RGL 50; В 20 лк на крюке во всех положениях со стороны машиниста; немеханизированная
// разгрузка 20 лк; монтаж конструкций В 30 лк; укладка подкрановых путей 30 лк; монтаж
// тросов и блоков 30 лк; подходы 5 лк; автодороги 10 лк); п. 5.3 (без открытых источников),
// 5.6 (пульсация ≤ 20 %), 5.7 (равномерность 0,25 / 0,40 / 0,50), 5.8 (Кз 1,3 LED / 1,5
// разрядные при чистке 2 раза в год), 6.2–6.5 (измерения, участки — в ППР), 4.12 (охранное
// 0,5 лк), 7.5 (молниезащита мачт), 7.6 (мачты выше 50 м — светоограждение, ≥ 2 красных).
// ГОСТ 12.1.046-85 (meganorm.ru): кранами — 10 лк Г и 10 лк В на крюке; общее равномерное
// при норме до 2 лк. Сравнение редакций — собственный разбор КРАН-КУБАНЬ.
// Закон № 608-КЗ (ст. 3.3 в ред. № 5423-КЗ с 01.03.2026) — уже проверен на сайте
// (seysmika-i-zakon-o-tishine): будни 08:00–13:00 и 15:00–23:00.
// Расчёты КРАН-КУБАНЬ: 50 × 1,3 = 65 лк; 50 × 1,5 = 75 лк; 50 × 0,40 = 20 лк; 20 / 10 = 2.
// НЕ названо: время заката в Краснодаре, мощности прожекторов, цены — нет проверенного источника.

const CHECKED = '22 октября 2026 года';
const PUBLISHED = '2026-10-22';

const title = 'Освещение площадки башенного крана: 50 лк и 20 лк на крюке';
const description = 'ГОСТ 12.1.046-2014 требует 50 лк на площадке приёма груза и 20 лк на крюке крана со стороны машиниста. Нормы, запас, замеры и вечерняя смена на Кубани.';
const h1 = 'Какое освещение нужно башенному крану вечером: нормы ГОСТ 12.1.046-2014';
const crumbTitle = 'Освещение площадки башенного крана';
const slug = 'osveshchenie-ploshchadki-bashennogo-krana';

const H2 = [
  'Нормы для крановых работ: таблица ГОСТ',
  'Что изменилось по сравнению с ГОСТ 1985 года',
  'Пример расчёта: сколько люкс закладывать в проект',
  'Прожекторы на кране и мачты на площадке',
  'Замер освещённости перед сменой',
  'Вечерняя смена и закон № 608-КЗ',
  'Памятка заказчику перед тёмной сменой',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая освещённость нужна при работе башенного крана ночью?',
    a: 'По таблице 2 ГОСТ 12.1.046-2014 — не менее 50 лк средней горизонтальной освещённости на площадках приёма и подачи грузов и 20 лк вертикальной освещённости на крюке во всех его положениях со стороны машиниста. КРАН-КУБАНЬ закладывает эти значения в проект освещения до тёмной смены.',
  },
  {
    q: 'Действует ли ещё ГОСТ 12.1.046-85?',
    a: 'Нет. ГОСТ 12.1.046-85 заменён стандартом ГОСТ 12.1.046-2014, который введён в действие с 1 июля 2015 года приказом Росстандарта № 1644-ст. Нормы для крановых работ в новой редакции выше: 50 лк вместо 10 лк на площадке и 20 лк вместо 10 лк на крюке.',
  },
  {
    q: 'Хватит ли прожекторов, установленных на самом кране?',
    a: 'Не всегда. ГОСТ 12.1.046-2014 требует оборудовать строительные машины наружным освещением, но норму в 50 лк проверяют замером на площадке приёма грузов. Если прожекторов башенного крана не хватает, КРАН-КУБАНЬ рекомендует добавить передвижные установки или мачты.',
  },
  {
    q: 'Можно ли работать башенным краном после 21:00 на Кубани?',
    a: 'По статье 3.3 закона Краснодарского края № 608-КЗ в редакции с 1 марта 2026 года шумные строительные работы в будни разрешены с 08:00 до 13:00 и с 15:00 до 23:00. Работа после 21:00 до 23:00 допустима, но в тёмное время площадка должна быть освещена по ГОСТ 12.1.046-2014.',
  },
  {
    q: 'Кто измеряет освещённость на стройплощадке?',
    a: 'ГОСТ 12.1.046-2014 требует контроля освещённости: замер по ГОСТ 24940 (в России действует ГОСТ Р 54944-2012) выполняют перед началом работ на участке и при изменении условий. Участки для замера определяют в проекте производства работ; КРАН-КУБАНЬ сверяет их с зоной обслуживания крана.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Как это работает · Безопасность"
  published={PUBLISHED}
>
    <p slot="intro">ГОСТ 12.1.046-2014 требует для работы грузоподъёмных кранов в тёмное время не менее 50 лк на площадках приёма и подачи грузов и 20 лк на крюке во всех его положениях со стороны машиниста. Для КРАН-КУБАНЬ это рабочая норма вечерней смены: зимой на Кубани заметная часть разрешённого законом № 608-КЗ времени до 23:00 приходится на темноту, и без расчёта освещения башенный кран вечером не работает.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Таблица 2 ГОСТ 12.1.046-2014 задаёт среднюю освещённость для каждого вида работ на стройплощадке, и для башенного крана из неё важны семь строк. Стандарт введён в действие с 1 июля 2015 года приказом Росстандарта от 18 ноября 2014 года № 1644-ст. КРАН-КУБАНЬ выписал строки, относящиеся к монтажу и работе крана; полный перечень участков — в тексте стандарта.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Участок работ</th><th>Плоскость нормирования</th><th>Средняя освещённость, лк</th></tr></thead>
      <tbody>
        <tr><td>Подъём и разгрузка грузов кранами — площадки приёма и подачи</td><td>Горизонтальная</td><td>50</td></tr>
        <tr><td>То же — крюк крана во всех положениях со стороны машиниста</td><td>Вертикальная</td><td>20</td></tr>
        <tr><td>Немеханизированная разгрузка и кантовка</td><td>Горизонтальная</td><td>20</td></tr>
        <tr><td>Монтаж стальных и железобетонных конструкций</td><td>Вертикальная, по высоте сборки</td><td>30</td></tr>
        <tr><td>Укладка подкрановых путей</td><td>Горизонтальная, на уровне земли</td><td>30</td></tr>
        <tr><td>Монтаж тросов и блоков грузоподъёмных механизмов</td><td>Горизонтальная, по высоте сборки</td><td>30</td></tr>
        <tr><td>Подходы к рабочим местам: лестницы, леса, площадки</td><td>Горизонтальная</td><td>5</td></tr>
      </tbody>
    </table></div>
    <p>Строка про монтаж тросов и блоков касается не работы, а сборки башенного крана: если КРАН-КУБАНЬ монтирует КБ-408.21 или Potain MDT 219 J10 в короткий зимний день, запасовку каната при недостатке света переносят на утро или ставят местное освещение на 30 лк. Слепящую блескость стандарт для крановой площадки ограничивает показателем RGL 50.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Нормы для крановых работ в действующем ГОСТ 12.1.046-2014 выросли в пять и в два раза: 50 лк вместо 10 лк на площадке и 20 лк вместо 10 лк на крюке. Прежние значения задавал отменённый ГОСТ 12.1.046-85. Сравнение двух редакций сделала инженерная служба КРАН-КУБАНЬ по текстам обоих стандартов. Новая редакция разработана с учётом европейских EN 12464-1 и EN 12464-2.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Требование</th><th>ГОСТ 12.1.046-85</th><th>ГОСТ 12.1.046-2014</th><th>Рост</th></tr></thead>
      <tbody>
        <tr><td>Площадка приёма и подачи грузов краном</td><td>10 лк</td><td>50 лк</td><td>×5</td></tr>
        <tr><td>Крюк крана со стороны машиниста</td><td>10 лк</td><td>20 лк</td><td>×2</td></tr>
        <tr><td>Порог для одного общего равномерного освещения</td><td>до 2 лк</td><td>до 10 лк</td><td>×5</td></tr>
      </tbody>
    </table></div>
    <p>Практический вывод КРАН-КУБАНЬ: проект освещения, сделанный по старым таблицам или перенесённый с давнего объекта, почти наверняка не дотягивает до действующих норм. Прожекторная мачта, которой хватало на 10 лк, на 50 лк потребует либо больше светильников, либо приближения к площадке приёма грузов.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Проектная освещённость площадки приёма грузов у башенного крана равна 65 лк для светодиодов и 75 лк для разрядных ламп. Норму 50 лк умножают на коэффициент запаса из пункта 5.8 ГОСТ 12.1.046-2014: 1,3 или 1,5 при чистке светильников дважды в год. Пример расчёта инженерной службы КРАН-КУБАНЬ для одной площадки — в таблице.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Показатель</th><th>Светодиоды</th><th>Разрядные лампы</th><th>Основание</th></tr></thead>
      <tbody>
        <tr><td>Норма средней освещённости</td><td>50 лк</td><td>50 лк</td><td>Таблица 2</td></tr>
        <tr><td>Коэффициент запаса</td><td>1,3</td><td>1,5</td><td>Пункт 5.8</td></tr>
        <tr><td>Проектная средняя освещённость</td><td>65 лк</td><td>75 лк</td><td>Расчёт КРАН-КУБАНЬ</td></tr>
        <tr><td>Минимум в точке при равномерности 0,40</td><td>20 лк</td><td>20 лк</td><td>Пункт 5.7, 50 × 0,40</td></tr>
        <tr><td>Периферийная зона шириной от 2 м</td><td>от 20 лк</td><td>от 20 лк</td><td>Таблица 1</td></tr>
      </tbody>
    </table></div>
    <p>Кроме уровня освещённости ГОСТ 12.1.046-2014 ограничивает качество света: коэффициент пульсации не выше 20 %, индекс цветопередачи не ниже 20 при норме 50 лк, открытые источники без светильников запрещены. Для КРАН-КУБАНЬ из этого следует простое правило подбора: светодиодный прожектор с паспортом, где указаны пульсация и Ra, проверяется по документам, а «лампа на проводе» не проходит ни по одному пункту.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пункт 4.2 ГОСТ 12.1.046-2014 требует, чтобы строительные машины были оборудованы наружным освещением, а если машину поставляют без него — чтобы установки на корпусе предусмотрели в проекте освещения. Для башенного крана это прожекторы на башне или стреле, которые светят в зону обслуживания. КРАН-КУБАНЬ проверяет их перед выездом на объект вместе с освещением кабины.</p>
    <p>Прожекторов на кране обычно недостаточно для 50 лк на всей площадке приёма грузов у Potain MDT 219 J10 с вылетом 65 м: свет с высоты слабеет к дальнему краю зоны. Поэтому стандарт допускает общее локализованное освещение со светильниками на зданиях, конструкциях и мачтах. Мачты должны иметь молниезащиту (пункт 7.5), а мачты выше 50 м — светоограждение минимум из двух красных светильников (пункт 7.6); о молниезащите самого крана — в статье <a href="/blog/zazemlenie-i-molniezashchita-bashennogo-krana/">«Заземление и молниезащита башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>ГОСТ 12.1.046-2014 требует измерять освещённость перед началом работ на участке и повторно при изменении условий, например когда башенный кран переходит на новую захватку. Методика замера — ГОСТ 24940, в России действует ГОСТ Р 54944-2012. Установка соответствует нормам, если измеренная средняя освещённость не ниже табличной.</p>
    <p>Участки, где освещённость определяет безопасность, по пункту 6.2 стандарта назначают при разработке проекта производства работ. КРАН-КУБАНЬ сверяет эти участки с зоной обслуживания крана: площадки складирования и подачи, места строповки, приёмные площадки на перекрытиях. Контрольные точки ставят в узлах сетки, шаг которой стандарт ограничивает 10 м; о составе ППР — в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«ППР для башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Статья 3.3 закона Краснодарского края № 608-КЗ в редакции с 1 марта 2026 года разрешает шумные строительные работы в будни с 08:00 до 13:00 и с 15:00 до 23:00. Вечернее окно в восемь часов зимой почти целиком приходится на сумерки и темноту, поэтому освещение для КРАН-КУБАНЬ — условие использования законного времени, а не опция. Подробно режим тишины разобран в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>
    <p>Освещение не расширяет режим работы: прожекторы позволяют работать до 23:00, но не после. Охранное освещение по ГОСТ 12.1.046-2014 — всего 0,5 лк на границе площадки, и его хватает для ночной охраны, но не для подъёмов. Зимние особенности работы крана КРАН-КУБАНЬ собрал в статье <a href="/blog/bashennyi-kran-zimoy/">«Башенный кран зимой на Кубани»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Перед первой тёмной сменой КРАН-КУБАНЬ рекомендует заказчику пройти пять шагов; перечень — рекомендация инженерной службы, а не текст стандарта.</p>
    <ol>
      <li>Найти в ППР участки, где освещённость определяет безопасность, и сверить их с зоной обслуживания крана.</li>
      <li>Заложить проектную освещённость площадки приёма грузов 65 лк для светодиодов или 75 лк для разрядных ламп.</li>
      <li>Проверить прожекторы башенного крана и при нехватке добавить передвижные установки или мачты с молниезащитой.</li>
      <li>Выполнить замер по ГОСТ Р 54944-2012 до начала работ и записать результат.</li>
      <li>Ограничить вечерние подъёмы 23:00 по закону № 608-КЗ.</li>
    </ol>
    <p>Если объект требует работы в тёмное время с первых дней, напишите об этом в заявке через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ учтёт освещение при выборе модели и места установки крана. Мощности прожекторов и стоимость освещения зависят от площадки, поэтому без проекта они не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/2/gost_12_1_046-2014_mezhgosudarstvennyy_standart_sistema.html', label: 'meganorm.ru — ГОСТ 12.1.046-2014 «Нормы освещения строительных площадок»: таблицы 1–3, пп. 4.2–7.6' },
      { href: 'https://meganorm.ru/Data2/1/4294853/4294853569.htm', label: 'meganorm.ru — ГОСТ 12.1.046-85 (отменён): таблица 1 для сравнения редакций' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — закон № 608-КЗ, ст. 3.3 в редакции с 01.03.2026: режим тишины' },
    ]} />
</BlogArticleLayout>
