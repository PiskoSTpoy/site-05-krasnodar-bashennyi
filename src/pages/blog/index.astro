---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';
import { blogPosts } from '../../data/blogPosts';

// Волна 16. Хаб блога был самой тонкой страницей сайта — 76 слов: заголовок,
// одна фраза и две карточки. Теперь это аннотированный указатель: что разбирает
// каждая статья, с какими нормами и числами, и чего в блоге сознательно нет.
// Волна 22: добавлены ещё две статьи — не новая тема, а практическое продолжение
// уже двух существующих (децибелы рядом с часами закона о тишине, сроки/стоимость
// СМР рядом с уже разобранными баллами площадки).
// Волна 69: шестая статья — норд-ост перестал быть двумя фразами на трёх других
// страницах и получил собственный технический разбор (флюгирование, противоугонные
// захваты), не пересекающийся с паспортным нормативом ветра, закреплённым за site-07.
// Волна 71: седьмая статья — первая про внутреннюю (степную) часть края, не про
// побережье. Армавир: действующий промпарк в Северной промзоне (АМК/РИАК,
// «Рустарк») плюс контринтуитивный факт из Приложения Б ТСН 22-302-2000 —
// расчётная сейсмичность площадки почти как в Сочи, хотя до моря 150 км.
// Волна 73: восьмая статья — предгорная ось (после честного нуля Волны 72 на
// третьем «курортном/степном» городе). Горячий Ключ: фоновая сейсмичность 8
// баллов, как на побережье, но материалы генплана округа прямо предписывают
// поднимать балл выше на площадках в оползневой зоне — задокументированной с
// 1983 года в южной части города (обоснование генплана, gorkluch.ru, прочитано
// напрямую через antiword, не через WebFetch-суммаризатор).
// Волна 74: девятая статья — продолжение предгорной оси на Апшеронском районе.
// Генплан Нефтегорского поселения делит площадки на три инженерно-геологических
// категории и поимённо называет 17+ улиц посёлка Нефтегорск в оползневой зоне
// (тот же метод: .doc скачан и прочитан напрямую через antiword+iconv).
// Волна 75: десятая статья — последний кандидат предгорной оси, Мостовской
// район. Генплан Переправненского поселения (mostovskiy.ru) перепрочитан
// напрямую через PyMuPDF: эрозия берегов Ходзи и Лабы (15-60% протяжённости),
// районирование сложности освоения, развилка карт А (7 баллов)/В (8 баллов).
// Коммерческий баланс усилен независимым источником — инвестпорталом района
// (mostov-invest.ru): реализованные проекты («Ахметовский», «Жемчужина
// Предгорья») и свежая (26.12.2025) муниципальная площадка под тепличный
// комплекс в пгт. Мостовской. Прямой curl+regex на сырой HTML этой площадки
// поймал галлюцинацию WebFetch-суммаризатора («станция Кавказская», М29,
// 220 кВ — ни одного слова в исходнике нет).
// Волна 76: одиннадцатая статья — первая про Азовское, а не Черноморское
// побережье края. Ейск: портовый элеватор и растущие терминалы вместо
// отеля/фермы, устойчивый ветер Ейского полуострова (кайт-репутация) вместо
// эпизодической новороссийской боры. Egress сессии не пропускал прямые
// запросы к docs.cntd.ru/base.garant.ru/сайтам администраций (заблокирован
// и для WebFetch, и для curl) — доступен был только WebSearch, и он дал два
// противоречащих ответа про сейсмичность Ейска подряд (похоже на достройку
// по шаблону соседних городов, а не цитату таблицы). Статья сознательно не
// приводит балл сейсмики для этой площадки.

const title = 'Блог: разборы кубанских норм для монтажа крана';
const description =
  'Одиннадцать статей инженерной службы КРАН-КУБАНЬ: изыскания, сейсмика Армавира, Горячего Ключа, Апшеронского и Мостовского районов, закон о тишине, норд-ост, порт Ейска.';

const SITE = 'https://kran-kuban.ru';
const CHECKED = '15 августа 2026 года';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
  ],
};

// Аннотация — не пересказ статьи, а ответ на вопрос «зачем мне это читать»:
// какая норма внутри и какое практическое следствие из неё вытекает.
const annotations: Record<string, { why: string; inside: string[] }> = {
  'izyskaniya-pered-montazhom-krana': {
    why: 'Читать, если площадка нестандартная: побережье, песок, ветреный район — и нужно понять, какие данные о грунте потребуются до подписания договора.',
    inside: [
      'СП 446.1325800.2019 — что именно определяют инженерно-геологические изыскания',
      'Почему у башенного крана и автокрана разные вопросы к одному и тому же грунту',
      'Ветер: почему «норма 15 м/с» из ПБ 10-382-00 больше не норма, а порог берётся из паспорта крана',
      'Когда изыскания уже есть в проекте здания, а когда основание оценивает арендодатель',
    ],
  },
  'seysmika-i-zakon-o-tishine': {
    why: 'Читать перед планированием графика: два региональных фактора, которые меняют и расчёт основания, и часы работы на объекте.',
    inside: [
      'ТСН 22-302-2000 и СП 14.13330.2018 — площадки 7, 8 и 9 баллов',
      'Что изменила редакция закона края №5423-КЗ с 1 марта 2026 года',
      'Рабочие окна 08:00–13:00 и 15:00–23:00 и почему «с 7:00» больше не работает',
      'Размеры штрафов по статье 3.3 для граждан, должностных и юридических лиц',
    ],
  },
  'uroven-shuma-v-decibelah': {
    why: 'Читать, если объект стоит рядом с отелем, санаторием или жилым домом: соблюдение часов закона о тишине не освобождает от отдельного норматива по громкости.',
    inside: [
      'Чем СанПиН 1.2.3685-21 (уровень звука в дБ) отличается от закона №608-КЗ (часы работы)',
      'Кто и как измеряет превышение — методика МУК 4.3.3722-21 и акт замера',
      'Ответственность по статье 6.3 КоАП РФ — отдельно от штрафов по 608-КЗ',
      'Что на площадке с краном реально даёт основной вклад в шум',
    ],
  },
  'seysmicheskoe-mikrorayonirovanie': {
    why: 'Читать, если карта ОСР-2015 недостаточно точна для вашей площадки: как заказать собственную карту сейсмического микрорайонирования, а не гадать по среднему баллу района.',
    inside: [
      'РСН 65-87 — технические требования к производству работ по СМР',
      'Кто вправе выполнять такие изыскания',
      'Сроки — ориентировочно от 20 рабочих дней',
      'Стоимость — ориентировочно от 60 000 ₽ для простой площадки до 1 га',
    ],
  },
  'uroven-otvetstvennosti-obekta': {
    why: 'Читать, если непонятно, почему раздел «Сейсмические зоны» упоминает «уровень ответственности объекта», но нигде не объясняет, откуда он берётся и кто его назначает.',
    inside: [
      '384-ФЗ (ст. 4) — три уровня ответственности: повышенный, нормальный, пониженный',
      'Кто определяет уровень — застройщик или проектировщик, а не арендодатель крана',
      'Ст. 48.1 Градостроительного кодекса — критерий «уникального объекта» (высота более 100 м)',
      'ГОСТ Р 54257-2010 — классы КС-1, КС-2, КС-3 и как уровень выбирает карту ОСР-2015',
    ],
  },
  'kran-vo-vremya-nord-osta': {
    why: 'Читать, если непонятно, что означает фраза «остановка из-за норд-оста» на этапе «Эксплуатация» — что конкретно в этот момент происходит со стрелой и с краном на рельсах.',
    inside: [
      'Приказ Ростехнадзора №533 и ГОСТ 32575.3-2013 — требование к анемометру на кране',
      'Флюгирование: почему стрелу растормаживают, а не блокируют, при усилении ветра',
      'Противоугонные захваты (ГОСТ 1451-77) — отдельная задача для рельсового хода',
      'Эпизод 7–8 февраля 2012 года — как выглядит настоящая бора: 52–60 м/с, −19 °C, 250 тыс. без света',
    ],
  },
  'kran-dlya-promzony-armavira': {
    why: 'Читать, если площадка не на побережье, и кажется, что сейсмический расчёт можно упростить: Армавир — контрпример из официального приложения к краевому нормативу.',
    inside: [
      'Что уже финансируется в Северной промзоне Армавира — литейно-прессовый завод АМК и проект «Рустарк»',
      'Приложение Б ТСН 22-302-2000: Армавир А-8/В-9/С-9 — почти как Сочи и Новороссийск',
      'Почему у соседних Кропоткина и Тихорецка (А-6) сейсмического расчёта вообще нет',
      'Каких курортных факторов (закон о тишине в сезон, ООПТ, норд-ост) в Армавире объективно нет',
    ],
  },
  'kran-dlya-goryachego-klyucha': {
    why: 'Читать, если площадка стоит в южной части Горячего Ключа: базовый балл побережья (8) там не потолок — на оползневом склоне его предписано поднимать выше.',
    inside: [
      'Южная часть города по данным ГУП «Кубаньгеология»: улицы Лермонтова, Шевченко, Достоевского, Нагорная',
      'Требование генплана округа — поднимать балл сейсмичности на оползневых и подтопляемых участках',
      'Оползень 2019 года в ст. Бакинской — что случилось и как городская власть на это отреагировала',
      'Второй, независимый слой — курортный статус и округ горно-санитарной охраны в 3 пояса',
    ],
  },
  'kran-dlya-apsheronskogo-rayona': {
    why: 'Читать, если площадка в Апшеронском районе: генплан поселения делит территорию на три категории сложности освоения, и от неё зависит тип фундамента ещё до расчёта балла сейсмики.',
    inside: [
      'Три инженерно-геологических района — от «усиленный фундамент» до «малопригодно для застройки»',
      '17+ улиц Нефтегорска в зоне оползневых процессов и катастрофа 13-18 января 1978 года',
      'Та же норма увеличения балла сейсмики в оползневой зоне, что и в Горячем Ключе (ТСН 22-302-2000)',
      'Новый тендер на генплан поселения 2025 года и куда адресовано будущее строительство переселения',
    ],
  },
  'kran-dlya-mostovskogo-rayona': {
    why: 'Читать, если объект в Мостовском районе: экономика здесь строит теплицы и фермы, а не отели, и берег Ходзи или Лабы рядом с площадкой — не пейзаж, а вводная для типа фундамента.',
    inside: [
      'Свежая (26.12.2025) муниципальная площадка под тепличный комплекс в пгт. Мостовской',
      'Действующий животноводческий комплекс «Ахметовский» ООО «Агрокомплекс» в ст-це Переправной',
      'Эрозия берегов Ходзи и Лабы — 15-60% протяжённости в зависимости от участка, генплан рекомендует сваи',
      'Развилка карт А (7 баллов) и В (8 баллов) — и почему региональный норматив закрывает её в пользу восьми',
    ],
  },
  'kran-dlya-eyska': {
    why: 'Читать, если объект в Ейске: заказчик здесь чаще порт или элеватор, чем отель, а ветер — не редкий шторм, а фоновый режим почти круглый год.',
    inside: [
      'АО «Ейский портовый элеватор» и рост мощности порта на новых терминалах — по данным «Морских вестей России»',
      'Почему устойчивый азовский ветер требует другой логики резерва в графике, чем эпизодическая новороссийская бора',
      'Тот же паспортный предел ветра (п. 132 ФНП №461), что и на остальном побережье края',
      'Закон №608-КЗ о тишине действует в Ейске так же, как в Сочи и Анапе',
    ],
  },
};

const posts = blogPosts;
---
<BaseLayout title={title} description={description} path="/blog/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Блог</span>
  </nav>

  <header class="dossier wrap" style="padding-top:8px">
    <span class="eyebrow">Блог</span>
    <h1>Разборы, которые не помещаются в этапы</h1>
    <p class="dossier__lead">
      Разборов в блоге сейчас {posts.length}, и все они про Кубань: краевой режим тишины по закону
      №608-КЗ, сейсмический балл площадки в диапазоне 7–9, норд-ост на побережье и то, откуда в этих
      нормах берутся числа. Основное содержание сайта разложено по
      <a href="/etapy/" style="color:var(--accent)">этапам работы крана</a> — там коротко и по делу, а
      сюда уходит то, что в этап не помещается и требует развёрнутого объяснения. Пересказывать своими
      словами федеральный норматив, который и так опубликован, мы не считаем полезным ни для читателя,
      ни для поиска.
    </p>
  </header>

  <section class="section wrap" style="padding-top:clamp(20px,3vw,28px);max-width:880px">
    <div class="posts">
      {posts.map((p) => (
        <article class="card-reg post-card">
          <h2><a href={p.href}>{p.title}</a></h2>
          <p class="post-card__excerpt">{p.excerpt}</p>
          <p class="aside-note post-card__why">{annotations[p.slug]?.why}</p>
          <p class="post-card__label">Что внутри</p>
          <ul class="post-card__list">
            {(annotations[p.slug]?.inside ?? []).map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <p><a class="post-card__more" href={p.href}>Читать разбор <span aria-hidden="true">→</span></a></p>
        </article>
      ))}
    </div>

    <div class="blog-elsewhere">
      <h2>Чего в этом блоге нет — и почему</h2>
      <p>
        Общефедеральный нормативный слой мы не пересказываем. Он одинаков в Краснодаре и в Норильске,
        полностью изложен в первоисточниках, и наш конспект добавил бы к ним только шанс на ошибку
        в цифре. Чтобы не отправлять читателя искать вслепую — вот куда смотреть напрямую:
      </p>
      <ul>
        <li><b>Несущая способность грунта под опорой.</b> Считается проектировщиком по данным изысканий на конкретной площадке. Ни один сайт подрядчика эту цифру не заменяет: она про ваш участок, а не про метод.</li>
        <li><b>Регистрация крана и учёт в Ростехнадзоре.</b> Порядок задан ФНП, утверждёнными приказом Ростехнадзора от 26.11.2020 № 461, и административным регламентом ведомства.</li>
        <li><b>Ветровые ограничения.</b> Предельная скорость для конкретной машины стоит в её паспорте и приоритетна над любым общим числом; распространённый ориентир — 15 м/с и 10 м/с для парусного груза.</li>
      </ul>
      <p>
        Местное явление, которое мы ведём сами, — новороссийская бора: она не норматив, а погодный
        режим побережья, и её влияние на график разобрано на этапе
        <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a>,
        а что технически происходит с краном в этот момент — в статье
        <a href="/blog/kran-vo-vremya-nord-osta/" style="color:var(--accent)">«Кран во время норд-оста»</a>.
      </p>
    </div>

    <div class="blog-elsewhere">
      <h2>Как мы обращаемся с фактурой</h2>
      <p>
        У каждой статьи и каждой страницы с нормами внизу стоит блок источников с датой проверки.
        Это не украшение: нормы меняются, и редакция закона о тишине, действующая с 1 марта 2026 года,
        — свежий тому пример. Дата проверки говорит читателю, на какой момент мы держали факт в руках,
        а ссылка позволяет перепроверить нас, а не поверить на слово.
      </p>
      <p>
        Обратная сторона того же правила: если факт не подтверждается, он снимается с сайта. Так
        произошло с конкретной цифрой предельной высоты застройки в историческом центре Краснодара —
        она стояла на трёх страницах, при перепроверке первоисточник не нашёлся, и цифра убрана.
        Сам градостроительный фактор остался и описан без чисел, со ссылкой на действующий приказ.
        Мы считаем, что честнее назвать фактор без цифры, чем оставить цифру без подтверждения.
      </p>
    </div>

    <Sources checked={CHECKED} label="Нормы в статьях сверены" items={[
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018, карты ОСР-2015' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — закон №5423-КЗ и режим тишины с 01.03.2026' },
      { href: 'https://meganorm.ru/Data2/1/4293728/4293728630.htm', label: 'meganorm.ru — СП 446.1325800.2019' },
      { href: 'https://docs.cntd.ru/document/573500115', label: 'docs.cntd.ru — СанПиН 1.2.3685-21, уровень шума на территории жилой застройки' },
      { href: 'https://znaytovar.ru/gost/2/RSN_6587_Inzhenernye_izyskaniy.html', label: 'РСН 65-87 — технические требования к сейсмическому микрорайонированию' },
      { href: 'https://base.garant.ru/12172032/', label: '384-ФЗ — уровни ответственности зданий и сооружений' },
      { href: 'https://docs.cntd.ru/document/1200083899', label: 'ГОСТ Р 54257-2010 — классы КС-1, КС-2, КС-3' },
    ]} />
  </section>
</main>
<style>
  /* minmax(0, 1fr), а не просто grid: у колонки со значением `auto`/`1fr`
