  .post-card__why { color: var(--ink); max-width: 68ch; }
  .post-card__label { margin-top: 22px; padding-top: 12px; border-top: 1px solid var(--line); font-family: var(--text); font-size: var(--t-rubric); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .post-card__list { margin: 12px 0 0; padding-left: 20px; font-family: var(--text); font-size: var(--t-aux); color: #3D362E; }
  .post-card__list li + li { margin-top: 6px; }
  .post-card__more {
    display: inline-block; margin-top: 18px; color: var(--accent); font-weight: 700;
    font-size: var(--t-note); font-family: var(--text); text-decoration: none; letter-spacing: .02em;
    background-image: linear-gradient(var(--accent), var(--accent));
