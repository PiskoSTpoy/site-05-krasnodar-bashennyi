    padding-bottom: 2px; transition: background-size .18s ease;
  }
  .post-card__more:hover, .post-card__more:focus-visible { background-size: 100% 1px; }
  @media (prefers-reduced-motion: reduce) { .post-card__more { transition: none; } }
</style>
</BaseLayout>
