---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 77. Двенадцатая статья блога — Туапсе. Ещё один город Черноморского
// побережья (после Анапы, Новороссийска, Сочи), но не курортный дубль: узел
// портовой перевалки между двумя уже разобранными городами и собственная,
// туапсинская бора — тот же класс явления, что норд-ост Новороссийска, но
// другой перевал и другой механизм.
//
// Сейсмика для Туапсе в статье сознательно не приведена числом: сетевой
// доступ сессии не пропускал прямые запросы к docs.cntd.ru и к первоисточнику
// списка населённых пунктов ОСР-97 (seismos-u.ifz.ru) — только WebSearch, и
// прямого цитирования строки Туапсе из Приложения Б ТСН 22-302-2000 в выдаче
// не нашлось (только косвенное упоминание соседней Джубги). Та же ситуация,
// что и с Ейском в Волне 76 — решение то же: назвать фактор без числа.
//
// Экономический слой (ТМТП, Туапсинский балкерный терминал) проверен по
// нескольким независимым реестрам (list-org, star-pro) и отраслевым изданиям
// (portnews.ru, Ассоциация морских торговых портов); инвестиционные цифры —
// с оговоркой «по данным», а не как точная цитата первоисточника, который
// сессия не могла открыть напрямую.

const CHECKED = '3 сентября 2026 года';

const title = 'Кран для Туапсе: балкерный терминал порта и своя, туапсинская бора';
const description = 'Туапсе — не только курорт между Сочи и Новороссийском: глубоководный порт с растущим балкерным терминалом и собственная бора через Гойтхский перевал, которую не стоит путать с новороссийской.';
const h1 = 'Кран для Туапсе: балкерный терминал порта и своя, туапсинская бора';
const crumbTitle = 'Кран для Туапсе';
const slug = 'kran-dlya-tuapse';

const H2 = [
  'Туапсе — порт между Сочи и Новороссийском, а не только курорт',
  'ТМТП и балкерный терминал: где сейчас нужен кран',
  'Туапсинская бора: соседка новороссийской, но не она',
  'Сейсмика: что мы можем сказать про Туапсе, а что — нет',
  'Закон о тишине в курортно-портовом городе',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Туапсинская бора требует другого паспортного предела ветра для крана, чем новороссийская?',
    a: 'Нет, предел один и тот же на весь край: работы прекращают при скорости ветра, превышающей предельную, указанную в паспорте конкретной машины (п. 132 ФНП №461) — разобрано в статье «Инженерные изыскания перед монтажом крана». Разница между двумя борами не в норме, а в механизме: новороссийская связана с Маркотхским перевалом, туапсинская — с более низким и узким Гойтхским, и рождается по той же схеме перелива холодного воздуха, что описана для норд-оста в статье «Кран во время норд-оста», но как самостоятельное местное явление, а не тот же самый ветер под другим именем.',
  },
  {
    q: 'Какой балл сейсмичности у площадки в Туапсе?',
    a: 'Мы сознательно не называем здесь конкретное число. Общий норматив ТСН 22-302-2000 действует на весь край, и соседние Сочи и Новороссийск задокументированы в статье «Инженерные изыскания перед монтажом крана» на уровне 8-9 баллов, но для Туапсе в этой волне не нашлось прямой цитаты строки из Приложения Б, которой можно доверять без оговорок. Прежде чем закладывать конкретную цифру в проект основания, площадку в Туапсе стоит уточнить в самом своде правил или заказать индивидуальное сейсмическое микрорайонирование (подробнее — в статье «Сейсмическое микрорайонирование площадки»), а не опираться на общее сходство с соседними городами.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Туапсе', item: `${SITE}/blog/kran-dlya-tuapse/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-tuapse/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-tuapse/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал три города Черноморского побережья края — Анапу, Новороссийск и Сочи — и Туапсе на первый взгляд похож на очередной курортный пункт между ними на той же трассе. На деле это отдельный узел с собственной экономикой и собственной погодой: глубоководный порт с круглогодичной навигацией, который перерабатывает не туристов, а нефтепродукты, уголь, руду и удобрения, и локальный ветровой феномен, который меняет название и механизм в зависимости от того, через какой перевал переливается холодный воздух. Для монтажа крана оба факта практичнее, чем «курортный город между двух других курортных городов».</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Туапсе стоит в устье реки Туапсе, на полпути между Сочи и Новороссийском, и совмещает две функции, которые в большинстве городов побережья края разделены: здесь одновременно курортная набережная с пляжами и один из немногих незамерзающих глубоководных портов Чёрного моря на российском берегу. Портовая часть города старше туристической и определяет экономику района не меньше, чем пляжный сезон — это отличает Туапсе от Анапы, где курортная функция и есть основная, и роднит его скорее с Новороссийском, только в существенно меньшем масштабе.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Основной стивидорный оператор порта — АО «ТМТП» (Туапсинский морской торговый порт), зарегистрированное юридическое лицо с уставным капиталом свыше 350 млн рублей; статус и реквизиты компании подтверждаются независимо в нескольких открытых реестрах. Порт исторически специализируется на перевалке нефтепродуктов, угля, руды, чёрных и цветных металлов, сахара и других навалочных и генеральных грузов, а с августа 2020 года управление операционной деятельностью передано ООО «Управление транспортными активами».</p>
    <p>Рядом с самим портом на той же площадке работает ООО «Туапсинский балкерный терминал» — по данным отраслевых источников, с середины 2024 года управляющей организацией терминала выступает АО «Портовый Альянс» (та же группа, что управляет Мурманским морским торговым портом и Мурманским балкерным терминалом). По данным Ассоциации морских торговых портов, за 2023-2025 годы в модернизацию терминала и ремонтную программу было направлено порядка 1,3 млрд рублей, а среднесрочный план предполагает рост перевалочной мощности примерно на четверть к 2030 году; отраслевое издание portnews.ru отдельно сообщало о росте ёмкости склада навалочных грузов ТМТП примерно на 32% к июню 2025 года. Это тот же тип заказчика, что уже разобран в статье про Ейск: кран здесь нужен не на один жилой корпус, а периодически — под расширение причальных сооружений, складов и перегрузочной инфраструктуры.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>В статье «Кран во время норд-оста» уже разобрана новороссийская бора — холодный ветер, стекающий через невысокий Маркотхский перевал в Цемесскую бухту. У Туапсе есть собственный аналог того же класса явления, но с другим механизмом: по определению отраслевого словаря ветров, туапсинская бора — тоже холодный северо-восточный ветер боратипа, но рождается он перетеканием воздуха через ещё более низкий (порядка 300 м) и узкий (порядка 6 км) Гойтхский перевал вдоль речной долины. Это не тот же самый норд-ост под другим именем, а отдельное местное явление со своей географией — сходство в категории (бора), а не в конкретном перевале и не в конкретной розе направлений.</p>
    <p>Для графика монтажа крана практический вывод тот же, что и в Новороссийске: норматив по остановке работ единый на весь край и привязан не к названию местного ветра, а к паспортному пределу конкретной машины (п. 132 ФНП №461). Меняется не порог, а то, о каком именно погодном событии стоит спрашивать метеослужбу перед планированием монтажа в этом конкретном городе.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Часть побережья края, включая Сочи, задокументирована в статье «Инженерные изыскания перед монтажом крана» на уровне сейсмичности 8-9 баллов по картам ОСР-2015 и территориальным нормам ТСН 22-302-2000. Туапсе географически стоит на той же прибрежной сейсмической оси между Новороссийском и Сочи, и было бы удобно предположить для него ту же цифру по аналогии. Мы сознательно этого не делаем: доступ этой сессии к первоисточнику — конкретной строке Туапсе в обязательном Приложении Б ТСН 22-302-2000 — не открылся, а косвенные упоминания в выдаче поиска касались соседней Джубги, а не самого Туапсе, и достраивать чужую строку таблицы по географическому соседству мы считаем менее честным, чем оставить факт без числа. Для площадки в Туапсе расчётный балл нужно смотреть в самом своде правил напрямую или заказывать индивидуальное сейсмическое микрорайонирование — как разобрано в статье «Сейсмическое микрорайонирование площадки».</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края от 23 июля 2003 года №608-КЗ (в редакции закона №5423-КЗ, действующей с 1 марта 2026 года) — региональный, а не местный, и действует в Туапсе так же, как в Сочи, Анапе или Ейске: часы шумных работ и штрафы по статье 3.3 одинаковы для всего края. Курортная набережная Туапсе, растянутая на десятки километров вдоль побережья, добавляет не другую норму, а более высокую вероятность жалобы в летний сезон — та же логика, что уже разобрана для Ейска и подробно изложена в статье «Сейсмика и закон о тишине на Кубани». Для площадки, привязанной к портовой, а не пляжной инфраструктуре, риск жалобы объективно ниже, но закон при этом действует ровно тот же.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Туапсе — не курортный дубль Анапы или Сочи, а глубоководный порт с круглогодичной навигацией между двумя уже разобранными городами блога.</li>
      <li>Основной заказчик крана здесь — портовая инфраструктура: АО «ТМТП» и ООО «Туапсинский балкерный терминал» (под управлением АО «Портовый Альянс»), с продолжающейся модернизацией причалов и складов.</li>
      <li>Туапсинская бора — самостоятельное местное явление через Гойтхский перевал, не то же самое, что новороссийская бора через Маркотхский; паспортный предел ветра (п. 132 ФНП №461) для крана при этом один и тот же на весь край.</li>
      <li>Сейсмический балл площадки для Туапсе в статье намеренно не назван: первоисточник строки Приложения Б ТСН 22-302-2000 не открылся этой сессии, а достраивать цифру по аналогии с соседними городами мы не считаем корректным.</li>
      <li>Закон о тишине №608-КЗ (ред. №5423-КЗ) действует в Туапсе так же, как на остальном побережье края.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.list-org.com/company/7082', label: 'list-org.com — АО «ТМТП» (Туапсинский морской торговый порт), реестровые данные' },
      { href: 'https://star-pro.ru/proverka-kontragenta/organization/1032313060427', label: 'star-pro.ru — ООО «Туапсинский Балкерный Терминал», ИНН 2322027681' },
      { href: 'https://www.morport.com/rus/news/tuapsinskiy-balkernyy-terminal-vlozhil-13-mlrd-rubley-v-modernizaciyu-i-planiruet-narastit', label: 'morport.com — Ассоциация морских торговых портов: инвестиции в модернизацию терминала и план роста мощности' },
      { href: 'https://portnews.ru/news/373304/', label: 'portnews.ru — рост ёмкости склада навалочных грузов ТМТП к июню 2025 года' },
      { href: 'https://komimeteo.ru/encyclopedia/termin1351.html', label: 'komimeteo.ru — словарь ветров: определение туапсинской боры и Гойтхский перевал' },
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/', label: 'приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026), п. 132 — прекращение работ по ветру по паспорту ПС' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — закон №5423-КЗ и режим тишины с 01.03.2026' },
    ]} />
</BlogArticleLayout>
