---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 95. Тридцать первая статья блога — угол (b) коммерческий/
// сравнительный. Вопрос заказчика «сколько стоит аренда башенного крана»
// почти всегда задаётся про месячную ставку, а объявления и сметы
// сравнивают несравнимое: у одного в цену входит монтаж, у другого нет.
// Статья раскладывает смету на строки и показывает три строки, которые
// добавляет именно Краснодарский край (сейсмика основания, окна закона
// о тишине, погодные простои побережья).
//
// Фактура (WebSearch/WebFetch 24.09.2026):
// - perevozka24.com, раздел «башенные краны», Краснодар: объявления от
//   120 000 ₽/мес (Potain 8 т) до 500 000 ₽/мес (QTZ-80), КБ-408.21 —
//   330 000 ₽/мес, демонтаж — 20 000 ₽/сутки; большинство объявлений —
//   «цена договорная». Цифры даём как срез объявлений агрегатора на дату,
//   не как рыночную «среднюю».
// - kranauto.ru (Москва, FAQ арендодателя): «Монтаж, демонтаж и техническое
//   обслуживание оборудования оказываются дополнительно»; комплект анкеров,
//   как правило, оплачивается отдельно.
// - smetnoedelo.ru: в сметной практике перебазировка (доставка, монтаж
//   с наладкой приборов, демонтаж, вывоз) учитывается отдельной строкой,
//   не в стоимости эксплуатации машины.
// - СМР: от ~60 000 ₽ и от 20 рабочих дней — перенесено со ссылкой из уже
//   опубликованной статьи «Сейсмическое микрорайонирование» (innoter.com).
// - Окна закона №608-КЗ: 5 + 8 часов в будни, 3 + 8 в выходные — та же
//   арифметика, что на этапе «Эксплуатация и режим тишины».

const CHECKED = '24 сентября 2026 года';

const title = 'Смета аренды башенного крана: что кроме месячной ставки';
const description = 'Из чего складывается цена аренды башенного крана на Кубани: ставка, перебазировка, основание, сейсмический расчёт и часы закона о тишине.';
const h1 = 'Смета аренды башенного крана на Кубани: что стоит за месячной ставкой';
const crumbTitle = 'Смета аренды башенного крана';
const slug = 'smeta-arendy-bashennogo-krana';

const H2 = [
  'Почему два предложения нельзя сравнивать по ставке',
  'Строка 1. Месячная ставка и что в неё входит',
  'Строка 2. Перебазировка: доставка, монтаж, демонтаж, вывоз',
  'Строка 3. Основание: фундамент, путь или анкеровка',
  'Кубанская строка: сейсмический расчёт и карта СМР',
  'Кубанская строка: сколько часов в оплаченном месяце',
  'Кубанская строка: погодные простои побережья',
  'Как сравнить два предложения: чек-лист',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const rows = [
  { line: 'Месячная ставка', who: 'Арендодатель', note: 'Есть ли в ней машинист, ТО, страхование' },
  { line: 'Перебазировка', who: 'Арендодатель', note: 'Доставка, монтаж, демонтаж, вывоз — часто отдельной суммой' },
  { line: 'Основание', who: 'По договору', note: 'Фундамент или путь, анкеры — кто делает и кто платит' },
  { line: 'Сейсмический расчёт и СМР', who: 'Заказчик / проектировщик', note: 'Балл площадки 7–9 меняет нагрузку на основание' },
  { line: 'Рабочие часы', who: 'Закон №608-КЗ', note: 'Ставка за месяц, работа — только в разрешённые окна' },
  { line: 'Погодные простои', who: 'Площадка', note: 'Норд-ост на побережье, жара летом' },
];

const faqs = [
  {
    q: 'Сколько стоит аренда башенного крана в Краснодаре в месяц?',
    a: 'Точной рыночной цифры нет: большинство арендодателей пишет «цена договорная». По объявлениям на агрегаторе perevozka24 на 24 сентября 2026 года разброс — от 120 000 до 500 000 рублей в месяц в зависимости от модели, КБ-408.21 предлагают за 330 000 рублей в месяц. Но это только ставка: монтаж, демонтаж и основание в неё обычно не входят.',
  },
  {
    q: 'Входит ли монтаж крана в месячную ставку?',
    a: 'Чаще нет. Арендодатели прямо пишут, что монтаж, демонтаж и техническое обслуживание оказываются дополнительно, а в сметной практике перебазировка крана учитывается отдельной строкой. Встречаются и предложения «всё включено» — поэтому состав цены нужно уточнять письменно до сравнения.',
  },
  {
    q: 'Кто платит за сейсмический расчёт фундамента крана?',
    a: 'Это определяет договор. Исходные данные — уровень ответственности объекта и балл площадки — даёт застройщик или проектировщик. Если нужна отдельная карта сейсмического микрорайонирования, её заказывают у изыскательской организации, и это отдельная сумма и отдельный срок в графике.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Первый вопрос почти любого заказчика — «сколько стоит кран в месяц». Вопрос понятный, но ответ на него мало что говорит о бюджете. Башенный кран не приезжает на смену, как автокран: его привозят, собирают на подготовленном основании, держат на объекте месяцами, потом разбирают и увозят. У каждого из этих шагов своя цена. А в Краснодарском крае к ним добавляются три строки, которых нет в сметах большинства регионов.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Если открыть объявления об аренде башенных кранов в Краснодаре, разброс цен окажется огромным. На агрегаторе perevozka24 на дату проверки встречались предложения от 120 000 рублей в месяц (Potain на 8 тонн) до 500 000 рублей в месяц (QTZ-80). КБ-408.21 предлагали за 330 000 рублей в месяц, демонтаж крана в одном из объявлений — за 20 000 рублей в сутки. Большинство же арендодателей цену не называют вовсе и пишут «договорная».</p>
    <p>Разница в четыре раза объясняется не только моделью. В одних предложениях ставка «голая», в других в неё уже включены доставка, монтаж и машинист. Сравнивать такие цифры напрямую — всё равно что сравнивать цену автомобиля с ценой автомобиля вместе с растаможкой и доставкой. Поэтому смету полезно разложить по строкам.</p>

    <div class="rule-table-wrap" style="margin-bottom:24px">
      <table class="rule-table">
        <caption style="text-align:left;margin-bottom:8px">Строки сметы башенного крана на Кубани</caption>
        <thead>
          <tr><th scope="col">Строка</th><th scope="col">От кого зависит</th><th scope="col">Что уточнить</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.line}</td><td>{r.who}</td><td>{r.note}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Месячная ставка — плата за то, что кран стоит на вашем объекте и готов к работе. Главный вопрос к ней: что входит. Работает ли кран с машинистом арендодателя или машиниста даёт заказчик. Кто отвечает за плановое техническое обслуживание во время аренды и за ремонт при поломке. Оплачивается ли полный месяц или можно закрыть неполный по дням. Ответы на эти вопросы меняют смету сильнее, чем разница в ставке в 20-30 тысяч рублей.</p>
    <p>Ставка зависит и от класса машины. В <a href="/park/">парке техники</a> разобраны пять моделей — от быстромонтируемого giraFFe SMK-5.66 до приставного КБ-674А для объектов выше 70 метров. Кран «на вырост», с запасом по высоте и вылету, обходится дороже, и этот запас окупается только там, где он действительно нужен.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Перебазировка — это весь путь крана до объекта и обратно: погрузка на базе, перевозка, монтаж с наладкой приборов безопасности, а в конце аренды — демонтаж и вывоз. В сметной практике эти затраты учитывают отдельной строкой, а не в стоимости работы машины. Арендодатели тоже часто пишут прямо: монтаж, демонтаж и техническое обслуживание оказываются дополнительно.</p>
    <p>Для короткого объекта эта строка может оказаться сопоставимой с несколькими месяцами аренды. Поэтому на объектах на несколько недель выгоднее смотреть в сторону быстромонтируемого крана: он встаёт за часы, а не за дни, и экономит именно на монтаже и демонтаже. Когда кран уезжает с площадки и сколько на это нужно времени, разобрано на этапе <a href="/etapy/demontazh-i-perebazirovka/">«Демонтаж и перебазировка»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Башенному крану нужно основание: монолитный фундамент, рельсовый путь или крепление к зданию. Это отдельная строительная работа со своей сметой, и её часто забывают при сравнении предложений. Мелочь, которая влияет на сумму: комплект анкеров для фундамента, как правило, оплачивается отдельно, а бесплатно его дают только при долгосрочной или крупной аренде. Кто делает основание и кто за него платит — заказчик или арендодатель, — должно быть записано в договоре. Что проверяют до его устройства, разобрано на этапе <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Первая строка, которую добавляет именно Кубань, — сейсмика. Расчётная сейсмичность площадок края лежит в диапазоне 7–9 баллов, и каждый балл удваивает расчётное ускорение: 0,1g при семи, 0,2g при восьми, 0,4g при девяти. Фундамент или анкеровку крана на площадке в девять баллов считают на вдвое большую горизонтальную нагрузку, чем в восемь. Это прямо отражается на объёме бетона, арматуры и на цене основания.</p>
    <p>Если по площадке нужна карта сейсмического микрорайонирования, добавляется ещё одна сумма и ещё один срок. По публичным ориентирам изыскательских организаций это от 60 000 рублей для простого участка до одного гектара и от 20 рабочих дней. Подробности — в статьях <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование площадки»</a> и <a href="/blog/uroven-otvetstvennosti-obekta/">«Уровень ответственности объекта»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Вторая кубанская строка не видна в смете, но влияет на неё сильнее многих. Ставка платится за календарный месяц, а шумные строительные работы по закону №608-КЗ разрешены не круглые сутки. В будни это окна с 08:00 до 13:00 и с 15:00 до 23:00 — пять и восемь часов, всего 13. В выходные и праздники утреннее окно начинается в 10:00, и остаётся 11 часов.</p>
    <p>Практический вывод для бюджета: стоимость одного часа работы крана считают от разрешённых часов, а не от 24 часов в сутки. Тот же кран в регионе без таких ограничений мог бы работать в две полные смены. Здесь вторая смена упирается в 23:00, и сократить срок аренды за счёт ночных работ не получится. Срок стройки, а значит и число оплаченных месяцев, нужно считать с учётом этих окон с самого начала. Подробный разбор — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Третья строка — погода. На побережье, в первую очередь в Новороссийске, норд-ост может остановить кран на целые дни: при сильном ветре кран переводят в режим свободного вращения стрелы, и подъёмы невозможны. Эти дни — оплаченное время без работы. Летом по всему краю добавляется жара: в мае 2026 года в Краснодаре было +41 °C. Кран при этом может работать, но темп бригады падает. Как собрать смену в жару, разобрано в статье <a href="/blog/bashennyi-kran-v-zharu/">«Башенный кран в жару»</a>, а поведение крана при боре — в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <ul>
      <li>Какая модель и какая высота подъёма и вылет предложены — и нужен ли этот запас объекту.</li>
      <li>Входят ли в ставку машинист, техобслуживание и ремонт при поломке.</li>
      <li>Сколько стоит перебазировка: доставка, монтаж, демонтаж и вывоз — одной суммой или по частям.</li>
      <li>Кто делает основание и кто платит за анкеры.</li>
      <li>На какой балл сейсмичности считали основание и откуда взяли этот балл.</li>
      <li>Как оплачивается неполный месяц в начале и в конце аренды.</li>
      <li>Как оплачиваются дни простоя из-за ветра.</li>
    </ul>
    <p>Если по всем пунктам есть письменный ответ, предложения можно сравнивать честно. Площадку и сроки можно прислать через <a href="/#order">форму на главной</a> — разложим смету по тем же строкам.</p>

    <h2 id={headings[8].id} style="margin:36px 0 16px">{headings[8].text}</h2>
    <ul>
      <li>Месячная ставка — только одна строка сметы. По объявлениям в Краснодаре разброс — от 120 до 500 тысяч рублей в месяц, большинство пишет «договорная».</li>
      <li>Перебазировка (доставка, монтаж, демонтаж, вывоз) обычно считается отдельно.</li>
      <li>Основание и анкеры — отдельная строительная работа. Кто её делает, фиксирует договор.</li>
      <li>Сейсмика 7–9 баллов меняет нагрузку на основание вдвое на каждый балл, а карта СМР — это ещё от 60 000 рублей и от 20 рабочих дней.</li>
      <li>Закон №608-КЗ оставляет 13 рабочих часов в будни и 11 в выходные. Срок аренды считают от них.</li>
      <li>Норд-ост и жара — оплаченное время с меньшей работой или без неё.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://perevozka24.com/krasnodar-23/arenda-stroitelnogo-oborudovaniya-bashennye-krany', label: 'perevozka24.com — объявления об аренде башенных кранов в Краснодаре' },
      { href: 'https://www.kranauto.ru/vopros/montazh-i-demontazh-vhodyat-v-cenu/', label: 'kranauto.ru — входят ли монтаж и демонтаж в цену аренды крана' },
      { href: 'https://www.kranauto.ru/vopros/ankera-vhodyat-v-cenu/', label: 'kranauto.ru — входят ли анкеры в стоимость монтажа и перебазировки' },
      { href: 'https://smetnoedelo.ru/vopros-otvet/zatraty-po-perevozke-na-stroyku-bashennogo-krana.html', label: 'smetnoedelo.ru — затраты на перебазировку башенного крана в смете' },
      { href: 'https://innoter.com/services/prochee/seysmicheskoe-mikrorayonirovanie/', label: 'innoter.com — сроки и стоимость сейсмического микрорайонирования' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
