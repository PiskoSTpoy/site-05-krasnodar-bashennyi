---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 101. Сорок седьмая статья блога — угол (a) информационная/how-to.
// Заземление и молниезащита башенного крана: тема, которой нет в блоге, а грозовой
// сезон на Кубани — реальный риск для площадки.
//
// Фактура — проверена 30.09.2026 (WebSearch + WebFetch zandz.com):
// - сопротивление заземляющего устройства не более 4 Ом (ПУЭ, п. 1.7.101; для сети 380 В);
// - кран заземляют не менее чем в двух точках, как правило через рельсы;
// - СО 153-34.21.122-2003, п. 3.2.1.2 и 3.2.2.5: кран не требует отдельных молниеприёмников,
//   сам является естественным молниеприёмником;
// - кабина металлическая — экран; сиденье из диэлектрика, на полу диэлектрическое покрытие.
// Периодичность замеров и зоны защиты НЕ называю — источник их не даёт.

const CHECKED = '30 сентября 2026 года';
const PUBLISHED = '2026-09-30';

const title = 'Заземление и молниезащита башенного крана: что проверяют';
const description = 'Сопротивление заземления крана — не более 4 Ом, точек заземления не меньше двух. Как заземляют кран на рельсах и на фундаменте, зачем молниезащита.';
const h1 = 'Как заземляют башенный кран и нужна ли ему молниезащита?';
const crumbTitle = 'Заземление и молниезащита крана';
const slug = 'zazemlenie-i-molniezashchita-bashennogo-krana';

const H2 = [
  'Зачем крану заземление и что оно защищает',
  'Сколько Ом и в скольких точках',
  'Как заземляют кран на рельсах и на фундаменте',
  'Нужна ли молниезащита башенному крану',
  'Что сделать до пуска крана в работу',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какое сопротивление заземления должно быть у башенного крана?',
    a: 'Для сети 380 В сопротивление заземляющего устройства башенного крана должно быть не более 4 Ом по п. 1.7.101 ПУЭ. Значение проверяют замером на площадке до пуска. КРАН-КУБАНЬ включает замер в подготовку любого крана из парка: без положительного результата кран не получает напряжение.',
  },
  {
    q: 'Сколько точек заземления нужно башенному крану?',
    a: 'Башенный кран заземляют не менее чем в двух точках. У крана на рельсовом пути, например КБ-408.21, это обычно две точки на рельсах, чтобы разрыв в одном месте не оставил кран без заземления. Для кранов на фундаменте схему заземлителя задаёт проект электроснабжения площадки.',
  },
  {
    q: 'Нужен ли молниеотвод на башенный кран?',
    a: 'Отдельные молниеприёмники крану не требуются: по СО 153-34.21.122-2003 (п. 3.2.1.2 и 3.2.2.5) металлическая конструкция крана сама служит естественным молниеприёмником. Условие одно — исправное заземление. Поэтому для КРАН-КУБАНЬ молниезащита крана сводится к качеству заземляющего устройства, а не к штырю на оголовке.',
  },
  {
    q: 'Что делает машинист во время грозы?',
    a: 'Приближение грозы считают основанием остановить работу: груз опускают, стрелу ставят во флюгерное положение, кран отключают. Кабина крана КРАН-КУБАНЬ металлическая и работает как экран, но это защита на случай удара, а не разрешение продолжать подъёмы. Порядок действий для конкретной модели машинист берёт из паспорта и инструкции.',
  },
  {
    q: 'Кто выполняет замер сопротивления заземления крана?',
    a: 'Замер выполняет электролаборатория специальным прибором, результат оформляют протоколом, который прикладывают к документам на кран. КРАН-КУБАНЬ согласует с заказчиком, кто из подрядчиков площадки приглашает лабораторию, чтобы протокол лежал на руках к моменту пуска крана.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Электробезопасность"
  published={PUBLISHED}
>
    <p slot="intro">Заземляющее устройство башенного крана должно давать сопротивление не более 4 Ом по ПУЭ, а сам кран заземляют не меньше чем в двух точках. Отдельный молниеотвод на кран не ставят: его металлическая конструкция служит естественным молниеприёмником, если заземление исправно. КРАН-КУБАНЬ проверяет это до пуска любой модели парка.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Башенный кран на стройплощадке — самый высокий металлический предмет вокруг и самый мощный потребитель электричества на объекте. Заземление КРАН-КУБАНЬ рассматривает как две защиты в одной: от поражения током при пробое изоляции на корпус и от последствий грозового разряда. Если корпус крана оказался под напряжением, ток должен уйти в землю по проводнику, а не через человека, который держится за поручень или стоит на рельсе.</p>
    <p>Грозовой сезон на Кубани делает вопрос практическим, а не формальным. Разряд в металлоконструкцию идёт по мачте и раме вниз, и от надёжного пути в землю зависит судьба электроприводов, кабины и людей на площадке. Инженерная служба КРАН-КУБАНЬ включает заземление в проверку готовности крана вместе с проверкой основания и ограничителей, как на этапе <a href="/etapy/proekt-i-ppr/">«Проект и ППР»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Норма по сопротивлению для башенного крана — не более 4 Ом: это значение задаёт пункт 1.7.101 ПУЭ для сети 380 В. Сопротивление измеряют между заземляющим устройством и землёй, и чем оно ниже, тем быстрее ток замыкания уходит с корпуса. Для кранов КРАН-КУБАНЬ, питающихся от трёхфазной сети 380 В, это рабочий порог: результат выше 4 Ом означает, что кран напряжение не получает.</p>
    <p>Требование «не менее двух точек» объясняется просто. Одна точка заземления — единственное звено: оборвался проводник или окислилось соединение, и кран остался без защиты, а внешне ничего не изменилось. Две независимые точки дают запас, поэтому КРАН-КУБАНЬ на рельсовом пути подключает заземляющие проводники в двух местах и проверяет перемычки между стыками рельсов.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Способ заземления зависит от основания, поэтому у пяти моделей парка КРАН-КУБАНЬ он выглядит по-разному. Кран на рельсовом пути заземляют, как правило, через сами рельсы, но при условии, что стыки соединены перемычками, а путь подключён к контуру. Кран на монолитном фундаменте получает заземлитель по проекту электроснабжения площадки: закладные детали фундамента подключают к контуру ещё до монтажа.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель парка</th><th>Основание</th><th>Что проверяют при заземлении</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>рельсовый путь</td><td>две точки на рельсах, перемычки стыков</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>путь или фундамент</td><td>по основанию: рельсы или заземлитель фундамента</td></tr>
        <tr><td>Potain MCH 175</td><td>путь или фундамент</td><td>по основанию: рельсы или заземлитель фундамента</td></tr>
        <tr><td>КБ-674А</td><td>фундамент и анкеровка к зданию</td><td>заземлитель фундамента, связь с каркасом здания по проекту</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>опорный контур 4×4 м</td><td>отдельный заземлитель у контура, замер после установки</td></tr>
      </tbody>
    </table></div>
    <p>Быстромонтируемый giraFFe SMK-5.66 требует особого внимания: фундамента у него нет, а значит, нет и готового заземлителя. КРАН-КУБАНЬ поэтому планирует заземлитель при установке крана и делает замер сразу после монтажа, который занимает 4–6 часов. Приставной КБ-674А заземляют вместе с фундаментом, а связь с металлическим каркасом здания оговаривают в проекте, чтобы не получить два разных потенциала.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Молниезащиту башенного крана отдельными молниеприёмниками не выполняют: по СО 153-34.21.122-2003 (пункты 3.2.1.2 и 3.2.2.5) кран сам служит естественным молниеприёмником. Металлическая мачта и стрела принимают разряд и отводят его через заземление, поэтому «молниезащита» крана на деле и есть его заземляющее устройство. Штырь на оголовке КРАН-КУБАНЬ не устанавливает: защиты он бы не добавил, а качество заземления осталось прежним.</p>
    <p>Машинист в кабине защищён конструкцией: кабина металлическая и работает как экран для внешнего электромагнитного воздействия. Сиденье делают из диэлектрического материала, а на полу лежит диэлектрическое покрытие, чтобы человек не оказался под напряжением при пробое. Это защита на случай неожиданного удара, а не право работать в грозу: при приближении грозы КРАН-КУБАНЬ останавливает подъёмы, ставит стрелу во флюгерное положение и отключает кран.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <ol>
      <li>Проверьте проект электроснабжения площадки: где контур заземления и кто отвечает за его выполнение.</li>
      <li>Убедитесь, что рельсы соединены перемычками, а заземляющие проводники подключены не менее чем в двух точках.</li>
      <li>Закажите замер сопротивления в электролаборатории и получите протокол.</li>
      <li>Сверьте результат с порогом 4 Ом; при превышении добавьте электроды и повторите замер.</li>
      <li>Приложите протокол к документам крана и расскажите машинисту порядок действий при грозе.</li>
    </ol>
    <p>Пример: кран КБ-408.21 на рельсовом пути показал 6 Ом, что выше нормы. Инженерная служба КРАН-КУБАНЬ добавляет заземляющие электроды у рельсов, повторяет замер и добивается результата ниже 4 Ом; пока этого нет, кран не подключают. Цифры замера зависят от грунта на площадке, а как грунт влияет на основание, показано в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Заказать кран с подготовленным заземлением можно через <a href="/#order">форму на главной</a>: инженерная служба КРАН-КУБАНЬ подберёт модель и учтёт заземление в графике монтажа.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://zandz.com/ru/news/20240710/kak-vypolnit-molniezashitu-bashennogo-krana/', label: 'zandz.com — как выполнить молниезащиту башенного крана: 4 Ом по ПУЭ п. 1.7.101, две точки заземления, СО 153-34.21.122-2003' },
      { href: 'https://szim.ru/news/kak_vypolnit_molniezashchitu_bashennogo_krana/', label: 'szim.ru — молниезащита башенного крана: кран как естественный молниеприёмник, кабина как экран' },
      { href: 'https://ellabst.ru/articles/article/zamer-zazemlenia-basennogo-krana/', label: 'ellabst.ru — замер заземления башенного крана электролабораторией' },
    ]} />
</BlogArticleLayout>
