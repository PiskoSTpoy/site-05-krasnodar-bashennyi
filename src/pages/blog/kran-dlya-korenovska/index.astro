---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 90. Двадцать пятая статья блога — Кореновск, равнинный город на
// трассе М4 между Краснодаром и Тимашевском: первый разбор пищевого
// профиля, где сразу два действующих завода стоят в границах одного
// небольшого города, а не одного района.
//
// Экономический слой: ЗАО «Кореновский молочно-консервный комбинат» (КМКК,
// ИНН 2335013799, ОГРН 1022304010046) — бренд «Коровка из Кореновки»,
// производство ведёт историю с начала 1950-х (65 лет отмечено в 2017 году),
// экспорт мороженого в Китай, Германию, США, Великобританию, Канаду,
// Вьетнам, Монголию и на Сейшелы. Второй завод — АО «Кореновсксахар» (ИНН
// 2373011986, ОГРН 1162375054225), один из действующих сахарных заводов
// края (в сезон 2025 года 14 заводов Кубани переработали 7,8 млн тонн
// свёклы и получили 1,1 млн тонн сахара — цифра по краю в целом, не по
// конкретному заводу, отдельно оговорено в тексте).
//
// WebSearch отдельным запросом проверял балл сейсмичности Кореновска по
// Приложению Б ТСН 22-302-2000 — прямой цитаты для города в выдаче не
// нашлось, docs.cntd.ru и base.garant.ru напрямую недоступны (тот же
// egress-паттерн, что и в Волнах 76-80, 83-89), поэтому балл в статье не
// назван — та же честная развилка. Инцидент с сальмонеллой в продукции
// КМКК (август 2025, данные Роспотребнадзора) намеренно не включён в
// статью: это вопрос пищевой безопасности продукции, а не монтажа крана,
// и его упоминание не добавляет ничего к теме сайта.

const CHECKED = '17 сентября 2026 года';

const title = 'Кран для Кореновска: молочный комбинат и сахарный завод на трассе М4';
const description = 'Кореновск — равнинный город на трассе М4 между Краснодаром и Тимашевском: молочно-консервный комбинат «Коровка из Кореновки» и сахарный завод «Кореновсксахар» формируют спрос на кран в границах одного небольшого города.';
const h1 = 'Кран для Кореновска: молочный комбинат и сахарный завод на трассе М4';
const crumbTitle = 'Кран для Кореновска';
const slug = 'kran-dlya-korenovska';

const H2 = [
  'Кореновск — равнинный город на трассе М4',
  '«Коровка из Кореновки»: молочно-консервный комбинат с полувековой историей',
  'Кореновсксахар: второй пищевой завод в том же городе',
  'Сейсмика: почему балл для площадки в статье не назван',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'В Кореновске кран нужен только на территории двух заводов?',
    a: 'Нет. КМКК и «Кореновсксахар» — самые заметные и узнаваемые площадки города, но обычная для райцентра на трассе М4 застройка — жильё, торговые и социальные объекты, складская и логистическая инфраструктура вдоль федеральной трассы — создаёт спрос на технику независимо от двух конкретных предприятий.',
  },
  {
    q: 'Чем Кореновск отличается от уже разобранных Тимашевска и Выселковского района, где тоже пищевая промышленность?',
    a: 'Профиль похож — молочное и сахарное производство встречаются и там, и там. Разница в масштабе: в Тимашевске и Выселковском районе якорь — один крупный комбинат на район, а в Кореновске сразу два узнаваемых федеральных бренда («Коровка из Кореновки» и один из действующих сахарных заводов края) стоят в границах одного небольшого города, а не распределены по территории района.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Кореновска', item: `${SITE}/blog/kran-dlya-korenovska/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-korenovska/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-korenovska/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье, предгорную ось, степные районы с металлургией и нефтепереработкой, речные города в пойме и головные площадки агрохолдингов. Кореновск продолжает степную линию, но с деталью, которой раньше в блоге не было: два узнаваемых пищевых предприятия — не одно на весь район, а оба в границах одного небольшого города на трассе М4.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Кореновск стоит на равнинной части Кубано-Приазовской низменности, на берегах реки Бейсужёк Левый — притока Бейсуга, в 60 километрах северо-восточнее Краснодара. Через город проходит федеральная автомагистраль М-4 «Дон» и линия Северо-Кавказской железной дороги — сочетание, которое обычно означает удобную логистику для техники и для готовой продукции обоих заводов города. Населённый пункт основан в 1794 году как станица Кореновская, статус города получил в 1961 году; население на 2025 год — 44 277 человек. Ни курортной функции, ни выхода к морю у города нет: спрос на кран формируют промышленная застройка и обычная городская инфраструктура райцентра, а не туристический сезон.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Самое узнаваемое предприятие города — закрытое акционерное общество «Кореновский молочно-консервный комбинат» (КМКК), зарегистрированное 29 августа 2002 года по адресу улица Тимашевская, 16 (ИНН 2335013799, ОГРН 1022304010046, уставный капитал — 111,6 млн рублей). Само производство на площадке существенно старше юридического лица: в 2017 году комбинат отмечал 65 лет с момента, когда с конвейера сошла первая банка сгущённого молока, — то есть история переработки на этом месте ведётся с начала 1950-х годов. Комбинат выпускает продукцию под брендами «Коровка из Кореновки», «Кореновское», «Руслада», «Облака из молока» и «Густияр»; мороженое под брендом «Коровка из Кореновки» поставляется на экспорт — в Китай, Германию, США, Великобританию, Канаду, Вьетнам, Монголию и на Сейшельские острова.</p>
    <p>Для арендодателя крана действующий пищевой комбинат такого возраста и масштаба — задача, знакомая по уже разобранным Ильскому и Афипскому НПЗ в Северском районе или химзаводу «ЕвроХим-БМУ» в Белореченске: модернизация и расширение мощностей на территории работающего производства означают монтаж на стеснённой площадке рядом с действующими цехами, а не в чистом поле, — с соответствующими требованиями к ППР и согласованию окон простоя оборудования.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Второй завод города — акционерное общество «Кореновсксахар» (ИНН 2373011986, ОГРН 1162375054225), расположенное на улице Коммунистической, 7. Основной вид деятельности — производство сахара из сахарной свёклы. Завод — один из действующих сахарных заводов края: по итогам сезона 2025 года 14 современных сахарных заводов Кубани в совокупности переработали 7,8 млн тонн свёклы и получили 1,1 млн тонн сахара — эта цифра относится к краю в целом, а не к конкретной площадке в Кореновске, и здесь она приведена только как масштаб отрасли, в которой завод работает.</p>
    <p>Сахарное производство добавляет городу сезонный фактор, знакомый по уже разобранным Выселковскому району и Тимашевску: пик приёмки и переработки свёклы приходится на осень, и площадки заводов в этот период работают в максимально плотном режиме — монтажные и ремонтные работы на территории обычно планируют заранее, чтобы не пересекаться с пиковой загрузкой конвейера.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Территориальные нормы ТСН 22-302-2000 (СНКК 22-301-2000) «Строительство в сейсмических районах Краснодарского края» задают расчётную сейсмичность по Приложению Б для конкретных населённых пунктов края — так, для уже разобранных в этом блоге Армавира и Кропоткина цифра была найдена и процитирована напрямую. Для Кореновска отдельный уточняющий запрос такой цитаты не дал: прямой доступ к первоисточникам (docs.cntd.ru, base.garant.ru) заблокирован сетевым egress сессии, а в сводках поисковика конкретный балл для города не встретился. Называть цифру без подтверждения мы не считаем правильным, поэтому в этой статье балл сейсмичности площадки не приведён — заказчику по-прежнему стоит уточнять его отдельно на этапе инженерных изысканий, как разбирает статья «Инженерные изыскания перед монтажом крана».</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины действует в Кореновске так же, как в Краснодаре или на побережье: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с двухчасовым дневным перерывом, а в выходные и праздничные дни утренняя граница сдвинута до 10:00. Удалённость от краевого центра и от моря здесь ничего не меняет: норма одна на весь край. Подробный разбор часов и сумм штрафов по статье 3.3 — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Кореновск — равнинный город на трассе М4 в 60 км северо-восточнее Краснодара, на реке Бейсужёк Левый, население 44 277 человек (2025), без курортной функции.</li>
      <li>ЗАО «КМКК» (ИНН 2335013799) — производство с начала 1950-х годов, бренд «Коровка из Кореновки», экспорт мороженого в восемь стран, включая Китай и США.</li>
      <li>АО «Кореновсксахар» (ИНН 2373011986) — действующий сахарный завод, сезонный пик нагрузки на площадку приходится на осень.</li>
      <li>Балл сейсмичности площадки в статье сознательно не назван — прямых источников подтвердить его не удалось; уточняется отдельно на этапе изысканий.</li>
      <li>Закон №608-КЗ о тишине действует в Кореновске так же, как во всём крае.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/Кореновск', label: 'ru.wikipedia.org — Кореновск: население, география, история' },
      { href: 'https://www.rusprofile.ru/id/1715411', label: 'rusprofile.ru — ЗАО «КМКК», ИНН 2335013799: регистрация, адрес, уставный капитал' },
      { href: 'https://kuban24.tv/item/korenovskij-molochno-konservnyj-kombinat-uvelichil-eksport-na-40', label: 'kuban24.tv — Кореновский молочно-консервный комбинат нарастил экспорт' },
      { href: 'https://yugtimes.com/news/60505/', label: 'yugtimes.com — «Коровка из Кореновки»: бренд в почти 30 странах мира' },
      { href: 'https://www.rusprofile.ru/id/10740734', label: 'rusprofile.ru — АО «Кореновсксахар», ИНН 2373011986: регистрация, адрес, вид деятельности' },
      { href: 'https://kubantoday.ru/zavody-kubani-pererabotali-pervyj-million-tonn-svekly-i-proizveli-bolee-100-tysjach-tonn-sahara/', label: 'kubantoday.ru — сезон переработки свёклы на Кубани: заводы, объёмы' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
