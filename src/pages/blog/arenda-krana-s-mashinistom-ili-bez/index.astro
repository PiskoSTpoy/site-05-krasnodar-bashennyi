---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 96. Тридцать третья статья блога — угол (b) коммерческий/
// сравнительный. «Смета аренды» (Волна 95) сравнивает предложения по
// деньгам; эта статья — по ответственности: кто ремонтирует, кто командует
// машинистом, кто платит за вред соседям. Для заказчика это такой же
// критерий выбора, как ставка.
//
// Фактура (WebFetch zakonrf.info, 25.09.2026), дословно по тексту ГК РФ:
// - ст. 632 — аренда ТС с экипажем: арендодатель своими силами оказывает
//   услуги по управлению и технической эксплуатации;
// - ст. 634 — арендодатель поддерживает надлежащее состояние, включая
//   текущий и капитальный ремонт;
// - ст. 635 п. 2 — члены экипажа — работники арендодателя; подчиняются
//   арендодателю в управлении/технической эксплуатации и арендатору —
//   в коммерческой эксплуатации;
// - ст. 636 — если иное не предусмотрено договором, арендатор несёт расходы
//   коммерческой эксплуатации, включая топливо и расходуемые материалы;
// - ст. 640 — вред третьим лицам: отвечает арендодатель (регресс к
//   арендатору при его вине);
// - ст. 644 — без экипажа ремонт (текущий и капитальный) на арендаторе;
// - ст. 645 — без экипажа арендатор сам управляет и эксплуатирует ТС;
// - ст. 648 — без экипажа вред третьим лицам — на арендаторе.
// Оговорка в тексте: применимость § 3 гл. 34 ГК к башенному крану
// определяется договором и практикой — юридическую квалификацию не
// утверждаем, даём модель и советуем проверить у юриста.
// Закон о тишине №608-КЗ: окна 08-13 и 15-23 в будни, с 10:00 в выходные —
// перенесено из опубликованных страниц сайта (kommersant.ru).

const CHECKED = '25 сентября 2026 года';
const PUBLISHED = '2026-09-25';

const title = 'Башенный кран с машинистом или без: кто за что отвечает';
const description = 'Аренда башенного крана с экипажем и без по ГК РФ: ремонт, управление, расходы, вред третьим лицам, закон о тишине и норд-ост на Кубани.';
const h1 = 'Аренда башенного крана с машинистом или без: что выбрать и кто за что отвечает';
const crumbTitle = 'Кран с машинистом или без';
const slug = 'arenda-krana-s-mashinistom-ili-bez';

const H2 = [
  'Две модели аренды в Гражданском кодексе',
  'Кто ремонтирует кран во время аренды',
  'Кто командует машинистом на площадке',
  'Кто отвечает за вред соседям и прохожим',
  'Закон о тишине и норд-ост: чьё это решение',
  'Когда выгоднее кран с машинистом, а когда без',
  'Что записать в договор: чек-лист',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const rows = [
  { q: 'Управление и техническая эксплуатация', with: 'Арендодатель, своими силами (ст. 632)', without: 'Арендатор, своими силами (ст. 645)' },
  { q: 'Текущий и капитальный ремонт', with: 'Арендодатель (ст. 634)', without: 'Арендатор (ст. 644)' },
  { q: 'Чей работник машинист', with: 'Арендодателя (ст. 635)', without: 'Арендатора' },
  { q: 'Расходы коммерческой эксплуатации', with: 'Арендатор, если договор не говорит иное (ст. 636)', without: 'Арендатор' },
  { q: 'Вред третьим лицам', with: 'Арендодатель, с регрессом при вине арендатора (ст. 640)', without: 'Арендатор (ст. 648)' },
];

const faqs = [
  {
    q: 'Кто отвечает, если кран с машинистом повредил соседний дом?',
    a: 'По статье 640 ГК РФ при аренде транспортного средства с экипажем за вред третьим лицам отвечает арендодатель. Если арендодатель докажет, что вред возник по вине арендатора, он вправе потребовать от арендатора возместить выплаченное. При аренде без экипажа статья 648 возлагает эту ответственность на арендатора. Для башенного крана КРАН-КУБАНЬ модель ответственности фиксируется в договоре.',
  },
  {
    q: 'Кто платит за ремонт башенного крана, если он сломался во время аренды?',
    a: 'При аренде с экипажем текущий и капитальный ремонт по статье 634 ГК РФ ложится на арендодателя. При аренде без экипажа статья 644 возлагает ремонт на арендатора. Поэтому аренда крана без машиниста дешевле по ставке, но переносит на заказчика риск ремонта и простоя.',
  },
  {
    q: 'Может ли прораб заказчика давать команды машинисту арендодателя?',
    a: 'Может, но только в коммерческой части. Статья 635 ГК РФ разделяет подчинение: в управлении и технической эксплуатации машинист слушает арендодателя, а в коммерческой эксплуатации — что и куда поднимать и когда работать — распоряжения даёт арендатор. Решение не работать при опасном ветре остаётся за стороной, отвечающей за техническую эксплуатацию.',
  },
  {
    q: 'Какой вариант аренды башенного крана чаще выбирают застройщики на Кубани?',
    a: 'Надёжной статистики по краю в открытых источниках нет. Логика выбора такая: если у застройщика нет своих аттестованных машинистов и службы механика, аренда крана КРАН-КУБАНЬ с экипажем снимает с него ремонт и ответственность перед третьими лицами. Аренда без экипажа имеет смысл для компании с собственной службой эксплуатации подъёмных сооружений.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение для заказчика"
  published={PUBLISHED}
>
    <p slot="intro">Аренда башенного крана с машинистом и без него различается не только ставкой, но и тем, кто ремонтирует кран, кто командует машинистом и кто платит за вред соседям. Гражданский кодекс РФ описывает эти две модели в статьях 632–648: с экипажем ремонт и ответственность перед третьими лицами несёт арендодатель, без экипажа — арендатор. Для заказчика КРАН-КУБАНЬ на Кубани к этому добавляются два местных вопроса: кто отвечает за часы работы по закону №608-КЗ и кто останавливает кран при норд-осте.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Гражданский кодекс РФ в параграфе 3 главы 34 описывает аренду транспортного средства с экипажем (статья 632) и без экипажа (статья 642). С экипажем арендодатель не только передаёт машину, но и своими силами оказывает услуги по управлению ею и технической эксплуатации. Без экипажа арендатор получает машину и дальше управляет и эксплуатирует её сам — так прямо сказано в статье 645.</p>

    <div class="rule-table-wrap" style="margin-bottom:24px">
      <table class="rule-table">
        <caption style="text-align:left;margin-bottom:8px">Кто за что отвечает: аренда с экипажем и без по ГК РФ</caption>
        <thead>
          <tr><th scope="col">Вопрос</th><th scope="col">С экипажем</th><th scope="col">Без экипажа</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.q}</td><td>{r.with}</td><td>{r.without}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <p>Договор аренды башенного крана стороны на практике строят по одной из этих моделей — прямо по нормам ГК о транспортных средствах или как смешанный договор аренды и услуг. Как квалифицировать конкретный договор, решает юрист; инженерной службе КРАН-КУБАНЬ важно, чтобы распределение ответственности было записано явно, а не выводилось из спора.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Ремонт башенного крана при аренде с экипажем — забота арендодателя: статья 634 ГК РФ обязывает его весь срок договора поддерживать машину в надлежащем состоянии, включая текущий и капитальный ремонт. При аренде без экипажа та же обязанность по статье 644 переходит на арендатора. Для заказчика разница ощутима: сломанный механизм поворота КБ-408.21 без экипажа — это его запчасти, его механик и его простой.</p>
    <p>Простой башенного крана КРАН-КУБАНЬ из-за поломки стоит не меньше самого ремонта. Ставка за месяц продолжает идти, а бригада на площадке ждёт. Если в договоре аренды без экипажа не записано, в какой срок арендодатель поставляет запчасти или заменяет кран, весь этот риск остаётся на заказчике.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Статья 635 ГК РФ делит подчинение машиниста при аренде с экипажем на две части. Члены экипажа — работники арендодателя, и в вопросах управления и технической эксплуатации они слушают арендодателя. В коммерческой эксплуатации — что поднимать, куда подавать груз, в какой последовательности — распоряжения даёт арендатор. На площадке КРАН-КУБАНЬ это выглядит так: прораб заказчика ставит задачу на смену, а машинист решает, можно ли выполнить подъём безопасно.</p>
    <p>Статья 636 добавляет расходы: если договор не говорит иное, арендатор платит за то, что расходуется при коммерческой эксплуатации. Для электрического башенного крана главная такая статья — электроэнергия, и строку о ней лучше прописать в договоре прямо.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Вред третьим лицам при аренде с экипажем по статье 640 ГК РФ возмещает арендодатель; он вправе потребовать выплаченное с арендатора, если докажет, что вред возник по вине арендатора. При аренде без экипажа статья 648 возлагает эту ответственность на арендатора. Для башенного крана это не теория: при вылете 40 метров у КБ-408.21 или 43 метра у giraFFe SMK-5.66 стрела проходит над соседними участками, дорогами и тротуарами.</p>
    <p>Для крана КРАН-КУБАНЬ плотная застройка центра Краснодара, Сочи и Новороссийска делает этот вопрос практическим. Соседний дом, припаркованная машина, прохожий на тротуаре — всё это «третьи лица» в смысле ГК. Какая сторона отвечает перед ними и есть ли страхование, в договоре аренды крана должно быть написано до монтажа.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ разрешает шумные работы в будни в двух окнах, с 08:00 до 13:00 и с 15:00 до 23:00, а в выходные — с 10:00 утра. Время работы крана — вопрос коммерческой эксплуатации, то есть по логике статьи 635 ГК РФ распоряжение арендатора. Поэтому при аренде крана КРАН-КУБАНЬ с экипажем график смен под окна закона о тишине согласует заказчик, а машинист работает в этих окнах. Подробный разбор окон — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>
    <p>Норд-ост — обратный случай. Решение остановить башенный кран при сильном ветре относится к технической эксплуатации и безопасности, и при аренде с экипажем его принимает сторона арендодателя, даже если прораб торопится. Как оплачиваются такие дни простоя, договор должен сказать отдельно. Что происходит с краном при боре, разобрано в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Аренда башенного крана КРАН-КУБАНЬ с машинистом выгоднее заказчику, у которого нет своей службы эксплуатации подъёмных сооружений: ремонт, квалификация экипажа и ответственность перед третьими лицами остаются у арендодателя. Ставка выше, но в неё уже заложены риски, которые иначе пришлось бы нести самому. Для застройщика жилья, промзоны или соцобъекта без собственной крановой службы кран КРАН-КУБАНЬ с экипажем — обычно более предсказуемый вариант.</p>
    <p>Аренда крана КРАН-КУБАНЬ без машиниста имеет смысл для компании, у которой уже есть аттестованные машинисты башенных кранов, механик и опыт эксплуатации такой техники. Федеральные требования к эксплуатирующей организации одинаковы по всей стране и в блоге не пересказываются — их нужно смотреть в первоисточнике до подписания договора. Перед решением полезно сложить полную смету по строкам — как в статье <a href="/blog/smeta-arendy-bashennogo-krana/">«Смета аренды башенного крана»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <ul>
      <li>Модель аренды по ГК РФ: с экипажем или без — прямо, с указанием, кто управляет и обслуживает кран.</li>
      <li>Кто делает текущий и капитальный ремонт и в какой срок кран восстанавливают или меняют.</li>
      <li>Как оплачивается простой из-за поломки, из-за ветра и из-за окон закона №608-КЗ.</li>
      <li>Кто платит за электроэнергию и другие расходы эксплуатации.</li>
      <li>Кто отвечает перед третьими лицами и есть ли страхование ответственности.</li>
      <li>Кто согласует график смен под часы закона о тишине.</li>
    </ul>
    <p>Модель аренды, модель крана и площадку можно обсудить через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ покажет, как распределяется ответственность в каждом варианте.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_9027/1ffe0cb622bfbe86c61d7d6df4c8c6011dfb45fe/', label: 'ГК РФ, статья 632 — аренда транспортного средства с экипажем (КонсультантПлюс)' },
      { href: 'https://www.zakonrf.info/gk/634/', label: 'ГК РФ, статья 634 — содержание транспортного средства арендодателем' },
      { href: 'https://www.zakonrf.info/gk/635/', label: 'ГК РФ, статья 635 — управление и эксплуатация, подчинение экипажа' },
      { href: 'https://www.zakonrf.info/gk/636/', label: 'ГК РФ, статья 636 — расходы на коммерческую эксплуатацию' },
      { href: 'https://www.zakonrf.info/gk/640/', label: 'ГК РФ, статья 640 — ответственность за вред при аренде с экипажем' },
      { href: 'https://www.zakonrf.info/gk/644/', label: 'ГК РФ, статья 644 — содержание транспортного средства арендатором' },
      { href: 'https://www.zakonrf.info/gk/645/', label: 'ГК РФ, статья 645 — управление и эксплуатация без экипажа' },
      { href: 'https://www.zakonrf.info/gk/648/', label: 'ГК РФ, статья 648 — ответственность за вред при аренде без экипажа' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
