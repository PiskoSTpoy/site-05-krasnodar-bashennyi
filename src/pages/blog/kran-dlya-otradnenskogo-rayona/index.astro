---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 111. Семьдесят девятая статья блога — угол (c) региональный.
// Отрадненский район — юго-восток края, граница со Ставропольским краем и
// Карачаево-Черкесией; в плане уже были соседи Лабинск и Новокубанский район,
// сам район не разбирался. Источник найден в волне 110 (smokk.ru, curl -sk).
//
// Фактура — один источник (проверено 13.10.2026):
// - smokk.ru/about/association-members/otradnenskiy-rayon (Совет муниципальных
//   образований края; текст описания района без даты): население 64 082 (01.01.2022),
//   63 529 (2023), 62 908 (2024), 62 456 (01.01.2025); площадь 245 208 га
//   (= 2452,08 км², пересчёт); граничит: восток — Ставропольский край, юг —
//   Карачаево-Черкесия, север и запад — Новокубанский, Лабинский, Успенский районы;
//   образован 2 июня 1924 года; в 2005 году образованы 14 сельских поселений;
//   сельхозугодий 186 600 га, в том числе пашни 96 200 га; промышленность — средние
//   и мелкие производители: мебель, коммунальные услуги, переработка
//   сельскохозяйственной продукции; администрация — ст. Отрадная, ул. Первомайская, 28.
// Расчёты: убыль 2022→2025 = 1626 чел. (2,5 %); плотность ≈ 25,5 чел./км²;
// сельхозугодья ≈ 76 % площади, пашня ≈ 39 %.
// НЕ названо в источнике и не приводится: рельеф, климат, грунт, расстояние до
// Краснодара, названия предприятий, балл сейсмичности (конвенция сайта с Волны 79).

const CHECKED = '13 октября 2026 года';
const PUBLISHED = '2026-10-13';

const title = 'Кран для Отрадненского района: 2452 км² на юго-востоке края';
const description = 'В Отрадненском районе 2452 км², 62 456 жителей на 01.01.2025 и 14 сельских поселений. Грунт, доставка и закон о тишине для башенного крана.';
const h1 = 'Кран для Отрадненского района: какой башенный кран нужен на юго-востоке края';
const crumbTitle = 'Кран для Отрадненского района';
const slug = 'kran-dlya-otradnenskogo-rayona';

const H2 = [
  'Что известно о районе: площадь, население, поселения',
  'Экономика: пашня, мебель и переработка',
  'Грунт, климат и сейсмика: чего нет в описании района',
  'Доставка: граница с Карачаево-Черкесией и соседи по краю',
  'Закон о тишине и режим работы на площадке',
  'Что проверить до заказа крана в районе',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Отрадненского района?',
    a: '245 208 га, или около 2452 км² — такую цифру приводит ассоциация «Совет муниципальных образований Краснодарского края» (СМОКК) в описании района. Это один из крупных районов юго-востока края: он граничит со Ставропольским краем и Карачаево-Черкесией.',
  },
  {
    q: 'Сколько людей живёт в Отрадненском районе?',
    a: '62 456 человек на 1 января 2025 года по данным СМОКК. За три года с 1 января 2022 года, когда было 64 082, население сократилось на 1626 человек, или на 2,5 %. Плотность — около 25 человек на км².',
  },
  {
    q: 'Какой грунт в Отрадненском районе?',
    a: 'В описании района грунт, рельеф и грунтовые воды не названы, поэтому общую цифру для всего района давать нельзя. Несущую способность под путём или фундаментом определяют изыскания на конкретной площадке; КРАН-КУБАНЬ не ставит кран без отчёта по грунту.',
  },
  {
    q: 'Как доставляют башенный кран в Отрадненский район?',
    a: 'Секциями мачты, стрелой и противовесом на нескольких машинах по краевой сети дорог. Расстояние от Краснодара в описании района не указано, и КРАН-КУБАНЬ считает доставку по фактическому маршруту от базы до площадки, а срок монтажа зависит от выбранной модели.',
  },
  {
    q: 'Какая модель крана подходит для частного и малоэтажного строительства в районе?',
    a: 'При высоте до 41,7 м подходит giraFFe SMK-5.66: опорный контур 4×4 м, фундамент не нужен, монтаж 4–6 часов. Для здания выше 41,7 м или для вылета свыше 43 м КРАН-КУБАНЬ предлагает КБ-408.21, Potain MCH 175, Potain MDT 219 J10 или КБ-674А по высоте и плану площадки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Юго-восток края"
  published={PUBLISHED}
>
    <p slot="intro">Отрадненский район занимает 245 208 га — около 2452 км² — на юго-востоке Краснодарского края, и 62 456 жителей на 1 января 2025 года дают плотность около 25 человек на км². Для башенного крана КРАН-КУБАНЬ из описания района важны три факта: 186 600 га сельхозугодий, 14 сельских поселений и граница с Карачаево-Черкесией.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Отрадненский район по данным Совета муниципальных образований Краснодарского края граничит на востоке со Ставропольским краем, на юге — с Карачаево-Черкесией, а на севере и западе — с Новокубанским, Лабинским и Успенским районами. Район образован 2 июня 1924 года, административный центр — станица Отрадная. Для заказчика башенного крана КРАН-КУБАНЬ это означает, что площадка может оказаться далеко от любой крупной базы.</p>
    <p>Население сокращается: 64 082 человека на 1 января 2022 года, 63 529 — в 2023-м, 62 908 — в 2024-м и 62 456 — в 2025-м. За три года минус 1626 человек, или 2,5 %. Территория делится на 14 сельских поселений, образованных в 2005 году вместо сельских округов, и застройка идёт в станицах и посёлках, а не в одном городе.</p>
    <p>Практический вывод для КРАН-КУБАНЬ: объект в таком районе, как правило, небольшой по этажности и разнесён по станицам. Выбор модели начинают с высоты здания и вылета подачи, а не с района — это те же параметры, что разобраны в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Сельскохозяйственных угодий в Отрадненском районе 186 600 га, в том числе пашни 96 200 га. От площади района это около 76 % и 39 % соответственно. Экономика района — агропромышленный комплекс, а промышленный потенциал по описанию состоит из средних и мелких производителей мебели, коммунальных услуг и переработки сельскохозяйственной продукции.</p>
    <p>Для башенного крана такая структура даёт типичный набор объектов: складские и производственные корпуса переработки, жильё в станицах, объекты коммунального хозяйства. КРАН-КУБАНЬ под них чаще подбирает giraFFe SMK-5.66, который монтируют за 4–6 часов без фундамента, или Potain MCH 175 с рельсовым путём там, где корпус длинный и узкий. Сравнение подходов — в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>
    <p>Названий предприятий и инвестиционных площадок в описании района нет, поэтому статья их не называет. Если объект заказчика связан с конкретным производством, технические требования — высоту, вылет, график подачи — берут из его проекта, а не из района.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Описание района на сайте СМОКК не называет ни рельеф, ни климат, ни грунты, и КРАН-КУБАНЬ не подставляет общие цифры вместо отсутствующих. Граница района с Карачаево-Черкесией не даёт оснований для вывода о грунтах: несущую способность определяют бурением на площадке, а не картой района.</p>
    <p>Для башенного крана эта часть работы не пропускается. Порядок изысканий — какие скважины, какая глубина, что попадает в отчёт — описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>, а выбор между рельсовым путём и фундаментом — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Для КБ-408.21 основание — только рельсовый путь, для Potain MDT 219 J10 — путь или монолитный фундамент.</p>
    <p>Балл сейсмичности района в описании не назван и в статье не указан. Расчётное значение для площадки берут из карт общего сейсмического районирования и ТСН 22-302-2000, при необходимости — из микрорайонирования, как в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>. Для КРАН-КУБАНЬ значение входит в проект производства работ.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Район лежит на юго-востоке края и состоит из 14 сельских поселений, а расстояние до Краснодара в описании не указано. КРАН-КУБАНЬ считает доставку по фактическому маршруту от базы до объекта: длину плеча, число машин и разрешения на негабарит берут из расчёта, а не из справочной цифры. Кран приходит секциями — мачта, стрела, противовес, — а не одной машиной.</p>
    <p>Ближайшие районы, с которыми граничит Отрадненский, уже разобраны: <a href="/blog/kran-dlya-labinska/">Лабинск</a> и <a href="/blog/kran-dlya-novokubanskogo-rayona/">Новокубанский район</a> лежат на севере и западе. Для заказчика, который ведёт стройку в нескольких районах, полезно, что парк КРАН-КУБАНЬ из пяти моделей один и тот же: Potain MDT 219 J10, КБ-408.21, КБ-674А, giraFFe SMK-5.66, Potain MCH 175.</p>
    <p>Срок монтажа зависит от модели и основания, а не от района. Сколько занимает монтаж тяжёлого крана и что входит в этот срок, разобрано в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>. Для giraFFe SMK-5.66 по паспорту это 4–6 часов с одним 25-тонным автокраном.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края № 608-КЗ о тишине действует во всех 14 поселениях Отрадненского района так же, как в городах края. Часы работы крана, монтажной техники и ночные подъёмы планируют по закону, а не по привычке бригады. Подробности и исключения для строительных работ — в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>
    <p>В станице отдельный практический вопрос — жилой дом рядом с площадкой: расстояние до окон, уровень шума от лебёдки и привода поворота. Как измеряют шум и что считать нормой, показано в статье <a href="/blog/uroven-shuma-v-decibelah/">«Уровень шума в децибелах»</a>. Значения шума механизмов конкретной модели берут из паспорта машины, а не из общей таблицы.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Заказ крана в Отрадненском районе сводится к пяти проверкам, и КРАН-КУБАНЬ рекомендует пройти их до подачи заявки. Перечень — рекомендация инженерной службы, а не норма.</p>
    <ol>
      <li>Определить высоту объекта и вылет подачи: от них зависит модель, а не от района.</li>
      <li>Заказать изыскания: грунт, воду и несущую способность в описании района не найти.</li>
      <li>Нанести на план соседние здания и линии электропередачи — от них зависит тип стрелы; см. статью <a href="/blog/gorizontalnaya-ili-mahovaya-strela-bashennogo-krana/">«Маховая или горизонтальная стрела»</a>.</li>
      <li>Согласовать часы работы по закону № 608-КЗ.</li>
      <li>Уточнить маршрут и сроки доставки от базы до объекта.</li>
    </ol>
    <p>Адрес и параметры площадки можно прислать через <a href="/#order">форму на главной</a>; инженерная служба КРАН-КУБАНЬ подберёт модель из парка и посчитает доставку.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/otradnenskiy-rayon', label: 'smokk.ru — Отрадненский муниципальный район: население, площадь, география, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
