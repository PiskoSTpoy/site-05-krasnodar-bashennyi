---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 101. Сорок девятая статья блога — угол (c) практический/региональный.
// Тбилисский район — центр края к северо-востоку от Краснодара, агропромышленный:
// сахар, молоко и сыр, зерно и семена. Соседи по блогу: Выселки, Усть-Лабинск,
// Кропоткин, Гулькевичи — у района свой профиль (переработка, не курорт и не порт).
//
// Фактура — проверена 30.09.2026 (WebSearch + WebFetch):
// - ст. Тбилисская основана 8 октября 1802 г.; район образован 31.12.1934;
//   991,7 км², 48,8 тыс. чел., 42 населённых пункта (business-kuban.ru);
// - ~100–105 км от Краснодара; правый берег Кубани (Википедия, adm-tbilisskaya.ru);
// - сахарный завод (с 1959), маслосырзавод (с 1954), Гречишкинский элеватор (1924),
//   семенной завод свёклы (Википедия, business-kuban.ru);
// - добыча строительного песка и глины (adm-tbilisskaya.ru, результат поиска).
// Балл сейсмичности НЕ называю (конвенция с Волны 79). Закон о тишине №608-КЗ —
// в редакции с 1 марта 2026 (как в статьях-соседях).

const CHECKED = '30 сентября 2026 года';
const PUBLISHED = '2026-09-30';

const title = 'Кран для Тбилисского района: башенный кран у Кубани';
const description = 'Ст. Тбилисская в 100–105 км от Краснодара: сахарный завод, маслосырзавод, зерновые элеваторы. Какой башенный кран нужен на промплощадке, а какой — на жилье.';
const h1 = 'Кран для Тбилисского района: какой башенный кран нужен в станице Тбилисской';
const crumbTitle = 'Кран для Тбилисского района';
const slug = 'kran-dlya-tbilisskogo-rayona';

const H2 = [
  'Тбилисский район: где нужен башенный кран',
  'Переработка сахара, молока и зерна',
  'Жильё станицы Тбилисской и быстромонтируемый кран',
  'Грунт у Кубани и балл сейсмичности',
  'Доставка крана и закон о тишине',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько километров от Краснодара до станицы Тбилисской?',
    a: 'По разным источникам станица Тбилисская находится в 100–105 км от Краснодара, на правом берегу Кубани. КРАН-КУБАНЬ закладывает это плечо в доставку: быстромонтируемый giraFFe SMK-5.66 едет одним рейсом, классический кран — несколькими рейсами с секциями мачты, стрелой и противовесом.',
  },
  {
    q: 'Хватит ли автокрана на стройке в Тбилисском районе?',
    a: 'Для одноэтажных построек и коротких домов автокрана обычно достаточно. Башенный кран КРАН-КУБАНЬ нужен там, где здание выше 28–37 м, а это предел 25-тонного автокрана, или где объект длинный: цеха и склады перерабатывающих предприятий, элеваторные ёмкости. Границу задают высота и вылет до дальней точки.',
  },
  {
    q: 'Какой кран подойдёт для сахарного или маслосырзавода?',
    a: 'Для протяжённых корпусов и складов подходит кран на рельсовом пути КБ-408.21: он идёт вдоль здания и закрывает всю длину. Для высоких ёмкостей и силосов КРАН-КУБАНЬ предлагает Potain MDT 219 J10 с вылетом 65 м или приставной КБ-674А. Выбор делают по чертежу объекта.',
  },
  {
    q: 'Какой балл сейсмичности у Тбилисского района?',
    a: 'КРАН-КУБАНЬ одной цифрой балл для района не называет. Его берут из карт ОСР-2015 для уровня ответственности объекта и уточняют сейсмическим микрорайонированием площадки, а требования задают ТСН 22-302-2000 и СП 14.13330.2018. Для расчёта крана действует балл, указанный в проекте конкретного объекта.',
  },
  {
    q: 'Действует ли закон о тишине в Тбилисском районе?',
    a: 'Да, закон Краснодарского края №608-КЗ действует по всему краю. С 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Тбилисский район"
  published={PUBLISHED}
>
    <p slot="intro">Станица Тбилисская стоит на правом берегу Кубани в 100–105 км от Краснодара, а в районе на 991,7 км² живут около 48,8 тыс. человек. Башенный кран здесь нужен прежде всего перерабатывающим предприятиям с высокими и длинными корпусами, а для коротких домов КРАН-КУБАНЬ предлагает быстромонтируемый giraFFe SMK-5.66.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Тбилисский район образован 31 декабря 1934 года, а его центр, станица Тбилисская, основана 8 октября 1802 года: тогда у Тифлисского редута поселились 181 семья. Сегодня район включает 42 населённых пункта, и базовая отрасль здесь — агропромышленный комплекс. КРАН-КУБАНЬ рассматривает район как площадку для промышленного строительства: корпуса, склады и ёмкости, а не курортную или портовую застройку.</p>
    <p>Башенный кран в Тбилисском районе оправдан там, где автокран уже не справляется. Граница проходит по высоте крюка и вылету до дальней точки: 25-тонный автокран работает до 28–37 м по высоте, а кран КРАН-КУБАНЬ поднимает крюк выше 70 м. Как сравнивать два вида техники, разобрано в статье <a href="/blog/bashennyi-kran-ili-avtokran/">«Башенный кран или автокран»</a>, а район по профилю ближе всего к соседним <a href="/blog/kran-dlya-vyselkovskogo-rayona/">Выселкам</a> и <a href="/blog/kran-dlya-kropotkina/">Кропоткину</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Промышленность района держится на переработке: сахарный завод, действующий с 1959 года, Тбилисский маслосырзавод с 1954 года, зерновая компания на базе Гречишкинского элеватора, основанного в 1924 году. Сахарный и молочный заводы — протяжённые корпуса и склады, где груз подают вдоль здания. Для такой геометрии КРАН-КУБАНЬ предлагает кран на рельсовом пути КБ-408.21: он идёт вдоль объекта и закрывает длину, которую кран на фундаменте достаёт только вылетом.</p>
    <p>Зерновое хозяйство добавляет второй сценарий — высоту. Силосы, надстройки элеватора и башни требуют крана, поднимающего груз выше типового этажа. Здесь КРАН-КУБАНЬ ставит Potain MDT 219 J10 с высотой крюка до 70,4 м или приставной КБ-674А с анкеровкой к возводимой конструкции. Выбор между длиной и высотой инженерная служба делает по чертежу: рельсовый путь для цехов, высотный кран для ёмкостей. Сравнение двух Potain парка приведено в статье <a href="/blog/potain-mdt-219-j10-ili-mch-175/">«Potain MDT 219 J10 или MCH 175»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Жилая застройка станицы Тбилисской в основном малоэтажная, и тяжёлый башенный кран для неё избыточен. Короткий дом на стеснённом участке закрывает быстромонтируемый giraFFe SMK-5.66: опорный контур 4×4 м без фундамента, монтаж за 4–6 часов и один рейс доставки на 100–105 км. КРАН-КУБАНЬ выбирает эту модель там, где месячный цикл монтажа классического крана невыгоден.</p>
    <p>Классический кран для жилья района нужен, когда высота дома превышает предел giraFFe SMK-5.66, а это до 27 м при горизонтальной стреле и до 41,7 м при наклоне 20°. Тогда КРАН-КУБАНЬ переходит к Potain MDT 219 J10 или КБ-408.21 с наращиванием мачты. Порядок выбора модели описан в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Грунт под кран в Тбилисском районе задают чернозёмные почвы и близость Кубани: слой плодородного грунта под основание не годится, а уровень грунтовых вод у реки меняется. В районе добывают строительный песок и глину, но песок из карьера не заменяет изысканий. Фундамент или путь под кран КРАН-КУБАНЬ рассчитывают по инженерно-геологическим изысканиям площадки, как в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Балл сейсмичности для Тбилисского района КРАН-КУБАНЬ не называет одной цифрой: его берут из карт ОСР-2015 под уровень ответственности объекта и уточняют микрорайонированием площадки. Требования к строительству в сейсмических районах края задают ТСН 22-302-2000 и СП 14.13330.2018. Инженерная служба КРАН-КУБАНЬ опирается на балл из проекта, а порядок его определения показан в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Доставка крана в станицу Тбилисскую — это 100–105 км от Краснодара, и число рейсов зависит от модели. Быстромонтируемый giraFFe SMK-5.66 КРАН-КУБАНЬ везёт одним рейсом и монтирует за смену; классический КБ-408.21 или Potain MDT 219 J10 требуют нескольких рейсов и монтажного автокрана на площадке. Плечо доставки инженерная служба КРАН-КУБАНЬ закладывает в смету отдельной строкой, как описано в статье <a href="/blog/smeta-arendy-bashennogo-krana/">о смете аренды</a>.</p>
    <p>Закон Краснодарского края №608-КЗ действует в Тбилисском районе так же, как в Краснодаре: с 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни; промзона вдали от домов планируется свободнее — подробнее в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>
    <p>Адрес объекта и чертёж можно прислать через <a href="/#order">форму на главной</a>: инженерная служба КРАН-КУБАНЬ предложит модель, основание и график доставки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.business-kuban.ru/tbilisskiy-rayon/', label: 'business-kuban.ru — Тбилисский район: дата образования, площадь, население, агропромышленный комплекс, сахарный завод' },
      { href: 'https://ru.wikipedia.org/wiki/Тбилисская', label: 'ru.wikipedia.org — Тбилисская: основание 1802 г., расположение на Кубани, расстояние до Краснодара, предприятия' },
      { href: 'https://adm-tbilisskaya.ru/city/', label: 'adm-tbilisskaya.ru — администрация Тбилисского района: 105 км до Краснодара, крупные предприятия, добыча песка и глины' },
      { href: 'https://docs.cntd.ru/document/1200035102', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
      { href: 'https://www.kubzsk.ru/', label: 'kubzsk.ru — Законодательное Собрание Краснодарского края: закон №608-КЗ (режим тишины)' },
    ]} />
</BlogArticleLayout>
