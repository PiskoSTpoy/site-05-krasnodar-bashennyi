---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 114. Восемьдесят седьмая статья блога — угол (a) информационный/how-to.
// Организационные требования к монтажной площадке башенного крана.
//
// Фактура — сырой текст ФНП № 461 (legalacts.ru, curl; проверено 16.10.2026):
// - п. 38 электробезопасность на монтажной площадке и при наладке: ограждение
//   токоведущих частей; временные сети монтируют только аттестованные
//   электромонтёры по технологическому регламенту (при наличии); работы на
//   токоведущих частях при напряжении более 50 В — только при снятом
//   напряжении; предупредительные таблички на устройства, подающие напряжение;
// - п. 39 погрузочно-разгрузочные работы при монтаже — по регламенту из
//   руководства по эксплуатации или технологическому регламенту, под
//   руководством ИТР, ответственного за безопасное производство работ с
//   применением ПС; до начала — инструктаж участников монтажа;
// - п. 40 технологическая последовательность по руководству по монтажу и по
//   ППР; изменения ППР/ТК в ходе монтажа разрабатывает организация, отвечающая
//   за монтаж, с исполнительными документами; требования к демонтажу в ППР и ТК
//   на монтаж определяются отдельно, ППР на демонтаж допускается отдельно;
// - п. 41 а)–д) организационные требования (посторонние, высота, переходы,
//   подъём по раскосам, место управления);
// - пп. 42, 43, 45 сборка по документации, несоосность в допусках руководства,
//   устойчивость до соединения; п. 44 — самомонтируемые башенные краны на
//   подготовленном наземном рельсовом пути; п. 47 запасовка канатов, наладка
//   тормозов, ограничителей, указателей, регистраторов и системы управления.
// НЕ приводится: числовые допуски несоосности (в ФНП их нет — в руководстве
// по эксплуатации), состав бригады, ответственность заказчика (ФНП её не
// задаёт — перечень в конце помечен как рекомендация КРАН-КУБАНЬ).

const CHECKED = '16 октября 2026 года';
const PUBLISHED = '2026-10-16';

const title = 'Кто на монтажной площадке башенного крана: пункт 41 ФНП';
const description = 'Пункт 41 ФНП № 461 задаёт пять организационных требований к монтажу крана: кто допускается на площадку, где можно находиться, как подниматься. Разбор пп. 38–47.';
const h1 = 'Кто может находиться на монтажной площадке башенного крана по ФНП № 461';
const crumbTitle = 'Монтажная площадка башенного крана';
const slug = 'kto-mozhet-byt-na-montazhnoy-ploshchadke-bashennogo-krana';

const H2 = [
  'Пункт 41: 5 организационных требований к монтажу',
  'Посторонним нельзя: площадка, кабина и опасная зона',
  'Работа на высоте: подмащивание, лестницы, канаты',
  'Пункт 38: электробезопасность при монтаже и наладке',
  'Пункты 39–40: инструктаж, ИТР и порядок по ППР',
  'Пункты 43–47: сборка, допуски и наладка после монтажа',
  'Памятка заказчику перед приездом бригады',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Кто может находиться на монтажной площадке башенного крана?',
    a: 'Только работники, которые участвуют в монтаже, демонтаже или наладке. Подпункт «а» пункта 41 ФНП № 461 запрещает присутствие посторонних. КРАН-КУБАНЬ перед монтажом согласует с заказчиком границу площадки и список лиц, допущенных за неё.',
  },
  {
    q: 'Можно ли монтажнику находиться в кабине машиниста?',
    a: 'Нет, если это не оговорено в эксплуатационной документации крана. Пункт 41 ФНП запрещает работникам, связанным с монтажом, находиться в кабине машиниста, на металлоконструкциях подъёмного сооружения, внутри них и в опасной зоне. Исключение возможно только по документации изготовителя.',
  },
  {
    q: 'Можно ли подниматься по раскосам или спускаться по канатам?',
    a: 'Нет. Подпункт «г» пункта 41 запрещает подъём и передвижение по раскосам и другим элементам металлоконструкций, не предназначенным для этого, а также спуск вниз по канатам крана. Переходить по смонтированным элементам разрешено только по лестницам, площадкам и трапам с перилами.',
  },
  {
    q: 'Кто руководит погрузкой и разгрузкой при монтаже крана?',
    a: 'Инженерно-технический работник, ответственный за безопасное производство работ с применением подъёмных сооружений (пункт 39 ФНП № 461). До начала работ он обеспечивает инструктаж участников монтажа. Регламент берут из руководства по эксплуатации или из технологического регламента на монтаж.',
  },
  {
    q: 'При каком напряжении работы на токоведущих частях ведут только без напряжения?',
    a: 'При напряжении более 50 В (пункт 38 ФНП № 461). Монтаж временных электрических сетей на площадке вправе вести только аттестованные электромонтёры, а на устройства, подающие напряжение, вывешивают предупредительные таблички.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Монтаж"
  published={PUBLISHED}
>
    <p slot="intro">На монтажной площадке башенного крана могут находиться только те, кто участвует в монтаже, демонтаже или наладке: так в подпункте «а» пункта 41 ФНП № 461 сформулирован запрет на посторонних. Всего пункт 41 содержит 5 организационных требований, и ещё три пункта — 38, 39 и 40 — добавляют электробезопасность, инструктаж и порядок работ. КРАН-КУБАНЬ разбирает их по тексту приказа Ростехнадзора.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 41 ФНП № 461 перечисляет организационные требования подпунктами «а»–«д» и относится к монтажным, демонтажным и наладочным работам одновременно. КРАН-КУБАНЬ применяет эти подпункты как вводный инструктаж бригады перед каждым монтажом башенного крана. Краткий пересказ каждого — в таблице.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Подпункт</th><th>О чём требование</th></tr></thead>
      <tbody>
        <tr><td>«а»</td><td>На площадке нет посторонних; участникам монтажа нельзя быть в кабине машиниста, на металлоконструкциях, внутри них и в опасной зоне</td></tr>
        <tr><td>«б»</td><td>Работа на высоте — со средств подмащивания, закреплённых заранее, и в местах, указанных в инструкции по монтажу</td></tr>
        <tr><td>«в»</td><td>Переход по смонтированным элементам — по лестницам, площадкам и трапам с перилами; на надземные рельсовые пути — по стационарным лестницам</td></tr>
        <tr><td>«г»</td><td>Запрещены подъём по раскосам и другим непредназначенным элементам, а также спуск по канатам крана</td></tr>
        <tr><td>«д»</td><td>Управление краном при монтаже — только с места, указанного в эксплуатационной документации</td></tr>
      </tbody>
    </table></div>
    <p>Пересказ сделан инженерной службой КРАН-КУБАНЬ своими словами, а точные формулировки читают в тексте ФНП. Здесь и далее «ПС» в приказе означает подъёмное сооружение; башенный кран — частный случай ПС.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Подпункт «а» пункта 41 говорит о двух запретах сразу: посторонним не место на монтажной площадке, а самим монтажникам нельзя находиться в кабине машиниста, на металлоконструкциях ПС, внутри них и в опасной зоне. Оговорка в конце подпункта — «если это не оговорено специально в эксплуатационной документации ПС» — означает, что исключение может дать только изготовитель, а не бригада.</p>
    <p>Для КРАН-КУБАНЬ практический вывод такой: граница площадки задаётся до приезда техники, а не в день монтажа. Что считается опасной зоной крана и как её определяют, разобрано в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>; границу площадки монтажа КРАН-КУБАНЬ берёт из ППР на монтаж.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Три подпункта пункта 41 — «б», «в» и «г» — касаются только высоты: работа идёт со средств подмащивания, переходы — по лестницам и трапам, а лазать по раскосам и спускаться по канатам запрещено. КРАН-КУБАНЬ выделяет здесь один смысл: безопасный путь по крану должен быть предусмотрен конструкцией, а не выбираться монтажником по месту.</p>
    <p>Подпункт «в» содержит отдельную фразу про надземные рельсовые пути: на них персонал поднимается по стационарным лестницам, прикреплённым к конструкциям строений, а перемещается вдоль пути по инструкции, которую утверждает организация, где ведут монтаж или наладку. У моделей парка КРАН-КУБАНЬ с рельсовым ходом — КБ-408.21 — в реестре указан наземный рельсовый крановый путь, поэтому эта фраза к ним применяется только если путь по проекту уложен на эстакаде (вывод инженерной службы, а не текст нормы).</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пункт 38 ФНП № 461 задаёт 4 требования к электробезопасности на монтажной площадке и при наладке. Токоведущие части и места присоединения проводов к машинам и трансформаторам ограждают; временные электрические сети монтируют только аттестованные электромонтёры по технологическому регламенту; работы на токоведущих частях при напряжении более 50 В ведут только при снятом напряжении; на устройства, подающие напряжение, вывешивают таблички.</p>
    <p>Заказчику КРАН-КУБАНЬ из этого важно одно: подключение крана к питанию — не работа для случайного электрика стройплощадки. Заземление и молниезащита крана в этот пункт не входят и описаны отдельно в статье <a href="/blog/zazemlenie-i-molniezashchita-bashennogo-krana/">«Заземление и молниезащита башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Пункты 39 и 40 ФНП № 461 связывают монтаж с двумя людьми и двумя документами: ИТР, ответственным за безопасное производство работ, и ППР вместе с руководством изготовителя по монтажу. Погрузку и разгрузку при монтаже ведут под руководством этого инженера, а до начала работ участников инструктируют (п. 39). КРАН-КУБАНЬ оформляет инструктаж под подпись.</p>
    <p>По пункту 40 монтаж идёт в последовательности, указанной в руководстве изготовителя и в ППР на конкретный объект. Если ППР или технологическую карту меняют в процессе монтажа, изменения разрабатывает организация, отвечающая за монтаж, и оформляет исполнительные документы — чертежи, схемы, описания. Требования к демонтажу определяют отдельно: они входят в ППР на монтаж, а сам ППР на демонтаж допускается выпускать отдельным документом (<a href="/blog/demontazh-bashennogo-krana/">разбор демонтажа</a>).</p>
    <p>Состав ППР и расстояния по пункту 156 ФНП разобраны в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«ППР для башенного крана»</a>, срок монтажа по моделям — в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Пункты 42–47 ФНП № 461 описывают саму сборку, и для башенного крана важны требования пунктов 43, 44, 45 и 47. Сборку выполняют по руководству по эксплуатации; крупногабаритные узлы укладывают на место монтажа грузоподъёмными механизмами, а фактическая несоосность стыкуемых узлов не должна превышать допуски руководства (п. 43). Числовых допусков в самом приказе нет, и КРАН-КУБАНЬ их не называет.</p>
    <p>Пункт 44 требует, чтобы сборка и монтаж металлоконструкций самомонтируемых башенных кранов велись на подготовленном участке наземного рельсового пути. Пункт 45 запрещает начинать соединение, пока положение узлов неустойчиво: операции сборки не должны приводить к падению. Выбор между рельсовым путём и фундаментом для моделей парка разобран в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>
    <p>После монтажа металлоконструкций пункт 47 требует запасовки грузовых канатов, наладки тормозов, ограничителей, указателей и регистраторов, а в конце — наладки системы управления в целом. Работы с приборами безопасности описаны в статье <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>. Для giraFFe SMK-5.66, который по реестру КРАН-КУБАНЬ монтируют за 4–6 часов двое рабочих и один 25-тонный автокран, порядок тот же: короткий срок не отменяет наладку.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>ФНП № 461 не возлагает на заказчика отдельных обязанностей на монтажной площадке, поэтому КРАН-КУБАНЬ предлагает перечень из 5 пунктов как рабочую рекомендацию, а не как требование нормы. Он помогает выполнить пункты 38–41 и не сорвать график.</p>
    <ul>
      <li>Огородить площадку и назначить одного ответственного за допуск людей — подпункт «а» пункта 41.</li>
      <li>Проверить, что временное электропитание подключит аттестованный электромонтёр (п. 38).</li>
      <li>Освободить подъезд и место разгрузки секций мачты, стрелы и противовеса.</li>
      <li>Назвать ИТР, ответственного за безопасное производство работ с ПС (п. 39).</li>
      <li>Передать КРАН-КУБАНЬ актуальную версию ППР — изменения вносит только организация, отвечающая за монтаж (п. 40).</li>
    </ul>
    <p>Адрес объекта, высоту здания и наличие питания можно прислать через <a href="/#order">форму на главной</a> — КРАН-КУБАНЬ назовёт модель, порядок монтажа и перечень документов.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора от 26.11.2020 № 461, ФНП: пункты 38–47' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/', label: 'kran-kuban.ru — ППР для башенного крана' },
    ]} />
</BlogArticleLayout>
