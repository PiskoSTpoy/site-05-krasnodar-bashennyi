---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 116. Девяносто третья статья блога — угол (b) коммерческий / сравнительный.
// Основание под кран по пяти моделям парка. Фактура — только parkModels.ts и карточки
// /park/* (CHECKED карточек: 17–20 августа 2026): тип основания по моделям; КБ-408.21 —
// наземный рельсовый путь, база/колея 7,5 × 7,5 м, масса 63,5 т, противовес 45 т,
// СП 12-103-2002 (нагрузка колеса до 325 кН), ГОСТ 35321-2025 с 01.01.2026,
// акт по РД 22-28-35-99; MDT 219 J10 и MCH 175 — путь или монолитный фундамент;
// КБ-674А — фундамент и анкеровка к зданию; SMK-5.66 — опорный контур 4×4 м, без
// фундамента, монтаж 4–6 ч, два человека и 25-тонный автокран. ФНП № 461 п. 44
// (сборка на подготовленном наземном рельсовом пути) — сырой текст legalacts.ru.
// Расчёты КРАН-КУБАНЬ: 4 × 4 = 16 м²; 7,5 × 7,5 = 56,25 м²; 56,25 / 16 ≈ 3,5.
// НЕ названо: размеры фундаментов, глубина, цены и сроки устройства основания — в реестре нет.

const CHECKED = '19 октября 2026 года';
const PUBLISHED = '2026-10-19';

const title = 'Основание под башенный кран: 4 схемы в парке и 16 м² SMK';
const description = 'Рельсовый путь, монолитный фундамент, анкеровка к зданию или опорный контур 4×4 м: какое основание нужно каждой из пяти моделей парка КРАН-КУБАНЬ.';
const h1 = 'Какое основание нужно башенному крану: путь, фундамент, анкеровка или контур';
const crumbTitle = 'Основание под башенный кран по моделям';
const slug = 'osnovanie-pod-bashennyi-kran-po-modelyam';

const H2 = [
  'Пять моделей и четыре основания: сводка парка',
  'Рельсовый путь для КБ-408.21: база 7,5 × 7,5 м',
  'Путь или фундамент для Potain MDT 219 J10 и MCH 175',
  'Анкеровка КБ-674А: нагрузку несёт здание',
  'Контур 4 × 4 м у giraFFe SMK-5.66',
  'Занимаемая площадь: 16 против 56,25 м²',
  'Документы на основание до установки крана',
  'Как выбрать основание под объект',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Нужен ли фундамент под башенный кран?',
    a: 'Не всем моделям. В парке КРАН-КУБАНЬ рельсовому КБ-408.21 нужен наземный путь, Potain MDT 219 J10 и MCH 175 ставят на путь или монолитный фундамент, КБ-674А — на фундамент с анкеровкой к зданию, а giraFFe SMK-5.66 обходится опорным контуром 4 × 4 м без фундамента.',
  },
  {
    q: 'Что лучше для башенного крана: рельсовый путь или фундамент?',
    a: 'Путь позволяет крану перемещаться вдоль фронта работ, фундамент фиксирует его в одной точке. Для MDT 219 J10 и MCH 175 выбор делает проект монтажа конкретной площадки, а не каталог. Подробное сравнение схем — в отдельной статье блога КРАН-КУБАНЬ.',
  },
  {
    q: 'Какой размер рельсового пути у КБ-408.21?',
    a: 'База и колея пути у КБ-408.21 — 7,5 × 7,5 м, то есть площадь контура 56,25 м². Масса крана 63,5 т, противовес 45 т из десяти железобетонных блоков. Геометрию пути под площадку считает проектировщик, данные карточки — исходные.',
  },
  {
    q: 'Почему giraFFe SMK-5.66 не требует фундамента?',
    a: 'Кран встаёт на собственный опорный контур 4 × 4 м с аутригерами на существующее покрытие площадки. Остаётся проверить несущую способность под четырьмя опорами. Монтаж занимает 4–6 часов силами двух человек и 25-тонного автокрана, по данным карточки модели.',
  },
  {
    q: 'Что принимают по акту: путь или кран?',
    a: 'Рельсовый путь принимают актом сдачи-приёмки по рекомендуемой форме РД 22-28-35-99, до его подписания кран по пути не ездит. Технические требования к самому пути с 1 января 2026 года задаёт ГОСТ 35321-2025. Данные взяты из карточек КБ-408.21 и MDT 219 J10.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">Пять моделей парка КРАН-КУБАНЬ стоят на четырёх разных основаниях: рельсовый путь у КБ-408.21, путь или монолитный фундамент у Potain MDT 219 J10 и MCH 175, фундамент с анкеровкой к зданию у КБ-674А и опорный контур 4 × 4 м у giraFFe SMK-5.66. Основание определяет сроки подготовки площадки раньше, чем грузоподъёмность и вылет.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Реестр парка КРАН-КУБАНЬ фиксирует для каждой модели одно поле «основание», и по нему видно, где подготовка площадки тяжелее. Сводка ниже составлена по этому реестру и карточкам моделей; размеры фундаментов и глубины в реестре не указаны, поэтому в таблице их нет.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Тип</th><th>Основание по реестру парка</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>С оголовком</td><td>Наземный рельсовый крановый путь</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>Топлесс</td><td>Рельсовый путь или монолитный фундамент</td></tr>
        <tr><td>Potain MCH 175</td><td>Маховая стрела</td><td>Рельсовый путь или монолитный фундамент</td></tr>
        <tr><td>КБ-674А</td><td>Приставной</td><td>Фундамент и анкеровка к конструкции здания</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>Быстромонтируемый</td><td>Опорный контур 4 × 4 м, фундамент не требуется</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>КБ-408.21 стоит на наземном рельсовом пути весь срок стройки, и база с колеей у него совпадают: 7,5 × 7,5 м. Площадь контура — 56,25 м² (расчёт КРАН-КУБАНЬ). Масса крана 63,5 т, противовес 45 т из десяти железобетонных блоков, поэтому путь рассчитывают под каждую площадку отдельно.</p>
    <p>Свод правил СП 12-103-2002, по данным карточки КБ-408.21, допускает нагрузку колеса на рельс до 325 кН. С 1 января 2026 года технические требования к пути задаёт ГОСТ 35321-2025, а готовый путь принимают актом сдачи-приёмки по рекомендуемой форме РД 22-28-35-99. Сборку самомонтируемого башенного крана пункт 44 ФНП № 461 разрешает только на подготовленном наземном рельсовом пути.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Potain MDT 219 J10 и MCH 175 в парке КРАН-КУБАНЬ допускают оба основания: наземный рельсовый путь или монолитный фундамент. Каталог выбор не делает, его определяет проект монтажа конкретной площадки. У обеих моделей грузоподъёмность до 10 т, но вылет разный: 65 м у MDT 219 J10 и до 55 м у MCH 175.</p>
    <p>Путь нужен, когда крану предстоит двигаться вдоль длинного фронта, фундамент — когда работа идёт из одной точки. Общее сравнение двух схем, без привязки к моделям, КРАН-КУБАНЬ разобрал в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>; расчёт на сейсмику для обоих оснований делает проектировщик, отдельного «сейсмостойкого исполнения» у MDT 219 J10 нет.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КБ-674А набирает высоту не за счёт грунта: башня крепится к строящемуся зданию, и нагрузку держит конструкция объекта. Свободно кран поднимает крюк до 60 м, приставным способом — до 116–120 м, а основанием служат фундамент и анкеровка к зданию. Это самое высокое сочетание в парке КРАН-КУБАНЬ.</p>
    <p>Для основания отсюда следует вывод инженерной службы: расчёт анкерных опор входит в проект здания, а не только в проект крана. Общие вопросы схем — в статье <a href="/blog/svobodnostoyashchiy-ili-pristavnoy-bashennyi-kran/">«Свободностоящий или приставной кран»</a>. Пункт 36 ФНП № 461 требует, чтобы монтируемый кран соответствовал параметрам эксплуатационной документации, включая крепления.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>giraFFe SMK-5.66 — единственная модель парка КРАН-КУБАНЬ без пути, фундамента и анкеровки: кран встаёт на собственный опорный контур 4 × 4 м с аутригерами. От доставки до готовности к подъёму проходит 4–6 часов, монтаж ведут двое рабочих и 25-тонный автокран. Максимальная нагрузка — 5 т, на вылете 43 м — 1,05 т.</p>
    <p>Подготовка площадки сводится к проверке несущей способности под четырьмя опорами существующего покрытия. Если покрытие слабое, КРАН-КУБАНЬ предложит усилить пятно под опорами, а не строить фундамент на весь срок аренды. Для невысокого объекта до 41,7 м такое решение дешевле по времени, о чём подробнее в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Опорный контур giraFFe SMK-5.66 занимает 16 м² (4 × 4 м), контур рельсового КБ-408.21 — 56,25 м² (7,5 × 7,5 м). Разница — в 3,5 раза (расчёт КРАН-КУБАНЬ по реестру парка), и она даёт больше места под склад, проезд и бытовки на тесном участке. Длина самого рельсового пути сюда не входит и зависит от фронта работ.</p>
    <p>Сравнение площадей не заменяет сравнение возможностей. SMK-5.66 поднимает 5 т и крюк до 41,7 м, КБ-408.21 — 10 т и крюк 54,0–72,7 м. Для тесного участка КРАН-КУБАНЬ сначала проверяет, достаточно ли высоты и груза у лёгкой модели, и только потом считает контур. Дополнительно можно сверить <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">высоту подъёма по моделям</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Для рельсовых и фундаментных схем КРАН-КУБАНЬ готовит комплект до выезда крана: изыскания на площадке, расчёт основания проектировщиком, акт приёмки пути по РД 22-28-35-99 для рельсовых кранов. Без подписанного акта КБ-408.21 по пути не ездит, независимо от того, насколько плотным выглядит балласт.</p>
    <p>Для SMK-5.66 комплект короче, но не пустой: проверка несущей способности под опорами и проект производства работ с учётом автокрана, который ставит кран. Состав работ на площадке описан в статьях <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом»</a> и <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«Проект производства работ»</a>; сроки устройства основания в реестре КРАН-КУБАНЬ не указаны.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Выбор основания КРАН-КУБАНЬ строит от задачи на площадке, а не от модели. Таблица ниже — ориентир инженерной службы, а не норма: итоговое решение даёт проект.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Условие на площадке</th><th>Основание</th><th>Модель парка</th></tr></thead>
      <tbody>
        <tr><td>Длинный фронт работ, крану нужно двигаться</td><td>Рельсовый путь</td><td>КБ-408.21, MDT 219 J10</td></tr>
        <tr><td>Работа из одной точки, нужен большой вылет</td><td>Монолитный фундамент</td><td>MDT 219 J10, MCH 175</td></tr>
        <tr><td>Высота свыше 73 м</td><td>Фундамент и анкеровка к зданию</td><td>КБ-674А</td></tr>
        <tr><td>Тесный участок, невысокий объект</td><td>Опорный контур 4 × 4 м</td><td>giraFFe SMK-5.66</td></tr>
      </tbody>
    </table></div>
    <p>Заявку с адресом и высотой объекта можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель, основание и перечень документов. Размеры и стоимость основания зависят от грунта площадки, поэтому без изысканий они не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели, основания и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/kb-408-21/', label: 'kran-kuban.ru — КБ-408.21: рельсовый путь, база 7,5 × 7,5 м, масса и противовес' },
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — giraFFe SMK-5.66: опорный контур 4 × 4 м, монтаж 4–6 часов' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461: ФНП, пп. 36 и 44' },
    ]} />
</BlogArticleLayout>
