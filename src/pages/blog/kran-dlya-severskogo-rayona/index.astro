---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 80. Пятнадцатая статья блога — Северский район, ещё одна степная/
// предгорная территория рядом с уже закрытым Абинским (Волна 79), но с иным
// экономическим профилем: не металлургия, а нефтепереработка, причём сразу
// два действующих завода в границах одного района.
//
// Экономический слой: ООО «Ильский НПЗ» (в реестрах и отраслевых обзорах
// также встречается под старым названием ООО «КНГК-ИНПЗ», ИНН 2308128110,
// ОГРН 1072308002172) — производственная площадка на 55-м км автодороги
// Краснодар — Новороссийск, пгт Ильский; юридический адрес по актуальной
// выписке — Красногорск Московской области, поэтому в статье как факт
// зафиксирована именно площадка, а не место регистрации юрлица. История по
// открытым источникам: площадка запущена в 1980 году как производство
// дорожного и строительного битума, в начале 2000-х перепрофилирована на
// нефтепереработку, к 2010 году — три технологические установки и 1,1 млн
// тонн нефти в год, к 2015 году — около 3 млн тонн, в 2016 году завод
// подключён к трубопроводу «Транснефти».
//
// Второй завод — ООО «Афипский НПЗ» (ИНН 7704214548, ОГРН 1037739597059,
// пгт Афипский, тер. Промзона, тот же Северский район) — старше Ильского:
// решение о строительстве газобензинового завода принято в 1952 году, первая
// очередь пущена 31 декабря 1963 года, с 1964 года — переработка
// газоконденсатов края в бензин А-66 и дизельное топливо. Проектная мощность
// по открытым данным — 6,25 млн тонн нефти в год, по итогам 2022 года
// переработано 7,017 млн тонн; в 2013-2017 годах прошла модернизация
// (вакуумная перегонка мазута, висбрекинг гудрона, утилизация сероводорода),
// в марте 2025 года введён в эксплуатацию комплекс гидрокрекинга. Оба факта
// сверены по нескольким независимым реестровым и отраслевым источникам
// (spark-interfax, rusprofile, list-org, отраслевые обзоры), egress сессии
// не пропускал прямой доступ к ru.wikipedia.org и base.garant.ru — цифры
// даны как опубликованные отраслевые данные, а не как цитата первоисточника
// завода.
//
// Как и в Волнах 76-79, сетевой egress не пропускал docs.cntd.ru и
// base.garant.ru (Приложение Б ТСН 22-302-2000) напрямую — WebSearch тоже не
// дал прямой цитаты строки Северского района. Балл сейсмики для площадки в
// статье сознательно не назван — та же честная развилка, что и в предыдущих
// четырёх статьях подряд.

const CHECKED = '6 сентября 2026 года';

const title = 'Кран для Северского района: два нефтезавода на трассе Краснодар — Новороссийск';
const description = 'Северский район живёт нефтепереработкой: Ильский и Афипский заводы стоят у одной и той же трассы Краснодар — Новороссийск — что это значит для монтажа башенного крана.';
const h1 = 'Кран для Северского района: два нефтезавода на трассе Краснодар — Новороссийск';
const crumbTitle = 'Кран для Северского района';
const slug = 'kran-dlya-severskogo-rayona';

const H2 = [
  'Северский район — промышленный коридор между Краснодаром и Новороссийском',
  'Ильский НПЗ: от битумной площадки до нефтепереработки',
  'Афипский НПЗ: завод старше на полвека, с ещё одной модернизацией в 2025 году',
  'Сейсмика: что можно сказать про Северский район, а что нет',
  'Закон о тишине действует и здесь — без региональной скидки',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Раз в районе два действующих НПЗ, значит ли это, что кран в Северском районе нужен только на их площадках?',
    a: 'Нет. Оба завода — крупные, регулярно модернизируемые промышленные объекты, но район живёт не только ими: жилая застройка станицы Северской и посёлков, сельская инфраструктура, объекты деревообработки и производства стройматериалов — всё это тоже площадки для монтажа крана, причём с другими требованиями к грузоподъёмности и графику, чем реконструкция технологической установки НПЗ. Разнородный спрос — обычная картина для промышленного района, а не исключение.',
  },
  {
    q: 'Правда ли, что сейсмика Северского района ниже, чем у соседнего Абинского?',
    a: 'Мы не можем этого утверждать и потому не приводим в статье конкретную цифру. Доступные в этой волне источники не подтвердили прямой цитатой строку Северского района в Приложении Б ТСН 22-302-2000 — так же, как ранее не подтвердили её для Абинского района. Соседство на карте края само по себе не говорит о том, выше или ниже расчётный балл здесь: это определяет проектировщик по действующей редакции норматива для конкретной площадки, а не сравнение с соседним районом.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Северского района', item: `${SITE}/blog/kran-dlya-severskogo-rayona/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-severskogo-rayona/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-severskogo-rayona/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье (Анапа, Новороссийск, Сочи, Ейск, Туапсе), предгорную ось (Армавир, Горячий Ключ, Апшеронский и Мостовской районы), равнинный речной город (Славянск-на-Кубани) и степной металлургический Абинский район. Северский район стоит рядом с Абинским на той же карте — тоже граница степи и первых отрогов Кавказа, тот же транспортный коридор Краснодар — Новороссийск, — но экономический якорь здесь другой: не металлургия, а нефтепереработка, причём сразу два действующих завода.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Северский район с административным центром в станице Северской занимает предгорную часть края между Краснодаром и Новороссийском. Через район проходит та же трасса, что связывает краевой центр с портовым Новороссийском, и именно вдоль неё сосредоточена основная промышленность района. Курортной функции у Северского района нет: сюда не едут ради моря и здравниц, спрос на технику формируют действующие производства и обслуживающая их инфраструктура, а не туристический сезон.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>ООО «Ильский НПЗ» (в реестрах и отраслевых обзорах встречается и под прежним названием КНГК-ИНПЗ, ИНН 2308128110, ОГРН 1072308002172) — производственная площадка на 55-м километре автодороги Краснодар — Новороссийск, в посёлке городского типа Ильский. По опубликованным отраслевым данным, площадка начинала в 1980 году как производство дорожного и строительного битума и лишь в начале 2000-х годов была перепрофилирована на переработку нефти: к 2010 году здесь заработали три технологические установки суммарной мощностью около 1,1 миллиона тонн нефти в год, а ещё через пять лет мощность выросла примерно до 3 миллионов тонн. В 2016 году завод подключили к трубопроводу «Транснефти», что упростило поставку сырья. Для арендодателя крана это означает регулярный, хоть и не всегда крупный, спрос на технику под реконструкцию и расширение технологических узлов — отдельно от жилой и коммерческой стройки района.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>В 20 с небольшим километрах от Ильского, в посёлке городского типа Афипский того же Северского района, работает завод куда более давней истории — ООО «Афипский НПЗ» (ИНН 7704214548, ОГРН 1037739597059). Решение о строительстве газобензинового завода для переработки попутного нефтяного газа было принято ещё в 1952 году, первая очередь пущена 31 декабря 1963 года, а с 1964 года завод перерабатывал газоконденсаты Краснодарского края в бензин А-66 и дизельное топливо. По опубликованным данным, проектная мощность сегодня — 6,25 миллиона тонн нефти в год, а по итогам 2022 года переработано 7,017 миллиона тонн; в 2013–2017 годах прошла модернизация с вводом установок вакуумной перегонки мазута и висбрекинга гудрона, а в марте 2025 года запущен новый комплекс гидрокрекинга. Два завода разного возраста и масштаба в границах одного района — обычная для Северского района картина: спрос на кран здесь формируют не одна, а несколько независимо развивающихся промышленных площадок.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Здесь мы, как и в статье про соседний Абинский район, сознательно не приводим конкретный балл сейсмичности. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Северского района доступные в этой волне источники надёжно не подтвердили. Соседство с уже разобранным Абинским районом на карте ничего не говорит о том, совпадает расчётный балл или отличается: это вопрос к действующей редакции норматива для конкретной площадки, а не к географической близости. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Северском районе так же, как в Сочи или Краснодаре: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дополнительным дневным перерывом на отдых, а ответственность по статье 3.3 одинакова для всего края независимо от того, стоит рядом промышленная площадка или частный дом. У технологических установок НПЗ, удалённых от жилой застройки, риск жалобы соседей ниже, чем у стройки в станице Северской или в посёлке при заводе, — но само требование к часам работы это не отменяет. Подробный разбор часов и сумм штрафов — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Северский район — предгорный промышленный коридор между Краснодаром и Новороссийском, без курортной функции, соседствует на карте с уже разобранным Абинским районом.</li>
      <li>Основной промышленный заказчик представлен сразу двумя действующими нефтеперерабатывающими заводами: Ильский НПЗ (ИНН 2308128110) — на 55-м км трассы Краснодар — Новороссийск, и более старый Афипский НПЗ (ИНН 7704214548) — с историей переработки с 1963 года и модернизацией 2025 года.</li>
      <li>Спрос на кран в районе распределён между несколькими независимыми промышленными площадками, а не сосредоточен на одном заказчике.</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Северского района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Северском районе так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://spark-interfax.ru/krasnodarski-krai-severski-raion/ooo-kngk-inpz-inn-2308128110-ogrn-1072308002172-f8cf590d04db4394ab019a1874a232b1', label: 'spark-interfax.ru — ООО «Ильский НПЗ» (КНГК-ИНПЗ), ИНН 2308128110' },
      { href: 'https://www.rusprofile.ru/id/4443005', label: 'rusprofile.ru — ООО «Ильский НПЗ», регистрационные данные' },
      { href: 'https://www.rusprofile.ru/id/4135737', label: 'rusprofile.ru — ООО «Афипский НПЗ», ИНН 7704214548' },
      { href: 'https://companies.rbc.ru/id/1037739597059-ooo-afipskij-neftepererabatyivayuschij-zavod/', label: 'РБК Компании — ООО «Афипский НПЗ»' },
      { href: 'https://nangs.org/news/downstream/refining/afipskiy-npz-rezko-uvelichil-neftepererabotku-posle-perehoda-k-gutserievu', label: 'nangs.org — модернизация и мощность Афипского НПЗ' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
    ]} />
</BlogArticleLayout>
