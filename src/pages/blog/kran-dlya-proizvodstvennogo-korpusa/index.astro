---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 117. Девяносто шестая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «производственный корпус 144 × 48 м» (иллюстрация, помечена в тексте):
// какая модель парка закрывает пятно застройки с рельсового пути вдоль длинной стороны.
// Фактура — только parkModels.ts и карточки /park/* (вылет, грузоподъёмность на конце,
// основание, высота): MDT 219 J10 — 65 м, 1,9 т на 65 м, путь или фундамент;
// MCH 175 — до 55 м, 1,5 т на 55 м; КБ-408.21 — 40 м, наземный путь; КБ-674А — 50,5 м,
// анкеровка к зданию; SMK-5.66 — 43 м, 1,05 т на 43 м, крюк до 27 м с горизонтальной стрелой.
// Расчёты КРАН-КУБАНЬ (теорема Пифагора, ось пути в 6 м от стены — допущение):
// дальняя кромка 6 + 48 = 54 м; MDT: √(65² − 54²) = √1309 ≈ 36,2 м → путь ≥ 144 − 72,4 = 71,6 м;
// MCH: √(55² − 54²) = √109 ≈ 10,4 м → путь ≥ 144 − 20,9 ≈ 123,1 м; одна стационарная точка
// у середины длинной стороны: √(72² + 54²) = 90 м > 65 м; КБ-408.21 закрывает полосу 40 − 6 = 34 м
// глубины, SMK — 43 − 6 = 37 м. Груз на 54 м у MDT в реестре нет — сказано, что не меньше 1,9 т
// по общему правилу характеристики, точное значение по паспорту.
// НЕ названо: цены, сроки, размеры реальных корпусов, допустимые зазоры (их задаёт ППР).

const CHECKED = '22 октября 2026 года';
const PUBLISHED = '2026-10-22';

const title = 'Кран для производственного корпуса: расчёт по 5 моделям';
const description = 'Корпус 144 × 48 м с рельсового пути: Potain MDT 219 J10 закрывает его с путём от 71,6 м, MCH 175 — от 123 м, КБ-408.21 — только полосу 34 м. Расчёт КРАН-КУБАНЬ.';
const h1 = 'Какой башенный кран нужен для производственного корпуса: расчёт по пяти моделям';
const crumbTitle = 'Кран для производственного корпуса';
const slug = 'kran-dlya-proizvodstvennogo-korpusa';

const H2 = [
  'Исходные данные примера: корпус 144 × 48 м',
  'Почему одной стоянки крана не хватает',
  'Potain MDT 219 J10: путь от 71,6 м',
  'Potain MCH 175: запас 1 м и путь почти во всю длину',
  'КБ-408.21 и giraFFe SMK-5.66: полоса 34 и 37 м',
  'КБ-674А: почему приставной кран не для одноэтажного цеха',
  'Сводка: модель, глубина покрытия и длина пути',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой башенный кран нужен для строительства склада или цеха?',
    a: 'Для широкого одноэтажного корпуса главный параметр — вылет, а не высота. В расчёте КРАН-КУБАНЬ для корпуса шириной 48 м с пути вдоль длинной стороны полностью закрывают пятно Potain MDT 219 J10 с вылетом 65 м и, с минимальным запасом, Potain MCH 175 с вылетом до 55 м.',
  },
  {
    q: 'Можно ли построить цех одним стационарным башенным краном?',
    a: 'Зависит от размеров. Для корпуса 144 × 48 м из примера КРАН-КУБАНЬ дальний угол от стоянки у середины длинной стороны находится в 90 м, а наибольший вылет в парке — 65 м у Potain MDT 219 J10. Поэтому для такого корпуса нужен рельсовый путь или второй кран.',
  },
  {
    q: 'Какой длины нужен рельсовый путь для башенного крана?',
    a: 'Длина пути зависит от вылета и размеров корпуса. В примере КРАН-КУБАНЬ для корпуса 144 × 48 м путь Potain MDT 219 J10 должен быть не короче 71,6 м, а Potain MCH 175 — около 123,1 м. Окончательную длину и положение пути задаёт проект производства работ.',
  },
  {
    q: 'Подойдёт ли быстромонтируемый кран для промышленного здания?',
    a: 'Для узкого невысокого здания — да. giraFFe SMK-5.66 с вылетом 43 м при оси в 6 м от стены закрывает полосу глубиной 37 м и поднимает крюк до 27 м с горизонтальной стрелой. Корпус шириной 48 м с одной стороны SMK-5.66 не закрывает.',
  },
  {
    q: 'Сколько груза поднимет кран на краю корпуса?',
    a: 'Грузоподъёмность на дальней кромке определяют по таблице паспорта крана. В реестре КРАН-КУБАНЬ указан груз на конце стрелы: 1,9 т на 65 м у Potain MDT 219 J10 и 1,5 т на 55 м у MCH 175. На меньшем вылете допустимый груз не ниже концевого.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">Для производственного корпуса шириной 48 м из пяти моделей парка КРАН-КУБАНЬ всё пятно застройки с рельсового пути вдоль длинной стороны закрывает Potain MDT 219 J10 с вылетом 65 м и путём от 71,6 м. Potain MCH 175 справляется с запасом около 1 м, а КБ-408.21 и giraFFe SMK-5.66 закрывают только полосу глубиной 34 и 37 м. Расчёт сделан на условном корпусе 144 × 48 м.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пример КРАН-КУБАНЬ — одноэтажный производственный корпус 144 × 48 м, а ось рельсового пути проходит в 6 м от длинной стены. Размеры и отступ — иллюстрация для расчёта, а не данные реального объекта: фактическое расстояние от пути до здания задаёт проект производства работ. Дальняя кромка корпуса при таком отступе находится в 6 + 48 = 54 м от оси пути.</p>
    <p>Высота одноэтажного цеха для выбора модели вторична: даже giraFFe SMK-5.66 с горизонтальной стрелой поднимает крюк до 27 м. Решают вылет и основание, поэтому КРАН-КУБАНЬ сравнивает пять моделей по тому, какую глубину корпуса каждая закрывает и какой длины путь для этого нужен. Вылеты моделей подробно разобраны в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Из одной стоянки у середины длинной стороны дальний угол корпуса 144 × 48 м находится в 90 м: √(72² + 54²) = 90 (расчёт КРАН-КУБАНЬ). Наибольший вылет в парке — 65 м у Potain MDT 219 J10, поэтому ни одна модель не закрывает такой корпус с одной точки. Остаются два решения: рельсовый путь вдоль корпуса или второй кран.</p>
    <p>Рельсовый путь превращает круг обслуживания в вытянутую полосу: кран переезжает вдоль корпуса, и каждая точка дальней кромки оказывается в пределах вылета. Требуемая длина пути считается так: кран должен подъехать к каждому углу на расстояние вдоль пути не больше √(R² − 54²), где R — вылет модели. Общее сравнение оснований — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Potain MDT 219 J10 с вылетом 65 м достаёт дальнюю кромку корпуса на 54 м, оставляя запас 11 м, а вдоль пути дотягивается до угла на √(65² − 54²) ≈ 36,2 м. Отсюда минимальная длина пути: 144 − 2 × 36,2 = 71,6 м (расчёт КРАН-КУБАНЬ). Половина длины корпуса обслуживается краем зоны, поэтому путь получается вдвое короче самого здания.</p>
    <p>По реестру парка КРАН-КУБАНЬ Potain MDT 219 J10 ставят на рельсовый путь или монолитный фундамент и поднимает до 10 т, а на конце стрелы 65 м — 1,9 т. На дальней кромке в 54 м вылет меньше концевого, поэтому допустимый груз не ниже 1,9 т; точное значение берут из таблицы грузовой характеристики в паспорте. Как читать такую таблицу — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Potain MCH 175 с вылетом до 55 м достаёт дальнюю кромку на 54 м с запасом всего 1 м, а вдоль пути дотягивается до угла лишь на √(55² − 54²) ≈ 10,4 м. Минимальная длина пути — около 123,1 м из 144 м длины корпуса (расчёт КРАН-КУБАНЬ). Такой запас КРАН-КУБАНЬ считает недостаточным: любое увеличение отступа от стены, которое потребует ППР, выводит дальнюю кромку за вылет.</p>
    <p>Маховая стрела Potain MCH 175 решает другую задачу — работу на тесной площадке рядом с соседними зданиями, где горизонтальная стрела задевала бы чужие участки. На открытой площадке у производственного корпуса её преимущество не используется, а груз на конце стрелы ниже: 1,5 т на 55 м против 1,9 т на 65 м у MDT 219 J10. Сравнение двух безоголовочных моделей — в статье <a href="/blog/potain-mdt-219-j10-ili-mch-175/">«Potain MDT 219 J10 или MCH 175»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>КБ-408.21 с вылетом 40 м при оси пути в 6 м от стены закрывает полосу корпуса глубиной 34 м, а giraFFe SMK-5.66 с вылетом 43 м — полосу 37 м (расчёт КРАН-КУБАНЬ). Корпус шириной 48 м ни одна из двух моделей с одной стороны не закрывает: остаётся непокрытая полоса 14 и 11 м у дальней стены.</p>
    <p>Для узкого корпуса шириной до 34–37 м обе модели становятся рабочим вариантом, но с разной логикой. КБ-408.21 стоит на наземном рельсовом пути и поднимает до 10 т, а giraFFe SMK-5.66 встаёт на опорный контур 4 × 4 м без фундамента, поднимает до 5 т и монтируется за 4–6 часов, по данным реестра КРАН-КУБАНЬ. Для широкого корпуса возможен второй путь вдоль противоположной стены, но это удваивает подготовку основания.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>КБ-674А в парке КРАН-КУБАНЬ — приставной кран: основание у него фундамент и анкеровка к конструкции здания, а смысл схемы — подъём крюка до 116–120 м. Одноэтажный производственный корпус не даёт ни высоты, ради которой стоит крепить кран к зданию, ни конструкции, к которой его можно надёжно прикрепить. Вылет 50,5 м тоже не закрывает дальнюю кромку в 54 м из примера.</p>
    <p>Для промышленного объекта КБ-674А имеет смысл в другом сценарии: высокий корпус, башня, силос или административное здание выше 73 м на территории предприятия. Там КРАН-КУБАНЬ предлагает его вместе с расчётом креплений, а для широкого низкого цеха ставит рельсовую модель. Схемы установки разобраны в статье <a href="/blog/svobodnostoyashchiy-ili-pristavnoy-bashennyi-kran/">«Свободностоящий или приставной башенный кран»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Сводка КРАН-КУБАНЬ по корпусу 144 × 48 м с осью пути в 6 м от стены показывает, что ширина корпуса отсекает три модели из пяти ещё до сравнения цен. Все числа в таблице — расчёт по реестру парка, условия примера — иллюстрация.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Вылет</th><th>Глубина покрытия корпуса (вылет − 6 м)</th><th>Корпус 48 м</th><th>Длина пути</th></tr></thead>
      <tbody>
        <tr><td>Potain MDT 219 J10</td><td>65 м</td><td>59 м</td><td>Закрывает, запас 11 м</td><td>от 71,6 м</td></tr>
        <tr><td>Potain MCH 175</td><td>до 55 м</td><td>49 м</td><td>Закрывает, запас 1 м</td><td>около 123,1 м</td></tr>
        <tr><td>КБ-674А</td><td>50,5 м</td><td>44,5 м</td><td>Не закрывает; приставная схема</td><td>—</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>43 м</td><td>37 м</td><td>Не закрывает, остаток 11 м</td><td>—</td></tr>
        <tr><td>КБ-408.21</td><td>40 м</td><td>34 м</td><td>Не закрывает, остаток 14 м</td><td>—</td></tr>
      </tbody>
    </table></div>
    <p>Для своего корпуса пришлите в КРАН-КУБАНЬ длину, ширину, высоту и самый тяжёлый элемент с его положением через <a href="/#order">форму на главной</a>: инженерная служба пересчитает пример на реальные размеры и отступ из ППР. Цены и сроки устройства пути в реестре парка не указаны и зависят от грунта площадки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: вылет, грузоподъёмность, основание пяти моделей' },
      { href: 'https://kran-kuban.ru/park/potain-mdt-219-j10/', label: 'kran-kuban.ru — Potain MDT 219 J10: вылет 65 м, 1,9 т на конце стрелы' },
      { href: 'https://kran-kuban.ru/park/potain-mch-175/', label: 'kran-kuban.ru — Potain MCH 175: вылет до 55 м, 1,5 т на конце стрелы' },
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — giraFFe SMK-5.66: вылет 43 м, опорный контур 4 × 4 м' },
    ]} />
</BlogArticleLayout>
