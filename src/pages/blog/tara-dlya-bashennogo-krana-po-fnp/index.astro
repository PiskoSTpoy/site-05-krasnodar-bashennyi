---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 122. Сто десятая статья блога — угол (a) информационный / how-to.
// Источник: ФНП № 461 (приказ Ростехнадзора от 26.11.2020), пп. 216, 218, 222, 224–228 — legalacts.ru (curl, проверено 28.10.2026).
// Факты п. 226: башенные краны с тарой, разгружаемой на весу, — в пределах группы классификации (режима) из паспорта,
// не более 8 циклов в час; тара без вибраторов (кроме грейферов) — суммарная масса тары с грузом в пределах грузоподъёмности;
// тара с вибратором — не более 50 % максимальной грузоподъёмности; одноканатные грейферы, не допускающие разгрузку на весу, — не более 50 %;
// для кранов в нескольких исполнениях «максимальная» — наибольшая среди исполнений; разгрузка равномерно не менее 10 с, мгновенная запрещена.
// П. 227: вибраторы — только при вертикальной оси вращения дисбалансов, возмущающая сила не более 4 кН.
// П. 228: мелкоштучные грузы — только в специальной таре; кирпич на поддонах без ограждения — только при погрузке/разгрузке транспорта на землю
// (и с земли), если иное не сказано в руководстве, документах на тару или в ППР; подъём пакетов кирпича/камней к каменщику — в таре,
// исключающей падение; подъём на поддонах без ограждающих устройств запрещён.
// П. 224: траверсы, клещи, захваты и тара — осмотр каждый месяц; стропы — каждые 10 дней; приспособления, которыми пользуются реже
// чем раз в 10 дней, — перед началом работ; пакетирующие стропы — подъём пакета на 100–200 мм и выдержка не менее 30 с.
// П. 225: результаты осмотра — в журнал. П. 218: негодная тара и тара без маркировки не должна находиться в местах работ.
// П. 222: после ремонта тары (кроме контейнеров) — статические испытания нагрузкой 110 % от разности масс брутто и нетто из характеристик тары.
// П. 216: подвешивание на крюк груза в ковшах, бадьях, контейнерах и другой таре — персоналом с квалификацией «стропальщик».
// Расчёт-иллюстрация КРАН-КУБАНЬ (допущения помечены в тексте): бадья масса 0,7 т; бетон 2,4 т/м³.
//   1,5 м³: 1,5 × 2,4 = 3,6 т бетона + 0,7 т = 4,3 т; 2,0 м³: 4,8 + 0,7 = 5,5 т.
//   8 циклов × 1,5 м³ = 12 м³/ч; 8 × 2,0 = 16 м³/ч (потолок по числу циклов при полной бадье, без учёта грузовой характеристики).
//   Лимит с вибратором (50 % от максимума по parkModels.ts): КБ-408.21 10 т → 5,0 т; Potain MDT 219 J10 10 т → 5,0 т;
//   Potain MCH 175 10 т → 5,0 т; КБ-674А 12,5 т → 6,25 т; giraFFe SMK-5.66 5 т → 2,5 т.
//   Бадья 4,3 т проходит у четырёх моделей (кроме SMK), 5,5 т — только у КБ-674А.
//   Осмотры: тара 12 в год; стропы 365 / 10 ≈ 36 в год.
// НЕ названо: цены, марки конкретных бадей и вибраторов, массы реальных бункеров, грузоподъёмность на конкретном вылете
// (берётся по грузовой характеристике из паспорта), п. 229–230 (испытания ГЗП) не раскрыты.

const CHECKED = '28 октября 2026 года';
const PUBLISHED = '2026-10-28';

const title = 'Тара для башенного крана: бадья, бункер, кирпич по ФНП';
const description = 'Бадья с вибратором — не более 50 % грузоподъёмности, не более 8 циклов в час. Пункты 226–228 ФНП № 461 и осмотр тары: разбор КРАН-КУБАНЬ.';
const h1 = 'Какую тару разрешено поднимать башенным краном: бадья, бункер, поддон с кирпичом';
const crumbTitle = 'Тара для башенного крана по ФНП';
const slug = 'tara-dlya-bashennogo-krana-po-fnp';

const H2 = [
  'Три пункта ФНП о таре: 226, 227 и 228',
  'Сколько тары на крюке: 100 % без вибратора и 50 % с вибратором',
  'Восемь циклов в час: потолок подачи бетона',
  'Разгрузка на весу: не быстрее 10 секунд',
  'Вибратор на таре: ось вертикальна, сила не выше 4 кН',
  'Кирпич и мелкоштучные грузы: когда поддон без ограждения допустим',
  'Осмотр тары: раз в месяц, стропы раз в 10 дней',
  'Сводка: что проверить до первого подъёма бадьи',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько раз в час можно разгружать бадью башенным краном?',
    a: 'Не более 8 циклов работы крана в час при разгрузке тары на весу: так сказано в пункте 226 ФНП № 461. Для бадьи на 1,5 м³ это потолок 12 м³ бетона в час, для бадьи на 2 м³ — 16 м³. Расчёт КРАН-КУБАНЬ иллюстративный и не учитывает грузовую характеристику на вылете.',
  },
  {
    q: 'Какая масса тары с бетоном допустима, если на бадье стоит вибратор?',
    a: 'Не более 50 % максимальной грузоподъёмности крана, включая массу самой тары. Для Potain MDT 219 J10, КБ-408.21 и Potain MCH 175 с максимумом 10 т это 5 т, для КБ-674А с 12,5 т — 6,25 т, для giraFFe SMK-5.66 с 5 т — 2,5 т. Без вибратора предел выше, но он ограничен грузовой характеристикой на рабочем вылете.',
  },
  {
    q: 'Можно ли разгружать бетон из бадьи мгновенно?',
    a: 'Нет. ФНП № 461 требует разгружать тару на весу равномерно в течение не менее 10 секунд, мгновенная разгрузка запрещена. Резкий сброс массы раскачивает груз и ударно нагружает канат и стрелу. Скорость раскрытия затвора бадьи КРАН-КУБАНЬ советует проверять на пробной выдаче до начала бетонирования.',
  },
  {
    q: 'Можно ли поднимать кирпич на поддонах без ограждения?',
    a: 'Только при погрузке или разгрузке транспорта на землю и с земли, если иное не указано в документах на тару или в ППР. Подъём пакетов на поддонах к рабочему месту каменщика разрешён только в таре, исключающей падение кирпича и камней; подъём без ограждающих устройств запрещён пунктом 228 ФНП № 461.',
  },
  {
    q: 'Как часто нужно осматривать тару и стропы?',
    a: 'Тару, траверсы, клещи и захваты осматривают каждый месяц, стропы — каждые 10 дней, а редко применяемые приспособления — перед началом работ. Результат записывают в журнал осмотра. Поврежденные приспособления изымают из работы; негодная и немаркированная тара не должна находиться на площадке вообще.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Тара и бадьи"
  published={PUBLISHED}
>
    <p slot="intro">Башенный кран разгружает тару на весу не более 8 циклов в час, а если на бадье стоит вибратор, масса тары вместе с бетоном не должна превышать 50 % максимальной грузоподъёмности: для крана на 10 т это 5 т. Так устроены пункты 226–228 ФНП № 461, которые КРАН-КУБАНЬ разбирает на примере бадьи с бетоном, бункера и поддона с кирпичом.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Тары на башенном кране касаются три соседних пункта ФНП № 461: 226 задаёт пределы массы и числа циклов, 227 — требования к вибраторам, 228 — правила для мелкоштучных грузов и кирпича. Для КРАН-КУБАНЬ это самые частые вопросы на площадках, где бетон подают бадьёй, а кирпич — на поддонах, и потому пункты удобно читать вместе.</p>
    <p>Пункт 216 добавляет требование к людям, которое КРАН-КУБАНЬ проверяет при допуске бригады: подвешивать на крюк груз в ковшах, бадьях, контейнерах и другой таре должен персонал с квалификацией «стропальщик». Это относится и к рабочим основных профессий, если подвешивание входит в их обязанности. Общие правила обвязки разобраны в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>, а подъём груза в целом — в статье <a href="/blog/podem-gruza-bashennym-kranom-po-fnp/">«Подъём груза башенным краном по ФНП»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Для тары без вибратора, исключая грейферы, ФНП разрешает на кране КРАН-КУБАНЬ или любом другом суммарную массу тары с грузом в пределах грузоподъёмности крана. Для тары с вибратором и для одноканатных грейферов, не допускающих разгрузку на весу, предел жёстче: не более 50 % грузоподъёмности. Если кран выпускают в нескольких исполнениях, «максимальной» считают наибольшую грузоподъёмность среди всех исполнений.</p>
    <p>КРАН-КУБАНЬ пересчитал половинный предел для пяти моделей парка по максимальным значениям из паспортов. Слова «в пределах грузоподъёмности» при этом относятся к грузовой характеристике на рабочем вылете, а не к максимуму у мачты; как читать характеристику — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Максимум по паспорту</th><th>Предел массы тары с вибратором (50 %)</th><th>Бадья 4,3 т</th><th>Бадья 5,5 т</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>10 т</td><td>5,0 т</td><td>проходит</td><td>не проходит</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>10 т</td><td>5,0 т</td><td>проходит</td><td>не проходит</td></tr>
        <tr><td>Potain MCH 175</td><td>10 т</td><td>5,0 т</td><td>проходит</td><td>не проходит</td></tr>
        <tr><td>КБ-674А</td><td>12,5 т</td><td>6,25 т</td><td>проходит</td><td>проходит</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>5 т</td><td>2,5 т</td><td>не проходит</td><td>не проходит</td></tr>
      </tbody>
    </table></div>
    <p>Бадьи в таблице условные: масса порожней бадьи 0,7 т и плотность бетона 2,4 т/м³ — допущения КРАН-КУБАНЬ. Бадья на 1,5 м³ даёт 3,6 т бетона и 4,3 т вместе с тарой, бадья на 2 м³ — 4,8 т бетона и 5,5 т с тарой. Вывод таблицы: лишние 0,5 м³ объёма переводят задачу из класса «подходит четырём моделям» в класс «подходит одной».</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пункт 226 ограничивает число циклов крана при работе с тарой, разгружаемой на весу: не более 8 в час, и только в пределах группы классификации, указанной в паспорте. Для подачи бетона бадьёй это означает потолок, который не зависит от числа бетоновозов у ворот: при бадье на 1,5 м³ кран выдаёт не больше 8 × 1,5 = 12 м³ в час, при бадье на 2 м³ — не больше 16 м³ в час.</p>
    <p>Цифры КРАН-КУБАНЬ — теоретический предел при полной бадье и без учёта высоты подъёма, вылета и времени на выравнивание; в реальности темп ниже. Практический вывод для заказчика: плиту на 120 м³ при бадье 1,5 м³ краном не зальют быстрее 10 часов, а для сплошной заливки без перерыва планируют бетононасос. Это инженерная оценка, а не норма. Схема подачи фиксируется в ППР, о нём — в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«Проект производства работ с башенным краном»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Разгрузка тары на весу на кранах КРАН-КУБАНЬ идёт равномерно не менее 10 секунд, а мгновенная разгрузка запрещена. Причина в динамике: когда несколько тонн бетона уходят из бадьи за секунду, крюк подпрыгивает, стрела качается, а канат получает ударную нагрузку. На Potain MDT 219 J10 с вылетом 65 м такая нагрузка передаётся через длинную стрелу, и раскачивание на дальнем вылете заметно сильнее.</p>
    <p>Что проверить на площадке: затвор бадьи должен открываться плавно, а оператор по сигналу стропальщика не пытается «стряхнуть» остатки бетона рывком крюка. КРАН-КУБАНЬ советует провести пробную выдачу воды или песка до первого бетона и засечь время открытия по часам; это рекомендация инженерной службы. Сигналы и связь — в статье <a href="/blog/raciya-ili-signalshchik-na-bashennom-krane/">«Рация или сигнальщик на башенном кране»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Пункт 227, который КРАН-КУБАНЬ сверяет с документами на бункер, разрешает ставить вибраторы на тару только при вертикальном расположении оси вращения дисбалансов, а возмущающая сила вибратора не должна превышать 4 кН. Норма защищает кран: горизонтальная ось вибратора раскачивала бы груз и нагружала стрелу в боковом направлении, а лишняя сила превращала бы бункер в источник ударов по канату.</p>
    <p>Для КБ-408.21 и КБ-674А это условие проверяют по документам на бункер до выхода на объект, а не на месте. Вибратор увеличивает массу тары, и ограничение 50 % из пункта 226 действует сразу для двух причин: масса и динамика. Вместе с пунктами о ветре оно входит в проверку площадки — см. статью <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Пункт 228 для площадок КРАН-КУБАНЬ разрешает перемещать мелкоштучные грузы только в специальной таре, которая исключает выпадение отдельных частей. Для кирпича сделано отдельное правило: на поддонах без ограждения его допустимо перемещать лишь при погрузке и разгрузке транспортных средств на землю и с земли, если иное не следует из руководства, документов на тару или ППР.</p>
    <p>Подъём пакетов кирпича или керамических камней к рабочему месту каменщика на объектах КРАН-КУБАНЬ происходит только в таре, исключающей падение груза; подъём на поддонах без ограждающих устройств запрещён. Если на площадке КБ-674А или giraFFe SMK-5.66 подают кирпич на этаж, в ППР записывают тип тары и схему, а не «поддоны с плёнкой». Погрузочные нормы по транспорту — в статье <a href="/blog/pogruzka-razgruzka-transporta-bashennym-kranom/">«Погрузка и разгрузка транспорта башенным краном»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Эксплуатирующая организация, в том числе КРАН-КУБАНЬ на своих кранах, через назначенного инженерно-технического работника осматривает траверсы, клещи, захваты и тару каждый месяц, а стропы — каждые 10 дней. Приспособления, которыми пользуются реже чем раз в 10 дней, осматривают перед началом работ. Результаты записывают в журнал осмотра; выявленные повреждённые приспособления изымают из работы.</p>
    <p>Расчёт КРАН-КУБАНЬ для года работы: бадья проходит 12 осмотров, комплект стропов — около 36 (365 дней / 10). Для пакетирующих стропов правило иное: перед каждым подъёмом пакета его поднимают на 100–200 мм над основанием и держат не менее 30 секунд; если форма и целостность пакета не изменились, строп годен, и записи в журнале по этой проверке не требуется.</p>
    <p>Негодная тара, а также тара без маркировки не должна находиться в местах производства работ с краном. После ремонта тары, кроме контейнеров, проводят статические испытания нагрузкой 110 % от разности масс брутто и нетто из характеристик тары. Ежесменный осмотр самого крана описан в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Ежесменный осмотр башенного крана»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Перед первой подачей бетона или кирпича КРАН-КУБАНЬ предлагает пройти пять проверок. Порядок — практика инженерной службы; нормативные основания — пункты ФНП № 461 в скобках.</p>
    <ol>
      <li>Масса тары с грузом сверена с пределом модели: 100 % грузовой характеристики без вибратора, 50 % максимума с вибратором (п. 226).</li>
      <li>Темп подачи не выше 8 циклов в час, разгрузка на весу занимает не менее 10 секунд (п. 226).</li>
      <li>Вибратор стоит осью вертикально, сила не выше 4 кН (п. 227).</li>
      <li>Кирпич подают только в таре с ограждением, поддоны без ограждения — только на землю и с земли (п. 228).</li>
      <li>Тара промаркирована, осмотрена, запись внесена в журнал; стропальщик имеет квалификацию (пп. 216, 218, 224, 225).</li>
    </ol>
    <p>Если одна из проверок не проходит, выход прост: меньший объём бадьи, другая модель или бетононасос. Размеры бадьи и тип подачи можно отправить через <a href="/#order">форму на главной</a>, и КРАН-КУБАНЬ назовёт подходящую модель парка. Цены и сроки зависят от площадки и здесь не называются.</p>

