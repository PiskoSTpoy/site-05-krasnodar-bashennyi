---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 74. Девятая статья блога — продолжение предгорной оси Волны 73
// (Горячий Ключ) на оставшемся кандидате из списка волны: Апшеронский район.
// Прямой первоисточник — обоснование генерального плана Нефтегорского
// городского поселения Апшеронского района (nf.apsheronsk-oms.ru), .doc,
// найден через навигацию по сайту администрации поселения (путь
// /general-nyy-plan.html → /tinybrowser/files/gd/gp/...doc; первый URL из
// сниппета WebSearch вёл на несуществующий /tinybrowser_subsites/_nf_/...
// — 404, перепроверено прямым curl до скачивания). Файл (2,1 МБ, cp1251)
// скачан локально и прочитан без модели-посредника — antiword -m cp1251.txt
// + iconv -f cp1251 -t utf-8, как и Горячий Ключ в Волне 73 (тот же класс
// метода: WebFetch на .doc/.pdf генплана даёт ненадёжный текст, прямое
// чтение — нет). Документ содержит именно то, что не даёт таблица
// сейсмичности по городам (base.garant.ru снова не содержит ни Апшеронска,
// ни Нефтегорска, ни Хадыженска — перепроверено, честно не процитировано):
// собственную трёхступенчатую классификацию площадок по сложности освоения
// (I/II/III инженерно-геологический район) и поимённый список из 17+ улиц
// пос. Нефтегорск в зоне оползневых процессов (Победы, Горького, Школьная,
// Гражданская, Физкультурная), с реками Нефтянка/Голышка/Чекуха как осью
// концентрации оползней, и с той же нормой «балл сейсмичности в оползневой
// зоне должен быть увеличен», что цитировал генплан Горячего Ключа (ТСН
// 22-302-2000, СНиП II-7-81*) — независимое совпадение формулировки в двух
// разных документах разных муниципалитетов, не копипаста с этого сайта.
// Независимо перепроверена и датирована история посёлка прямым WebFetch:
// катастрофа 13-18 января 1978 года (42 дома разрушены, 51 повреждён,
// переселение пострадавших в Апшеронск и Хадыженск — та же формулировка
// повторена в двух версиях одного материала), отчёт ГУП «Кубаньгеология»
// 2016-2017 (72 дома в активной зоне сегодня), новый тендер на генплан
// марта 2025 (ООО «НИИ Прогрессивного градостроительства», СПб; утверждение
// не раньше лета 2026). Честно зафиксировано: журналистский материал — один
// и тот же текст, синдицированный на нескольких городских доменах одной
// медиасети (е1.ру/нгс.ру/93.ру и др.), а не независимые редакции — в
// отличие от РИА+REGNUM в Волне 73. Цитируется как один источник, не как
// перекрёстная проверка.

const CHECKED = '20 августа 2026 года';

const title = 'Кран для Апшеронского района: три категории площадок';
const description = 'Генплан Нефтегорского поселения делит площадки района на три инженерно-геологических категории — Нефтегорск официально в худшей из них.';
const h1 = 'Кран для Апшеронского района: сначала категория площадки, потом марка крана';
const crumbTitle = 'Кран для Апшеронского района';
const slug = 'kran-dlya-apsheronskogo-rayona';

const H2 = [
  'Три категории площадок — не формальность генплана',
  'Нефтегорск: 17 улиц в зоне, названной в документе поимённо',
  'Что это меняет в проекте: фундамент, глубина, балл сейсмики',
  'Живой процесс: генплан поселения переписывают прямо сейчас',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Значит ли это, что в Апшеронском районе кран вообще не поставить?',
    a: 'Нет. Документ по Нефтегорску прямо делит территорию на три категории, и большая часть площадок в районе попадает в первую или вторую — там нужны обычные для предгорья меры: инженерно-геологическое обследование на крип и оползни при выборе точки, усиленный фундамент, отвод дождевых вод. Третья категория, где меры становятся дорогостоящими и объёмными, — это конкретные, поимённо описанные в генплане участки, а не весь район целиком. Мы оцениваем не «район вообще», а конкретный адрес.',
  },
  {
    q: 'Как понять, к какой категории относится конкретный адрес в Апшеронском районе?',
    a: 'По отчёту инженерно-геологических изысканий именно этой площадки — для капитального объекта он обычно уже есть в составе проектной документации. Если адрес попадает в зону, описанную в генплане поселения (как перечисленные улицы Нефтегорска), мы закладываем в расчёт свайный фундамент и увеличенный балл сейсмики ещё на этапе заявки, не дожидаясь отдельного отчёта — и пересчитываем только если изыскания покажут более лёгкий вариант, а не наоборот.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Апшеронского района', item: `${SITE}/blog/kran-dlya-apsheronskogo-rayona/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-apsheronskogo-rayona/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-apsheronskogo-rayona/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Заявку на башенный кран в Апшеронском районе мы не считаем по прайсу «предгорье — доплата за сейсмику». Сначала смотрим, в какую из трёх инженерно-геологических категорий генплан поселения относит саму площадку: это не наша внутренняя оценка, а официальная классификация, под которой стоит подпись проектной организации и техотчёт государственного геологического предприятия. Самый жёсткий и при этом самый подробно документированный случай в районе — посёлок Нефтегорск, где генплан называет не абстрактную «зону риска», а конкретные улицы. Разбираем, что это значит на практике для проекта монтажа.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Материалы по обоснованию генерального плана Нефтегорского городского поселения делят территорию на три инженерно-геологических района по степени сложности освоения. Первый — площадки с благоприятными условиями, где всё равно требуется отдельное обследование на крип и оползни при выборе точки под здание, усиленный фундамент и отвод дождевых вод от него, а этажность ограничивают вплоть до двух этажей ради снижения нагрузки на основание. Второй — площадки, где застройка возможна, но требует специальных инженерных мероприятий: значительных объёмов земляных работ, подпорных стенок, водоотводных канав, дамб, забивки свай. Третий — площадки, застройка которых затруднительна и требует большого и дорогостоящего комплекса защитных мероприятий; часть из них документ прямо называет малопригодными или полностью непригодными для строительства.</p>
    <p>Классификация опирается не на визуальную оценку, а на технический отчёт по инженерно-геологическим изысканиям ГУП КК «Кубанская краевая научно-производственная компания минеральных ресурсов и геологии «Кубаньгеология», Азовское отделение, 2009 год. Тот же институт, что документировал оползневые склоны Горячего Ключа с 1983 года (см. статью «<a href="/blog/kran-dlya-goryachego-klyucha/" style="color:var(--accent)">Кран для Горячего Ключа</a>»), работал и здесь — это не совпадение подрядчика на двух разных страницах сайта, а реальная зона ответственности одной геологической службы по всему краю.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>В границах Нефтегорского поселения сильнее всего подвержена оползневым процессам территория самого посёлка Нефтегорск: они концентрируются в долинах рек Нефтянка, Голышка, Чекуха и их притоков. Более 17 улиц посёлка попадают в зону развития оползневых процессов разной степени активности — документ отдельно называет самые пострадавшие: Победы, Горького, Школьная, Гражданская, Физкультурная. Отдельная деталь из того же документа: площадь активных оползней в застроенной части посёлка в 4-5 раз выше, чем на менее освоенных соседних участках — то есть сама застройка (подрезка склонов, коммуникации, лесоразработки) ускоряет процесс, а не только природный рельеф.</p>
    <p>Это не абстракция на бумаге. 13-18 января 1978 года смещение грунта разрушило 42 дома (79 семей, 202 человека остались без крова), ещё 51 дом получил повреждения, пострадали 4 км дорог, линии электропередачи, газопровод и водопровод — после этого строительство в опасной зоне запретили, а часть пострадавших переселили в Апшеронск и Хадыженск. Обследование ГУП «Кубаньгеология» в 2016-2017 годах зафиксировало 72 дома, до сих пор находящихся в активной оползневой зоне сегодня — то есть режим ограничения действует не по инерции устаревшего документа, а подтверждён относительно недавней полевой съёмкой.</p>

    <h2 id={headings[2].id} style="margin:36px 0 18px">{headings[2].text}</h2>
    <p>Фоновая сейсмичность территории по СНиП II-7-81* (карта ОСР-97-А) — 8 баллов, как и на большей части края (подробнее — на странице «<a href="/seysmozony/8-ballov/" style="color:var(--accent)">Площадка 8 баллов</a>»). Но тот же генплан прямо оговаривает: «Балл сейсмичности на территориях, расположенных в зоне возможных оползневых подвижек и на территориях подтопления, должен быть увеличен» — со ссылкой на ТСН 22-302-2000 и СНиП II-7-81*, ту же пару норм, что применяется и на оползневых склонах Горячего Ключа. Категория грунтов по сейсмическим свойствам на площадке отнесена к I, II и III (высокой) категории сложности по Приложению Б СП 11-105-97 — формальное подтверждение того, что расчёт здесь не сводится к одной цифре из таблицы населённых пунктов.</p>
    <p>Практическая рекомендация документа для первого и второго инженерно-геологических районов — свайные фундаменты как наиболее рациональное решение, минимальная глубина заложения фундамента равна мощности почвенного слоя, но не менее нормативной глубины промерзания (0,8 м), с детальными инженерными изысканиями под каждый отдельный объект. Для башенного крана это означает более тяжёлую и более глубокую анкеровку, чем на стандартной равнинной площадке того же балла — расчёт разобран на этапе «<a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">Монтаж и анкеровка</a>», а откуда вообще берётся категория грунта под площадкой — на этапе «<a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">Изыскания и грунт</a>». Там, где площадка объективно нестабильна, а задача — короткий монтаж без многомесячной стройки, капитальный фундамент может быть избыточным риском: для таких случаев в парке есть <a href="/park/giraffe-smk-5-66/" style="color:var(--accent)">giraFFe SMK-5.66</a>, единственная модель, которой не нужен ни путь, ни фундамент.</p>

    <h2 id={headings[3].id} style="margin:36px 0 18px">{headings[3].text}</h2>
    <p>Расселение из оползневой зоны Нефтегорска — не завершённая история 1978 года, а процесс, идущий прямо сейчас. Жители, по открытым публикациям, ждут переселения с 2007 года; в 2018 году Минстрой РФ обозначил условие — федеральное финансирование возможно только после утверждения нового генплана поселения; попытка 2019-2024 годов (небольшая местная проектная организация) закончилась отправкой проекта на доработку из-за ошибок. В марте 2025 года район объявил новый тендер, исполнителем стало ООО «НИИ Прогрессивного градостроительства» (Санкт-Петербург); утверждение документа ожидают не раньше лета 2026 года. Честная оговорка: эти детали приводит один и тот же журналистский материал, синдицированный на нескольких городских доменах одной медиасети (е1.ру, нгс.ру, 93.ру и другие) — это не независимая перекрёстная проверка несколькими редакциями, а один источник, повторно опубликованный.</p>
    <p>При этом сам генплан уже сейчас закладывает конкретные цифры под будущее расселение: 16,1 га новой селитебной территории — для жителей, переселяемых из оползневой зоны в границах самого посёлка Нефтегорск (расчётный срок до 2030 года), и ещё 217 га резерва на территории соседней станицы Нефтяной — уже на период 2030-2045 годов, для прироста населения станицы и для тех, кого переселяют туда из оползневых зон Нефтегорска. Это означает, что новое капитальное строительство в поселении концентрируется не в самой оползневой зоне (там оно запрещено), а на площадках, которые тот же документ отнёс к более благоприятным категориям — именно туда, а не в зону риска, стоит адресовать вопрос о технике под будущую застройку.</p>

    <h2 id={headings[4].id} style="margin:36px 0 18px">{headings[4].text}</h2>
    <ul>
      <li>Апшеронский район официально разделён генпланом на три инженерно-геологических категории сложности освоения — от «нужен усиленный фундамент» до «малопригодно для строительства».</li>
      <li>Нефтегорск — самый документированный случай: 17+ улиц в зоне оползневых процессов, катастрофа 1978 года (42 дома разрушены), 72 дома в активной зоне по данным 2016-2017 годов.</li>
      <li>В оползневой зоне расчётный балл сейсмики поднимают выше фоновых восьми — та же норма ТСН 22-302-2000/СНиП II-7-81*, что и на склонах Горячего Ключа.</li>
      <li>Новое строительство переселения (16,1 га в посёлке, 217 га резерва у ст. Нефтяной) адресовано в более благоприятные категории площадок, а не в саму зону риска.</li>
    </ul>
    <p>Что стоит за самим баллом площадки и откуда его берут в целом по краю — в разделе «<a href="/seysmozony/" style="color:var(--accent)">Сейсмические зоны</a>»; похожий случай с официальной нормой повышения балла на оползневом склоне — в статье «<a href="/blog/kran-dlya-goryachego-klyucha/" style="color:var(--accent)">Кран для Горячего Ключа</a>».</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://nf.apsheronsk-oms.ru/general-nyy-plan.html', label: 'nf.apsheronsk-oms.ru — генплан Нефтегорского городского поселения Апшеронского района: обоснование, три инженерно-геологических района, улицы в оползневой зоне, нормы фундамента' },
      { href: 'https://www.e1.ru/text/world/2025/10/12/76069226/', label: 'Е1.ру (12.10.2025) — история посёлка Нефтегорск: катастрофа 1978 года, отчёт «Кубаньгеологии» 2016-2017, тендер на генплан 2025 года (материал синдицирован сетью городских порталов)' },
      { href: 'https://93.ru/text/incidents/2025/10/13/76067686/', label: '93.ру (13.10.2025) — продолжение: исполнитель тендера на генплан, ожидаемая дата утверждения, обращение жителей к президенту' },
    ]} />
</BlogArticleLayout>
