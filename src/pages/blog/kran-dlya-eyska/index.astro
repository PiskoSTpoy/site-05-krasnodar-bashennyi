---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 76. Одиннадцатая статья блога — первая про азовский, а не черноморский
// берег края. До этой волны блог покрывал Черное море (Анапа, Новороссийск,
// Сочи), исторический Краснодар и предгорную ось (Армавир, Горячий Ключ,
// Апшеронский и Мостовской районы) — Азовское побережье не встречалось ни разу.
// Ейск выбран как контраст: тот же региональный каркас (закон о тишине,
// паспортный предел ветра), но другая экономика (портовый элеватор и
// терминалы, а не отель или ферма) и другой ветровой режим (устойчивая
// «кайтовая» роза ветров Азовского моря, а не эпизодическая новороссийская
// бора).
//
// В этой волне сетевой доступ сессии не позволил напрямую открыть
// docs.cntd.ru/base.garant.ru/сайты администраций (egress заблокирован для
// всех внешних доменов, включая WebFetch и curl) — только WebSearch. Прямая
// проверка через WebSearch строки Ейска в Приложении Б ТСН 22-302-2000 дала
// два противоречащих друг другу ответа подряд (один «нашёл» баллы 7/8/9,
// второй прямо сказал, что не нашёл) — то есть первый ответ похож на
// достройку модели по шаблону соседних прибрежных городов, а не на цитату
// строки таблицы. Поэтому в статье сознательно нет ни одной цифры сейсмики
// для Ейска: только факты, подтверждённые независимо несколькими источниками
// в выдаче (реестры юрлиц для АО «Ейский портовый элеватор», отраслевое
// издание «Морские вести России» для роста мощности порта, Циан для текущей
// жилой стройки, три независимых источника про ветровую репутацию
// Ейского полуострова).

const CHECKED = '2 сентября 2026 года';

const title = 'Кран для Ейска: порт на Азовском море и ветер, который знают кайтсёрферы';
const description = 'Ейск — первый разбор блога про азовский, а не черноморский берег края: портовый элеватор, растущие терминалы и устойчивый ветер, который для крана значит не меньше, чем для кайтсёрфера.';
const h1 = 'Кран для Ейска: порт на Азовском море и ветер, который знают кайтсёрферы';
const crumbTitle = 'Кран для Ейска';
const slug = 'kran-dlya-eyska';

const H2 = [
  'Ейск — порт на Азовском, а не на Чёрном море',
  'Портовый элеватор и терминалы: где чаще всего нужен кран',
  'Азовский ветер: кайт-репутация и паспортный предел крана',
  'Курортный сезон и закон о тишине',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'В Ейске тот же норматив по ветру, что и в Новороссийске?',
    a: 'Норматив один и тот же на весь край: работы прекращают при скорости ветра, превышающей предельную, указанную в паспорте конкретной машины (п. 132 ФНП №461) — это разобрано в статье «Инженерные изыскания перед монтажом крана». Разница не в норме, а в характере ветра: новороссийская бора — эпизодический и очень сильный порывистый ветер, азовский ветер в районе Ейска — более устойчивый и предсказуемый по направлению, что и сделало Ейский полуостров местом притяжения для кайтсёрферов. Для графика монтажа это означает не другой предел, а другую логику планирования: не редкий пиковый шторм, а частые, но более ровные ветреные дни.',
  },
  {
    q: 'Действует ли в Ейске закон о тишине так же строго, как в Сочи или Анапе?',
    a: 'Да, закон края №608-КЗ (в редакции закона №5423-КЗ, действующей с 1 марта 2026 года) — краевой, а не местный, и применяется в Ейске так же, как в любом другом населённом пункте края: часы шумных работ и штрафы по статье 3.3 одинаковы. Курортный статус Ейска добавляет не другую норму, а более высокую вероятность жалобы в высокий пляжный сезон — та же логика, что и на Черноморском побережье, разобрана в статье «Сейсмика и закон о тишине на Кубани».',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Ейска', item: `${SITE}/blog/kran-dlya-eyska/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-eyska/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-eyska/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>До этой статьи блог писал про Черноморское побережье края (Анапа, Новороссийск, Сочи), про исторический Краснодар и про предгорную ось от Армавира до Мостовского района — и ни разу про Азовское море. Ейск закрывает этот пробел, и не просто как «ещё один город на карте»: экономика площадки здесь портовая, а не туристическая или сельскохозяйственная, а ветер — не эпизодический шторм, а устойчивый режим, из-за которого Ейский полуостров стал одним из главных мест для кайтсёрфинга в России. Для монтажа крана это два разных практических вопроса, и оба стоит разобрать отдельно от уже написанного про Новороссийск.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Ейск стоит на Ейской косе, у входа в Таганрогский залив Азовского моря — это другой берег края, чем Чёрное море, и другая логистика: закрытое мелководное море с иным характером волнения и ветра, чем открытое побережье у Новороссийска или Сочи. Город исторически сложился вокруг порта, а не вокруг курортной инфраструктуры, хотя пляжный туризм в Ейске тоже есть. Именно портовая функция — то, что делает площадку интересной для нашей темы: краны здесь чаще нужны не отелю, а грузовому терминалу или элеватору.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Ключевое предприятие города — АО «Ейский портовый элеватор», зарегистрированное юридическое лицо с многолетней историей перевалки зерна через Азовский бассейн; статус и реквизиты компании подтверждаются независимо в нескольких открытых реестрах. Рядом с элеватором работает сам морской порт: по данным отраслевого издания «Морские вести России», за последние годы его перевалочные мощности выросли примерно на миллион тонн в год за счёт новых терминалов для жидких пищевых грузов — в частности, комплексов ООО «Директория – Новый морской порт» и ООО «Ейск-Порт-Виста». Это тот тип объекта, где кран нужен не на месяц под один жилой корпус, а периодически — под расширение эстакад, резервуарных парков и складской инфраструктуры.</p>
    <p>Жилищное строительство в самом городе для сравнения точечное: по данным профильных порталов недвижимости, одновременно в Ейске обычно ведётся не больше одного-двух проектов многоквартирных жилых комплексов — совсем не тот объём, что в Краснодаре или Новороссийске. Поэтому для этой площадки мы в первую очередь говорим не «жильё или курорт», а «промышленный и портовый заказчик», и это меняет и тип техники, и график работ.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Ейский полуостров по ветровой статистике — один из наиболее известных в стране районов для кайтсёрфинга: несколько независимых источников сходятся в том, что устойчивость и предсказуемость направления здешнего ветра выделяют его среди других побережий России, а комфортным для катания на кайте считается диапазон примерно 6-13 м/с. Это не инженерная характеристика, а спортивная, но для площадки под кран она значима косвенно: она говорит о том, что ветреные дни в Ейске — не редкое исключение, а фоновый режим, с которым приходится считаться в графике почти постоянно, а не время от времени.</p>
    <p>Норматив здесь тот же, что и на любой другой площадке края: работы прекращают при скорости ветра, превышающей предел, указанный в паспорте конкретной машины (п. 132 ФНП №461, подробнее — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/" style="color:var(--accent)">«Инженерные изыскания перед монтажом крана»</a>). Но логика планирования другая, чем в Новороссийске. Там мы закладываем резерв на редкий, но очень сильный порывистый эпизод — бору. В Ейске резерв закладывается иначе: не на один пиковый день, а на устойчиво более высокую долю ветреных смен в принципе, из-за которой рабочее окно у стрелового крана на площадке заметно чаще требует внимания к текущим показаниям анемометра, чем на защищённой от моря территории.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Закон Краснодарского края от 23 июля 2003 года №608-КЗ (в редакции закона №5423-КЗ, действующей с 1 марта 2026 года) — региональный, а не местный: он одинаково регулирует часы шумных работ в Ейске, Краснодаре и Сочи. Курортный статус Ейска не меняет саму норму, но повышает вероятность её практического применения: пляжная зона города летом плотно заселена отдыхающими, и нарушение времени работ там с высокой вероятностью обернётся жалобой, а значит — проверкой и штрафом по статье 3.3. Полный разбор часов и сумм штрафов — в статье <a href="/blog/seysmika-i-zakon-o-tishine/" style="color:var(--accent)">«Сейсмика и закон о тишине на Кубани»</a>; здесь достаточно сказать, что для портового и элеваторного объекта, стоящего дальше от пляжной линии, риск жалобы объективно ниже, чем для стройки в двух шагах от набережной, но закон при этом действует ровно тот же.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <ul>
      <li>Ейск — первый разбор блога про Азовское, а не Черноморское побережье края: другая экономика площадки и другой характер ветра.</li>
      <li>Основной заказчик крана здесь — портовая и элеваторная инфраструктура (АО «Ейский портовый элеватор», терминалы порта), а не отель или жилой комплекс.</li>
      <li>Ветер Ейского полуострова устойчивый и предсказуемый, а не эпизодический, как новороссийская бора — тот же паспортный предел (п. 132 ФНП №461), но иная логика резерва в графике.</li>
      <li>Закон о тишине №608-КЗ (ред. №5423-КЗ) действует в Ейске так же, как на остальном побережье края.</li>
      <li>Сейсмический расчёт для этой площадки в статье намеренно не приведён: доступные в этой волне источники не дали надёжного подтверждения конкретного балла для Ейска.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.list-org.com/company/9964', label: 'list-org.com — АО «Ейский портовый элеватор», регистрационные данные' },
      { href: 'https://zachestnyibiznes.ru/company/ul/1022301118223_2331004850_AO-EYSKIY-PORTOVYY-ELEVATOR', label: 'zachestnyibiznes.ru — АО «Ейский портовый элеватор», ИНН 2331004850' },
      { href: 'https://morvesti.ru/analitika/1688/94140/', label: 'morvesti.ru — «Морские вести России»: рост мощности Ейского порта за счёт новых терминалов' },
      { href: 'https://krasnodar.cian.ru/novostroyki-2027-krasnodarskiy-kray-eysk/', label: 'cian.ru — новостройки Ейска, текущий объём жилой стройки' },
      { href: 'https://kitemart.ru/index.php?news_id=10&route=information%2Fnews%2Fnews', label: 'kitemart.ru — комфортный диапазон ветра для кайтсёрфинга' },
      { href: 'https://geobrox.com/blog/23', label: 'geobrox.com — Ейский полуостров среди лучших мест для кайтсёрфинга в России' },
    ]} />
</BlogArticleLayout>
