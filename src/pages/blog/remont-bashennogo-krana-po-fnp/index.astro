---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 116. Девяносто вторая статья блога — угол (a) информационный / how-to.
// Ремонт башенного крана по ФНП № 461: кто имеет право, какие виды, как оформляется.
//
// Фактура — сырой текст приказа Ростехнадзора от 26.11.2020 № 461
// (legalacts.ru, curl, проверено 19.10.2026): п. 10 (ремонт в эксплуатации —
// специализированные организации), п. 23 (эксплуатирующая организация с собственным
// ремонтом — подразделение по требованиям п. 10 и далее), пп. 63–65 (оборудование и
// оснастка по проекту ремонта), п. 79–80 (качество ремонтных сварных соединений,
// контроль всего соединения, повтор шва на одном участке более двух раз запрещён),
// пп. 81–83 (плановые ремонты по наработке или интервалам из руководства; текущие и
// капитальный; полная разборка, дефектация с неразрушающим контролем, обязательная
// замена по наработке, срок продления — заключение экспертизы), пп. 85–88 (ремонт
// ограничителей, указателей, регистраторов; настройка и опломбирование; запись в
// паспорте при потере информации), п. 93–97 (ремонтные чертежи, ОТК, протокол или акт
// приёмки, акт сдачи-приёмки рельсового пути, запись в паспорте и копии сертификатов),
// п. 154 (устранение неисправностей, остановка эксплуатации).
// Числовых сроков, расценок и межремонтных интервалов в ФНП нет — не названы.
// Памятка заказчику аренды — рекомендация КРАН-КУБАНЬ, не норма.

const CHECKED = '19 октября 2026 года';
const PUBLISHED = '2026-10-19';

const title = 'Ремонт башенного крана по ФНП: пункты 10, 83, 96 и 97';
const description = 'Кто вправе ремонтировать башенный кран, чем плановый ремонт отличается от капитального и какие документы нужны после: пункты 10, 81–97 и 154 ФНП № 461.';
const h1 = 'Кто вправе ремонтировать башенный кран и как оформить ремонт по ФНП';
const crumbTitle = 'Ремонт башенного крана по ФНП';
const slug = 'remont-bashennogo-krana-po-fnp';

const H2 = [
  'Кто ремонтирует кран: пункты 10 и 23',
  'Плановый ремонт: наработка и пункты 81–82',
  'Капитальный ремонт: пункт 83 требует полной разборки',
  'Сварка при ремонте: пункты 79–80 и предел в два шва',
  'Приборы безопасности: ремонт по пунктам 85–88',
  'Приёмка из ремонта: пункты 96 и 97',
  'Пункт 154: кран, который не удаётся починить',
  'Что проверить заказчику при аренде крана',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Кто имеет право ремонтировать башенный кран?',
    a: 'Согласно пункту 10 ФНП № 461, ремонт крана в процессе эксплуатации ведут специализированные организации. Эксплуатирующая организация может ремонтировать собственные краны сама, но только если в ней есть подразделение с теми же требованиями (п. 23). Для арендатора это означает: ремонт — не работа сменного персонала площадки.',
  },
  {
    q: 'Как часто нужен плановый ремонт башенного крана?',
    a: 'Интервал ФНП не называет. Пункт 81 привязывает плановый ремонт к наработке в машино-часах или циклах либо к срокам, указанным в руководстве по эксплуатации конкретного крана. Числа берут из документации производителя модели, поэтому КРАН-КУБАНЬ не приводит общий срок для всего парка.',
  },
  {
    q: 'Что делают при капитальном ремонте крана?',
    a: 'По пункту 83 ФНП выполняют полную разборку всех ремонтопригодных механизмов и соединений, дефектацию с обязательным неразрушающим контролем одним из методов, затем восстановление или замену изношенных элементов. Срок продления эксплуатации после капитально-восстановительного ремонта задаёт заключение экспертизы промышленной безопасности.',
  },
  {
    q: 'Какие документы оформляют после ремонта крана?',
    a: 'Протокол или акт приёмки из ремонта, утверждённый эксплуатирующей организацией (п. 96). Для рельсового крана — ещё акт сдачи-приёмки рельсового пути. Специализированная организация делает запись о работе в паспорте крана и передаёт копии сертификатов на материалы и запасные части (п. 97).',
  },
  {
    q: 'Сколько раз можно переваривать один и тот же шов при ремонте?',
    a: 'Повторение ремонтных сварных швов на одном и том же участке более двух раз запрещено — пункт 80 ФНП. Если неразрушающий контроль нашёл недопустимые дефекты, проверяют всё соединение целиком, а исправленные участки подтверждают повторным контролем.',
  },
  {
    q: 'Можно ли эксплуатировать кран, который не удаётся привести в порядок?',
    a: 'Нет. Пункт 154 ФНП требует остановить эксплуатацию, если кран нельзя привести в соответствие требованиям промышленной безопасности технологического процесса. До этого эксплуатирующая организация обязана своевременно устранять выявленные неисправности, дефекты и повреждения.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Эксплуатация"
  published={PUBLISHED}
>
    <p slot="intro">Пункт 10 ФНП № 461 отдаёт ремонт башенного крана в эксплуатации специализированным организациям, а пункты 96 и 97 требуют после него акт приёмки и запись в паспорте. Для заказчика аренды КРАН-КУБАНЬ это три проверки: кто ремонтировал, какой был объём и какие документы остались. Ниже — все виды ремонта по тексту приказа и памятка по приёмке.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 10 ФНП № 461 называет ремонт среди видов деятельности специализированных организаций: они ведут монтаж, демонтаж, наладку, ремонт, реконструкцию и модернизацию крана, его приборов безопасности и рельсового пути. Для башенных кранов КРАН-КУБАНЬ — КБ-408.21, КБ-674А, Potain MDT 219 J10 — это значит, что сменный машинист и стропальщики на площадке ремонт не выполняют.</p>
    <p>Пункт 23 оставляет эксплуатирующей организации право ремонтировать собственные краны, но с условием: в ней должно быть подразделение, отвечающее требованиям пункта 10 и последующих. Выбор оборудования для ремонта регулируют пункты 63–65: оснастка и инструмент подбираются по проекту ремонта и по руководству по эксплуатации конкретного крана, а не «что нашлось в мастерской».</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Пункт 81 ФНП привязывает плановые ремонты к наработке, а не к календарю: после определённого числа машино-часов или циклов либо через интервалы, указанные в руководстве по эксплуатации. Пункт 82 добавляет, что краны своевременно проходят текущие ремонты и капитальный, чтобы оставаться в работоспособном состоянии. Общего числа ФНП не называет, и КРАН-КУБАНЬ его не придумывает.</p>
    <p>Важная деталь пункта 83: если руководство по эксплуатации предписывает заменить элемент или сборочную единицу после достижения наработки, замена обязательна, даже когда повреждений не видно. Для КБ-674А, который работает на высоте до 116–120 м приставным способом, этот пункт значим: узел, отработавший срок, меняют по документу, а не по внешнему виду.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Капитальный и капитально-восстановительный ремонт по пункту 83 начинается с полной разборки всех ремонтопригодных механизмов и соединений по руководству по эксплуатации. Затем идёт дефектация с обязательным применением одного из методов неразрушающего контроля, после чего изношенные элементы восстанавливают или заменяют. Такой порядок КРАН-КУБАНЬ считает главным признаком настоящего капитального ремонта.</p>
    <p>Если эксплуатационная документация не задаёт объём, специализированная организация работает по проекту на капитальный ремонт: в нём указано, какие части, компоненты и оборудование ремонтируют или заменяют. При восстановительной сварке изношенных изделий требования к качеству и браковочные признаки тоже прописывают в этом проекте. Срок продления службы крана после такого ремонта КРАН-КУБАНЬ берёт только из заключения экспертизы промышленной безопасности.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пункт 79 ФНП признаёт качество ремонтного сварного соединения неудовлетворительным, если при любом виде контроля найдены внутренние или наружные дефекты за пределами норм эксплуатационной документации или проекта ремонта. Для мачты КБ-408.21 или стрелы Potain MDT 219 J10 в КРАН-КУБАНЬ это означает контроль по нормам проекта, а не «на глаз».</p>
    <p>Пункт 80 задаёт два правила. Первое: при недопустимых дефектах неразрушающему контролю подвергают всё соединение, а исправленные участки подтверждают повторным контролем. Второе: повторять ремонтные швы на одном и том же участке более двух раз запрещено. Практический вывод КРАН-КУБАНЬ: если участок уже дважды ремонтировали, третий раз его не варят, а меняют элемент.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Ремонт ограничителей, указателей и регистраторов по пункту 85 ФНП выполняют изготовители крана (если у них есть квалифицированный персонал), изготовители приборов, их сервисные центры и специализированные организации. Объём и последовательность берут из документации прибора; если указаний нет, ремонтную документацию разрабатывает специализированная организация. Для прибора безопасности КБ-408.21 четвёртого поколения КРАН-КУБАНЬ хранит такие записи вместе с паспортом.</p>
    <p>После ремонта прибора по пункту 87 проводят настройку, проверку работоспособности и опломбирование. Пункт 88 требует, чтобы ремонт регистратора не приводил к потере информации долговременного хранения, а при невозможности восстановления данных в паспорт вносят запись. В КРАН-КУБАНЬ разрешение на пуск крана после такого ремонта даёт инженерно-технический работник, ответственный за содержание крана в работоспособном состоянии. Правила приборов подробнее — в статье <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Пункт 96 ФНП требует подтвердить качество ремонта протоколом или актом приёмки из ремонта, утверждённым эксплуатирующей организацией. Для рельсового крана — КБ-408.21, Potain MDT 219 J10 на пути — отдельно нужен акт сдачи-приёмки отремонтированного рельсового пути. Пункт 95 поручает контроль соблюдения проекта, чертежей и технологии службе технического контроля исполнителя, и КРАН-КУБАНЬ запрашивает её подпись.</p>
    <p>Пункт 97 добавляет итоговый документ, который КРАН-КУБАНЬ прикладывает к паспорту: по завершении ремонта специализированная организация делает в паспорте крана запись о проведённой работе и передаёт копии сертификатов на применённые материалы, замененные и отремонтированные запчасти, узлы и агрегаты. Для КБ-674А и других моделей парка пункт 94 требует, чтобы на ремонтных чертежах металлоконструкций были видны повреждённые участки, материалы замены, способы правки и нормы контроля швов.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Документ</th><th>Кто оформляет</th><th>Пункт ФНП № 461</th></tr></thead>
      <tbody>
        <tr><td>Ремонтные чертежи металлоконструкции</td><td>Исполнитель ремонта</td><td>94</td></tr>
        <tr><td>Протокол или акт приёмки из ремонта</td><td>Утверждает эксплуатирующая организация</td><td>96</td></tr>
        <tr><td>Акт сдачи-приёмки рельсового пути</td><td>Для кранов на рельсах</td><td>96</td></tr>
        <tr><td>Запись в паспорте и копии сертификатов</td><td>Специализированная организация</td><td>97</td></tr>
        <tr><td>Заключение экспертизы (продление срока)</td><td>Экспертная организация</td><td>83</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Пункт 154 ФНП состоит из двух частей. Обслуживание и ремонт крана, а также ремонт и рихтовка рельсовых путей выполняют с учётом руководства по эксплуатации и самого ФНП; эксплуатирующая организация обязана своевременно устранять выявленные неисправности, дефекты и повреждения. Для КРАН-КУБАНЬ «своевременно» значит до следующей смены, а не к концу месяца.</p>
    <p>Вторая часть пункта 154 жёсткая: если кран нельзя привести в соответствие требованиям промышленной безопасности технологического процесса, его эксплуатация должна быть остановлена. Это правило закрывает вопрос «дотянем до конца стройки»: на КБ-674А, Potain MDT 219 J10 или giraFFe SMK-5.66 неремонтопригодный дефект означает простой, а не работу с риском. Связанные проверки — в статьях <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Ежесменный осмотр»</a> и <a href="/blog/tekhnicheskoe-osvidetelstvovanie-bashennogo-krana/">«Техническое освидетельствование»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Памятка ниже — рекомендация инженерной службы КРАН-КУБАНЬ, а не норма ФНП. Арендатор крана не ведёт ремонт сам, но вправе знать, что с краном делали до отгрузки на объект. Запрос к арендодателю занимает пять строк и не требует специальных знаний.</p>
    <ul>
      <li>Дата и вид последнего ремонта по записи в паспорте крана (п. 97).</li>
      <li>Акт или протокол приёмки из ремонта, утверждённый эксплуатирующей организацией (п. 96).</li>
      <li>Для рельсового КБ-408.21 или Potain MDT 219 J10 — акт сдачи-приёмки пути.</li>
      <li>Отметка о проверке и опломбировании прибора безопасности после его ремонта (п. 87).</li>
      <li>Заключение экспертизы, если кран проходил капитально-восстановительный ремонт (п. 83).</li>
    </ul>
    <p>КРАН-КУБАНЬ передаёт заказчику копии этих записей по запросу вместе с паспортными характеристиками модели из <a href="/park/">парка техники</a>. Сроки и стоимость ремонтов ФНП не регулирует, поэтому в статье цен нет; про то, как условия аренды описаны в смете, — в статье <a href="/blog/smeta-arendy-bashennogo-krana/">«Смета аренды башенного крана»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461: ФНП «Правила безопасности опасных производственных объектов, на которых используются подъёмные сооружения» (пп. 10, 23, 63–65, 79–97, 154)' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/tekhnicheskoe-osvidetelstvovanie-bashennogo-krana/', label: 'kran-kuban.ru — техническое освидетельствование башенного крана' },
    ]} />
</BlogArticleLayout>
