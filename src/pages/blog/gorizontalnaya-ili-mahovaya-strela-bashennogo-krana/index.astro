---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 111. Семьдесят восьмая статья блога — угол (b) коммерческий/сравнительный.
// Все десять пар пяти моделей парка уже разобраны, поэтому здесь сравнение не
// «модель против модели», а ТИП СТРЕЛЫ против типа: четыре модели с горизонтальной
// стрелой и одна (Potain MCH 175) с маховой. Угол выбора под площадку, а не под
// паспортный максимум.
//
// Фактура — только src/data/parkModels.ts (реестр парка) и ФНП № 461:
// - Potain MDT 219 J10: 10 т макс., 1,9 т на 65 м, вылет 65 м, крюк до 70,4 м;
// - КБ-408.21: 10 т макс., вылет 40 м, крюк 54,0–72,7 м; груз на вылете в реестре
//   не указан — по моменту на конце стрелы не сравнивается;
// - КБ-674А: 12,5 т макс., 5,6 т на 50,5 м, вылет 50,5 м, крюк до 60 м свободно /
//   116–120 м приставным;
// - giraFFe SMK-5.66: 5 т макс., 1,05 т на 43 м, вылет 2,8–43 м, крюк до 27 м
//   (горизонтальная стрела) / 41,7 м (наклон 20°);
// - Potain MCH 175: 10 т макс., 1,5 т на 55 м, вылет до 55 м, сокращается
//   наклоном стрелы, крюк до 58,5 м; минимальный вылет в реестре не указан.
// - произведения «груз × вылет» на конце стрелы — арифметика над паспортными
//   значениями реестра (123,5; 82,5; 282,8; 45,2 т·м), в статье помечены как
//   расчётные, не паспортные.
// - ФНП № 461 (legalacts.ru, ред. 16.04.2026, проверено 13.10.2026), п. 160:
//   разность уровней балочных (горизонтальных) стрел ≥ 1 м по вертикали;
//   «условия совместной безопасной работы башенных кранов с подъёмными стрелами
//   должны быть обязательно приведены в ППР».
// Цен, сроков монтажа MCH 175 и минимального вылета в реестре нет — в тексте сказано.

const CHECKED = '13 октября 2026 года';
const PUBLISHED = '2026-10-13';

const title = 'Маховая или горизонтальная стрела крана: что выбрать';
const description = 'Potain MCH 175 сокращает вылет наклоном стрелы, четыре других крана парка держат горизонтальную. Сравнение по паспорту и правило ФНП № 461 по ППР.';
const h1 = 'Маховая или горизонтальная стрела башенного крана: что выбрать под вашу площадку';
const crumbTitle = 'Маховая или горизонтальная стрела';
const slug = 'gorizontalnaya-ili-mahovaya-strela-bashennogo-krana';

const H2 = [
  'Чем маховая стрела отличается от горизонтальной',
  'Пять моделей парка по типу стрелы и паспорту',
  'Когда выигрывает маховая стрела: тесная площадка',
  'Когда нужна горизонтальная стрела: вылет и высота',
  'Что ФНП № 461 требует от ППР при подъёмных стрелах',
  'Три вопроса до выбора типа стрелы',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем маховая стрела башенного крана отличается от горизонтальной?',
    a: 'Маховая (луффинговая) стрела наклоняется и сокращает рабочий радиус почти до мачты, а горизонтальная работает кругом радиусом до максимального вылета. В парке КРАН-КУБАНЬ маховая стрела только у Potain MCH 175 — до 55 м вылета и 58,5 м по крюку.',
  },
  {
    q: 'Какой кран лучше для тесной площадки между зданиями?',
    a: 'Для узкого участка с соседним корпусом подходит Potain MCH 175: наклон стрелы сокращает радиус, и стрела не заходит на чужой участок. Если высота объекта не выше 41,7 м, КРАН-КУБАНЬ рассматривает и giraFFe SMK-5.66, которому нужен только опорный контур 4×4 м.',
  },
  {
    q: 'У какого крана парка самый большой вылет?',
    a: 'У Potain MDT 219 J10 — 65 м, на этом вылете он поднимает 1,9 т. Следом идут Potain MCH 175 с 55 м и 1,5 т, КБ-674А с 50,5 м и 5,6 т, giraFFe SMK-5.66 с 43 м и 1,05 т. Для КБ-408.21 вылет — 40 м, груз на вылете в реестре парка не указан.',
  },
  {
    q: 'Нужен ли особый проект, если на площадке кран с маховой стрелой?',
    a: 'Да, если на площадке несколько башенных кранов. Пункт 160 ФНП № 461 требует обязательно привести в проекте производства работ условия совместной безопасной работы кранов с подъёмными стрелами. КРАН-КУБАНЬ готовит этот раздел для площадки по фактическому расположению кранов.',
  },
  {
    q: 'Можно ли узнать минимальный вылет Potain MCH 175?',
    a: 'В реестре парка КРАН-КУБАНЬ минимальный вылет MCH 175 не указан — только «сокращается наклоном стрелы вплоть до почти вертикального положения». Точное значение берут из паспорта и руководства по эксплуатации конкретной машины, а не из общей таблицы.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Выбор техники"
  published={PUBLISHED}
>
    <p slot="intro">Из пяти моделей парка КРАН-КУБАНЬ одна — Potain MCH 175 — имеет маховую стрелу, которая наклоном сокращает вылет с 55 м почти до мачты. Остальные четыре работают горизонтальной стрелой и покрывают круг до максимального вылета: 40, 43, 50,5 или 65 м. Тип стрелы выбирают по площадке и соседям, а не по паспортной грузоподъёмности.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Горизонтальная стрела постоянного наклона оставляет рабочую зону кругом, радиус которого равен максимальному вылету модели. Potain MDT 219 J10 описывает круг радиусом 65 м, КБ-408.21 — 40 м, КБ-674А — 50,5 м. Если в этот круг попадает соседнее здание, линия электропередачи или чужой участок, вопрос решают ограничением зоны или выбором другого крана.</p>
    <p>Маховая стрела меняет геометрию, а не размер: наклон сокращает рабочий радиус вплоть до почти вертикального положения у мачты. Potain MCH 175 за счёт этого проходит рядом с соседней стеной там, где горизонтальная стрела задела бы её. Цена такого решения — зависимость нагрузки от угла: чем круче стрела, тем иначе меняется груз на крюке, и значения берут из паспорта.</p>
    <p>Отдельный случай — giraFFe SMK-5.66: стрела у него горизонтальная, но для высоты её можно наклонить на 20° и получить 41,7 м вместо 27 м. Маховой схемой в полном смысле наклон у giraFFe SMK-5.66 не является: вылет сокращается, а смысл наклона — набрать высоту крюка у быстромонтируемого крана без фундамента.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Таблица собрана из реестра парка КРАН-КУБАНЬ, а последний столбец — арифметика над паспортными значениями: груз на максимальном вылете, умноженный на вылет. Это расчётное произведение, а не паспортный грузовой момент, и сравнивать его с документом изготовителя нельзя.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Стрела</th><th>Вылет</th><th>Груз на вылете</th><th>Крюк, м</th><th>Груз × вылет (расчёт)</th></tr></thead>
      <tbody>
        <tr><td>Potain MDT 219 J10</td><td>горизонтальная, без оголовка</td><td>65 м</td><td>1,9 т</td><td>до 70,4</td><td>123,5 т·м</td></tr>
        <tr><td>КБ-408.21</td><td>горизонтальная, с оголовком</td><td>40 м</td><td>в реестре не указан</td><td>54,0–72,7</td><td>—</td></tr>
        <tr><td>КБ-674А</td><td>горизонтальная, приставной</td><td>50,5 м</td><td>5,6 т</td><td>до 60 / 116–120 приставным</td><td>282,8 т·м</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>горизонтальная, наклон 20°</td><td>2,8–43 м</td><td>1,05 т</td><td>до 27 / 41,7 при наклоне</td><td>45,2 т·м</td></tr>
        <tr><td>Potain MCH 175</td><td>маховая</td><td>до 55 м</td><td>1,5 т</td><td>до 58,5</td><td>82,5 т·м</td></tr>
      </tbody>
    </table></div>
    <p>Из таблицы видно, что маховая стрела не даёт ни самого дальнего вылета, ни самой высокой точки: 65 м у MDT и 116–120 м у КБ-674А больше. Выигрыш MCH 175 — гибкость рабочей зоны. В КРАН-КУБАНЬ эту модель предлагают там, где важна граница площадки, а не рекорд по цифре.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Маховая стрела Potain MCH 175 нужна, когда площадка зажата: соседнее здание, жилой дом через проезд или линия электропередачи рядом. Горизонтальная стрела того же вылета вынуждает договариваться с соседом о проходе над его территорией, а наклон стрелы эту необходимость снимает без смены модели. Как считают зазоры до проводов, разобрано в статье <a href="/blog/bashennyi-kran-ryadom-s-lep/">«Башенный кран рядом с ЛЭП»</a>.</p>
    <p>Вторая причина — плотная городская застройка, где кран стоит вплотную к границам участка. В центре Краснодара, Сочи или Новороссийска площадка редко бывает прямоугольником с запасом, и рабочий круг приходится «обрезать» на плане. Что даёт опорный контур и какой кран не требует рельсов, показано в статье <a href="/blog/kb-674a-ili-mch-175/">«КБ-674А или Potain MCH 175»</a>.</p>
    <p>Ограничение у маховой схемы то же, что у остальных моделей с основанием: MCH 175 ставят на рельсовый путь или монолитный фундамент. Для объекта, где нет места ни под путь, ни под фундамент, остаётся giraFFe SMK-5.66 с контуром 4×4 м, но с вылетом до 43 м и высотой до 41,7 м.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Горизонтальная стрела выигрывает, когда нужен максимальный вылет и круговая зона без наклонов. Potain MDT 219 J10 держит 1,9 т на 65 м и поднимает крюк до 70,4 м, поэтому его выбирают для протяжённых объектов, где кран стоит в стороне от здания. Топлесс-конструкция без оголовка позволяет поставить рядом ещё один кран, не задевая его.</p>
    <p>Если высота объекта выше 70 м, горизонтальная схема идёт вместе с приставным способом: КБ-674А набирает 116–120 м, опираясь на здание, а стрела остаётся постоянной длины. КБ-408.21 с вылетом 40 м и крюком до 72,7 м подходит для рельсового хода вдоль длинного фасада. Сравнение этих двух схем — в статье <a href="/blog/kb-408-21-ili-kb-674a/">«КБ-408.21 или КБ-674А»</a>.</p>
    <p>Четыре из пяти моделей парка КРАН-КУБАНЬ — горизонтальные, и у каждой рабочая зона записана одним числом: максимальным вылетом. Для типового цикла подач — панели, арматура, бетон в бадье — выбор поэтому начинают с горизонтальной схемы и переходят к Potain MCH 175 только тогда, когда плану площадки не хватает свободного круга.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Когда на площадке два крана и один из них с подъёмной стрелой, пункт 160 ФНП № 461 требует обязательно записать условия совместной работы в проекте производства работ. Для горизонтальных стрел и противовесных консолей норма даёт число: разность уровней, включая канаты подвески и грузовые канаты, — не менее 1 м по вертикали. Для подъёмных стрел числа нет — условия определяет ППР.</p>
    <p>Это значит, что для маховой схемы КРАН-КУБАНЬ готовит раздел ППР по фактическому положению кранов на плане, а не по общему правилу. Стоянка в нерабочее время идёт по тому же пункту: расстояние между кранами или их частями по горизонтали — не менее 2 м, по вертикали — не менее 1 м, а кран установлен на все противоугонные захваты. Правило для двух кранов подробно разобрано в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Выбор между схемами сводится к трём вопросам, на которые КРАН-КУБАНЬ просит ответить до расчёта. Ответы берутся из плана площадки и проекта, а не из каталога.</p>
    <ol>
      <li>Попадают ли в рабочий круг чужие здания, линия электропередачи или соседний кран? Если да — рассматривают Potain MCH 175.</li>
      <li>Нужен ли вылет больше 55 м? Тогда только Potain MDT 219 J10, у других моделей парка вылет меньше.</li>
      <li>Есть ли место под путь или фундамент? Если нет, остаётся giraFFe SMK-5.66 с ограничением высоты 41,7 м.</li>
    </ol>
    <p>Цены, сроки монтажа MCH 175 и минимальный вылет в реестре парка не указаны, поэтому в расчёте их запрашивают у инженерной службы. Адрес и план площадки можно прислать через <a href="/#order">форму на главной</a>; общий порядок подбора по высоте и вылету — в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: паспортные характеристики пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора № 461 (ФНП), пункт 160 о совместной работе башенных кранов' },
      { href: 'https://kran-kuban.ru/park/potain-mch-175/', label: 'kran-kuban.ru — карточка Potain MCH 175' },
    ]} />
</BlogArticleLayout>
