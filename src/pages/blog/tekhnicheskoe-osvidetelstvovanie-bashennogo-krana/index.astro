---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 109. Семьдесят первая статья блога — угол (a) информационный / how-to.
// Техническое освидетельствование башенного крана: сроки, внеочередные случаи,
// кто проводит, что проверяют и чем испытывают.
//
// Фактура — сырой текст ФНП № 461 (ред. 16.04.2026), legalacts.ru, пп. 164–171,
// 179, 183, 189–190 (curl, проверено 09.10.2026). Пункт 164 отдаёт объём и
// периодичность руководству по эксплуатации; ФНП действуют, когда в руководстве
// указаний нет. Значения по конкретным моделям парка не приводятся: у каждой
// машины они в паспорте. Рекомендации КРАН-КУБАНЬ в списке подготовки помечены
// как рекомендации, не как норма.

const CHECKED = '9 октября 2026 года';
const PUBLISHED = '2026-10-09';

const title = 'Техническое освидетельствование башенного крана: сроки';
const description = 'Частичное освидетельствование башенного крана — раз в 12 месяцев, полное — раз в 3 года (п. 165 ФНП № 461). Что проверяют и какие испытания проводят.';
const h1 = 'Как проходит техническое освидетельствование башенного крана и как часто его делают';
const crumbTitle = 'Техническое освидетельствование башенного крана';
const slug = 'tekhnicheskoe-osvidetelstvovanie-bashennogo-krana';

const H2 = [
  'Частичное и полное: раз в 12 месяцев и раз в 3 года',
  'Внеочередное освидетельствование: пять поводов',
  'Кто проводит и что пишет в паспорт',
  'Что проверяют при осмотре',
  'Испытания: 125 % статикой и 110 % на ходу',
  'Как подготовить кран: шесть шагов',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Как часто проходит техническое освидетельствование башенного крана?',
    a: 'По п. 165 ФНП № 461 частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года. Но п. 164 ставит выше руководство по эксплуатации: если оно задаёт иные объём и периодичность, действует оно, а ФНП применяют при отсутствии таких указаний.',
  },
  {
    q: 'Какие испытания входят в частичное освидетельствование?',
    a: 'Никаких грузовых. П. 169 ФНП прямо говорит: при частичном освидетельствовании статические и динамические испытания не проводятся. Кран осматривают, а механизмы, тормоза, приборы безопасности проверяют в работе. Грузовые испытания включены только в полное освидетельствование.',
  },
  {
    q: 'Каким грузом испытывают кран при полном освидетельствовании?',
    a: 'Статика идёт грузом 125 % от паспортной грузоподъёмности, динамика — грузом на 10 % выше паспортного, не менее трёх подъёмов и опусканий. Масса контрольных грузов не должна отличаться от нужной больше чем на 3 %.',
  },
  {
    q: 'Кто записывает результат в паспорт крана?',
    a: 'Инженерно-технический работник, ответственный за производственный контроль при эксплуатации. Он же указывает срок следующего освидетельствования. Для действующего крана запись подтверждает, что кран соответствует ФНП, исправен и выдержал испытания.',
  },
  {
    q: 'Нужно ли освидетельствование после перевозки крана на новый объект?',
    a: 'Для башенных кранов — зависит от типа. П. 166 требует внеочередного полного освидетельствования после монтажа на новом месте, но исключает из этого правила быстромонтируемые башенные краны. Относится ли к исключению конкретная машина, подтверждает её эксплуатационная документация.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Эксплуатация крана"
  published={PUBLISHED}
>
    <p slot="intro">Частичное техническое освидетельствование башенного крана проводят не реже раза в 12 месяцев, полное — не реже раза в 3 года (п. 165 ФНП № 461). Грузовые испытания входят только в полное: статикой 125 % и динамикой 110 % от паспортной грузоподъёмности. КРАН-КУБАНЬ разбирает порядок по пунктам 164–171, 179 и 189–190 действующей редакции.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>П. 165 ФНП № 461 делит периодическое освидетельствование на два вида: частичное не реже одного раза в 12 месяцев и полное не реже одного раза в 3 года. Исключение для полного — краны, обслуживающие машинные залы и электростанции: у них интервал 5 лет. К башенным кранам КБ-408.21 или Potain MCH 175 из парка КРАН-КУБАНЬ это исключение не относится.</p>
    <p>Первое слово в вопросе о сроках принадлежит руководству по эксплуатации. П. 164 говорит прямо: объём, порядок и периодичность освидетельствований определяет руководство, а ФНП действуют, когда указаний в нём нет. Поэтому заказчик сначала открывает руководство конкретной модели и только потом сверяет его с пунктом 165.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Вид</th><th>Периодичность</th><th>Что входит</th></tr></thead>
      <tbody>
        <tr><td>Частичное</td><td>не реже раза в 12 месяцев</td><td>осмотр, проверка механизмов, тормозов и приборов в работе; без грузовых испытаний</td></tr>
        <tr><td>Полное</td><td>не реже раза в 3 года</td><td>осмотр, статические и динамические испытания, испытания на устойчивость, если они есть в паспорте</td></tr>
        <tr><td>Внеочередное полное</td><td>после перечисленных в п. 166 событий</td><td>как полное; после замены грузозахватного органа — только статические испытания</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Внеочередное полное освидетельствование по п. 166 ФНП нужно не по календарю, а после события. Для башенного крана из списка пункта работают пять случаев: монтаж на новом месте, реконструкция или модернизация, ремонт расчётных элементов металлоконструкций с заменой или сваркой, установка сменного стрелового оборудования или замена стрелы, капитальный ремонт или замена лебёдки. Шестой случай, замена грузозахватного органа, требует только статических испытаний.</p>
    <p>Первый повод, монтаж на новом месте, имеет оговорку: пункт исключает из него подъёмники, вышки, стреловые и быстромонтируемые башенные краны. Быстромонтируемый giraFFe SMK-5.66 попадает под формулировку исключения, но КРАН-КУБАНЬ рекомендует подтвердить применение к конкретной машине по её эксплуатационной документации. Свободностоящий КБ-408.21, который собирают из секций на рельсовом пути, под исключение не подходит: после каждого монтажа на новой площадке его освидетельствуют полностью.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Освидетельствование проводит инженерно-технический работник, ответственный за осуществление производственного контроля при эксплуатации крана, при участии работника, ответственного за содержание крана в работоспособном состоянии (п. 167). Исполнитель не меняется ни для частичного, ни для полного освидетельствования.</p>
    <p>Результат записывается в паспорт крана (п. 189) вместе со сроком следующего освидетельствования. У вновь смонтированного крана запись подтверждает, что он смонтирован по руководству и ФНП и выдержал испытания. У действующего крана запись подтверждает соответствие ФНП, работоспособное состояние и прохождение испытаний, а разрешение на дальнейшую работу выдаёт тот же инженерно-технический работник.</p>
    <p>Отсюда практическое правило КРАН-КУБАНЬ: паспорт должен быть на площадке в момент освидетельствования. Без него запись сделать некуда, а срок следующего осмотра, который заказчик видит в паспорте, и есть календарь работ по крану.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>П. 170 ФНП требует осмотреть кран, а его механизмы, тормоза, гидро- и электрооборудование, указатели, ограничители и регистраторы проверить в работе. Дальше пункт перечисляет контрольные позиции: металлоконструкции и их соединения, крюк и блоки, расстояние между крюковой подвеской и упором при срабатывании концевого выключателя, изоляцию проводов и заземление, массу противовеса и балласта, крепление осей и пальцев, состояние рельсового пути и канатов.</p>
    <p>Металлоконструкции оценивает п. 190: проверяют отсутствие трещин, остаточных деформаций, утонения стенок от коррозии и ослабления соединений кабины, лестниц, площадок и ограждений. Нормы браковки берут из приложения № 3 к ФНП, если они не противоречат руководству. Рельсовые пути оценивают по методикам руководства, а при их отсутствии по требованиям ФНП.</p>
    <p>Ежесменный осмотр, который делает крановщик, не заменяет этого освидетельствования: у него другой исполнитель и другие интервалы. Что именно проверяют каждую смену, разобрано в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Осмотр башенного крана перед сменой»</a>, а какие приборы входят в проверку «в работе» — в статье <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Статические испытания идут грузом 125 % от номинальной паспортной грузоподъёмности для всех типов подъёмных сооружений, кроме подъёмников (п. 171). Перед ними тормоза всех механизмов регулируют на паспортный тормозной момент, а ограничитель грузоподъёмности отключают. Цель испытания — проверка конструктивной пригодности, поэтому положения крана выбирают такими, при которых усилия в канатах и изгибающие моменты наибольшие.</p>
    <p>Динамические испытания идут грузом на 10 % выше паспортной грузоподъёмности (п. 179). Груз поднимают и опускают не менее трёх раз и проверяют все рабочие движения в совмещении, как предписывает руководство. Если на кране два механизма подъёма, испытывают каждый (п. 180). Если кран используют только для подъёма и опускания груза, динамику не проводят (п. 181).</p>
    <p>Эксплуатирующая организация обеспечивает комплект контрольных грузов с указанием фактической массы (п. 183). Допуск по массе — не более 3 % от нужной (п. 171). Для Potain MDT 219 J10 или КБ-408.21 это означает заранее заказанный груз на площадку: без него испытание не начать. Паспортный график грузоподъёмности по вылету, из которого считают 125 % и 110 %, разобран в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Шесть шагов ниже — рекомендация КРАН-КУБАНЬ, а не норма ФНП: они сокращают простой крана в день освидетельствования.</p>
    <ol>
      <li>Найти срок следующего освидетельствования в паспорте и поставить дату в график за месяц.</li>
      <li>Сверить периодичность из руководства по эксплуатации с п. 165 ФНП и записать более строгое значение.</li>
      <li>Проверить, не было ли с прошлого раза события из п. 166: ремонта сваркой, замены стрелы, лебёдки или крюка.</li>
      <li>Заказать контрольные грузы с известной массой на 125 % и 110 % от паспортной грузоподъёмности.</li>
      <li>Подготовить рельсовый путь и акты его приёмки, чтобы осмотр пути шёл без догадок.</li>
      <li>Положить на площадку паспорт, руководство по эксплуатации и журналы осмотров.</li>
    </ol>
    <p>Освидетельствование — не единственная плановая работа по крану. Сроки монтажа и демонтажа, которые тоже требуют остановки, собраны в статьях <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сколько дней занимает сборка»</a> и <a href="/blog/demontazh-bashennogo-krana/">«Демонтаж башенного крана»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора № 461 (ФНП), пункты 164–171, 179–183, 189–190' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: КБ-408.21, Potain MDT 219 J10, giraFFe SMK-5.66' },
      { href: 'https://kran-kuban.ru/blog/ezhesmennyi-osmotr-bashennogo-krana/', label: 'kran-kuban.ru — статья «Осмотр башенного крана перед сменой»' },
    ]} />
</BlogArticleLayout>
