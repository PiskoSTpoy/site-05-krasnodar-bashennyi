---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 103. Пятьдесят пятая статья блога — угол (c) практический/региональный.
// Брюховецкий район — равнинный север-запад края между Тимашевском, Выселками,
// Кореновском, Каневской и Приморско-Ахтарским районом. Профиль: переработка
// сельхозсырья (комбикорм, хлеб, птица, кролик) плюс новая промплощадка у
// села Радовская, объявленная в 2026 году — первый в блоге пример района,
// где у крана есть конкретный свежий инвестиционный повод, а не только
// действующие заводы.
//
// Фактура — проверена 02.10.2026 (WebSearch + WebFetch, Википедия и bruh-invest.ru):
// - район образован 2 июня 1924 г.; 1376,22 км²; 46 005 чел. (2025 г.),
//   перепись 2020 г. — 46 852 чел.; 33 населённых пункта;
//   соседи: Выселковский (восток), Кореновский и Тимашёвский (юг),
//   Каневской и Павловский (север), Приморско-Ахтарский (запад);
// - станица Брюховецкая основана в 1794 г. как казачье поселение, статус
//   станицы с 1842 г.; на слиянии рек Бейсужёк Левый и Бейсуг; 19 154 чел.
//   (2021); ~22 км севернее Тимашевска; расстояние до Краснодара источники
//   дают от 95,5 до 100 км — даю диапазон;
// - предприятия: «Южная Корона — Брюховецкий комбикормовый завод», Брюховецкий
//   хлебозавод, Брюховецкий птицевод, Брюховецкий кролик, элеватор; 10
//   сельхозпредприятий, рыбколхоз, 265 КФХ, два племзавода КРС; ~180
//   предприятий района всего;
// - новая промплощадка у с. Радовская: 50 000 м², инженерные сети (вода,
//   электричество, газ, канализация), подъездные дороги, объявлена 06.06.2026
//   (bruh-invest.ru).
// Балл сейсмичности НЕ называю (конвенция с Волны 79). Закон о тишине №608-КЗ —
// в редакции с 1 марта 2026 (как в статьях-соседях).

const CHECKED = '2 октября 2026 года';
const PUBLISHED = '2026-10-02';

const title = 'Кран для Брюховецкого района: башенный кран у Бейсуга';
const description = 'Станица Брюховецкая в 95–100 км от Краснодара: комбикормовый завод, хлебозавод, птицеводство и промплощадка 50 000 м². Какой башенный кран здесь нужен.';
const h1 = 'Кран для Брюховецкого района: какой башенный кран нужен у станицы Брюховецкой';
const crumbTitle = 'Кран для Брюховецкого района';
const slug = 'kran-dlya-bryuhoveckogo-rayona';

const H2 = [
  'Брюховецкий район: 95–100 км от Краснодара на слиянии рек',
  'Комбикормовый завод, хлебозавод и птицеводство — какой кран',
  'Новая промплощадка у Радовской: 50 000 м² под резидентов',
  'Жильё станицы Брюховецкой и giraFFe SMK-5.66',
  'Грунт у Бейсуга, балл сейсмичности и закон №608-КЗ',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько километров от Краснодара до станицы Брюховецкой?',
    a: 'Станица Брюховецкая находится в 95–100 км от Краснодара — источники расходятся в пределах этого диапазона в зависимости от маршрута. КРАН-КУБАНЬ везёт технику по трассе через Тимашевск: быстромонтируемый giraFFe SMK-5.66 — одним рейсом, классический кран — несколькими рейсами с секциями мачты и стрелой.',
  },
  {
    q: 'Какой кран нужен для комбикормового завода или элеватора в Брюховецком районе?',
    a: 'Силосные банки и производственные корпуса переработки — высотная задача. КРАН-КУБАНЬ предлагает Potain MDT 219 J10 с высотой крюка до 70,4 м и вылетом 65 м или КБ-408.21 на рельсовом пути для длинных цехов, где кран едет вдоль здания и закрывает его вылетом 40 м.',
  },
  {
    q: 'Что известно о новой промплощадке в Брюховецком районе?',
    a: 'У села Радовская в 2026 году объявлена промышленная площадка 50 000 м² с подведёнными сетями водоснабжения, электричества, газа и канализации и подъездными дорогами для резидентов. КРАН-КУБАНЬ готов подать технику на эту площадку по мере запуска первых производств.',
  },
  {
    q: 'Какой балл сейсмичности у Брюховецкого района?',
    a: 'КРАН-КУБАНЬ не называет балл для района одной цифрой. Значение берут из карт ОСР-2015 для уровня ответственности объекта и уточняют микрорайонированием площадки, а требования задают ТСН 22-302-2000 и СП 14.13330.2018. Для расчёта основания крана действует балл, записанный в проекте конкретного объекта.',
  },
  {
    q: 'Действует ли закон о тишине в станице Брюховецкой?',
    a: 'Да, закон Краснодарского края №608-КЗ действует на всей территории края, включая станицу Брюховецкую. С 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. КРАН-КУБАНЬ составляет график подъёмов под эти окна.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Брюховецкий район"
  published={PUBLISHED}
>
    <p slot="intro">Станица Брюховецкая стоит в 95–100 км от Краснодара на слиянии рек Бейсужёк Левый и Бейсуг, а в Брюховецком районе на 1376,22 км² живут 46 005 человек. Башенный кран здесь нужен переработчикам сельхозсырья и новой промплощадке у села Радовская, а для малоэтажной застройки станицы КРАН-КУБАНЬ предлагает быстромонтируемый giraFFe SMK-5.66.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Брюховецкий район образован 2 июня 1924 года и занимает 1376,22 км², а население района на 2025 год составляет 46 005 человек — перепись 2020 года зафиксировала 46 852 жителя. В районе 33 населённых пункта, а на западе район граничит с Приморско-Ахтарским районом, на севере — с Каневским и Павловским, на юге — с Кореновским и Тимашёвским, на востоке — с Выселковским. КРАН-КУБАНЬ обслуживает весь этот узел равнинных районов с одной логистической базы.</p>
    <p>Станица Брюховецкая, административный центр района, основана в 1794 году как казачье поселение и получила статус станицы в 1842 году; расположена на слиянии рек Бейсужёк Левый и Бейсуг, примерно в 22 км к северу от Тимашевска. Расстояние до Краснодара источники дают в диапазоне 95–100 км. Для КРАН-КУБАНЬ это означает доставку техники по трассе через Тимашевск без горных перевалов, которые усложняют рейсы в <a href="/blog/kran-dlya-tuapse/">Туапсе</a> или <a href="/blog/kran-dlya-sochi/">Сочи</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Промышленность Брюховецкого района — переработка сельхозпродукции: комбикормовый завод «Южная Корона — БКЗ», Брюховецкий хлебозавод, птицеводческое и кролиководческое производство, элеватор. Сырьё дают 10 крупных сельхозпредприятий района, рыбколхоз и 265 крестьянско-фермерских хозяйств, а два племзавода занимаются разведением крупного рогатого скота. Корпуса комбикормового завода и элеватора — длинные склады и силосные линии, где груз подают вдоль здания.</p>
    <p>Для цехов переработки и элеваторных силосов КРАН-КУБАНЬ предлагает два решения в зависимости от геометрии объекта. Длинный производственный корпус закрывает КБ-408.21 на рельсовом пути: кран с вылетом 40 м едет вдоль здания и обслуживает всю его длину. Силосные банки и рабочие башни элеватора, где важна высота, поднимает Potain MDT 219 J10 с крюком до 70,4 м; разница между двумя моделями разобрана в статье <a href="/blog/potain-mdt-219-j10-ili-kb-408-21/">«Potain MDT 219 J10 или КБ-408.21»</a>.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Объект в Брюховецком районе</th><th>Что определяет выбор</th><th>Модель парка КРАН-КУБАНЬ</th></tr></thead>
      <tbody>
        <tr><td>Корпус комбикормового завода, элеватор</td><td>длина здания</td><td>КБ-408.21, вылет 40 м, рельсовый путь</td></tr>
        <tr><td>Силосы, рабочая башня</td><td>высота подачи</td><td>Potain MDT 219 J10, крюк до 70,4 м</td></tr>
        <tr><td>Корпус на промплощадке Радовской</td><td>скорость подготовки площадки</td><td>КБ-408.21 или Potain MDT 219 J10 по проекту</td></tr>
        <tr><td>Малоэтажный дом станицы</td><td>скорость монтажа</td><td>giraFFe SMK-5.66, крюк до 27 м</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Промышленная площадка у села Радовская — новый объект спроса для башенного крана в Брюховецком районе: 50 000 м² земли с подведёнными сетями водоснабжения, электроснабжения, газоснабжения и канализации, а также подъездными дорогами для будущих резидентов. Площадку объявили в июне 2026 года, и конкретные производства, которые на ней встанут, пока не определены публично.</p>
    <p>Готовая инфраструктура Радовской — водопровод, электричество, газ, канализация, подъездные пути — снимает с резидента земляные и сетевые работы и ускоряет переход к строительству корпусов. КРАН-КУБАНЬ рассматривает такую площадку как типичный сценарий для КБ-408.21: первые корпуса резидентов обычно длинные и невысокие, а рельсовый путь крана наращивает обслуживаемую длину без лишнего вылета. Как читать проект и выбрать модель под конкретный корпус, показано в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>В станице Брюховецкой живут 19 154 человека по данным переписи 2021 года — меньше половины населения района, а жилая застройка здесь преимущественно малоэтажная. Классический башенный кран с фундаментом или рельсовым путём для такого дома избыточен по срокам подготовки. КРАН-КУБАНЬ предлагает giraFFe SMK-5.66: опорный контур 4×4 м без фундамента и монтаж за 4–6 часов силами двух человек.</p>
    <p>Предел giraFFe SMK-5.66 задаёт высота дома: до 27 м при горизонтальной стреле и до 41,7 м при наклоне 20°, с грузом 1,05 т на вылете 43 м. Для дома выше этой отметки КРАН-КУБАНЬ переходит к КБ-408.21 или Potain MDT 219 J10. Доставка giraFFe SMK-5.66 на 100 км занимает один рейс, что делает его выгодным и на короткий срок стройки; логика выбора описана в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Станица Брюховецкая стоит на слиянии степных рек Бейсужёк Левый и Бейсуг на равнинной части Азово-Кубанской низменности. Близость двух рек означает, что несущий грунт под кран лежит ниже плодородного чернозёмного горизонта, а уровень грунтовых вод у слияния меняется по сезонам сильнее, чем на удалённых от воды участках. Основание под кран КРАН-КУБАНЬ рассчитывают по изысканиям конкретной площадки — порядок описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Балл сейсмичности Брюховецкого района КРАН-КУБАНЬ одной цифрой не называет: его берут из карт ОСР-2015 под уровень ответственности объекта и уточняют микрорайонированием. Требования к строительству в сейсмических районах края задают ТСН 22-302-2000 и СП 14.13330.2018. Инженерная служба КРАН-КУБАНЬ работает с баллом, записанным в проекте, а как его определяют, показано в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Закон Краснодарского края №608-КЗ действует в станице Брюховецкой так же, как в Краснодаре: с 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни с двухчасовым перерывом. Адрес объекта в Брюховецком районе можно прислать через <a href="/#order">форму на главной</a>: инженерная служба предложит модель, основание и график доставки. Соседние площадки разобраны в статьях о <a href="/blog/kran-dlya-timashevska/">Тимашевске</a> и <a href="/blog/kran-dlya-kanevskogo-rayona/">Каневском районе</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%91%D1%80%D1%8E%D1%85%D0%BE%D0%B2%D0%B5%D1%86%D0%BA%D0%B8%D0%B9_%D1%80%D0%B0%D0%B9%D0%BE%D0%BD', label: 'ru.wikipedia.org — Брюховецкий район: дата образования, площадь, население 2025 г., населённые пункты, соседние районы' },
      { href: 'https://ru.wikipedia.org/wiki/%D0%91%D1%80%D1%8E%D1%85%D0%BE%D0%B2%D0%B5%D1%86%D0%BA%D0%B0%D1%8F', label: 'ru.wikipedia.org — Брюховецкая: основание 1794 г., слияние рек, население 2021 г., расстояние до Тимашевска' },
      { href: 'https://bruhoveckaya.ru/raion/', label: 'bruhoveckaya.ru — Брюховецкий район: сельхозпредприятия, КФХ, племзаводы' },
      { href: 'https://bruh-invest.ru/ru/news/promyshlennaya-ploshchadka-06032026/', label: 'bruh-invest.ru — промышленная площадка у с. Радовская: 50 000 м², инженерные сети, июнь 2026 г.' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
      { href: 'https://www.kubzsk.ru/', label: 'kubzsk.ru — Законодательное Собрание Краснодарского края: закон №608-КЗ (режим тишины)' },
    ]} />
</BlogArticleLayout>
