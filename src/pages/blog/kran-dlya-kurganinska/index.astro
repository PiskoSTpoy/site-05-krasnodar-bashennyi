---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 98. Сороковая статья блога — угол (c) практический/региональный.
// Курганинск — следующий город вниз по Лабе после Лабинска (Волна 97) и до
// Усть-Лабинского района (Волна 93). Отличие от соседей: железнодорожный
// узел на линии Армавир — Туапсе и пищевые предприятия с высотными
// сооружениями (элеватор, сахарный завод), где кран работает у действующих
// корпусов и путей, а не на свободном поле.
//
// Фактура (WebFetch 27.09.2026):
// - ru.wikipedia.org «Курганинск»: 46 089 жит. (2025); правый берег Лабы,
//   150 км к востоку от Краснодара; станция Курганная на линии Армавир —
//   Туапсе; станица Курганная основана в 1834 г., город Курганинск с
//   14.01.1961; предприятия: сахарный завод, птицекомбинат, пищекомбинат
//   «Галан», элеватор, завод жестяно-баночных изделий.
// Свежих подтверждённых строек с этажностью в открытых источниках не нашли —
// конкретных ЖК не называем. Балл сейсмичности Курганинска не называем
// (конвенция сайта с Волны 79). Закон №608-КЗ — окна из опубликованных
// страниц сайта (kommersant.ru).

const CHECKED = '27 сентября 2026 года';
const PUBLISHED = '2026-09-27';

const title = 'Кран для Курганинска: башенный кран у Лабы и железной дороги';
const description = 'Башенный кран в Курганинске: элеватор и сахарный завод, станция Курганная на линии Армавир — Туапсе, грунт у Лабы, сейсмичность и закон о тишине.';
const h1 = 'Кран для Курганинска: какой башенный кран нужен в городе на Лабе и железной дороге';
const crumbTitle = 'Кран для Курганинска';
const slug = 'kran-dlya-kurganinska';

const H2 = [
  'Курганинск: город на Лабе в 150 км от Краснодара',
  'Промышленность Курганинска: элеватор, сахар и птица',
  'Кран у действующих корпусов и железной дороги',
  'Какую модель парка выбрать для Курганинска',
  'Грунт на правом берегу Лабы',
  'Сейсмичность площадки в Курганинске',
  'Закон о тишине в Курганинске',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой башенный кран нужен для реконструкции элеватора в Курганинске?',
    a: 'Для элеватора решают высота крюка над силосами и вылет до дальней точки корпуса. Если нужна высота до 70 м и широкий вылет, КРАН-КУБАНЬ предлагает Potain MDT 219 J10 с вылетом 65 м; если площадка стеснена соседними корпусами — Potain MCH 175 с маховой стрелой. Выбор делают по генплану и массам оборудования.',
  },
  {
    q: 'Можно ли ставить башенный кран рядом с железной дорогой в Курганинске?',
    a: 'Можно, но только по проекту производства работ, согласованному с владельцем инфраструктуры, если рабочая зона крана выходит к путям. Станция Курганная стоит на линии Армавир — Туапсе, и для площадок рядом с ней КРАН-КУБАНЬ закладывает ограничение поворота или маховую стрелу Potain MCH 175, которая сокращает вылет.',
  },
  {
    q: 'Какая сейсмичность в Курганинске для строительства?',
    a: 'Надёжного первоисточника с баллом для площадок Курганинска мы не нашли, поэтому число не называем. Расчётный балл определяют по СП 14.13330.2018 и краевым ТСН 22-302-2000 с учётом уровня ответственности объекта и грунта. Инженерная служба КРАН-КУБАНЬ считает основание крана от балла, указанного в проекте.',
  },
  {
    q: 'Действует ли закон о тишине в Курганинске?',
    a: 'Да, закон Краснодарского края №608-КЗ действует во всём крае, включая Курганинск. Шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
  about: { '@type': 'City', name: 'Курганинск' },
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Курганинский район"
  published={PUBLISHED}
>
    <p slot="intro">Курганинск — город на 46 тысяч жителей на правом берегу Лабы, в 150 км к востоку от Краснодара, и башенный кран здесь чаще нужен пищевой промышленности, чем жилой стройке. Элеватор, сахарный завод и птицекомбинат — объекты, где кран КРАН-КУБАНЬ работает у действующих корпусов, а станция Курганная на линии Армавир — Туапсе добавляет ограничения по рабочей зоне. К выбору модели прибавляются грунт у Лабы, расчётная сейсмичность по ТСН 22-302-2000 и окна закона №608-КЗ.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Курганинск стоит на правом берегу Лабы, в 150 км к востоку от Краснодара; по данным Википедии, в 2025 году в городе жили 46 089 человек. Станица Курганная основана в 1834 году, а 14 января 1961 года получила статус города и новое имя — Курганинск. Через город проходит железнодорожная линия Армавир — Туапсе со станцией Курганная.</p>
    <p>Для КРАН-КУБАНЬ Курганинск — средняя точка на Лабе между двумя уже разобранными районами: предгорным Лабинском выше по течению и Усть-Лабинским районом ниже. Особенности соседей — в статьях <a href="/blog/kran-dlya-labinska/">«Кран для Лабинска»</a> и <a href="/blog/kran-dlya-ust-labinskogo-rayona/">«Кран для Усть-Лабинского района»</a>. От обоих Курганинск отличается железнодорожным узлом в черте города и промышленными площадками вдоль путей.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Промышленность Курганинска по перечню Википедии — пищевая и перерабатывающая: сахарный завод, элеватор, птицекомбинат, пищекомбинат «Галан» и завод жестяно-баночных изделий. Для башенного крана КРАН-КУБАНЬ эти площадки различаются задачей. Элеватор и сахарный завод — это высота: силосы, башни и технологические этажи, где при реконструкции груз поднимают выше крыши действующих корпусов.</p>
    <p>Птицекомбинат, пищекомбинат и баночный завод — это ширина: одноэтажные цеха и склады с большими пролётами, где крану КРАН-КУБАНЬ нужен вылет, а не высота. Такие корпуса перекрывает giraFFe SMK-5.66 с вылетом до 43 м или классический кран, если масса оборудования больше 1,05 т на конце стрелы SMK-5.66. Точный выбор зависит от массы самого тяжёлого груза и расстояния до него.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>На действующем заводе башенный кран КРАН-КУБАНЬ работает рядом с корпусами, которые нельзя остановить, и рабочую зону ограничивают так, чтобы груз не проходил над работающими цехами и людьми. Для этого в проекте производства работ задают ограничение угла поворота или выбирают кран с меньшим вылетом над соседними объектами. Potain MCH 175 решает задачу геометрией: маховая стрела наклоняется и сокращает вылет почти до мачты.</p>
    <p>Площадки Курганинска вдоль линии Армавир — Туапсе требуют того же подхода к железной дороге: если круг вылета крана КРАН-КУБАНЬ выходит к путям станции Курганная, работу согласуют с владельцем инфраструктуры и ограничивают зону поворота в ППР. Рядом с путями безоголовочный Potain MDT 219 J10 удобнее крана с оголовком, когда над площадкой проходят линии связи или соседние краны. Порядок согласований разобран на этапе <a href="/etapy/proekt-i-ppr/">«Проект и ППР»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Выбор модели КРАН-КУБАНЬ для Курганинска идёт от типа объекта, а не от города. Ориентир по задачам:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Объект в Курганинске</th><th>Что решает</th><th>Модель КРАН-КУБАНЬ</th></tr></thead>
      <tbody>
        <tr><td>Реконструкция элеватора, сахарного завода</td><td>Высота и вылет</td><td>Potain MDT 219 J10: до 70,4 м, 65 м вылета</td></tr>
        <tr><td>Площадка у действующих корпусов или путей</td><td>Сокращение вылета</td><td>Potain MCH 175: маховая стрела до 55 м</td></tr>
        <tr><td>Склад, цех с большим пролётом</td><td>Вылет при малой высоте</td><td>giraFFe SMK-5.66: вылет до 43 м</td></tr>
        <tr><td>Среднеэтажный жилой дом</td><td>Высота крюка и длина здания</td><td>КБ-408.21 на рельсовом пути или SMK-5.66</td></tr>
      </tbody>
    </table></div>
    <p>Характеристики в таблице — из карточек моделей парка КРАН-КУБАНЬ; грузоподъёмность на конкретном вылете берут из грузовой характеристики, а не из максимума. Как считать высоту крюка, вылет и груз, разобрано в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>, а выбор основания — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Прибрежная часть Курганинска у Лабы — повод для КРАН-КУБАНЬ начать с изысканий, а не с выбора крана. Несущую способность грунта и уровень грунтовых вод под фундаментом или рельсовым путём определяет проектировщик по данным изысканий на конкретном участке. На действующем заводе к этому добавляются подземные сети и старые фундаменты, которые не всегда отражены в документах.</p>
    <p>Для КБ-408.21 на рельсовом пути в Курганинске важна равномерность основания по всей длине пути, для Potain MDT 219 J10 на фундаменте — несущая способность под плитой. giraFFe SMK-5.66 требует проверки покрытия под четырьмя опорами контура 4×4 м. Что входит в изыскания, КРАН-КУБАНЬ разобрал на этапе <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a> и в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Балл сейсмичности для Курганинска КРАН-КУБАНЬ сознательно не называет: надёжного первоисточника с числом для площадок города в открытом доступе мы не нашли. Расчётную сейсмичность определяют по СП 14.13330.2018 и краевым ТСН 22-302-2000 с учётом уровня ответственности объекта и категории грунта. Краевой диапазон — 7–9 баллов, и равнинное положение города не заменяет проверку по проекту.</p>
    <p>От расчётного балла зависит нагрузка на основание крана КРАН-КУБАНЬ — на фундамент Potain MDT 219 J10, на рельсовый путь КБ-408.21 и на устойчивость giraFFe SMK-5.66. Для элеватора и сахарного завода важен и уровень ответственности самого объекта: он влияет на расчётный балл площадки. Как балл складывается, разобрано в разделе <a href="/seysmozony/">«Сейсмозоны»</a> и в статье <a href="/blog/uroven-otvetstvennosti-obekta/">«Уровень ответственности объекта»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Закон Краснодарского края №608-КЗ действует в Курганинске так же, как в Краснодаре. Шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Башенный кран КРАН-КУБАНЬ на жилой площадке Курганинска работает 13 часов в будни, и срок аренды считают от этих часов. Промышленная площадка вдали от жилья планируется свободнее, но расстояние до ближайших домов проверяют по проекту.</p>
    <p>Для крана КРАН-КУБАНЬ на заводе в жилой застройке Курганинска окно 13:00–15:00 удобно отдать под осмотр механизмов и пересменку, а шумные подъёмы металлоконструкций — на утро. Подробный разбор окон — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>
    <p>Адрес площадки в Курганинске и тип объекта можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ подберёт модель и основание под задачу.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9A%D1%83%D1%80%D0%B3%D0%B0%D0%BD%D0%B8%D0%BD%D1%81%D0%BA', label: 'ru.wikipedia.org — Курганинск: население, география, история, предприятия' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018 «Строительство в сейсмических районах»' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
