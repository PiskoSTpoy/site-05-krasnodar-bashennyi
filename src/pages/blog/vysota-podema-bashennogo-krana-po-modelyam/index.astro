---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 112. Восемьдесят первая статья блога — угол (b) коммерческий/сравнительный.
// Пять моделей парка по высоте подъёма крюка и по способу её набрать. Пары
// сравнивались по грузу и по типу стрелы; высота как отдельная ось — нет.
//
// Фактура — только src/data/parkModels.ts и карточки парка (проверено 14.10.2026):
// - Potain MDT 219 J10: высота подъёма до 70,4 м; вылет 65 м; 10 т максимум;
//   рельсовый путь или монолитный фундамент;
// - КБ-408.21: 54,0–72,7 м (наращивание секций мачты); вылет 40 м; 10 т;
//   только наземный рельсовый путь;
// - КБ-674А: до 60 м свободностоящий, до 116–120 м приставной (крепление к
//   зданию); вылет 50,5 м; 12,5 т максимум;
// - giraFFe SMK-5.66: до 27 м с горизонтальной стрелой, до 41,7 м с наклоном
//   20°; вылет 2,8–43 м; 5 т максимум; опорный контур 4×4 м;
// - Potain MCH 175: до 58,5 м; вылет до 55 м, сокращается наклоном стрелы;
//   10 т максимум.
// Расчёты: КБ-408.21 — диапазон 72,7 − 54,0 = 18,7 м; SMK-5.66 — наклон
// даёт +14,7 м (41,7 − 27); приставной КБ-674А против свободного — +56–60 м
// (116–120 − 60); MDT против КБ-408.21 при максимуме — разница 2,3 м.
// Условный пример с этажами помечен как допущение (3 м на этаж — не данные парка).
// Не названо: высота подъёма MCH с наклонной стрелой при разных вылетах,
// цены и сроки монтажа — в реестре нет.

const CHECKED = '14 октября 2026 года';
const PUBLISHED = '2026-10-14';

const title = 'Высота подъёма башенного крана: сравнение моделей парка';
const description = 'Высота подъёма крюка в парке КРАН-КУБАНЬ — от 27 м у giraFFe SMK-5.66 до 120 м у приставного КБ-674А. Сравнение пяти моделей и способы набрать высоту.';
const h1 = 'Какой башенный кран поднимает выше всех: высота подъёма пяти моделей парка';
const crumbTitle = 'Высота подъёма башенного крана';
const slug = 'vysota-podema-bashennogo-krana-po-modelyam';

const H2 = [
  'Пять моделей по высоте подъёма крюка',
  'Как набирают высоту: секции, анкеровка или наклон стрелы',
  'Высота и груз на вылете: что теряется за каждый метр',
  'Какую модель брать под высоту объекта',
  'Что проверить, прежде чем доверять цифре высоты',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой башенный кран в парке поднимает выше всех?',
    a: 'Приставной КБ-674А: по данным парка КРАН-КУБАНЬ до 116–120 м при креплении к зданию и до 60 м свободностоящим. Среди свободностоящих моделей выше всех КБ-408.21 — до 72,7 м, следом Potain MDT 219 J10 — до 70,4 м.',
  },
  {
    q: 'Почему у КБ-408.21 высота подъёма указана диапазоном?',
    a: 'Высоту набирают наращиванием секций мачты: 54,0 м при базовой комплектации и до 72,7 м при максимальном числе секций. Разница — 18,7 м. КРАН-КУБАНЬ определяет число секций по высоте здания и по расчёту основания, а не берёт максимум по умолчанию.',
  },
  {
    q: 'На какую высоту может поднять giraFFe SMK-5.66?',
    a: 'До 27 м при горизонтальной стреле и до 41,7 м при наклоне стрелы на 20°. Наклон поднимает крюк на 14,7 м, но сокращает рабочий вылет. Для объекта выше 41,7 м КРАН-КУБАНЬ предлагает другие модели парка.',
  },
  {
    q: 'Что даёт приставной кран по высоте по сравнению со свободностоящим?',
    a: 'У КБ-674А свободностоящая высота ограничена 60 м, а при креплении к зданию — 116–120 м, то есть на 56–60 м больше. Цена — анкеровка к конструкции здания и расчёт узлов крепления в проекте, поэтому такой вариант определяют на этапе ППР.',
  },
  {
    q: 'Достаточно ли высоты крюка, чтобы выбрать кран?',
    a: 'Нет: высота крюка должна перекрывать здание с запасом на груз и стропы, а на нужном вылете кран обязан держать массу груза. КРАН-КУБАНЬ проверяет три числа сразу — высоту, вылет и груз на вылете — и сверяет их с паспортной кривой модели.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">Выше всех в парке КРАН-КУБАНЬ поднимает приставной КБ-674А: 116–120 м при креплении к зданию, но только 60 м свободностоящим. Среди кранов без крепления лидирует КБ-408.21 — до 72,7 м, на втором месте Potain MDT 219 J10 с 70,4 м, затем Potain MCH 175 с 58,5 м и giraFFe SMK-5.66 с 27–41,7 м. Разница между крайними моделями — 78 м.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Высота подъёма крюка — паспортная величина, которую для каждой модели парка КРАН-КУБАНЬ задаёт конструкция мачты и способ крепления. В таблице она стоит рядом с вылетом и грузом: высота без этих двух чисел для выбора крана бесполезна.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Высота подъёма крюка</th><th>Как набирается</th><th>Вылет</th><th>Груз максимум</th></tr></thead>
      <tbody>
        <tr><td>КБ-674А</td><td>до 60 м свободно, 116–120 м приставным</td><td>Крепление к зданию</td><td>50,5 м</td><td>12,5 т</td></tr>
        <tr><td>КБ-408.21</td><td>54,0–72,7 м</td><td>Секции мачты</td><td>40 м</td><td>10 т</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>до 70,4 м</td><td>Секции мачты</td><td>65 м</td><td>10 т</td></tr>
        <tr><td>Potain MCH 175</td><td>до 58,5 м</td><td>Секции мачты, стрела наклоняется</td><td>до 55 м</td><td>10 т</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>до 27 м, с наклоном 20° до 41,7 м</td><td>Наклон стрелы, без секций</td><td>2,8–43 м</td><td>5 т</td></tr>
      </tbody>
    </table></div>
    <p>Разница между двумя свободностоящими лидерами невелика: КБ-408.21 при максимальном числе секций выше Potain MDT 219 J10 на 2,3 м. Поэтому решать между ними по высоте обычно не приходится, и КРАН-КУБАНЬ выбирает по вылету, грузу и основанию. Попарные сравнения этих моделей разобраны в статье <a href="/blog/potain-mdt-219-j10-ili-kb-408-21/">«Potain MDT 219 J10 или КБ-408.21»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Три способа набрать высоту дают три разные цены в проекте. Наращивание секций мачты — путь Potain MDT 219 J10, КБ-408.21 и Potain MCH 175: каждая секция поднимает крюк, но увеличивает нагрузку на основание, поэтому рельсовый путь или монолитный фундамент считают под итоговую высоту. Для КБ-408.21 эта разница составляет 18,7 м между базовой и максимальной комплектацией.</p>
    <p>Крепление к зданию — путь КБ-674А. Свободностоящий кран упирается в 60 м, а анкеровка к конструкции здания поднимает потолок до 116–120 м, то есть на 56–60 м выше. Цена — узлы крепления, которые считают вместе с конструкторами здания, и ППР, где расчётные нагрузки анкеров обязаны быть. Состав такого проекта разобран в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«ППР для башенного крана»</a>.</p>
    <p>Наклон стрелы — путь giraFFe SMK-5.66: горизонтальная стрела даёт до 27 м, наклон на 20° — до 41,7 м, то есть на 14,7 м больше. Платой служит вылет: наклонённая стрела работает на меньшем радиусе. Об основании у этой модели речь не идёт — опорный контур 4×4 м, фундамент не нужен, как показано в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Высота и грузоподъёмность на вылете связаны через паспортную кривую, и максимум по одному параметру не означает максимум по другому. У Potain MDT 219 J10 на вылете 65 м кран держит 1,9 т, у КБ-674А на 50,5 м — 5,6 т, у Potain MCH 175 на 55 м — 1,5 т, у giraFFe SMK-5.66 на 43 м — 1,05 т. Десять тонн у трёх моделей — паспортный максимум, а не груз на конце стрелы.</p>
    <p>Практический вывод для КРАН-КУБАНЬ: высоту объекта проверяют вместе с самым тяжёлым грузом на самом дальнем вылете. Пример: монолитная панель 3 т подаётся на 45 м. Potain MCH 175 и Potain MDT 219 J10 по высоте проходят, но на этом вылете их паспортные кривые надо читать по таблице, а не по максимуму. Как читать кривую, показано в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>
    <p>Дополнительно высоту ограничивает ветер. Чем выше крюк, тем сильнее нагрузка на мачту, и паспортный предел скорости ветра надо проверять для итоговой высоты, а не для базовой. Порядок чтения этого числа дан в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Высота здания плюс запас на строповку и груз задаёт минимальную высоту крюка, и по ней отсекаются модели парка КРАН-КУБАНЬ. Условный пример с допущением три метра на этаж: девятиэтажный дом — около 27 м, а с запасом на стропы и груз крюк должен подниматься заметно выше. Допущение в три метра — расчётное, а не данные парка, высоту здания берут из проекта.</p>
    <ul>
      <li>До 41,7 м — giraFFe SMK-5.66 с наклоном стрелы или любая из тяжёлых моделей; решает вылет и основание.</li>
      <li>От 41,7 до 58,5 м — Potain MCH 175, КБ-408.21, Potain MDT 219 J10 или КБ-674А свободностоящий.</li>
      <li>От 58,5 до 72,7 м — КБ-408.21 с максимальным числом секций, Potain MDT 219 J10 до 70,4 м либо КБ-674А.</li>
      <li>Выше 72,7 м — только приставной КБ-674А, до 116–120 м.</li>
    </ul>
    <p>Границы в списке взяты из паспортных значений парка: они показывают, какая модель по высоте вообще проходит, а не какую модель выбрать. Окончательный выбор делают по вылету, грузу и основанию; общий порядок — в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>, а выбор между путём и фундаментом — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Паспортная высота — верхняя граница, а не рабочая цифра: КРАН-КУБАНЬ проверяет её тремя вопросами до заказа. Первый — какая комплектация секций даёт нужную высоту, а не максимальную. Второй — выдержит ли основание кран в этой комплектации. Третий — не пересекутся ли стрела и противовес с соседним краном или зданием на этой высоте.</p>
    <p>Если на площадке два крана, высоту подбирают так, чтобы стрелы шли на разных уровнях: разность по вертикали между ними не менее 1 м требует ФНП № 461. Этот случай разобран в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>. Для КРАН-КУБАНЬ именно разность уровней нередко определяет, сколько секций нужно кранам.</p>
    <p>Высота здания, адрес и вылет подачи можно прислать через <a href="/#order">форму на главной</a>; инженерная служба КРАН-КУБАНЬ сопоставит их с таблицей парка и назовёт модели, которые проходят по высоте.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/gruzovaya-harakteristika-bashennogo-krana/', label: 'kran-kuban.ru — грузовая характеристика башенного крана' },
      { href: 'https://kran-kuban.ru/blog/kak-podobrat-bashennyi-kran/', label: 'kran-kuban.ru — как подобрать башенный кран' },
    ]} />
</BlogArticleLayout>
