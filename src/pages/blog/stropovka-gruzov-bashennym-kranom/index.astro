---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 104. Пятьдесят седьмая статья блога — угол (a) информационный/how-to.
// Строповка грузов башенным краном: новая тема блога — ни одна статья ещё не
// разбирала выбор и расчёт грузозахватной оснастки (стропов) для типовых
// грузов на стройплощадке. Тема про такелаж, не про федеральную регистрацию
// крана — не пересекается с резервом site-01.
//
// Фактура — проверена 03.10.2026 (WebSearch + WebFetch):
// - три вида стропов (цепные, канатные, текстильные), области применения по
//   типу груза, коэффициент запаса не менее 6 — ТР ТС 010/2011 (docs.cntd.ru);
// - угол между ветвями стропа не более 90°, оптимум 60-90° — promstrop.ru;
// - формула Lmin = 1,2 × Lц для угла 60-90° — startkom.ru;
// - требования к стропальщику (18 лет, обучение, аттестация, осмотр перед
//   подъёмом) — promstrop.ru.
// Числовой пример расчёта длины стропа — собственный, помечен условным
// (источники формулу дают без примера).

const CHECKED = '3 октября 2026 года';
const PUBLISHED = '2026-10-03';

const title = 'Строповка грузов башенным краном: какие стропы и когда';
const description = 'Цепные стропы — для горячих и острых грузов, канатные — универсальные, текстильные — для кирпича. Угол между ветвями до 90°, запас прочности — не менее 6.';
const h1 = 'Строповка грузов башенным краном: какие стропы использовать и когда';
const crumbTitle = 'Строповка грузов башенным краном';
const slug = 'stropovka-gruzov-bashennym-kranom';

const H2 = [
  'Три вида стропов для башенного крана',
  'Какой строп нужен для какого груза на стройке',
  'Угол между ветвями стропа и коэффициент запаса',
  'Как считают длину стропа под конкретный груз',
  'Кто имеет право проводить строповку',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой коэффициент запаса должен быть у стропа на башенном кране?',
    a: 'Технический регламент ТР ТС 010/2011 требует для каждой ветви стропа запас прочности не менее 6 к разрывной нагрузке. КРАН-КУБАНЬ списывает строп, если фактический запас опускается ниже этой нормы из-за износа, замятий или истирания, даже без видимых повреждений на поверхности.',
  },
  {
    q: 'Какой строп нужен для арматурных каркасов?',
    a: 'Арматурные каркасы цепляют цепными стропами, потому что острые концы прутков разрезали бы текстильную ленту за один подъём. КРАН-КУБАНЬ использует цепные стропы и для раскалённого металлопроката, который выдерживает нагрев до 400°C без потери прочности.',
  },
  {
    q: 'Можно ли поднимать кирпич на поддонах канатным стропом?',
    a: 'Технически можно, но КРАН-КУБАНЬ предпочитает текстильные стропы для кирпича и блоков на поддонах: лента равномерно распределяет нагрузку по контуру поддона и не повреждает обвязку груза, в отличие от более жёсткого стального канатного стропа.',
  },
  {
    q: 'Какой угол между ветвями стропа считается безопасным?',
    a: 'Угол между ветвями многоветвевого стропа не должен превышать 90°, а оптимальным КРАН-КУБАНЬ считает диапазон 60–90°. При большем угле ветви работают почти горизонтально, и нагрузка на каждую ветвь растёт быстрее, чем кажется на глаз.',
  },
  {
    q: 'Кто может проводить строповку груза на башенном кране?',
    a: 'Строповку проводит стропальщик не младше 18 лет, прошедший обучение и аттестацию, а не любой рабочий на площадке. Стропальщик КРАН-КУБАНЬ осматривает груз и строп перед каждым подъёмом и имеет право остановить работу при сомнении в схеме или исправности оснастки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Эксплуатация · Такелаж"
  published={PUBLISHED}
>
    <p slot="intro">Коэффициент запаса прочности у каждой ветви стропа на башенном кране должен быть не менее 6 — так требует технический регламент ТР ТС 010/2011. КРАН-КУБАНЬ подбирает стропы под груз на площадке из трёх видов: текстильные для кирпича и облицовки, канатные для грузов общего назначения, цепные для горячего металла и острых кромок. Угол между ветвями стропа не должен превышать 90°, а его длину считают от расстояния до центра тяжести груза.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Три вида стропов работают с башенным краном КРАН-КУБАНЬ: цепные, канатные и текстильные (ленточные). Цепные стропы держат нагретые грузы до 400°C и острый металлопрокат — здесь кромка или температура разрушили бы текстильный или канатный строп за один подъём. Канатные стропы универсальны и чаще всего используют для грузов общего назначения на стройке. Текстильные стропы легче остальных видов и не царапают облицовку, но не подходят для горячих и острых грузов.</p>
    <p>Выбор стропа для крана КРАН-КУБАНЬ зависит от поверхности и температуры груза, а не только от его массы. Канатный строп переживает истирание на бетонной кромке лучше текстильного, но может повредить окрашенную или полированную поверхность панели. Текстильный строп КРАН-КУБАНЬ использует там, где важно не повредить фасадный материал — например, облицовочные плиты. Цепной строп остаётся единственным вариантом для раскалённого металлопроката и конструкций с острыми кромками без защитных накладок.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Пять типов груза на площадке КРАН-КУБАНЬ требуют разных стропов: кирпич и блоки на поддонах, железобетонные панели, арматурные каркасы, бадьи с бетоном и технологическое оборудование. Кирпич и блоки на поддонах поднимают текстильными стропами с равномерным распределением нагрузки по контуру поддона. Железобетонные панели и блоки КРАН-КУБАНЬ цепляет за монтажные петли текстильными или канатными стропами — петля уже рассчитана проектировщиком панели под эту нагрузку.</p>
    <p>Панели КРАН-КУБАНЬ поднимает траверсой с опорными захватами, а не обычным стропом: нагрузка распределяется по двум точкам, и панель не выгибается при подъёме. Арматурные каркасы цепляют цепными стропами из-за острых концов прутков, которые разрезали бы текстильную ленту за один подъём. Бадьи с бетоном КРАН-КУБАНЬ поднимает канатными или цепными стропами за рым-болты, предусмотренные конструкцией самой бадьи.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Вид стропа</th><th>Материал</th><th>Для каких грузов</th><th>Ограничение</th></tr></thead>
      <tbody>
        <tr><td>Текстильный (ленточный)</td><td>полиэстеровая лента</td><td>кирпич и блоки на поддонах, облицовка</td><td>не для горячих и острых грузов</td></tr>
        <tr><td>Канатный</td><td>стальной трос</td><td>грузы общего назначения, ЖБИ за петли, бадьи</td><td>истирает мягкие поверхности</td></tr>
        <tr><td>Цепной</td><td>стальная цепь</td><td>арматурные каркасы, металлопрокат до 400°C</td><td>тяжелее остальных видов</td></tr>
      </tbody>
    </table></div>
    <p>Таблица показывает, что ни один вид стропа не закрывает все случаи сразу: текстильный бережёт поверхность, канатный держит истирание, цепной — температуру и острые кромки. КРАН-КУБАНЬ держит на объекте минимум два вида стропов, когда на площадке одновременно идёт кирпичная кладка и монтаж арматурных каркасов. Выбор стропа под конкретный подъём утверждает стропальщик, а не крановщик по требованию бригады.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Угол между ветвями многоветвевого стропа на кране КРАН-КУБАНЬ не должен превышать 90°, а оптимальным считается диапазон от 60° до 90°. При угле больше 90° нагрузка на каждую ветвь растёт быстрее, чем кажется на глаз: ветви начинают работать почти горизонтально и тянут груз в стороны, а не держат его вес вертикально. Технический регламент ТР ТС 010/2011 требует для каждой ветви стропа запас прочности не менее 6 к её разрывной нагрузке.</p>
    <p>Запас прочности 6 для стропа КРАН-КУБАНЬ — не инженерная перестраховка, а требование техрегламента на весь срок службы оснастки. Трос или лента изнашиваются при каждом цикле подъёма, и шестикратный запас оставляет ресурс на истирание, замятия и случайные перегрузки до следующей проверки стропа. Снижение запаса ниже нормы — причина, по которой строп списывают, даже если видимых повреждений на нём нет.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Минимальную длину ветви стропа для угла 60–90° КРАН-КУБАНЬ считает по формуле Lmin = 1,2 × Lц, где Lц — расстояние от точки крепления до центра тяжести груза. Коэффициент 1,2 закладывает запас именно под этот диапазон углов между ветвями стропа и перестаёт работать, если ветви разворачиваются за его пределы — тогда расчёт делают по другой формуле с учётом фактического угла.</p>
    <p>Пример расчёта: железобетонная панель с расстоянием от точки крепления до центра тяжести Lц = 1,5 м потребует ветви стропа длиной не меньше Lmin = 1,2 × 1,5 = 1,8 м, чтобы угол между ветвями остался в диапазоне 60–90°. Цифры примера условны и показывают порядок расчёта, а не параметры конкретной панели на объекте КРАН-КУБАНЬ. Строп короче 1,8 м на этом же грузе развернёт угол ветвей за пределы нормы ТР ТС 010/2011.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Строповку груза на кране КРАН-КУБАНЬ проводит стропальщик не младше 18 лет, прошедший обучение и аттестацию — случайный рабочий со стройки к крюку крана не допускается. Стропальщик обязан знать схемы строповки под типовые грузы объекта и осматривать и груз, и выбранный строп перед каждым подъёмом. При сомнении в исправности стропа или в правильности схемы стропальщик обязан остановить подъём до устранения замечаний, и крановщик КРАН-КУБАНЬ не поднимает груз по сигналу без этого разрешения.</p>
    <p>Расчёт стропов КРАН-КУБАНЬ увязывает с грузовой характеристикой самого крана: даже правильно застропованный груз не поднять, если его масса превышает паспортную грузоподъёмность на нужном вылете — таблица по моделям парка разобрана в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>. Перечень грузов и чертёж объекта можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ подберёт схему строповки под конкретный монтаж.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://promstrop.ru/bezopasnaya-stropovka_artic_.html', label: 'promstrop.ru — виды стропов, применение по типу груза, угол между ветвями, коэффициент запаса' },
      { href: 'https://startkom.ru/raschyot-gruzovyh-stropov-dlya-podema-gruza/', label: 'startkom.ru — формула расчёта минимальной длины ветви стропа' },
      { href: 'https://startkom.ru/shemy-stropovki-gruzov/', label: 'startkom.ru — схемы строповки грузов по ГОСТ 14192-96' },
      { href: 'https://docs.cntd.ru/document/902307904', label: 'docs.cntd.ru — ТР ТС 010/2011 «О безопасности машин и оборудования»' },
    ]} />
</BlogArticleLayout>
