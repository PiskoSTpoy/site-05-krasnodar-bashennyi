---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 108. Шестьдесят восьмая статья блога — угол (a) информационный/how-to.
// Ежесменный осмотр башенного крана: что проверяет крановщик до первого подъёма
// и какие интервалы ФНП № 461 задаёт для пути, строп и приспособлений. Не повторяет
// «Ветер и паспорт» (предел ветра из паспорта) и «Строповку грузов» (выбор стропов):
// здесь — график осмотров и кто за какой интервал отвечает.
//
// Фактура — сырой текст ФНП № 461 (legalacts.ru, curl, ред. 16.04.2026),
// проверено 08.10.2026; пункты сверены по тексту:
// - п. 135 а), г): решение о пуске — перед пуском в работу и после ремонта со сваркой
//   или замены расчётных элементов, с записью в паспорте, выдаёт ИТР по производственному контролю;
// - пп. 200, 203, 204: закрепление рельсов, тупиковые упоры на каждой нити, участок стоянки,
//   акт сдачи-приёмки пути после ремонта;
// - пп. 206–208: ежесменный осмотр крановщиком в объёме производственной инструкции;
//   осмотр после каждых 24 смен — крановщик под руководством ИТР;
// - п. 209: плановая проверка пути не реже одного раза в год;
// - п. 210: записи после 24 смен — в паспорт пути или вахтенный журнал крановщика;
//   плановые и внеочередные проверки — актами с паспортами ПС;
// - п. 224: стропы — каждые 10 дней; траверсы, клещи, захваты, тару — каждый месяц;
//   съёмные приспособления, которые реже раза в 10 дней, — перед началом работ.
// Список «что смотреть в смену» — рекомендация КРАН-КУБАНЬ, не норма: ФНП задаёт
// объём через производственную инструкцию, и это явно написано в тексте.

const CHECKED = '8 октября 2026 года';
const PUBLISHED = '2026-10-08';

const title = 'Осмотр башенного крана перед сменой: что проверяют';
const description = 'ФНП № 461 требует ежесменный осмотр рельсового пути, осмотр после каждых 24 смен и проверку строп каждые 10 дней. Кто что проверяет и когда.';
const h1 = 'Что проверяет крановщик перед сменой башенного крана и что записывает';
const crumbTitle = 'Ежесменный осмотр башенного крана';
const slug = 'ezhesmennyi-osmotr-bashennogo-krana';

const H2 = [
  'Ежесменный осмотр рельсового пути: что входит в смену',
  'Периодичность: смена, 24 смены, 10 дней и месяц',
  'Перед пуском: решение и запись в паспорт',
  'Журнал и паспорт: что записывают после осмотра',
  'Стропы и приспособления: осмотр не по смене',
  'Дефект, найденный за смену',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Кто проводит ежесменный осмотр рельсового пути башенного крана?',
    a: 'Крановщик (оператор). Пункт 207 ФНП № 461 возлагает на него осмотр в объёме, который задаёт производственная инструкция эксплуатирующей организации. КРАН-КУБАНЬ предлагает заказчику включить в эту инструкцию перечень из пяти проверок, описанный в статье.',
  },
  {
    q: 'Как часто проверяют рельсовый путь крана?',
    a: 'Каждую смену — крановщиком. После каждых 24 смен работы путь проверяют уже с инженером по пункту 208, а плановая проверка проводится не реже одного раза в год по пункту 209 ФНП № 461.',
  },
  {
    q: 'Как часто осматривают стропы?',
    a: 'Стропы — каждые 10 дней, траверсы, клещи, захваты и тару — каждый месяц, а съёмные приспособления, которые используют реже раза в 10 дней, — перед началом работ. Интервалы задаёт пункт 224 ФНП № 461, осмотр ведёт назначенный инженер.',
  },
  {
    q: 'Нужна ли запись в журнал после каждой смены?',
    a: 'Пункт 207 не требует отдельной записи за каждую смену. Результаты осмотра пути заносят в паспорт рельсового пути или вахтенный журнал крановщика после каждых 24 смен, а плановые проверки оформляют актом (пункт 210).',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Эксплуатация"
  published={PUBLISHED}
>
    <p slot="intro">Ежесменный осмотр рельсового пути башенного крана выполняет крановщик перед работой: так требует пункт 207 ФНП № 461, а объём осмотра задаёт производственная инструкция. Путь после каждых 24 смен проверяют уже с инженером (пункт 208), стропы — каждые 10 дней (пункт 224). КРАН-КУБАНЬ переводит эти сроки в конкретный список для смены.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Крановщик проверяет рельсовый путь каждую смену, а не раз в месяц. Пункт 206 ФНП № 461 включает ежесменный осмотр в состав проверки пути наряду с плановой или внеочередной проверкой, а пункт 207 отдаёт сам осмотр крановщику в объёме производственной инструкции. Поэтому у каждого объекта объём свой, и инструкция фиксирует его заранее, до первого подъёма.</p>
    <p>КРАН-КУБАНЬ предлагает заказчику включить в инструкцию пять проверок, которые опираются на пункты ФНП № 461 и на обычный порядок эксплуатации:</p>
    <ol>
      <li>Рельсы закреплены так, что исключено поперечное и продольное смещение (пункт 200).</li>
      <li>На каждой рельсовой нити установлены тупиковые упоры (пункт 200).</li>
      <li>Участок стоянки крана в нерабочем состоянии свободен и выделен (пункт 204).</li>
      <li>Питающий кабель и кабельный барабан не попадают под колёса; если кабель идёт по земле, на его пути есть лоток (пункт 200).</li>
      <li>На полосе движения нет просадок, провалов и посторонних предметов.</li>
    </ol>
    <p>Перечень КРАН-КУБАНЬ не заменяет инструкцию крана, а дополняет её. Если осмотр показал смещение рельса или отсутствующий упор, КРАН-КУБАНЬ не выводит кран на подъём до устранения дефекта. Готовность пути к работе после ремонта подтверждает акт сдачи-приёмки с результатами планово-высотной съёмки, по пункту 203.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Ежесменный осмотр — самый частый интервал, но не единственный: пункты 208, 209 и 224 ФНП № 461 задают ещё три, и каждый закреплён за своим исполнителем. В таблице они собраны в один график.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Что проверяют</th><th>Периодичность</th><th>Кто проверяет</th><th>Пункт ФНП № 461</th></tr></thead>
      <tbody>
        <tr><td>Рельсовый путь</td><td>каждую смену</td><td>крановщик (оператор)</td><td>206–207</td></tr>
        <tr><td>Рельсовый путь</td><td>после каждых 24 смен работы</td><td>крановщик под руководством ИТР</td><td>208, 210</td></tr>
        <tr><td>Рельсовый путь</td><td>плановая проверка — не реже одного раза в год</td><td>работники по пунктам 207–208</td><td>209</td></tr>
        <tr><td>Стропы</td><td>каждые 10 дней</td><td>назначенный инженер эксплуатирующей организации</td><td>224</td></tr>
        <tr><td>Траверсы, клещи, захваты, тара</td><td>каждый месяц</td><td>то же</td><td>224</td></tr>
        <tr><td>Съёмные приспособления, которые используют реже раза в 10 дней</td><td>перед началом работ</td><td>то же</td><td>224</td></tr>
      </tbody>
    </table></div>
    <p>Интервалы в таблице задают нижнюю границу: пункт 209 говорит «не реже», а частоту проверки строп никто не запрещает делать чаще. Пример с числами для условной стройки: объект работает шесть дней в неделю, одна смена в день, поэтому 24 смены — это четыре недели работы. За месяц крановщик проводит около 26 ежесменных осмотров, инженер по пути — один, стропы проверяют трижды (30 дней делить на 10), траверсы и тару — один раз.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Смена начинается с документов, а не с пуска двигателя. Пункт 135 ФНП № 461, подпункт «а», требует решения о пуске в работу перед пуском: его выдаёт инженерно-техническая работник, ответственный за производственный контроль, и вносит запись в паспорт крана. Решение опирается на положительные результаты технического освидетельствования.</p>
    <p>Тот же пункт 135, подпункт «г», возвращает решение о пуске после замены расчётных элементов или узлов металлоконструкций и после ремонта со сваркой. Поэтому КРАН-КУБАНЬ при возврате крана после такого ремонта не ставит его в смену без новой записи в паспорте, даже если визуально всё в порядке.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Результаты осмотра пути после каждых 24 смен заносят в паспорт рельсового пути или в вахтенный журнал крановщика. Пункт 210 ФНП № 461 требует именно этого, когда на одном пути стоят несколько кранов: запись делают во все их вахтенные журналы.</p>
    <p>Плановые и внеочередные проверки пути оформляют актами, и эти акты хранят вместе с паспортами кранов (пункт 210). Для надземных путей, управляемых с пола, пункт 210 отдельно требует вести журнал осмотра пути. Результаты осмотров таких путей заносят туда после каждых 24 смен работы.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Стропы и съёмные приспособления живут по своему графику. По пункту 224 ФНП № 461 назначенный инженер осматривает стропы каждые 10 дней, траверсы, клещи, захваты и тару — каждый месяц, а приспособления, которые поднимают реже раза в 10 дней, — перед началом работ. Крановщик такой график не заменяет: его визуальный осмотр перед подъёмом задаёт производственная инструкция.</p>
    <p>Для пакетированного груза пункт 224 добавляет отдельную проверку: перед каждой операцией пакет поднимают на 100–200 мм и выдерживают не менее 30 секунд. Если форма пакета и его целостность не изменились, строп признают годным. Подбор стропов по типу груза и углу разобран в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Если осмотр выявил дефект, кран не возвращают в работу до его устранения, а решение о пуске после ремонта оформляет ИТР по пункту 135. Порядок такой: дефект фиксируют в журнале, сообщают инженеру, назначают ремонт, после ремонта принимают решение о пуске с записью в паспорте.</p>
    <p>Пример: на стропе найден порез, и строп выводится из работы. Замену КРАН-КУБАНЬ согласует с инженером объекта и записывает в журнал, а сам подъём с этим стропом не возобновляют до решения. Если дефект касался рельсового пути, работу отложат до акта, который подтверждает ремонт пути по пункту 203.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора № 461 (ФНП), пункты 135, 200, 203–210, 224' },
      { href: 'https://www.consultant.ru/', label: 'consultant.ru — справочная система: ФНП «Правила безопасности опасных производственных объектов, на которых используются подъёмные сооружения»' },
      { href: 'https://kran-kuban.ru/blog/stropovka-gruzov-bashennym-kranom/', label: 'kran-kuban.ru — статья о строповке грузов башенным краном' },
    ]} />
</BlogArticleLayout>
