---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 87. Двадцать вторая статья блога — Кропоткин, второй по величине
// промышленный узел Кавказского района после Армавира (уже разобранного в
// Волне 71), но с другим профилем и, впервые для блога, с подтверждённой
// цитатой сейсмического приложения, которая говорит «расчёт не нужен», а не
// «мы не смогли подтвердить балл».
//
// Экономический слой: АО «КрЭМЗ» (ИНН 2313005410, ОГРН 1022302296411,
// зарегистрировано как АО 2 июня 1994 года, 3-й Промышленный переулок, 3) —
// специализированное машиностроительное предприятие, ведущее историю с
// 1974 года в системе Миннефтегазстроя СССР, выпускает оборудование для
// строительства и ремонта газонефтепроводов (трубоукладчики, трубогибы,
// трубосварочные базы). Второй якорь — ООО «Кубанские масла» (ИНН
// 2364014275, ОГРН 1162364051024, зарегистрировано 15.07.2016, ул. Сетевая,
// 12), маслоэкстракционный завод, 100% которого принадлежит АО «Эфко
// продукты питания»: выручка за 2024 год — 31,7 млрд руб. (+14,6% год к
// году), штат вырос с 423 человек в 2020 году до 956 в 2024-м, мощность —
// до 1,7 тыс. тонн подсолнечника в сутки. Завод приостанавливал работу в
// марте 2025 года из-за рыночной волатильности и просевшего экспортного
// спроса и возобновил её в июле 2025 года. Историю покупки завода
// какой-либо конкретной компанией в конкретном году в статью сознательно
// не включили: WebSearch дал два взаимоисключающих следа (актив ЮНК-
// Агропродукт при банкротстве в открытых источниках назван проданным фирме
// «Агро», тогда как текущий контроль ЭФКО подтверждён свежими 2025-го года
// источниками) — цепочка промежуточных сделок не подтверждена, поэтому
// статья называет только текущего подтверждённого владельца.
//
// Сейсмика — единственный случай блога, где цифра не «не подтверждена», а
// подтверждена и означает «расчёт не требуется»: Приложение Б ТСН 22-302-
// 2000 (тот же источник base.garant.ru, что и в Волне 71 для Армавира) даёт
// для Кропоткина и Тихорецка А-6, а свод правил распространяется только на
// площадки 7 баллов и выше. Прямой повторный WebFetch к base.garant.ru и
// docs.cntd.ru в этой волне снова блокировал сетевой egress — цифра взята
// не из нового запроса, а как уже опубликованный и процитированный на этом
// же сайте факт (см. src/pages/blog/kran-dlya-promzony-armavira/index.astro).

const CHECKED = '14 сентября 2026 года';

const title = 'Кран для Кропоткина: машиностроение, маслозавод и сейсмика, которую можно не считать';
const description = 'Кропоткин — промышленный узел Кавказского района: полувековой завод КрЭМЗ, маслозавод группы «Эфко» и редкий для блога случай, когда сейсмический расчёт основания крана по нормативу не требуется вовсе.';
const h1 = 'Кран для Кропоткина: машиностроение, маслозавод и сейсмика, которую можно не считать';
const crumbTitle = 'Кран для Кропоткина';
const slug = 'kran-dlya-kropotkina';

const H2 = [
  'Кропоткин — промышленный узел на правом берегу Кубани',
  'АО «КрЭМЗ»: полвека машиностроения для газонефтепроводов',
  'Маслозавод «Эфко»: остановка и перезапуск 2025 года',
  'Сейсмика: единственный случай блога, где расчёт можно не делать',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Если сейсмический расчёт не нужен, значит ли это, что монтаж крана в Кропоткине проще и дешевле, чем в Армавире?',
    a: 'Проще — в одной конкретной части проекта: расчёт основания и анкеровки на сейсмическую нагрузку действительно не входит в состав работ, потому что свод правил распространяется только на площадки от 7 баллов, а у Кропоткина — 6. Но сейсмика — не единственный фактор монтажа: несущая способность грунта на конкретной площадке, ветровая нагрузка и паспортный предел техники учитываются в любом случае, независимо от сейсмического балла. Экономия на одном пункте не делает проект монтажа тривиальным в целом.',
  },
  {
    q: 'Кран в Кропоткине нужен только на площадках КрЭМЗ и маслозавода?',
    a: 'Нет. Оба предприятия — крупные и давно действующие, но город живёт не только ими: Кропоткин — крупный железнодорожный узел с сопутствующей инфраструктурой, здесь работают и другие предприятия пищевой промышленности, а сама городская застройка — с населением более 80 тысяч человек — тоже формирует спрос на кран, причём с другими требованиями к технике и графику, чем реконструкция цеха действующего завода.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Кропоткина', item: `${SITE}/blog/kran-dlya-kropotkina/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-kropotkina/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-kropotkina/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал промзону соседнего Армавира — и контринтуитивный факт из Приложения Б ТСН 22-302-2000: расчётная сейсмичность Армавира почти на уровне Сочи, хотя город стоит вдали от моря. Кропоткин — ещё один промышленный узел того же Кавказского района, в 40 с небольшим километрах от Армавира по трассе, — даёт противоположный по знаку, но столь же контринтуитивный случай: по тому же нормативу для этой площадки сейсмический расчёт основания крана можно не делать вовсе. Плюс к этому — два действующих промышленных предприятия совершенно разного профиля, от тяжёлого машиностроения до пищевой переработки.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Город Кропоткин — административный центр Кавказского района, расположен на правом возвышенном берегу реки Кубани, примерно в 136 километрах от Краснодара. Население — более 80 тысяч человек. Город исторически сложился как крупный железнодорожный узел: станция Кавказская, вокруг которой во второй половине XX века вырос современный Кропоткин, до сих пор остаётся одной из ключевых на юге страны. Отдельно от транспортной функции Кропоткин традиционно считается одним из центров пищевой промышленности края — здесь исторически сосредоточены маслоэкстракционные, консервные, молочные и хлебокомбинатные производства. Курортной функции у города нет: спрос на технику формируют промышленность, транспортный узел и обычная городская застройка, а не туристический сезон.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>АО «КрЭМЗ» (ИНН 2313005410, ОГРН 1022302296411, 3-й Промышленный переулок, 3) ведёт историю с 1974 года, когда завод вошёл в систему министерства нефтяной и газовой промышленности СССР (Миннефтегазстроя) как специализированное предприятие по производству оборудования для строительства и ремонта газонефтепроводов; современное акционерное общество зарегистрировано 2 июня 1994 года. Сегодня завод выпускает практически весь спектр техники для прокладки и ремонта трубопроводов — трубоукладчики, трубогибы, дорны, трубогибочные комплексы, трубосварочные базы и станки подготовки кромок труб, — которая поставляется по всей России и в страны ближнего зарубежья.</p>
    <p>Для арендодателя крана такое предприятие — заказчик другого типа, чем НПЗ или агрохолдинг: спрос формируют не столько разовые крупные стройки, сколько регулярная реконструкция и дооснащение производственных корпусов и площадок хранения готовой техники, где важна не столько высота подъёма, сколько манёвренность и грузоподъёмность под конкретную деталь — например, узел трубоукладчика или секцию трубогибочного комплекса.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Второй промышленный якорь Кропоткина — маслоэкстракционный завод, сегодня работающий под именем ООО «Кубанские масла» (ИНН 2364014275, ОГРН 1162364051024, зарегистрировано 15 июля 2016 года, улица Сетевая, 12). Сто процентов компании принадлежит АО «Эфко продукты питания» — одному из крупнейших российских производителей растительных масел. По открытым реестровым данным, выручка предприятия за 2024 год составила 31,7 миллиарда рублей, что на 4,1 миллиарда, или 14,6%, больше показателя годом ранее, а штат за пять лет вырос почти вдвое — с 423 человек в 2020 году до 956 в 2024-м. Производственная мощность площадки — до 1,7 тысячи тонн подсолнечника в сутки.</p>
    <p>2025 год завод прошёл не гладко: в марте предприятие временно приостановило работу из-за высокой волатильности рынка и просевшего экспортного спроса, а в июле того же года возобновило её вместе с однопрофильным заводом группы в Тбилисской. Для площадки такого масштаба остановка и последующий перезапуск обычно сопровождаются ремонтом и дооснащением линий — а значит, и предметным, хоть и не всегда заметным со стороны, спросом на технику для монтажных и погрузочных работ на территории завода.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>В статье про промзону Армавира уже приводилась цитата Приложения Б к территориальным строительным нормам ТСН 22-302-2000 (СНКК 22-301-2000) «Строительство в сейсмических районах Краснодарского края»: расчётная сейсмичность Армавира — А-8/В-9/С-9, почти на уровне Сочи, тогда как у географически более близких к Армавиру Кропоткина и Тихорецка — А-6. Это не опечатка и не совпадение: свод правил требует расчёта на сейсмическую нагрузку только для площадок сейсмичностью 7 баллов и выше, а значит, для стандартной площадки в Кропоткине такой расчёт нормативно не требуется вовсе — в отличие от Армавира, Сочи, Новороссийска, Краснодара и большинства других городов, уже разобранных в этом блоге.</p>
    <p>Разница объясняется не расстоянием до моря, а близостью к зоне активных разломов предгорий Кавказа: сейсмическая опасность в крае растёт не линейно с широтой, а по конкретным геологическим структурам, и Армавир географически ближе к этой зоне, чем степной Кропоткин северо-восточнее него. Это не значит, что при монтаже крана в Кропоткине изыскания можно пропустить целиком: несущая способность конкретного грунта на берегу Кубани и ветровая нагрузка по-прежнему требуют отдельного расчёта, отменяется только сейсмическая часть. Как читать саму таблицу баллов — в разделах «Площадка 8 баллов» и «Площадка 9 баллов».</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Кропоткине так же, как в Сочи или Краснодаре: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дневным перерывом, а ответственность по статье 3.3 одинакова для всего края независимо от того, идёт ли речь о территории завода на окраине или о жилой застройке в центре города. Подробный разбор часов и сумм штрафов — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Кропоткин — промышленный и железнодорожный узел Кавказского района на правом берегу Кубани, без курортной функции, в 40 с небольшим километрах от уже разобранного Армавира.</li>
      <li>АО «КрЭМЗ» (ИНН 2313005410) выпускает оборудование для строительства и ремонта газонефтепроводов с 1974 года — заказчик с регулярным, а не разовым спросом на технику.</li>
      <li>ООО «Кубанские масла» (ИНН 2364014275, 100% — АО «Эфко продукты питания») — маслозавод мощностью до 1,7 тыс. тонн подсолнечника в сутки, приостанавливал работу в марте 2025 года и возобновил её в июле 2025-го.</li>
      <li>По Приложению Б ТСН 22-302-2000 сейсмичность Кропоткина и Тихорецка — А-6, ниже порога в 7 баллов, с которого свод правил вообще требует сейсмического расчёта основания — редкий для блога случай подтверждённой, а не отсутствующей цифры.</li>
      <li>Закон о тишине №608-КЗ действует в Кропоткине так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.rusprofile.ru/id/1500460', label: 'rusprofile.ru — АО «КрЭМЗ», ИНН 2313005410, дата регистрации, адрес' },
      { href: 'https://en.runeft.ru/enterprise/izolyatsiya/kropotkinskiy_mashinostroitelnyy_zavod_oao.htm', label: 'runeft.ru — история завода КрЭМЗ с 1974 года, выпускаемая продукция' },
      { href: 'https://checko.ru/company/kubanskie-masla-1162364051024', label: 'checko.ru — ООО «Кубанские масла», ИНН 2364014275: владелец, выручка 2024 года, штат' },
      { href: 'https://www.kommersant.ru/doc/7587793', label: 'kommersant.ru — «ЭФКО» приостановила работу маслоэкстракционных заводов на Кубани (март 2025)' },
      { href: 'https://www.kommersant.ru/doc/7891544', label: 'kommersant.ru — ГК «Эфко» возобновила работу маслоэкстракционных заводов на Кубани (июль 2025)' },
      { href: 'https://base.garant.ru/23972997/948c9c0734b6e944a4727660f2d5a027/', label: 'base.garant.ru — Приложение Б к ТСН 22-302-2000: Кропоткин и Тихорецк А-6' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
