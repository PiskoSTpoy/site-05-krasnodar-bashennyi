---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 107. Шестьдесят седьмая статья блога — угол (a) информационный/how-to.
// Ветер и паспорт башенного крана: где в документах записан предел и кто
// останавливает работу. Не повторяет «Кран во время норд-оста» (порядок действий
// в шторм) и «Приборы безопасности» (устройство анемометра): здесь — бумаги и
// пункты ФНП, которые связывают паспорт, ППР и остановку.
//
// Фактура — сырой текст ФНП № 461 (legalacts.ru, curl, ред. 16.04.2026),
// проверено 07.10.2026; пункты сверены по тексту, не по пересказам:
// - п. 9 (в): соответствие нагрузкам от ветра «для ветрового района установки»;
//   если в паспорте нет записи о ветровом районе и сейсмичности, изготовитель
//   может подтвердить расчётами;
// - п. 122: нерабочее ПС обесточено, приняты меры против угона ветром;
// - п. 132: работы ПС на открытом воздухе прекращают при скорости ветра выше
//   предельно допустимой по паспорту (+ температура, осадки, плохая видимость);
// - пп. 155–156: ПОС и ППР предусматривают соответствие ПС ветровой нагрузке и
//   сейсмичности района; п. 156 — недопустимость работ на высоте при ветре выше
//   паспортных значений;
// - п. 159 (ж): в ППР и ТК — выписка из паспорта о силе ветра, при которой
//   работа не допускается;
// - п. 241 (а): люльки (кабины) с людьми — запрещены при ветре выше 10 м/с;
// - пп. 259 (т), 267: проверка сигнализатора предельной скорости ветра
//   (анемометра) — по руководству по эксплуатации.
// Числа предела для моделей парка НЕ приводятся — они в паспорте конкретного
// крана; общий порог не называется (в тексте ФНП его нет, кроме п. 241).

const CHECKED = '7 октября 2026 года';
const PUBLISHED = '2026-10-07';

const title = 'Ветер и паспорт башенного крана: где записан предел';
const description = 'Предел ветра для башенного крана берут из паспорта, а не из общей цифры: ФНП № 461 требует его выписку в ППР. Какие пункты и кто останавливает работу.';
const h1 = 'При какой скорости ветра башенный кран прекращает работу и где это записано';
const crumbTitle = 'Ветер и паспорт башенного крана';
const slug = 'veter-i-pasport-bashennogo-krana';

const H2 = [
  'Предельная скорость ветра записана в паспорте крана',
  'Выписка из паспорта в проекте производства работ',
  'Кто и когда останавливает работу крана',
  'Анемометр и проверка сигнализатора ветра',
  'Что делают с краном, когда он стоит без работы',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'При какой скорости ветра башенный кран прекращает работу?',
    a: 'Работу прекращают при скорости ветра выше предельно допустимой, указанной в паспорте крана: так сказано в пункте 132 ФНП № 461. Общей цифры для всех кранов в этом пункте нет, поэтому КРАН-КУБАНЬ берёт предел из паспорта конкретной модели парка и выписывает его в проект производства работ.',
  },
  {
    q: 'Где записана предельная скорость ветра для моего крана?',
    a: 'В паспорте крана и в выписке из него, которую по пункту 159 ФНП № 461 включают в проект производства работ и технологические карты. Для КРАН-КУБАНЬ это означает, что предел у Potain MDT 219 J10, КБ-408.21 и giraFFe SMK-5.66 свой, и переносить цифру с одной модели на другую нельзя.',
  },
  {
    q: 'Кто имеет право остановить кран из-за ветра?',
    a: 'Остановить работу при превышении паспортного предела обязаны ответственные за безопасное производство работ, и крановщик тоже может не начинать движение. ФНП № 461 не называет для ветра отдельную должность, поэтому КРАН-КУБАНЬ закрепляет в проекте производства работ, кто даёт команду «стоп» и кто её фиксирует.',
  },
  {
    q: 'Что такое сигнализатор предельной скорости ветра?',
    a: 'Это анемометр с сигнализацией: прибор подаёт сигнал, когда скорость ветра достигает значения из паспорта крана. Пункты 259 и 267 ФНП № 461 требуют проверять его работоспособность по руководству по эксплуатации. На кранах КРАН-КУБАНЬ исправность прибора входит в проверку перед сменой.',
  },
  {
    q: 'Можно ли поднимать людей в люльке на башенном кране при сильном ветре?',
    a: 'Нет, пункт 241 ФНП № 461 запрещает использовать люльки с людьми при ветре сильнее 10 м/с, при плохой видимости и обледенении. Это отдельный и более жёсткий порог, чем предел для обычных грузов: люльку КРАН-КУБАНЬ при таких условиях не поднимает.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Безопасность"
  published={PUBLISHED}
>
    <p slot="intro">Пункт 132 ФНП № 461 требует прекращать работу башенного крана на открытом воздухе, когда скорость ветра выше предельно допустимой по паспорту, — единого числа для всех кранов закон не называет. КРАН-КУБАНЬ берёт предел из паспорта конкретной модели, выписывает его в проект производства работ и проверяет сигнализатор ветра перед сменой.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Предел ветра для башенного крана — паспортная характеристика, а не общая норма. Пункт 132 ФНП № 461 связывает остановку работ именно с «предельно допустимой скоростью, указанной в паспорте», и добавляет другие причины: температура ниже паспортной, снегопад, дождь, туман, когда крановщик плохо различает сигналы стропальщика или груз. Поэтому КРАН-КУБАНЬ не пользуется «круглой» цифрой, а открывает паспорт той модели, которая стоит на объекте.</p>
    <p>Предел зависит от конструкции: у Potain MDT 219 J10 с вылетом 65 м, КБ-408.21 с оголовком и giraFFe SMK-5.66 с опорным контуром 4×4 м он разный, и переносить значение между моделями нельзя. Пункт 9 ФНП № 461 дополнительно требует, чтобы кран соответствовал нагрузкам от ветра «для ветрового района установки». Если в паспорте нет записи о ветровом районе, изготовитель может подтвердить соответствие расчётами. Как ветер ведёт себя в крае, разобрано в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Выписка из паспорта о силе ветра, при которой работа крана не допускается, — обязательный элемент проекта производства работ. Пункт 159 ФНП № 461 (подпункт «ж») прямо включает её в раздел о безопасном производстве работ с подъёмными сооружениями. Пункты 155 и 156 дополняют: проект организации строительства и ППР обязаны подтвердить соответствие крана ветровой нагрузке и сейсмичности района установки.</p>
    <p>Для КРАН-КУБАНЬ это превращается в конкретный лист в ППР: модель, предельная скорость из паспорта, кто и чем её контролирует, что делать при достижении предела. Пункт 156 ФНП № 461 отдельно требует указать недопустимость работ на высоте в открытых местах при ветре выше паспортных значений, при гололёде, грозе и плохой видимости. Как составляют сам проект и из чего он состоит — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Работу КРАН-КУБАНЬ останавливает по превышению паспортного предела или по сигналу прибора, не дожидаясь визуальных признаков бури. ФНП № 461 не называет отдельную должность, которая «выключает» кран по ветру, поэтому порядок записывают в проекте производства работ: кто следит за показаниями анемометра, кто даёт команду прекратить подъём и кто отмечает это в журнале.</p>
    <p>Практическое правило КРАН-КУБАНЬ простое: если сигнализатор сработал, груз опускают, стрелу ставят во флюгерное положение по инструкции модели, а новые подъёмы не начинают. Крановщик имеет право не начинать движение при сомнении, а стропальщик — потребовать остановки, как описано в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>. Парусный груз — лист, панель, кровельный материал — реагирует на ветер раньше самого крана, и это учитывают при планировании подъёма.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Сигнализатор предельной скорости ветра (анемометр) — прибор безопасности, который подаёт сигнал при достижении значения из паспорта. Пункт 259 ФНП № 461 (подпункт «т») включает его в проверки работоспособности при техническом диагностировании, а пункт 267 отсылает к руководству по эксплуатации прибора и указателя угла наклона. Для КРАН-КУБАНЬ это означает: работоспособность проверяют в сроки и способом, которые указал изготовитель.</p>
    <p>Результаты проверок оформляют актом, который по пункту 269 является приложением к паспорту крана. Устройство приборов безопасности — какие бывают и что регистрирует прибор — разобрано в статье <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>. Неисправный анемометр на кране КРАН-КУБАНЬ считается основанием не начинать работу, пока прибор не заменят или не проверят.</p>
    <p>Особый случай — подъём людей. Пункт 241 ФНП № 461 запрещает использовать люльки (кабины) при ветре выше 10 м/с, плохой видимости и обледенении. Это единственный числовой порог по ветру в тексте, и относится он только к люльке с людьми. Для обычных грузов по-прежнему действует паспортный предел.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Пункт 122 ФНП № 461 требует, чтобы смонтированный кран в нерабочем состоянии был обесточен и защищён от угона ветром. Для КРАН-КУБАНЬ это значит: на ночь и на выходные кран ставят в положение, указанное в инструкции модели, отключают питание и затягивают противоугонные захваты на рельсовом пути. Противоугонные устройства входят в перечень проверок по пункту 259 (подпункт «у»).</p>
    <p>Нерабочее состояние — самое нагруженное для башенного крана: стрела стоит без груза, но площадь, на которую давит ветер, остаётся. Правила постановки в нерабочее положение для КБ-408.21 на рельсах и для giraFFe SMK-5.66 с опорным контуром различаются, и КРАН-КУБАНЬ выдаёт их в инструкции на объект. Если прогноз обещает сильный ветер, бригаду предупреждают заранее — адрес и модель можно уточнить через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора № 461 (ФНП), пункты 9, 122, 132, 155–156, 159, 241, 259, 267, 269' },
      { href: 'https://www.consultant.ru/', label: 'consultant.ru — справочная система: ФНП «Правила безопасности опасных производственных объектов, на которых используются подъёмные сооружения»' },
      { href: 'https://kran-kuban.ru/blog/pribory-bezopasnosti-bashennogo-krana/', label: 'kran-kuban.ru — статья о приборах безопасности башенного крана' },
    ]} />
</BlogArticleLayout>
