---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 22 (расширение блога). Третья статья блога и второй новый материал этой
// волны. Тема — прямое расширение зоны, закреплённой за этим сайтом в TOPIC-REGISTRY.md
// («Закон о тишине Краснодарского края №608-КЗ и шумовые ограничения курортной
// зоны»): существующая статья /blog/seysmika-i-zakon-o-tishine/ и этап
// /etapy/ekspluatatsiya-i-tishina/ разбирают ТОЛЬКО время работ (часы и окна).
// Ни на одной странице сайта нет ни слова про уровень шума в децибелах — это
// отдельный, независимый регуляторный слой (СанПиН вместо административного
// закона края), проверено grep-ом по всему src/ перед началом (0 совпадений
// «децибел», «СанПиН», «дБ»). Не пересказ существующей статьи, а её недостающая
// вторая половина: время vs громкость — два разных требования с разными
// проверяющими и разными штрафами.

const CHECKED = '15 августа 2026 года';

const title = 'Уровень шума в децибелах: второе требование закона о тишине';
const description = 'Закон №608-КЗ регулирует часы работы. Отдельно действуют нормы шума в децибелах (СанПиН 1.2.3685-21) — другой порог, другая проверка, своя статья КоАП.';
const h1 = 'Уровень шума в децибелах: второе требование, о котором молчит закон о тишине';
const crumbTitle = 'Уровень шума в децибелах';
const slug = 'uroven-shuma-v-decibelah';

// Волна 33 (GEO). Таблица не приносит новых фактов: это свод того, что уже
// сказано прозой в разделах «Два требования, а не одно», «Кто измеряет» и
// «Ответственность» — время vs громкость по шести осям сравнения. Модели
// извлекают таблицу охотнее сплошного текста, а читателю она даёт то же
// сравнение одним взглядом.
const twoRules = [
  { axis: 'Что регулирует', law: 'Время: когда шумные работы разрешены', sanpin: 'Громкость: какой уровень звука допустим' },
  { axis: 'Документ', law: 'Ст. 3.3 закона Краснодарского края №608-КЗ (ред. №5423-КЗ, с 01.03.2026)', sanpin: 'СанПиН 1.2.3685-21, таблица 5.35 (постановление №2 от 28.01.2021)' },
  { axis: 'Как действует во времени', law: 'Окна 08:00–13:00 и 15:00–23:00 в будни, 10:00–13:00 и 15:00–23:00 в выходные', sanpin: 'Круглосуточно, два порога: день 07:00–23:00 и ночь 23:00–07:00, без обеденного перерыва' },
  { axis: 'Чем доказывается нарушение', law: 'Фактом времени — свидетельскими показаниями или записью', sanpin: 'Инструментальным замером шумомером по МУК 4.3.3722-21 с оформлением акта' },
  { axis: 'Статья ответственности', law: 'Ст. 3.3 закона края №608-КЗ', sanpin: 'Ст. 6.3 КоАП РФ' },
  { axis: 'Санкция для юридического лица', law: '20 000 – 30 000 ₽', sanpin: '10 000 – 20 000 ₽ либо приостановление деятельности до 90 суток' },
];

const H2 = [
  'Два требования, а не одно',
  'Что регулирует закон о тишине — и что не регулирует',
  'Санитарные нормы шума: другой документ, другие цифры',
  'Кто измеряет и как это выглядит на практике',
  'Ответственность — тоже отдельная, не по статье 3.3',
  'Что это значит для площадки с краном',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Если мы укладываемся в рабочие окна закона о тишине, можно не думать про децибелы?',
    a: 'Нет, это два независимых требования. Закон №608-КЗ отвечает только на вопрос «когда можно шуметь», а санитарные нормы — на вопрос «насколько громко». Работы, начатые строго в 08:00, всё равно должны укладываться в допустимый уровень звука на территории жилой застройки — превышение фиксируется отдельно и по другой статье КоАП.',
  },
  {
    q: 'Кто вправе замерить шум на стройплощадке и предъявить претензию?',
    a: 'Официально зафиксировать превышение может специалист территориального органа Роспотребнадзора или аккредитованной лаборатории — по методике МУК 4.3.3722-21, с составлением акта измерений. Устная жалоба соседей или отдыхающих сама по себе не доказательство: без инструментального замера и акта привлечь к ответственности по санитарной норме нельзя, в отличие от нарушения часов работы, которое фиксируется по факту времени.',
  },
];

const SITE = 'https://kran-kuban.example';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Уровень шума в децибелах', item: `${SITE}/blog/uroven-shuma-v-decibelah/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/uroven-shuma-v-decibelah/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/uroven-shuma-v-decibelah/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Статья <a href="/blog/seysmika-i-zakon-o-tishine/" style="color:var(--accent)">«Сейсмика и закон о тишине на Кубани»</a> и этап <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a> подробно разбирают закон Краснодарского края №608-КЗ — во сколько можно и нельзя вести шумные работы. Это необходимое, но не единственное требование. Параллельно с ним действует другой документ, который отвечает не на вопрос «когда», а на вопрос «насколько громко» — и про него на площадке вспоминают заметно реже, обычно уже после жалобы.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Строительная площадка в курортной зоне края подчиняется одновременно двум разным по природе требованиям. Первое — административное: закон края №608-КЗ определяет часы, в которые запрещены шумные работы, независимо от их фактической громкости. Нарушение фиксируется по факту времени: техника работала в 22:50, значит, есть состав правонарушения, и не важно, был ли шум еле слышен или гремел на всю улицу.</p>
    <p>Второе требование — санитарное: гигиенические нормативы устанавливают предельно допустимый уровень звука в децибелах на территории жилой застройки и внутри жилых помещений, причём круглосуточно, без разбивки на «разрешённые окна». Здесь наоборот: неважно, что работы идут строго с 15:00 до 23:00, как и положено по закону о тишине, — если фактический уровень звука на границе соседнего участка выше норматива, это отдельное нарушение по отдельному документу. Оба требования применяются параллельно и независимо: соблюдение одного не освобождает от другого.</p>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Закон о тишине и санитарный норматив шума: чем два требования отличаются</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Ось сравнения</th><th scope="col" role="columnheader">Закон края №608-КЗ</th><th scope="col" role="columnheader">СанПиН 1.2.3685-21</th></tr>
        </thead>
        <tbody>
          {twoRules.map((r) => (
            <tr role="row"><th scope="row" role="rowheader">{r.axis}</th><td role="cell" data-label="Закон края №608-КЗ">{r.law}</td><td role="cell" data-label="СанПиН 1.2.3685-21">{r.sanpin}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">Строчки таблицы дальше разобраны по отдельности — но уже из неё видно главное: пересечения между двумя колонками нет ни по одной оси, кроме самой площадки.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Статья 3.3 закона №608-КЗ, разобранная в статье о сейсмике и в этапе эксплуатации, называет земляные, строительные и погрузочно-разгрузочные работы с применением механических средств и задаёт для них временные окна — с 1 марта 2026 года это 08:00–13:00 и 15:00–23:00 в будни, 10:00–13:00 и 15:00–23:00 в выходные и праздники. Документ ни разу не упоминает децибелы, шумомеры или предельные уровни звука: это чисто временной регламент, устроенный по принципу «в это время можно, в это нельзя», и штрафует он именно за факт работы вне окна.</p>
    <p>Из этого иногда делают неверный вывод: раз закон о тишине — единственный найденный на первый взгляд документ про шум на площадке, значит, соблюдение его часов закрывает тему целиком. Это не так же, как считать, что паспортный лимит скорости ветра для крана и расчёт на сейсмическую нагрузку — одно и то же требование, потому что оба «про устойчивость». У временного и у санитарного регулирования шума разные предметы, разные измерители и разные проверяющие органы.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Действующий санитарный норматив — СанПиН 1.2.3685-21 «Гигиенические нормативы и требования к обеспечению безопасности и (или) безвредности для человека факторов среды обитания», утверждённый постановлением Главного государственного санитарного врача РФ от 28.01.2021 №2 и зарегистрированный в Минюсте 29.01.2021 за №62296. Таблица 5.35 этого документа задаёт нормируемые параметры шума — эквивалентные и максимальные уровни звука — отдельно для помещений жилых и общественных зданий и отдельно для шума на селитебной (жилой) территории. Документ действует по всей стране одинаково, но именно потому, что до этой статьи на сайте про него не было сказано ни слова, разбираем его здесь — как вторую половину темы «шум и стройка», которую первая статья закономерно оставила за кадром, сосредоточившись на региональном законе.</p>
    <p>Логика нормирования простая и симметрична часовому делению закона о тишине, но измеряется в других единицах: для территории, непосредственно прилегающей к жилым домам, действуют более высокие пороги, чем внутри самих квартир, и дневной порог всегда выше ночного. Дневное время (07:00–23:00) и ночное (23:00–07:00) в санитарной норме почти совпадают по границам с окнами закона №608-КЗ — но дальше документы расходятся: закон о тишине внутри дневного интервала вырезает ещё и двухчасовой обеденный перерыв, а санитарная норма никакого перерыва не знает и действует все шестнадцать дневных часов подряд одним порогом.</p>
    <p>Прежним ориентиром служил СанПиН 2.1.2.2645-10, где для территории, непосредственно прилегающей к жилым домам, были заданы уровни 55 дБ днём и 45 дБ ночью, а для более широкой прилегающей территории — до 70 дБ днём и 60 дБ ночью. СанПиН 1.2.3685-21 объединил гигиенические нормативы в один документ и сохранил эту же логику двух порогов — более строгого около самого фасада и более мягкого на территории застройки в целом. Для ориентира по громкости: разговорная речь на расстоянии метра — это около 60 дБ, а свая, забиваемая копром, — около 90 дБ; шкала логарифмическая, и каждые дополнительные 10 дБ воспринимаются ухом примерно как удвоение громкости, а не как равномерный шаг.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Разница между двумя требованиями видна уже в том, как каждое из них фиксируется. Нарушение закона о тишине доказывается фактом времени: достаточно зафиксировать, что механизированные работы велись в запрещённый час, — свидетельских показаний или записи с телефона обычно достаточно для составления протокола. Нарушение санитарного норматива по шуму доказывается иначе: нужен инструментальный замер шумомером, выполненный по методике действующих методических указаний МУК 4.3.3722-21 «Контроль уровня шума на территории жилой застройки, в жилых и общественных зданиях и помещениях», утверждённых Роспотребнадзором 27.12.2021 взамен более раннего МУК 4.3.2194-07. Методика задаёт, где ставить точку измерения, сколько длится замер, как учитывать посторонние источники шума и как оформляется акт.</p>
    <p>Практически это означает, что жалобу на превышение уровня шума не закрывают протоколом на месте, как это бывает с нарушением часов работы: территориальный орган Роспотребнадзора или аккредитованная лаборатория выезжает с поверенным прибором, проводит замер по правилам методики и оформляет акт, который и становится основанием для дальнейших действий. Это дольше и формальнее, чем фиксация времени, но именно акт замера — единственное, что превращает жалобу в доказанное нарушение с точки зрения санитарного законодательства.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Штрафы за нарушение закона №608-КЗ — по статье 3.3 регионального закона об административных правонарушениях, они уже приведены в статье о сейсмике: для юридических лиц 20 000–30 000 рублей. Превышение же санитарного норматива шума квалифицируется по совсем другой норме — статье 6.3 КоАП РФ «Нарушение законодательства в области обеспечения санитарно-эпидемиологического благополучия населения»: по части 1 для юридических лиц предусмотрен штраф 10 000–20 000 рублей либо административное приостановление деятельности на срок до 90 суток, а при повторном или отягчённом нарушении санкции по этой же статье вырастают на порядок. Приостановление деятельности на площадке, где работает арендованный кран простоем в 90 суток, — несопоставимо более тяжёлое последствие, чем разовый штраф за час работы за пределами окна.</p>
    <p>Это две отдельные статьи, два отдельных производства и, в теории, два отдельных штрафа за одну и ту же смену: можно нарушить только часы, только уровень звука, оба требования сразу или ни одного. Смешивать их в один пункт сметы рисков — значит недооценивать именно санитарную часть, потому что она наступает реже, но обходится дороже.</p>

    <h2 id={headings[5].id} style="margin:36px 0 18px">{headings[5].text}</h2>
    <p>Для площадки, где работает башенный кран, источник шума — не только сама машина: значительная часть акустической нагрузки на курортной стройке приходится на сопутствующие операции монтажа и общестроительные работы — забивку свай, работу бетононасосов, разгрузку металлоконструкций, звуковые сигналы техники при манёврах. Сам башенный кран в установившемся режиме подъёма относительно тихий по сравнению с этими операциями, но их обычно ведут одновременно с ним и в те же часы.</p>
    <p>Практический вывод для графика работ на объекте в плотной курортной застройке — рядом с отелем, санаторием или жилым домом — тот же принцип, что и в статье про грунт и ветер: параметр площадки узнают заранее, а не по факту жалобы. Если объект стоит вплотную к жилой или гостиничной застройке, для самых громких операций (сваебойные и другие ударные работы, резка металла без шумоизолирующего кожуха) стоит заранее сверяться не только с расписанием закона о тишине, но и с тем, какой уровень звука реально создаёт площадка на границе соседнего участка — и при необходимости переносить именно эти операции на середину разрешённого окна, а не на его край, оставляя запас по обоим требованиям сразу.</p>

    <h2 id={headings[6].id} style="margin:36px 0 18px">{headings[6].text}</h2>
    <ul>
      <li>Закон края №608-КЗ регулирует ВРЕМЯ шумных работ (окна 08:00–13:00 и 15:00–23:00 в будни) — это административное требование со штрафом по статье 3.3, до 20 000–30 000 ₽ для юрлица.</li>
      <li>СанПиН 1.2.3685-21 (таблица 5.35) отдельно регулирует УРОВЕНЬ звука в децибелах на территории жилой застройки и в помещениях — круглосуточно, без обеденного перерыва закона о тишине.</li>
      <li>Соблюдение часов работы не освобождает от санитарного норматива по громкости, и наоборот — это два независимых требования с разными проверяющими.</li>
      <li>Нарушение часов доказывается фактом времени; превышение уровня шума — только инструментальным замером по методике МУК 4.3.3722-21 с оформлением акта.</li>
      <li>Ответственность за превышение уровня шума — по статье 6.3 КоАП РФ: для юрлиц 10 000–20 000 ₽ либо приостановление деятельности до 90 суток — тяжелее по последствиям, чем штраф по 608-КЗ.</li>
      <li>На площадке рядом с плотной курортной застройкой основной вклад в шум обычно дают сопутствующие операции монтажа, а не сам кран в установившемся режиме подъёма.</li>
    </ul>
    <p>Документальная сторона монтажа в целом — что оформляется на площадке и как в неё попадает график работ — собрана в разделе <a href="/documents/" style="color:var(--accent)">«Документы монтажа башенного крана»</a>, а расчёт основания под сейсмическую нагрузку, который решается на том же этапе, что и организация шумных работ, — в разделе <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны края»</a>.</p>

