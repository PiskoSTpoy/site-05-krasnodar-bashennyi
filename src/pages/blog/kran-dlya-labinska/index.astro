---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 97. Тридцать седьмая статья блога — угол (c) практический/
// региональный. Лабинск — город в предгорьях на Лабе между уже разобранными
// Армавиром (Волна 71) и Мостовским районом (Волна 75), но сам в блоге не
// был. Отличие от соседей: не курортная и не металлургическая тема, а
// средний город с пищевой промышленностью и среднеэтажным жильём, где выбор
// между быстромонтируемым и классическим краном решается на 8 этажах.
//
// Фактура (WebFetch 26.09.2026):
// - ru.wikipedia.org «Лабинск»: 55 434 жит. (2025); правый берег Лабы, в
//   предгорьях Главного Кавказского хребта, 180 км к юго-востоку от
//   Краснодара; станица Лабинская основана в 1841 г., город с 23.10.1947;
//   курорт местного значения с 1997 г.; предприятия по перечню Википедии
//   (маслоэкстракционный завод, «Сыродел», элеватор, хлебозавод).
// - domostroyrf.ru: ЖК «Первый», ул. Калинина, 309 — 8 этажей, 80 квартир,
//   2 секции, застройщик «ВКБ-Новостройки» (ООО СЗ АПСК-ИНВЕСТ), сроки
//   3 кв. 2024 — 4 кв. 2025, «все квартиры проданы».
// - kuban24.tv, 12.08.2026: ремонт трассы Лабинск — Мостовской — граница
//   КЧР, участок 5,3 км между ст. Зассовской и пос. Мостовским, завершение
//   в октябре 2026, нацпроект «Инфраструктура для жизни».
// Отклонено: invest-labinsk.ru (новость про «инвестплощадку 57,3 млн») —
// текст страницы внутренне противоречив, как источник не используем.
// Балл сейсмичности Лабинска не называем (конвенция сайта с Волны 79).
// Закон №608-КЗ — окна из опубликованных страниц сайта (kommersant.ru).

const CHECKED = '26 сентября 2026 года';
const PUBLISHED = '2026-09-26';

const title = 'Кран для Лабинска: башенный кран в предгорьях на Лабе';
const description = 'Башенный кран в Лабинске: восьмиэтажное жильё и пищевые заводы, 180 км от Краснодара, грунт у Лабы, сейсмичность площадки по ТСН 22-302-2000 и закон о тишине.';
const h1 = 'Кран для Лабинска: какой башенный кран нужен в предгорном городе на Лабе';
const crumbTitle = 'Кран для Лабинска';
const slug = 'kran-dlya-labinska';

const H2 = [
  'Лабинск: предгорный город в 180 км от Краснодара',
  'Что строят в Лабинске и какие объекты требуют крана',
  'Какой кран нужен под восьмиэтажный дом',
  'Перебазировка крана в Лабинск: 180 км и дорога на Мостовской',
  'Грунт у Лабы: изыскания под основание крана',
  'Сейсмичность площадки в Лабинске: откуда берут балл',
  'Закон о тишине в Лабинске',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой башенный кран нужен для восьмиэтажного дома в Лабинске?',
    a: 'Для восьмиэтажного дома, как ЖК «Первый» на улице Калинина, решают высота крюка и вылет. Если высота крюка с запасом и строповкой укладывается в 41,7 м при нужном вылете, хватает быстромонтируемого giraFFe SMK-5.66; если нет — КРАН-КУБАНЬ предлагает КБ-408.21 или Potain MCH 175. Точный выбор делают по генплану и массам грузов.',
  },
  {
    q: 'Какая сейсмичность в Лабинске для строительства?',
    a: 'Надёжного первоисточника с баллом для площадок Лабинска мы не нашли, поэтому число не называем. Расчётный балл определяют по СП 14.13330.2018 и краевым ТСН 22-302-2000 с учётом уровня ответственности объекта и грунта, при необходимости — по сейсмическому микрорайонированию. Инженерная служба КРАН-КУБАНЬ считает основание крана от балла, указанного в проекте.',
  },
  {
    q: 'Действует ли закон о тишине в Лабинске?',
    a: 'Да, закон Краснодарского края №608-КЗ действует во всём крае, включая Лабинск. Шумные строительные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ на жилой площадке это 13 рабочих часов в будни.',
  },
  {
    q: 'Сколько ехать башенному крану из Краснодара в Лабинск?',
    a: 'Лабинск лежит в 180 км к юго-востоку от Краснодара, и перебазировка башенного крана КРАН-КУБАНЬ идёт негабаритным автотранспортом. Время в пути зависит от маршрута, разрешений на перевозку и ограничений на трассе. Классический кран везут секциями и монтируют автокраном по ППР, а giraFFe SMK-5.66 разворачивается собственными механизмами с одним автокраном 25 т.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
  about: { '@type': 'City', name: 'Лабинск' },
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Лабинский район"
  published={PUBLISHED}
>
    <p slot="intro">Лабинск — город на 55 тысяч жителей в предгорьях Главного Кавказского хребта, в 180 км к юго-востоку от Краснодара, и типичный башенный объект здесь — восьмиэтажный жилой дом. На такой высоте выбор крана КРАН-КУБАНЬ проходит по границе между быстромонтируемым giraFFe SMK-5.66 и классическим КБ-408.21. К выбору добавляются три местных условия: грунт на берегу Лабы, расчётная сейсмичность площадки по ТСН 22-302-2000 и окна закона Краснодарского края №608-КЗ.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Лабинск стоит на правом берегу реки Лабы, в предгорьях Главного Кавказского хребта, в 180 км к юго-востоку от Краснодара. По данным Википедии, в 2025 году в городе жили 55 434 человека. Станица Лабинская основана в 1841 году, статус города получила 23 октября 1947 года, а с 1997 года Лабинск — курорт местного значения.</p>
    <p>Для КРАН-КУБАНЬ Лабинск — южная точка между двумя уже разобранными соседями: промышленным Армавиром на севере и горным Мостовским районом на юге. Особенности соседей — в статьях <a href="/blog/kran-dlya-promzony-armavira/">«Кран для промзоны Армавира»</a> и <a href="/blog/kran-dlya-mostovskogo-rayona/">«Кран для Мостовского района»</a>. Сам Лабинск отличается от них масштабом: средний город, где стройка — это среднеэтажное жильё и пищевые предприятия, а не высотки и не курорты.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Жилая стройка Лабинска — среднеэтажная: ЖК «Первый» на улице Калинина, 309 — восьмиэтажный дом на 80 квартир в двух секциях, который «ВКБ-Новостройки» строили с третьего квартала 2024 по четвёртый квартал 2025 года. По данным агрегатора новостроек, все квартиры в нём проданы. Для башенного крана КРАН-КУБАНЬ это ориентир по масштабу типичного жилого объекта города.</p>
    <p>Промышленность Лабинска по перечню Википедии — пищевая и перерабатывающая: маслоэкстракционный завод, «Сыродел», элеватор и хлебозавод. Реконструкция цехов и строительство складов на таких площадках — задачи для крана КРАН-КУБАНЬ с широким вылетом, а не с большой высотой. Одноэтажный корпус с пролётом перекрывает giraFFe SMK-5.66 с вылетом до 43 м; тяжёлое технологическое оборудование требует классического крана с 10 т грузоподъёмности.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Восьмиэтажный дом — пограничный объект для быстромонтируемого крана giraFFe SMK-5.66. Его крюк поднимается до 27 м при горизонтальной стреле и до 41,7 м при наклоне стрелы на 20°, но наклон сокращает вылет. Если отметка кровли, запас по ППР, строповка и высота груза в сумме укладываются в этот предел на нужном вылете, SMK-5.66 экономит на фундаменте и монтаже за 4–6 часов.</p>
    <p>Если высоты или вылета giraFFe SMK-5.66 не хватает, КРАН-КУБАНЬ предлагает классический кран. КБ-408.21 даёт 10 т и высоту крюка 54,0–72,7 м на рельсовом пути, Potain MCH 175 — 10 т и маховую стрелу до 55 м, которая сокращает вылет над соседними участками. Порядок расчёта — в статьях <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран под объект»</a> и <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Перебазировка башенного крана КРАН-КУБАНЬ в Лабинск — это 180 км от Краснодара негабаритным автотранспортом. Классический КБ-408.21 или Potain MDT 219 J10 везут секциями мачты, стрелой и противовесами, а на месте собирают автокраном по ППР. giraFFe SMK-5.66 разворачивает башню и стрелу собственными механизмами, и на площадке ему нужен один автокран 25 т.</p>
    <p>Для объектов КРАН-КУБАНЬ южнее Лабинска важна трасса Лабинск — Мостовской — граница Карачаево-Черкесии. По данным «Кубань 24» от 12 августа 2026 года, на ней ремонтируют участок 5,3 км между станицей Зассовской и посёлком Мостовским по нацпроекту «Инфраструктура для жизни», с завершением в октябре 2026 года. До окончания работ маршрут негабарита на этом участке лучше сверять заранее. Как планируют перебазировку, разобрано на этапе <a href="/etapy/demontazh-i-perebazirovka/">«Демонтаж и перебазировка»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Береговая часть Лабинска у реки Лабы — повод для КРАН-КУБАНЬ внимательно отнестись к изысканиям под основание крана. Несущую способность грунта и уровень грунтовых вод под фундаментом или рельсовым путём определяет проектировщик по данным изысканий на конкретном участке, а не по общим картам района. Для КБ-408.21 на рельсовом пути важна равномерность основания по всей длине пути, для фундаментных кранов — несущая способность под плитой.</p>
    <p>giraFFe SMK-5.66 и здесь требует меньше: для его опорного контура 4×4 м проверяют покрытие под четырьмя опорами. Но и для быстромонтируемого крана КРАН-КУБАНЬ слабый или обводнённый грунт означает подкладки или усиление под аутригерами. Что входит в изыскания и сколько они занимают, разобрано на этапе <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a> и в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Балл сейсмичности для Лабинска КРАН-КУБАНЬ сознательно не называет: надёжного первоисточника с числом для площадок города в открытом доступе мы не нашли. Расчётную сейсмичность определяют по СП 14.13330.2018 и краевым ТСН 22-302-2000 с учётом уровня ответственности объекта и категории грунта. Краевой диапазон — 7–9 баллов, и предгорное положение города не заменяет проверку по проекту.</p>
    <p>От расчётного балла зависит нагрузка на основание крана КРАН-КУБАНЬ: на фундамент КБ-408.21 или Potain MDT 219 J10 и на устойчивость giraFFe SMK-5.66 против опрокидывания. Для ответственных объектов на сложном грунте у Лабы проект может потребовать сейсмического микрорайонирования. Как балл складывается и когда нужна карта СМР, разобрано в разделе <a href="/seysmozony/">«Сейсмозоны»</a> и в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Закон Краснодарского края №608-КЗ действует в Лабинске так же, как в Краснодаре. Шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Башенный кран КРАН-КУБАНЬ на жилой площадке в центре Лабинска работает 13 часов в будни, и срок аренды считают от этих часов. Промышленная площадка вдали от жилья планируется свободнее, но границу санитарной зоны проверяют по проекту.</p>
    <p>Для крана КРАН-КУБАНЬ окно 13:00–15:00 в жилом квартале Лабинска удобно отдать под осмотр механизмов и пересменку. Монтаж giraFFe SMK-5.66 за 4–6 часов помещается в одно дневное окно, а многодневный монтаж классического крана планируют под окна на несколько дней. Подробный разбор — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>
    <p>Адрес площадки в Лабинске и этажность объекта можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ подскажет, хватит ли быстромонтируемого крана или нужен классический.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9B%D0%B0%D0%B1%D0%B8%D0%BD%D1%81%D0%BA', label: 'ru.wikipedia.org — Лабинск: население, география, история, предприятия' },
      { href: 'https://krasnodar.domostroyrf.ru/novostroyki/zhk-po-ul-kalinina', label: 'domostroyrf.ru — ЖК «Первый», Лабинск, ул. Калинина, 309: этажность, квартиры, сроки' },
      { href: 'https://kuban24.tv/item/remont-dorogi-mezhdu-labinskim-i-mostovskim-rajonami-zavershat-v-oktyabre', label: 'kuban24.tv, 12.08.2026 — ремонт дороги Лабинск — Мостовской завершат в октябре' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018 «Строительство в сейсмических районах»' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
