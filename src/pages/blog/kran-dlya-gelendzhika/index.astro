---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 91. Двадцать шестая статья блога — Геленджик, курортный город
// между уже разобранными Новороссийском и Сочи, но до сих пор не
// разобранный отдельно. Отличие от соседей по блогу: не порт с сухими
// грузами (Новороссийск) и не мораторий на многоэтажки (Сочи), а
// действующая стройка яхтенной марины и круизного терминала стоимостью
// около 100 млрд рублей — самый капиталоёмкий объект из всех разобранных
// в блоге на сегодня.
//
// Экономический слой: застройщик проекта «Геленджик Марина» — компания
// с ИНН 2304070885, ОГРН 1162375056480 (зарегистрирована 5 декабря 2016
// года), в открытых реестрах встречается под двумя названиями одного и
// того же юрлица — ООО «Морской порт Геленджик» и ООО СЗ «Геленджик
// Марина» — источники расходятся, какое из них текущее, поэтому в статье
// названы оба без утверждения, какое актуальнее. Исполнитель работ — ГК
// «Стройтрансгаз» (СТГ). Морскую часть марины планируют завершить в 2026
// году, весь комплекс с гостиницей и терминалом — в 2027-м.
//
// Сейсмика: прямая цитата строки Приложения Б ТСН 22-302-2000 для
// Геленджика не подтвердилась — docs.cntd.ru и base.garant.ru заблокированы
// egress-прокси сессии, тот же паттерн, что и в Волнах 76-80, 83-90. Зато
// отдельным запросом нашлась отраслевая публикация геотехнической компании
// «Геомаркетинг» (geomark.ru, сам сайт тоже заблокирован egress — цитата
// взята из сводки WebSearch, не из прямого чтения страницы): для проекта
// высотных (35-этажных, 123 м) зданий повышенного уровня ответственности в
// Геленджике сейсмичность указана как девять баллов по карте ОСР-2015(В)
// при периоде повторяемости раз в 1000 лет. Это не табличная строка ТСН
// Приложения Б и не универсальный балл для любой площадки города — в
// статье цифра приведена с этой оговоркой, а не как общий норматив.

const CHECKED = '18 сентября 2026 года';

const title = 'Кран для Геленджика: яхтенная марина за 100 млрд рублей у хребта Маркотх';
const description = 'Геленджик — курортный город между Новороссийском и Сочи: стройка яхтенной марины и круизного терминала «Геленджик Марина» стоимостью около 100 млрд рублей формирует спрос на кран, помимо обычной застройки курорта.';
const h1 = 'Кран для Геленджика: яхтенная марина за 100 млрд рублей у хребта Маркотх';
const crumbTitle = 'Кран для Геленджика';
const slug = 'kran-dlya-gelendzhika';

const H2 = [
  'Геленджик — курортный город в бухте у хребта Маркотх',
  '«Геленджик Марина»: яхтенный порт и круизный терминал за 100 млрд рублей',
  'Кто строит: застройщик и генеральный подрядчик',
  'Сейсмика: девять баллов для высоток — цифра с оговоркой',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'В Геленджике кран нужен только на площадке марины?',
    a: 'Нет. «Геленджик Марина» — самый капиталоёмкий и заметный объект города на сегодня, но обычная для курорта застройка — гостиницы, санатории, жильё в Кабардинке и Дивноморском, инфраструктура городского округа — создаёт спрос на технику независимо от одного конкретного проекта.',
  },
  {
    q: 'Чем Геленджик отличается от уже разобранных Новороссийска и Сочи?',
    a: 'От Новороссийска — тем, что якорный объект здесь не грузовой порт, а туристический и яхтенный комплекс, рассчитанный на пассажиров и отдыхающих, а не на зерно и цемент. От Сочи — тем, что в Геленджике нет моратория на многоэтажное строительство: город, наоборот, реализует один из самых капиталоёмких за последние годы курортных проектов края.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Геленджика', item: `${SITE}/blog/kran-dlya-gelendzhika/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-gelendzhika/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-gelendzhika/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье: порт Новороссийска, курортный мораторий Сочи, балкерный терминал Туапсе, азовский ветер Ейска. Геленджик стоит на той же береговой линии между Новороссийском и Сочи, но добавляет третий, ещё не разобранный сюжет — не грузовой порт и не ограничение на застройку, а действующая стройка яхтенной марины и круизного терминала, один из самых капиталоёмких курортных проектов края.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Геленджик стоит на берегу овальной Геленджикской бухты Чёрного моря, у подножия западной части хребта Маркотх — с адыгейского название переводится как «ягодный» или «ежевичный». До Новороссийска отсюда 25 км, до Краснодара — 180 км, до Сочи — около 250 км. Город имеет статус городского округа «город-курорт Геленджик», в состав которого помимо самого города входят курортные посёлки Кабардинка, Дивноморское и Архипо-Осиповка. Население собственно города на 2025 год — 80 534 человека. В отличие от Новороссийска рядом, у Геленджика нет крупного грузового порта и промышленной специализации: экономика города строится на курортном сезоне и — в последние годы — на одном крупном инфраструктурном проекте.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>«Геленджик Марина» — проект многофункционального рекреационного комплекса и яхтенного порта стоимостью около 100 млрд рублей. В его составе — морской пассажирский терминал со смотровой площадкой, театр водных представлений на 400 зрителей, гостиница на 600 номеров, объекты торговли и общественного питания, детский развлекательный центр — всего 14 объектов различного назначения, не считая самой марины с причалами для яхт. Строительство морской части (причалы, укрепление берега, понтоны) планируют завершить в 2026 году, весь комплекс вместе с наземной инфраструктурой — в 2027-м. Первый этап марины уже сдан, к концу 2026 года на площадке параллельно ведётся строительство яхт-клуба и корпусов гавани — стройка идёт не эпизодически, а несколькими параллельными потоками одновременно.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Застройщиком проекта выступает компания с ИНН 2304070885 и ОГРН 1162375056480, зарегистрированная 5 декабря 2016 года по адресу в Геленджике на улице Кирова: в разных открытых реестрах она встречается под двумя названиями одного и того же юридического лица — ООО «Морской порт Геленджик» и ООО СЗ «Геленджик Марина» (СЗ — специализированный застройщик). Источники расходятся, какое из названий актуально на сегодня, поэтому здесь названы оба, без утверждения, какое из них текущее. Среди совладельцев компании фигурируют структуры с долями около 32,8% каждая, а также ПАО «Интер РАО» с долей 28,93%. Генеральным исполнителем строительных работ на площадке выступает группа компаний «Стройтрансгаз» (СТГ) — крупный федеральный подрядчик, работающий и на других инфраструктурных проектах юга страны. Для арендодателя крана такой состав участников означает то же, что и на других крупных площадках блога — от промзоны Армавира до цементного завода в Новороссийске: согласование графика идёт не с одним заказчиком, а с генподрядчиком, который распределяет фронт работ между несколькими исполнителями и этапами.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Территориальные нормы ТСН 22-302-2000 (СНКК 22-301-2000) задают расчётную сейсмичность по Приложению Б для конкретных населённых пунктов края — этот источник уже прямо цитировался в блоге для Армавира и Кропоткина. Для Геленджика отдельный запрос такой цитаты не дал: docs.cntd.ru и base.garant.ru заблокированы сетевым egress сессии, та же картина, что и в предыдущих волнах. Зато нашлась отраслевая публикация геотехнической компании «Геомаркетинг» (geomark.ru — сам сайт тоже заблокирован для прямого чтения, цитата взята из сводки поисковика): для конкретного проекта высотных зданий — 35-этажных башен высотой 123 м, объектов повышенного уровня ответственности — сейсмичность площадки в Геленджике указана как девять баллов по карте ОСР-2015(В) при периоде повторяемости сотрясений раз в 1000 лет. Это не табличная строка Приложения Б и не универсальный балл для любой площадки города, поэтому в статье цифра приводится с этой оговоркой: девять баллов — это то, что справочно зафиксировано для одного конкретного высотного проекта, а не подтверждённый фоновый балл для всего Геленджика. Заказчику в любом случае стоит уточнять расчётную сейсмичность отдельно на этапе инженерных изысканий, как разбирает статья «Инженерные изыскания перед монтажом крана».</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины действует в Геленджике так же, как в Сочи, Новороссийске или Ейске: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с двухчасовым дневным перерывом, а в выходные и праздничные дни утренняя граница сдвинута до 10:00. Курортный статус города здесь ничего не меняет: норма одна на весь край, и она же будет действовать на площадке марины, и на площадке обычной гостиницы в Кабардинке. Подробный разбор часов и сумм штрафов по статье 3.3 — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Геленджик — курортный городской округ на берегу одноимённой бухты у хребта Маркотх, между Новороссийском и Сочи, население города — 80 534 человека (2025).</li>
      <li>«Геленджик Марина» — яхтенный порт и круизный терминал стоимостью около 100 млрд рублей, 14 объектов, морская часть — к 2026 году, весь комплекс — к 2027-му.</li>
      <li>Застройщик — компания с ИНН 2304070885 (встречается под названиями «Морской порт Геленджик» и СЗ «Геленджик Марина»), генеральный подрядчик — ГК «Стройтрансгаз».</li>
      <li>Девять баллов по карте ОСР-2015(В) зафиксированы для конкретного проекта 35-этажных высоток в Геленджике — это не подтверждённый фоновый балл для всего города, а справочная цифра с оговоркой.</li>
      <li>Закон №608-КЗ о тишине действует в Геленджике так же, как во всём крае.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/Геленджик', label: 'ru.wikipedia.org — Геленджик: население, география, статус городского округа' },
      { href: 'https://www.rusprofile.ru/id/10793400', label: 'rusprofile.ru — застройщик «Геленджик Марины», ИНН 2304070885: регистрация, адрес, совладельцы' },
      { href: 'https://www.korabel.ru/news/comments/proekt_stroitelstva_vtorogo_etapa_yahtennoy_mariny_v_gelendzhike_proshel_gosekspertizu.html', label: 'korabel.ru — второй этап яхтенной марины в Геленджике прошёл госэкспертизу' },
      { href: 'https://93.ru/text/gorod/2026/09/02/76618409/', label: '93.ru — как идёт стройка туристического комплекса «Геленджик Марина» (2 сентября 2026)' },
      { href: 'https://paluba.media/news/215629', label: 'paluba.media — в Геленджике начали строить яхт-клуб и корпуса «Геленджик Марины»' },
      { href: 'https://www.geomark.ru/articles/osobennosti-provedeniya-seysmicheskog/', label: 'geomark.ru — сейсмическое микрорайонирование при высотном строительстве в Геленджике' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
