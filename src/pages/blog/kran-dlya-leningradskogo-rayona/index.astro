---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 106. Шестьдесят пятая статья блога — угол (c) практический/региональный.
// Ленинградский район — северный аграрный район края на границе с Ростовской
// областью; агропромышленный профиль с переработкой (сахар, молоко, сыры, масло).
//
// Фактура — проверена 06.10.2026 (WebSearch + WebFetch):
// - Википедия: район образован 31.12.1934; площадь 1416,16 км² (26-е место в
//   крае); население 58 628 чел. (2025, Росстат), 59 536 (2021); с февраля 2024
//   преобразован в муниципальный округ; станица Ленинградская — центр, 35 561
//   чел. (2021); добыча природного газа, глины и воды; карбонатные чернозёмы;
// - инвестиционная презентация района (invest-lenkub.ru): до Краснодара 181 км,
//   до Ростова-на-Дону 120 км; 27 сельхозпредприятий, 251 КФХ; чернозёмы
//   102,2 тыс. га; АПК и переработка — более 80 % оборота продукции;
//   производства: сахар, молочная продукция, сыры, растительное масло, мука,
//   хлеб, мясо. Расстояние в разных источниках 163–181 км — называю 181 км по
//   районной презентации и пишу «около 180 км».
// Названий предприятий не называю. Балл сейсмичности НЕ называю (конвенция с
// Волны 79). Закон о тишине №608-КЗ — в редакции с 1 марта 2026.

const CHECKED = '6 октября 2026 года';
const PUBLISHED = '2026-10-06';

const title = 'Кран для Ленинградского района: башенный кран на севере края';
const description = 'Ленинградская в 181 км от Краснодара: сахар, молочная продукция и сыры дают более 80 % оборота. Какой башенный кран нужен на пищевом производстве.';
const h1 = 'Кран для Ленинградского района: какой башенный кран нужен на севере Кубани';
const crumbTitle = 'Кран для Ленинградского района';
const slug = 'kran-dlya-leningradskogo-rayona';

const H2 = [
  'Ленинградский район: 1416 км² на границе с Ростовской областью',
  'Пищевая переработка: сахар, молоко, сыры — какой кран',
  'Станица Ленинградская: жильё и соцобъекты',
  'Чернозём и основание крана',
  'Балл сейсмичности и закон №608-КЗ',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько километров от Краснодара до станицы Ленинградской?',
    a: 'По данным районной инвестиционной презентации, станица Ленинградская находится в 181 км от Краснодара и в 120 км от Ростова-на-Дону; в других источниках называют от 163 до 177 км — это зависит от маршрута. КРАН-КУБАНЬ везёт технику на север края около 180 км и закладывает в график доставку классического крана несколькими рейсами.',
  },
  {
    q: 'Какая экономика у Ленинградского района?',
    a: 'Агропромышленный комплекс и переработка дают более 80 % оборота продукции района. Выпускают сахар, молочную продукцию, сыры, растительное масло, муку, хлеб и мясо. В районе работают 27 сельскохозяйственных предприятий и 251 фермерское хозяйство на чернозёмах площадью 102,2 тыс. га. Добывают также газ, глину и воду.',
  },
  {
    q: 'Какой башенный кран подходит для пищевого производства?',
    a: 'Для цеха или склада вытянутой формы КРАН-КУБАНЬ рассматривает кран с большим вылетом: Potain MDT 219 J10 с вылетом 65 м обслуживает круг диаметром 130 м. Для компактного объекта до 27 м по высоте крюка хватает быстромонтируемого giraFFe SMK-5.66, которому не нужен фундамент.',
  },
  {
    q: 'Какой балл сейсмичности у Ленинградского района?',
    a: 'Одной цифрой балл не называют: значение берут из карт ОСР-2015 для уровня ответственности конкретного объекта и уточняют микрорайонированием площадки. Требования задают ТСН 22-302-2000 и СП 14.13330.2018. КРАН-КУБАНЬ принимает балл из проекта объекта, а не из общей карты.',
  },
  {
    q: 'Действует ли закон о тишине в Ленинградском районе?',
    a: 'Да, закон Краснодарского края №608-КЗ действует на всей территории края. С 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. В станице Ленинградской с населением 35,5 тыс. человек КРАН-КУБАНЬ проверяет расстояние до домов.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Ленинградский район"
  published={PUBLISHED}
>
    <p slot="intro">Станица Ленинградская — центр района площадью 1 416 км² — стоит в 181 км от Краснодара и в 120 км от Ростова-на-Дону. Агропромышленный комплекс и переработка дают здесь более 80 % оборота продукции, поэтому башенный кран КРАН-КУБАНЬ чаще работает на цехах и складах пищевых предприятий, чем на жилых домах. Модель выбирают по длине фронта работ, а не по этажности.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Ленинградский район образован 31 декабря 1934 года и занимает 1 416,16 км² — 26-е место среди районов края. Население по данным Росстата на 2025 год — 58 628 человек, в 2021 году было 59 536. С февраля 2024 года район преобразован в муниципальный округ, и КРАН-КУБАНЬ называет территорию по привычному имени, а объект привязывает к адресу, а не к статусу.</p>
    <p>Расстояние до Краснодара — около 180 км (181 км по районной презентации; в других источниках от 163 до 177 км, в зависимости от маршрута). Для КРАН-КУБАНЬ это главный логистический факт: быстромонтируемый giraFFe SMK-5.66 вывозят одним рейсом, а Potain MDT 219 J10 и КБ-408.21 — несколькими, с секциями мачты, стрелой и противовесом. Соседний район с таким же аграрным профилем разобран в статье о <a href="/blog/kran-dlya-kushchyovskogo-rayona/">Кущёвском районе</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Сахар, молочная продукция, сыры, растительное масло, мука, хлеб и мясо — перечень основных производств района, а на АПК и переработку приходится более 80 % оборота продукции. Для КРАН-КУБАНЬ из этого следует: объекты района — протяжённые цеха, склады и силосные корпуса, где длина фронта работ важнее высоты. Один кран с малым вылетом такой объект не покрывает целиком.</p>
    <p>Здесь выгодна модель с длинной стрелой. Potain MDT 219 J10 с вылетом 65 м обслуживает круг диаметром 130 м и подаёт материалы по всей длине здания без переустановки. КБ-408.21 с вылетом 40 м даёт круг диаметром 80 м — для компактного цеха этого достаточно, а его высота крюка 54,0–72,7 м пригодится для вертикальных корпусов. Если здание вытянуто сильнее, КРАН-КУБАНЬ планирует два крана — как это делают, показано в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Станица Ленинградская с населением 35 561 человек (2021) — крупнейший населённый пункт района и главная точка жилой и социальной застройки. Для школ, детских садов и невысоких домов КРАН-КУБАНЬ подбирает кран по высоте здания. Для объекта до 27 м по крюку хватает giraFFe SMK-5.66: опорный контур 4×4 м, фундамент не нужен, монтаж за 4–6 часов.</p>
    <p>Для более высокого дома КРАН-КУБАНЬ предлагает Potain MDT 219 J10 или КБ-408.21, а разницу между быстромонтируемым и классическим краном разбирает статья <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>. Сравнение двух конкретных моделей парка — в статье <a href="/blog/kb-408-21-ili-giraffe-smk-5-66/">«КБ-408.21 или giraFFe SMK-5.66»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Карбонатные чернозёмы Ленинградского района — плодородная почва, но не обязательно надёжное основание для крана: несущая способность зависит от конкретного участка, уровня грунтовых вод и сезона. КРАН-КУБАНЬ не берёт её «по району», а запрашивает материалы изысканий и сверяет с нагрузкой на основание. Перечень данных, которые нужны до монтажа, — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Для протяжённого цеха удобен рельсовый путь вдоль здания, для компактного объекта — монолитный фундамент под Potain MDT 219 J10 или КБ-408.21. Правила выбора основания разобраны в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Балл сейсмичности для Ленинградского района КРАН-КУБАНЬ одной цифрой не называет: значение берут из карт общего сейсмического районирования ОСР-2015 для уровня ответственности конкретного объекта и уточняют микрорайонированием площадки. Требования к строительству в сейсмических районах края задают ТСН 22-302-2000 и СП 14.13330.2018 — как определяют балл для площадки, показано в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Закон Краснодарского края №608-КЗ действует в Ленинградском районе так же, как в Краснодаре: с 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Пищевая площадка обычно далека от жилой застройки, но КРАН-КУБАНЬ проверяет расстояние до домов станицы заранее. Адрес объекта можно прислать через <a href="/#order">форму на главной</a>: инженерная служба предложит модель, основание и график доставки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9B%D0%B5%D0%BD%D0%B8%D0%BD%D0%B3%D1%80%D0%B0%D0%B4%D1%81%D0%BA%D0%B8%D0%B9_%D1%80%D0%B0%D0%B9%D0%BE%D0%BD_(%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%BE%D0%B4%D0%B0%D1%80%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B9)', label: 'ru.wikipedia.org — Ленинградский район: дата образования, площадь, население 2025 (Росстат), станица Ленинградская' },
      { href: 'https://www.invest-lenkub.ru/ru/presentation/', label: 'invest-lenkub.ru — презентация района: расстояние до Краснодара, АПК и переработка, число хозяйств' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
      { href: 'https://www.kubzsk.ru/', label: 'kubzsk.ru — Законодательное Собрание Краснодарского края: закон №608-КЗ (режим тишины)' },
    ]} />
</BlogArticleLayout>
