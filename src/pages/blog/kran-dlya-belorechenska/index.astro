---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 83. Восемнадцатая статья блога — Белореченск, первый разбор
// предгорного промышленного города с химическим, а не металлургическим или
// нефтеперерабатывающим профилем (в отличие от уже закрытых Абинского и
// Северского районов).
//
// Экономический слой: ООО «ЕвроХим-Белореченские минудобрения» (ЕвроХим-БМУ,
// ИНН 2303025270, ОГРН 1062303006930, зарегистрировано 01.09.2006, юр. адрес —
// г. Белореченск) — по опубликованным отраслевым и реестровым данным одно из
// крупнейших предприятий ЮФО по производству фосфорных минеральных удобрений,
// с 2002 года в составе МХК «ЕвроХим». Историческая часть (Краснодарский
// химический завод, первая отгрузка серной кислоты 9 июля 1977 года, к
// сентябрю 1979 года — 1 млн тонн серной кислоты, 14 цехов и около 3000
// рабочих за 1974-1986 годы) и данные о текущей модернизации (реконструкция
// сернокислотного цеха — рост мощности с 2200 до 2750 т/сутки, цех сложных
// водорастворимых удобрений) сверены по нескольким независимым источникам
// (spark-interfax, rusprofile, kartoteka.ru, list-org — для реквизитов;
// rupec.ru, ognikavkaza.ru — для истории и модернизации). Egress сессии не
// пропускал прямой доступ к adm-belorechensk.ru, eurochem.ru, list-org.ru и
// rusprofile.ru — цифры даны как опубликованные отраслевые/реестровые данные,
// а не как цитата первоисточника предприятия.
//
// Как и в Волнах 76-80, сетевой egress не пропускал docs.cntd.ru и
// base.garant.ru (Приложение Б ТСН 22-302-2000) напрямую — WebSearch тоже не
// дал прямой цитаты строки Белореченска. Балл сейсмики для площадки в статье
// сознательно не назван — та же честная развилка, что и в пяти предыдущих
// статьях подряд.

const CHECKED = '8 сентября 2026 года';

const title = 'Кран для Белореченска: химзавод «ЕвроХим-БМУ» и предгорье вместо степи';
const description = 'Белореченск — предгорный город на реке Белой: полувековой химический завод «ЕвроХим-БМУ» с действующей модернизацией и то, что это значит для монтажа башенного крана.';
const h1 = 'Кран для Белореченска: химзавод «ЕвроХим-БМУ» и предгорье вместо степи';
const crumbTitle = 'Кран для Белореченска';
const slug = 'kran-dlya-belorechenska';

const H2 = [
  'Белореченск — предгорье между Краснодаром и Адыгеей',
  'От химзавода до «ЕвроХим-БМУ»: полвека одной площадки',
  'Что сейчас строится и модернизируется на заводе',
  'Сейсмика: что можно сказать про Белореченск, а что нет',
  'Закон о тишине действует и здесь — без региональной скидки',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Раз в Белореченске есть крупный химзавод, значит ли это, что кран в городе нужен только на его площадке?',
    a: 'Нет. «ЕвроХим-БМУ» — крупный и регулярно модернизируемый промышленный объект, но город с населением около 54 тысяч человек живёт не только заводом: жилая застройка, социальная инфраструктура, объекты у трассы и в окрестных станицах района — тоже площадки для монтажа крана, с другими требованиями к грузоподъёмности и графику, чем реконструкция технологического цеха химического комбината.',
  },
  {
    q: 'Правда ли, что сейсмика Белореченска ниже, чем в предгорных Апшеронском или Мостовском районах?',
    a: 'Мы не можем этого утверждать и потому не приводим в статье конкретную цифру. Доступные источники не подтвердили прямой цитатой строку Белореченска в Приложении Б ТСН 22-302-2000 — так же, как ранее не подтвердили её для нескольких других районов края. Соседство на карте предгорной зоны само по себе не говорит о том, выше или ниже расчётный балл здесь: это определяет проектировщик по действующей редакции норматива для конкретной площадки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Белореченска', item: `${SITE}/blog/kran-dlya-belorechenska/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-belorechenska/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-belorechenska/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье (Анапа, Новороссийск, Сочи, Ейск, Туапсе), предгорную ось курортов и агропоселений (Армавир, Горячий Ключ, Апшеронский и Мостовской районы) и степные промышленные территории (Славянск-на-Кубани, Абинский и Северский районы). Белореченск стоит в той же предгорной полосе, что Апшеронский и Мостовской районы, но заказчик здесь другой: не теплица и не ферма, а химический комбинат с полувековой историей и действующей программой модернизации.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Белореченск — административный центр Белореченского района, город на реке Белой в предгорьях Главного Кавказского хребта, на границе с Республикой Адыгея. Население городского поселения — около 54 тысяч человек, всего района — свыше 106 тысяч. От Краснодара до города по разным источникам от 80 до чуть более 100 километров в зависимости от маршрута. В отличие от Апшеронского и Мостовского районов, где рельеф и сейсмический риск связаны прежде всего с оползневыми склонами, в Белореченске на первый план для монтажа крана выходит не рельеф, а масштаб и возраст промышленной площадки.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>История нынешнего «ЕвроХим-БМУ» начинается 9 июля 1977 года: в этот день с подъездных путей Краснодарского химического завода отправили первые сотни тонн серной кислоты. Уже к сентябрю 1979 года предприятие выпустило миллион тонн серной кислоты, а за 1974–1986 годы здесь построили 14 цехов, на которых работало около 3000 человек, — в конце 1985 года запустили цеха обесфторенных фосфатов и второй сернокислотный цех. Строительство завода в своё время подтолкнуло рост самого Белореченска: в 1980 году он получил статус города краевого подчинения. С 2002 года предприятие входит в минерально-химическую компанию «ЕвроХим» и работает как ООО «ЕвроХим-Белореченские минудобрения» (ИНН 2303025270, ОГРН 1062303006930) — сегодня это одно из крупнейших в Южном федеральном округе предприятий по производству фосфорных сложных минеральных удобрений.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Для арендодателя крана важна не только история площадки, а то, что на ней продолжают строить сейчас. По опубликованным отраслевым данным, в рамках программы модернизации на заводе построен цех комплексных водорастворимых удобрений и проведена реконструкция сернокислотного цеха: ввод нового оборудования позволил поднять его производительность примерно на четверть — с 2200 до 2750 тонн серной кислоты в сутки, а в отраслевых обзорах упоминалась и дальнейшая цель по мощности. Действующее и регулярно расширяемое химическое производство такого масштаба означает не разовый, а периодически повторяющийся спрос на башенный или автокран под реконструкцию отдельных цехов — отдельно от жилой и коммерческой застройки самого города.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Здесь мы, как и в статьях про Ейск, Туапсе, Славянск-на-Кубани, Абинский и Северский районы, сознательно не приводим конкретный балл сейсмичности. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Белореченска доступные источники надёжно не подтвердили. Предгорное положение города само по себе не говорит о том, выше расчётный балл или ниже, чем на равнине или на побережье: это вопрос к действующей редакции норматива для конкретной площадки, а не к рельефу на глаз. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Белореченске так же, как в Сочи или Краснодаре: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дополнительным дневным перерывом на отдых, а ответственность по статье 3.3 одинакова для всего края независимо от того, стоит рядом промышленная площадка или жилой квартал. У технологических цехов завода, удалённых от жилой застройки, риск жалобы соседей ниже, чем у стройки в самом городе или в станицах района, — но само требование к часам работы это не отменяет. Подробный разбор часов и сумм штрафов — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Белореченск — предгорный город на реке Белой у границы с Адыгеей, продолжает предгорную ось края, но с промышленным, а не курортно-аграрным профилем.</li>
      <li>Основной промышленный заказчик — «ЕвроХим-БМУ» (ИНН 2303025270), полувековая площадка бывшего Краснодарского химического завода, с 2002 года в составе МХК «ЕвроХим».</li>
      <li>Модернизация продолжается: реконструкция сернокислотного цеха подняла его мощность с 2200 до 2750 тонн в сутки, построен цех водорастворимых удобрений — регулярный спрос на технику под реконструкцию отдельных узлов.</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Белореченска в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Белореченске так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://spark-interfax.ru/krasnodarski-krai-belorechensk/ooo-evrokhim-bmu-inn-2303025270-ogrn-1062303006930-c2a2e13b708048f69ddc38fe0601057c', label: 'spark-interfax.ru — ООО «ЕвроХим-БМУ», ИНН 2303025270, ОГРН 1062303006930' },
      { href: 'https://www.rusprofile.ru/id/3037133', label: 'rusprofile.ru — ООО «ЕвроХим-БМУ», регистрационные данные' },
      { href: 'https://www.kartoteka.ru/card/324fe695ae275c2ecc68026bb2cf9c5b/', label: 'kartoteka.ru — реквизиты ООО «ЕвроХим-БМУ»' },
      { href: 'https://ognikavkaza.ru/news/obshchestvo/belorechenskomu-evrokhimu-45', label: 'ognikavkaza.ru — история завода, 45 лет предприятию (01.09.2022)' },
      { href: 'https://rupec.ru/news/37804/', label: 'rupec.ru — запуск цеха водорастворимых удобрений и модернизация сернокислотного цеха' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
    ]} />
</BlogArticleLayout>
