---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 113. Восемьдесят третья статья блога — угол (a) информационный/how-to.
// Связь между крановщиком башенного крана и стропальщиком: когда рация
// обязательна, когда хватает сигнальщика и знаков. На сайте темы не было
// (сигнальщик упоминался только мимоходом).
//
// Фактура — ФНП № 461 (сырой текст legalacts.ru через curl, проверено 15.10.2026):
// - п. 123: башенными кранами возводят здания выше 36 м — двухсторонняя радио-
//   или телефонная связь; перечень и обозначение команд — внутренним
//   распорядительным актом эксплуатирующей организации;
// - п. 153: зона не просматривается из кабины и нет радио/телефона —
//   назначают сигнальщика из числа стропальщиков; назначает ИТР, ответственный
//   за безопасное производство работ;
// - п. 162 (последний абзац): подача в проёмы, стропальщик вне видимости —
//   радио/телефон или сигнальщики; команды сигнальщика видны и крановщику,
//   и стропальщику;
// - п. 248: порядок обмена сигналами устанавливает эксплуатирующая организация;
//   знаковая сигнализация и система обмена при радиопереговорах — в
//   производственных инструкциях крановщиков и стропальщиков; знаки — прил. № 7;
// - п. 249: при смене участка — инструктаж под подпись о знаковой сигнализации;
// - приложение № 7: девять операций (поднять/опустить груз, передвинуть ПС,
//   передвинуть тележку, повернуть стрелу, поднять/опустить стрелу, стоп,
//   осторожно). Описания жестов пересказаны, не скопированы.
// - п. 250 (10/22 м) — только подъёмники (вышки), к башенным кранам не относится —
//   сказано в тексте, чтобы не путали.
// Чек-лист и «какие сигналы нужны какой модели» — рекомендация КРАН-КУБАНЬ на
// основе parkModels.ts (тележка — у всех, кроме подъёма стрелы; подъём/опускание
// стрелы — только Potain MCH 175 и наклон у giraFFe SMK-5.66).
// Не названо: модели раций, частоты, дальность — в ФНП нет.

const CHECKED = '15 октября 2026 года';
const PUBLISHED = '2026-10-15';

const title = 'Рация или сигнальщик на башенном кране: что требует ФНП';
const description = 'При стройке выше 36 м башенный кран обязан работать с двухсторонней радио- или телефонной связью (п. 123 ФНП № 461). Когда хватает сигнальщика и знаков.';
const h1 = 'Рация или сигнальщик: как крановщик башенного крана получает команды';
const crumbTitle = 'Рация или сигнальщик на башенном кране';
const slug = 'raciya-ili-signalshchik-na-bashennom-krane';

const H2 = [
  'Порог 36 м: когда радиосвязь обязательна',
  'Сигнальщик: кто его назначает и когда он нужен',
  'Девять знаков приложения № 7 и модели парка',
  'Где записан порядок сигналов и кто расписывается',
  'Как КРАН-КУБАНЬ организует связь на площадке',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Обязательна ли рация на башенном кране?',
    a: 'Обязательна, если башенным краном возводят здание или сооружение выше 36 м: пункт 123 ФНП № 461 требует двухстороннюю радио- или телефонную связь. Ниже этой высоты рация нужна, когда стропальщик вне видимости крановщика, — либо вместо неё назначают сигнальщика. КРАН-КУБАНЬ выдаёт рации на всех объектах.',
  },
  {
    q: 'Кто назначает сигнальщика на стройке?',
    a: 'Инженерно-технический работник, ответственный за безопасное производство работ с применением подъёмных сооружений, — так сказано в пункте 153 ФНП № 461. Сигнальщика выбирают из числа стропальщиков, а не из случайных рабочих. На объектах КРАН-КУБАНЬ назначение оформляют до первого подъёма.',
  },
  {
    q: 'Сколько знаков сигнализации для крановщика установлено ФНП?',
    a: 'Девять: поднять и опустить груз, передвинуть кран, передвинуть грузовую тележку, повернуть стрелу, поднять и опустить стрелу, «стоп» и «осторожно». Они приведены в приложении № 7 к ФНП № 461. Для Potain MDT 219 J10 и КБ-408.21 знаки подъёма и опускания стрелы не применяются — стрела у них горизонтальная.',
  },
  {
    q: 'Можно ли командовать крановщиком голосом?',
    a: 'Для башенного крана ФНП № 461 предусматривает радио- или телефонную связь либо знаковую сигнализацию. Правило про голос до 10 м в пункте 250 относится к подъёмникам (вышкам) и людям в люльке, а не к кранам. На площадках КРАН-КУБАНЬ голосовые команды не используются.',
  },
  {
    q: 'Нужно ли заново инструктировать крановщика на новом объекте?',
    a: 'Да: пункт 249 ФНП № 461 требует инструктажа под подпись о знаковой сигнализации при смене участка работы — и для крановщика, и для стропальщиков. КРАН-КУБАНЬ проводит такой инструктаж при выходе машиниста на новый объект вместе со сверкой перечня радиокоманд.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Безопасность · Работа на площадке"
  published={PUBLISHED}
>
    <p slot="intro">Когда башенным краном возводят здание выше 36 м, между крановщиком и стропальщиком обязательна двухсторонняя радио- или телефонная связь — это пункт 123 ФНП № 461. Ниже 36 м рация нужна там, где стропальщика не видно из кабины; вместо неё допускается сигнальщик со знаками из приложения № 7. КРАН-КУБАНЬ разбирает, какие пункты за что отвечают и кто подписывает порядок сигналов.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 123 ФНП № 461 называет конкретную границу: при возведении башенными кранами зданий и сооружений высотой более 36 м применяется двухсторонняя радио- или телефонная связь. Это единственное место в правилах, где обязанность иметь рацию привязана к высоте объекта, а не к видимости. Для КРАН-КУБАНЬ порог означает: при условной высоте этажа 3 м (допущение, а не норма) под требование попадает уже 12-этажный дом.</p>
    <p>Тот же пункт 123 добавляет условие, о котором часто забывают: перечень команд и их обозначения утверждает внутренний распорядительный акт эксплуатирующей организации. Рация без утверждённого списка фраз формально требование не закрывает. КРАН-КУБАНЬ поэтому выдаёт на объект не только радиостанции, но и лист команд, подписанный ответственным лицом.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Ситуация на площадке</th><th>Что требует ФНП № 461</th><th>Пункт</th></tr></thead>
      <tbody>
        <tr><td>Объект выше 36 м</td><td>Радио- или телефонная связь</td><td>п. 123</td></tr>
        <tr><td>Зону не видно из кабины</td><td>Связь или сигнальщик</td><td>п. 153</td></tr>
        <tr><td>Подача груза в проём</td><td>Связь или сигнальщики</td><td>п. 162</td></tr>
        <tr><td>Смена участка работ</td><td>Инструктаж под подпись</td><td>п. 249</td></tr>
      </tbody>
    </table></div>
    <p>Высота 36 м сравнима с паспортом моделей парка: giraFFe SMK-5.66 с наклоном стрелы поднимает крюк до 41,7 м, остальные четыре модели КРАН-КУБАНЬ — от 54 м и выше. Значит, на объектах тяжёлых кранов парка рация практически всегда обязательна, а не желательна. Высоты всех моделей сведены в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Сигнальщика назначают, если зону работы крана не видно из кабины полностью и радио- или телефонной связи между крановщиком и стропальщиком нет — так сформулирован пункт 153 ФНП № 461. Назначает его инженерно-технический работник, ответственный за безопасное производство работ с подъёмными сооружениями, и только из числа стропальщиков. На площадке КРАН-КУБАНЬ сигнальщик — обученный стропальщик с удостоверением, а не прораб или подсобник.</p>
    <p>Пункт 162 ФНП № 461 повторяет ту же развилку для подачи грузов в проёмы и люки перекрытий: связь по радио или телефону либо выставленные сигнальщики. Добавлено требование к видимости: команды сигнальщика должны видеть и крановщик, и стропальщик. Для башенного крана высотой 50–70 м это трудно выполнимо, поэтому при подаче в проёмы КРАН-КУБАНЬ работает только по рации, а сигнальщика ставит как дублёра.</p>
    <p>Типичная ошибка на объектах края — путать правила кранов и подъёмников. Пункт 250 ФНП № 461 с порогами 10 и 22 м касается связи с людьми в люльке подъёмника (вышки), а не башенного крана. Для башенного крана КРАН-КУБАНЬ ориентируется на пункты 123, 153 и 162; границы зоны, где во время подъёма не должно быть людей, разобраны в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Приложение № 7 к ФНП № 461 описывает девять знаков рукой: поднять груз, опустить груз, передвинуть кран, передвинуть грузовую тележку, повернуть стрелу, поднять стрелу, опустить стрелу, «стоп» и «осторожно». Подъём груза показывают рукой, согнутой в локте, с ладонью вверх, опускание — ладонью вниз перед грудью. «Стоп» — резкий взмах вправо-влево на уровне пояса, и КРАН-КУБАНЬ учит машинистов реагировать на него раньше любой радиокоманды.</p>
    <p>Не все девять знаков нужны каждой модели парка КРАН-КУБАНЬ. Знак «передвинуть кран» имеет смысл только для кранов на рельсовом пути — КБ-408.21 и Potain MDT 219 J10 или Potain MCH 175 в рельсовом исполнении. Знаки «поднять стрелу» и «опустить стрелу» относятся к маховой стреле Potain MCH 175, а «передвинуть тележку» — к кранам с горизонтальной стрелой.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Тележка</th><th>Подъём стрелы</th><th>Передвижение</th></tr></thead>
      <tbody>
        <tr><td>Potain MDT 219 J10</td><td>да</td><td>нет</td><td>на пути</td></tr>
        <tr><td>КБ-408.21</td><td>да</td><td>нет</td><td>да</td></tr>
        <tr><td>КБ-674А</td><td>да</td><td>нет</td><td>нет</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>да</td><td>наклон 20°</td><td>нет</td></tr>
        <tr><td>Potain MCH 175</td><td>нет</td><td>да</td><td>на пути</td></tr>
      </tbody>
    </table></div>
    <p>Таблица составлена инженерной службой КРАН-КУБАНЬ по типу стрелы и основанию из паспортных данных парка, а не взята из ФНП: правила дают знаки, но не привязывают их к моделям. Подробно разница стрел описана в статье <a href="/blog/gorizontalnaya-ili-mahovaya-strela-bashennogo-krana/">«Маховая или горизонтальная стрела»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пункт 248 ФНП № 461 возлагает порядок обмена сигналами между стропальщиками и крановщиками на эксплуатирующую организацию. И знаковая сигнализация, и система обмена при радиопереговорах вносятся в производственные инструкции крановщиков и стропальщиков. На объектах КРАН-КУБАНЬ эти инструкции лежат в кабине и у старшего стропальщика.</p>
    <p>Пункт 249 ФНП № 461 добавляет инструктаж под подпись при смене участка работы: крановщик, перешедший с одного объекта на другой, заново знакомится с принятой там сигнализацией. Причина практическая — на соседних площадках радиокоманды могут звучать по-разному. КРАН-КУБАНЬ проводит этот инструктаж в день выхода машиниста и хранит лист подписей вместе с вахтенным журналом.</p>
    <p>Документальная часть связи пересекается с ППР: схема строповки, места стропальщиков и способ передачи команд удобнее показать в одном проекте. Состав такого проекта для башенного крана описан в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«ППР для башенного крана»</a>, и КРАН-КУБАНЬ включает туда раздел о связи.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Порядок КРАН-КУБАНЬ строится так, чтобы закрыть пункты 123, 153, 248 и 249 ФНП № 461 до первого подъёма. Список ниже — рабочее правило инженерной службы, а не текст нормы.</p>
    <ol>
      <li>КРАН-КУБАНЬ проверяет высоту объекта по проекту: больше 36 м — радиосвязь обязательна.</li>
      <li>Ответственный за безопасное производство работ утверждает перечень радиокоманд.</li>
      <li>По плану площадки КРАН-КУБАНЬ отмечает зоны, не видимые из кабины, и назначает сигнальщика из стропальщиков.</li>
      <li>Крановщик и стропальщики расписываются за инструктаж по сигнализации этого участка.</li>
      <li>Перед сменой КРАН-КУБАНЬ проверяет заряд раций и связь «кабина — земля».</li>
    </ol>
    <p>Связь — часть общей подготовки к сменной работе, наравне с осмотром крана и пути. Ежесменный порядок разобран в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Осмотр башенного крана перед сменой»</a>, а правила строповки — в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>. Высоту объекта и план площадки можно прислать через <a href="/#order">форму на главной</a> — КРАН-КУБАНЬ учтёт связь в расчёте.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'ФНП № 461 «Правила безопасности ОПО, на которых используются подъёмные сооружения» — пп. 123, 153, 162, 248–250, приложение № 7' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
    ]} />
</BlogArticleLayout>
