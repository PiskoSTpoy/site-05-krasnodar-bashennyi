---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 113. Восемьдесят четвёртая статья блога — угол (b) коммерческий/сравнительный.
// Свободностоящая схема (четыре модели парка) против приставной (КБ-674А):
// что меняется в смете, документах и сроках. Пары моделей уже разобраны,
// ось «способ установки» отдельно — нет.
//
// Фактура (проверено 15.10.2026):
// - src/data/parkModels.ts: MDT 219 J10 до 70,4 м, путь или фундамент;
//   КБ-408.21 54,0–72,7 м, только рельсовый путь; КБ-674А до 60 м своб. /
//   116–120 м приставным, фундамент + анкеровка; SMK-5.66 до 27/41,7 м,
//   опорный контур 4×4 м; MCH 175 до 58,5 м, путь или фундамент;
// - карточка /park/kb-674a/: максимальная нагрузка на настенную опору 37,8 т
//   (источник карточки — stroy-kran.ru); высота 116–120 м зависит от числа
//   настенных опор и исполнения;
// - ФНП № 461 (legalacts.ru, curl): п. 36 — для ПС, которые при монтаже
//   крепят к строящемуся объекту (приставных башенных кранов), конструкции
//   креплений — по проектной и (или) эксплуатационной документации и пп. 42–47;
//   п. 47 — после монтажа металлоконструкций запасовка канатов, наладка
//   тормозов, ограничителей, указателей, регистраторов (пп. 48–55);
//   п. 156 (ППР) уже разобран в отдельной статье — только ссылка.
// Расчёт: приставной КБ-674А выше свободного на 56–60 м; выше лучшего
// свободностоящего (КБ-408.21, 72,7 м) на 43,3–47,3 м.
// Не названо: число настенных опор на конкретную высоту, цены, сроки — в
// реестре нет, сказано в тексте.

const CHECKED = '15 октября 2026 года';
const PUBLISHED = '2026-10-15';

const title = 'Свободностоящий или приставной башенный кран: что выбрать';
const description = 'Свободностоящие краны парка КРАН-КУБАНЬ поднимают до 72,7 м, приставной КБ-674А — до 116–120 м. Что меняет крепление к зданию в проекте и смете.';
const h1 = 'Свободностоящий или приставной башенный кран: когда крепить кран к зданию';
const crumbTitle = 'Свободностоящий или приставной кран';
const slug = 'svobodnostoyashchiy-ili-pristavnoy-bashennyi-kran';

const H2 = [
  'Свободностоящий кран и приставной КБ-674А: в чём разница',
  'Четыре свободностоящие модели и один приставной кран',
  'Что добавляет крепление к зданию: опоры, расчёт, ФНП',
  'Когда приставной кран оправдан, а когда избыточен',
  'Какие данные нужны КРАН-КУБАНЬ для выбора схемы',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем приставной башенный кран отличается от свободностоящего?',
    a: 'Приставной кран по мере роста здания крепят к его конструкции настенными опорами, а свободностоящий держится только на основании — рельсовом пути, фундаменте или опорном контуре. В парке КРАН-КУБАНЬ приставной режим есть у КБ-674А: до 60 м без крепления и 116–120 м с креплением к зданию.',
  },
  {
    q: 'До какой высоты работает свободностоящий башенный кран?',
    a: 'В парке КРАН-КУБАНЬ лучший результат без крепления к зданию — у КБ-408.21: до 72,7 м при максимальном числе секций мачты. Potain MDT 219 J10 поднимает до 70,4 м, Potain MCH 175 — до 58,5 м, giraFFe SMK-5.66 — до 41,7 м с наклоном стрелы.',
  },
  {
    q: 'Какую нагрузку приставной кран передаёт на здание?',
    a: 'Для КБ-674А паспортный максимум — 37,8 т на одну настенную опору, по данным карточки модели в парке КРАН-КУБАНЬ. Эту нагрузку должен принять проектировщик здания: без его расчёта стены и перекрытия под анкеры не считаются подтверждёнными и монтаж в приставном режиме не начинают.',
  },
  {
    q: 'Что требует ФНП № 461 для приставного крана?',
    a: 'Пункт 36 ФНП № 461 требует, чтобы конструкции креплений приставного башенного крана к строящемуся зданию соответствовали проектной и (или) эксплуатационной документации и пунктам 42–47 о сборке и наладке. КРАН-КУБАНЬ закладывает узлы крепления в ППР до начала монтажа.',
  },
  {
    q: 'Можно ли перейти со свободностоящего режима на приставной в ходе стройки?',
    a: 'У КБ-674А такой путь предусмотрен самой схемой: до 60 м кран стоит без крепления, выше его наращивают и крепят к зданию. Но опоры и закладные должны быть в проекте заранее. КРАН-КУБАНЬ рассматривает этот вариант до заказа, а не по ходу работ.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Схема установки"
  published={PUBLISHED}
>
    <p slot="intro">Свободностоящий кран парка КРАН-КУБАНЬ поднимает крюк максимум на 72,7 м — это КБ-408.21, а приставной КБ-674А, закреплённый к зданию, работает на 116–120 м. Разница в 43–47 м стоит дополнительного расчёта: каждая настенная опора КБ-674А передаёт на конструкцию до 37,8 т, и проектировщик здания должен эту нагрузку подтвердить.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Свободностоящий башенный кран держится только на своём основании — рельсовом пути, монолитном фундаменте или опорном контуре — и сопротивляется опрокидыванию за счёт базы и противовеса. Приставной кран по мере роста здания крепят к нему настенными опорами, и часть нагрузки уходит в конструкцию дома. В парке КРАН-КУБАНЬ четыре модели работают только свободностоящими, а КБ-674А умеет оба режима.</p>
    <p>Для заказчика разница сводится к тому, чей объект участвует в устойчивости крана. Свободностоящий кран не зависит от готовности стен, и его можно ставить до начала каркаса. Приставной КБ-674А требует, чтобы в местах крепления уже были несущие конструкции нужной прочности, поэтому КРАН-КУБАНЬ увязывает график наращивания мачты с графиком возведения этажей.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Паспортные данные пяти моделей КРАН-КУБАНЬ показывают, где проходит потолок свободностоящей схемы. Таблица сведена из реестра парка, проверенного 15 октября 2026 года.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Режим</th><th>Высота крюка</th><th>Основание</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>свободностоящий</td><td>54,0–72,7 м</td><td>рельсовый путь</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>свободностоящий</td><td>до 70,4 м</td><td>путь или фундамент</td></tr>
        <tr><td>Potain MCH 175</td><td>свободностоящий</td><td>до 58,5 м</td><td>путь или фундамент</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>свободностоящий</td><td>до 41,7 м</td><td>контур 4×4 м</td></tr>
        <tr><td>КБ-674А</td><td>оба</td><td>60 м / 116–120 м</td><td>фундамент и анкеры</td></tr>
      </tbody>
    </table></div>
    <p>Из таблицы КРАН-КУБАНЬ делает простой вывод: до 72,7 м задача решается без крепления к зданию, выше — только приставным КБ-674А. В свободностоящем режиме КБ-674А с его 60 м уступает КБ-408.21 и Potain MDT 219 J10, так что брать его ради высоты до 60 м смысла нет — его сильная сторона в грузе: 12,5 т максимум и 5,6 т на вылете 50,5 м. Сравнение этих моделей по грузу — в статье <a href="/blog/kb-408-21-ili-kb-674a/">«КБ-408.21 или КБ-674А»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пункт 36 ФНП № 461 прямо называет приставные башенные краны: конструкции их креплений к строящемуся зданию должны соответствовать проектной и (или) эксплуатационной документации и пунктам 42–47 о сборке. Самодельные кронштейны и «усиление по месту» правила не допускают. КРАН-КУБАНЬ монтирует только паспортные настенные опоры КБ-674А по схеме изготовителя.</p>
    <p>Вторая строка затрат — расчёт здания. Настенная опора КБ-674А передаёт до 37,8 т, и эту силу должен принять проектировщик дома: стена, перекрытие или колонна в точке крепления. Без такого расчёта КРАН-КУБАНЬ приставной монтаж не начинает, а предлагает либо пересчёт конструкций, либо свободностоящую схему с КБ-408.21 там, где хватает 72,7 м.</p>
    <p>Третья строка — наладка после каждого наращивания. Пункт 47 ФНП № 461 требует после монтажа металлоконструкций запасовать канаты и наладить тормоза, ограничители, указатели и регистраторы. Для приставного крана, который наращивают несколько раз за стройку, КРАН-КУБАНЬ планирует эти работы в графике заранее; приборы безопасности разобраны в статье <a href="/blog/pribory-bezopasnosti-bashennogo-krana/">«Приборы безопасности башенного крана»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Приставная схема КБ-674А оправдана, когда здание выше 72,7 м с учётом запаса на груз и стропы: ни одна свободностоящая модель КРАН-КУБАНЬ туда не дотянется. Приставной режим даёт прирост 43,3–47,3 м к лучшему свободностоящему крану парка и 56–60 м к самому КБ-674А без крепления. Расчёт получен вычитанием паспортных высот, а не из паспорта.</p>
    <p>Приставной режим избыточен, если объект укладывается в 72,7 м: крепления, расчёт здания и повторная наладка добавляют строки в смету, не давая высоты, которой нет у КБ-408.21 или Potain MDT 219 J10. Для низких объектов до 41,7 м КРАН-КУБАНЬ рассматривает giraFFe SMK-5.66, которому не нужен даже фундамент. Сметная логика аренды описана в статье <a href="/blog/smeta-arendy-bashennogo-krana/">«Смета аренды башенного крана»</a>.</p>
    <p>Сейсмичность края добавляет аргумент в пользу расчёта, а не против приставной схемы: здание и закреплённый на нём кран при толчке колеблются вместе, поэтому КРАН-КУБАНЬ просит проектировщика учесть в расчёте узлов балльность площадки, определённую по ТСН 22-302-2000. Как КРАН-КУБАНЬ учитывает балльность, разобрано в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Выбор между свободностоящей и приставной схемой КРАН-КУБАНЬ делает по пяти исходным данным; перечень — рабочее правило инженерной службы, а не норма.</p>
    <ol>
      <li>Высота здания по проекту — граница 72,7 м отделяет свободностоящие модели КРАН-КУБАНЬ от приставного КБ-674А.</li>
      <li>Самый тяжёлый груз и вылет его подачи — по ним проверяют паспортную кривую модели.</li>
      <li>Конструктивная схема здания — есть ли несущие стены или колонны в местах опор.</li>
      <li>Согласие проектировщика здания рассчитать нагрузку до 37,8 т на опору.</li>
      <li>Отчёт изысканий — от него зависит фундамент КБ-674А или путь КБ-408.21.</li>
    </ol>
    <p>Общий порядок подбора по высоте, вылету и грузу описан в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>, а паспорт КБ-674А с настенными опорами — на <a href="/park/kb-674a/">странице модели</a>. Высоту здания и схему конструкций можно прислать через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ ответит, хватит ли свободностоящего крана.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'ФНП № 461 «Правила безопасности ОПО, на которых используются подъёмные сооружения» — пп. 36, 42–47' },
      { href: 'https://www.stroy-kran.ru/kb/kb-674', label: 'stroy-kran.ru — КБ-674А: высота приставным способом, нагрузка на настенную опору' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
    ]} />
</BlogArticleLayout>
