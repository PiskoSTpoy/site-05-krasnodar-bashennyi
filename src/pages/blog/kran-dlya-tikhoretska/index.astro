---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 94. Двадцать девятая статья блога — Тихорецк, степной север края,
// 150 км к северо-востоку от Краснодара. Новая для блога ось — не курорт,
// не порт и не пищевой завод, а железнодорожный узел (станция Тихорецкая
// на линиях Ростов — Баку и Волгоград — Новороссийск) и заявленная новая
// промышленная стройка.
//
// Экономический слой: соглашение края с компанией «Л-Пак» о строительстве
// в Тихорецке завода гофрокартона и упаковки — подписано на ПМЭФ-2026,
// инвестиции 9,3 млрд руб., более 300 рабочих мест. Подтверждено независимо
// dg-yug.ru (05.06.2026) и publish.ru (08.06.2026). Сроки строительства,
// площадка и площадь в открытых источниках НЕ названы — в статье так и
// сказано. Второй слой — ОАО «ТМЗ им. В.В. Воровского» (ИНН 2321003173):
// путевые машины для РЖД и метрополитенов; «более 110 лет» — формулировка
// самого завода (tmzv.ru), точный год основания в статью не выносим.
//
// Балл сейсмики для Тихорецка не найден в доступных источниках (запрос по
// ОСР-2015 / ТСН 22-302-2000 цифры не дал) — та же честная развилка, что и
// в Волнах 76-80, 83-93. Закон о тишине сверен WebSearch 24.09.2026
// (Коммерсантъ, РБК Кубань): 23:00-08:00, 13:00-15:00, в выходные до 10:00.

const CHECKED = '24 сентября 2026 года';

const title = 'Кран для Тихорецка: завод «Л-Пак» и железнодорожный узел';
const description = 'Тихорецк: соглашение о заводе упаковки «Л-Пак» на 9,3 млрд рублей, ТМЗ им. Воровского и узел станции Тихорецкая — что это значит для аренды башенного крана.';
const h1 = 'Кран для Тихорецка: завод «Л-Пак» и железнодорожный узел';
const crumbTitle = 'Кран для Тихорецка';
const slug = 'kran-dlya-tikhoretska';

const H2 = [
  'Тихорецк — город, выросший при станции',
  'Завод «Л-Пак»: соглашение на 9,3 млрд рублей',
  'ТМЗ им. Воровского: действующий заказчик',
  'Железная дорога рядом с площадкой',
  'Сейсмика: почему балл для площадки в статье не назван',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Когда начнётся стройка завода «Л-Пак» в Тихорецке?',
    a: 'На дату проверки открытые источники сообщают только о подписанном на ПМЭФ-2026 соглашении, объёме инвестиций (9,3 млрд рублей) и числе рабочих мест (более 300). Сроки строительства и конкретная площадка публично не названы. Планировать технику под этот объект имеет смысл после выхода разрешения на строительство — до этого любые даты были бы догадкой.',
  },
  {
    q: 'Нужен ли для завода гофрокартона именно башенный кран?',
    a: 'Не обязательно на весь объект. Одноэтажные производственные корпуса большого пролёта часто монтируют стреловыми и гусеничными кранами. Башенный кран оправдан там, где длинная стройка, стеснённая площадка или многоэтажный административно-бытовой корпус и склад с высоким стеллажным хранением. Решение принимается по ППР конкретного объекта.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Тихорецка', item: `${SITE}/blog/kran-dlya-tikhoretska/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-tikhoretska/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-tikhoretska/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал курорты, порты и города при сахарных заводах. Тихорецк не похож ни на один из этих случаев. Город вырос при железнодорожной станции, и главный его работодатель много десятилетий выпускает технику для железной дороги. Летом 2026 года к этому добавилась новость о крупной промышленной стройке: край подписал соглашение о заводе упаковки на 9,3 миллиарда рублей.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Тихорецк стоит на севере Краснодарского края, примерно в 150 километрах к северо-востоку от Краснодара и в 165 километрах к юго-востоку от Ростова-на-Дону. Город основан в 1874 году как хутор при станции Тихорецкой, а статус города получил в 1926 году. Население по данным 2025 года — около 54 тысяч человек. Станция Тихорецкая — узел линий Ростов — Баку и Волгоград — Новороссийск, рядом проходят федеральные автотрассы. Курортной функции у города нет: спрос на технику создают промышленность, логистика и обычная городская застройка.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>В июне 2026 года на Петербургском международном экономическом форуме администрация Краснодарского края и компания «Л-Пак» подписали соглашение о строительстве в Тихорецке завода гофрокартона и упаковки. Заявленные инвестиции — 9,3 миллиарда рублей, завод должен дать городу более 300 рабочих мест. Выпускать там собираются гофролист, изделия со сложной высечкой и четырёхклапанные коробки. Об этом независимо сообщили «Деловая газета. Юг» и отраслевой портал publish.ru.</p>
    <p>Чего в открытых источниках пока нет: сроков строительства, адреса площадки и площади корпусов. Мы их не додумываем. Для подрядчика вывод простой: объект заявлен, но планировать под него технику стоит после появления разрешения на строительство и проекта организации работ.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>ОАО «Тихорецкий машиностроительный завод им. В. В. Воровского» (ИНН 2321003173) — предприятие путевого машиностроения. Завод выпускает машины для текущего ремонта и содержания железнодорожного пути и для работ на контактной сети. Среди заказчиков, по данным самого завода, — РЖД, метрополитены Москвы и Санкт-Петербурга, железные дороги Казахстана, Беларуси и Средней Азии. Своей истории завод насчитывает более 110 лет: начинался он с мастерских по ремонту паровозов при станции. Для арендодателя крана такой завод — это не одна большая стройка, а регулярные работы: реконструкция цехов, замена оборудования, ремонт кровель и складов.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>В городе, выросшем вокруг станции, многие промышленные площадки примыкают к путям и подъездным веткам. Для башенного крана это отдельная тема проекта: зона обслуживания стрелы и возможного падения груза не должна заходить на действующие пути и контактную сеть без согласования с их владельцем. Иногда стрелу ограничивают по сектору, иногда кран ставят дальше от путей и берут модель с большим вылетом. Такие решения закладываются на этапе ППР, а не на площадке в день монтажа. Подробнее о том, что проверяют до монтажа, — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Инженерные изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Как и в статьях про Усть-Лабинский, Абинский, Северский и другие районы, мы сознательно не называем здесь конкретный балл сейсмичности. Территориальные нормы ТСН 22-302-2000 задают расчётную сейсмичность для населённых пунктов края, но строку для Тихорецка в доступных источниках подтвердить не удалось. Степной север края в целом спокойнее побережья, где расчётная сейсмичность доходит до 8-9 баллов, но «спокойнее» — не цифра. Расчётный балл площадки определяет проектировщик по результатам изысканий. Как сейсмика меняет выбор крана, разобрано в разделе <a href="/seysmozony/">«Сейсмозоны»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины действует в Тихорецке так же, как в Краснодаре. С 1 марта 2026 года шуметь нельзя с 23:00 до 08:00 и с 13:00 до 15:00, а в выходные и праздники утренняя граница сдвигается до 10:00. Для юрлица штраф составляет от 20 до 30 тысяч рублей. Удалённость от моря и курортов здесь ничего не меняет: норма одна на весь край. Подробный разбор — в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине на Кубани»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <ul>
      <li>Тихорецк находится в 150 км к северо-востоку от Краснодара. Это город при железнодорожном узле Тихорецкая, в нём около 54 тысяч жителей.</li>
      <li>В июне 2026 года на ПМЭФ подписано соглашение о заводе упаковки «Л-Пак»: 9,3 млрд рублей и более 300 рабочих мест. Сроки и площадка публично не названы.</li>
      <li>ТМЗ им. Воровского (ИНН 2321003173) — действующий завод путевых машин, на котором регулярно ведут реконструкцию.</li>
      <li>Если площадка примыкает к путям, ограничение зоны работы крана закладывают в ППР заранее.</li>
      <li>Балл сейсмичности для Тихорецка в статье сознательно не назван: источник не подтвердил строку.</li>
      <li>Закон №608-КЗ о тишине действует здесь так же, как во всём крае.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://megabook.ru/article/Тихорецк', label: 'megabook.ru — Тихорецк: статус города, расположение' },
      { href: 'https://www.tihoretsk-gorod.ru/index.php/gorodskaya-sreda/o-gorode', label: 'tihoretsk-gorod.ru — о городе: железнодорожный узел, население' },
      { href: 'https://www.dg-yug.ru/news/20245413.html', label: 'dg-yug.ru — в Тихорецке планируют построить производство упаковки за 9,3 млрд руб., 05.06.2026' },
      { href: 'https://www.publish.ru/news/202606_20099237', label: 'publish.ru — «Л-Пак» построит завод в Тихорецке, 08.06.2026' },
      { href: 'https://tmzv.ru/company/about/', label: 'tmzv.ru — ОАО «ТМЗ им. В. В. Воровского»: о компании, заказчики' },
      { href: 'https://www.rusprofile.ru/id/2891058', label: 'rusprofile.ru — ОАО «ТМЗ им. В. В. Воровского», ИНН 2321003173' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
