---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 106. Шестьдесят третья статья блога — угол (a) информационный/how-to.
// Демонтаж башенного крана: парная тема к «Монтаж башенного крана: сроки»
// (Волна 103), где цифры по демонтажу сознательно не приводились.
//
// Фактура — проверена 06.10.2026 (WebSearch + WebFetch):
// - stroy-technics.ru: краны демонтируют в порядке, обратном монтажу; в
//   стеснённых условиях порядок нарушают; перед работой проверяют грузовую и
//   стреловую лебёдки и регулируют тормоза; внимание — запасовке канатов и
//   креплению элементов; альтернативы — другой башенный кран, стреловые
//   краны, элементы здания как якоря;
// - glavarendakran.com: «в среднем на разборку уходит несколько дней»;
//   привлекают другие (более высокие) краны; нестандартные случаи —
//   индивидуально;
// - stroy-technics.ru (приставные): в ограниченном пространстве краны КБ-573 и
//   КБ-676 разбирают на отдельные узлы стреловым краном; секции башни снимают
//   до минимально допустимого уровня;
// - exkavator.ru: болты снимают, секции опускает автокран с вылетом стрелы,
//   превышающим высоту башни; к моменту демонтажа вокруг уже стоят
//   многоэтажные здания, место под автокран ограничено.
// Сроков в часах и днях по моделям парка не называю — источники их не дают.
// giraFFe SMK-5.66: только собственный факт сайта — монтаж 4–6 часов силами
// двух человек и автокрана 25 т (parkModels.ts).

const CHECKED = '6 октября 2026 года';
const PUBLISHED = '2026-10-06';

const title = 'Демонтаж башенного крана: порядок разборки на площадке';
const description = 'Башенный кран разбирают в порядке, обратном монтажу, за несколько дней; в тесноте порядок меняют. Что проверяют до начала и как снимают секции.';
const h1 = 'Демонтаж башенного крана: в каком порядке разбирают кран на площадке';
const crumbTitle = 'Демонтаж башенного крана';
const slug = 'demontazh-bashennogo-krana';

const H2 = [
  'Порядок демонтажа: обратный монтажу',
  'Что проверяют до начала разборки',
  'Чем снимают секции: автокран, другой кран, якоря',
  'Тесная площадка: когда порядок нарушают',
  'Демонтаж по моделям парка КРАН-КУБАНЬ',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'В каком порядке демонтируют башенный кран?',
    a: 'Башенный кран демонтируют в порядке, обратном монтажу: сначала снимают то, что ставили последним, — противовес, стрелу, оголовок, затем секции башни и в конце основание. КРАН-КУБАНЬ закладывает этот порядок в проект производства работ и меняет его только там, где стеснённая площадка не даёт опустить стрелу и секции.',
  },
  {
    q: 'Сколько дней длится демонтаж башенного крана?',
    a: 'Источники называют общий срок «несколько дней» и привязывают его к габаритам крана и месту установки. Точных часов по моделям отраслевые статьи не дают, поэтому КРАН-КУБАНЬ называет срок только после проекта производства работ, когда известны высота башни, число секций и место для автокрана.',
  },
  {
    q: 'Какая техника нужна для разборки башенного крана?',
    a: 'Обычно секции и стрелу снимает автокран, у которого вылет стрелы выше высоты башни. Если высота мешает, привлекают другой, более высокий башенный кран или стреловые краны. Для компактных конструкций возможен демонтаж вовсе без спецтехники — это зависит от модели и условий площадки.',
  },
  {
    q: 'Что проверяют перед демонтажем башенного крана?',
    a: 'Перед разборкой проверяют грузовую и стреловую лебёдки и регулируют их тормоза: кран демонтируют собственными механизмами, поэтому исправность лебёдок определяет безопасность всей работы. Отдельное внимание уделяют запасовке канатов и креплению элементов. КРАН-КУБАНЬ добавляет к этому проверку основания и свободного места под укладку секций.',
  },
  {
    q: 'Можно ли демонтировать кран, если вокруг уже построено здание?',
    a: 'Можно, но порядок меняют: к моменту разборки вокруг крана обычно стоят многоэтажные корпуса, и места для автокрана остаётся мало. Тогда кран разбирают на отдельные узлы стреловым краном, привлекают более высокий кран или используют элементы здания как якоря. Способ КРАН-КУБАНЬ определяет в проекте.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Демонтаж"
  published={PUBLISHED}
>
    <p slot="intro">Башенный кран разбирают в порядке, обратном монтажу, и на всю работу уходит в среднем несколько дней — точнее зависит от габаритов крана и места установки. Первыми снимают противовес и стрелу, последними — нижние секции и основание. Инженерная служба КРАН-КУБАНЬ определяет порядок и технику в проекте производства работ, потому что к моменту демонтажа вокруг крана уже стоит здание.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Основное правило демонтажа башенного крана — обратная последовательность монтажа: то, что ставили последним, снимают первым. В статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a> разобраны девять этапов сборки, и демонтаж КРАН-КУБАНЬ проходит те же этапы в обратную сторону, от верха к земле.</p>
    <p>На практике цепочка выглядит так: сначала отсоединяют и опускают противовесные плиты, затем разбирают контрстрелу и стрелу по секциям, снимают оголовок и кабину, после чего по очереди разбирают башню. Противовес — самые тяжёлые отдельные элементы, поэтому их снимают первыми и только с подъёмной техникой, рассчитанной на такой вес. Последним демонтируют основание: рельсовый путь или анкерные элементы фундамента.</p>
    <p>Практический вывод для заказчика: срок демонтажа нужно закладывать в график объекта так же, как срок монтажа. Источники называют общий срок «несколько дней» без привязки к модели, поэтому КРАН-КУБАНЬ не обещает часов заранее, а называет их после проекта производства работ.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Первое действие перед разборкой — проверка лебёдок: грузовую и стреловую лебёдки осматривают и регулируют их тормоза. Причина в том, что кран демонтируют его собственными механизмами, и неисправный тормоз на грузовой лебёдке превращает снятие противовеса в аварийную операцию. КРАН-КУБАНЬ ставит эту проверку первым пунктом перед разборкой.</p>
    <p>Второй пункт — канаты и крепёж. Специалисты отдельно отмечают запасовку канатов и крепление элементов: при разборке стрелы канат нужно не потерять и не защемить, а болтовые соединения секций — снять в правильном порядке, иначе секция провиснет при снятии нагрузки. Каждый стык КРАН-КУБАНЬ проверяет по списку до начала подъёма.</p>
    <p>Третий пункт — площадка. До начала работ КРАН-КУБАНЬ освобождает место под укладку снятых секций и под стоянку автокрана, закрывает опасную зону вокруг и проверяет основание под самим автокраном. Правила закрытия зоны описаны в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <table>
      <thead><tr><th>Способ</th><th>Когда применяют</th><th>Что нужно</th></tr></thead>
      <tbody>
        <tr><td>Автокран</td><td>Основной способ: секции опускают по очереди</td><td>Вылет стрелы выше высоты башни</td></tr>
        <tr><td>Другой башенный кран</td><td>Кран выше доступных автокранов</td><td>Более высокий кран на площадке</td></tr>
        <tr><td>Стреловые краны</td><td>Тесная площадка, разбор на узлы</td><td>Место для крана и укладки узлов</td></tr>
        <tr><td>Элементы здания как якоря</td><td>Стеснённые условия, нет места для спуска</td><td>Расчёт и проект производства работ</td></tr>
      </tbody>
    </table>
    <p>Основной способ — автокран: болты между секциями снимают, и автокран опускает каждую секцию вниз. Условие одно, зато жёсткое — вылет стрелы автокрана должен превышать высоту башни. Для невысокого крана КРАН-КУБАНЬ подбирает автокран под высоту башни, а для высокого — меняет схему, как указано в таблице.</p>
    <p>Если подходящего автокрана нет, КРАН-КУБАНЬ идёт по одному из трёх путей из таблицы: привлекает более высокий башенный кран, использует стреловые краны или опирается на элементы здания как на якоря. Выбор между ними — расчётная задача, а не вопрос вкуса, поэтому он фиксируется в проекте производства работ. Об этапе проекта можно прочитать на странице <a href="/etapy/">этапов работы</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Жёсткое ограничение демонтажа — свободное место: к моменту разборки вокруг башенного крана уже стоят многоэтажные корпуса, и автокрану негде развернуться. КРАН-КУБАНЬ учитывает это ещё при установке: если здание сложной конфигурации сомкнётся вокруг крана, места для опускания стрелы и башни не останется.</p>
    <p>В стеснённых условиях порядок демонтажа допускается нарушать: приставные краны вроде КБ-573 и КБ-676 разбирают на отдельные узлы стреловым краном, а секции башни снимают до минимально допустимого уровня перед перемещением. Для КРАН-КУБАНЬ из этого следует правило: место для демонтажа закладывают на этапе монтажа, а не за неделю до разборки. Пример с двумя кранами разобран в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>giraFFe SMK-5.66 монтируют за 4–6 часов силами двух человек и 25-тонного автокрана, и обратная операция для него по логике короче, чем для классических кранов. Опорный контур 4×4 м и отсутствие фундамента означают, что после снятия крана на площадке не остаётся основания, которое нужно разбирать. Точные часы демонтажа КРАН-КУБАНЬ не публикует — нет подтверждённых данных, только паспортное время монтажа.</p>
    <p>КБ-408.21 и Potain MDT 219 J10 — классические краны на рельсовом пути или фундаменте: их разбирают по секциям мачты, затем снимают противовес и стрелу, а в конце — путь. Для КБ-674А высота до 116–120 м приставным способом означает, что в проекте производства работ нужно заранее решить, чем снимать верхние секции: вылет обычного автокрана может не достать до вершины башни, поэтому КРАН-КУБАНЬ рассматривает другой, более высокий кран или иную схему.</p>
    <p>Для расчёта графика объекта пришлите адрес и этажность через <a href="/#order">форму на главной</a>: инженерная служба назовёт порядок демонтажа и необходимую технику. Выбор модели описан в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://stroy-technics.ru/article/demontazh-bashennykh-kranov', label: 'stroy-technics.ru — демонтаж башенных кранов: обратный порядок, проверка лебёдок и тормозов, способы в стеснённых условиях' },
      { href: 'https://stroy-technics.ru/article/montazh-demontazh-i-transportirovanie-pristavnykh-kranov', label: 'stroy-technics.ru — монтаж, демонтаж и транспортирование приставных кранов' },
      { href: 'https://www.glavarendakran.com/stati/razbor-bashennogo-krana/', label: 'glavarendakran.com — разборка башенного крана: срок «несколько дней», привлечение других кранов' },
      { href: 'https://exkavator.ru/main/news/inf_news/123743_ustroystvo_bashennogo_krana_montag_i_demontag_bashennih_kranov.html', label: 'exkavator.ru — устройство башенного крана, монтаж и демонтаж: опускание секций автокраном' },
      { href: 'https://giraffecrane.ru/', label: 'giraffecrane.ru — производитель быстромонтируемых кранов giraFFe' },
    ]} />
</BlogArticleLayout>
