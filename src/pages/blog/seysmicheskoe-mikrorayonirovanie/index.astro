---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 22 (расширение блога). Четвёртая статья блога, первый новый материал
// этой волны. Тема — прямое расширение зоны, закреплённой за этим сайтом в
// TOPIC-REGISTRY.md («Сейсмические требования к монтажу башенного крана...
// инженерные изыскания под фундамент»). До этой статьи раздел /seysmozony/ и
// этап /etapy/izyskaniya-i-grunt/ трижды называют карту сейсмического
// микрорайонирования «самым точным источником балла», но ни разу не отвечают,
// КАК её заказать: кто выполняет, сколько это стоит и сколько занимает по
// времени. Проверено grep-ом по src/ перед началом — ни одного упоминания
// РСН 65-87, сроков или стоимости СМР на сайте не было. Не пересказ трёх
// существующих страниц про баллы, а их практическое продолжение: страницы про
// баллы отвечают «что это значит», эта статья — «что делать, если карты
// недостаточно».

const CHECKED = '15 августа 2026 года';

const title = 'Сейсмическое микрорайонирование площадки: сроки и стоимость';
const description = 'Карта сейсмического микрорайонирования (СМР) точнее ОСР-2015, но её заказывают отдельно. Кто выполняет работы по РСН 65-87, сколько это занимает и стоит.';
const h1 = 'Сейсмическое микрорайонирование площадки: сроки, стоимость и место в графике монтажа';
const crumbTitle = 'Сейсмическое микрорайонирование';
const slug = 'seysmicheskoe-mikrorayonirovanie';

const H2 = [
  'Зачем вообще заказывать СМР, если есть карты ОСР-2015',
  'Что регулирует РСН 65-87',
  'Кто выполняет эти работы',
  'Сколько это занимает по времени',
  'Во сколько это обходится',
  'Куда СМР встаёт в график монтажа крана',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Обязательно ли заказывать СМР для любого объекта в сейсмоопасной зоне края?',
    a: 'Нет. Для большинства объектов капитального строительства достаточно балла по картам ОСР-2015 или по данным изысканий, уже выполненных для проекта здания, — они разобраны в разделе «Сейсмические зоны». Отдельное СМР заказывают точечно: для площадок повышенного уровня ответственности, при явном расхождении карты с фактическим грунтом или когда изысканий под здание не было вовсе.',
  },
  {
    q: 'Можно ли ускорить СМР, если сроки монтажа поджимают?',
    a: 'Частично — если заказать работы заранее, до того как их отсутствие станет узким местом графика. Сама методика инструментальных измерений требует определённого времени в поле независимо от срочности заказа; резко сжать её без потери точности результата нельзя. Поэтому решение о необходимости СМР стоит принимать на этапе изысканий, а не после того, как проект монтажа уже свёрстан под конкретную дату.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Сейсмическое микрорайонирование', item: `${SITE}/blog/seysmicheskoe-mikrorayonirovanie/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/seysmicheskoe-mikrorayonirovanie/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/seysmicheskoe-mikrorayonirovanie/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Раздел <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны края»</a> трижды повторяет одну и ту же оговорку: самый точный источник расчётной сейсмичности площадки — не карта ОСР-2015 и не таблица населённых пунктов, а карта сейсмического микрорайонирования (СМР) конкретного участка. Там же честно сказано, что «балл конкретного адреса по телефону мы не называем» — без такой карты или отчёта по изысканиям это была бы догадка. Логичный следующий вопрос — что представляет собой эта карта, кто её делает, сколько это стоит и сколько времени занимает. Ни на одной странице сайта до этой статьи ответа на него не было.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Карты общего сейсмического районирования ОСР-2015 в составе СП 14.13330.2018 дают балл для площадки размером в десятки и сотни километров и для «средних» грунтовых условий — грунтов II категории. Как разобрано в этапе <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>, реальная площадка почти никогда не «средняя»: рыхлый прибрежный песок или, наоборот, плотные скальные грунты сдвигают фактическую сейсмичность относительно карты в ту или другую сторону, причём разница может достигать целого балла — а балл в сейсмическом расчёте означает не прибавку «немного», а двукратное изменение расчётного ускорения.</p>
    <p>Сейсмическое микрорайонирование закрывает именно этот разрыв: вместо балла для района или города оно даёт балл для конкретного участка, с учётом фактического строения грунтовой толщи под ним. Для объектов повышенного уровня ответственности, для площадок с явно нестандартным основанием или там, где данные карты и данные изысканий расходятся, это не факультативное уточнение, а единственный способ получить проверяемую цифру вместо оценки по региону.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Технические требования к производству работ по сейсмическому микрорайонированию задаёт документ РСН 65-87 «Инженерные изыскания для строительства. Сейсмическое микрорайонирование. Технические требования к производству работ» — региональные строительные нормы, устанавливающие методику для территорий проектирования и строительства новых, а также реконструкции существующих зданий и сооружений в сейсмических районах 7, 8 и 9 баллов по шкале, использовавшейся в СНиП II-7-81. Документ прямо не распространяется на изыскания под отдельные специальные объекты вроде крупных плотин, атомных станций или тоннелей — у них своя, более строгая методика, — но для площадки капитального строительства с башенным краном это ровно тот документ, по которому исполнитель обязан вести работу.</p>
    <p>В основе методики — сопоставление инженерно-геологического районирования площадки, выполненного по требованиям смежного документа РСН 60-86, с сейсмическими свойствами грунтов: территорию делят на участки, однородные по сочетанию геологических условий, а затем для каждого участка определяют поправку к фоновому баллу площадки. Поправку получают одним из двух подходов, применяемых в комбинации: расчётным методом сейсмических жёсткостей, который сравнивает акустическую жёсткость грунтов на площадке со средними («эталонными») грунтами карты ОСР, и инструментальными наблюдениями — записью реальных микроколебаний или отголосков далёких землетрясений непосредственно на участке. Инструментальный метод точнее, но дольше и дороже расчётного, и для рядового объекта капитального строительства обычно достаточно первого.</p>
    <p>Итоговый пакет документов — не просто цифра, а карта СМР с нанесёнными границами однородных участков и присвоенным каждому расчётным баллом, плюс пояснительная записка с описанием методики и исходных данных. Именно эта карта, а не устная оценка «у нас тут восемь», прикладывается затем к проекту монтажа как основание для расчёта фундамента и анкеровки на этапе <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 18px">{headings[2].text}</h2>
    <p>Сейсмическое микрорайонирование — часть инженерных изысканий, а значит, его вправе выполнять только специализированная изыскательская организация, а не подрядчик по монтажу крана и не проектировщик здания напрямую. На практике это отдельная строка в составе инженерно-геологических или инженерно-геофизических изысканий, которую заказывают либо застройщик на этапе проектирования объекта, либо — в нестандартных случаях, разобранных в статье <a href="/blog/izyskaniya-pered-montazhom-krana/" style="color:var(--accent)">«Инженерные изыскания перед монтажом крана»</a> — тот, кто отвечает за подготовку площадки под кран отдельно от здания.</p>
    <p>Как и любые инженерные изыскания, работы по СМР вправе вести только организация, отвечающая требованиям к членству в соответствующей саморегулируемой организации — самостоятельно, без допуска СРО, заказать такую карту нельзя, и это ещё одна причина не пытаться получить «примерный балл» у случайного исполнителя ради экономии времени. На практике СМР почти всегда заказывают в одном пакете с общими инженерно-геологическими изысканиями объекта, а не отдельным договором с нуля — тогда часть данных о грунте не дублируется, а переиспользуется.</p>
    <p>Наша часть на этом этапе не техническая, а организационная: мы не проводим СМР сами и не подменяем изыскательскую организацию, но при приёме заявки на объект в сейсмоопасной зоне спрашиваем, есть ли у заказчика уже готовая карта микрорайонирования или отчёт по изысканиям, чтобы заложить в проект монтажа проверяемый балл, а не средний по карте ОСР-2015.</p>

    <h2 id={headings[3].id} style="margin:36px 0 18px">{headings[3].text}</h2>
    <p>Срок выполнения работ по сейсмическому микрорайонированию у изыскательских организаций обычно указывается от 20 рабочих дней — это ориентир для площадки типового размера при уже готовых исходных данных инженерной геологии. По более широким оценкам практикующих организаций диапазон шире — от 7 до 30 дней в зависимости от сложности задачи, площади участка и от того, насколько быстро заказчик предоставляет уже имеющиеся материалы прежних изысканий. Это заметно дольше, чем получение балла по табличному ориентиру из свода правил, и именно поэтому решение «нужна ли отдельная карта СМР» правильнее принимать в начале проекта, а не тогда, когда дата монтажа уже согласована с арендодателем техники.</p>
    <p>Само измерение — полевой процесс: инструментальные и расчётные методы требуют выезда на площадку и определённого времени работы там, и это время нельзя сжать пропорционально желаемой скорости проекта без потери точности результата, ради которой СМР вообще заказывают.</p>

    <h2 id={headings[4].id} style="margin:36px 0 18px">{headings[4].text}</h2>
    <p>Стоимость работ по сейсмическому микрорайонированию у изыскательских организаций начинается от порядка 60 000 рублей — это ориентир для простейших условий и участка площадью примерно до 1 гектара; итоговая цена зависит от площади, сложности геологического строения, требуемой детальности карты и удалённости объекта. Публичные ориентиры такого рода стоит воспринимать именно как отправную точку для разговора с изыскательской организацией, а не как готовую цифру для сметы: точный расчёт зависит от конкретной площадки и запрашивается индивидуально.</p>
    <p>Главный фактор, который двигает цену вверх, — не столько площадь участка, сколько выбранный метод и число точек наблюдения: чисто расчётная оценка по методу сейсмических жёсткостей обходится дешевле, а привлечение инструментальных измерений в нескольких точках на сложном по геологии участке увеличивает и смету, и срок. Заказчику имеет смысл спрашивать у изыскательской организации не только итоговую сумму, но и то, каким методом получен балл, — это тот же принцип, что и с картами ОСР-2015: важна не только цифра, но и то, каким способом она получена.</p>
    <p>Для сравнения масштаба: смета владения краном на объекте, доступная в калькуляторе на главной странице сайта, считается сотнями тысяч рублей за месяц аренды башенного крана. Расходы на отдельное СМР — величина другого порядка и, как правило, не решающий фактор в общей стоимости проекта, но фактор, который нужно учитывать заранее в бюджете и в сроке подготовки площадки, а не как неожиданную статью расходов посреди монтажа.</p>

    <h2 id={headings[5].id} style="margin:36px 0 18px">{headings[5].text}</h2>
    <p>По циклу из пяти этапов, разобранному в разделе <a href="/etapy/" style="color:var(--accent)">«Этапы работы крана»</a>, вопрос о необходимости СМР решается на первом этапе — <a href="/etapy/izyskaniya-i-grunt/" style="color:var(--accent)">«Изыскания и грунт»</a>, до подписания договора. Если ответ положительный, срок выполнения работ (от 20 рабочих дней и больше) закладывается как отдельный пункт графика подготовки объекта, параллельно с проектированием, а не последовательно после него — иначе он становится узким местом, отодвигающим весь монтаж на недели.</p>
    <p>Результат СМР напрямую влияет на следующий этап — <a href="/etapy/proekt-i-ppr/" style="color:var(--accent)">«Проект и ППР»</a>: уточнённый балл площадки определяет, какую сейсмическую нагрузку закладывает расчёт фундамента и анкеровки на этапе <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a>. Если карта СМР показывает балл ниже, чем консервативная оценка по ОСР-2015 и таблице населённых пунктов, расчёт основания может оказаться легче ожидаемого; если выше — наоборот, и это тоже правильнее узнать на этапе изысканий, а не после заливки фундамента под кран.</p>

    <h2 id={headings[6].id} style="margin:36px 0 18px">{headings[6].text}</h2>
    <ul>
      <li>Сейсмическое микрорайонирование (СМР) даёт балл для конкретной площадки, а не для района или населённого пункта — точнее карт ОСР-2015 из СП 14.13330.2018.</li>
      <li>Технические требования к производству работ задаёт РСН 65-87, применяется для площадок сейсмичностью 7, 8 и 9 баллов.</li>
      <li>Выполняют работы только специализированные изыскательские организации — это часть инженерных изысканий, а не услуга подрядчика по крану.</li>
      <li>Срок — ориентировочно от 20 рабочих дней, по отдельным оценкам от 7 до 30 дней в зависимости от сложности и площади участка.</li>
      <li>Стоимость — ориентировочно от 60 000 рублей для простых условий на участке до 1 га; точная цена зависит от конкретной площадки.</li>
      <li>Решение о заказе СМР принимают на этапе изысканий — до подписания договора на монтаж, чтобы срок работ не стал неожиданным препятствием в уже согласованном графике.</li>
    </ul>
    <p>Что делать с готовым баллом площадки на следующих этапах монтажа — в разделах <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны края»</a> и <a href="/documents/" style="color:var(--accent)">«Документы монтажа башенного крана»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://znaytovar.ru/gost/2/RSN_6587_Inzhenernye_izyskaniy.html', label: 'РСН 65-87 — технические требования к производству работ по сейсмическому микрорайонированию' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018, карты ОСР-2015 и область применения по баллам' },
      { href: 'https://innoter.com/services/prochee/seysmicheskoe-mikrorayonirovanie/', label: 'innoter.com — сроки и стоимость работ по сейсмическому микрорайонированию' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
    ]} />
</BlogArticleLayout>
