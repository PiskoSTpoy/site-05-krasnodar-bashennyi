---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 86. Двадцать первая статья блога — Крымский район, город на реке
// Адагум между уже разобранными Абинским районом и Славянском-на-Кубани.
// Не новая ось, а третий город на равнинной степной части края, но с
// собственным, ни у кого больше не встречавшимся вводным фактором:
// катастрофическое наводнение в ночь на 7 июля 2012 года (официально 172
// погибших, из них 153 — в Крымске и Крымском районе) и последующая
// реконструкция русла Адагума (уширение с 15 до 35-50 метров на участке
// 4,5 км в черте города, бетонный лоток). Это не «обычная» поёмная
// подтопляемость, как в Славянске-на-Кубани, а разовая катастрофа с
// инженерными последствиями для площадок у реки.
//
// Экономический слой — два реальных объекта:
// 1) ООО «Крымский винный завод» (ИНН 2337026352) — действует с 1926 года,
//    около 20 сортов винограда, ассамбляжные и моносортовые вина; на
//    10.05.2026 налоговой задолженности не числится (rusprofile).
// 2) ООО «Колос Кубани» (ИНН 2304073639) — интенсивный яблоневый сад на 400
//    га, инвестиции 3,5 млрд руб. (Коммерсантъ, Агроинвестор, 2020 год),
//    логистический центр на хранение до 20 000 тонн. В марте 2026 года
//    хозяйство приобрёл «Магнит» за 1,8 млрд руб. и объявил о дополнительных
//    инвестициях до 1,4 млрд руб. в расширение — новые линии сортировки и
//    фасовки, холодный склад, камеры газации (Коммерсантъ, kubnews.ru,
//    ko.ru, tadviser, logistics.ru). Именно строительство холодного склада
//    и новых линий — прямой источник спроса на кран в районе, а не только
//    сельхозпроизводство как таковое.
//
// Как и в Волнах 76-80, 83-85, egress сессии не пропускал прямой доступ к
// docs.cntd.ru и base.garant.ru (Приложение Б ТСН 22-302-2000), а также к
// kommersant.ru, tass.ru и 93.ru напрямую — балл сейсмики для района в
// статье сознательно не назван, факты о наводнении и предприятиях взяты из
// нескольких независимых источников через WebSearch.

const CHECKED = '11 сентября 2026 года';

const title = 'Кран для Крымского района: винзавод старше века и урок наводнения 2012 года';
const description = 'Крымский район на реке Адагум: катастрофа июля 2012 года, действующий винзавод с 1926 года и стройка холодного склада на площадке бывшего «Колос Кубани» — что это значит для монтажа башенного крана.';
const h1 = 'Кран для Крымского района: винзавод старше века и урок наводнения 2012 года';
const crumbTitle = 'Кран для Крымского района';
const slug = 'kran-dlya-krymskogo-rayona';

const H2 = [
  'Крымский район — город на Адагуме между Абинским районом и Славянском-на-Кубани',
  'Наводнение 2012 года: почему площадка у Адагума требует отдельного взгляда на грунт',
  'Крымский винный завод: производство с 1926 года',
  '«Колос Кубани» и «Магнит»: от яблоневого сада к холодному складу',
  'Сейсмика: что можно сказать про Крымский район, а что нет',
  'Закон о тишине действует и здесь — без региональной скидки',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Наводнение было в 2012 году — актуально ли это для площадки, которую строят в 2026 году?',
    a: 'Дата события не делает фактор устаревшим. Русло Адагума в черте города реконструировано — расширено и одето в бетон, — но это снижает риск повторного разлива, а не отменяет саму пойму как географическую данность. Для площадки в границах прежней зоны затопления инженерно-геологические изыскания перед монтажом крана остаются обязательным шагом независимо от того, сколько лет прошло с последней катастрофы: инженерный расчёт опирается на характеристики конкретного грунта, а не на календарь.',
  },
  {
    q: 'Правда ли, что сейсмика Крымского района ниже, чем у более южных районов края?',
    a: 'Мы не можем это утверждать и потому не приводим в статье конкретную цифру. Доступные в этой волне источники не подтвердили прямой цитатой строку Крымского района в Приложении Б ТСН 22-302-2000 — так же, как ранее не подтвердили её для Абинского, Северского и ряда других районов. Расчётный балл для конкретной площадки определяет проектировщик по действующей редакции норматива, а не географическая близость к побережью.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Крымского района', item: `${SITE}/blog/kran-dlya-krymskogo-rayona/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-krymskogo-rayona/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-krymskogo-rayona/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал равнинную степную часть края на примере Абинского района (металлургия) и Славянска-на-Кубани (нефтепереработка и регулярно подтопляемая пойма Кубани и Протоки). Крымский район стоит между ними на карте — тот же коридор Краснодар — Новороссийск, та же степь без гор и моря, — но вводный фактор здесь другой: не сезонное подтопление, а разовая катастрофа на реке Адагум, оставившая инженерный след, который важен для площадки и четырнадцать лет спустя.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Город Крымск — административный центр Крымского района, расположенный на реке Адагум примерно на полпути между Абинском и Новороссийском. Через район проходит тот же транспортный узел, что связывает краевой центр с портовым городом, а сама застройка ведёт историю от казачьей станицы Крымской, основанной в 1863 году. Курортной функции у района нет: спрос на технику формируют промышленность, сельское хозяйство и обычная городская стройка, а не туристический сезон.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>В ночь на 7 июля 2012 года после ливня, за несколько часов превысившего месячную норму осадков в 3-5 раз, река Адагум вышла из берегов и затопила большую часть Крымска. По официальным данным, жертвами наводнения в крае стали 172 человека, из них 153 — в Крымске и Крымском районе; пострадали десятки тысяч жителей, были разрушены и повреждены жилые дома, школы, больницы, дороги и инженерные сети. Это одна из самых тяжёлых техногенно-природных катастроф в новейшей истории края, и для строительной площадки в черте города она не абстрактная историческая справка, а прямая причина отдельного взгляда на грунт и гидрологию участка.</p>
    <p>После наводнения русло Адагума в черте Крымска реконструировали: очистили от наносов и деревьев, углубили, а берега и дно на участке протяжённостью 4,5 км одели в железобетонный лоток. Ширина русла, до реконструкции составлявшая около 15 метров, увеличена минимум до 35 метров, а на отдельных участках — до 50 метров. Это снижает риск повторного разлива, но не отменяет саму пойму как географическую данность: для площадки в прежней зоне подтопления инженерно-геологические изыскания перед монтажом крана — не формальность, а обязательный шаг, о котором подробно рассказано в статье «Инженерные изыскания перед монтажом крана».</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>ООО «Крымский винный завод» (ИНН 2337026352, город Крымск, улица Синева, дом 15) — действующее производство с историей, отсчитываемой с 1926 года: сегодня завод выращивает порядка двадцати сортов винограда, выпускает ассамбляжные и моносортовые тихие и игристые вина. По данным реестровых источников, на середину 2026 года налоговой задолженности за предприятием не числится, что подтверждает его текущую работу. Для арендодателя крана это в первую очередь стабильный, хоть и не самый техникоёмкий заказчик: винодельческое производство модернизируется постепенно, а не единовременными масштабными стройками, характерными для металлургии или нефтепереработки соседних районов.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Куда более прямой источник спроса на кран в районе — площадка ООО «Колос Кубани» (ИНН 2304073639). С 2020 года здесь реализуется проект интенсивного яблоневого сада на 400 гектарах с общим объёмом инвестиций 3,5 миллиарда рублей и логистическим центром, рассчитанным на хранение до 20 000 тонн продукции. В марте 2026 года хозяйство приобрёл ритейлер «Магнит» за 1,8 миллиарда рублей — в рамках выхода в промышленное выращивание голубики и яблок — и объявил о дополнительных инвестициях до 1,4 миллиарда рублей в расширение площадей и мощностей: новые линии сортировки и фасовки, холодный склад, камеры газации. Именно строительство и модернизация складской и перерабатывающей инфраструктуры такого масштаба — а не сам по себе рост площади сада — формирует предметный спрос на монтаж техники: холодный склад и производственные линии возводятся не на голом поле, а с подведением капитальных конструкций, для которых используется кран.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Здесь мы, как и в статьях про Абинский, Северский и ряд других районов, сознательно не приводим конкретный балл сейсмичности. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Крымского района доступные в этой волне источники надёжно не подтвердили. Соседство на карте с уже разобранными районами ничего не говорит о том, совпадает расчётный балл или отличается: это вопрос к действующей редакции норматива для конкретной площадки, а не к географической близости. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Крымском районе так же, как в Сочи или Краснодаре: с 1 марта 2026 года рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дневным перерывом, а ответственность по статье 3.3 одинакова для всего края независимо от того, идёт речь о стройке холодного склада на бывшей площадке «Колос Кубани» или о частном доме в станице. Подробный разбор часов и сумм штрафов — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <ul>
      <li>Крымский район — степной город на реке Адагум между уже разобранными Абинским районом и Славянском-на-Кубани, без курортной функции.</li>
      <li>Наводнение в ночь на 7 июля 2012 года (официально 172 погибших по краю, из них 153 — в Крымске и районе) остаётся причиной для отдельных изысканий на площадках в прежней пойме, даже после реконструкции русла Адагума (уширение с 15 до 35-50 м на 4,5 км в черте города).</li>
      <li>Действующий якорь пищевой промышленности — ООО «Крымский винный завод» (ИНН 2337026352), работает с 1926 года.</li>
      <li>Прямой источник спроса на кран — стройка холодного склада и линий сортировки на площадке ООО «Колос Кубани» (ИНН 2304073639) после её покупки «Магнитом» в марте 2026 года за 1,8 млрд руб. и объявленных инвестиций до 1,4 млрд руб.</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Крымского района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Крымском районе так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.rusprofile.ru/id/3831088', label: 'rusprofile.ru — ООО «Крымский винный завод», ИНН 2337026352' },
      { href: 'https://spark-interfax.ru/krasnodarski-krai-krymski-raion/ooo-kolos-kubani-inn-2304073639-ogrn-1182375065916-733520d379b80975e0531b9aa8c06631', label: 'spark-interfax.ru — ООО «Колос Кубани», ИНН 2304073639' },
      { href: 'https://www.agroinvestor.ru/regions/news/34924-na-kubani-poyavitsya-yablonevyy-sad-za-3-5-mlrd-rubley/', label: 'agroinvestor.ru — инвестиции 3,5 млрд руб. в яблоневый сад «Колос Кубани»' },
      { href: 'https://www.kommersant.ru/doc/8477794', label: 'kommersant.ru — покупка «Магнитом» хозяйства «Колос Кубани» за 1,8 млрд руб.' },
      { href: 'https://kubnews.ru/amp/obshchestvo/2026/03/02/magnit-priobrel-proizvoditelya-golubiki-i-yablok-v-krymskom-rayone-za-1-8-mlrd-rubley/', label: 'kubnews.ru — детали сделки и планы «Магнита» по расширению (холодный склад, линии сортировки)' },
      { href: 'https://ru.wikipedia.org/wiki/%D0%9D%D0%B0%D0%B2%D0%BE%D0%B4%D0%BD%D0%B5%D0%BD%D0%B8%D0%B5_%D0%B2_%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%BE%D0%B4%D0%B0%D1%80%D1%81%D0%BA%D0%BE%D0%BC_%D0%BA%D1%80%D0%B0%D0%B5_(2012)', label: 'ru.wikipedia.org — наводнение в Краснодарском крае 2012 года, хроника и число погибших' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
    ]} />
</BlogArticleLayout>
