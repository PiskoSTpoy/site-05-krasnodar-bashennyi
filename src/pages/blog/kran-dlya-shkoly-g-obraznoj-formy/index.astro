---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 120. Сто пятая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «школа Г-образного плана»: крыло А 54 × 14 м вдоль оси x, крыло Б 42 × 14 м вдоль оси y,
// общий угловой блок 14 × 14 м, высота 15 м (три этажа по 5 м — иллюстрация, помечена в тексте).
// Отличие от предыдущих сценариев: здание НЕ прямоугольник; низкое (15 м), поэтому высота перестаёт быть
// ограничением и решает вылет и место стоянки. Сравниваются две стоянки: S1 — двор в 6 м от обеих внутренних
// стен (координаты 20; 20), S2 — снаружи у внешнего угла в 6 м по диагонали от стен (−6; −6).
// Расчёты (метры, плоская схема): потребный крюк 15 + 0,5 (п. 114 ФНП № 461) + 3 + 4 = 22,5 м.
// S1: до (54;0) √(34² + 20²) = √1556 = 39,45; до (54;14) √(34² + 6²) = √1192 = 34,53;
//     до (0;42) √(20² + 22²) = √884 = 29,73; до (14;42) √(6² + 22²) = √520 = 22,80; до (0;0) √800 = 28,28.
//     Наибольшее 39,45 м. Запас: КБ-408.21 (40 м) +0,55; SMK-5.66 (43 м) +3,55; КБ-674А (50,5 м) +11,05;
//     MCH 175 (55 м) +15,55; MDT 219 J10 (65 м) +25,55.
// S2: до (54;14) √(60² + 20²) = √4000 = 63,25; до (54;0) √(60² + 6²) = √3636 = 60,30; до (14;42) √(20² + 48²) = √2704 = 52,0;
//     до (0;42) √(6² + 48²) = √2340 = 48,37. Наибольшее 63,25 м: только MDT 219 J10 (+1,75 м).
// Фактура — только parkModels.ts: SMK-5.66 крюк до 27 м (гориз.) / 41,7 м (наклон 20°), вылет 43 м, 1,05 т на 43 м,
// опорный контур 4 × 4 м; КБ-408.21 — 40 м, 54,0–72,7 м, рельсовый путь; КБ-674А — 50,5 м, 5,6 т на 50,5 м;
// MCH 175 — до 55 м, до 58,5 м, 1,5 т на 55 м; MDT 219 J10 — 65 м, до 70,4 м, 1,9 т на 65 м.
// НЕ названо: цены, сроки, нормы СанПиН/школьных зон, массы элементов, требования к демонтажу как нормы.

const CHECKED = '26 октября 2026 года';
const PUBLISHED = '2026-10-26';

const title = 'Кран для школы Г-образной формы: двор или внешний угол';
const description = 'Школа Г-образного плана, высота 15 м: из двора достаточно вылета 39,45 м, с внешнего угла нужно 63,25 м. Расчёт КРАН-КУБАНЬ по пяти моделям и двум стоянкам.';
const h1 = 'Где ставить башенный кран у школы Г-образной формы: во дворе или снаружи';
const crumbTitle = 'Кран для школы Г-образной формы';
const slug = 'kran-dlya-shkoly-g-obraznoj-formy';

const H2 = [
  'Исходные данные примера: два крыла по 14 м и высота 15 м',
  'Потребная высота крюка 22,5 м: кому она по силам',
  'Стоянка S1 во дворе: наибольший вылет 39,45 м',
  'Стоянка S2 у внешнего угла: вылет 63,25 м',
  'Запас по вылету: почему КБ-408.21 проходит на 0,55 м',
  'Когда низкая школа открывает дорогу быстромонтируемому крану',
  'Двор-колодец: что остаётся за пределами расчёта',
  'Сводка: модель, запас вылета на двух стоянках и вывод',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Достаточно ли одного башенного крана для школы Г-образной формы?',
    a: 'Достаточно, если кран стоит во внутреннем углу двора. В примере КРАН-КУБАНЬ крылья 54 и 42 м, кран в 6 м от обеих стен, и наибольшее расстояние до здания — 39,45 м до дальнего угла длинного крыла. Этот вылет есть у всех пяти моделей парка, у КБ-408.21 запас составляет 0,55 м.',
  },
  {
    q: 'Где лучше ставить башенный кран у здания Г-образного плана?',
    a: 'Во внутреннем углу, потому что оба крыла лежат вокруг крана и вылет работает с обеих сторон. В примере КРАН-КУБАНЬ двор даёт 39,45 м против 63,25 м при стоянке у внешнего угла. Разница 23,8 м означает, что снаружи подойдёт только Potain MDT 219 J10 с вылетом 65 м.',
  },
  {
    q: 'Хватит ли быстромонтируемого крана для трёхэтажной школы?',
    a: 'При высоте здания 15 м и допущениях КРАН-КУБАНЬ потребный крюк составляет 22,5 м, а giraFFe SMK-5.66 поднимает крюк до 27 м и с горизонтальной стрелой. Вылета 43 м из двора хватает с запасом 3,55 м. Грузоподъёмность на вылете 43 м — 1,05 т, и тяжёлые элементы раскладывают ближе к крану.',
  },
  {
    q: 'Почему во дворе-колодце важен порядок демонтажа?',
    a: 'Кран, поставленный во внутреннем углу, оказывается окружён готовыми стенами, и автокрану для демонтажа нужен проезд к основанию. Порядок согласуют заранее, чтобы последние секции фасада не перекрыли подъезд. Это практика КРАН-КУБАНЬ, а не норма, детали разобраны в статье о демонтаже башенного крана.',
  },
  {
    q: 'Как проверить вылет для школы с другими размерами крыльев?',
    a: 'Выбирают стоянку, считают расстояние от неё до каждого дальнего угла по формуле √(Δx² + Δy²) и берут наибольшее значение. Вылет модели должен быть больше него с запасом, а потребный крюк определяют по формуле: высота здания + 0,5 м + высота груза + длина строп. Размеры в проекте заменяют фактическими.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Школа"
  published={PUBLISHED}
>
    <p slot="intro">Для школы Г-образного плана с крыльями 54 и 42 м и высотой 15 м башенному крану нужен вылет 39,45 м, если кран стоит во внутреннем углу двора, и 63,25 м, если его поставить у внешнего угла. Разница в 23,8 м сильнее любой разницы между моделями: из двора подходят все пять кранов парка КРАН-КУБАНЬ, снаружи — только Potain MDT 219 J10.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Для расчёта КРАН-КУБАНЬ взял условную школу Г-образного плана: длинное крыло 54 × 14 м, короткое крыло 42 × 14 м, общий угловой блок 14 × 14 м. Высота 15 м соответствует трём этажам по 5 м с учётом высоких спортивных и актовых помещений. Размеры выбраны для иллюстрации и не относятся к реальному объекту, а метод от них не зависит.</p>
    <p>Отличие от прямоугольных домов, разобранных в статьях <a href="/blog/kran-dlya-zhilogo-doma-iz-treh-sekciy/">«Кран для жилого дома из трёх секций»</a> и <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>, в форме здания. У буквы «Г» есть внутренний угол, куда можно поставить кран так, что оба крыла окажутся по две стороны от него. Для этого случая считают расстояния до дальних точек обоих крыльев сразу.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Потребная высота крюка равна высоте здания плюс 0,5 м запаса над препятствиями, высота груза и длина строп: 15 + 0,5 + 3 + 4 = 22,5 м. Запас 0,5 м берут из пункта 114 ФНП № 461; груз 3 м и стропы 4 м — допущения КРАН-КУБАНЬ, которые в проекте заменяют по самому высокому элементу.</p>
    <p>Высота 22,5 м не отсекает ни одну модель. giraFFe SMK-5.66 поднимает крюк до 27 м даже с горизонтальной стрелой, запас 4,5 м. Остальные модели КРАН-КУБАНЬ превосходят потребную высоту многократно: Potain MCH 175 — до 58,5 м, КБ-674А — до 60 м свободно, Potain MDT 219 J10 — до 70,4 м, КБ-408.21 — от 54,0 м. Сравнение высот — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Стоянка S1 расположена в 6 м от обеих внутренних стен угла, то есть в точке с координатами (20; 20) при начале координат во внешнем углу здания. Самая далёкая точка здания от неё — внешний торец длинного крыла: √(34² + 20²) = √1556 = 39,45 м. Остальные дальние углы ближе: 34,53 м до северо-восточного угла длинного крыла и 29,73 м до торца короткого.</p>
    <p>Расчёт КРАН-КУБАНЬ выполнен на плоской схеме и не учитывает габариты противовеса, соседние постройки и ограждение. Для школы он показывает главное: во дворе вылет определяет длинное крыло, а короткое попадает в радиус без напряжения. Вылет моделей по паспортам — в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Стоянка S2 выбрана снаружи Г-образного здания, в 6 м по диагонали от внешнего угла, в точке (−6; −6). Теперь оба крыла уходят от крана в одну сторону, и самый дальний угол — северо-восточный у длинного крыла: √(60² + 20²) = √4000 = 63,25 м. До торца длинного крыла 60,30 м, до торца короткого — 48,37 м.</p>
    <p>Вылет 63,25 м перекрывает только Potain MDT 219 J10 с вылетом 65 м и запасом 1,75 м. Остальные модели парка КРАН-КУБАНЬ не достают: Potain MCH 175 уступает 8,25 м, КБ-674А — 12,75 м, giraFFe SMK-5.66 — 20,25 м, КБ-408.21 — 23,25 м. Поэтому внешний угол оправдан, только когда двор нельзя занять, например из-за подземных сетей или проезда.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>КБ-408.21 с вылетом 40 м закрывает 39,45 м из двора, но запас составляет всего 0,55 м. Такой запас означает, что любое смещение стоянки от расчётной точки на несколько метров в сторону внешнего угла выводит дальний угол за пределы стрелы. Допустимое смещение зависит от направления, и его определяют по плану в ППР, а не по таблице.</p>
    <p>Для КБ-408.21 на наземном рельсовом пути запас подкрепляется возможностью сдвинуть кран вдоль пути, но тогда в расчёт входят длина пути и его основание. Условия — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>, страница модели — <a href="/park/kb-408-21/">КБ-408.21</a>. Запас у остальных моделей двора шире: 3,55 м у giraFFe SMK-5.66, 11,05 м у КБ-674А, 15,55 м у Potain MCH 175.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Низкая школа — тот случай, где giraFFe SMK-5.66 выглядит естественным выбором. Крюк модели до 27 м при потребных 22,5 м, вылет 43 м при расстоянии 39,45 м, опорный контур 4 × 4 м без фундамента. Все три ограничения проходят, а подготовка основания сводится к площадке во дворе.</p>
    <p>Платой становится грузоподъёмность: 1,05 т на вылете 43 м и 5 т максимума. Лёгкие элементы кладки и перегородок на дальнем крыле подходят, тяжёлые плиты перекрытия и колонны раскладывают ближе к крану или поднимают другой техникой. Сравнение быстромонтируемого и башенного крана — в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Кран во внутреннем углу оказывается внутри двора, окружённого готовыми стенами, и расчёт вылета этого не показывает. Вопрос звучит иначе: по какому пути придёт автокран на демонтаж и не закроет ли его последний фасадный элемент. КРАН-КУБАНЬ рекомендует согласовать порядок до начала монтажа; это практика инженерной службы, а не норма. Порядок работ — в статье <a href="/blog/demontazh-bashennogo-krana/">«Демонтаж башенного крана»</a>.</p>
    <p>За пределами расчёта остаются и соседние объекты: ограждение школьного участка, проезд, воздушные линии. Опасную зону вокруг крана определяют по паспорту и ППР; методика — в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>. Если школа строится рядом с действующей территорией, КРАН-КУБАНЬ сверяет зону крана с планом ограждения до выбора точки стоянки.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Сводка показывает расчёт КРАН-КУБАНЬ для условной школы с крыльями 54 и 42 м и потребным крюком 22,5 м. Запас по вылету — разность вылета модели и наибольшего расстояния до здания; знак «−» означает, что кран не достаёт.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Вылет</th><th>Запас: двор S1 (39,45 м)</th><th>Запас: снаружи S2 (63,25 м)</th><th>Высота крюка (22,5 м)</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>40 м</td><td>+0,55 м</td><td>−23,25 м</td><td>от 54,0 м</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>43 м</td><td>+3,55 м</td><td>−20,25 м</td><td>до 27 м, +4,5 м</td></tr>
        <tr><td>КБ-674А</td><td>50,5 м</td><td>+11,05 м</td><td>−12,75 м</td><td>до 60 м</td></tr>
        <tr><td>Potain MCH 175</td><td>до 55 м</td><td>+15,55 м</td><td>−8,25 м</td><td>до 58,5 м</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>65 м</td><td>+25,55 м</td><td>+1,75 м</td><td>до 70,4 м</td></tr>
      </tbody>
    </table></div>
    <p>Вывод таблицы один: стоянку выбирают раньше модели. Во дворе подходит любая модель, и решают основание и грузы; снаружи остаётся один кран. Цены и сроки зависят от площадки и здесь не называются. План школы с размерами крыльев и двора можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и точку стоянки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: высота крюка, вылет и грузоподъёмность пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, п. 114 (перемещение груза на 0,5 м выше препятствий)' },
      { href: 'https://kran-kuban.ru/blog/vylet-bashennogo-krana-po-modelyam/', label: 'kran-kuban.ru — вылет башенного крана по моделям' },
    ]} />
</BlogArticleLayout>
