---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 112. Восемьдесят вторая статья блога — угол (c) региональный.
// Успенский район — юго-восток края, граница со Ставропольским краем, соседи —
// Отрадненский (волна 111), Новокубанский район и Армавир. Источник тот же,
// что в волнах 110–111: smokk.ru, curl -sk.
//
// Фактура — один источник (проверено 14.10.2026):
// - smokk.ru/about/association-members/uspenskiy-rayon (Совет муниципальных
//   образований края; текст без даты): население 39 245 (01.01.2022),
//   38 864 (2023), 38 722 (2024), 38 426 (01.01.2025); площадь 1130 км²;
//   юго-восток края; граничит: восток — Ставропольский край, юг — Отрадненский
//   район, запад — Новокубанский район и город Армавир; главная река — Кубань,
//   на юго-западной границе — Уруп; образован 2 июня 1924 года, упразднялся
//   в 1929 и в 1962–1975 годах; в 2005 году образованы 10 сельских поселений;
//   администрация — с. Успенское, ул. Калинина, 76; структура экономики:
//   сельское хозяйство 46 %, промышленность 41 %, торговля 11 %, строительство
//   1 % (дата не указана; производственная деятельность — на 2008 год:
//   3 АО, 5 ООО, 172 КФХ).
// Расчёты: убыль 2022→2025 = 819 чел. (2,1 %); плотность ≈ 34 чел./км².
// НЕ названо в источнике и не приводится: рельеф, климат, грунт, расстояние до
// Краснодара, названия предприятий, балл сейсмичности (конвенция сайта с Волны 79).

const CHECKED = '14 октября 2026 года';
const PUBLISHED = '2026-10-14';

const title = 'Кран для Успенского района: 1130 км² у реки Кубань';
const description = 'В Успенском районе 1130 км², 38 426 жителей на 01.01.2025 и 10 сельских поселений. Грунт, доставка и закон о тишине для башенного крана.';
const h1 = 'Кран для Успенского района: какой башенный кран нужен на юго-востоке края';
const crumbTitle = 'Кран для Успенского района';
const slug = 'kran-dlya-uspenskogo-rayona';

const H2 = [
  'Что известно о районе: площадь, население, поселения',
  'Экономика: сельское хозяйство и промышленность',
  'Грунт, климат и сейсмика: чего нет в описании района',
  'Доставка: соседи района и граница со Ставропольским краем',
  'Закон о тишине и режим работы на площадке',
  'Что проверить до заказа крана в районе',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая площадь Успенского района Краснодарского края?',
    a: '1130 км² — такую цифру приводит ассоциация «Совет муниципальных образований Краснодарского края» (СМОКК). Район расположен на юго-востоке края и граничит со Ставропольским краем, Отрадненским и Новокубанским районами и городом Армавир.',
  },
  {
    q: 'Сколько жителей в Успенском районе?',
    a: '38 426 человек на 1 января 2025 года по данным СМОКК. С 1 января 2022 года, когда было 39 245, население сократилось на 819 человек, или на 2,1 %. Плотность составляет около 34 человек на км².',
  },
  {
    q: 'Какой грунт в Успенском районе?',
    a: 'СМОКК не приводит сведений о грунте Успенского района, а рядом текут Кубань и Уруп, поэтому общая цифра была бы выдумкой. Грунт и воду на площадке показывает отчёт изысканий; без него КРАН-КУБАНЬ не назначает основание для крана.',
  },
  {
    q: 'Как доставить башенный кран в Успенский район?',
    a: 'В разобранном виде несколькими машинами: секции мачты, стрела, противовес. Расстояния до Краснодара в описании района нет, поэтому КРАН-КУБАНЬ считает доставку от базы до адреса объекта; сроки монтажа зависят от модели.',
  },
  {
    q: 'Какая модель подходит для небольшого объекта в станице района?',
    a: 'При высоте до 41,7 м подходит giraFFe SMK-5.66: опорный контур 4×4 м, фундамент не нужен, монтаж 4–6 часов. Для здания выше или для вылета больше 43 м КРАН-КУБАНЬ предлагает КБ-408.21, Potain MCH 175, Potain MDT 219 J10 или КБ-674А по высоте и плану площадки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Юго-восток края"
  published={PUBLISHED}
>
    <p slot="intro">Успенский район занимает 1130 км² на юго-востоке Краснодарского края, а 38 426 жителей на 1 января 2025 года дают плотность около 34 человек на км². Для башенного крана КРАН-КУБАНЬ из описания района важны три факта: 10 сельских поселений, граница со Ставропольским краем и река Кубань как главная река района.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Успенский район по данным Совета муниципальных образований Краснодарского края граничит на востоке со Ставропольским краем, на юге — с Отрадненским районом, на западе — с Новокубанским районом и городом Армавир. Главная река — Кубань, на юго-западной границе течёт Уруп. Администрация района находится в селе Успенское, и для КРАН-КУБАНЬ это означает объекты в селах, а не в одном городе.</p>
    <p>Район образован 2 июня 1924 года, упразднялся дважды — в 1929 году и с 1962 по 1975 год, когда его территория входила в состав Новокубанского района. В 2005 году вместо сельских округов образованы 10 сельских поселений: Успенское, Веселовское, Вольненское, Коноковское, Кургоковское, Маламинское, Николаевское, Трехсельское, Убеженское и Урупское.</p>
    <p>Население сокращается: 39 245 человек на 1 января 2022 года, 38 864 — в 2023-м, 38 722 — в 2024-м и 38 426 — в 2025-м. За три года минус 819 человек, или 2,1 %. Общую логику выбора модели по высоте и вылету, а не по району, КРАН-КУБАНЬ описывает в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Структура экономики Успенского района в описании СМОКК такая: сельское хозяйство — 46 %, промышленность — 41 %, торговля — 11 %, строительство — 1 %. Дата этих долей в тексте не указана, поэтому для КРАН-КУБАНЬ они служат ориентиром, а не свежей статистикой. Заметно, что доля промышленности почти равна доле сельского хозяйства.</p>
    <p>Производственная деятельность в районе по тому же описанию на 2008 год: 3 акционерных общества, 5 обществ с ограниченной ответственностью и 172 крестьянско-фермерских хозяйства. Цифра устарела, но показывает масштаб: район фермерский, и типичный объект — склад, ангар, хранилище или цех переработки, а не многоэтажный комплекс.</p>
    <p>Под такие объекты КРАН-КУБАНЬ чаще предлагает giraFFe SMK-5.66, который монтируют за 4–6 часов без фундамента, или Potain MCH 175 с рельсовым путём для длинного узкого корпуса. Разница между ними по высоте и вылету показана в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>. Названий предприятий в описании района нет, поэтому статья их не приводит.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>В тексте СМОКК об Успенском районе нет ни рельефа, ни климата, ни сведений о грунтах, и КРАН-КУБАНЬ не заполняет пробел чужими цифрами. Реки Кубань и Уруп — единственный природный факт из описания, а выводов о грунтовых водах на площадке из него не сделать: уровень воды и несущую способность показывает только бурение.</p>
    <p>Отчёт изысканий поэтому остаётся первым документом любого заказа. Какие скважины закладывают и что входит в отчёт, сказано в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>; от результата зависит, путь или фундамент (<a href="/blog/relsovyi-put-ili-fundament/">сравнение</a>). Основание КБ-408.21 — только наземный рельсовый путь, а Potain MDT 219 J10 допускает и путь, и монолитный фундамент.</p>
    <p>Сейсмичность района СМОКК тоже не называет, и статья балл не указывает. Значение для площадки берут из карт общего сейсмического районирования и ТСН 22-302-2000, а если нужно уточнение — из микрорайонирования (<a href="/blog/seysmicheskoe-mikrorayonirovanie/">разбор</a>). КРАН-КУБАНЬ вносит его в ППР и сверяет с условиями установки модели.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Восточная граница Успенского района проходит по Ставропольскому краю, и расстояние до Краснодара СМОКК не приводит. Маршрут доставки КРАН-КУБАНЬ считает от своей базы до адреса объекта: от него зависят число машин, режим движения негабарита и сутки в пути. Кран едет разобранным — секции мачты, стрела, противовес, балласт.</p>
    <p>Соседние территории с отдельными разборами: <a href="/blog/kran-dlya-otradnenskogo-rayona/">Отрадненский район</a> на юге, <a href="/blog/kran-dlya-novokubanskogo-rayona/">Новокубанский район</a> на западе, <a href="/blog/kran-dlya-promzony-armavira/">промзона Армавира</a> на границе. Парк КРАН-КУБАНЬ на всех объектах один: Potain MDT 219 J10, КБ-408.21, КБ-674А, giraFFe SMK-5.66, Potain MCH 175.</p>
    <p>Срок монтажа определяют модель и основание, а не адрес. Тяжёлый кран собирают дольше, чем giraFFe SMK-5.66, которому по паспорту нужны 4–6 часов и один 25-тонный автокран; разбор сроков — в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Краевой закон № 608-КЗ распространяется на все 10 сельских поселений района, а не только на города, и определяет, когда на площадке допустим шум от монтажа и работы крана. Поэтому график подъёмов КРАН-КУБАНЬ согласует с заказчиком до выезда бригады. Исключения для строительных работ описаны в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a>.</p>
    <p>Жилой двор рядом с площадкой — отдельная задача: расстояние до окон и шум привода поворота и лебёдки. Методика измерения и пороги — в статье <a href="/blog/uroven-shuma-v-decibelah/">«Уровень шума в децибелах»</a>, а шумовые данные конкретной машины берут из её паспорта.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Перед заявкой на кран в Успенском районе КРАН-КУБАНЬ советует сверить пять позиций; список — рекомендация инженерной службы, а не норма закона.</p>
    <ol>
      <li>Высота здания и вылет подачи — по ним выбирают модель, район на выбор не влияет.</li>
      <li>Отчёт изысканий с грунтом и уровнем воды на площадке.</li>
      <li>План с линиями электропередачи и соседними зданиями — порядок для линий описан в статье <a href="/blog/bashennyi-kran-ryadom-s-lep/">«Башенный кран рядом с ЛЭП»</a>.</li>
      <li>Часы работ по закону № 608-КЗ.</li>
      <li>Маршрут доставки и окно для монтажа.</li>
    </ol>
    <p>Параметры площадки можно прислать через <a href="/#order">форму на главной</a>: инженерная служба КРАН-КУБАНЬ назовёт подходящие модели и стоимость доставки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://smokk.ru/about/association-members/uspenskiy-rayon', label: 'smokk.ru — Успенский муниципальный район: население, площадь, география, экономика' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмика и закон о тишине' },
    ]} />
</BlogArticleLayout>
