---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 71. Седьмая статья блога — первая, которая разбирает не курортную,
// а внутреннюю (степную) часть края. Задание волны: узкая повторная попытка
// городов края (после Волны 51/69, отклонявших Геленджик и повтор уже занятых
// городов) — но только при новом, коммерчески значимом WebSearch-факте.
// Найден при прямом WebFetch Приложения Б к ТСН 22-302-2000 (base.garant.ru):
// Армавир числится с расчётной сейсмичностью А-8/В-9/С-9 — практически на
// уровне Сочи (А-8/В-9/С-10) и Новороссийска (А-8/В-9/С-9), при том что
// соседние Кропоткин и Тихорецк — А-6. Это прямо противоречит интуитивному
// «раз не на море — можно проще» и было проверено тем же первоисточником,
// на который уже ссылаются /documents/, /etapy/montazh-i-ankerovka/ и
// /seysmozony/. Коммерческий повод — не абстрактный, а действующий: в
// Северной промзоне Армавира с 2024 по 2029 год реализуется промпарк на
// 90,7 га (~76 млрд ₽, ~2000 рабочих мест), где уже строится литейно-
// прессовый завод «Армавирской металлургической компании» (группа РИАК,
// соглашение со Сбербанком, апрель 2025) — и стоит на паузе ревизии проект
// «Рустарк» (о пересмотре параметров компания объявила 23 апреля 2026 года).
// H1 и первый абзац — про задачу заявки на кран, сейсмика — техническая
// причина, а не тема статьи (§1C1).

const CHECKED = '20 августа 2026 года';

const title = 'Кран для промзоны Армавира: сейсмика как на курорте';
const description = 'Промышленный парк Армавира: что там строят и почему фундамент башенного крана считают по той же сейсмике, что на побережье — ТСН 22-302-2000, Приложение Б.';
const h1 = 'Кран для промзоны Армавира: сейсмика — как на курорте, не как в степи';
const crumbTitle = 'Кран для промзоны Армавира';
const slug = 'kran-dlya-promzony-armavira';

const H2 = [
  'Что уже финансируется в Северной промзоне',
  'Сейсмика площадки: 8 баллов, как в Сочи и Новороссийске',
  'Что это меняет в проекте монтажа',
  'Чего в Армавире нет — и это тоже часть расчёта',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Если Армавир не на побережье, разве на него вообще распространяется краевой сейсмический норматив?',
    a: 'Да. ТСН 22-302-2000 (СНКК 22-301-2000) действует на любой площадке 7, 8 или 9 баллов по всему Краснодарскому краю, а не только в курортной зоне. Приложение Б к этому документу — постатейный список населённых пунктов края с расчётной сейсмичностью по картам А, В и С, и Армавир в нём стоит рядом с Сочи и Новороссийском, а не с внутренними районами вроде Кропоткина.',
  },
  {
    q: 'Получается, кран для Армавира обойдётся дороже, чем для условного Кропоткина?',
    a: 'Расчёт сейсмической нагрузки на фундамент и анкеровку — часть базового проекта монтажа, а не платная опция, и мы закладываем его одинаково при любой сейсмичности 7 баллов и выше. Разница в том, что для площадки в Кропоткине (А-6) свод правил в принципе не требует сейсмического расчёта основания, а для Армавира (А-8) требует — это реальная, а не декоративная разница в объёме инженерной части проекта.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для промзоны Армавира', item: `${SITE}/blog/kran-dlya-promzony-armavira/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-promzony-armavira/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-promzony-armavira/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Заявка на башенный кран для площадки в Армавире обычно начинается с одного и того же вопроса: «а нам точно нужен полный сейсмический расчёт — мы же в полутора сотнях километров от моря, не в Сочи». По нормативу ответ обратный интуиции: да, нужен, и почти в том же объёме, что на курортной площадке. Ниже — что сейчас реально строится в городе, откуда берётся эта цифра и что она меняет в проекте монтажа.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>В Северной промзоне Армавира с 2024 по 2029 год реализуется индустриальный парк на 90,7 га: заявленный объём инвестиций резидентов — около 76 млрд ₽, ожидаемое число новых рабочих мест — порядка 2000, управляющая компания — АО «Корпорация развития Краснодарского края». Это не проект на бумаге: в апреле 2025 года ООО «Армавирская металлургическая компания» (группа РИАК) подписала со Сбербанком соглашение о финансировании литейно-прессового завода — свыше 21 млрд ₽ вложений, из них 7 млрд ₽ отдельно на прессовую линию, мощность до 60 тыс. т продукции в год, запуск намечен на 2028 год. Завод должен выпускать крупные алюминиевые компоненты для первого российского высокоскоростного поезда, а также для «Ласточек» и электротранспорта — то есть не типовой цех, а объект с достаточно длинным циклом стройки, чтобы аренда башенного крана считалась месяцами, а не сменами.</p>
    <p>Второй резидент того же парка — ООО «Рустарк» — заявлял завод глубокой переработки зерна на 42 га с исходным бюджетом 60 млрд ₽ в три очереди по 20 млрд ₽ и мощностью 88 тыс. т лимонной кислоты в год, первую очередь планировали запустить в сезоне 2025/26. Честно о статусе: 23 апреля 2026 года компания объявила о пересмотре продуктовой линейки и параметров проекта — рынок лимонной кислоты за три года заметно изменился, новые сроки и инвестиции пока не названы, площадка ждёт готовности инженерной инфраструктуры парка. Мы приводим оба проекта, а не только более определённый, — потому что промзона строится не одним резидентом, и вопрос сейсмики актуален для площадки целиком, а не для одной конкретной стройки.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Приложение Б к территориальным строительным нормам ТСН 22-302-2000 (СНКК 22-301-2000) «Строительство в сейсмических районах Краснодарского края» — постатейный список населённых пунктов края с расчётной сейсмичностью по картам А, В и С (интервалы повторяемости 500, 1000 и 5000 лет). Армавир в этом списке стоит на отметке А-8 / В-9 / С-9 — практически вровень с Сочи (А-8 / В-9 / С-10) и Новороссийском (А-8 / В-9 / С-9), и не сильно ниже Краснодара (А-8 / В-8 / С-9) и Анапы (А-8 / В-8 / С-9). А вот более близкие к Армавиру по географии Кропоткин и Тихорецк стоят в том же приложении на А-6 — для площадок с такой сейсмичностью свод правил вообще не требует расчёта на сейсмическую нагрузку, он распространяется только на 7 баллов и выше.</p>
    <p>Разница объясняется не расстоянием до моря, а близостью к зоне активных разломов предгорий Кавказа: сейсмическая опасность в крае растёт не линейно с широтой, а по конкретным геологическим структурам, и Армавир географически ближе к этой зоне, чем степные города северо-восточнее него. Как читать саму таблицу баллов и что она значит для конкретной площадки — в разделах <a href="/seysmozony/8-ballov/" style="color:var(--accent)">«Площадка 8 баллов»</a> и <a href="/seysmozony/9-ballov/" style="color:var(--accent)">«Площадка 9 баллов»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Практическое следствие для заявки в Армавире то же самое, что для площадки в Сочи: в проект монтажа должен войти расчёт основания и анкеровки на сейсмическую нагрузку, а не только на ветровую, — этот шаг подробно разобран на этапе <a href="/etapy/montazh-i-ankerovka/" style="color:var(--accent)">«Монтаж и анкеровка»</a> и в разделе <a href="/documents/" style="color:var(--accent)">«Документы монтажа»</a>. Мы уточняем сейсмичность конкретного адреса до выезда техники, а не в процессе монтажа: для многомесячной стройки на промзоне, где кран стоит на площадке от очереди строительства до следующей, пересчитывать анкеровку постфактум — это дни простоя, которых при заранее известном балле можно было избежать.</p>
    <p>Для промышленной площадки такого масштаба, где секции здания заливаются и монтируются в несколько этапов растянутого графика, чаще подходит кран на собственном фундаменте или рельсовом пути с большим сроком стоянки, а не быстромонтируемая модель для короткого объекта — какая машина парка закрывает какой случай, разобрано в разделе <a href="/park/" style="color:var(--accent)">«Парк техники»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 18px">{headings[3].text}</h2>
    <p>Совпадение по сейсмике не значит, что Армавир — это Сочи в миниатюре. Курортная чувствительность к шуму, из-за которой на побережье в высокий сезон особенно легко получить жалобу и проверку, здесь не работает — рядом с промзоной нет отельной и рекреационной застройки. Нет и статуса особо охраняемой природной территории вроде анапской Пересыпи, ограничивающего маршруты подъезда техники, и нет норд-оста — новороссийской боры, которая на побережье способна остановить кран на несколько дней подряд. Краевые нормы, действующие независимо от расстояния до моря, — режим тишины по статье 3.3 закона №608-КЗ и летнее ограничение движения тяжеловесов при жаре выше +32 °C — применяются в Армавире так же, как в любой точке края: они не курортная надбавка, а норма для всего региона.</p>
    <p>Итог: на площадке в Армавире мы не срезаем угол на инженерном расчёте, ссылаясь на удалённость от моря, — но и не переносим туда курортные ограничения, которых там объективно нет.</p>

    <h2 id={headings[4].id} style="margin:36px 0 18px">{headings[4].text}</h2>
    <ul>
      <li>Северная промзона Армавира — действующий проект 2024–2029, 90,7 га, порядка 76 млрд ₽ инвестиций резидентов; литейно-прессовый завод АМК (группа РИАК) финансируется Сбербанком с апреля 2025 года, запуск — 2028 год.</li>
      <li>По Приложению Б ТСН 22-302-2000 расчётная сейсмичность Армавира — А-8 / В-9 / С-9, почти на уровне Сочи и Новороссийска, тогда как у ближайших Кропоткина и Тихорецка — А-6.</li>
      <li>При 8 баллах расчёт основания и анкеровки на сейсмическую нагрузку обязателен — тот же объём инженерного этапа, что на курортной площадке.</li>
      <li>Курортных факторов (закон о тишине в высокий сезон, ООПТ, норд-ост) в Армавире нет — краевые нормы там действуют в базовом, а не в усиленном варианте.</li>
    </ul>
    <p>Как балл площадки считается в целом по краю — в разделе <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны»</a>; что именно оформляется в проекте монтажа помимо расчёта сейсмики — в статье <a href="/blog/seysmika-i-zakon-o-tishine/" style="color:var(--accent)">«Сейсмика и закон о тишине на Кубани»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://base.garant.ru/23972997/948c9c0734b6e944a4727660f2d5a027/', label: 'base.garant.ru — Приложение Б к ТСН 22-302-2000: Армавир А-8/В-9/С-9, Кропоткин и Тихорецк А-6' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
      { href: 'https://kuban.rbc.ru/krasnodar/07/12/2024/6752dc489a7947a83fe70093', label: 'РБК Кубань (07.12.2024) — индустриальный парк Армавира: 90,7 га, ~76 млрд ₽, 2024–2029, Корпорация развития Краснодарского края' },
      { href: 'https://kuban.rbc.ru/krasnodar/freenews/67f919b69a7947dc7f5e0e4f', label: 'РБК Кубань (14.04.2025) — литейно-прессовый завод «Армавирской металлургической компании»: соглашение со Сбербанком, свыше 21 млрд ₽, запуск в 2028 году' },
      { href: 'https://www.agroinvestor.ru/companies/news/40477-rustark-zapustit-pervuyu-ochered-novogo-zavoda-v-sezone-2025-26/', label: 'Агроинвестор — исходные параметры проекта «Рустарк»: 60 млрд ₽, три очереди, 88 тыс. т лимонной кислоты в год' },
      { href: 'https://south.vedomosti.ru/south/news/2026/04/23/1192539-rustark', label: 'Ведомости.Юг (23.04.2026) — «Рустарк» пересматривает параметры проекта в Армавире' },
    ]} />
</BlogArticleLayout>
