---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 85. Двадцатая статья блога — Выселковский район, ещё один равнинный
// степной район без гор и моря (продолжение линии Тимашевска, Абинского и
// Северского районов), но с иным экономическим профилем: не завод-гигант
// на площадке города, а штаб-квартира самого агрохолдинга. Здесь, в
// ст. Выселки, расположена головная площадка АО Фирма «Агрокомплекс» им.
// Н.И.Ткачева (ИНН 2328000083, ОГРН 1022303554635) — одного из крупнейших
// в стране землевладельцев и производителей мяса, молока и сахара.
//
// Факты сверены через WebSearch по нескольким независимым источникам
// (rusprofile.ru, spark-interfax.ru, kommersant.ru, yuga.ru, rossahar.ru) —
// egress сессии не пропускал прямой доступ к rossahar.ru и sugar.ru
// (WebFetch отбит EGRESS_BLOCKED на обоих), поэтому цифры даны как
// опубликованные отраслевые данные, а не как прямая цитата первоисточника.
//
// Важная находка при проверке: WebSearch по запросу о сахарном заводе сперва
// вернул цифру «1,201 млрд руб., 2016 год» — при точечной перепроверке
// выяснилось, что эта сделка относится к ПОКУПКЕ ТИХОРЕЦКОГО сахарного
// завода, а не Выселковского. Выселковский завод («Кристалл») куплен
// «Агрокомплексом» раньше и дешевле — в марте 2006 года, 89,66% акций у
// «Русского сахара». Эта цифра в статью не попала именно поэтому — почти
// повторили прецедент 01.09.2026 (чужие цифры приписаны не той статье/не
// тому заводу). Текущую мощность переработки свёклы завода WebSearch дал
// с расхождением (3600 т/сутки по одному источнику, 7900 т/сутки по
// другому, без ясности о годах) — цифра в статью намеренно не включена,
// как и балл сейсмики для района: докс.cntd.ru снова недоступен напрямую,
// прямой цитаты строки Выселковского района в выдаче нет. Та же честная
// развилка, что и в шести предыдущих статьях подряд.

const CHECKED = '10 сентября 2026 года';

const title = 'Кран для Выселковского района: штаб агрохолдинга и завод «Кристалл»';
const description = 'Выселковский район — равнинная степь в центре Кубани: здесь стоит головная площадка «Агрокомплекса» им. Н.И.Ткачева и старейший в крае сахарный завод «Кристалл» (с 1959 года).';
const h1 = 'Кран для Выселковского района: штаб агрохолдинга и завод «Кристалл»';
const crumbTitle = 'Кран для Выселковского района';
const slug = 'kran-dlya-vyselkovskogo-rayona';

const H2 = [
  'Выселковский район — равнинное сердце сельскохозяйственной Кубани',
  '«Агрокомплекс» им. Н.И.Ткачева: от слияния 1993 года до крупнейшего агрохолдинга страны',
  'Сахарный завод «Кристалл»: площадка 1959 года в частном агрохолдинге с 2006 года',
  'Сейсмика: что можно сказать про Выселковский район, а что нет',
  'Закон о тишине действует и здесь — без региональной скидки',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Если в Выселках стоит штаб-квартира крупнейшего агрохолдинга края, значит кран нужен только на его площадках?',
    a: 'Нет. «Агрокомплекс» — крупнейший, но не единственный заказчик техники в районе: жилая застройка самой станицы Выселки и остальных станиц района, объекты социальной и коммерческой инфраструктуры формируют отдельный, более мелкий и разрозненный спрос — с другими требованиями к грузоподъёмности и графику, чем реконструкция цеха действующего завода холдинга.',
  },
  {
    q: 'Правда ли, что сейсмика Выселковского района ниже, чем у предгорных районов края?',
    a: 'Скорее всего да — район равнинный, в центре Прикубанской равнины, вдали от Кавказских гор, и логика такая же, как у Кропоткина и Тихорецка (расчётная сейсмичность А-6, то есть ниже порога, при котором сейсмический расчёт обязателен). Но мы сознательно не называем в статье конкретный балл: доступные источники не подтвердили прямой цитатой строку Выселковского района в Приложении Б ТСН 22-302-2000, а предполагать цифру по аналогии с равнинными соседями мы считаем менее честным, чем не называть её вовсе.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Выселковского района', item: `${SITE}/blog/kran-dlya-vyselkovskogo-rayona/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-vyselkovskogo-rayona/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-vyselkovskogo-rayona/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже разбирал побережье, предгорную ось и степные промышленные территории — металлургию Абинского района, нефтепереработку Северского района, пищевую переработку Тимашевска. Выселковский район продолжает равнинную степную линию, но с третьим, ещё не разобранным профилем: здесь заказчик — не завод в промзоне города, а головная площадка самого агрохолдинга, вокруг которой десятилетиями наращивалась вся остальная инфраструктура района.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Выселковский район расположен в центральной части Прикубанской равнины, в центре Краснодарского края, вдали от Кавказских гор и любого побережья. Административный центр — станица Выселки. Площадь района — около 1740 км², население — порядка 55 тысяч человек. Плодородные равнинные почвы определили экономику района на десятилетия вперёд: здесь нет ни курортной функции, ни портовой перевалки, ни горнодобычи — только сельское хозяйство и его глубокая переработка, причём в масштабе, который для района такого размера скорее исключение, чем правило.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>АО Фирма «Агрокомплекс» им. Н.И.Ткачева (ИНН 2328000083, ОГРН 1022303554635) — головная площадка компании расположена в самой станице Выселки, по адресу ул. Степная, 1. Компания образована в 1993 году слиянием Выселковского комбикормового завода и откормочной базы «Восход» — основал её Николай Ткачёв, отец Александра Ткачёва, будущего губернатора Краснодарского края (2001–2015 годы) и министра сельского хозяйства России (2015–2018 годы). Дальше холдинг рос почти ежегодно: в 1994 году в его состав вошёл Выселковский элеватор, в 1995 году — маслозавод и птицефабрика, в 1999 году — ряд зерновых предприятий. В 2016 году «Коммерсантъ» называл «Агрокомплекс» четвёртым по величине владельцем сельскохозяйственных земель в стране — сегодня компания входит в число крупнейших в России производителей мяса, птицы, молока и сахара. Для арендодателя крана это означает постоянный, а не разовый спрос: у холдинга с десятками производственных площадок в крае регулярно идёт реконструкция то одного, то другого цеха, и головная площадка в Выселках — узел, куда эти заявки стекаются.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Второй якорь экономики станицы — сахарный завод, работающий сегодня под именем «Выселковский» (исторически — ЗАО «Кристалл»). Площадку строили в 1957–1959 годах, а первый сахар-песок завод выдал 23 февраля 1959 года — то есть предприятию уже почти семьдесят лет, и оно старше практически всей остальной промышленной застройки района. В частные руки завод перешёл в марте 2006 года: компания «Русский сахар» продала 89,66% акций «Кристалла» выселковской «Агрокомплекс» — с тех пор завод работает в составе холдинга Ткачёва. Конкретную сегодняшнюю мощность переработки свёклы в статье мы намеренно не приводим: разные отраслевые источники дают заметно разные цифры без ясной привязки к году, и указывать любую из них как актуальную факту было бы нечестно. Для монтажа крана важнее сам факт: советская промышленная площадка почти семидесятилетнего возраста в составе современного агрохолдинга — это история регулярной модернизации оборудования и цехов, а не законсервированный музей.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Здесь мы, как и в статьях про Абинский, Северский, Славянск-на-Кубани, Ейск, Туапсе и Тимашевск, сознательно не приводим конкретный балл сейсмичности. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют конкретные баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Выселковского района доступные источники надёжно не подтвердили. По географической логике равнинный район в центре Прикубанской равнины скорее ближе к соседним Кропоткину и Тихорецку — населённым пунктам, для которых, как отмечено в статье про Армавир, сейсмический расчёт по действующему нормативу не требуется, — чем к предгорным районам с их поднятым баллом. Но аналогия с соседями — не подтверждённый факт, а только направление рассуждения, и мы не выдаём одно за другое. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий, и действует в Выселковском районе так же, как в Сочи или Краснодаре: с 1 марта 2026 года (после вступления в силу закона №5423-КЗ) рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с дополнительным дневным перерывом на тишину, а ответственность по статье 3.3 одинакова для всего края независимо от того, стоит рядом промышленная площадка или частный дом. У производственных площадок «Агрокомплекса» и сахарного завода, удалённых от плотной жилой застройки, риск жалобы соседей ниже, чем у стройки в самой станице Выселки, — но само требование к часам работы это не отменяет. Подробный разбор часов и сумм штрафов — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Выселковский район — равнинный степной район в центре Прикубанской равнины, без гор и моря; спрос на кран здесь связан не с курортом или портом, а с сельхозпереработкой.</li>
      <li>АО Фирма «Агрокомплекс» им. Н.И.Ткачева (ИНН 2328000083) — головная площадка в ст. Выселки, один из крупнейших в России агрохолдингов, основан в 1993 году.</li>
      <li>Сахарный завод «Кристалл» («Выселковский») работает с 1959 года, с марта 2006 года — в составе «Агрокомплекса».</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Выселковского района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Выселковском районе так же, как на побережье края — без региональной скидки на удалённость от моря.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.rusprofile.ru/id/1824733', label: 'rusprofile.ru — АО Фирма «Агрокомплекс» им. Н.И.Ткачева, ИНН 2328000083' },
      { href: 'https://ru.wikipedia.org/wiki/Агрокомплекс_имени_Н._И._Ткачёва', label: 'ru.wikipedia.org — история компании: слияние 1993 года, элеватор 1994, маслозавод и птицефабрика 1995' },
      { href: 'https://www.kommersant.ru/doc/3281302', label: 'kommersant.ru — «Агрокомплекс им. Н.И. Ткачева» — четвёртый в России владелец земли (2016)' },
      { href: 'https://www.yuga.ru/news/68738/', label: 'yuga.ru — покупка сахарного завода «Кристалл» компанией «Агрокомплекс», март 2006 года' },
      { href: 'http://www.rossahar.ru/rynok/istoriya-zavodov/vyselkovskiy-sakharnyy-zavod/', label: 'rossahar.ru — история Выселковского сахарного завода, пуск в 1959 году' },
      { href: 'https://ru.wikipedia.org/wiki/Выселковский_район', label: 'ru.wikipedia.org — Выселковский район: площадь, население, географическое положение' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — закон №5423-КЗ и режим тишины с 01.03.2026' },
    ]} />
</BlogArticleLayout>
