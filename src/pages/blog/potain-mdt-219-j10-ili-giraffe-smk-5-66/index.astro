---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 107. Шестьдесят шестая статья блога — угол (b) коммерческий/сравнительный.
// Пара, которую ещё не сравнивали: Potain MDT 219 J10 (длинный вылет 65 м,
// топлесс) и giraFFe SMK-5.66 (быстромонтируемый без фундамента) — самый большой
// разрыв парка по вылету и основанию.
//
// Фактура — только реестр parkModels.ts и карточки /park/ (проверено 07.10.2026):
// - Potain MDT 219 J10: безоголовочный (топлесс), 10 т максимум, 1,9 т на 65 м,
//   вылет 65 м, крюк до 70,4 м, рельсовый путь или монолитный фундамент;
// - giraFFe SMK-5.66: 5 т максимум, 1,05 т на 43 м, вылет 2,8–43 м, крюк до 27 м
//   (гориз.) / до 41,7 м (наклон 20°), опорный контур 4×4 м, без фундамента,
//   монтаж 4–6 часов силами двух человек и автокрана 25 т.
// Цен и сроков поставки нет. Диаметр рабочего круга = 2 × вылет (арифметика).

const CHECKED = '7 октября 2026 года';
const PUBLISHED = '2026-10-07';

const title = 'Potain MDT 219 J10 или giraFFe SMK-5.66: какой кран выбрать';
const description = 'MDT 219 J10 достаёт на 65 м и несёт 1,9 т на вылете, SMK-5.66 берёт 5 т на коротком вылете и монтируется за 4–6 часов без фундамента. Как выбрать.';
const h1 = 'Potain MDT 219 J10 или giraFFe SMK-5.66: какой башенный кран выбрать для объекта';
const crumbTitle = 'Potain MDT 219 J10 или giraFFe SMK-5.66';
const slug = 'potain-mdt-219-j10-ili-giraffe-smk-5-66';

const H2 = [
  'Чем Potain MDT 219 J10 отличается от giraFFe SMK-5.66',
  'Сравнение двух кранов по восьми параметрам',
  'Когда нужен Potain MDT 219 J10',
  'Когда хватает giraFFe SMK-5.66',
  'Как выбрать между двумя кранами по вылету и основанию',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем Potain MDT 219 J10 отличается от giraFFe SMK-5.66?',
    a: 'Potain MDT 219 J10 из парка КРАН-КУБАНЬ — безоголовочный кран с вылетом 65 м и крюком до 70,4 м на рельсовом пути или монолитном фундаменте. giraFFe SMK-5.66 — быстромонтируемый кран с вылетом 2,8–43 м и крюком до 41,7 м на опорном контуре 4×4 м без фундамента. Первый закрывает большую площадь, второй — тесную стройку.',
  },
  {
    q: 'У какого крана больше вылет — MDT 219 J10 или SMK-5.66?',
    a: 'Вылет Potain MDT 219 J10 — 65 м, то есть рабочий круг диаметром 130 м. У giraFFe SMK-5.66 вылет 2,8–43 м и круг диаметром до 86 м. Разница в 22 м вылета означает, что один MDT 219 J10 обслуживает вытянутый объект, для которого КРАН-КУБАНЬ иначе ставил бы два быстромонтируемых крана.',
  },
  {
    q: 'Какой кран тяжелее поднимает груз на предельном вылете?',
    a: 'На предельном вылете Potain MDT 219 J10 несёт 1,9 т на 65 м, а giraFFe SMK-5.66 — 1,05 т на 43 м. Максимальный груз у них 10 т и 5 т соответственно, но на «хвосте» стрелы разница меньше и достигается дальностью: MDT 219 J10 несёт почти вдвое больше на вылете на 22 м дальше.',
  },
  {
    q: 'Нужен ли фундамент для Potain MDT 219 J10 и giraFFe SMK-5.66?',
    a: 'Для Potain MDT 219 J10 КРАН-КУБАНЬ готовит рельсовый путь или монолитный фундамент — основание рассчитывают по проекту. giraFFe SMK-5.66 стоит на собственном опорном контуре 4×4 м, фундамент не нужен, но грунт под четырьмя опорами проверяют до установки.',
  },
  {
    q: 'Когда выбрать быстромонтируемый кран вместо MDT 219 J10?',
    a: 'Когда объект ниже 27–41,7 м, груз не тяжелее 5 т, а места под рельсовый путь или фундамент нет. Тогда КРАН-КУБАНЬ предлагает giraFFe SMK-5.66: монтаж 4–6 часов силами двух человек и автокрана 25 т. Если площадка вытянута больше чем на 43 м от крана, нужен MDT 219 J10.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">Potain MDT 219 J10 достаёт на 65 м и несёт 10 т максимум, а giraFFe SMK-5.66 берёт 5 т на вылете до 43 м и монтируется за 4–6 часов без фундамента. КРАН-КУБАНЬ выбирает между ними по длине фронта работ, высоте здания и тому, есть ли на участке место под рельсовый путь или монолитное основание.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Potain MDT 219 J10 и giraFFe SMK-5.66 — крайние точки парка КРАН-КУБАНЬ по вылету. Potain MDT 219 J10 — безоголовочный (топлесс) кран с самым длинным вылетом парка, 65 м: стрела обслуживает круг диаметром 130 м, а топлесс-геометрия позволяет работать рядом с соседними кранами. Платой за это служит основание: рельсовый путь или монолитный фундамент и многодневный монтаж по полноценному проекту производства работ.</p>
    <p>giraFFe SMK-5.66 из парка КРАН-КУБАНЬ решает противоположную задачу: короткий объект, тесный участок, нет места под путь. Собственный опорный контур 4×4 м заменяет фундамент, монтаж занимает 4–6 часов силами двух человек и 25-тонного автокрана. Паспортные данные — в карточках <a href="/park/potain-mdt-219-j10/">Potain MDT 219 J10</a> и <a href="/park/giraffe-smk-5-66/">giraFFe SMK-5.66</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>Potain MDT 219 J10</th><th>giraFFe SMK-5.66</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>безоголовочный (топлесс)</td><td>быстромонтируемый, без фундамента</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>10 т</td><td>5 т</td></tr>
        <tr><td>Вылет</td><td>65 м</td><td>2,8–43 м</td></tr>
        <tr><td>Груз на предельном вылете</td><td>1,9 т на 65 м</td><td>1,05 т на 43 м</td></tr>
        <tr><td>Диаметр рабочего круга</td><td>130 м</td><td>до 86 м</td></tr>
        <tr><td>Высота подъёма крюка</td><td>до 70,4 м</td><td>до 27 м (гориз.) / до 41,7 м (наклон 20°)</td></tr>
        <tr><td>Основание</td><td>рельсовый путь или монолитный фундамент</td><td>опорный контур 4×4 м</td></tr>
        <tr><td>Монтаж</td><td>полноценный проект производства работ, автокран</td><td>4–6 часов, два человека и автокран 25 т</td></tr>
      </tbody>
    </table></div>
    <p>Таблица парка КРАН-КУБАНЬ показывает: Potain MDT 219 J10 вдвое мощнее по грузу (10 т против 5 т) и на 22 м длиннее по вылету. Диаметр круга — это просто удвоенный вылет: 2 × 65 = 130 м против 2 × 43 = 86 м. giraFFe SMK-5.66 выигрывает основанием и временем: разница между «часами» и «днями» монтажа ощутима на коротких работах.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Potain MDT 219 J10 нужен КРАН-КУБАНЬ, когда фронт работ длиннее 43 м от места установки или здание выше 41,7 м. Вылет 65 м закрывает цех, склад или жилой квартал вытянутой формы одним краном, а крюк до 70,4 м — многоэтажный дом. На самом «хвосте» стрелы кран несёт 1,9 т: для кирпича на поддонах и опалубки этого достаточно, для тяжёлых панелей нужно сокращать вылет.</p>
    <p>Топлесс-геометрия MDT 219 J10 полезна на площадке с соседним краном или ограничением по высоте: стрелы разводят по высоте без помех, как разбирает статья <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>. Цена вопроса — рельсовый путь или монолитный фундамент; выбор между ними описан в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>giraFFe SMK-5.66 хватает КРАН-КУБАНЬ на здании до 27 м (с наклоном стрелы 20° — до 41,7 м) и при грузе не тяжелее 5 т. Вылет до 43 м даёт круг диаметром 86 м — для жилого дома, школы или небольшого склада этого достаточно. Фундамент не нужен: опорный контур 4×4 м ставят на проверенный грунт, и кран работает в день приезда.</p>
    <p>Для объекта с коротким сроком SMK-5.66 выгоднее по времени и по подготовке: не нужно прокладывать путь и ждать набора прочности бетона. Единственная плата — потолок по высоте и грузу, которые разобраны в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>. Если груз упирается в 5 т, КРАН-КУБАНЬ переходит к Potain MDT 219 J10 или КБ-408.21.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Условный пример для КРАН-КУБАНЬ: складской комплекс длиной 120 м и высотой 14 м. Один giraFFe SMK-5.66 с вылетом 43 м покрывает только 86 м круга, то есть вдоль здания нужны два крана. Один Potain MDT 219 J10 в середине с кругом диаметром 130 м обслуживает здание целиком, но требует основания. Пример условный и показывает логику выбора, а не параметры конкретного объекта.</p>
    <ol>
      <li>Измерьте расстояние от места установки до самой дальней точки подачи: если оно больше 43 м, giraFFe SMK-5.66 один не справится.</li>
      <li>Сверьте высоту здания с пределами: 27 м, 41,7 м с наклоном или 70,4 м у Potain MDT 219 J10.</li>
      <li>Оцените массу самых тяжёлых элементов: больше 5 т — только MDT 219 J10 из этой пары.</li>
      <li>Найдите место под рельсовый путь или фундамент; если его нет, а объект невысокий, выбирайте giraFFe SMK-5.66.</li>
      <li>Прикиньте срок стройки: на несколько недель быстромонтируемый кран выгоднее, на многомесячный проект — Potain MDT 219 J10.</li>
    </ol>
    <p>Окончательный выбор КРАН-КУБАНЬ фиксирует в проекте производства работ, когда известны план участка, высота и масса элементов. Другие пары парка — в статьях <a href="/blog/kb-408-21-ili-giraffe-smk-5-66/">«КБ-408.21 или giraFFe SMK-5.66»</a> и <a href="/blog/potain-mdt-219-j10-ili-kb-408-21/">«Potain MDT 219 J10 или КБ-408.21»</a>. Адрес и чертёж можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/potain-mdt-219-j10/', label: 'kran-kuban.ru — карточка Potain MDT 219 J10: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — карточка giraFFe SMK-5.66: паспортные характеристики' },
      { href: 'https://giraffecrane.ru/', label: 'giraffecrane.ru — производитель быстромонтируемых кранов giraFFe' },
      { href: 'https://www.manitowoc.com/', label: 'manitowoc.com — производитель башенных кранов Potain' },
    ]} />
</BlogArticleLayout>
