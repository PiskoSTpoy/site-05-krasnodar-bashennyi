---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 110. Семьдесят четвёртая статья блога — угол (a) информационный / how-to.
// Внеочередная проверка наземного рельсового пути башенного крана после ливня.
// Кубань — регион с резкими ливнями (Крымский район 2012, Усть-Лабинский 19 мая
// 2026 — обе статьи уже есть в блоге), а ежесменный осмотр пути (пп. 206–210)
// разобран в статье про осмотр перед сменой. Здесь — только то, чего там нет:
// п. 211 (внеочередная проверка после ливней и зимних оттепелей), п. 209
// (плановая раз в 12 месяцев), п. 210 (акты), п. 203 + приложение № 5
// (планово-высотная съёмка, зазор P5 по температуре).
//
// Фактура — сырой текст ФНП № 461 (ред. от 16.04.2026), legalacts.ru, curl,
// проверено 12.10.2026: пп. 200, 203, 205–211; приложение № 5, пп. 1–2.
// Числовые допуски P1–P3 из таблицы приложения № 5 не приводятся: колонки по типам
// кранов в тексте читаются неоднозначно. Порога «ливня» (мм осадков) в норме нет.

const CHECKED = '12 октября 2026 года';
const PUBLISHED = '2026-10-12';

const title = 'Рельсовый путь крана после ливня: внеочередная проверка';
const description = 'П. 211 ФНП № 461: после ливней и зимних оттепелей наземный путь башенного крана проверяют в объёме плановой проверки. Кто проводит и как оформляют акт.';
const h1 = 'Как проверять рельсовый путь башенного крана после ливня и оттепели';
const crumbTitle = 'Проверка рельсового пути после ливня';
const slug = 'vneocherednaya-proverka-relsovogo-puti-posle-livnya';

const H2 = [
  'Что требует п. 211: проверка в объёме плановой',
  'Четыре вида проверки пути: чем внеочередная отличается от остальных',
  'Что входит в объём: съёмка, зазоры и крепление рельсов',
  'Зазор между рельсами: поправка на температуру',
  'Кто проводит и как оформляют акт',
  'Порядок действий после сильного дождя',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Обязательна ли проверка рельсового пути после каждого дождя?',
    a: 'Нет. Пункт 211 ФНП № 461 называет два события: ливни и зимние оттепели. Порога в миллиметрах осадков норма не задаёт, поэтому решение о ливне принимает инженерно-технический работник, ответственный за производственный контроль, по состоянию площадки.',
  },
  {
    q: 'Кто проводит внеочередную проверку пути башенного крана?',
    a: 'Проверка идёт под руководством инженерно-технического работника, ответственного за осуществление производственного контроля при эксплуатации подъёмных сооружений. Саму осмотровую работу выполняют работники, названные в пп. 207–208: крановщик под его руководством.',
  },
  {
    q: 'Как оформляется результат внеочередной проверки?',
    a: 'Актом. Пункт 210 ФНП № 461 говорит, что результаты плановых и внеочередных проверок оформляются актами, которые хранятся вместе с паспортами подъёмных сооружений. Запись о ежесменном осмотре в журнал акт не заменяет.',
  },
  {
    q: 'Меняется ли зазор между рельсами при морозе?',
    a: 'Да. Приложение № 5 к ФНП: на каждые 10 °C изменения температуры зазор между рельсами меняют на 1,5 мм. При +20 °C зазор равен 3 мм, при −10 °C — 7,5 мм. Значения из приложения — пример нормы, а проектный зазор берут из документации пути.',
  },
  {
    q: 'Нужна ли эта проверка крану на монолитном фундаменте?',
    a: 'Пункт 211 говорит о наземных рельсовых путях. Potain MDT 219 J10 и Potain MCH 175 КРАН-КУБАНЬ ставит на путь или на монолитный фундамент, и проверка относится только к варианту с путём. Для фундамента состояние основания определяет проект и плановое освидетельствование.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Как сделать · Эксплуатация"
  published={PUBLISHED}
>
    <p slot="intro">Пункт 211 ФНП № 461 требует внеочередной проверки наземных рельсовых путей после ливней и зимних оттепелей — в объёме плановой проверки и под руководством ответственного инженера. Для КБ-408.21, который КРАН-КУБАНЬ ставит только на рельсовый путь, это главное правило сезона дождей на Кубани.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 211 ФНП № 461 (редакция от 16.04.2026) состоит из одного предложения: внеочередная проверка наземных рельсовых путей проводится в объёме плановой проверки после ливней или зимних оттепелей. Руководит ею инженерно-технический работник, ответственный за осуществление производственного контроля при эксплуатации подъёмных сооружений.</p>
    <p>Два слова в этой формулировке определяют всю работу. «В объёме плановой» значит: недостаточно пройти вдоль пути и посмотреть на рельсы, как при ежесменном осмотре крановщика. Нужна та же проверка, которую подъёмное сооружение проходит раз в 12 месяцев. «После ливней» значит: событие наступает по факту, а не по календарю, и срок на него норма не пишет.</p>
    <p>Порога осадков в миллиметрах ФНП не задаёт. Решение, считать ли дождь ливнем, принимает ответственный инженер по состоянию площадки: размыт ли отвал, стоит ли вода между шпалами, поплыл ли балласт. КРАН-КУБАНЬ в таких случаях исходит из простого признака: если после дождя на площадке остались следы текущей воды вдоль пути, проверку проводят до следующего выхода крана в работу.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>ФНП № 461 в пунктах 205–211 описывает четыре режима контроля рельсового пути башенного крана, и внеочередная проверка среди них единственная, которую запускает не календарь, а событие. Для КБ-408.21, работающего только на пути, разница между режимами решает, когда кран вообще можно выпускать в работу.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Вид контроля</th><th>Когда</th><th>Кто</th><th>Где фиксируется</th></tr></thead>
      <tbody>
        <tr><td>Ежесменный осмотр (п. 207)</td><td>каждую смену</td><td>крановщик в объёме производственной инструкции</td><td>порядок записи задаёт инструкция</td></tr>
        <tr><td>Осмотр после 24 смен (пп. 208, 210)</td><td>каждые 24 смены</td><td>крановщик под руководством ИТР, отвечающего за содержание в работоспособном состоянии</td><td>паспорт пути или вахтенные журналы</td></tr>
        <tr><td>Плановая проверка (п. 209)</td><td>не реже раза в 12 месяцев</td><td>те же работники под руководством ИТР производственного контроля</td><td>акт, хранится с паспортом</td></tr>
        <tr><td>Внеочередная проверка (п. 211)</td><td>после ливней и зимних оттепелей</td><td>в объёме плановой, под руководством ИТР производственного контроля</td><td>акт, хранится с паспортом</td></tr>
      </tbody>
    </table></div>
    <p>Ежесменный осмотр и осмотр после 24 смен подробно разобраны в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Ежесменный осмотр башенного крана»</a>. Здесь важно другое: два нижних режима дают акт, а два верхних — запись в журнале. Акт нужен, потому что он подтверждает соответствие пути проекту, а не только отсутствие явных дефектов.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Объём плановой проверки по п. 209 ФНП № 461 один результат: подтверждено ли соответствие рельсовых путей требованиям проектной документации. Для башенного крана на пути это сверка с тремя документами, и они определяют содержание акта после ливня.</p>
    <p>Первый документ — акт сдачи-приёмки пути с результатами планово-высотной съёмки (п. 203). Это эталон: с ним сравнивают, не просел ли рельс после намокания грунта. Второй — приложение № 5 о предельных отклонениях пути от проектного положения в плане и профиле. Третий — приложение № 3 о нормах браковки рельсов и шпал.</p>
    <p>По приложению № 5 отклонения P1, P2 и P3 измеряют на всём участке возможного движения крана через интервалы не более 5 м. Для пути длиной 60 м это не менее 13 точек замера (60 / 5 + 1). Численные допуски по типам кранов в таблице приложения читаются неоднозначно, поэтому в статье они не приводятся: КРАН-КУБАНЬ берёт их из первоисточника при каждой проверке.</p>
    <p>Дополнительно проверяют два простых условия из п. 200: рельсы закреплены так, что исключено продольное и поперечное смещение, и на каждой нити стоят по два тупиковых упора. После ливня именно эти две вещи страдают первыми, когда вода уносит балласт из-под шпал.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Приложение № 5 к ФНП № 461 задаёт правило для зазора P5 между рельсами: на каждые 10 °C изменения температуры зазор меняют на 1,5 мм. В самом приложении дан пример: при +20 °C зазор равен 3 мм, при −10 °C — 7,5 мм. Рельс на морозе укорачивается, и без запаса стык встанет враспор, а летом, наоборот, разойдётся.</p>
    <p>Пример расчёта по этому правилу. Путь уложен при +20 °C с зазором 3 мм, а проверка идёт в оттепель после мороза при −5 °C. Температура ниже на 25 °C, то есть на 2,5 шага по 10 °C. Поправка 2,5 × 1,5 = 3,75 мм, итоговый зазор около 6,75 мм. Если замер показывает 3 мм, зазор не соответствует температуре, и это замечание в акт.</p>
    <p>Поправка нужна именно при зимних оттепелях, о которых говорит п. 211: мороз сменяется плюсом за сутки, рельсы и грунт под ними ведут себя по-разному. Проектное значение зазора берут из документации пути, а правило из приложения служит проверкой логики расчёта.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Результат внеочередной проверки оформляется актом: так сказано в п. 210 ФНП № 461, который прямо перечисляет плановые и внеочередные проверки и требует хранить акты вместе с паспортами подъёмных сооружений. Запись в вахтенном журнале крановщика акт не заменяет, и в журнал полезно вписать ссылку на номер акта.</p>
    <p>Руководит проверкой инженерно-технический работник, ответственный за производственный контроль, а выполняют её работники, названные в пп. 207–208 — то есть крановщик под руководством ИТР. Если на одном пути стоит несколько кранов, записи ведут во всех вахтенных журналах, как этого требует п. 210 для осмотров после 24 смен.</p>
    <p>Минимальное содержание акта КРАН-КУБАНЬ строит как рекомендацию, а не как норму (в тексте ФНП формы акта нет): дата и событие, которое вызвало проверку; результаты замеров P1–P3 и зазора; состояние упоров и крепления; вывод о допуске крана к работе; подписи ответственных. Одна страница вместо абзаца в журнале экономит споры при последующей комиссии.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Порядок после сильного дождя или оттепели укладывается в пять шагов, и первый из них остановка, а не осмотр. Норма п. 211 не называет такой остановки прямо, но проверка «в объёме плановой» до её завершения не имеет смысла при работающем кране.</p>
    <ol>
      <li>Остановить передвижение крана по пути и не выводить его на размытый участок.</li>
      <li>Сообщить ответственному инженеру производственного контроля: событие произошло, решение за ним.</li>
      <li>Осмотреть путь по всей длине: размыв основания, вода между шпалами, смещение рельсов, состояние тупиковых упоров.</li>
      <li>Выполнить замеры отклонений через интервалы до 5 м и зазоры между рельсами с поправкой на температуру.</li>
      <li>Оформить акт и только после него вернуть кран в работу.</li>
    </ol>
    <p>Для площадок Кубани, где ливни приходят на сухой грунт и размывают отвал за час, КРАН-КУБАНЬ закладывает этот порядок в ППР. Как ливень воздействует на площадку у реки, видно в статье <a href="/blog/kran-dlya-ust-labinskogo-rayona/">«Кран для Усть-Лабинского района»</a>, а выбор между путём и фундаментом на таких грунтах разобран в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'Приказ Ростехнадзора № 461 от 26.11.2020 (ФНП ПС), ред. от 16.04.2026 — пп. 200, 203, 205–211, приложения № 3 и № 5' },
      { href: 'https://kran-kuban.ru/blog/ezhesmennyi-osmotr-bashennogo-krana/', label: 'kran-kuban.ru — ежесменный осмотр башенного крана (пп. 206–210)' },
      { href: 'https://kran-kuban.ru/park/kb-408-21/', label: 'kran-kuban.ru — карточка КБ-408.21: рельсовый ход' },
    ]} />
</BlogArticleLayout>
