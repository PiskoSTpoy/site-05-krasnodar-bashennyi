---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';
import { parkModels } from '../../../data/parkModels';

// Волна 97. Тридцать пятая статья блога — угол (a) информационный/how-to.
// До этой волны подбор модели был размазан по пяти карточкам парка и этапу
// «Проект и ППР»; здесь — один порядок действий: высота крюка → вылет →
// грузоподъёмность на вылете → основание → краевые факторы.
//
// Фактура: только проверенные цифры парка из src/data/parkModels.ts (одна
// правда для /park/ и карточек, источники — на карточках моделей). Пример
// расчёта оперирует условными исходными данными и прямо помечает их как
// условные: запас над препятствием, длину строповки и массу груза задаёт
// ППР конкретного объекта, а не блог. Федеральный слой (ФНП ПС) не
// пересказывается — тема site-01.
// Закон №608-КЗ — окна из опубликованных страниц сайта (kommersant.ru).

const CHECKED = '26 сентября 2026 года';
const PUBLISHED = '2026-09-26';

const title = 'Как подобрать башенный кран под объект: высота, вылет, груз';
const description = 'Подбор башенного крана в три шага: высота крюка, вылет до дальней точки и грузоподъёмность на этом вылете. Пример для 16-этажного дома на Кубани.';
const h1 = 'Как подобрать башенный кран под объект: высота крюка, вылет и грузоподъёмность';
const crumbTitle = 'Как подобрать башенный кран';
const slug = 'kak-podobrat-bashennyi-kran';

const H2 = [
  'Три параметра, по которым подбирают башенный кран',
  'Высота подъёма крюка: как её посчитать',
  'Вылет стрелы: от оси крана до дальней точки',
  'Грузоподъёмность на вылете, а не максимальная',
  'Пример подбора для 16-этажного дома',
  'Основание и площадка: второй фильтр',
  'Сейсмика и закон о тишине в подборе на Кубани',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Как рассчитать нужную высоту подъёма башенного крана?',
    a: 'Высоту подъёма крюка складывают из четырёх слагаемых: отметка самой высокой точки здания или препятствия, запас над ним по ППР, длина строповки и высота самого груза. Для дома высотой 48 метров с условными 2 м запаса, 4 м строповки и 2 м груза нужно около 56 метров. Под такую задачу в парке КРАН-КУБАНЬ подходят КБ-408.21, Potain MDT 219 J10, Potain MCH 175 и КБ-674А.',
  },
  {
    q: 'Почему нельзя выбирать кран по максимальной грузоподъёмности?',
    a: 'Максимальная грузоподъёмность башенного крана действует только на малом вылете у мачты. На конце стрелы допустимый груз в несколько раз меньше: у Potain MDT 219 J10 это 10 т максимум и 1,9 т на 65 м, у giraFFe SMK-5.66 — 5 т и 1,05 т на 43 м. Поэтому КРАН-КУБАНЬ проверяет самый тяжёлый груз на том вылете, где его реально будут поднимать.',
  },
  {
    q: 'Какой башенный кран нужен для девятиэтажного дома?',
    a: 'Девятиэтажный дом высотой около 27–30 метров с учётом кровли укладывается в диапазон свободностоящих кранов парка КРАН-КУБАНЬ: КБ-408.21 даёт 54,0–72,7 м высоты крюка, Potain MCH 175 — до 58,5 м. Быстромонтируемый giraFFe SMK-5.66 даёт до 41,7 м только с наклоном стрелы 20°, ценой вылета. Окончательный выбор зависит от вылета и массы грузов по ППР.',
  },
  {
    q: 'Что прислать, чтобы подобрали башенный кран?',
    a: 'Инженерной службе КРАН-КУБАНЬ нужны генплан участка с размерами здания и соседних строений, отметка верха здания, перечень самых тяжёлых элементов с массами, срок строительства и адрес площадки. По адресу определяют расчётную сейсмичность по ТСН 22-302-2000 и окна работы по закону №608-КЗ, а по генплану — место установки крана и нужный вылет.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция для заказчика"
  published={PUBLISHED}
>
    <p slot="intro">Башенный кран подбирают по трём числам: высоте подъёма крюка, вылету стрелы до самой дальней точки площадки и грузоподъёмности именно на этом вылете. Максимальная грузоподъёмность из рекламы — плохой ориентир: у Potain MDT 219 J10 она 10 т, но на конце 65-метровой стрелы — 1,9 т. Инженерная служба КРАН-КУБАНЬ проходит эти три шага по порядку, а на Кубани добавляет четвёртый — основание под расчётную сейсмичность по ТСН 22-302-2000 и график под закон №608-КЗ.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Подбор башенного крана КРАН-КУБАНЬ начинается с трёх параметров, и каждый отсекает часть парка. Высота подъёма крюка отвечает на вопрос «достанет ли кран до верха здания с грузом». Вылет стрелы отвечает на вопрос «дотянется ли кран из точки установки до дальнего угла здания и до склада». Грузоподъёмность на вылете отвечает на вопрос «поднимет ли кран самый тяжёлый элемент там, где его будут монтировать».</p>
    <p>Порядок проверки для крана КРАН-КУБАНЬ важен: высоту и вылет задаёт геометрия объекта, и их нельзя «докупить», а грузоподъёмность иногда решается делением груза или переносом склада ближе к мачте. Ниже — сводка пяти моделей парка по этим параметрам; источники цифр указаны на карточках моделей.</p>

    <div class="rule-table-wrap" style="margin-bottom:24px">
      <table class="rule-table">
        <caption style="text-align:left;margin-bottom:8px">Парк КРАН-КУБАНЬ: три параметра подбора</caption>
        <thead>
          <tr><th scope="col">Модель</th><th scope="col">Высота крюка</th><th scope="col">Вылет</th><th scope="col">Грузоподъёмность</th></tr>
        </thead>
        <tbody>
          {parkModels.map((m) => (
            <tr><td><a href={m.href}>{m.name}</a></td><td>{m.hookHeight}</td><td>{m.reach}</td><td>{m.capacity}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Высота подъёма крюка башенного крана КРАН-КУБАНЬ складывается из 4 слагаемых: отметки самой высокой точки здания или соседнего препятствия, запаса над этой точкой, длины строповки и высоты самого груза. Запас над препятствием задаёт проект производства работ, а не каталог крана. Считать нужно от верха того, что окажется под грузом: кровли с парапетом, лифтовой надстройки или соседнего дома, если стрела проходит над ним.</p>
    <p>Типичная ошибка при подборе крана — взять высоту здания и сравнить её с паспортом. Кран КРАН-КУБАНЬ с высотой крюка «впритык» к отметке кровли не поднимет на неё поддон со стропами. Для КБ-408.21 высоту набирают секциями мачты в диапазоне 54,0–72,7 м, для КБ-674А при креплении к зданию — до 116–120 м, поэтому запас лучше закладывать сразу, а не наращивать мачту посреди стройки.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Вылет башенного крана в парке КРАН-КУБАНЬ — от 40 м у КБ-408.21 до 65 м у Potain MDT 219 J10. Его измеряют от оси вращения до самой дальней точки подачи груза: дальнего угла здания, приёмной площадки или места разгрузки машин. Точку установки крана КРАН-КУБАНЬ выбирают первой — по генплану, с учётом подъезда, котлована и соседей. Длина пути от оси крана до дальнего угла здания и есть требуемый вылет.</p>
    <p>Для КРАН-КУБАНЬ стеснённая площадка в центре Краснодара или Сочи часто ограничивает не минимальный, а максимальный вылет: стрела не должна заходить на соседний участок или над дорогой. Здесь помогает Potain MCH 175 с маховой стрелой: вылет до 55 м сокращается наклоном стрелы почти до мачты. Как соседние здания сужают выбор модели, разобрано на этапе <a href="/etapy/proekt-i-ppr/">«Проект и ППР»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Грузоподъёмность башенного крана КРАН-КУБАНЬ падает с ростом вылета, и зависимость задаёт грузовая характеристика из паспорта модели. Максимум — 10 т у Potain MDT 219 J10 или 12,5 т у КБ-674А — доступен только на малом вылете у мачты. На конце стрелы остаётся 1,9 т на 65 м у MDT 219 J10, 5,6 т на 50,5 м у КБ-674А и 1,05 т на 43 м у giraFFe SMK-5.66.</p>
    <p>Проверка крана КРАН-КУБАНЬ по грузоподъёмности выглядит так: для каждого тяжёлого элемента по ППР берут его массу вместе со стропами и тарой и вылет, на котором его монтируют. Если хотя бы одна пара «масса — вылет» выходит за грузовую характеристику, модель не подходит. Обычно решающими оказываются бадья с бетоном, лестничные марши, плиты перекрытия и оборудование для кровли.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Пример подбора башенного крана КРАН-КУБАНЬ для 16-этажного дома строится на условных исходных данных, которые на реальном объекте даёт проект. Допустим, 16 этажей по 3 м дают отметку кровли 48 м. Запас над кровлей в примере — 2 м, строповка — 4 м, высота груза — 2 м. Требуемая высота крюка: 48 + 2 + 4 + 2 = 56 м.</p>
    <ul>
      <li>КБ-408.21 (54,0–72,7 м) — подходит при сборке мачты выше нижней границы диапазона.</li>
      <li>Potain MDT 219 J10 (до 70,4 м) и Potain MCH 175 (до 58,5 м) — подходят; у MCH 175 запас по высоте всего 2,5 м.</li>
      <li>КБ-674А (до 60 м свободностоящим) — подходит, а если дом вырастет, наращивается креплениями к зданию.</li>
      <li>giraFFe SMK-5.66 (до 41,7 м с наклоном стрелы) — не подходит по высоте.</li>
    </ul>
    <p>Дальше подбор крана КРАН-КУБАНЬ идёт по вылету. Если кран стоит напротив середины длинного фасада в 6 м от него, а здание имеет глубину 18 м и длину 40 м, до дальнего угла от оси крана √(24² + 20²) ≈ 31 м — это в пределах всех четырёх оставшихся моделей. Последний фильтр — грузовая характеристика: самый тяжёлый элемент на 31 м сверяют с паспортом каждой модели.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Основание — второй фильтр подбора крана КРАН-КУБАНЬ после 3 геометрических параметров. КБ-408.21 ходит по наземному рельсовому пути, Potain MDT 219 J10 и Potain MCH 175 ставят на рельсовый путь или монолитный фундамент, КБ-674А — на фундамент с анкеровкой к зданию. giraFFe SMK-5.66 встаёт на опорный контур 4×4 м без фундамента.</p>
    <p>Для крана КРАН-КУБАНЬ площадка без места под рельсовый путь сразу оставляет только фундаментные варианты. Слабый или обводнённый грунт делает фундамент дороже, а иногда меняет выбор модели. Что проверяют до устройства основания, разобрано на этапах <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a> и <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Краснодарский край добавляет к подбору башенного крана КРАН-КУБАНЬ 2 местных фактора: ТСН 22-302-2000 и закон №608-КЗ. Первый — сейсмичность: краевые нормы ТСН 22-302-2000 вместе с СП 14.13330.2018 задают расчётный балл площадки в диапазоне 7–9 баллов, и от него зависит нагрузка на основание крана. Балл конкретной площадки инженерная служба КРАН-КУБАНЬ берёт из проекта; как он складывается, разобрано в разделе <a href="/seysmozony/">«Сейсмозоны»</a>.</p>
    <p>Второй фактор — закон Краснодарского края №608-КЗ: шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Кран КРАН-КУБАНЬ в жилом квартале работает 13 часов в будни, и график монтажа тяжёлых элементов подгоняют под эти окна. Если окон не хватает, выручает кран с большей грузоподъёмностью: меньше подъёмов за смену при той же массе. Подробнее — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>
    <p>Генплан, отметку верха здания и список тяжёлых элементов можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ проведёт объект через все три шага подбора и назовёт подходящие модели парка.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://giraffecrane.ru/catalog/bashennye-krany/smk-5-66/', label: 'giraffecrane.ru — giraFFe SMK-5.66: грузоподъёмность, вылет, высота подъёма, опорный контур' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018 «Строительство в сейсмических районах»' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
