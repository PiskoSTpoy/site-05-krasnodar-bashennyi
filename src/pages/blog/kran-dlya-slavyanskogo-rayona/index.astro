---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 121. Сто девятая статья блога — угол (c) практический / региональный.
// Источник: smokk.ru/about/association-members/slavyanskiy-rayon (curl, проверено 27.10.2026).
// Факты источника: население 128 207 (01.01.2022) → 126 353 → 125 608 → 124 891 (01.01.2025);
// расчёт КРАН-КУБАНЬ: убыль за три года 128 207 − 124 891 = 3316 чел., 3316 / 128 207 = 2,59 % ≈ 2,6 %;
// за последний год 125 608 − 124 891 = 717 чел., 717 / 125 608 = 0,57 % ≈ 0,6 %;
// плотность 124 891 / 2198 = 56,8 чел./км²; площадь района 2198 км², Славянск-на-Кубани — 19,6 км² (0,9 %);
// границы: по реке Протоке 140 км (граничит с Красноармейским районом), по Кубани 60 км (с Крымским), по Азовскому морю 45 км;
// группа лиманов между Кубанью и Протокой 88 400 га (= 884 км², расчёт; 40,2 % от 2198 км² — сопоставление масштаба,
// источник не утверждает, что лиманы целиком в площади района) — Рамсарская конвенция;
// район образован 2 июня 1924 (10 сельсоветов), 11.02.1927 присоединены 5 сельсоветов, 31.12.1934 выделены Ивановский,
// Красноармейский и Черноерковский районы, 22.08.1953 вошла территория упразднённого Черноерковского района,
// 26.10.1965 город выведен из состава района (остаётся центром), 2005 — 15 муниципальных образований (список источника пересчитан: 15);
// экономика: пищевая и перерабатывающая промышленность — 80 % структуры производства; Анастасиевско-Троицкое и
// Сладковско-Морозовское месторождения, 45 % углеводородного сырья Кубани; 128 920 га сельхозугодий (= 1289,2 км², 58,7 % от 2198 км²),
// 25 крупных сельхозпредприятий, 3 рыбоводческих, 107 КФХ; рис — 35,2 % валового сбора по краю; федеральные автодороги
// на порты Новороссийск, Темрюк, Порт-Кавказ; станция Протока; запланирована реконструкция аэропорта Славянск-на-Кубани.
// Грунт, сейсмика, ветер, подтопление в источнике НЕТ — не названы. Город Славянск-на-Кубани разобран в отдельной статье
// (kran-dlya-slavyanska-na-kubani) — здесь акцент на район: дельта, лиманы, 15 поселений, рис и нефтегаз.
// Модели — только parkModels.ts.

const CHECKED = '27 октября 2026 года';
const PUBLISHED = '2026-10-27';

const title = 'Кран для Славянского района: 2198 км², лиманы и рис';
const description = '124 891 житель на 01.01.2025, 15 поселений, 88 400 га лиманов и 35,2 % риса края по данным СМОКК. Какой башенный кран выбрать в Славянском районе.';
const h1 = 'Какой башенный кран выбрать для объекта в Славянском районе Краснодарского края?';
const crumbTitle = 'Кран для Славянского района';
const slug = 'kran-dlya-slavyanskogo-rayona';

const H2 = [
  'Дельта между Кубанью и Протокой: 2198 км² и три границы',
  '15 муниципальных образований и один город на 19,6 км²',
  '124 891 житель и убыль 2,6 % за три года',
  '88 400 га лиманов: что это значит для площадки',
  'История: от 10 сельсоветов до 15 поселений',
  'Рис, переработка и нефтегаз: кому нужен кран',
  'Дороги, станция Протока и подвоз секций',
  'Порядок выбора башенного крана для Славянского района',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько жителей в Славянском районе и как меняется население?',
    a: 'По данным СМОКК, на 1 января 2025 года в районе 124 891 житель. На 1 января 2022 года было 128 207, убыль за три года составила 3316 человек, около 2,6 %. За последний год убыль — 717 человек, около 0,6 %. Для застройщика это спрос на замену фонда, а не на рост.',
  },
  {
    q: 'Какая площадь Славянского района и сколько в нём поселений?',
    a: 'Площадь района — 2198 км², из них город Славянск-на-Кубани занимает 19,6 км². С 2005 года в районе образовано 15 муниципальных образований, включая город. Адрес объекта КРАН-КУБАНЬ просит уточнять до уровня поселения, потому что разрешения и обращения о тишине решает местная администрация.',
  },
  {
    q: 'Почему лиманы важны для установки башенного крана?',
    a: 'Группа лиманов между Кубанью и Протокой занимает 88 400 га и признана Рамсарской конвенцией водно-болотными угодьями международного значения. СМОКК не приводит данных о грунтах, но для площадки вблизи воды основание выбирают по изысканиям, а не по аналогии. Подход описан в статье КРАН-КУБАНЬ об изысканиях.',
  },
  {
    q: 'Какой башенный кран подходит под высотное здание в Славянском районе?',
    a: 'Район в основном низкоэтажный: до 41,7 м хватает giraFFe SMK-5.66 с наклонной стрелой. Для зданий выше берут Potain MCH 175 до 58,5 м, КБ-674А до 60 м свободно или Potain MDT 219 J10 до 70,4 м. Окончательно модель выбирают по проекту, основанию и грузам.',
  },
  {
    q: 'Какую сейсмичность принимают для Славянского района?',
    a: 'Балл сейсмичности района СМОКК не приводит, и КРАН-КУБАНЬ не называет его без первоисточника. Значение для площадки берут по картам общего сейсмического районирования и ТСН 22-302-2000, для ответственных объектов уточняют микрорайонированием. Закон № 608-КЗ о тишине действует во всех поселениях района.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Дельта Кубани"
  published={PUBLISHED}
>
    <p slot="intro">Славянский район занимает 2198 км² между Кубанью, Протокой и Азовским морем, насчитывает 124 891 жителя на 1 января 2025 года и 15 муниципальных образований, а 80 % его промышленного производства, по данным СМОКК, приходится на пищевую и перерабатывающую отрасль. Для башенного крана КРАН-КУБАНЬ это объекты двух типов: жильё в станицах и корпуса переработки, а главный вопрос — основание на низкой речной земле.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Славянский район лежит между двумя рукавами одной системы: границы района тянутся на 140 км по реке Протоке, на 60 км по Кубани и на 45 км по побережью Азовского моря. По Протоке район граничит с Красноармейским районом, по Кубани — с Крымским. Площадь, по данным СМОКК, составляет 2198 км², и эти три границы вместе дают 245 км береговой и речной линии.</p>
    <p>Расчёт КРАН-КУБАНЬ: плотность населения 124 891 человек на 2198 км² — около 56,8 человека на квадратный километр. Для заказчика цифра показывает, что стройплощадки здесь разбросаны, а не сосредоточены, и перебазировка крана между объектами занимает время. Соседний район по Кубани разобран в статье <a href="/blog/kran-dlya-krymskogo-rayona/">«Кран для Крымского района»</a>, а Красноармейский — в статье <a href="/blog/kran-dlya-krasnoarmeyskogo-rayona/">«Кран для Красноармейского района»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>С 2005 года в Славянском районе действуют 15 муниципальных образований, включая Славянское городское поселение. Остальные 14 — сельские: Анастасиевское, Ачуевское, Забойское, Кировское, Коржевское, Маевское, Петровское, Прибрежное, Прикубанское, Протокское, Рисовое, Голубая Нива, Целинное и Черноерковское. Число КРАН-КУБАНЬ пересчитал по списку СМОКК, и оно совпало.</p>
    <p>Сам Славянск-на-Кубани занимает 19,6 км², то есть менее 1 % территории района: город маленький, а район большой. Поэтому в заявке на КРАН-КУБАНЬ указывают поселение, а не только район: администрация поселения выдаёт разрешения на строительство и принимает обращения по закону № 608-КЗ. Город разобран отдельно в статье <a href="/blog/kran-dlya-slavyanska-na-kubani/">«Кран для Славянска-на-Кубани»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Население Славянского района, по данным СМОКК, сокращалось три года подряд: 128 207 человек на 1 января 2022 года, 126 353 на 1 января 2023, 125 608 на 1 января 2024 и 124 891 на 1 января 2025. Расчёт КРАН-КУБАНЬ: 128 207 − 124 891 = 3316 человек, около 2,6 % за три года, а годовая убыль замедлилась с 1854 человек между первыми двумя датами до 717 между последними.</p>
    <p>Для застройки это сигнал о характере спроса: строят точечные дома, школы, склады и корпуса переработки, а не потоки новых микрорайонов. Под такие задачи подходит парк от лёгкого giraFFe SMK-5.66 до Potain MCH 175, и выбор определяют высота и вылет конкретного объекта. Подход — в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>На территории Славянского района между реками Кубанью и Протокой расположена группа лиманов общей площадью 88 400 га, которую Рамсарская конвенция признала водно-болотными угодьями международного значения. В квадратных километрах это 884 км²; для масштаба: 884 из 2198 км² — около 40 % площади района. Источник не утверждает, что лиманы целиком входят в эту площадь, поэтому цифра служит сравнением.</p>
    <p>Для башенного крана вода рядом — вопрос основания, а не высоты. СМОКК данных о грунтах и уровне вод не приводит, и КРАН-КУБАНЬ их не называет: значение для площадки получают изысканиями. Метод описан в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>, а выбор между рельсовым путём и фундаментом — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>
    <p>Побережье Азовского моря в 45 км границы означает открытое пространство и ветер. Предел ветра для работы определяет паспорт конкретной модели, например КБ-408.21 или Potain MDT 219 J10, а не район; порядок — в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>. Похожая приморская задача разобрана в статье <a href="/blog/bashennyi-kran-u-morya/">«Башенный кран у моря»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Славянский район образован 2 июня 1924 года в составе Кубанского округа Юго-Восточной области и первоначально включал 10 сельских советов. 11 февраля 1927 года к нему присоединили ещё пять сельсоветов упразднённого Поповичевского района, а 31 декабря 1934 года из его состава выделили Ивановский, Красноармейский и Черноерковский районы.</p>
    <p>Дальше границы менялись ещё несколько раз: 22 августа 1953 года вошла территория упразднённого Черноерковского района, с 11 февраля 1963 по 30 декабря 1966 года район включал территорию упразднённого Красноармейского. 26 октября 1965 года город вывели из состава района, оставив его центром. В 2005 году ликвидировали администрации сельских округов и образовали 15 муниципальных образований. Практический вывод КРАН-КУБАНЬ: в старых документах названия и границы могут не совпадать с нынешними, поэтому заказчик указывает кадастровый номер участка.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>СМОКК называет пищевую и перерабатывающую промышленность главной в районе: на неё приходится 80 % структуры производства. Агропромышленный комплекс включает 25 крупных сельскохозяйственных предприятий, 3 рыбоводческих хозяйства и 107 крестьянских хозяйств; сельскохозяйственных угодий в районе 128 920 га, то есть 1289 км² или около 59 % площади района.</p>
    <p>Рис — основная культура: 35,2 % валового сбора по краю даёт Славянский район. Для башенного крана это значит корпуса сушки, хранения и переработки, высота которых определяется технологией, а не жильём; расчёт на примере высокого корпуса 30 × 30 × 48 м — в статье <a href="/blog/kran-dlya-silosnogo-korpusa/">«Кран для силосного корпуса»</a>. КБ-674А поднимает крюк до 60 м свободно, Potain MDT 219 J10 — до 70,4 м.</p>
    <p>Второй профиль района — нефтегаз: Анастасиевско-Троицкое месторождение СМОКК называет крупнейшим в крае, а вместе со Сладковско-Морозовским район даёт 45 % углеводородного сырья Кубани. Площадки таких объектов имеют собственные требования безопасности, которые КРАН-КУБАНЬ уточняет по проекту заказчика, а не по общим правилам. Для складов и производственных корпусов метод в статьях <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a> и <a href="/blog/kran-dlya-sklada-angara/">«Кран для склада-ангара»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Через Славянск проходят автодороги федерального значения на порты Новороссийск, Темрюк и Порт-Кавказ, а в районе действует транспортный терминал железнодорожной станции Протока Северо-Кавказской железной дороги. Секции башни, стрела и противовесы идут тралом, и маршрут от базы КРАН-КУБАНЬ до поселения проверяют до подтверждения даты монтажа.</p>
    <p>Запланирована и реконструкция аэропорта Славянск-на-Кубани. Для крана рядом с аэродромом действуют отдельные ограничения высоты, которые определяют не район, а проект: КРАН-КУБАНЬ выясняет их у заказчика на этапе запроса. Сроки монтажа и состав работ — в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сроки»</a>. Погрузку материалов со станции регулируют нормы, описанные в статье <a href="/blog/pogruzka-razgruzka-transporta-bashennym-kranom/">«Погрузка и разгрузка транспорта башенным краном»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Модель под объект в Славянском районе КРАН-КУБАНЬ подбирает в четыре шага, начиная с типа здания. Порядок — практика инженерной службы, а не норма.</p>
    <ol>
      <li>Тип объекта: жилой дом, школа или склад — кран на низкий корпус до 27 м по крюку даёт giraFFe SMK-5.66, на высокий корпус — Potain MCH 175, КБ-674А или Potain MDT 219 J10.</li>
      <li>Основание: изыскания определяют, рельсовый путь, фундамент или опорный контур 4 × 4 м без фундамента; грунт района СМОКК не описывает, а вблизи лиманов и рек его выясняют отдельно.</li>
      <li>Ветер и шум: предел определяет паспорт модели, часы работы — закон № 608-КЗ, нормы шума — в статье <a href="/blog/uroven-shuma-v-decibelah/">«Уровень шума в децибелах»</a>.</li>
      <li>Подвоз и перебазировка: маршрут трала и точка разгрузки согласуются заранее.</li>
    </ol>
    <p>Адрес с названием поселения и размеры объекта можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и основание. Балл сейсмичности района СМОКК не приводит, поэтому его берут по ТСН 22-302-2000 и картам районирования. Цены и сроки зависят от площадки и без исходных данных не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
