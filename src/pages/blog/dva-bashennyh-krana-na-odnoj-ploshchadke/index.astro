---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 105. Шестидесятая статья блога — угол (a) информационная/how-to.
// Тема: два башенных крана на одной площадке. Не повторяет статью про опасную
// зону (там — граница зоны и сигнальное ограждение), а разбирает именно
// совместную работу: разведение стрел по высоте и стоянку в нерабочее время.
//
// Фактура (проверена 05.10.2026, текст пункта 160 ФНП № 461 — по двум
// источникам, консультант/судакт; WebFetch-сводке числа не доверял, сверил):
// - ФНП «Правила безопасности ОПО, на которых используются ПС», приказ
//   Ростехнадзора от 26.11.2020 № 461, п. 160: при пересечении зон обслуживания
//   совместно работающих башенных кранов стрелы и противовесные консоли — на
//   разных уровнях (однотипные краны — разное число секций башни); разность
//   уровней балочных стрел/консолей, включая канаты подвески и грузовые
//   канаты, — не менее 1 м по вертикали; на стоянке в нерабочее время
//   расстояния между кранами или их частями — не менее 2 м по горизонтали и
//   1 м по вертикали;
// - парк (parkModels.ts): Potain MDT 219 J10 — вылет 65 м, топлесс для
//   площадок с соседними кранами; КБ-408.21 — вылет 40 м, крюк 54,0–72,7 м;
//   Potain MCH 175 — переменный вылет до 55 м, сокращается наклоном стрелы.
// Федеральный нормативный слой закреплён за site-01 — здесь только п. 160 как
// инженерное условие размещения, без пересказа остальных ФНП.

const CHECKED = '5 октября 2026 года';
const PUBLISHED = '2026-10-05';

const title = 'Два башенных крана на одной площадке: какие нужны зазоры';
const description = 'Пункт 160 ФНП № 461: стрелы двух кранов разводят по высоте минимум на 1 м, на стоянке — 2 м по горизонтали. Как спланировать пару кранов.';
const h1 = 'Два башенных крана на одной площадке: какие зазоры нужны между стрелами';
const crumbTitle = 'Два башенных крана на одной площадке';
const slug = 'dva-bashennyh-krana-na-odnoj-ploshchadke';

const H2 = [
  'Когда на объекте нужны два башенных крана',
  'Что требует пункт 160 ФНП № 461',
  'Как развести два крана по высоте',
  'Стоянка двух кранов в нерабочее время',
  'Какие модели парка ставят парой',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какое расстояние должно быть между двумя башенными кранами на одной площадке?',
    a: 'Если зоны обслуживания кранов пересекаются, разность уровней балочных стрел и противовесных консолей вместе с канатами должна быть не менее 1 м по вертикали (пункт 160 ФНП № 461). На стоянке в нерабочее время расстояние между кранами или их частями — не менее 2 м по горизонтали и 1 м по вертикали. КРАН-КУБАНЬ закладывает запас сверх этого минимума.',
  },
  {
    q: 'Можно ли поставить два одинаковых башенных крана рядом?',
    a: 'Да, но однотипные краны с пересекающимися зонами должны иметь разное число секций башни, чтобы их стрелы шли на разных уровнях. Два КБ-408.21 из парка КРАН-КУБАНЬ разводят по высоте набором секций мачты в паспортном диапазоне крюка 54,0–72,7 м.',
  },
  {
    q: 'Как понять, что на объект нужен второй кран?',
    a: 'Сначала сравнивают круг обслуживания с пятном застройки. КБ-408.21 с вылетом 40 м обслуживает круг диаметром 80 м, Potain MDT 219 J10 с вылетом 65 м — круг диаметром 130 м. Если здание или два корпуса не помещаются в круг одного крана, либо нужно вести две захватки параллельно, планируют второй кран.',
  },
  {
    q: 'Где фиксируют высоты двух кранов?',
    a: 'Отметки стрел, противовесных консолей и порядок наращивания записывают в проект производства работ. КРАН-КУБАНЬ готовит схему размещения на этапе «Проект и ППР»: круги зон обоих кранов, зона пересечения и отметки, на которых краны проходят друг над другом.',
  },
  {
    q: 'Что делать, если при наращивании один кран приблизился к другому?',
    a: 'После каждого наращивания сверяют разность уровней стрел с проектной отметкой и не включают пересекающуюся зону, пока запас меньше 1 м. Если зоны мешают, помогает Potain MCH 175 из парка КРАН-КУБАНЬ: наклон маховой стрелы сокращает радиус и тем самым уменьшает область пересечения.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Монтаж и работа"
  published={PUBLISHED}
>
    <p slot="intro">Пункт 160 ФНП № 461 требует разводить стрелы двух совместно работающих башенных кранов по высоте: разность уровней балочных стрел и противовесных консолей, включая канаты, — не менее 1 м по вертикали. На стоянке в нерабочее время краны держат не ближе 2 м по горизонтали и 1 м по вертикали. КРАН-КУБАНЬ планирует пару кранов по высоте мачт ещё до выбора моделей.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Второй башенный кран появляется на объекте КРАН-КУБАНЬ тогда, когда один кран не покрывает пятно застройки. Круг обслуживания считают по вылету: КБ-408.21 с вылетом 40 м обслуживает круг диаметром 80 м, а Potain MDT 219 J10 с вылетом 65 м — круг диаметром 130 м. Протяжённый корпус или два дома на одном участке часто не помещаются в такой круг целиком.</p>
    <p>Вторая причина — темп. Два крана КРАН-КУБАНЬ ведут две захватки параллельно: пока один подаёт арматуру и бетон на первую секцию, другой работает на второй, и график не упирается в очередь на единственный крюк. Третья причина связана с грузом: тяжёлую панель на дальнем вылете и мелкую штучную подачу на ближней зоне удобнее развести между разными машинами.</p>
    <p>Цена такого решения — пересечение рабочих зон. В области, где круги двух кранов накладываются, стрела одного может пройти над стрелой, канатами или противовесом другого. Для этого случая и существует норма о разности уровней, которую КРАН-КУБАНЬ закладывает в схему размещения кранов до заказа техники.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Пункт 160 ФНП «Правила безопасности опасных производственных объектов, на которых используются подъёмные сооружения» (приказ Ростехнадзора от 26.11.2020 № 461) задаёт три условия для кранов с пересекающимися зонами. Стрелы и противовесные консоли должны находиться на разных уровнях. Однотипные краны для этого имеют разное число секций башни. Разность уровней балочных стрел или консолей, включая канаты подвески и грузовые канаты, составляет не менее 1 м по вертикали.</p>
    <p>Метр считают не до металла стрелы, а до самой низкой части системы: канаты подвески и грузовые канаты тоже входят в замер. Поэтому проектировщик КРАН-КУБАНЬ смотрит на нижнюю точку каната при поднятой обойме, а не на горизонтальную линию стрелы. Запас сверх одного метра защищает от прогиба стрелы под грузом и от раскачки каната на ветру.</p>
    <p>Условный пример показывает логику. Если нижняя точка канатов первого крана проходит на отметке 54,0 м, второй кран в зоне пересечения должен держать стрелу и канаты не ниже 55,0 м, а на практике КРАН-КУБАНЬ закладывает запас больше. Цифры примера иллюстративны: реальные отметки задаёт проект производства работ конкретного объекта.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Разведение двух кранов по высоте КРАН-КУБАНЬ делает пошагово ещё на стадии проекта производства работ. Мачта каждого крана собирается из секций, и число секций определяет отметку стрелы. Для КБ-408.21 из парка паспортный диапазон высоты крюка составляет 54,0–72,7 м, поэтому разность в несколько секций даёт нужный зазор без смены модели.</p>
    <ol>
      <li>Нанесите на генплан круги обслуживания обоих кранов по вылету стрел.</li>
      <li>Найдите зону пересечения кругов и отметьте её границы.</li>
      <li>Задайте башням разное число секций, чтобы стрелы и консоли шли на разных уровнях.</li>
      <li>Проверьте разность уровней с учётом канатов подвески и грузовых канатов — не менее 1 м по вертикали, лучше с запасом.</li>
      <li>Запишите отметки и порядок наращивания в проект производства работ.</li>
      <li>После каждого наращивания сверяйте фактическую разность с проектной.</li>
    </ol>
    <p>Шестой шаг важнее остальных: кран растёт вместе со зданием, и разность уровней меняется при каждой новой секции. Если выше поднимают нижний кран, он может приблизиться к стреле соседа. Поэтому КРАН-КУБАНЬ расписывает очередность наращивания двух кранов заранее, а не решает её на площадке.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>В нерабочее время два башенных крана КРАН-КУБАНЬ стоят с разведёнными стрелами, и ФНП № 461 задаёт для стоянки отдельные расстояния: не менее 2 м по горизонтали и 1 м по вертикали между кранами или их частями. Стрела любого крана при повороте не должна задевать башню, стрелу, противовес или канаты другого. Свободно поворачивающаяся на ветру стрела — именно тот случай, ради которого норма написана.</p>
    <p>На схеме размещения КРАН-КУБАНЬ отмечает для каждого крана парковочное положение стрелы и сектор, в который её можно развернуть. Если краны стоят рядом на параллельных рельсовых путях, сектора выбирают так, чтобы стрелы смотрели в разные стороны. Как рассчитывают границы такой зоны вокруг одного крана, разобрано в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Для площадки с двумя кранами КРАН-КУБАНЬ чаще всего берёт Potain MDT 219 J10: в реестре парка эта безоголовочная модель с вылетом 65 м отмечена как рассчитанная на площадки с соседними кранами и градостроительными ограничениями по высоте. Второй кран в паре подбирают по задаче: КБ-408.21 — когда нужна высота, набираемая секциями мачты, и тяжёлый противовес для 10 т. Сравнение этих двух моделей приведено в статье <a href="/blog/potain-mdt-219-j10-ili-kb-408-21/">«Potain MDT 219 J10 или КБ-408.21»</a>.</p>
    <p>Potain MCH 175 с маховой стрелой решает пересечение зон иначе: наклон стрелы сокращает радиус до почти вертикального положения у мачты, и область наложения кругов уменьшается. КБ-674А в паре с другим краном КРАН-КУБАНЬ рассматривает, когда здание выше предела свободностоящих моделей и один из кранов крепится к конструкции. Рельсовый путь или фундамент под каждый кран выбирают по правилам из статьи <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>
    <p>Схему размещения двух кранов инженерная служба КРАН-КУБАНЬ составляет по генплану и высоте здания. Прислать чертёж и адрес объекта можно через <a href="/#order">форму на главной</a>, порядок работ описан на странице <a href="/etapy/">«Этапы»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/f7815d9c6eac8483e35e0b74950da570d45ad998/', label: 'consultant.ru — ФНП «Правила безопасности ОПО, на которых используются подъёмные сооружения» (приказ Ростехнадзора № 461), установка ПС и производство работ' },
      { href: 'https://kran-kuban.ru/park/potain-mdt-219-j10/', label: 'kran-kuban.ru — карточка Potain MDT 219 J10: вылет 65 м, топлесс' },
      { href: 'https://kran-kuban.ru/park/kb-408-21/', label: 'kran-kuban.ru — карточка КБ-408.21: вылет 40 м, высота крюка 54,0–72,7 м' },
      { href: 'https://kran-kuban.ru/park/potain-mch-175/', label: 'kran-kuban.ru — карточка Potain MCH 175: переменный вылет' },
    ]} />
</BlogArticleLayout>
