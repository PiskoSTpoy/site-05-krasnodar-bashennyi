---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 123. Сто тринадцатая статья блога — угол (a) информационный / how-to.
// Источник: ФНП № 461 (приказ Ростехнадзора от 26.11.2020), пп. 229–234 — legalacts.ru через curl, проверено 29.10.2026.
// Факты пунктов: 229 — необходимость, условия и способы испытаний ГЗП в эксплуатации определяют с учётом документации изготовителя;
// 230 — ветви многоветвевых строп при испытании под углом 90° друг к другу, другой угол — с пересчётом нагрузок;
// 231 — спецприспособления: схема присоединения испытательного груза, отклонение массы ≤ 3 %, грейфер — симметричное нагружение челюстей;
// 232 — статическая нагрузка на 25 % выше грузоподъёмности, подъём на 50–100 мм, выдержка ≥ 10 минут, затем опускание;
// 233 — анализ после снятия нагрузки, остаточная деформация → к работе не допускают, при аварийной ситуации испытания прекращают;
// 234 — акт (протокол) для ГЗП и тары, при отрицательном результате — ремонт или утилизация.
// Расчёт-иллюстрация КРАН-КУБАНЬ (не норма): ГЗП на грузоподъёмность = максимум крана → 1,25 × Q:
//   giraFFe SMK-5.66 5 т → 6,25 т; Potain MDT 219 J10 и КБ-408.21 и Potain MCH 175 по 10 т → 12,5 т; КБ-674А 12,5 т → 15,625 ≈ 15,63 т.
//   Допуск 3 % от 6,25 т = 0,1875 т ≈ 188 кг → 6,06…6,44 т.
//   Двухветвевой строп, 6,25 т, угол между ветвями 90°: на ветвь 6,25 / (2 · cos 45°) = 6,25 / 1,4142 = 4,42 т.
//   Угол 60°: чтобы ветвь несла те же 4,42 т, общий груз 4,42 · 2 · cos 30° = 4,42 · 1,7321 = 7,65 т (геометрия, не методика изготовителя).
// НЕ названо: периодичность испытаний (в пп. 229–234 её нет), нормы браковки, исполнитель, цены, требования к площадке испытаний.
// Осмотр тары раз в месяц и строп раз в 10 дней — только ссылкой на статью про тару (пп. 226–228 там уже разобраны).

const CHECKED = '29 октября 2026 года';
const PUBLISHED = '2026-10-29';

const title = 'Испытания строп и тары: +25 % нагрузки и 10 минут по ФНП';
const description = 'Пункты 229–234 ФНП № 461: груз на 25 % выше грузоподъёмности, подъём на 50–100 мм, выдержка 10 минут, акт. Расчёт КРАН-КУБАНЬ по пяти моделям.';
const h1 = 'Как испытывают стропы, грейферы и тару для башенного крана по ФНП';
const crumbTitle = 'Испытания строп и тары по ФНП';
const slug = 'ispytaniya-gruzozahvatnyh-prisposoblenij-i-tary-po-fnp';

const H2 = [
  'Пункт 229: кто решает, как испытывать',
  'Пункт 230: ветви строп под углом 90°',
  'Пункт 231: специальные приспособления и грейфер',
  'Пункт 232: нагрузка выше на 25 %, выдержка 10 минут',
  'Пункт 233: остаточная деформация закрывает допуск',
  'Пункт 234: акт или протокол испытания',
  'Расчёт: испытательный груз для пяти моделей парка',
  'Что в пунктах 229–234 не сказано',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой нагрузкой испытывают стропы и другие грузозахватные приспособления?',
    a: 'По пункту 232 ФНП № 461 статическая нагрузка превышает грузоподъёмность приспособления на 25 процентов. Для стропа на 5 т испытательный груз равен 6,25 т. Груз поднимают с малыми ускорениями на 50–100 мм и держат не менее 10 минут. КРАН-КУБАНЬ напоминает, что цифра относится к приспособлению, а не к крану.',
  },
  {
    q: 'Сколько времени груз висит при испытании стропа?',
    a: 'Не менее 10 минут. Пункт 232 требует поднять испытательный груз на высоту 50–100 мм, выдержать его в таком положении и после этого опустить на площадку. Подъём ведут с возможно меньшими ускорениями, чтобы не создать динамическую добавку. Меньшую выдержку акт не подтвердит.',
  },
  {
    q: 'Как испытывают двухветвевой строп: под каким углом?',
    a: 'Пункт 230 требует расположить ветви под углом 90 градусов друг к другу. Другой угол допускается, но нагрузки нужно пересчитать. Расчёт КРАН-КУБАНЬ показывает масштаб: при 60° между ветвями ту же нагрузку на ветвь создаёт общий груз около 7,65 т вместо 6,25 т. Методику берут у изготовителя.',
  },
  {
    q: 'Что делать, если после снятия нагрузки строп остался деформированным?',
    a: 'Пункт 233 не допускает такое приспособление к работе: остаточная деформация, возникшая от испытательного груза, — основание для отказа. Результат записывают в акт с описанием дефекта и вероятной причины, а приспособление направляют в ремонт или на утилизацию. Повторное испытание без устранения причины смысла не имеет.',
  },
  {
    q: 'Нужно ли оформлять результат испытаний тары и строп?',
    a: 'Да, пункт 234 требует акт или протокол для приспособлений и тары. При положительном результате в нём подтверждают, что изделие выдержало испытание и соответствует действующим паспорту и руководству по эксплуатации. При отрицательном перечисляют дефекты и причины. Документ КРАН-КУБАНЬ хранит рядом с журналом осмотров.',
  },
  {
    q: 'Как часто нужно испытывать грузозахватные приспособления?',
    a: 'Пункты 229–234 ФНП № 461 срок не называют: необходимость, условия и способы определяют с учётом документации изготовителя. Поэтому периодичность берут из паспорта и руководства по эксплуатации приспособления. Регулярные осмотры — отдельная норма: строп смотрят раз в 10 дней, и это разобрано в статье про тару.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Испытания"
  published={PUBLISHED}
>
    <p slot="intro">Статическое испытание грузозахватного приспособления по ФНП № 461 проводят нагрузкой на 25 % выше его грузоподъёмности: груз поднимают на 50–100 мм и держат не менее 10 минут (пункт 232). Для стропа на 5 т испытательный груз равен 6,25 т. Остаточная деформация закрывает допуск к работе, а итог оформляют актом. КРАН-КУБАНЬ разбирает пункты 229–234 по порядку и считает груз для пяти моделей парка.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 229 ФНП № 461 не задаёт цифр, а отсылает к изготовителю: необходимость, условия и способы испытаний приспособления в период эксплуатации определяют с учётом его эксплуатационной документации. Для КРАН-КУБАНЬ это значит, что первым документом при любом вопросе об испытании служит паспорт стропа, траверсы или грейфера, а не общая таблица.</p>
    <p>Практический вывод для заказчика: на площадке с краном Potain MDT 219 J10 или КБ-674А рядом с паспортом крана лежат паспорта на каждый строп и каждую тару. Без них нельзя ответить на вопрос, какой груз считать испытательным. Порядок строповки и подбора строп описан в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Пункт 230 требует при испытании многоветвевых строп расположить ветви под углом 90 градусов по вертикали друг к другу. Другой угол допустим, но испытательные нагрузки тогда пересчитывают. Условие важно для строп любого крана КРАН-КУБАНЬ, потому что нагрузка на ветвь растёт вместе с углом между ветвями.</p>
    <p>Расчёт КРАН-КУБАНЬ показывает масштаб. Двухветвевой строп на 5 т испытывают грузом 6,25 т; при угле 90° на каждую ветвь приходится 6,25 / (2 · cos 45°) = 4,42 т. Если взять угол 60° и сохранить те же 4,42 т на ветвь, общий груз составит 4,42 · 2 · cos 30° ≈ 7,65 т. Это геометрическая иллюстрация, а методику пересчёта даёт изготовитель.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пункт 231 разбирает случай, когда испытательный груз нельзя зацепить самим приспособлением. Тогда инструкция по испытаниям должна содержать схему надёжного присоединения груза нужной массы. Отклонение массы не должно превышать 3 процентов. Для условного изделия на 6,25 т допуск равен 0,1875 т, то есть около 188 кг: груз укладывается в диапазон 6,06–6,44 т.</p>
    <p>Для грейфера на крюке КБ-408.21 или Potain MCH 175 пункт 231 добавляет правило: статическую прочность проверяют симметричным нагружением челюстей. Недостающую массу набирают двумя способами: предварительно взвешенный груз кладут внутрь, а дополнительный подвешивают к челюстям снизу, либо подвешивают всю массу к челюстям. Схему записывают в руководстве по эксплуатации грейфера или в инструкции по испытаниям.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Пункт 232 описывает сам опыт: статическая нагрузка превышает грузоподъёмность приспособления на 25 процентов. Груз, зацепленный или обвязанный испытываемым приспособлением, поднимают с возможно меньшими ускорениями на высоту 50–100 мм и держат не менее 10 минут. По истечении времени груз опускают на площадку.</p>
    <p>Для КРАН-КУБАНЬ из этого пункта следуют три практических требования. Подъём ведут плавно, потому что рывок создаёт динамическую добавку к нагрузке. Высота подъёма мала: речь о сантиметрах над площадкой, а не о метрах. Выдержка отсчитывается с момента зависания, и меньшее время акт не подтверждает.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Пункт 233 требует анализировать результат после снятия нагрузки. Если на приспособлении осталась деформация, вызванная испытательным грузом, к работе его не допускают. Для строп Potain MDT 219 J10 и других моделей парка это значит: проверка идёт на разгруженном изделии, а не на висящем.</p>
    <p>Тот же пункт обязывает прекратить или приостановить испытания при аварийной ситуации, угрожающей людям, которые в них участвуют. Продолжать можно только после устранения причин остановки. Рекомендация КРАН-КУБАНЬ: на площадке испытаний оставляют только участников опыта, потому что под висящим грузом 6,25–15,63 т находиться нельзя; правила опасной зоны крана — в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Пункт 234 фиксирует результат документом: статические испытания приспособлений и тары оформляют актом или протоколом. При положительном итоге в нём подтверждают, что изделие выдержало испытание, соответствует паспорту и руководству по эксплуатации и находится в работоспособном состоянии. При отрицательном — перечисляют дефекты, повреждения и вероятные причины.</p>
    <p>Дальше путь изделия определён однозначно: ремонт или утилизация. Для заказчика КРАН-КУБАНЬ это прямая выгода: акт показывает, что строп конкретного крана не списан на словах, а проверен нагрузкой. Журнал осмотров тары и строп, который ведут отдельно, описан в статье <a href="/blog/tara-dlya-bashennogo-krana-po-fnp/">«Тара для башенного крана по ФНП»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Возьмём приспособление, грузоподъёмность которого равна максимуму крана. Это допущение КРАН-КУБАНЬ для сравнения; реальное приспособление может быть слабее. Испытательный груз по пункту 232 равен 1,25 от грузоподъёмности, а допуск по массе 3 % добавляет диапазон (на примере giraFFe SMK-5.66 — 188 кг).</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель парка</th><th>Максимум крана</th><th>Испытательный груз (×1,25)</th><th>Допуск ±3 %</th></tr></thead>
      <tbody>
        <tr><td>giraFFe SMK-5.66</td><td>5 т</td><td>6,25 т</td><td>±0,19 т</td></tr>
        <tr><td>КБ-408.21</td><td>10 т</td><td>12,5 т</td><td>±0,38 т</td></tr>
        <tr><td>Potain MCH 175</td><td>10 т</td><td>12,5 т</td><td>±0,38 т</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>10 т</td><td>12,5 т</td><td>±0,38 т</td></tr>
        <tr><td>КБ-674А</td><td>12,5 т</td><td>15,63 т</td><td>±0,47 т</td></tr>
      </tbody>
    </table></div>
    <p>Вывод таблицы: испытательный груз приспособления привязан к его паспорту, а не к крану. У Potain MDT 219 J10 он составил бы 12,5 т, тогда как на вылете 65 м кран поднимает 1,9 т, то есть в 6,6 раза меньше. Значит, испытательный груз нельзя «примерять» к дальнему вылету: условия опыта задаёт методика изготовителя. Каталожные данные парка — на странице <a href="/park/">«Парк техники»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Пункты 229–234 ФНП № 461 не называют периодичность испытаний, исполнителя и нормы браковки каната или цепи, и КРАН-КУБАНЬ не выдумывает эти значения. Сроки и условия берут из документации изготовителя приспособления. Браковка стального каната на кране — отдельная тема, разобранная в статье <a href="/blog/zamena-i-brakovka-stalnogo-kanata-bashennogo-krana/">«Замена и браковка стального каната»</a>.</p>
    <p>Испытания приспособлений не заменяют проверки самого крана. Для Potain MCH 175 и КБ-674А полное техническое освидетельствование идёт по своему порядку: <a href="/blog/tekhnicheskoe-osvidetelstvovanie-bashennogo-krana/">«Техническое освидетельствование башенного крана»</a>. Подъём груза по ФНП разобран в статье <a href="/blog/podem-gruza-bashennym-kranom-po-fnp/">«Подъём груза башенным краном по ФНП»</a>. Вопрос по паспорту на строп можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, пп. 229–234 (испытания грузозахватных приспособлений и тары)' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: грузоподъёмность пяти моделей' },
      { href: 'https://kran-kuban.ru/blog/tara-dlya-bashennogo-krana-po-fnp/', label: 'kran-kuban.ru — тара для башенного крана по ФНП (осмотры и журнал)' },
    ]} />
</BlogArticleLayout>
