---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 112. Восьмидесятая статья блога — угол (a) информационный/how-to.
// ППР с башенным краном: что должно быть в проекте производства работ, кто его
// утверждает, с чем знакомят под подпись. ППР упоминается в десятках статей
// сайта вскользь, отдельной статьи до этой не было.
//
// Фактура — сырой текст ФНП № 461 (legalacts.ru, curl, ред. 16.04.2026),
// проверено 14.10.2026, пункты сверены по тексту:
// - п. 40: при монтаже ПС работы ведут по руководству изготовителя и по ППР,
//   разрабатываемому для монтажа на конкретном объекте; изменения в ППР в ходе
//   монтажа разрабатывает организация, отвечающая за монтаж; в ППР на монтаж
//   для ПС на строительных работах отдельно определены требования к демонтажу;
//   ППР на демонтаж допускается разрабатывать отдельно;
// - п. 98: ограничение зоны перемещения ПС и грузов (над коммуникациями,
//   проезжей частью, в стеснённых условиях) — по ППР, разработанному
//   эксплуатирующей или специализированной организацией по пп. 155–163; ППР
//   утверждает эксплуатирующая организация; работа с отступлениями не
//   допускается; изменения вносит разработчик;
// - п. 155: ПОС — соответствие ПС условиям работ по грузоподъёмности, высоте,
//   вылету, ветровой нагрузке и сейсмичности; расстояния до ЛЭП, транспорта;
// - п. 156: состав ППР: соответствие ПС (грузоподъёмность, высота, вылет,
//   ветер, сейсмичность), расстояния до ЛЭП, откосы, несколько кранов на пути,
//   перечень грузозахватных приспособлений и схемы строповки, места складирования,
//   опасные зоны по приложению № 2, минимальная скорость поворота стрелы при
//   расстоянии от груза до границы опасной зоны менее 7 м, разрез здания на
//   полную высоту при максимальном и минимальном вылете, зазоры: от низа груза
//   до выступающих частей не менее 0,5 м, до перекрытий и площадок с людьми —
//   не менее 2,3 м; запрет работ на высоте при ветре выше паспортного;
// - пп. 157–158: ППР утверждён эксплуатирующей организацией и выдан на участок
//   до начала работ; ИТР, крановщики, стропальщики знакомятся под подпись;
// - п. 159: раздел об организации безопасных работ: совместная работа двух и
//   более ПС, координатная защита, выписка из паспорта о силе ветра, связь
//   крановщика со стропальщиком, мероприятия при опасной зоне над дорогой;
// - п. 160: расстояние между совместно работающими кранами по горизонтали не
//   менее 5 м, разность уровней стрел не менее 1 м, условия — в ППР.
// Не называется: номера и формы листов ППР (ФНП их не задаёт), стоимость.

const CHECKED = '14 октября 2026 года';
const PUBLISHED = '2026-10-14';

const title = 'ППР для башенного крана: что должно быть в проекте';
const description = 'Проект производства работ с башенным краном обязан содержать разрез здания, зазоры 0,5 и 2,3 м и схемы строповки — состав по пп. 155–160 ФНП № 461.';
const h1 = 'Что должно быть в проекте производства работ с башенным краном и кто его утверждает';
const crumbTitle = 'ППР для башенного крана';
const slug = 'proekt-proizvodstva-rabot-s-bashennym-kranom';

const H2 = [
  'Чем ППР отличается от ПОС и от паспорта крана',
  'Что обязан содержать ППР: перечень пункта 156',
  'Разрез здания и зазоры 0,5 м и 2,3 м',
  'Опасные зоны и скорость поворота стрелы',
  'Кто утверждает ППР и кого знакомят под подпись',
  'Когда ППР меняют и кто вносит изменения',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Что такое ППР при работе башенного крана?',
    a: 'Проект производства работ — документ, который привязывает кран к конкретной площадке: модель, вылет, высоту, зазоры до здания, опасные зоны, схемы строповки и порядок работы нескольких кранов. Состав задан пунктами 155–160 ФНП № 461. КРАН-КУБАНЬ включает его в комплект до монтажа.',
  },
  {
    q: 'Кто утверждает ППР на работу башенного крана?',
    a: 'Организация, которая эксплуатирует кран: пункт 98 ФНП № 461 требует утверждения ППР эксплуатирующей организацией, а пункт 157 — выдачи документа на участок до начала работ. Разработать ППР может эксплуатирующая или специализированная организация. Изменения вносит его разработчик.',
  },
  {
    q: 'Нужен ли отдельный ППР на демонтаж башенного крана?',
    a: 'Требования к демонтажу должны быть определены отдельно уже в ППР на монтаж, а сам ППР на демонтаж по пункту 40 ФНП № 461 допускается разрабатывать отдельным документом. КРАН-КУБАНЬ готовит демонтажную часть до монтажа, потому что условия на площадке к концу стройки меняются.',
  },
  {
    q: 'Какие расстояния от груза до здания должен задать ППР?',
    a: 'От низа перемещаемого груза до наиболее выступающих по вертикали частей здания — не менее 0,5 м, а до перекрытий и площадок, где могут находиться люди, — не менее 2,3 м. Длина стропов и траверсы входят в расчёт (подпункт «к» пункта 156 ФНП № 461).',
  },
  {
    q: 'Кого нужно ознакомить с ППР под подпись?',
    a: 'Инженерно-технических работников, ответственных за безопасное производство работ, крановщиков, машинистов подъёмников, рабочих люльки и стропальщиков — до начала работ (пункт 158 ФНП № 461). КРАН-КУБАНЬ рекомендует хранить лист ознакомления вместе с ППР на площадке.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Инструкция · Документы"
  published={PUBLISHED}
>
    <p slot="intro">ППР с башенным краном по пункту 156 ФНП № 461 обязан содержать минимум тринадцать позиций — от соответствия крана ветру и сейсмичности до разреза здания на полную высоту. Утверждает документ организация, эксплуатирующая кран, а с содержанием под подпись знакомят крановщика и стропальщика до первого подъёма. КРАН-КУБАНЬ собирает ППР из паспорта модели и плана площадки.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Три документа отвечают на три разных вопроса, и путать их нельзя. Паспорт крана описывает машину вообще: грузовую характеристику, ветровой предел, приборы безопасности. Проект организации строительства (ПОС) по пункту 155 ФНП № 461 решает, годится ли такой кран объекту по грузоподъёмности, высоте, вылету, ветру и сейсмичности. ППР же описывает, как именно кран работает на этой площадке в эту стройку.</p>
    <p>Для КРАН-КУБАНЬ порядок такой: сначала параметры объекта и изыскания, затем выбор модели из парка, затем ППР. Выбор модели — отдельная задача, разобранная в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>, а исходные данные по грунту — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>. Если ПОС уже содержит часть позиций, пункт 156 допускает не повторять их в ППР.</p>
    <p>Монтаж и демонтаж идут по тому же принципу. Пункт 40 ФНП № 461 требует вести монтаж по руководству изготовителя и по ППР, разработанному для монтажа на конкретном объекте. Требования к демонтажу при этом должны быть определены отдельно уже в проекте на монтаж, а полноценный ППР на демонтаж допускается разрабатывать отдельным документом.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Пункт 156 ФНП № 461 перечисляет, что должно быть предусмотрено в ППР, если этого нет в ПОС. Для башенного крана КРАН-КУБАНЬ применяет из этого перечня позиции, которые относятся к кранам; позиции про подъёмники (вышки) остаются в тексте нормы. Содержание сгруппировано в таблице.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Блок ППР</th><th>Что в нём должно быть</th><th>Подпункт пункта 156</th></tr></thead>
      <tbody>
        <tr><td>Соответствие крана объекту</td><td>Грузоподъёмность, высота подъёма, вылет, ветровая нагрузка, сейсмичность района</td><td>а</td></tr>
        <tr><td>Расстояния до внешних объектов</td><td>Линии электропередачи, городской транспорт, пешеходы, оборудование и строения, склады материалов</td><td>б</td></tr>
        <tr><td>Откосы котлованов</td><td>Условия установки и работы вблизи откосов</td><td>в</td></tr>
        <tr><td>Несколько кранов</td><td>Работа нескольких кранов на одном и на параллельных путях, указатели и ограничители</td><td>г</td></tr>
        <tr><td>Строповка</td><td>Перечень грузозахватных приспособлений, схемы строповки, способы кантовки</td><td>д</td></tr>
        <tr><td>Склады и подъезды</td><td>Места и габариты складирования грузов, подъездные пути</td><td>е</td></tr>
        <tr><td>Опасные зоны</td><td>Зоны по приложению № 2, меры при попадании в них людей и зданий</td><td>ж</td></tr>
        <tr><td>Графика</td><td>Разрез здания на полную высоту, зазоры по вертикали и горизонтали, выступающие элементы</td><td>и, к, л, м</td></tr>
      </tbody>
    </table></div>
    <p>Две позиции пункта 156 КРАН-КУБАНЬ проверяет первыми, потому что именно на них чаще всего возвращают проект на доработку: схемы строповки и разрез здания. Схема без перечня стропов и траверс не имеет смысла, а разрез без указанных вылетов нельзя проверить на пересечения. Подробности о схемах строповки разобраны в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Разрез здания на полную высоту — обязательная графика ППР: подпункт «и» пункта 156 требует показать положение стрелы над зданием при максимальном и минимальном вылете, а выступающие металлоконструкции крана — пунктиром при повороте на 180 градусов. По этому чертежу видно, заденет ли консоль противовеса соседний балкон или карниз.</p>
    <p>Зазоры задают подпункты «к» и «л». От низа перемещаемого груза до наиболее выступающих по вертикали частей здания должно быть не менее 0,5 м, а до перекрытий и площадок, где могут находиться люди, — не менее 2,3 м. Длина стропов и размеры траверсы в расчёт входят. Пример: груз на крюке КБ-408.21 висит на стропах длиной 3 м, поэтому высоту подъёма над парапетом считают от нижней точки груза, а не от крюка.</p>
    <p>Отдельно считают элементы, выступающие в горизонтальной плоскости: карнизы, балконы, ограждения, эркеры, козырьки и входы (подпункт «м»). КРАН-КУБАНЬ рекомендует выносить такие элементы на план площадки с размерами, потому что ошибка обнаруживается не на чертеже, а при повороте стрелы.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Опасные зоны определяют по приложению № 2 к ФНП № 461, и пункт 156 заставляет сделать это в ППР, а не оставлять крановщику. Если в зону от перемещаемого груза или от строящегося здания могут попасть эксплуатируемые здания, дороги или места, где находятся люди, нужны меры, исключающие возникновение там опасной зоны. Падение самого крана и его узлов при определении зон не учитывается.</p>
    <p>Меры названы прямо: кран оснащают дополнительными средствами ограничения зоны, а скорость поворота стрелы в сторону границы рабочей зоны ограничивают до минимальной, когда груз ближе 7 м к границе опасной зоны. Такие решения согласуют с собственником или владельцем имущества, которое попадает в зону. Расчёт зоны для самого крана разобран в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>.</p>
    <p>Если рядом линия электропередачи, ППР подтягивает расстояния из приложений № 1 и № 2, а наряд-допуск оформляют отдельно; порядок описан в статье <a href="/blog/bashennyi-kran-ryadom-s-lep/">«Башенный кран рядом с ЛЭП»</a>. Для КРАН-КУБАНЬ линия на плане — стандартная причина вернуть ППР на доработку, пока кран не смонтирован.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Утверждает ППР эксплуатирующая организация — так сказано в пункте 98 ФНП № 461, а пункт 157 добавляет срок: документ выдают на участок до начала работ. Разработать его вправе эксплуатирующая или специализированная организация. Если кран арендован, ответственность за эксплуатацию на площадке распределяют договором — в статье <a href="/blog/arenda-krana-s-mashinistom-ili-bez/">«Аренда крана с машинистом или без»</a> показано, как это меняет роли сторон.</p>
    <p>Знакомство с документом — отдельный шаг. Пункт 158 перечисляет, кого ознакомить под подпись до начала производства работ: инженерно-технических работников, ответственных за безопасное производство, крановщиков, машинистов подъёмников, рабочих люльки и стропальщиков. Подпись в листе ознакомления — доказательство, что стропальщик знал схему строповки на своём объекте.</p>
    <p>Раздел об организации безопасных работ (пункт 159) КРАН-КУБАНЬ делает коротким и проверяемым. Он содержит условия совместной работы двух и более кранов, координатную защиту, выписку из паспорта о силе ветра, при которой работа запрещена, радиосвязь крановщика со стропальщиком и меры на случай опасной зоны над дорогой. Ветровой предел и порядок его чтения — в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Работа с отступлениями от ППР не допускается — это прямое требование пункта 98 ФНП № 461, поэтому изменение обстановки означает изменение документа. Вносит его разработчик ППР, а не прораб и не крановщик. Для КРАН-КУБАНЬ поводом пересмотра служат пять ситуаций: второй кран на площадке, новая линия электропередачи у границы, смена схемы строповки, перенос склада и изменение оси пути.</p>
    <p>Два крана на одной площадке — самая частая причина. Пункт 160 ФНП № 461 требует расстояние по горизонтали между кранами, стрелами и грузами не менее 5 м, а при пересечении зон обслуживания стрелы и противовесные консоли должны быть на разных уровнях с разностью не менее 1 м; условия обязательно приводят в ППР. Вся схема разобрана в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>.</p>
    <p>Порядок подготовки ППР КРАН-КУБАНЬ рекомендует такой. Перечень — рекомендация, а не перечень из ФНП № 461.</p>
    <ol>
      <li>Получить отчёт изысканий и план площадки с линиями, соседними зданиями и складами.</li>
      <li>Выбрать модель по высоте, вылету и грузу из парка и приложить выписку из паспорта о ветре.</li>
      <li>Начертить разрез здания и посчитать зазоры 0,5 и 2,3 м с учётом стропов и траверсы.</li>
      <li>Определить опасные зоны и согласовать меры с владельцами попадающих в них объектов.</li>
      <li>Утвердить документ у эксплуатирующей организации и собрать подписи в листе ознакомления.</li>
    </ol>
