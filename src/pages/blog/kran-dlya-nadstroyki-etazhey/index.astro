---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 122. Сто одиннадцатая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «надстройка этажей над существующим домом»: здание 48 × 12 м, существующая высота 21 м (7 этажей),
// надстройка +12 м (4 этажа по 3 м) → итоговая высота 33 м — иллюстрация, помечена в тексте.
// Отличие от дома, школы, ангара, корпуса: здание уже стоит, перепад между «этажом работ» и землёй 21–33 м,
// высота крюка решает больше, чем вылет. Потребный крюк: 33 + 0,5 (п. 114 ФНП № 461) + 3 + 4 = 40,5 м.
// План: x ∈ [0; 48], y ∈ [0; 12]. Стоянка S1 — снаружи у середины длинной стены, 8 м от стены: (24; −8).
//   Дальние углы (0;12) и (48;12): √(24² + 20²) = √976 = 31,24 м; ближние (0;0), (48;0): √(24² + 8²) = √640 = 25,30 м.
//   Запас по вылету: КБ-408.21 (40) +8,76; SMK-5.66 (43) +11,76; КБ-674А (50,5) +19,26; MCH 175 (55) +23,76; MDT 219 J10 (65) +33,76.
// Стоянка S2 — снаружи у торца, 8 м от торца, на оси: (−8; 6). Дальние углы (48;0) и (48;12): √(56² + 6²) = √3172 = 56,32 м.
//   Запас: КБ-408.21 −16,32; SMK-5.66 −13,32; КБ-674А −5,82; MCH 175 −1,32; MDT 219 J10 +8,68.
// Высота крюка (parkModels.ts): КБ-408.21 54,0–72,7 → +13,5 от нижней границы; SMK-5.66 27 (гориз.) → −13,5; 41,7 (наклон 20°) → +1,2,
//   но наклон сокращает вылет, и значение вылета при наклоне в parkModels.ts нет — в расчёт не берётся; КБ-674А до 60 свободно → +19,5;
//   MCH 175 до 58,5 → +18,0; MDT 219 J10 до 70,4 → +29,9. КБ-674А: анкеровка к надстраиваемому зданию не нужна (40,5 < 60).
// НЕ названо: цены, сроки, нагрузки на существующие конструкции, допустимость анкеровки, работы над эксплуатируемым зданием как норма
// (только отсылка к статье о проёмах и ППР), массы элементов надстройки.

const CHECKED = '28 октября 2026 года';
const PUBLISHED = '2026-10-28';

const title = 'Кран для надстройки этажей: высота крюка 40,5 м решает выбор';
const description = 'Дом 48 × 12 м, надстройка до 33 м: нужен крюк 40,5 м, у торца вылет 56,32 м. Расчёт КРАН-КУБАНЬ по пяти моделям и двум стоянкам.';
const h1 = 'Какой башенный кран нужен для надстройки этажей над существующим домом';
const crumbTitle = 'Кран для надстройки этажей';
const slug = 'kran-dlya-nadstroyki-etazhey';

const H2 = [
  'Исходные данные примера: дом 48 × 12 м и четыре новых этажа',
  'Потребная высота крюка 40,5 м: здесь она решает',
  'Стоянка S1 у длинной стены: вылет 31,24 м',
  'Стоянка S2 у торца: вылет 56,32 м',
  'Модель giraFFe SMK-5.66: 1,2 м запаса только с наклоном',
  'Нужна ли анкеровка КБ-674А к существующему зданию',
  'Что остаётся за пределами расчёта',
  'Сводка: модель, запасы по высоте и вылету',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая высота крюка нужна для надстройки четырёх этажей над семиэтажным домом?',
    a: 'Для условного дома высотой 21 м и надстройки 12 м итоговая высота равна 33 м, потребный крюк — 40,5 м: 33 + 0,5 м запаса по пункту 114 ФНП № 461 + 3 м груз + 4 м стропы. Груз и стропы — допущения КРАН-КУБАНЬ, в проекте их заменяют по самому высокому элементу.',
  },
  {
    q: 'Хватит ли giraFFe SMK-5.66 для надстройки до 33 м?',
    a: 'С горизонтальной стрелой крюк giraFFe SMK-5.66 поднимается до 27 м, и до 40,5 м он не достаёт на 13,5 м. С наклоном стрелы 20° высота крюка 41,7 м даёт запас 1,2 м, но наклон сокращает вылет, а значение вылета при наклоне КРАН-КУБАНЬ из каталога не берёт. Применимость проверяют по паспорту.',
  },
  {
    q: 'Какое расстояние от стены до крана выбрать при надстройке?',
    a: 'В расчёте КРАН-КУБАНЬ принято 8 м от стены. При такой стоянке у середины длинной стороны вылет до дальних углов 31,24 м, у торца — 56,32 м. Реальное расстояние определяют по ограждению, проезду и зоне падения груза, поэтому цифры пересчитывают по плану площадки.',
  },
  {
    q: 'Можно ли при надстройке крепить кран к существующему зданию?',
    a: 'Потребности нет: КБ-674А поднимает крюк до 60 м свободно, а нужно 40,5 м. Анкеровка к существующим конструкциям возможна только по расчёту проектировщика здания, и КРАН-КУБАНЬ нагрузок не называет. Если анкеровка всё же понадобится, ставят её в проекте, а не решают на месте.',
  },
  {
    q: 'Какая модель подходит, если кран можно поставить только у торца дома?',
    a: 'В примере у торца вылет до дальнего угла 56,32 м, и достаёт только Potain MDT 219 J10 с вылетом 65 м и запасом 8,68 м. Potain MCH 175 с вылетом 55 м уступает 1,32 м, КБ-674А — 5,82 м. Для остальных моделей требуется стоянка у длинной стены.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Надстройка"
  published={PUBLISHED}
>
    <p slot="intro">Для надстройки четырёх этажей над домом 48 × 12 м, итоговая высота которого 33 м, башенному крану нужен крюк на 40,5 м, а вылет зависит от места стоянки: 31,24 м у середины длинной стены и 56,32 м у торца. Здесь высота важнее вылета. Из пяти моделей парка КРАН-КУБАНЬ у длинной стены проходят четыре, giraFFe SMK-5.66 не хватает 13,5 м высоты, а у торца достаёт только Potain MDT 219 J10.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Для расчёта КРАН-КУБАНЬ взял условный дом: длина 48 м, ширина 12 м, существующая высота 21 м (семь этажей по 3 м). Надстройка добавляет четыре этажа по 3 м, то есть 12 м, и итоговая высота получается 33 м. Размеры выбраны для иллюстрации и не относятся к реальному объекту; метод от них не зависит. В плане здание лежит в координатах x от 0 до 48 и y от 0 до 12.</p>
    <p>Надстройка отличается от новостройки, разобранной в статье <a href="/blog/kran-dlya-zhilogo-doma-iz-treh-sekciy/">«Кран для жилого дома из трёх секций»</a>: дом уже стоит, работы идут на верхних отметках, а нижние этажи часто заселены. Поэтому вопрос не «как достать до дальнего угла», а «как поднять груз на 33 м и не пронести его над чужими окнами». Порядок подачи над действующим зданием записывают в ППР; смежная норма о проёмах — в статье <a href="/blog/podacha-gruza-v-proemy-perekrytiy-bashennym-kranom/">«Подача груза в проёмы перекрытий башенным краном»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Потребная высота крюка равна высоте здания плюс 0,5 м запаса над препятствиями, высота груза и длина строп: 33 + 0,5 + 3 + 4 = 40,5 м. Запас 0,5 м взят из пункта 114 ФНП № 461; груз 3 м и стропы 4 м — допущения КРАН-КУБАНЬ, которые в проекте заменяют по самому высокому элементу, например по блоку лифтовой шахты.</p>
    <p>Высота 40,5 м сразу делит парк на две группы. КБ-408.21 поднимает крюк на 54,0–72,7 м и даёт запас от 13,5 м, КБ-674А — до 60 м свободно (запас 19,5 м), Potain MCH 175 — до 58,5 м (18,0 м), Potain MDT 219 J10 — до 70,4 м (29,9 м). giraFFe SMK-5.66 с горизонтальной стрелой достаёт до 27 м и недобирает 13,5 м. Сравнение высот — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Стоянка S1 расположена снаружи у середины длинной стены на расстоянии 8 м, в точке (24; −8). Дальние углы здания (0; 12) и (48; 12) отстоят на √(24² + 20²) = √976 = 31,24 м; ближние — на √(24² + 8²) = √640 = 25,30 м. Разброс между ближним и дальним углом всего 5,94 м, потому что дом узкий.</p>
    <p>Вылет 31,24 м перекрывают все пять моделей КРАН-КУБАНЬ. Запас у КБ-408.21 составляет +8,76 м, у giraFFe SMK-5.66 — +11,76 м, у КБ-674А — +19,26 м, у Potain MCH 175 — +23,76 м, у Potain MDT 219 J10 — +33,76 м. Выбирать кран по вылету в этой схеме бессмысленно: отсев идёт по высоте. Вылеты по паспортам — в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Стоянка S2 расположена на оси здания у торца в 8 м от стены, в точке (−8; 6). Дальние углы противоположного торца (48; 0) и (48; 12) отстоят на √(56² + 6²) = √3172 = 56,32 м. Схема нужна, когда вдоль длинной стены нет места: проезд, стена соседнего дома, коммуникации.</p>
    <p>Вылет 56,32 м проходит только Potain MDT 219 J10 с вылетом 65 м и запасом 8,68 м. Остальные модели КРАН-КУБАНЬ не достают: Potain MCH 175 уступает 1,32 м, КБ-674А — 5,82 м, giraFFe SMK-5.66 — 13,32 м, КБ-408.21 — 16,32 м. Для MCH 175 это тот редкий случай, когда помогает рельсовый путь вдоль торца: условия основания — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>giraFFe SMK-5.66 с горизонтальной стрелой поднимает крюк до 27 м и до потребных 40,5 м не достаёт. С наклоном стрелы 20° высота крюка составляет 41,7 м, запас 1,2 м. Наклон при этом сокращает вылет, а значение вылета при наклоне в данных каталога КРАН-КУБАНЬ нет, поэтому в расчёт оно не включено.</p>
    <p>Практический вывод: для дома 33 м быстромонтируемый кран остаётся в игре только на границе возможностей, и решение о нём принимают по паспорту, а не по таблице. Для надстройки 2–3 этажей над низким зданием его возможностей хватает с запасом; сравнение двух моделей — в статье <a href="/blog/giraffe-smk-5-66-ili-potain-mch-175/">«giraFFe SMK-5.66 или Potain MCH 175»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>КБ-674А — приставной кран, и вопрос анкеровки к зданию возникает сам собой. Для надстройки до 33 м она не нужна: свободно кран поднимает крюк до 60 м, а нужно 40,5 м. Запас 19,5 м закрывает задачу без нагрузок на существующие конструкции, которые для надстраиваемого дома и без того часто рассчитаны на другие условия.</p>
    <p>Если высота объекта или модель изменятся, нагрузки на фасад и перекрытия считает проектировщик здания, а не поставщик крана; КРАН-КУБАНЬ значения не называет. Метод приставного режима разобран в статье <a href="/blog/svobodnostoyashchiy-ili-pristavnoy-bashennyi-kran/">«Свободностоящий или приставной башенный кран»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Расчёт КРАН-КУБАНЬ плоский: он не учитывает габариты противовеса, ограждение, воздушные линии, зону падения груза и жильцов нижних этажей. Грузоподъёмность на дальнем вылете падает: у Potain MDT 219 J10 она составляет 1,9 т на 65 м против 10 т максимума, у КБ-674А — 5,6 т на 50,5 м против 12,5 т. Поэтому тяжёлые модули надстройки подают ближе к крану.</p>
    <p>Для обитаемого дома добавляются ограничения по шуму и по часам работы: закон № 608-КЗ и нормы обсуждаются в статьях <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине»</a> и <a href="/blog/uroven-shuma-v-decibelah/">«Уровень шума в децибелах»</a>. Основание крана выбирают по изысканиям, а не по аналогии: <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Сводка показывает расчёт КРАН-КУБАНЬ для условного дома 48 × 12 м с итоговой высотой 33 м и потребным крюком 40,5 м. Запас — разность возможности модели и потребности; знак «−» означает, что кран не достаёт.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Крюк, запас к 40,5 м</th><th>Вылет</th><th>Запас: S1 у длинной стены (31,24 м)</th><th>Запас: S2 у торца (56,32 м)</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>+13,5 м (от 54,0 м)</td><td>40 м</td><td>+8,76 м</td><td>−16,32 м</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>−13,5 м (27 м); +1,2 м (41,7 м, наклон 20°)</td><td>43 м</td><td>+11,76 м</td><td>−13,32 м</td></tr>
        <tr><td>КБ-674А</td><td>+19,5 м (до 60 м)</td><td>50,5 м</td><td>+19,26 м</td><td>−5,82 м</td></tr>
        <tr><td>Potain MCH 175</td><td>+18,0 м (до 58,5 м)</td><td>до 55 м</td><td>+23,76 м</td><td>−1,32 м</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>+29,9 м (до 70,4 м)</td><td>65 м</td><td>+33,76 м</td><td>+8,68 м</td></tr>
      </tbody>
    </table></div>
    <p>Вывод таблицы: у высокой надстройки сначала смотрят на высоту крюка, потом на место стоянки. Длинная стена оставляет четыре модели без оговорок, торец — одну. План дома с размерами, высотой надстройки и возможными стоянками можно отправить через <a href="/#order">форму на главной</a>; КРАН-КУБАНЬ назовёт модель и точку. Цены и сроки зависят от площадки и здесь не называются.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: высота крюка, вылет и грузоподъёмность пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, п. 114 (перемещение груза на 0,5 м выше препятствий)' },
      { href: 'https://kran-kuban.ru/blog/vysota-podema-bashennogo-krana-po-modelyam/', label: 'kran-kuban.ru — высота подъёма башенного крана по моделям' },
    ]} />
</BlogArticleLayout>
