---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 121. Сто восьмая статья блога — угол (b) коммерческий / сравнительный.
// Сценарий «склад-ангар»: здание 72 × 36 м (длинная сторона вдоль оси x), высота до конька 12 м — иллюстрация,
// помечена в тексте. Отличие от школы, дома и корпуса: низкое, но очень «глубокое» здание — решает не высота,
// а поперечная глубина 36 м. Потребный крюк: 12 + 0,5 (п. 114 ФНП № 461) + 3 + 4 = 19,5 м.
// Стоянка S1 — снаружи у середины длинной стены, 6 м от стены: (36; −6); здание x ∈ [0; 72], y ∈ [0; 36].
//   Дальние углы (0;36) и (72;36): √(36² + 42²) = √3060 = 55,32 м; ближние (0;0): √(36² + 6²) = √1332 = 36,50 м.
//   Запас: КБ-408.21 (40) −15,32; SMK-5.66 (43) −12,32; КБ-674А (50,5) −4,82; MCH 175 (55) −0,32; MDT 219 J10 (65) +9,68.
//   Покрытие дальней стены (глубина 42 м): полуширина w = √(R² − 42²): R=40 — не достаёт; 43 → √85 = 9,22;
//   50,5 → √786,25 = 28,04; 55 → √1261 = 35,51; 65 → √2461 = 49,61. Нужно ±36 до каждого угла.
//   MCH 175 на пути: в точке x = 35,51 покрывает дальнюю стену [0; 71,02], в точке x = 36,49 — [0,98; 72,00]; ход ≈ 1 м.
// Стоянка S2 — внутри контура, в центре (36; 18), до кровли: √(36² + 18²) = √1620 = 40,25 м.
//   Запас: КБ-408.21 −0,25; SMK-5.66 +2,75; КБ-674А +10,25; MCH 175 +14,75; MDT 219 J10 +24,75.
// Высота: SMK-5.66 до 27 м → запас 7,5 м к 19,5 м.
// Фактура — только parkModels.ts: вылеты 40 / 43 / 50,5 / до 55 / 65 м; крюк КБ-408.21 54,0–72,7 м, SMK-5.66 до 27 м (гориз.)
// и 41,7 м (наклон 20°), КБ-674А до 60 м свободно, MCH 175 до 58,5 м, MDT 219 J10 до 70,4 м; опорный контур SMK 4 × 4 м.
// НЕ названо: цены, сроки, массы элементов каркаса, нормы по пожарной безопасности, требования к демонтажу как норма.

const CHECKED = '27 октября 2026 года';
const PUBLISHED = '2026-10-27';

const title = 'Кран для склада-ангара 72 × 36 м: снаружи или внутри контура';
const description = 'Ангар 72 × 36 м, высота 12 м: снаружи нужен вылет 55,32 м, внутри контура — 40,25 м. Расчёт КРАН-КУБАНЬ по пяти моделям и двум стоянкам.';
const h1 = 'Где ставить башенный кран у склада-ангара: снаружи у стены или внутри контура';
const crumbTitle = 'Кран для склада-ангара';
const slug = 'kran-dlya-sklada-angara';

const H2 = [
  'Исходные данные примера: ангар 72 × 36 м и высота 12 м',
  'Потребная высота крюка 19,5 м: здесь она не решает',
  'Стоянка S1 снаружи: вылет 55,32 м до дальнего угла',
  'Полуширина покрытия дальней стены по моделям',
  'Стоянка S2 внутри контура: вылет 40,25 м',
  'Рельсовый путь вдоль ангара: метр хода решает вопрос для Potain MCH 175',
  'Что остаётся за пределами расчёта',
  'Сводка: модель, запас на двух стоянках и вывод',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой вылет нужен крану для склада-ангара 72 × 36 м?',
    a: 'Если кран стоит снаружи у середины длинной стены на расстоянии 6 м, до дальних углов нужен вылет 55,32 м. Если поставить его внутри контура в центре, достаточно 40,25 м. Расчёт КРАН-КУБАНЬ плоский, размеры ангара условные; для своего объекта расстояния пересчитывают по плану.',
  },
  {
    q: 'Почему для низкого ангара нужен длинный вылет?',
    a: 'Потому что решает не высота, а глубина здания: 36 м плюс 6 м зазора до стены дают 42 м до дальней стены. Кран с вылетом 40 м, такой как КБ-408.21, до неё не достаёт, а giraFFe SMK-5.66 с вылетом 43 м покрывает лишь участок 18,4 м.',
  },
  {
    q: 'Можно ли поставить башенный кран внутри строящегося ангара?',
    a: 'Геометрически можно: в центре контура вылет до дальнего угла составляет 40,25 м. Ограничение другое — порядок работ: кровлю и стены закрывают после демонтажа или оставляют проём для автокрана. КРАН-КУБАНЬ советует согласовать это в ППР до начала монтажа, это практика, а не норма.',
  },
  {
    q: 'Хватит ли Potain MCH 175 для ангара 72 × 36 м снаружи?',
    a: 'С места в центре стены не хватает 0,32 м: вылет модели 55 м, нужно 55,32 м. На рельсовом пути проблема решается ходом около 1 м: в двух крайних точках стрела дотягивается до обоих дальних углов. Без пути или при фундаменте потребуется другая модель, например Potain MDT 219 J10.',
  },
  {
    q: 'Какая модель подходит под ангар, если стоять можно только снаружи?',
    a: 'В примере КРАН-КУБАНЬ с одной точки снаружи проходит только Potain MDT 219 J10: вылет 65 м, запас 9,68 м. КБ-674А с вылетом 50,5 м покрывает дальнюю стену на ±28,04 м из нужных ±36 м. Для остальных моделей требуется внутренняя стоянка или переезд крана вдоль стены.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Склад-ангар"
  published={PUBLISHED}
>
    <p slot="intro">Для склада-ангара 72 × 36 м высотой 12 м башенному крану нужен вылет 55,32 м, если он стоит снаружи у середины длинной стены, и 40,25 м, если его поставить внутри контура до кровли. Высота здесь не мешает: решает глубина 36 м. Снаружи с одной точки проходит только Potain MDT 219 J10, изнутри — четыре из пяти моделей парка КРАН-КУБАНЬ.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Для расчёта КРАН-КУБАНЬ взял условный склад-ангар: длина 72 м, ширина 36 м, высота до конька 12 м. Размеры выбраны для иллюстрации и не относятся к реальному объекту; метод от них не зависит. В плане здание лежит в координатах x от 0 до 72 и y от 0 до 36, кран ставится либо снаружи, либо внутри.</p>
    <p>Ангар отличается от домов, разобранных в статьях <a href="/blog/kran-dlya-zhilogo-doma-iz-treh-sekciy/">«Кран для жилого дома из трёх секций»</a> и <a href="/blog/kran-dlya-shkoly-g-obraznoj-formy/">«Кран для школы Г-образной формы»</a>, пропорциями: он низкий и очень широкий. Для высотного здания определяющей становится высота крюка; для ангара — расстояние до самой дальней точки плана. Это тот случай, где модель выбирают по вылету, а не по высоте.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Потребная высота крюка равна высоте здания плюс 0,5 м запаса над препятствиями, высота груза и длина строп: 12 + 0,5 + 3 + 4 = 19,5 м. Запас 0,5 м берут из пункта 114 ФНП № 461; груз 3 м и стропы 4 м — допущения КРАН-КУБАНЬ, которые в проекте заменяют по самому высокому элементу, например по ферме.</p>
    <p>Высота 19,5 м не отсекает ни одну модель. giraFFe SMK-5.66 поднимает крюк до 27 м даже с горизонтальной стрелой, запас 7,5 м. Остальные модели парка превосходят потребную высоту многократно: КБ-408.21 — от 54,0 м, Potain MCH 175 — до 58,5 м, КБ-674А — до 60 м свободно, Potain MDT 219 J10 — до 70,4 м. Сравнение высот — в статье <a href="/blog/vysota-podema-bashennogo-krana-po-modelyam/">«Высота подъёма башенного крана по моделям»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Стоянка S1 расположена снаружи у середины длинной стены на расстоянии 6 м, в точке с координатами (36; −6). Самые дальние точки здания — два угла противоположной стены, (0; 36) и (72; 36): √(36² + 42²) = √3060 = 55,32 м. До ближних углов расстояние составляет всего √(36² + 6²) = √1332 = 36,50 м, то есть перепад между ближним и дальним углом достигает 18,8 м.</p>
    <p>Вылет 55,32 м перекрывает только Potain MDT 219 J10 с вылетом 65 м и запасом 9,68 м. Остальные модели КРАН-КУБАНЬ не достают: Potain MCH 175 уступает 0,32 м, КБ-674А — 4,82 м, giraFFe SMK-5.66 — 12,32 м, КБ-408.21 — 15,32 м. Вылеты по паспортам — в статье <a href="/blog/vylet-bashennogo-krana-po-modelyam/">«Вылет башенного крана по моделям»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Дальняя стена ангара находится на расстоянии 36 + 6 = 42 м от оси крана, и каждая модель покрывает на ней отрезок полушириной √(R² − 42²). Расчёт КРАН-КУБАНЬ показывает разброс: у КБ-408.21 с вылетом 40 м стена вообще недосягаема, у giraFFe SMK-5.66 покрытие ±9,22 м, у КБ-674А ±28,04 м, у Potain MCH 175 ±35,51 м, у Potain MDT 219 J10 ±49,61 м.</p>
    <p>Для полного покрытия 72-метровой стены нужно ±36 м от середины. Только MDT 219 J10 выполняет условие с запасом 13,61 м; MCH 175 не добирает 0,49 м. На практике это значит, что склад подходящей длины можно разбить на зоны и обслуживать дальнюю стену частично, но тогда фермы и панели на непокрытых участках подаёт другая техника.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Стоянка S2 расположена внутри контура будущего здания, в центре плана (36; 18). До любого угла отсюда √(36² + 18²) = √1620 = 40,25 м, то есть вылет, нужный для всего ангара, на 15,07 м меньше, чем при стоянке снаружи. Внутренняя точка возвращает в игру короткие модели.</p>
    <p>Запасы у моделей КРАН-КУБАНЬ из центра таковы: giraFFe SMK-5.66 +2,75 м, КБ-674А +10,25 м, Potain MCH 175 +14,75 м, Potain MDT 219 J10 +24,75 м. Только у КБ-408.21 с вылетом 40 м не хватает 0,25 м. Внутри контура кран стоит на фундаменте или опорном контуре 4 × 4 м у giraFFe SMK-5.66, а рельсовый путь укладывают по оси ангара, если модели нужен ход.</p>
    <p>Оборотная сторона — порядок работ. Кран внутри мешает закрыть кровлю и возвести часть конструкций, поэтому его демонтируют до завершения этих этапов или оставляют технологический проём для автокрана. КРАН-КУБАНЬ рекомендует решить это в ППР до выбора модели; это практика инженерной службы, а не норма. Порядок демонтажа — в статье <a href="/blog/demontazh-bashennogo-krana/">«Демонтаж башенного крана»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Potain MCH 175 с вылетом до 55 м не добирает до дальнего угла 0,32 м, если стоит в середине стены. На рельсовом пути это исправляется ходом: в точке x = 35,51 стрела покрывает дальнюю стену от 0 до 71,02 м, в точке x = 36,49 — от 0,98 до 72,00 м. Две крайние точки отстоят друг от друга на 0,98 м, то есть кран перемещается на метр.</p>
    <p>Рельсовый путь вдоль ангара полезен и для других моделей: чем длиннее ход, тем больше участков дальней стены попадает в радиус. Условия основания КБ-408.21 и MCH 175 — рельсовый путь или монолитный фундамент — разобраны в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Путь обследуют и проверяют по отдельным нормам ФНП — они вынесены в статью о <a href="/blog/kompleksnoe-obsledovanie-relsovogo-puti-bashennogo-krana/">комплексном обследовании пути</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Расчёт КРАН-КУБАНЬ плоский: он не учитывает габариты противовеса, ограждение, воздушные линии, проезд тралов и склад материалов. Для ангара, который строят из лёгких стальных конструкций, добавляется ещё один фактор — масса и габарит ферм. Грузоподъёмность на дальнем вылете падает: у MDT 219 J10 это 1,9 т на 65 м против 10 т максимума, у КБ-674А — 5,6 т на 50,5 м против 12,5 т.</p>
    <p>Поэтому тяжёлые элементы каркаса раскладывают ближе к крану, а лёгкие панели и прогоны подают на дальний вылет. Расчёт по моделям — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>. Площадку перед монтажом изучают изысканиями, и без них основание не выбирают: <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Сводка показывает расчёт КРАН-КУБАНЬ для условного ангара 72 × 36 м с потребным крюком 19,5 м. Запас по вылету — разность вылета модели и наибольшего расстояния до здания; знак «−» означает, что кран не достаёт.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Модель</th><th>Вылет</th><th>Запас: снаружи S1 (55,32 м)</th><th>Запас: внутри S2 (40,25 м)</th><th>Покрытие дальней стены с S1</th></tr></thead>
      <tbody>
        <tr><td>КБ-408.21</td><td>40 м</td><td>−15,32 м</td><td>−0,25 м</td><td>не достаёт</td></tr>
        <tr><td>giraFFe SMK-5.66</td><td>43 м</td><td>−12,32 м</td><td>+2,75 м</td><td>±9,22 м</td></tr>
        <tr><td>КБ-674А</td><td>50,5 м</td><td>−4,82 м</td><td>+10,25 м</td><td>±28,04 м</td></tr>
        <tr><td>Potain MCH 175</td><td>до 55 м</td><td>−0,32 м</td><td>+14,75 м</td><td>±35,51 м</td></tr>
        <tr><td>Potain MDT 219 J10</td><td>65 м</td><td>+9,68 м</td><td>+24,75 м</td><td>±49,61 м</td></tr>
      </tbody>
    </table></div>
    <p>Вывод таблицы: для широкого низкого здания стоянку выбирают раньше модели. Внутри контура подходят четыре модели из пяти, снаружи с одной точки — один кран. Цены и сроки зависят от площадки и здесь не называются. План ангара с размерами и возможными стоянками можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ назовёт модель и точку стоянки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: высота крюка, вылет и грузоподъёмность пяти моделей' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, п. 114 (перемещение груза на 0,5 м выше препятствий)' },
      { href: 'https://kran-kuban.ru/blog/vylet-bashennogo-krana-po-modelyam/', label: 'kran-kuban.ru — вылет башенного крана по моделям' },
    ]} />
</BlogArticleLayout>
