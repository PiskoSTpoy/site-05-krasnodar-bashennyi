---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 96. Тридцать четвёртая статья блога — угол (c) практический/
// региональный. Первый разбор северной Приазовской равнины края, где
// стройка — в основном агропромышленная и малоэтажная. Честный угол:
// башенный кран здесь нужен не везде, и статья объясняет, где да, где нет.
//
// Фактура (WebSearch/WebFetch 25.09.2026):
// - ru.wikipedia.org «Каневская»: 41 721 житель (2021), крупнейший
//   населённый пункт сельского типа в России; 128 км к северу от
//   Краснодара, Кубано-Приазовская низменность, р. Челбас; основана в 1794;
//   ж/д станция на линии Тимашевск — Старominская; через станицу проходит
//   трасса Краснодар — Ейск.
// - utyug.info 29.05.2026: в посёлке Челбас Каневского района построена
//   молочная ферма на 2000 голов, инвестиции 3,5 млрд руб., соглашение —
//   ПМЭФ-2023; к 2027 году «Агрохлебопродукт» планирует ещё две фермы
//   суммарно на 4000 голов.
// - kanevskadm.ru 27.10.2020: Каневской сахарный завод за сезон 2020
//   переработал 483 тыс. т сырья, произвёл 64 тыс. т сахара — дата даётся
//   явно, свежих данных за 2025–2026 не нашли.
// - spark-interfax / rusprofile: АО «Каневсксахар», ИНН 2334005403,
//   юрадрес — станица Стародеревянковская.
// Сейсмика: балл для Каневской в надёжном первоисточнике не найден —
// по конвенции сайта (Волны 79+) не называем.
// Закон №608-КЗ — окна из опубликованных страниц сайта (kommersant.ru).

const CHECKED = '25 сентября 2026 года';
const PUBLISHED = '2026-09-25';

const title = 'Кран для Каневского района: фермы, завод, станица';
const description = 'Каневской район: крупнейшая станица России, молочные фермы и сахарный завод. Когда нужен башенный кран, а когда хватит автокрана.';
const h1 = 'Кран для Каневского района: когда на равнине нужен башенный кран';
const crumbTitle = 'Кран для Каневского района';
const slug = 'kran-dlya-kanevskogo-rayona';

const H2 = [
  'Каневская: крупнейшая станица России в 128 км от Краснодара',
  'Что строят в Каневском районе в 2026 году',
  'Молочная ферма: башенный кран или автокран',
  'Сахарный завод и промплощадки: где нужен башенный кран',
  'Многоэтажка в станице: закон о тишине и соседи',
  'Сейсмика и грунт: почему балл площадки не назван',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const cases = [
  { obj: 'Молочная ферма, коровник', height: 'Невысокий, протяжённый', crane: 'Автокран или быстромонтируемый giraFFe SMK-5.66 — по ширине пролёта и сроку' },
  { obj: 'Цех или склад на промплощадке', height: 'Средняя, длительный монтаж', crane: 'Башенный кран, если монтаж идёт месяцами и объект растёт этапами' },
  { obj: 'Многоквартирный дом в станице', height: 'Несколько этажей', crane: 'Башенный кран: КБ-408.21 на пути или Potain MDT 219 J10 на фундаменте' },
  { obj: 'Частный дом', height: 'Один-два этажа', crane: 'Башенный кран не нужен' },
];

const faqs = [
  {
    q: 'Нужен ли башенный кран для строительства фермы в Каневском районе?',
    a: 'Чаще нет: коровники и склады — невысокие протяжённые здания, и для них обычно хватает автокрана. Башенный кран, например быстромонтируемый giraFFe SMK-5.66 с вылетом до 43 метров, имеет смысл, когда монтаж идёт неделями, а площадь застройки большая. Решение принимают по проекту производства работ, а не по привычке подрядчика.',
  },
  {
    q: 'Какая сейсмичность в станице Каневской?',
    a: 'Надёжного первоисточника с баллом для Каневской мы не нашли, поэтому число не называем. Расчётный балл площадки берут из СП 14.13330.2018 и краевых ТСН 22-302-2000 с учётом уровня ответственности объекта и грунта; при необходимости делают сейсмическое микрорайонирование. Инженерная служба КРАН-КУБАНЬ считает основание крана от балла, указанного в проекте.',
  },
  {
    q: 'Действует ли закон о тишине в станицах?',
    a: 'Да, закон Краснодарского края №608-КЗ действует по всему краю, включая станицы. Шумные строительные работы разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для крана КРАН-КУБАНЬ рядом с жилыми домами Каневской это 13 рабочих часов в будни и 11 в выходные.',
  },
  {
    q: 'Сколько стоит доставка башенного крана в Каневскую?',
    a: 'Фиксированной цифры нет: перебазировка считается по модели крана, числу рейсов и срокам. Каневская лежит в 128 километрах к северу от Краснодара по трассе на Ейск, и эта дистанция входит в строку перебазировки сметы. Как читать эту строку, разобрано в статье КРАН-КУБАНЬ «Смета аренды башенного крана».',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Районы Кубани"
  published={PUBLISHED}
>
    <p slot="intro">Каневской район — равнинный север Краснодарского края, где стройка в основном агропромышленная: в мае 2026 года в посёлке Челбас открылась молочная ферма на 2000 голов стоимостью 3,5 млрд рублей, и к 2027 году здесь планируют ещё две. Башенный кран КРАН-КУБАНЬ в Каневском районе нужен не на каждом объекте. Он оправдан на многоэтажке в станице, на промплощадке с долгим монтажом и на большом по площади объекте, а для невысокого коровника чаще хватает автокрана.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Станица Каневская — крупнейший населённый пункт сельского типа в России: 41 721 житель по данным 2021 года. Каневская основана в 1794 году среди первых сорока черноморских куренных селений и стоит на реке Челбас в Кубано-Приазовской низменности, в 128 километрах к северу от Краснодара. Через станицу проходят трасса Краснодар — Ейск и железная дорога на линии Тимашевск — Староминская.</p>
    <p>Для аренды башенного крана эти цифры значат две вещи. Каневская — это уже не село с одноэтажной застройкой, а город по размеру, где строят и многоквартирные дома, и социальные объекты. А 128 километров от Краснодара — это полноценная строка перебазировки в смете крана КРАН-КУБАНЬ, которую нужно считать с самого начала.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Главный инвестиционный сюжет Каневского района 2026 года — молочное животноводство. В посёлке Челбас построена ферма на 2000 голов, инвестиции — 3,5 млрд рублей; соглашение по проекту подписано на ПМЭФ-2023. Компания «Агрохлебопродукт» к 2027 году планирует запустить в районе ещё две молочно-товарные фермы суммарно на 4000 голов.</p>
    <p>Вторая опора экономики района — сахарная свёкла. АО «Каневсксахар» (ИНН 2334005403, юридический адрес — станица Стародеревянковская) перерабатывает свёклу в сахар, патоку и жом. По данным администрации района, в сезоне 2020 года Каневской сахарный завод переработал 483 тысячи тонн сырья и произвёл 64 тысячи тонн сахара; более свежих публичных цифр мы не нашли.</p>

    <div class="rule-table-wrap" style="margin-bottom:24px">
      <table class="rule-table">
        <caption style="text-align:left;margin-bottom:8px">Какой кран под какой объект Каневского района</caption>
        <thead>
          <tr><th scope="col">Объект</th><th scope="col">Высота и срок</th><th scope="col">Кран</th></tr>
        </thead>
        <tbody>
          {cases.map((c) => (
            <tr><td>{c.obj}</td><td>{c.height}</td><td>{c.crane}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Молочная ферма на 2000 голов — невысокое, но протяжённое здание, и для большинства таких объектов автокран экономичнее башенного крана. Автокран приезжает на смену и уезжает, а башенному крану нужны основание, монтаж и демонтаж. Башенный кран КРАН-КУБАНЬ на ферме оправдан, когда монтаж каркаса и покрытия идёт неделями и автокран пришлось бы вызывать почти каждый день.</p>
    <p>Для такой площадки в парке КРАН-КУБАНЬ подходит быстромонтируемый giraFFe SMK-5.66: он встаёт за 4–6 часов без фундамента и рельсового пути, а вылет стрелы до 43 метров перекрывает широкий пролёт с одной стоянки. Высоты подъёма до 27 метров при горизонтальной стреле хватает для одноэтажного сельскохозяйственного здания с запасом. Подробности — на странице <a href="/park/giraffe-smk-5-66/">giraFFe SMK-5.66</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Промышленная площадка вроде АО «Каневсксахар», элеватора или склада нуждается в башенном кране, когда объект растёт этапами и монтаж длится месяцами. Реконструкция цеха действующего предприятия добавляет ограничение: кран работает рядом с оборудованием, которое не останавливают. Рельсовый КБ-408.21 с вылетом 40 метров и координатной защитой прибора безопасности позволяет задать запретные зоны над действующими цехами.</p>
    <p>Если площадка стеснённая и места под рельсовый путь нет, основание КРАН-КУБАНЬ выбирает иначе: Potain MDT 219 J10 на монолитном фундаменте. Как выбирают основание и что проверяют до его устройства, разобрано на этапах <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a> и <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Многоквартирный дом в станице Каневской — объект, где башенный кран нужен без оговорок, и здесь сразу включается закон Краснодарского края №608-КЗ. Шумные работы рядом с жилыми домами разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные и праздники — с 10:00. Башенный кран КРАН-КУБАНЬ на такой площадке работает 13 часов в будни и 11 в выходные, и срок аренды считают от этих часов.</p>
    <p>Станичная застройка Каневской добавляет крану КРАН-КУБАНЬ свою особенность: частные дома с дворами стоят вплотную к участку стройки. Стрела башенного крана проходит над соседними участками, поэтому зону работы ограничивают прибором безопасности, а схему согласуют в проекте производства работ. Подробный разбор окон работы — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Балл сейсмичности для станицы Каневской КРАН-КУБАНЬ сознательно не называет: надёжного первоисточника с числом для этой точки в открытом доступе мы не нашли. Расчётную сейсмичность площадки определяют по СП 14.13330.2018 и краевым ТСН 22-302-2000 с учётом уровня ответственности объекта и грунта. Равнинная часть края лежит в нижней части краевого диапазона 7–9 баллов, но балл конкретной площадки берут из проекта, а не из общей карты.</p>
    <p>Для КРАН-КУБАНЬ Кубано-Приазовская низменность и река Челбас — повод внимательно отнестись к изысканиям под основание крана. Несущую способность грунта считает проектировщик по данным изысканий на конкретном участке. Откуда берётся балл и когда нужна карта сейсмического микрорайонирования, разобрано в разделе <a href="/seysmozony/">«Сейсмозоны»</a> и в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование площадки»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <ul>
      <li>Каневская — крупнейшая станица России (41 721 житель), 128 км к северу от Краснодара; расстояние — отдельная строка перебазировки.</li>
      <li>Стройка района в 2026 году — молочные фермы: 2000 голов в Челбасе, ещё 4000 голов к 2027 году.</li>
      <li>Для невысокой фермы чаще хватает автокрана; при долгом монтаже — быстромонтируемый giraFFe SMK-5.66.</li>
      <li>Промплощадки и многоэтажки — задача башенного крана: КБ-408.21 на пути или Potain MDT 219 J10 на фундаменте.</li>
      <li>Закон №608-КЗ действует и в станицах: 13 рабочих часов в будни и 11 в выходные.</li>
      <li>Балл сейсмичности площадки берут из проекта, грунт — из изысканий.</li>
    </ul>
    <p>Объект в Каневском районе и сроки можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ подскажет, нужен ли здесь башенный кран и какой.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9A%D0%B0%D0%BD%D0%B5%D0%B2%D1%81%D0%BA%D0%B0%D1%8F', label: 'ru.wikipedia.org — станица Каневская: население, география, история' },
      { href: 'https://utyug.info/new/v-kanevskom-rayone-kubani-ao-rodina-postroilo-fermu-dlya-dvukh-tysyach-korov-74404/', label: 'utyug.info, 29.05.2026 — ферма на 2000 коров в Каневском районе' },
      { href: 'https://kanevskadm.ru/news/kanevskoy-sakharnyy-zavod-za-sezon-pererabotal-svyshe-480-tysyach-tonn-syrya/', label: 'kanevskadm.ru, 27.10.2020 — итоги сезона Каневского сахарного завода' },
      { href: 'https://www.rusprofile.ru/id/1420947', label: 'rusprofile.ru — АО «Каневсксахар», ИНН 2334005403' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
