---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 120. Сто четвёртая статья блога — угол (a) информационный / how-to.
// Тема: периодическое комплексное обследование рельсового пути башенного крана (ФНП № 461, пп. 203–205, 212–214).
// Источник: текст приказа Ростехнадзора от 26.11.2020 № 461 на legalacts.ru (curl, проверено 26.10.2026).
// Факты: п. 203 — готовность пути подтверждает акт сдачи-приёмки с результатами планово-высотной съёмки;
// допуски — приложение № 5, нормы браковки рельсов и шпал — приложение № 3 (значения НЕ приводятся);
// п. 204 — на каждом пути выделен участок стоянки в нерабочем состоянии; п. 205 — проверка, комплексное
// обследование, ТО, ремонт; пп. 206–210 — лестница осмотров (смена / 24 смены / ежегодно); п. 211 — внеочередная
// после ливней и оттепелей (отдельная статья, здесь одна ссылка); п. 212 — обследование делают специализированные
// организации, 4 вида работ, включая измерение сопротивления заземления и ведомость дефектов; п. 213 — акт;
// п. 214 — не реже одного раза в три года и после подтоплений, наводнений, землетрясений, селей.
// Расчёт-иллюстрация КРАН-КУБАНЬ: 250 смен в год → 250 / 24 = 10,4 → 10 осмотров по 24 смены за год,
// за 3 года 750 смен → 31 осмотр (750 / 24 = 31,25), плюс 3 плановые проверки и 1 комплексное обследование.
// Модели с рельсовым основанием — только из parkModels.ts (КБ-408.21 — наземный рельсовый путь;
// Potain MDT 219 J10 и MCH 175 — рельсовый путь или фундамент).
// НЕ названо: допуски приложения № 5, цены обследования, названия организаций, фактические сроки.

const CHECKED = '26 октября 2026 года';
const PUBLISHED = '2026-10-26';

const title = 'Комплексное обследование рельсового пути крана: раз в 3 года';
const description = 'КРАН-КУБАНЬ о ФНП № 461: комплексное обследование рельсового пути крана не реже раза в три года и после наводнений, землетрясений, селей. Кто делает.';
const h1 = 'Как часто проводят комплексное обследование рельсового пути башенного крана?';
const crumbTitle = 'Комплексное обследование рельсового пути';
const slug = 'kompleksnoe-obsledovanie-relsovogo-puti-bashennogo-krana';

const H2 = [
  'Три года и четыре события: когда обследование обязательно',
  'Кто проводит комплексное обследование пути',
  'Четыре вида работ по пункту 212 ФНП',
  'Чем обследование отличается от плановой проверки',
  'Лестница проверок пути: от смены до трёх лет',
  'Сколько осмотров набегает за три года: пример на 250 смен',
  'Акт, ведомость дефектов и что с ними делают',
  'Что подготовить заказчику перед обследованием',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Как часто нужно обследовать рельсовый путь башенного крана?',
    a: 'Комплексное обследование наземных и надземных рельсовых путей проводят не реже одного раза в три года (пункт 214 ФНП № 461). Дополнительно его делают после подтоплений, наводнений, землетрясений и селей на территории, где стоит кран. Плановая проверка пути, в отличие от обследования, нужна ежегодно.',
  },
  {
    q: 'Кто имеет право проводить комплексное обследование рельсового пути?',
    a: 'Пункт 212 ФНП № 461 поручает обследование специализированным организациям. Крановщик и инженерно-технический работник эксплуатирующей организации выполняют только ежесменный осмотр, осмотр после каждых 24 смен и плановую проверку. Название и допуск организации заказчику лучше запросить до подписания договора.',
  },
  {
    q: 'Что входит в комплексное обследование рельсового пути?',
    a: 'Пункт 212 перечисляет четыре вида работ: проверка службы эксплуатации опасного объекта, проверка проектной и эксплуатационной документации, поэлементное обследование пути с оценкой фактического состояния и подготовка результатов с инструментальными замерами, включая сопротивление заземления, и ведомостью дефектов.',
  },
  {
    q: 'Чем комплексное обследование отличается от плановой проверки пути?',
    a: 'Плановую проверку раз в 12 месяцев делают работники эксплуатирующей организации под руководством ответственного инженера, и она подтверждает соответствие пути проекту (пункт 209). Комплексное обследование раз в три года делает специализированная организация с замерами и актом (пункты 212–214).',
  },
  {
    q: 'Нужно ли обследовать путь после сильного ливня?',
    a: 'После ливней и зимних оттепелей наземный путь проверяют внеочередно в объёме плановой проверки (пункт 211). Комплексное обследование по пункту 214 обязательно после подтоплений и наводнений. Обычный ливень без подтопления путь размывает не всегда, поэтому границу определяет ответственный инженер по осмотру.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Рельсовый путь"
  published={PUBLISHED}
>
    <p slot="intro">Комплексное обследование рельсового пути башенного крана проводят не реже одного раза в три года, а также после подтоплений, наводнений, землетрясений и селей — так сказано в пункте 214 ФНП № 461. Работу выполняет специализированная организация, а не бригада заказчика. Для кранов КРАН-КУБАНЬ на рельсах, КБ-408.21, Potain MDT 219 J10 и Potain MCH 175, это отдельная строка графика, не заменяемая ни ежесменным осмотром, ни годовой проверкой.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 214 ФНП № 461 задаёт два независимых условия: срок и событие. Срок — не реже одного раза в три года для наземных и надземных путей. Событие — любое подтопление, наводнение, землетрясение или сель на территории, где находится кран. Сработало одно условие — обследование нужно, второе ждать не требуется. Для краёв с активной сейсмичностью вторая часть пункта не формальность: Краснодарский край отнесён к зонам 8–9 баллов по ТСН 22-302-2000, и КРАН-КУБАНЬ закладывает возможное внеочередное обследование в график аренды.</p>
    <p>Слово «не реже» делает три года верхней границей, а не рекомендуемым сроком. Эксплуатирующая организация вправе обследовать путь чаще, если по осмотрам видно движение основания. Три года считаются по пути, а не по крану, и КРАН-КУБАНЬ ведёт отсчёт от акта приёмки. После перебазировки на новую площадку путь строят заново, и первой проверкой становится приёмка по пункту 203 с актом и результатами планово-высотной съёмки.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Пункт 212 ФНП № 461 называет исполнителя прямо: специализированные организации. Крановщик, оператор и инженерно-технический работник эксплуатирующей организации в этом перечне не стоят. Они выполняют другие ступени проверки, которые КРАН-КУБАНЬ включает в обслуживание площадки — ежесменный осмотр, осмотр после каждых 24 смен и плановую проверку раз в год, о которых речь ниже.</p>
    <p>На практике КРАН-КУБАНЬ советует заказчику запросить у исполнителя три документа ещё до выезда: выписку о праве проводить такие работы, перечень приборов с действующей поверкой и образец акта. Это рекомендация инженерной службы, а не норма ФНП. Она экономит неделю: без поверенного прибора измерения сопротивления заземления акт придётся переделывать.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пункт 212 ФНП № 461 раскладывает обследование на четыре обязательных вида работ. Первый — проверка того, что у опасного объекта есть служба эксплуатации, отвечающая за состояние рельсовых путей. Второй — проверка проектной и эксплуатационной документации пути. Третий — поэлементное обследование с оценкой фактического состояния. Четвёртый — подготовка результатов: инструментальные замеры, в том числе измерение сопротивления заземления, и составление ведомости дефектов.</p>
    <p>Третий вид работ для КБ-408.21 с наземным рельсовым путём в парке КРАН-КУБАНЬ означает осмотр каждого рельса, шпалы, стыка и подушки балласта. Норм браковки рельсов и шпал в тексте пункта нет: они вынесены в приложение № 3 к ФНП, а допуски отклонения от проекта — в приложение № 5. Значения из приложений КРАН-КУБАНЬ здесь не приводит, чтобы не исказить таблицы, и отсылает к официальному тексту. О том, как заземление рельсов измеряют отдельно, — в статье <a href="/blog/zazemlenie-i-molniezashchita-bashennogo-krana/">«Заземление и молниезащита башенного крана»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Плановая проверка и комплексное обследование нередко путают, хотя ФНП № 461 разводит их по исполнителю и результату. Плановую проверку раз в 12 месяцев проводят работники эксплуатирующей организации под руководством инженера, ответственного за производственный контроль, и её итог — подтверждение соответствия пути проекту (пункт 209). Комплексное обследование выполняет сторонний специалист, а его итог — акт с замерами и ведомостью дефектов (пункты 212–213).</p>
    <p>Для арендатора КРАН-КУБАНЬ разница выражается просто: годовую проверку включают в обслуживание площадки, а комплексное обследование чаще всего приходится на срок, когда кран стоит на одном объекте три года и дольше. Крупная застройка с длинным циклом, как у многосекционного жилого дома из статьи <a href="/blog/kran-dlya-zhilogo-doma-iz-treh-sekciy/">«Кран для жилого дома из трёх секций»</a>, подходит под него без остатка.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Сводка по пунктам 206–214 ФНП № 461 показывает, что рельсовый путь проверяют на пяти уровнях, и каждый уровень закреплён за своим исполнителем. Таблица собрана КРАН-КУБАНЬ из текста приказа на 26 октября 2026 года; рекомендательных ступеней в ней нет.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Проверка</th><th>Периодичность</th><th>Кто проводит</th><th>Основание</th></tr></thead>
      <tbody>
        <tr><td>Ежесменный осмотр</td><td>каждую смену</td><td>крановщик (оператор)</td><td>пп. 206–207</td></tr>
        <tr><td>Осмотр после 24 смен</td><td>каждые 24 смены</td><td>крановщик под руководством ИТР</td><td>п. 208</td></tr>
        <tr><td>Плановая проверка</td><td>не реже 1 раза в 12 месяцев</td><td>работники эксплуатирующей организации под руководством ИТР</td><td>п. 209</td></tr>
        <tr><td>Внеочередная проверка</td><td>после ливней и зимних оттепелей</td><td>в объёме плановой, под руководством ИТР</td><td>п. 211</td></tr>
        <tr><td>Комплексное обследование</td><td>не реже 1 раза в 3 года и после подтоплений, землетрясений, селей</td><td>специализированная организация</td><td>пп. 212–214</td></tr>
      </tbody>
    </table></div>
    <p>Верхняя ступень не заменяет нижние, и КРАН-КУБАНЬ не снимает осмотры при свежем акте: наличие свежего акта обследования не отменяет ежесменный осмотр крановщика. Содержание ежесменного осмотра — в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Ежесменный осмотр башенного крана»</a>, внеочередной проверки — в статье <a href="/blog/vneocherednaya-proverka-relsovogo-puti-posle-livnya/">«Внеочередная проверка рельсового пути после ливня»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Расчёт КРАН-КУБАНЬ показывает, сколько проверок приходится на путь за один трёхлетний цикл. Допущение для иллюстрации: кран работает 250 смен в год, то есть одну смену в будни. Осмотр после каждых 24 смен тогда выпадает 10 раз в год (250 / 24 = 10,4), за три года — 31 раз (750 / 24 = 31,25). К ним добавляются три плановые проверки по одной в год и одно комплексное обследование.</p>
    <p>Итого за цикл — 35 проверок пути у одного крана КРАН-КУБАНЬ, от осмотров крановщика до обследования специалистами. Допущение 250 смен условное; при двух сменах в сутки Potain MDT 219 J10 на длинной стройке набирает вдвое больше осмотров, а число плановых проверок и обследований остаётся тем же. Отсюда видно, где заказчик может сэкономить усилия: не на частоте, а на полноте записей в паспорте пути.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Результат обследования для крана КРАН-КУБАНЬ оформляют актом: это требование пункта 213 ФНП № 461. Внутри акта находятся инструментальные замеры и ведомость дефектов, а в паспорт пути вносят результаты осмотров после каждых 24 смен (пункт 210). Акты плановых и внеочередных проверок хранят вместе с паспортами подъёмных сооружений.</p>
    <p>Ведомость дефектов для КРАН-КУБАНЬ — рабочий документ для ремонта, а не архив. Каждая строка получает исполнителя и срок, а закрытие дефекта подтверждается повторным замером. Готовность пути после ремонта или реконструкции, как напоминает пункт 203, снова оформляют актом сдачи-приёмки с планово-высотной съёмкой. Ремонт самого крана регулируют другие пункты, разобранные в статье <a href="/blog/remont-bashennogo-krana-po-fnp/">«Ремонт башенного крана по ФНП»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Подготовка к обследованию занимает у заказчика несколько действий, и КРАН-КУБАНЬ напоминает их арендатору заранее. Порядок — практика инженерной службы, а не норма.</p>
    <ol>
      <li>Собрать проектную документацию пути и акт сдачи-приёмки с результатами планово-высотной съёмки (пункт 203).</li>
      <li>Найти паспорт пути и журналы осмотров после каждых 24 смен; пробел в записях исполнитель отметит в ведомости.</li>
      <li>Освободить участок стоянки крана в нерабочем состоянии, который обязан быть выделен на каждом пути (пункт 204), и расчистить рельсы и шпалы от мусора.</li>
      <li>Зафиксировать дату последнего подтопления или ливня, чтобы исполнитель учёл их при оценке основания.</li>
      <li>Согласовать остановку работ крана: обследование идёт с отключением движения по пути.</li>
    </ol>
    <p>Про выбор между рельсовым путём и фундаментом, где путь вообще не нужен, — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>. Если объект рассчитан на срок короче трёх лет, обследование может не попасть в график, но осмотры и плановая проверка остаются обязательными. Вопросы по модели и основанию можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ подскажет вариант без лишних требований к пути.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — приказ Ростехнадзора от 26.11.2020 № 461, пп. 203–214 (проверка и комплексное обследование рельсовых путей)' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: основание и тип крана по моделям' },
      { href: 'https://kran-kuban.ru/blog/seysmika-i-zakon-o-tishine/', label: 'kran-kuban.ru — сейсмичность Краснодарского края и закон о тишине' },
    ]} />
</BlogArticleLayout>
