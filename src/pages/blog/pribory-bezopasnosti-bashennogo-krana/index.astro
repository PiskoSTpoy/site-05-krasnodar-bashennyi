---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 102. Пятидесятая статья блога — угол (a) информационный/how-to.
// Приборы безопасности башенного крана: что обязано стоять на кране и что заказчик
// видит при приёмке. Соседи: «Грузовая характеристика» (физика кривой), «Кран во время
// норд-оста» (ветер и флюгирование), «Заземление и молниезащита» — у этой статьи свой
// предмет: перечень ограничителей и указателей и порядок их проверки.
//
// Фактура — проверена 01.10.2026 (WebSearch + WebFetch):
// - ГОСТ 32575.3-2022 «Краны грузоподъёмные. Ограничители и указатели. Часть 3. Краны
//   башенные» действует с 1 марта 2023 г., заменил ГОСТ 32575.3-2013 (gostinfo.ru);
// - перечень: ограничитель грузоподъёмности, указатель номинальной грузоподъёмности,
//   ограничители и указатели движений, сигнализатор предельной скорости ветра,
//   регистратор параметров; порог — 1 т или 40 000 Н·м (выдача по тексту стандарта);
// - редакция 2013 г.: срабатывание ограничителя в диапазоне 102–110 % (docs.cntd.ru,
//   выдача), п. 9.4 — усреднённые показания ветра, интервал 5 с (os1.ru);
// - СНиП 12-04-2002 — 15 м/с (os1.ru).
// Сроки поверки и калибровки НЕ называю — в проверенных источниках их нет.
// Федеральный слой (ФНП №461) — одной фразой, тема закреплена за site-01.

const CHECKED = '1 октября 2026 года';
const PUBLISHED = '2026-10-01';

const title = 'Приборы безопасности башенного крана: что должно стоять';
const description = 'ГОСТ 32575.3-2022 требует на башенном кране 6 групп приборов: от ограничителя грузоподъёмности до регистратора параметров. Что делает каждый и как их проверяют.';
const h1 = 'Какие приборы безопасности должны стоять на башенном кране';
const crumbTitle = 'Приборы безопасности башенного крана';
const slug = 'pribory-bezopasnosti-bashennogo-krana';

const H2 = [
  'Шесть групп приборов по ГОСТ 32575.3-2022',
  'Ограничитель грузоподъёмности: порог 102–110 %',
  'Ограничители движений: крюк, тележка, поворот, путь',
  'Сигнализатор ветра: осреднение за 5 секунд',
  'Регистратор параметров и приёмка крана за 5 шагов',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какие приборы безопасности обязательны на башенном кране?',
    a: 'ГОСТ 32575.3-2022 называет шесть групп: ограничитель грузоподъёмности или грузового момента, указатель номинальной грузоподъёмности, ограничители движений, указатели движений и рабочих параметров, сигнализатор предельной скорости ветра и регистратор параметров работы. КРАН-КУБАНЬ проверяет все шесть при вводе крана в работу на площадке заказчика.',
  },
  {
    q: 'Что такое ОГП на башенном кране?',
    a: 'ОГП — ограничитель грузоподъёмности: прибор сравнивает фактическую нагрузку с допустимой для текущего вылета и отключает подъём при перегрузе. У Potain MDT 219 J10 из парка КРАН-КУБАНЬ допустимый груз меняется от 10 т у мачты до 1,9 т на 65 м, поэтому ограничитель считает не вес, а грузовой момент.',
  },
  {
    q: 'При какой перегрузке срабатывает ограничитель грузоподъёмности?',
    a: 'ГОСТ 32575.3 в редакции 2013 года задаёт для башенных кранов срабатывание ограничителя при нагрузке не менее 102 % и не более 110 % от номинальной. Запас в несколько процентов не является резервом для работы: КРАН-КУБАНЬ планирует подъёмы по грузовой характеристике из паспорта, без расчёта на допуск прибора.',
  },
  {
    q: 'Обязателен ли анемометр на башенном кране?',
    a: 'Да, сигнализатор предельной скорости ветра входит в перечень ГОСТ 32575.3-2022 для башенных кранов. Прибор показывает усреднённую скорость ветра и подаёт сигнал при достижении предела из паспорта крана. Решение о прекращении работы принимает крановщик КРАН-КУБАНЬ — сигнализатор предупреждает, но не заменяет человека.',
  },
  {
    q: 'Можно ли работать на кране с неисправным ограничителем?',
    a: 'Нет, кран с неисправным или отключённым ограничителем к работе не допускается: требование закреплено федеральными правилами по подъёмным сооружениям, приказ Ростехнадзора №461. КРАН-КУБАНЬ останавливает кран до восстановления прибора, а факт вмешательства в настройки фиксирует регистратор параметров.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Эксплуатация · Безопасность"
  published={PUBLISHED}
>
    <p slot="intro">ГОСТ 32575.3-2022 требует на башенном кране шесть групп приборов: ограничитель грузоподъёмности, указатель номинальной грузоподъёмности, ограничители и указатели движений, сигнализатор ветра и регистратор параметров. Стандарт действует с 1 марта 2023 года. КРАН-КУБАНЬ проверяет эти приборы при каждом вводе крана в работу, потому что без них кран не допускают к подъёму грузов.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>ГОСТ 32575.3-2022 «Краны грузоподъёмные. Ограничители и указатели. Часть 3. Краны башенные» заменил редакцию 2013 года и действует с 1 марта 2023 года. Стандарт делит приборы на две роли: ограничитель останавливает движение сам, указатель только показывает машинисту значение. Ограничитель грузоподъёмности и указатель номинальной грузоподъёмности обязательны для кранов от 1 т или с опрокидывающим моментом от 40 000 Н·м, а под этот порог попадает вся техника КРАН-КУБАНЬ.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Группа приборов</th><th>Что контролирует</th><th>Как действует</th></tr></thead>
      <tbody>
        <tr><td>Ограничитель грузоподъёмности (грузового момента)</td><td>нагрузку на крюке с учётом вылета</td><td>отключает подъём и увеличение вылета</td></tr>
        <tr><td>Указатель номинальной грузоподъёмности</td><td>допустимый груз на текущем вылете</td><td>показывает значение машинисту</td></tr>
        <tr><td>Ограничители движений</td><td>крайние положения крюка, тележки, поворота, хода по пути</td><td>останавливают механизм у предела</td></tr>
        <tr><td>Указатели движений и параметров</td><td>вылет, высоту, угол поворота</td><td>показывают значение машинисту</td></tr>
        <tr><td>Сигнализатор предельной скорости ветра</td><td>скорость ветра на высоте крана</td><td>подаёт звуковой и световой сигнал</td></tr>
        <tr><td>Регистратор параметров</td><td>нагрузки, срабатывания, наработку</td><td>записывает историю работы</td></tr>
      </tbody>
    </table></div>
    <p>Таблица КРАН-КУБАНЬ сводит перечень стандарта к одному вопросу заказчика: какой прибор от чего защищает. Три строки останавливают или предупреждают, три — информируют и записывают. Набор одинаков для отечественного КБ-408.21 и для импортного Potain MDT 219 J10: отличается исполнение электроники, а не состав функций.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Ограничитель грузоподъёмности башенного крана срабатывает при нагрузке не менее 102 % и не более 110 % от номинальной — такой диапазон задан ГОСТ 32575.3 в редакции 2013 года. Прибор считает не вес сам по себе, а грузовой момент: произведение груза на вылет. Potain MDT 219 J10 из парка КРАН-КУБАНЬ поднимает 10 т у мачты и только 1,9 т на вылете 65 м, поэтому один и тот же поддон на разных вылетах даёт разную загрузку крана.</p>
    <p>Пример с числами для Potain MDT 219 J10: на конце стрелы 65 м номинал равен 1,9 т, значит, порог 102–110 % соответствует грузу примерно 1,94–2,09 т. Поддон массой 2,2 т на этом вылете ограничитель поднять не даст, хотя у мачты тот же кран берёт впятеро больше. КРАН-КУБАНЬ рассчитывает каждый подъём по паспортной кривой, как показано в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">о грузовой характеристике</a>, и не закладывает допуск прибора в план работ.</p>
    <p>После срабатывания ограничителя кран КРАН-КУБАНЬ разрешает только движения, которые уменьшают нагрузку: опускание груза и уменьшение вылета. Подъём и выдвижение тележки от мачты блокируются до тех пор, пока момент не вернётся в допустимую зону. Стропальщику это даёт простое правило: если кран «не берёт» груз, поддон разгружают или подвозят ближе к мачте.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Ограничители движений по ГОСТ 32575.3-2022 останавливают четыре механизма башенного крана у крайнего положения: подъём крюка, перемещение грузовой тележки, поворот и передвижение по рельсовому пути. Ограничитель высоты не даёт крюковой подвеске дойти до стрелы, ограничители вылета останавливают тележку у мачты и у конца стрелы. КРАН-КУБАНЬ проверяет каждый из них пробным подходом к пределу на малой скорости.</p>
    <p>Набор ограничителей зависит от модели парка КРАН-КУБАНЬ. КБ-408.21 ездит по наземному пути, поэтому у него работают концевые выключатели хода и тупиковые упоры в конце пути; КБ-674А в приставном исполнении стоит на фундаменте, и ограничитель передвижения ему не нужен. У махового Potain MCH 175 вместо хода тележки ограничивается угол наклона стрелы, потому что вылет меняется подъёмом самой стрелы.</p>
    <p>Ограничитель поворота башенного крана защищает кабели: без него токоподвод скручивается при вращении в одну сторону. На стеснённых площадках Краснодара, Сочи и Новороссийска КРАН-КУБАНЬ дополнительно настраивает координатную защиту — запретные секторы, в которые стрела не заходит. Границы секторов берут из проекта производства работ, а порядок их расчёта описан в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">об опасной зоне крана</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Сигнализатор предельной скорости ветра по пункту 9.4 ГОСТ 32575.3-2013 выдаёт непрерывные усреднённые показания с интервалом осреднения 5 секунд. Усреднение отсекает одиночный порыв, который длится секунду, и показывает устойчивый ветер, опасный для груза с большой парусностью. Датчик КРАН-КУБАНЬ ставит на верхней точке крана, где ветер сильнее, чем у земли.</p>
    <p>Предельную скорость ветра для работы берут из паспорта конкретного крана КРАН-КУБАНЬ, а общий строительный порог задаёт СНиП 12-04-2002: при 15 м/с и более работы на высоте прекращают. Сигнализатор подаёт сигнал, но не выключает кран целиком — решение об остановке принимает крановщик. На побережье это случается чаще, чем в степной части края; действия при боре разобраны в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Регистратор параметров башенного крана записывает нагрузки, срабатывания ограничителей и наработку — ГОСТ 32575.3-2022 включает его в обязательный перечень. Запись показывает, сколько циклов кран отработал и были ли попытки поднять груз сверх номинала. Для заказчика КРАН-КУБАНЬ это аргумент при разборе спорной ситуации: данные прибора объективнее объяснений участников.</p>
    <p>Приёмка приборов на кране КРАН-КУБАНЬ укладывается в пять шагов, и заказчик может присутствовать на каждом:</p>
    <ol>
      <li>Сверить по паспорту крана перечень установленных приборов и отметки об их настройке.</li>
      <li>Проверить ограничитель грузоподъёмности контрольным грузом на заданном вылете.</li>
      <li>Подвести крюк, тележку, поворот и ход к пределам и убедиться, что механизм останавливается.</li>
      <li>Проверить сигнализатор ветра и показания указателей в кабине.</li>
      <li>Убедиться, что регистратор ведёт запись, а пломбы на приборах целы.</li>
    </ol>
    <p>Требование работать только с исправными приборами закреплено федеральными правилами, приказ Ростехнадзора №461; КРАН-КУБАНЬ повторяет проверку после каждого монтажа и перебазировки. Место этой проверки в общем цикле показано на этапе <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>, а соседняя электрическая часть — в статье <a href="/blog/zazemlenie-i-molniezashchita-bashennogo-krana/">о заземлении крана</a>. Адрес объекта можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://en.gostinfo.ru/catalog/Details/?id=7068578', label: 'gostinfo.ru — ГОСТ 32575.3-2022 «Краны грузоподъёмные. Ограничители и указатели. Часть 3. Краны башенные»: действует с 01.03.2023, заменил редакцию 2013 г.' },
      { href: 'https://internet-law.ru/gosts/gost/78806/', label: 'internet-law.ru — ГОСТ 32575.3-2022: карточка и страницы стандарта' },
      { href: 'https://docs.cntd.ru/document/1200112633', label: 'docs.cntd.ru — ГОСТ 32575.3-2013: диапазон срабатывания ограничителя 102–110 %' },
      { href: 'https://os1.ru/article/26210-bashennye-krany-i-veter-velikany-i-uragany', label: 'os1.ru — п. 9.4 ГОСТ 32575.3-2013 (осреднение 5 с), СНиП 12-04-2002 (15 м/с)' },
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/', label: 'consultant.ru — приказ Ростехнадзора от 26.11.2020 №461 (правила безопасности ОПО с подъёмными сооружениями)' },
    ]} />
</BlogArticleLayout>
