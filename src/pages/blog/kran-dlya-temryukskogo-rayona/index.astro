---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 81. Шестнадцатая статья блога — Темрюкский район, первый разбор
// Таманского полуострова. Экономический якорь — действующий зерновой
// терминал ООО «ЗТКТ» в порту Тамань (ИНН 2352044733, ОГРН 1092352000553,
// проектная мощность до 5,5 млн тонн в год, рекорд сезона 2023/2024 —
// 5,4 млн тонн, данные подтверждены независимо на ztkt.ru, portnews.ru,
// spark-interfax.ru, checko.ru, list-org.com). Инженерный фактор —
// уникальный для края и для страны: грязевой вулканизм полуострова
// (40-50 действующих грязевых вулканов, академический источник —
// kubsu.ru), а не эрозия/подтопление/рыхлый песок, уже разобранные в
// других статьях блога.
//
// Как и в Волнах 76-78 (Ейск, Туапсе, Славянск-на-Кубани), сетевой доступ
// сессии не пропускал прямые запросы к docs.cntd.ru/meganorm.ru/rusprofile.ru
// (egress заблокирован даже для WebFetch) — только WebSearch. Строка
// Темрюкского района из Приложения Б ТСН 22-302-2000 в выдаче не нашлась,
// поэтому, как и в предыдущих волнах, сейсмический балл в статье не
// указан — фактор назван без числа, со ссылкой на первоисточник.
// По той же причине конкретная дата/высота извержения горы Гнилая
// (Гефест) дана с оговоркой «по данным путеводителей»: независимые
// источники в выдаче разошлись в годах последнего извержения.

const CHECKED = '7 сентября 2026 года';

const title = 'Кран для Темрюкского района: зерновой терминал Тамани и грязевые вулканы полуострова';
const description = 'Темрюкский район — между Азовским и Чёрным морями: зерновой терминал в порту Тамань, грязевой вулканизм полуострова как уникальный грунтовый фактор и то, что это значит для монтажа башенного крана.';
const h1 = title;
const crumbTitle = 'Кран для Темрюкского района';
const slug = 'kran-dlya-temryukskogo-rayona';

const H2 = [
  'Темрюкский район — полуостров между двух морей',
  'Порт Тамань и зерновой терминал: где чаще всего нужен кран',
  'Грязевые вулканы: грунтовый фактор, которого нет больше нигде в России',
  'Сейсмика: что можно сказать про Темрюкский район, а что нет',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Нужно ли на Таманском полуострове отдельно проверять, не стоит ли площадка рядом с грязевым вулканом?',
    a: 'Общий порядок инженерно-геологических изысканий один для всего края — он задан СП 446.1325800.2019 и разобран в статье «Инженерные изыскания перед монтажом крана». Но на Таманском полуострове у этих изысканий есть локальная особенность: часть территории района попадает в зону влияния грязевого вулканизма, а грязевые вулканы на полуострове расположены не равномерно, а сосредоточены в определённых местах (район Ахтанизовской, Голубицкой, горы Гнилой и других известных сопок). Поэтому для конкретной площадки в районе мы уточняем, не относится ли она к зоне такого влияния, а не полагаемся на общее представление о «степном» или «прибрежном» грунте края.',
  },
  {
    q: 'Правда ли, что для Темрюкского района сейсмический расчёт не нужен вообще?',
    a: 'Мы не можем сказать этого с уверенностью и потому не пишем в статье конкретный балл: доступные в этой волне источники не дали надёжного подтверждения строки Темрюкского района в Приложении Б ТСН 22-302-2000. Для конкретного объекта расчётную сейсмичность площадки определяет проектировщик по действующей редакции норматива, а не по среднему впечатлению о равнинной приморской части края.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Темрюкского района', item: `${SITE}/blog/kran-dlya-temryukskogo-rayona/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-temryukskogo-rayona/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-temryukskogo-rayona/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже писал про Черноморское побережье (Анапа, Новороссийск, Сочи), про Азовское (Ейск), про предгорную ось (Армавир, Горячий Ключ, Апшеронский и Мостовской районы) и про равнинную часть края на реке (Славянск-на-Кубани) — но ни разу про Таманский полуостров. Темрюкский район закрывает этот пробел, и не как «ещё один прибрежный город»: здесь у площадки под кран сразу два необычных фактора — портовая зерновая логистика и грунт, устроенный иначе, чем где-либо ещё в крае.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Темрюкский район занимает большую часть Таманского полуострова — узкой земли между Азовским морем на севере и Чёрным морем на юге, отделённой от Крыма Керченским проливом. Административный центр, город Темрюк, стоит в дельте Кубани, а собственно порт и зерновой терминал района — южнее, на берегу Таманского залива, у посёлка Волна. Курортная функция здесь тоже есть (Голубицкая, Пересыпь), но экономику района, в отличие от чисто пляжных территорий, во многом определяет портовая и сельскохозяйственная логистика, а не только сезонный туризм.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Ключевое предприятие для нашей темы — ООО «ЗТКТ» (Зерновой терминальный комплекс Тамань), зарегистрированное в 2009 году в порту Тамань, в границах Таманского сельского поселения (ИНН 2352044733, ОГРН 1092352000553); учредители компании — АО «Тамань Инвест» с долей 99,9% и МКООО «Тамань Грейн Терминал Холдингс» с долей 0,1%, данные подтверждаются независимо в нескольких открытых реестрах юрлиц. По собственным пресс-релизам терминала и отраслевому изданию PortNews, проектная мощность комплекса — до 5,5 млн тонн зерновых, зернобобовых и масличных культур в год, а сельскохозяйственный сезон 2023/2024 терминал закрыл с рекордом перевалки в 5,4 млн тонн; параллельно компания реализует программу расширения мощности. Для такой площадки кран нужен не под один жилой корпус на несколько месяцев, а периодически — под расширение элеваторных мощностей, силосных корпусов, эстакад и портовой инфраструктуры, причём часто в стеснённых условиях действующего грузового терминала, а не на свободном пустыре.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>В статье про изыскания перед монтажом крана мы уже разбирали, что рыхлый песчаный грунт Анапы или пойма Протоки у Славянска-на-Кубани — конкретные, локальные причины уточнять основание на площадке, а не полагаться на общее представление о грунте края. У Темрюкского района — свой, куда более редкий вариант той же темы. Таманский полуостров — единственный в России и один из крупнейших в мире районов проявления грязевого вулканизма: по академическим источникам (Кубанский государственный университет), на его территории насчитывают порядка 40-50 действующих грязевых вулканов, часть из которых формирует возвышенности высотой до полутора сотен метров. Самые известные — Ахтанизовская сопка у одноимённой станицы и гора Гнилая (местное название вулкана Гефест) в нескольких километрах от Темрюка; по данным путеводителей по региону, одно из давних извержений горы Гнилой в начале XX века разрушило стоявшие там войсковые постройки лечебницы — конкретный год и параметры того извержения в разных источниках расходятся, но сам факт периодической активности вулкана подтверждён многократно.</p>
    <p>Для монтажа крана это не значит, что весь район непригоден для капитального строительства — большая часть его территории вне зон конкретных вулканов застраивается и эксплуатируется десятилетиями. Но это значит, что инженерно-геологические изыскания на площадке в Темрюкском районе (те же по порядку, что заданы СП 446.1325800.2019 для всего края) должны прямо отвечать на вопрос, не относится ли конкретный участок к зоне влияния грязевого вулканизма — просаживающийся или подвижный грунт в такой зоне требует другого подхода к основанию крана, чем стандартный расчёт на плотном грунте. Мы указываем точное местоположение объекта в заявке именно для того, чтобы этот вопрос был закрыт до монтажа, а не выяснялся по факту прибытия техники на площадку.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Здесь мы, как и в статьях про Ейск и Славянск-на-Кубани, сознательно не приводим конкретный балл сейсмичности для Темрюкского района. Расчётная сейсмичность площадок края определяется по картам ОСР-2015 (СП 14.13330.2018) и территориальным нормам ТСН 22-302-2000, которые перечисляют баллы для конкретных населённых пунктов в отдельном приложении, — и именно эту строку для Темрюкского района доступные в этой волне источники надёжно не подтвердили. Мы уже показывали на примере Армавира, что интуиция «не курорт — значит, не сейсмоопасно» может подвести: Армавир, стоящий далеко от моря, по официальному приложению к краевому нормативу рассчитывается почти как Сочи. Возможно, что-то похожее верно и для Темрюкского района, а возможно — нет; называть цифру без прямой цитаты первоисточника мы не готовы. Проверить строку можно напрямую в ТСН 22-302-2000, ссылка — в источниках под статьёй.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины — краевой, а не только для курортных территорий Черноморского побережья, и действует в Темрюкском районе так же, как в Анапе или Краснодаре: часы шумных работ и ответственность по статье 3.3 КоАП одинаковы для всего края независимо от того, стоит рядом портовый терминал или прибрежный посёлок. Разница не в норме, а в вероятности жалобы: у грузового терминала, удалённого от плотной жилой застройки, риск обращения ниже, чем у стройки рядом с курортным посёлком Голубицкая в разгар сезона, — но само требование к часам работы это не отменяет. Подробный разбор часов и сумм — в статье <a href="/blog/seysmika-i-zakon-o-tishine/" style="color:var(--accent)">«Сейсмика и закон о тишине на Кубани»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Темрюкский район — первый разбор блога про Таманский полуостров: земля между Азовским и Чёрным морями, с портовой и сельскохозяйственной, а не только курортной экономикой.</li>
      <li>Основной промышленный заказчик — зерновой терминал ООО «ЗТКТ» в порту Тамань (ИНН 2352044733), мощностью до 5,5 млн тонн в год, с программой расширения.</li>
      <li>Таманский полуостров — единственный в России район концентрированного грязевого вулканизма (40-50 вулканов); для площадки в районе изыскания должны отдельно проверить зону влияния вулканизма.</li>
      <li>Сейсмический балл для площадки в статье намеренно не назван: доступные источники не подтвердили строку Темрюкского района в Приложении Б ТСН 22-302-2000.</li>
      <li>Закон о тишине №608-КЗ действует в Темрюкском районе так же, как на остальном побережье края.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://spark-interfax.ru/krasnodarski-krai-temryukski-raion/ooo-ztkt-ooo-zernovoi-terminalny-kompleks-taman-inn-2352044733-ogrn-1092352000553-ea0a290e5c9f4440b238272284579e14', label: 'spark-interfax.ru — ООО «ЗТКТ», ИНН 2352044733, ОГРН 1092352000553' },
      { href: 'https://checko.ru/company/ozztkt-1092352000553', label: 'checko.ru — учредители ООО «ЗТКТ»: АО «Тамань Инвест» (99,9%), МКООО «Тамань Грейн Терминал Холдингс» (0,1%)' },
      { href: 'https://ztkt.ru/news/18-zernovoj-terminalnyj-kompleks-taman-zakonchil-sezon-2023-2024-s-rekordom-perevalki-v-5-4-mln-tonn', label: 'ztkt.ru — рекорд перевалки 5,4 млн тонн, сезон 2023/2024' },
      { href: 'https://portnews.ru/news/369542/', label: 'portnews.ru — планы по увеличению мощности терминала «Тамань»' },
      { href: 'https://www.kubsu.ru/sites/default/files/faculty/prezentaciya_gryazevoy_vulkanizm_kak_yavlenie_o_obekt_eskursionnogo.pdf', label: 'kubsu.ru — грязевые вулканы Керченско-Таманской области, число и высота сопок' },
      { href: 'https://cyclowiki.org/wiki/Грязевые_вулканы_(Тамань)', label: 'cyclowiki.org — грязевые вулканы Тамани, включая гору Гнилую (Гефест) и Ахтанизовскую сопку' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края (Приложение Б — список населённых пунктов)' },
    ]} />
</BlogArticleLayout>
