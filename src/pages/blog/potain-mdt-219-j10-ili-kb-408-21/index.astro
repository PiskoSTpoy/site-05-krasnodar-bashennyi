---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 103. Пятьдесят четвёртая статья блога — угол (b) коммерческий/сравнительный.
// Последняя непарная пара моделей парка: оба крана на рельсовом ходу (Potain
// MDT 219 J10 может встать и на фундамент), оба 10 т максимум — но с разной
// геометрией стрелы (топлесс vs оголовок) и разным вылетом (65 м vs 40 м).
// Парная к «КБ-408.21 или КБ-674А» (Волна 102) и «Potain MDT 219 J10 или MCH 175»
// (Волна 101): там сравнивали внутри одного бренда, здесь — через бренды.
//
// Фактура — только реестр parkModels.ts и карточки /park/ (проверено 02.10.2026):
// - Potain MDT 219 J10: 10 т, 1,9 т на 65 м, вылет 65 м, крюк до 70,4 м,
//   топлесс, путь или фундамент, совместимость базовой мачты в линейке MDT;
// - КБ-408.21: 10 т, вылет 40 м, крюк 54,0–72,7 м, с оголовком, только путь,
//   база 7,5×7,5 м, противовес 45 т.
// Цен и сроков поставки нет: открытые источники дают разброс объявлений по
// отдельности для каждой модели, но не сравнение «дешевле/дороже» без даты
// и конкретного предложения — такого сравнения в статье нет.

const CHECKED = '2 октября 2026 года';
const PUBLISHED = '2026-10-02';

const title = 'Potain MDT 219 J10 или КБ-408.21: какой кран выбрать';
const description = 'Оба крана поднимают 10 т, но Potain MDT 219 J10 достаёт на 65 м топлесс-стрелой, а КБ-408.21 — на 40 м с оголовком. Как выбрать между ними по вылету объекта.';
const h1 = 'Potain MDT 219 J10 или КБ-408.21: какой башенный кран выбрать';
const crumbTitle = 'Potain MDT 219 J10 или КБ-408.21';
const slug = 'potain-mdt-219-j10-ili-kb-408-21';

const H2 = [
  'Чем Potain MDT 219 J10 отличается от КБ-408.21',
  'Сравнение Potain MDT 219 J10 и КБ-408.21 по шести параметрам',
  'Когда нужен вылет Potain MDT 219 J10 — 65 м',
  'Когда хватает КБ-408.21 на рельсовом пути',
  'Как выбрать кран для объекта с несколькими корпусами',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Чем отличается Potain MDT 219 J10 от КБ-408.21?',
    a: 'Оба крана из парка КРАН-КУБАНЬ поднимают до 10 т, но по-разному устроены и достают на разное расстояние. Potain MDT 219 J10 — безоголовочный (топлесс) кран с вылетом до 65 м, а КБ-408.21 — кран с оголовком и вылетом до 40 м. КБ-408.21 работает только на рельсовом пути, Potain MDT 219 J10 — на пути или на монолитном фундаменте.',
  },
  {
    q: 'У какого крана больше грузоподъёмность: у Potain или у КБ-408.21?',
    a: 'Максимальная грузоподъёмность у Potain MDT 219 J10 и КБ-408.21 из парка КРАН-КУБАНЬ одинаковая — 10 т у мачты. Разница проявляется на вылете: Potain MDT 219 J10 несёт 1,9 т на предельных 65 м, а грузоподъёмность КБ-408.21 на его предельном вылете 40 м КРАН-КУБАНЬ считает по паспортной грузовой характеристике под конкретный объект.',
  },
  {
    q: 'Можно ли поставить Potain MDT 219 J10 без рельсового пути?',
    a: 'Да, Potain MDT 219 J10 из парка КРАН-КУБАНЬ монтируют на рельсовый путь или на монолитный фундамент — выбор основания шире, чем у КБ-408.21, который работает только на наземном рельсовом пути. Фундамент выгоден на стеснённом участке, где негде проложить путь под базу крана.',
  },
  {
    q: 'Какой кран выше поднимает крюк: Potain MDT 219 J10 или КБ-408.21?',
    a: 'По верхней границе высоты подъёма кран КБ-408.21 из парка КРАН-КУБАНЬ немного обходит Potain MDT 219 J10: крюк до 72,7 м против 70,4 м. Разница в 2,3 м редко становится решающим фактором — выбор между моделями чаще определяет вылет, а не высота подъёма.',
  },
  {
    q: 'Почему топлесс-кран ставят на стеснённую площадку?',
    a: 'Безоголовочная схема Potain MDT 219 J10 не имеет растяжек стрелы и оголовка над собой, поэтому кран можно поставить впритык к соседнему крану или зданию, не рискуя задеть чужую верхнюю точку при развороте. КРАН-КУБАНЬ использует это свойство на плотной застройке Краснодара и Сочи, где рядом одновременно работает несколько кранов.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">Potain MDT 219 J10 и КБ-408.21 из парка КРАН-КУБАНЬ поднимают одинаковые 10 т, но Potain достаёт на вылете до 65 м безоголовочной (топлесс) стрелой, а КБ-408.21 — только до 40 м краном с оголовком. Оба работают на рельсовом пути, а Potain MDT 219 J10 ещё и на монолитном фундаменте. Выбор между ними решает не грузоподъёмность, а вылет и геометрия соседней застройки.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Potain MDT 219 J10 и КБ-408.21 из парка КРАН-КУБАНЬ различаются конструкцией стрелы: Potain — безоголовочный (топлесс) кран без растяжек над стрелой, КБ-408.21 — классическая схема с оголовком. У топлесс-крана нет верхней точки, которая выступает над стрелой при развороте, поэтому Potain MDT 219 J10 можно ставить ближе к соседним кранам и зданиям. КБ-408.21 с оголовком — более распространённая в России схема, привычная монтажным бригадам и проектировщикам стройки.</p>
    <p>Второе отличие пары — вылет и основание. КБ-408.21 из парка КРАН-КУБАНЬ работает только на наземном рельсовом пути и держит вылет до 40 м, Potain MDT 219 J10 встаёт на путь или на монолитный фундамент и достаёт до 65 м. По документации производителя базовая мачта серии MDT унифицирована в линейке Potain, что упрощает подбор запчастей и узлов при обслуживании. Паспортные данные моделей КРАН-КУБАНЬ приводит в карточках <a href="/park/potain-mdt-219-j10/">Potain MDT 219 J10</a> и <a href="/park/kb-408-21/">КБ-408.21</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>Potain MDT 219 J10</th><th>КБ-408.21</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>безоголовочный (топлесс)</td><td>с оголовком, рельсовый ход</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>10 т</td><td>10 т</td></tr>
        <tr><td>Предельный вылет</td><td>65 м</td><td>40 м</td></tr>
        <tr><td>Груз на предельном вылете</td><td>1,9 т</td><td>по паспортной кривой</td></tr>
        <tr><td>Высота подъёма крюка</td><td>до 70,4 м</td><td>54,0–72,7 м</td></tr>
        <tr><td>Основание</td><td>рельсовый путь или монолитный фундамент</td><td>только наземный рельсовый путь</td></tr>
      </tbody>
    </table></div>
    <p>Таблица парка КРАН-КУБАНЬ показывает, что модели равны по грузоподъёмности, но расходятся по вылету почти в полтора раза: 65 м у Potain MDT 219 J10 против 40 м у КБ-408.21. На верхней границе высоты подъёма разница обратная и небольшая — у КБ-408.21 запас 2,3 м за счёт исполнений мачты от 54,0 до 72,7 м. Строка «основание» в таблице — единственная, где у Potain MDT 219 J10 есть выбор, а у КБ-408.21 его нет.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Вылет 65 м Potain MDT 219 J10 из парка КРАН-КУБАНЬ нужен на объектах с широким пятном застройки: торговый центр, производственный корпус с несколькими пролётами, жилой комплекс из нескольких корпусов вокруг одной стоянки крана. С одной точки Potain MDT 219 J10 закрывает круг радиусом 65 м — это почти в полтора раза больше площади обслуживания, чем у КБ-408.21 на той же стоянке.</p>
    <p>Топлесс-геометрия Potain MDT 219 J10 — второй довод в пользу этой модели на плотной застройке Краснодара, Сочи и Новороссийска, где рядом одновременно работают несколько башенных кранов. Без оголовка и растяжек над стрелой кран можно поставить ближе к соседней машине, не рискуя задеть её при развороте. КРАН-КУБАНЬ подбирает именно эту модель, когда в проекте производства работ уже заложено несколько кранов на одной площадке.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КБ-408.21 из парка КРАН-КУБАНЬ хватает, когда объект вытянут вдоль одной оси и вылета 40 м достаточно, чтобы перекрыть ширину здания с одной стоянки пути. Кран едет по рельсам вдоль фасада и подаёт груз в любую точку по длине — то, чего неподвижный кран на фундаменте не умеет без увеличения вылета. Для длинного производственного корпуса или жилого дома со стандартной секционной застройкой перемещение по пути часто выгоднее лишнего радиуса.</p>
    <p>Привычность схемы с оголовком — практический довод за КБ-408.21: отечественная модель собрана по геометрии, с которой давно работают монтажные бригады и проектировщики на Кубани. КРАН-КУБАНЬ ставит КБ-408.21 на объекты, где заказчику важна предсказуемая логистика запчастей и обслуживания в пределах края, без завязки на зарубежного дилера. Как эта модель ведёт себя рядом с приставным краном того же производителя, разобрано в статье <a href="/blog/kb-408-21-ili-kb-674a/">«КБ-408.21 или КБ-674А»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Жилой комплекс из трёх корпусов вокруг общего двора — пример, где выбор между Potain MDT 219 J10 и КБ-408.21 заметен сильнее всего. Если корпуса стоят по кругу диаметром до 120 м, один Potain MDT 219 J10 в центре двора накрывает все три здания вылетом 65 м с единой стоянки. Пример условный и показывает логику выбора, а не конкретный объект.</p>
    <ol>
      <li>Измерьте расстояние от возможной точки стоянки крана до самой дальней части объекта.</li>
      <li>Если оно больше 40 м, КБ-408.21 без переустановки пути не справится — переходите к Potain MDT 219 J10.</li>
      <li>Проверьте, есть ли на участке место под рельсовый путь или нужен компактный фундамент.</li>
      <li>Уточните, стоят ли рядом другие краны: топлесс-геометрия Potain MDT 219 J10 снижает риск столкновения стрел.</li>
      <li>Сверьте высоту объекта с паспортными данными обеих моделей в карточках парка.</li>
    </ol>
    <p>Итоговый выбор между Potain MDT 219 J10 и КБ-408.21 КРАН-КУБАНЬ делает на стадии проекта производства работ, когда известны генплан, число корпусов и расстояние между ними. Общий порядок подбора крана под объект описан в статье <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>. Чертёж и адрес объекта можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/potain-mdt-219-j10/', label: 'kran-kuban.ru — карточка модели Potain MDT 219 J10: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/kb-408-21/', label: 'kran-kuban.ru — карточка модели КБ-408.21: паспортные характеристики' },
      { href: 'https://exkavator.ru/excapedia/technic/kranovie_tehnologii_kb-40821-02', label: 'exkavator.ru — КБ-408.21: технические характеристики и обзор' },
      { href: 'https://www.manitowoc.com/', label: 'manitowoc.com — производитель Potain, серия MDT' },
    ]} />
</BlogArticleLayout>
