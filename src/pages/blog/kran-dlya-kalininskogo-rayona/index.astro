---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 108. Шестьдесят девятая статья блога — угол (c) региональный.
// Калининский район — первый разбор территории на северо-западе края, которой
// в реестре ещё не было (соседи Тимашевск и Славянск-на-Кубани уже разобраны).
//
// Фактура — только официальный сайт района и его инвестиционный портал:
// - invest.kalininskaya-93.ru/ru/presentation/district/ (проверено 08.10.2026):
//   население 51 190 чел. (дата не указана), 26 300 экономически активных,
//   115,4 тыс. га сельхозугодий, черноземы 65 % площади (те же 115,4 тыс. га),
//   около 13 тыс. га водных ресурсов (река Понура, лиманы, плавни), умеренно-жаркий
//   климат, 280 солнечных дней, дороги Тимашевск — Славянск-на-Кубани — Крымск и
//   Калининская — Новотитаровская, Северо-Кавказская ж/д, станция Величковка;
// - там же: расстояние до Краснодара указано как 246 км и как 75 км — противоречие,
//   поэтому расстояние в статье не называется;
// - площадь района на портале не указана; цифру из Википедии (1499,54 км²) в статью
//   не берём — первоисточника на сайте района не нашлось;
// - invest.kalininskaya-93.ru/ru/news/kalininskiy-rayon-predstavlyaet-25052026/:
//   анонс предприятия по выращиванию индеек, 560 т в год, участок 99 034 м² в хуторе
//   Джумайловка — анонс проекта, а не готовый объект;
// - kalininskaya-93.ru — официальный сайт муниципального образования.
// Балл сейсмичности района не назван (конвенция сайта с Волны 79): в источниках его нет.
// Калининский сельский округ города Краснодара — другое муниципальное образование.

const CHECKED = '8 октября 2026 года';
const PUBLISHED = '2026-10-08';

const title = 'Кран для Калининского района: башенный кран на черноземе';
const description = 'В Калининском районе 115,4 тыс. га сельхозугодий, черноземы на 65 % территории и около 51 тыс. жителей по порталу района. Что это значит для башенного крана.';
const h1 = 'Кран для Калининского района: какой башенный кран нужен на черноземе';
const crumbTitle = 'Кран для Калининского района';
const slug = 'kran-dlya-kalininskogo-rayona';

const H2 = [
  'Что известно о районе: население, земля, экономика',
  'Грунт: чернозём и путь под краном',
  'Инвестиционная площадка: птицеводство в хуторе Джумайловка',
  'Транспорт: трасса, железная дорога и станция Величковка',
  'Тишина и жара: что учесть при работе крана',
  'Что проверить до заказа крана в районе',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько жителей в Калининском районе?',
    a: '51 190 человек по данным инвестиционного портала района, дата публикации на странице не указана. Сторонний сервис СПАРК даёт около 51,21 тыс., так что цифры близки. Для официальной даты нужна сверка с Росстатом, её в статье пока нет.',
  },
  {
    q: 'Какой грунт в Калининском районе?',
    a: 'Черноземы: портал указывает, что они занимают 65 % площади района. Несущую способность под рельсовым путём или фундаментом определяет изыскание на конкретном участке, а не данные по району в целом.',
  },
  {
    q: 'Сколько сельхозугодий в Калининском районе?',
    a: '115,4 тыс. га по данным портала. Тот же показатель портал приводит и для чернозёмов, поэтому две категории нельзя складывать в одну площадь.',
  },
  {
    q: 'Нужен ли башенный кран для птицефабрики?',
    a: 'Зависит от проекта. Башенный кран нужен при высоких конструкциях, например силосах или вентиляционных башнях. Низкие корпуса КРАН-КУБАНЬ рекомендует проверять на возможность монтажа автокраном, а решение принимать по самой высокой отметке проекта.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Калининский район"
  published={PUBLISHED}
>
    <p slot="intro">Черноземы занимают 65 % территории Калининского района, а сельхозугодья — 115,4 тыс. га: эти цифры опубликованы на инвестиционном портале района. Для башенного крана первый вопрос здесь — грунт под рельсовым путём или фундаментом, поэтому КРАН-КУБАНЬ начинает подбор модели с изысканий, а не с каталога.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Административный центр Калининского района — станица Калининская. Портал района называет 51 190 жителей без даты публикации и 26 300 экономически активных. Сторонний сервис СПАРК даёт около 51,21 тыс. человек, то есть цифры близки, но точной даты у портала нет.</p>
    <p>Экономика держится на агропромышленном комплексе: портал называет сельское хозяйство, перерабатывающую и пищевую промышленность, мукомольно-крупяное производство, рыбоводство и рыболовство. Земельный фонд тоже работает на эту структуру: портал приводит 115,4 тыс. га и как сельхозугодья, и как площадь чернозёмов, поэтому считать эти категории по отдельности нельзя.</p>
    <p>Вода — ещё один фактор территории. Портал указывает около 13 тыс. га водных ресурсов: река Понура, лиманы, плавни и водоёмы. Рядом с лиманами и плавнями КРАН-КУБАНЬ рекомендует включать в изыскание проверку уровня грунтовых вод до выбора фундамента.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Черноземный грунт под путём или фундаментом требует проверки несущей способности на каждом участке. Глубину и количество точек определяет изыскание, а не цифра по району, поэтому статья не называет ни одной нормы для конкретного слоя.</p>
    <p>Для рельсового пути важна ещё и ровность. Пункт 203 ФНП № 461 ограничивает отклонения рельсового пути от проектного положения величинами приложения 5, а готовность пути подтверждает акт сдачи-приёмки с планово-высотной съёмкой. Порядок изысканий и приёмки разобран в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Инженерные изыскания перед монтажом крана»</a>.</p>
    <p>Климат района портал описывает как умеренно-жаркий с 280 солнечными днями в году. Подъёмы в полуденную жару требуют отдельного графика, как описано в статье <a href="/blog/bashennyi-kran-v-zharu/">«Башенный кран в жару»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Портал района анонсирует предприятие по выращиванию индеек мощностью 560 тонн продукции в год. Участок площадью 99 034 м² выделен в хуторе Джумайловка. Это анонс инвестиционного проекта, а не готовый объект, поэтому сроки и состав строительства в статье не приводятся.</p>
    <p>Для такого комплекса башенный кран нужен не всегда. КРАН-КУБАНЬ рекомендует сначала сверить проект по высотам: если все корпуса низкие, монтаж можно вести автокраном, а башенный кран рассматривать только для высоких конструкций. Сравнение моделей для такой задачи — в статье <a href="/blog/kb-408-21-ili-potain-mch-175/">«КБ-408.21 или Potain MCH 175»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Портал перечисляет дороги Тимашевск — Славянск-на-Кубани — Крымск и Калининская — Новотитаровская, линию Северо-Кавказской железной дороги и станцию Величковка. Для доставки секций крана важен маршрут от трассы до площадки, поэтому КРАН-КУБАНЬ проверяет его до подачи заявки на доставку.</p>
    <p>Соседние районы с похожей логистикой уже разобраны: в статьях <a href="/blog/kran-dlya-timashevska/">«Кран для Тимашевска»</a> и <a href="/blog/kran-dlya-slavyanska-na-kubani/">«Кран для Славянска-на-Кубани»</a> описаны трасса и площадки рядом с ней. Условия подъезда стоит сравнивать с ними, а не с данными по всему краю.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Работа башенного крана в районе подчиняется закону о тишине Краснодарского края № 608-КЗ, и часы шумных работ на объекте считаются по нему. Как закон применяется к башенному крану и почему сейсмика с ним связана, разобрано в статье <a href="/blog/seysmika-i-zakon-o-tishine/">«Сейсмика и закон о тишине на Кубани»</a>.</p>
    <p>Жара на объекте — отдельная нагрузка на смену. Портал описывает климат района как умеренно-жаркий, и подъёмы в полдень на открытом черноземе требуют графика, рассчитанного под температуру. Пример такого графика — в статье <a href="/blog/bashennyi-kran-v-zharu/">«Башенный кран в жару»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Перед заказом крана в Калининском районе проверяют пять пунктов, и каждый из них влияет на выбор модели или на сроки.</p>
    <ol>
      <li>Изыскание под путь или фундамент с учётом чернозёма и уровня грунтовых вод рядом с лиманами.</li>
      <li>Высота верха строения и вылет до дальней точки груза — по паспорту выбранной модели.</li>
      <li>Маршрут доставки от трассы Тимашевск — Крымск до самой площадки.</li>
      <li>Срок монтажа и график подъёмов с учётом жары.</li>
      <li>Статус проекта: утверждённая документация или анонс на портале.</li>
    </ol>
    <p>Сроки и порядок монтажа по дням разобраны в статье <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сколько дней занимает сборка»</a>. Если объект ещё на стадии анонса, сроки монтажа стоит пересчитывать после утверждения проекта.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://invest.kalininskaya-93.ru/ru/presentation/district/', label: 'invest.kalininskaya-93.ru — презентация Калининского района: население, земля, климат, транспорт (проверено 08.10.2026)' },
      { href: 'https://invest.kalininskaya-93.ru/ru/news/kalininskiy-rayon-predstavlyaet-25052026/', label: 'invest.kalininskaya-93.ru — анонс проекта предприятия по выращиванию индеек (25.05.2026)' },
      { href: 'https://kalininskaya-93.ru/', label: 'kalininskaya-93.ru — официальный сайт муниципального образования Калининский район' },
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'legalacts.ru — Приказ Ростехнадзора № 461 (ФНП), пункт 203' },
    ]} />
</BlogArticleLayout>
