---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 121. Сто седьмая статья блога — угол (a) информационный / how-to.
// Подача груза в проёмы (люки) перекрытий и монтаж парусных конструкций башенным краном:
// ФНП № 461 пп. 162–163. Фактура — сырой текст legalacts.ru (curl, utf-8, проверено 27.10.2026):
// п. 162 — подача грузов в проёмы (люки) перекрытий и покрытий по специально разработанному ППР;
// груз опускают и крюк со стропами поднимают на минимальной скорости без раскачивания;
// расстояние между краем проёма и грузом (или крюковой обоймой, если она опускается в проём) —
// не менее 0,5 м; при подъёме стропа через проём крюки стропов навешены на разъёмное звено,
// строп направляется снизу пеньковым канатом, который отцепляют после выхода стропа из проёма;
// стропальщик подходит к грузу (отходит от груза), когда груз опущен (поднят) на высоту не более
// 1 м от поверхности, где стоит стропальщик; у места приёма (отправки) груза и у проёма —
// световая сигнализация (груз над проёмом / опускание через проём), надписи и знаки, запрещающие
// нахождение людей под грузом; сигнализация расположена так, чтобы груз и грузозахватные приспособления
// её не повредили; связь или сигнальщики — подробно в статье «Рация или сигнальщик» (ссылкой);
// проёмы в межферменном пространстве — ровные гладкие стены, чтобы груз не застревал;
// п. 163 — монтаж конструкций с большой парусностью и габаритами (витражи, фермы, перегородки,
// стеновые панели) и монтаж в зоне примыкания к эксплуатируемым зданиям (сооружениям) —
// работы в местах действия опасных факторов; по ППР, под непосредственным руководством
// инженерно-технического работника, ответственного за безопасное производство работ с применением ПС.
// Расчёт-иллюстрация КРАН-КУБАНЬ: пакет 1,5 × 1,0 м, зазор 0,5 м с каждой стороны → проём не менее
// 2,5 × 2,0 м (трактовка «с каждой стороны» — рекомендация, помечена в тексте).
// НЕ названо: скорости в м/с (ФНП их не задают), ветровые пределы (из паспорта), цены, сроки.

const CHECKED = '27 октября 2026 года';
const PUBLISHED = '2026-10-27';

const title = 'Подача груза в проём перекрытия краном: пп. 162–163 ФНП';
const description = 'ФНП № 461 п. 162: зазор от груза до края проёма не менее 0,5 м, подход стропальщика при грузе ниже 1 м, световая сигнализация. Разбор КРАН-КУБАНЬ.';
const h1 = 'Как башенным краном подавать груз в проём перекрытия и монтировать панели и витражи';
const crumbTitle = 'Подача груза в проём перекрытия';
const slug = 'podacha-gruza-v-proemy-perekrytiy-bashennym-kranom';

const H2 = [
  'Два пункта ФНП: проёмы перекрытий и парусные конструкции',
  'Специальный ППР для проёма: без него груз не подают',
  'Зазор 0,5 м: проём под пакет 1,5 × 1,0 м',
  'Минимальная скорость, разъёмное звено и пеньковый канат',
  'Световая сигнализация и знаки у проёма',
  'Витражи, фермы, перегородки и панели: пункт 163',
  'Монтаж у эксплуатируемого здания',
  'Памятка для площадки: порядок подачи в проём',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой зазор нужен между грузом и краем проёма в перекрытии?',
    a: 'Не менее 0,5 м: так сказано в пункте 162 ФНП № 461. Зазор считают до груза или до крюковой обоймы, если она тоже опускается в проём. КРАН-КУБАНЬ при расчёте закладывает 0,5 м с каждой стороны, то есть проём больше груза на 1,0 м по каждому размеру.',
  },
  {
    q: 'Когда стропальщик может подойти к грузу в проёме?',
    a: 'Когда груз опущен или поднят на высоту не более 1 м от поверхности, на которой стоит стропальщик. Это правило пункта 162 ФНП. До этого момента стропальщик находится вне зоны под грузом, а команды крановщику КРАН-КУБАНЬ подаются по радио, телефону или через сигнальщика.',
  },
  {
    q: 'Нужен ли отдельный ППР для подачи груза в проём?',
    a: 'Да. Пункт 162 ФНП требует подавать грузы в проёмы и люки перекрытий и покрытий по специально разработанному проекту производства работ. Общего ППР на монтаж крана для этого недостаточно: в проекте описывают размеры проёмов, порядок подачи и сигнализацию. Состав ППР — в статье КРАН-КУБАНЬ о проекте производства работ.',
  },
  {
    q: 'Что относится к парусным конструкциям по ФНП?',
    a: 'Пункт 163 называет витражи, фермы, перегородки и стеновые панели как конструкции с большой парусностью и габаритами. Их монтаж относится к работам в местах действия опасных факторов и идёт по ППР под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ.',
  },
  {
    q: 'Можно ли монтировать панели рядом с действующим зданием без инженера на площадке?',
    a: 'Нет. Монтаж в зоне примыкания к эксплуатируемым зданиям и сооружениям пункт 163 ФНП относит к работам в местах действия опасных факторов. Они идут по ППР и под непосредственным руководством ответственного инженерно-технического работника, который присутствует на площадке, а не отвечает по телефону.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Проёмы и парусные конструкции"
  published={PUBLISHED}
>
    <p slot="intro">Пункт 162 ФНП № 461 разрешает подавать груз башенным краном в проём перекрытия только по специальному ППР, с зазором не менее 0,5 м от груза до края и с подходом стропальщика, когда груз ниже 1 м от его площадки. Пункт 163 добавляет витражи, фермы, перегородки и стеновые панели к работам в местах действия опасных факторов. Для КРАН-КУБАНЬ это два набора действий: подготовить проём и назначить инженера.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>КРАН-КУБАНЬ опирается на два последовательных пункта федеральных норм и правил № 461 от 26.11.2020: пункт 162 о подаче грузов в проёмы и люки перекрытий и покрытий, пункт 163 о монтаже парусных конструкций и работе у эксплуатируемых зданий. Первый описывает проём, второй — вид работ; вместе они закрывают две ситуации, где груз проходит рядом с конструкцией, а не просто висит над площадкой.</p>
    <p>Для башенного крана оба пункта применимы напрямую: нормы говорят о подъёмных сооружениях вообще. Типичный пример на площадке КРАН-КУБАНЬ — подача арматуры или опалубки через технологический проём в перекрытии подвала, а также установка стеновых панелей и витражей на готовый каркас. Подъём как таковой — в статье <a href="/blog/podem-gruza-bashennym-kranom-po-fnp/">«Подъём груза башенным краном по ФНП»</a>.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Требование</th><th>Пункт ФНП</th><th>Кто отвечает на площадке</th></tr></thead>
      <tbody>
        <tr><td>Специальный ППР на подачу в проём</td><td>162</td><td>Эксплуатирующая организация</td></tr>
        <tr><td>Зазор от груза до края проёма ≥ 0,5 м</td><td>162</td><td>Проектировщик ППР, стропальщик</td></tr>
        <tr><td>Подход к грузу при высоте ≤ 1 м</td><td>162</td><td>Стропальщик</td></tr>
        <tr><td>Световая сигнализация, знаки</td><td>162</td><td>Эксплуатирующая организация</td></tr>
        <tr><td>Монтаж парусных конструкций под руководством ИТР</td><td>163</td><td>Инженерно-технический работник</td></tr>
      </tbody>
    </table></div>
    <p>Третий столбец КРАН-КУБАНЬ заполнил по смыслу пунктов: прямо ФНП называют ответственного только в пункте 163. Остальные обязанности распределяет ППР площадки; состав людей на ней разобран в статье <a href="/blog/kto-mozhet-byt-na-montazhnoy-ploshchadke-bashennogo-krana/">«Кто может быть на монтажной площадке»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Подачу грузов в проёмы и люки перекрытий и покрытий КРАН-КУБАНЬ ведёт только по специально разработанному ППР, потому что так прямо требует пункт 162 ФНП № 461. Слово «специально» значит: общего раздела о работе крана на объекте недостаточно, нужен документ именно на эту операцию с размерами проёма, этажом, порядком подачи и сигнализацией.</p>
    <p>В специальный ППР на подачу в проём КРАН-КУБАНЬ рекомендует вносить пять сведений: размеры проёма и груза, положение крана и вылет до проёма, схему строповки, места стропальщиков наверху и внизу, способ связи. Список — практика инженерной службы, а не норма. Общий состав проекта — в статье <a href="/blog/proekt-proizvodstva-rabot-s-bashennym-kranom/">«Проект производства работ с башенным краном»</a>.</p>
    <p>КРАН-КУБАНЬ проверяет вылет до проёма по грузовой характеристике, а не по максимуму: у КБ-674А это 12,5 т максимум и 5,6 т на 50,5 м, у Potain MDT 219 J10 — 10 т максимум и 1,9 т на 65 м. Пакет, который проходит по массе вблизи мачты, на дальнем вылете может оказаться за пределом. Расчёт — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пункт 162 ФНП, на который опирается КРАН-КУБАНЬ, задаёт расстояние между краем проёма и грузом не менее 0,5 м, а при опускании крюковой обоймы в проём это расстояние отсчитывают и до неё. Груз, таким образом, должен свободно проходить через проём, а не протискиваться; цель нормы — исключить застревание и контакт груза с кромкой перекрытия.</p>
    <p>Расчёт-иллюстрация КРАН-КУБАНЬ для пакета арматуры 1,5 × 1,0 м: если зазор 0,5 м выдержать с каждой стороны, проём нужен не менее 1,5 + 0,5 + 0,5 = 2,5 м в длину и 1,0 + 0,5 + 0,5 = 2,0 м в ширину. Размеры груза условные, а трактовка «с каждой стороны» — рекомендация КРАН-КУБАНЬ: норма говорит о расстоянии, не уточняя, считать ли его по периметру.</p>
    <p>КРАН-КУБАНЬ проверяет и качание: груз на стропах для КБ-408.21 или Potain MCH 175 не висит неподвижно, и реальный зазор меньше расчётного на величину раскачивания. Поэтому проём не делают по минимуму, а оставляют запас сверх 0,5 м, если конструкция перекрытия позволяет. Стропы и схемы — в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Груз в проём КРАН-КУБАНЬ опускает, а крюк со стропами поднимает на минимальной скорости без раскачивания: это требование пункта 162. Числовое значение скорости ФНП не называет, оно определяется паспортом и руководством по эксплуатации конкретного крана, например режимом малой скорости механизма подъёма.</p>
    <p>Подъём самого стропа через проём на площадках КРАН-КУБАНЬ устроен отдельно. Крюки стропов навешивают на разъёмное звено, а строп направляют снизу пеньковым канатом; канат отцепляют после того, как строп вышел из проёма. Смысл приёма понятен: стальной строп с крюками не должен зацепиться за кромку перекрытия или арматурный выпуск, когда его вытягивают наверх вслепую.</p>
    <p>Стропальщику разрешено подойти к грузу или отойти от него, когда груз опущен или поднят на высоту не более 1 м от поверхности, где стропальщик стоит. Для КРАН-КУБАНЬ это правило превращается в простую границу: пока груз выше метра, стропальщик остаётся за пределами проёма и зоны под грузом. Правило метра для подъёма вообще — в статье <a href="/blog/podem-gruza-bashennym-kranom-po-fnp/">о подъёме груза</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>У места приёма и отправки груза, а также у самого проёма КРАН-КУБАНЬ оборудует световую сигнализацию: пункт 162 требует, чтобы она предупреждала и о нахождении груза над проёмом, и о его опускании через проём. Рядом ставят надписи и знаки, запрещающие находиться под перемещаемым грузом.</p>
    <p>Сигнализацию размещают так, чтобы перемещаемый груз и грузозахватные приспособления не могли её повредить: лампа на кромке проёма, в которую метит груз, этому требованию не соответствует. Освещённость самой площадки по вечерам регулирует отдельная норма, разобранная в статье <a href="/blog/osveshchenie-ploshchadki-bashennogo-krana/">«Освещение площадки башенного крана»</a>.</p>
    <p>Между крановщиком и стропальщиком, который находится вне его видимости, ФНП требуют двусторонней радио- или телефонной связи либо сигнальщиков из числа стропальщиков. Подача в проём — именно такой случай: крановщик Potain MCH 175 не видит этаж внизу. Выбор между связью и сигнальщиком — в статье <a href="/blog/raciya-ili-signalshchik-na-bashennom-krane/">«Рация или сигнальщик на башенном кране»</a>. Проёмы в межферменном пространстве должны иметь ровные гладкие стены, чтобы груз в них не застревал.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Монтаж конструкций с большой парусностью и габаритами — витражей, ферм, перегородок и стеновых панелей — пункт 163 ФНП относит к работам в местах действия опасных факторов. Для КРАН-КУБАНЬ это означает, что такие подъёмы нельзя вести по общей инструкции: нужен ППР и инженерно-технический работник, непосредственно руководящий работами.</p>
    <p>Для КРАН-КУБАНЬ парусность важна потому, что ветер действует на плоскую панель площадью в десятки квадратных метров сильнее, чем на пакет арматуры такой же массы. Предельную скорость ветра для крана определяет паспорт, и она не считает груз с большой площадью. Поэтому решение о подъёме панели принимает руководитель работ с учётом условий дня; детали — в статье <a href="/blog/veter-i-pasport-bashennogo-krana/">«Ветер и паспорт башенного крана»</a>.</p>
    <p>Для Potain MDT 219 J10 и КБ-408.21 с длинной стрелой разворот парусной конструкции на вылете особенно заметен: плечо увеличивает момент, а оттяжки в руках стропальщика работают на полную длину. Рекомендация КРАН-КУБАНЬ: панели большой площади подавать в паузах между порывами и разворачивать оттяжками; нормы о развороте груза — в статье о подъёме груза.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Монтаж в зоне примыкания к эксплуатируемым зданиям и сооружениям КРАН-КУБАНЬ воспринимает как отдельный риск, потому что пункт 163 приравнивает его к парусным конструкциям: тот же ППР, то же непосредственное руководство инженера. Причина понятна: рядом люди, коммуникации и фасад, которые не защищены строительным ограждением.</p>
    <p>Для башенного крана у действующего здания к этому добавляется геометрия: стрела и груз не должны проходить над кровлей и входами, если иное не предусмотрено проектом. Ограничение зоны делают по ППР и по правилам, описанным в статье <a href="/blog/opasnaya-zona-bashennogo-krana/">«Опасная зона башенного крана»</a>. Для реконструкции корпусов подход общий с задачей из статьи <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>.</p>

    <h2 id={headings[7].id} style="margin:36px 0 16px">{headings[7].text}</h2>
    <p>Порядок подачи груза в проём КРАН-КУБАНЬ собирает из пунктов 162 и 163 в семь действий. Это рекомендация инженерной службы, а не текст норм: последовательность упрощает контроль и не даёт пропустить требование.</p>
    <ol>
      <li>В ППР есть специальный раздел на подачу в проём; размеры проёма и груза сверены (п. 162).</li>
      <li>Зазор от груза и обоймы до края проёма не меньше 0,5 м с запасом на раскачивание (п. 162).</li>
      <li>Световая сигнализация и знаки установлены и защищены от груза и стропов (п. 162).</li>
      <li>Связь с крановщиком проверена, либо сигнальщик виден крановщику и стропальщику (п. 162).</li>
      <li>Груз и крюк идут через проём на минимальной скорости без раскачивания (п. 162).</li>
      <li>Стропальщик подходит к грузу, когда тот ниже 1 м от его площадки (п. 162).</li>
      <li>При подаче панелей, витражей и ферм на площадке находится инженерно-технический работник (п. 163).</li>
    </ol>
    <p>Семь действий укладываются в смену подачи материалов на любой площадке с КБ-674А, giraFFe SMK-5.66 или другой моделью парка. Нормы о погрузке машин — в статье <a href="/blog/pogruzka-razgruzka-transporta-bashennym-kranom/">«Погрузка и разгрузка транспорта башенным краном»</a>. План этажа с проёмами можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ предложит модель и точку стоянки.</p>

