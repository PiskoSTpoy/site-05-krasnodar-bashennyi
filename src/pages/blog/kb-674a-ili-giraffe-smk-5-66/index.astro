---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 109. Семидесятая статья блога — угол (b) коммерческий/сравнительный.
// Пара, которую ещё не сравнивали: КБ-674А (приставной, анкеровка к зданию,
// 12,5 т, вылет 50,5 м, высота до 116–120 м приставным способом) и giraFFe SMK-5.66
// (быстромонтируемый, без фундамента, 5 т, вылет до 43 м, монтаж 4–6 часов).
// Это два «крайних» кейса парка: самый высокий и самый быстрый кран.
//
// Фактура — только реестр parkModels.ts и карточки /park/ (проверено 09.10.2026).
// Цен в реестре нет, поэтому по стоимости модели не сравниваются.

const CHECKED = '9 октября 2026 года';
const PUBLISHED = '2026-10-09';

const title = 'КБ-674А или giraFFe SMK-5.66: что выбрать по высоте';
const description = 'КБ-674А поднимает крюк до 116–120 м приставным способом, SMK-5.66 встаёт за 4–6 часов без фундамента, но до 41,7 м. Сравнение по паспортным данным.';
const h1 = 'КБ-674А или giraFFe SMK-5.66: какой башенный кран выбрать для объекта';
const crumbTitle = 'КБ-674А или giraFFe SMK-5.66';
const slug = 'kb-674a-ili-giraffe-smk-5-66';

const H2 = [
  'Два разных ответа: приставной и быстромонтируемый',
  'Высота: 116–120 м против 41,7 м',
  'Грузоподъёмность и вылет: 12,5 т и 50,5 м против 5 т и 43 м',
  'Основание: фундамент с анкерами или опорный контур 4×4 м',
  'Монтаж: цикл с ППР или 4–6 часов',
  'Пять вопросов перед выбором',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой кран выше: КБ-674А или giraFFe SMK-5.66?',
    a: 'КБ-674А: приставным способом крюк достаёт 116–120 м, свободно — до 60 м. SMK-5.66 поднимает крюк до 27 м при горизонтальной стреле и до 41,7 м с наклоном 20°. Разница по верхней точке — больше 74 м.',
  },
  {
    q: 'Нужен ли фундамент для giraFFe SMK-5.66?',
    a: 'Нет. По карточке парка кран ставится на собственный опорный контур 4×4 м без рельсового пути, монолитного фундамента и анкеровки. КБ-674А, наоборот, требует фундамент и крепление к конструкции здания.',
  },
  {
    q: 'Можно ли использовать КБ-674А без здания, к которому его крепят?',
    a: 'Свободно, без креплений к зданию, КБ-674А поднимает крюк только до 60 м. Высота 116–120 м достигается приставным способом и зависит от числа настенных опор и исполнения. Несущие стены под анкеры проверяет проект.',
  },
  {
    q: 'Какой кран подойдёт для стеснённой площадки в центре города?',
    a: 'SMK-5.66, если высота объекта не выше 41,7 м по крюку и груз не больше 5 т. КБ-674А нужен фундамент и стена для анкеров, поэтому на тесном участке его применяют, когда высота здания не оставляет выбора.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">КБ-674А поднимает крюк до 116–120 м, если его закрепить на здании, а giraFFe SMK-5.66 собирается за 4–6 часов без фундамента, но достаёт только до 41,7 м. Две модели парка КРАН-КУБАНЬ решают противоположные задачи: одна выбирает высоту, другая — скорость и малое пятно основания.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>КБ-674А из парка КРАН-КУБАНЬ — приставной кран: на свободной высоте он стоит на фундаменте, а выше его крепят анкерными опорами к конструкции строящегося здания. Нагрузку на таком кране несёт не только грунт, но и стены дома, поэтому проект обязан подтвердить, что стены её выдерживают.</p>
    <p>giraFFe SMK-5.66 из Челябинска — быстромонтируемый кран на собственном опорном контуре. Фундамент, рельсовый путь и анкеровка ему не нужны, а монтаж по карточке парка занимает 4–6 часов от доставки до готовности к подъёму. Поэтому сравнивать эти модели по одной графе нельзя: таблица ниже показывает разные ответы на разные вопросы.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>КБ-674А</th><th>giraFFe SMK-5.66</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>приставной, крепится к зданию</td><td>быстромонтируемый, без фундамента</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>12,5 т (на вылете до 24 м)</td><td>5 т</td></tr>
        <tr><td>Груз на предельном вылете</td><td>5,6 т на 50,5 м</td><td>1,05 т на 43 м</td></tr>
        <tr><td>Вылет</td><td>3,5–50,5 м</td><td>2,8–43 м</td></tr>
        <tr><td>Высота подъёма</td><td>до 60 м свободно, 116–120 м приставным</td><td>до 27 м (горизонтальная стрела), до 41,7 м (наклон 20°)</td></tr>
        <tr><td>Основание</td><td>фундамент + анкеровка к зданию</td><td>опорный контур 4×4 м</td></tr>
        <tr><td>Монтаж</td><td>по проекту производства работ</td><td>4–6 часов</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>КБ-674А достаёт крюком 116–120 м приставным способом, а SMK-5.66 — максимум 41,7 м с наклоном стрелы 20°. Разница составляет более 74 м, и именно она решает выбор для жилых башен: высотное здание закрывает только КБ-674А.</p>
    <p>Условный пример: проектная отметка верха 90 м, плюс 3 м на строповку, итого 93 м. SMK-5.66 не проходит с запасом более 51 м. КБ-674А проходит, но только приставным способом: свободно он поднимает до 60 м, а выше требует анкеров на стенах. Количество опор и исполнение определяют итоговую высоту в диапазоне 116–120 м.</p>
    <p>Если объект ниже 40 м, картина другая. Для SMK-5.66 важно помнить, что 41,7 м даёт только наклон стрелы 20°, который сокращает вылет. На горизонтальной стреле с полным вылетом 43 м крюк поднимается лишь до 27 м — эти две высоты нельзя путать при подборе.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>КБ-674А поднимает 12,5 т на вылете до 24 м и 5,6 т на предельных 50,5 м. SMK-5.66 заметно слабее: 5 т максимум и 1,05 т на 43 м. На самом дальнем вылете разница составляет 5,3 раза в пользу КБ-674А, поэтому для тяжёлых элементов выбор очевиден.</p>
    <p>Для SMK-5.66 такая нагрузка и не предусмотрена. Модель рассчитана на короткий объект с лёгкими грузами. Вес самого тяжёлого элемента берут из проекта и сравнивают с графиком из паспорта, как описано в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КБ-674А требует фундамента и анкеровки к конструкции здания: так записано в карточке парка. Анкеры передают на стены горизонтальные нагрузки, поэтому до заказа крана проверяют несущую способность стен и шаг опор. Порядок такой проверки разобран на странице этапа <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>.</p>
    <p>У giraFFe SMK-5.66 всё наоборот: опорный контур 4×4 м с собственными аутригерами, без рельсового пути, фундамента и анкеровки. Площадка при этом всё равно должна выдерживать давление опор, и это проверяют изыскания. Что именно измеряют на грунте, описано в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Инженерные изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Монтаж SMK-5.66 по карточке парка занимает 4–6 часов, а КБ-674А собирают по проекту производства работ с последующим наращиванием и креплением к зданию. Поэтому сроки двух моделей несопоставимы: часы у SMK-5.66 против многоэтапного цикла у КБ-674А.</p>
    <p>Точные сроки сборки КБ-674А зависят от высоты и числа анкерных опор, а в реестре парка по ним цифры не указаны. Общую логику сроков и последовательность операций разбирает статья <a href="/blog/montazh-bashennogo-krana-sroki/">«Монтаж башенного крана: сколько дней занимает сборка»</a>, а сравнение быстромонтируемого и тяжёлого крана — статья <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Выбор между КБ-674А и SMK-5.66 сводится к пяти вопросам, и первый из них отсекает одну модель сразу.</p>
    <ol>
      <li>Какая отметка верха строения и сколько метров нужно на строповку: выше 41,7 м — только КБ-674А.</li>
      <li>Какой вес самого тяжёлого груза и на каком вылете: больше 5 т — только КБ-674А.</li>
      <li>Выдерживают ли стены здания анкеры: если проект не подтверждает, приставной режим закрыт.</li>
      <li>Есть ли место под фундамент или нужен кран на опорном контуре 4×4 м.</li>
      <li>Сколько дней стройплощадка может ждать монтажа: часы у SMK-5.66, многоэтапный цикл у КБ-674А.</li>
    </ol>
    <p>Цен в реестре парка КРАН-КУБАНЬ нет, а аренда и покупка разобраны в статье <a href="/blog/arenda-ili-pokupka-bashennogo-krana/">«Аренда или покупка башенного крана»</a>. Сравнивать модели стоит по высоте, грузу и основанию, а не по цене из чужого объявления.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://kran-kuban.ru/park/kb-674a/', label: 'kran-kuban.ru — карточка КБ-674А: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/park/giraffe-smk-5-66/', label: 'kran-kuban.ru — карточка giraFFe SMK-5.66: паспортные характеристики' },
      { href: 'https://kran-kuban.ru/etapy/montazh-i-ankerovka/', label: 'kran-kuban.ru — этап «Монтаж и анкеровка»' },
    ]} />
</BlogArticleLayout>
