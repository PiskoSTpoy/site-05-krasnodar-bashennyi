---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 102. Пятьдесят первая статья блога — угол (b) коммерческий/сравнительный.
// Пара отечественных кранов парка: КБ-408.21 (рельсовый ход) и КБ-674А (приставной).
// Парная к «Potain MDT 219 J10 или MCH 175» (Волна 101): там выбор решала геометрия
// стрелы, здесь — высота объекта и способ, которым кран её набирает.
//
// Фактура — только реестр parkModels.ts и карточки /park/ (проверено 01.10.2026):
// - КБ-408.21: 10 т, вылет 40 м, крюк 54,0–72,7 м, наземный рельсовый путь,
//   база 7,5×7,5 м, противовес 45 т;
// - КБ-674А: 12,5 т, 5,6 т на 50,5 м, до 60 м свободностоящим и до 116–120 м приставным,
//   фундамент + анкеровка к зданию.
// Цен в статье нет: разброс объявлений по КБ-408.21 дан в карточке модели, по КБ-674
// открытые источники дают «цена по запросу». Пример с домом помечен условным.

const CHECKED = '1 октября 2026 года';
const PUBLISHED = '2026-10-01';

const title = 'КБ-408.21 или КБ-674А: какой отечественный кран выбрать';
const description = 'КБ-408.21 едет по рельсам и поднимает крюк до 72,7 м, КБ-674А крепится к зданию и достаёт до 116–120 м. Как выбрать между ними по высоте и длине объекта.';
const h1 = 'КБ-408.21 или КБ-674А: какой башенный кран выбрать для объекта';
const crumbTitle = 'КБ-408.21 или КБ-674А';
const slug = 'kb-408-21-ili-kb-674a';

const H2 = [
  'Чем КБ-408.21 отличается от КБ-674А',
  'Сравнение КБ-408.21 и КБ-674А по шести параметрам',
  'Когда выбирают КБ-408.21 на рельсовом пути',
  'Когда нужен приставной КБ-674А',
  'Как выбрать кран для дома в 24 этажа',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какая грузоподъёмность у КБ-408.21 и КБ-674А?',
    a: 'КБ-408.21 из парка КРАН-КУБАНЬ поднимает до 10 т, КБ-674А — до 12,5 т у мачты и 5,6 т на предельном вылете 50,5 м. Разница заметнее всего на краю стрелы: КБ-674А несёт туда тяжёлые элементы, для которых КБ-408.21 пришлось бы ставить ближе к месту монтажа.',
  },
  {
    q: 'На какую высоту поднимает КБ-674А?',
    a: 'КБ-674А поднимает крюк до 60 м в свободностоящем исполнении и до 116–120 м в приставном, когда башню крепят к возводимому зданию. КРАН-КУБАНЬ наращивает мачту по мере роста этажей, поэтому верхняя граница зависит от числа креплений и расчёта каркаса конкретного дома.',
  },
  {
    q: 'Что лучше для длинного дома: КБ-408.21 или КБ-674А?',
    a: 'Для длинного дома высотой до 72,7 м КРАН-КУБАНЬ рекомендует КБ-408.21: кран едет по рельсовому пути вдоль фасада и закрывает длину здания передвижением. КБ-674А в приставном исполнении стоит на одной точке и обслуживает только круг радиусом 50,5 м, поэтому на длинной секции потребуется второй кран.',
  },
  {
    q: 'Нужен ли фундамент под КБ-408.21?',
    a: 'Монолитный фундамент КБ-408.21 не нужен: кран работает на наземном рельсовом крановом пути. КРАН-КУБАНЬ устраивает путь под базу 7,5×7,5 м с балластной призмой и тупиковыми упорами. Приставному КБ-674А, наоборот, нужны фундамент и анкеровка к конструкции здания.',
  },
  {
    q: 'Можно ли заменить КБ-674А импортным краном?',
    a: 'До высоты 70,4 м приставной КБ-674А заменяет Potain MDT 219 J10 из парка КРАН-КУБАНЬ: у него вылет 65 м и безоголовочная схема. Выше этой отметки свободностоящие модели парка не работают, и КБ-674А с креплением к зданию остаётся единственным вариантом КРАН-КУБАНЬ.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Сравнение · Парк техники"
  published={PUBLISHED}
>
    <p slot="intro">КБ-408.21 поднимает 10 т и набирает высоту крюка до 72,7 м на рельсовом пути, КБ-674А поднимает 12,5 т и в приставном исполнении достаёт до 116–120 м. Оба отечественных крана стоят в парке КРАН-КУБАНЬ, а выбор между ними определяют два размера объекта: высота здания и его длина вдоль фасада.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>КБ-408.21 и КБ-674А различаются способом, которым кран держится на площадке: первый стоит на наземном рельсовом пути, второй опирается на фундамент и крепится к зданию. КБ-408.21 из парка КРАН-КУБАНЬ — передвижной кран с базой 7,5×7,5 м и противовесом 45 т, устойчивость ему даёт собственная масса. КБ-674А устойчивость на большой высоте получает от каркаса дома, к которому башню притягивают креплениями.</p>
    <p>Способ опирания у пары КБ-408.21 и КБ-674А задаёт всё остальное: предельную высоту, зону обслуживания и состав подготовительных работ. Кран на рельсах закрывает длинный объект, но ограничен по высоте; приставной кран растёт вместе с домом, но работает с одной точки. Паспортные данные каждой машины КРАН-КУБАНЬ приводит в карточках <a href="/park/kb-408-21/">КБ-408.21</a> и <a href="/park/kb-674a/">КБ-674А</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Параметр</th><th>КБ-408.21</th><th>КБ-674А</th></tr></thead>
      <tbody>
        <tr><td>Тип</td><td>с оголовком, рельсовый ход</td><td>приставной, крепится к зданию</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>10 т</td><td>12,5 т</td></tr>
        <tr><td>Предельный вылет</td><td>40 м</td><td>50,5 м</td></tr>
        <tr><td>Груз на предельном вылете</td><td>по паспортной кривой</td><td>5,6 т</td></tr>
        <tr><td>Высота подъёма крюка</td><td>54,0–72,7 м</td><td>до 60 м свободностоящим, до 116–120 м приставным</td></tr>
        <tr><td>Основание</td><td>наземный рельсовый крановый путь</td><td>фундамент и анкеровка к зданию</td></tr>
      </tbody>
    </table></div>
    <p>Таблица парка КРАН-КУБАНЬ показывает, что КБ-674А сильнее по всем силовым строкам: на 2,5 т больше груз у мачты, на 10,5 м длиннее стрела, а потолок по высоте выше на 43–47 м. Грузовой момент КБ-674А на краю стрелы по паспортной паре равен примерно 283 тм, то есть 5,6 т на 50,5 м. Преимущество КБ-408.21 в таблице записано одной строкой — «рельсовый ход»: кран перемещается, а значит, обслуживает объект длиннее собственного вылета.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>КБ-408.21 КРАН-КУБАНЬ рекомендует для объектов высотой до 72,7 м, вытянутых вдоль одной оси: многосекционный жилой дом, производственный корпус, склад. Кран едет по пути вдоль фасада и подаёт груз в любую секцию, тогда как неподвижный кран достаёт только в пределах круга. Высоту КБ-408.21 набирает наращиванием секций мачты, диапазон по исполнениям — от 54,0 до 72,7 м.</p>
    <p>Рельсовый путь для КБ-408.21 требует места и подготовки: полоса под базу 7,5 м, балластная призма, тупиковые упоры и заземление рельсов. На стеснённом участке в центре Краснодара или Сочи такой полосы может не быть, и тогда КРАН-КУБАНЬ рассматривает кран на фундаменте. Сравнение двух оснований приведено в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>
    <p>Агропромышленные площадки Кубани — типичный сценарий для КБ-408.21 из парка КРАН-КУБАНЬ. Корпуса сахарных заводов, элеваторные склады и цеха переработки длинные и невысокие, и один кран на пути закрывает всю длину здания. Примеры таких площадок разобраны в региональных статьях о <a href="/blog/kran-dlya-tbilisskogo-rayona/">Тбилисском</a> и <a href="/blog/kran-dlya-pavlovskogo-rayona/">Павловском</a> районах.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КБ-674А нужен, когда здание выше 70–73 м — потолка обоих свободностоящих кранов парка КРАН-КУБАНЬ. В приставном исполнении башню КБ-674А крепят к возводимому каркасу и наращивают по мере роста этажей, поэтому высота подъёма достигает 116–120 м. До отметки 60 м КБ-674А работает как свободностоящий кран, и первые крепления ставят уже на построенные этажи.</p>
    <p>Анкеровка КБ-674А передаёт на здание горизонтальные нагрузки от крана, и каркас должен быть на них рассчитан. КРАН-КУБАНЬ согласует точки крепления с проектировщиком дома до начала монтажа: узлы закладывают в перекрытия или стены. В сейсмических районах края, где действует ТСН 22-302-2000, расчёт креплений ведут с учётом балла из проекта; порядок работ описан на этапе <a href="/etapy/montazh-i-ankerovka/">«Монтаж и анкеровка»</a>.</p>
    <p>Тяжёлые элементы на дальнем вылете — второй довод за КБ-674А в парке КРАН-КУБАНЬ. Кран несёт 5,6 т на 50,5 м, поэтому подаёт крупные панели, пакеты арматуры и опалубочные щиты на дальний угол плиты без перестановки. Для дома ниже 60 м приставная схема избыточна: крепления добавляют строку в смету, а высоту закрывает КБ-408.21 или Potain MDT 219 J10.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Дом в 24 этажа высотой около 75 м КБ-408.21 закрыть не может: крюк крана поднимается максимум до 72,7 м, а над верхней плитой нужен ещё запас на стропы и груз. КРАН-КУБАНЬ для такого объекта предлагает КБ-674А с креплением к каркасу. Пример условный и показывает логику выбора, а не конкретную площадку; для 16 этажей при тех же вводных достаточно КБ-408.21.</p>
    <ol>
      <li>Определите отметку верха здания и прибавьте запас на груз и стропы: выше 72,7 м КБ-408.21 отпадает.</li>
      <li>Измерьте длину объекта: если она больше двух вылетов, то есть 80 м для КБ-408.21, нужен ход по рельсам или второй кран.</li>
      <li>Проверьте, есть ли на участке полоса под рельсовый путь с базой 7,5 м.</li>
      <li>Найдите самый тяжёлый груз и вылет, на который его подают: сверьтесь с грузовой характеристикой.</li>
      <li>Для приставной схемы запросите у проектировщика дома узлы крепления башни.</li>
    </ol>
    <p>Окончательный выбор между КБ-408.21 и КБ-674А КРАН-КУБАНЬ делает на стадии проекта производства работ, когда известны генплан и график бетонирования. Импортную пару парка сравнивает статья <a href="/blog/potain-mdt-219-j10-ili-mch-175/">«Potain MDT 219 J10 или MCH 175»</a>, общий порядок подбора — <a href="/blog/kak-podobrat-bashennyi-kran/">«Как подобрать башенный кран»</a>. Чертёж и адрес объекта можно прислать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://exkavator.ru/excapedia/technic/kranovie_tehnologii_kb-40821-02', label: 'exkavator.ru — КБ-408.21: технические характеристики и обзор' },
      { href: 'https://www.kranauto.ru/public/specs/460_KB_408.21.PDF', label: 'kranauto.ru — паспортные характеристики КБ-408.21 (PDF)' },
      { href: 'https://www.stroy-kran.ru/kb/kb-674', label: 'stroy-kran.ru — КБ-674А: грузоподъёмность, вылет, высота подъёма приставным способом' },
      { href: 'https://kran-vertikal.ru/arenda/bashennye-krany/kb-674/', label: 'kran-vertikal.ru — КБ-674: характеристики, база и колея' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
    ]} />
</BlogArticleLayout>
