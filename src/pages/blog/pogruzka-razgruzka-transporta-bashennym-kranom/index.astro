---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 119. Сто первая статья блога — угол (a) информационный / how-to.
// Погрузка и разгрузка автомашин и полувагонов башенным краном: ФНП № 461 пп. 124–128
// (п. 129 — одной ссылкой, он подробно разобран в статье «Подъём груза башенным краном по ФНП»).
// Фактура — сырой текст legalacts.ru (curl, utf-8, проверено 25.10.2026):
// п. 124 — эстакады или навесные площадки для стропальщиков в местах постоянной погрузки
// автомашин и полувагонов; технология погрузки полувагонов утверждена эксплуатирующей организацией
// (места стропальщиков, выход на эстакады); людей в полувагонах при подъёме и опускании нет;
// п. 125 — отправляемые грузы грузят так, чтобы строповка при разгрузке была безопасной;
// «не разрешается опускать груз на автомашину, а также поднимать груз при нахождении людей
// в кузове или кабине»; п. 126 — без нарушения равновесия транспорта; строповка пакетов труб
// и металлопроката за элементы упаковки запрещена; длинномерные — не менее двух пакетирующих
// строп соответствующей грузоподъёмности; п. 127 — несколько ПС только по ППР или ТК, нагрузка
// на каждое ≤ грузоподъёмности; под руководством ИТР: несколько ПС, полувагоны, груз без
// маркировки веса и схем строповки; п. 128 — перемещение над перекрытиями, под которыми могут
// быть люди, не допускается; ПС в зданиях над нижними этажами — только если проект учёл падение груза.
// Пояснения «что делать на площадке» — рекомендация КРАН-КУБАНЬ, помечена в тексте.
// НЕ названо: сроки, штрафы, расстояния до людей (ФНП их здесь не задаёт), цены.

const CHECKED = '25 октября 2026 года';
const PUBLISHED = '2026-10-25';

const title = 'Погрузка и разгрузка машин башенным краном: правила ФНП';
const description = 'ФНП № 461 пп. 124–128: люди не находятся в кузове и кабине при подъёме, пакеты не стропят за упаковку, груз без веса — под надзором ИТР. Разбор КРАН-КУБАНЬ.';
const h1 = 'Как башенным краном разгружать и грузить автомашины: правила пп. 124–128 ФНП';
const crumbTitle = 'Погрузка и разгрузка башенным краном';
const slug = 'pogruzka-razgruzka-transporta-bashennym-kranom';

const H2 = [
  'Пять пунктов ФНП о транспорте: что в них входит',
  'Кабина, кузов и полувагон: где людям быть нельзя',
  'Эстакады и технология для постоянных мест разгрузки',
  'Равновесие транспорта и строповка пакетов труб и проката',
  'Несколько кранов и груз без маркировки: под надзором ИТР',
  'Над перекрытием с людьми: запрет пункта 128',
  'Памятка для площадки: порядок разгрузки машины',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Можно ли поднимать груз, пока водитель сидит в кабине?',
    a: 'Нет. Пункт 125 ФНП № 461 не разрешает поднимать груз при нахождении людей в кузове или кабине автомашины. Водитель выходит из кабины в безопасное место до подъёма. На площадке КРАН-КУБАНЬ место ожидания водителя назначают заранее и показывают на схеме разгрузки.',
  },
  {
    q: 'Можно ли стропить пакет труб за обвязку?',
    a: 'Нет. Пункт 126 ФНП запрещает строповку пакетов труб и металлопроката за элементы упаковки: скрутки и стяжки не предназначены для строповки. Длинномерный груз поднимают не менее чем двумя пакетирующими стропами соответствующей грузоподъёмности.',
  },
  {
    q: 'Что делать, если на грузе нет маркировки веса?',
    a: 'Работать под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением подъёмных сооружений: так требует пункт 127 ФНП. Тот же порядок действует при отсутствии схем строповки, разгрузке полувагонов и совместной работе нескольких кранов.',
  },
  {
    q: 'Можно ли двумя кранами поднять один груз?',
    a: 'Только по проекту производства работ или технологической карте, и нагрузка на каждый кран не должна превышать его грузоподъёмность. Так говорит пункт 127 ФНП № 461. Расстояния при совместной работе и порядок согласования КРАН-КУБАНЬ берёт из проекта конкретной площадки.',
  },
  {
    q: 'Можно ли переносить груз краном над перекрытием, под которым люди?',
    a: 'Нет. Пункт 128 ФНП не допускает перемещать грузы при строительно-монтажных и погрузочно-разгрузочных работах над перекрытиями, под которыми размещены производственные, жилые или служебные помещения, где могут находиться люди. Исключение — только если проект предусмотрел падение груза.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормы · Погрузка и разгрузка"
  published={PUBLISHED}
>
    <p slot="intro">Пункты 124–128 ФНП № 461 задают правила для башенного крана, который разгружает или грузит автомашины: людей в кабине и кузове при подъёме быть не должно, пакеты труб нельзя стропить за упаковку, а груз без маркировки веса поднимают под надзором инженерно-технического работника. Для КРАН-КУБАНЬ это пять пунктов, и каждый превращается в конкретное действие на площадке: назначить место водителю, выбрать стропы, определить ответственного.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>КРАН-КУБАНЬ опирается на требования к погрузке и разгрузке транспорта, которые собраны в пяти последовательных пунктах федеральных норм и правил № 461 от 26.11.2020: пункты 124, 125, 126, 127 и 128. Каждый отвечает на свой вопрос: где стоят люди, как грузят, как стропят, кто руководит и что находится под грузом. Пункт 129 — о людях между грузом и стеной — разобран отдельно в статье <a href="/blog/podem-gruza-bashennym-kranom-po-fnp/">«Подъём груза башенным краном по ФНП»</a>.</p>
    <p>Для башенного крана норма применима напрямую: пункты говорят о подъёмных сооружениях и крюковых кранах вообще. На стройке КРАН-КУБАНЬ чаще всего это разгрузка самосвалов, бортовых машин и тралов с арматурой, трубами, опалубкой и поддонами. Полувагоны на строительной площадке встречаются редко, но пункты о них действуют там, где подведена железнодорожная ветка склада или производственного предприятия.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Пункт ФНП</th><th>О чём</th><th>Ответственный на площадке</th></tr></thead>
      <tbody>
        <tr><td>124</td><td>Эстакады и технология для постоянных мест, люди в полувагонах</td><td>Эксплуатирующая организация</td></tr>
        <tr><td>125</td><td>Людей нет в кузове и кабине, строповка при последующей разгрузке</td><td>Стропальщик, водитель</td></tr>
        <tr><td>126</td><td>Равновесие транспорта, пакеты труб и проката, длинномеры</td><td>Стропальщик</td></tr>
        <tr><td>127</td><td>Несколько кранов, груз без маркировки, полувагоны</td><td>Инженерно-технический работник</td></tr>
        <tr><td>128</td><td>Запрет переноса над перекрытием с людьми внизу</td><td>Проектировщик, руководитель работ</td></tr>
      </tbody>
    </table></div>
    <p>Третий столбец заполнен инженерной службой КРАН-КУБАНЬ по смыслу пунктов, а не по тексту норм: ФНП называют ответственных только в пункте 127. Остальные распределяют по ППР площадки, и состав людей на ней — тема статьи <a href="/blog/kto-mozhet-byt-na-montazhnoy-ploshchadke-bashennogo-krana/">«Кто может быть на монтажной площадке»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>На площадках КРАН-КУБАНЬ подъём и опускание груза запрещены, пока люди находятся в кузове или кабине автомашины, а в полувагонах людей при подъёме и опускании не допускается быть вовсе. Первый запрет содержит пункт 125 ФНП, второй — пункт 124. Формулировка пункта 125 жёсткая: не разрешается опускать груз на автомашину, а также поднимать груз при нахождении людей в кузове или кабине.</p>
    <p>Практически КРАН-КУБАНЬ трактует это так: водитель покидает кабину и уходит в заранее назначенное безопасное место до того, как крановщик поднимает первый пакет. Для кузова это значит, что человек, поправлявший строп или откидывавший борт, тоже сходит на землю. Интерпретация «кто куда уходит» — рекомендация КРАН-КУБАНЬ, сама норма говорит только о недопустимости присутствия людей.</p>
    <p>Для башенного крана это особенно важно из-за расстояния до земли: крановщик Potain MDT 219 J10 или КБ-408.21 сидит высоко над площадкой и может не разглядеть человека между бортом и пакетом. Поэтому КРАН-КУБАНЬ рекомендует подавать сигнал на подъём только стропальщику, который лично убедился, что кузов пуст. Способы связи с кабиной — в статье <a href="/blog/raciya-ili-signalshchik-na-bashennom-krane/">«Рация или сигнальщик на башенном кране»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Для постоянных мест КРАН-КУБАНЬ исходит из пункта 124, который в местах погрузки и разгрузки автомашин и полувагонов требует стационарные эстакады или навесные площадки для стропальщиков. Постоянное место — склад арматуры, бетонный узел, площадка приёма металлоконструкций; временная разгрузка у стройки под этот пункт не подпадает буквально, но принцип сохраняется: стропальщик не лезет на борт и не стоит на колесе.</p>
    <p>Погрузку и разгрузку полувагонов крюковыми подъёмными сооружениями выполняют по технологии, которую утвердила эксплуатирующая организация. В ней определены места нахождения стропальщиков при перемещении грузов и возможность их выхода на эстакады и навесные площадки. Для заказчика КРАН-КУБАНЬ это означает, что технологию составляет и утверждает владелец площадки, а не арендодатель крана. Рядом с рельсовым путём такая эстакада попадает в габарит приближения, поэтому её место фиксируют в ППР вместе с путём: устройство основания — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>КРАН-КУБАНЬ выполняет погрузку и разгрузку транспортных средств без нарушения их равновесия: пункт 126 ФНП распространяет это на полувагоны, платформы, автомашины и другие транспортные средства. Снимать груз с одной стороны кузова, не разгрузив противоположную, нельзя, если машина может опрокинуться или сместиться; последовательность съёма определяет стропальщик по расположению груза.</p>
    <p>На практике КРАН-КУБАНЬ пакеты труб и металлопроката не стропит за элементы упаковки, как и требует норма: скрутки и стяжки не предназначены для строповки. Длинномерные грузы поднимают в пакетирующих стропах, и их должно быть не менее двух, каждый соответствующей грузоподъёмности. Для КБ-674А с максимальной грузоподъёмностью 12,5 т это означает пару стропов, рассчитанных на всю массу пакета, а не по половине: запас по грузоподъёмности каждого стропа считает проект. Типы стропов и схемы — в статье <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>.</p>
    <p>Отдельная ловушка — вес пакета на машине. Масса указана в накладной на весь груз, а к крюку на разгрузке подходит часть: КРАН-КУБАНЬ сверяет её с грузовой характеристикой на нужном вылете, потому что на дальнем вылете грузоподъёмность падает. У КБ-674А это 5,6 т на вылете 50,5 м против 12,5 т максимума, у Potain MDT 219 J10 — 1,9 т на 65 м против 10 т. Расчёт по моделям — в статье <a href="/blog/gruzovaya-harakteristika-bashennogo-krana/">«Грузовая характеристика башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Для КРАН-КУБАНЬ подъём и перемещение груза несколькими подъёмными сооружениями разрешены только по проекту производства работ или технологической карте, и нагрузка на каждое из них не должна превышать его грузоподъёмность. Пункт 127 ФНП — единственный в этом блоке, где названа должность ответственного: инженерно-технический работник, отвечающий за безопасное производство работ с применением подъёмных сооружений.</p>
    <p>Под его непосредственным руководством выполняют три вида работ: перемещение груза несколькими кранами, разгрузку и погрузку полувагонов, а также любую работу при отсутствии маркировки веса груза и схем строповки. Для КРАН-КУБАНЬ третий случай знаком по практике: приезжает бортовая машина, на пакете нет бирки, и вес прикидывают «на глаз». Норма в этой ситуации требует присутствия инженера; вес по документам или взвешиванием определяют до подъёма — это рекомендация КРАН-КУБАНЬ.</p>
    <p>Совместная работа двух башенных кранов на одной площадке — отдельная тема в статье <a href="/blog/dva-bashennyh-krana-na-odnoj-ploshchadke/">«Два башенных крана на одной площадке»</a>. Подъём одного груза двумя кранами — другое, более редкое решение, и КРАН-КУБАНЬ рассматривает его только при готовом ППР: технология перераспределения нагрузки между крюками должна быть в проекте, а не придумана в день работ.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>КРАН-КУБАНЬ не переносит грузы над перекрытиями, под которыми размещены производственные, жилые или служебные помещения с возможным присутствием людей, потому что так сформулирован пункт 128 ФНП № 461. Он относится к строительно-монтажным и погрузочно-разгрузочным работам и закрывает ситуацию, когда пакет плит или арматуры проносят над нижним этажом действующего здания.</p>
    <p>Размещение подъёмного сооружения в производственных зданиях и сооружениях над нижними этажами допустимо только при условии, что проект объекта учёл возможное падение груза на межэтажные перекрытия или крышу. Проект должен подтвердить безопасность от падения груза и последствия контакта с перекрытием, в том числе химические и термические. Для башенного крана на стройплощадке это условие встречается редко, но оно важно при реконструкции корпусов, о которой идёт речь в статье <a href="/blog/kran-dlya-proizvodstvennogo-korpusa/">«Кран для производственного корпуса»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Порядок разгрузки машины башенным краном КРАН-КУБАНЬ собирает из пунктов 124–128 в шесть действий. Это рекомендация инженерной службы, а не текст норм: последовательность упрощает контроль и помогает не пропустить требование.</p>
    <ol>
      <li>Машина встаёт на отведённое место в зоне действия крюка; водитель выходит из кабины в назначенную безопасную точку (п. 125).</li>
      <li>Стропальщик проверяет, что в кузове и на платформе нет людей, и оценивает устойчивость машины при снятии груза (пп. 125–126).</li>
      <li>Масса груза определена по документам или взвешиванием; если маркировки и схемы строповки нет, вызывается инженерно-технический работник (п. 127).</li>
      <li>Пакет труб или проката стропят не за упаковку, а парой пакетирующих стропов нужной грузоподъёмности (п. 126).</li>
      <li>Маршрут груза проверен: под ним нет перекрытий с людьми и нет людей между грузом и стеной (пп. 128–129).</li>
      <li>Груз снимают без нарушения равновесия машины (п. 126), а стропальщик подходит к нему только после опускания на подкладки.</li>
    </ol>
    <p>Шесть действий укладываются в регламент разгрузки одной машины на любой площадке с Potain MCH 175, giraFFe SMK-5.66 или другой моделью парка. Нормы о пробном подъёме и запретах при подъёме груза — в статье <a href="/blog/podem-gruza-bashennym-kranom-po-fnp/">«Подъём груза башенным краном по ФНП»</a>. Размеры площадки и модель крана можно отправить через <a href="/#order">форму на главной</a>: КРАН-КУБАНЬ предложит схему подъезда машин.</p>

