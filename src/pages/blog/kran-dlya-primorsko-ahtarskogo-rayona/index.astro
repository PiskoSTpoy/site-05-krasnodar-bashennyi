---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 104. Пятьдесят девятая статья блога — угол (c) практический/региональный.
// Приморско-Ахтарский округ — северо-запад края на берегу Азовского моря,
// сосед уже разобранного Брюховецкого района (Волна 103) с западной стороны.
// Первый разбор территории, упразднённой как район и преобразованной в
// муниципальный округ (19.02.2024) — называю оба статуса явно для точности.
//
// Фактура — проверена 03.10.2026 (WebSearch + WebFetch, Википедия):
// - округ (бывший район) образован 2 июня 1924 г., упразднён как район
//   19.02.2024, преобразован в муниципальный округ; площадь 2503,63 км²
//   (2-е место в крае); население 55 313 чел. (2025 г.), перепись 2020 г. —
//   59 563 чел.; 35 населённых пунктов (1 город и 34 сельских);
//   соседи — Каневской, Брюховецкий, Ейский, Тимашевский, Калининский,
//   Славянский районы; с запада — Азовское море, с севера — Бейсугский лиман;
// - город Приморско-Ахтарск: основан в 1854 г. как посёлок Ахтарский, статус
//   станицы с 1900 г., город с 1922 г. (повторно с 1949 г.); на берегу
//   Ахтарского лимана Азовского моря; 151 км северо-западнее Краснодара;
//   население 30 084 чел. (2025 г.);
// - экономика: рыболовство и рыбоводство, рыбоперерабатывающие предприятия,
//   молочный завод, судостроение и судоремонт, курортно-туристический сектор
//   (базы отдыха).
// Балл сейсмичности НЕ называю (конвенция с Волны 79). Закон о тишине
// №608-КЗ — в редакции с 1 марта 2026 (как в статьях-соседях).

const CHECKED = '3 октября 2026 года';
const PUBLISHED = '2026-10-03';

const title = 'Кран для Приморско-Ахтарского района: кран у Азовского моря';
const description = 'Приморско-Ахтарск в 151 км от Краснодара на берегу лимана: рыбопереработка, судоремонт и курортная застройка. Какой башенный кран нужен на площадке.';
const h1 = 'Кран для Приморско-Ахтарского района: какой башенный кран нужен у Азовского моря';
const crumbTitle = 'Кран для Приморско-Ахтарского района';
const slug = 'kran-dlya-primorsko-ahtarskogo-rayona';

const H2 = [
  'Приморско-Ахтарский округ: 151 км от Краснодара на берегу Азовского моря',
  'Рыбопереработка и судоремонт — какой кран',
  'Курортная и жилая застройка Приморско-Ахтарска',
  'Грунт лимана и основание крана',
  'Балл сейсмичности и закон №608-КЗ',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько километров от Краснодара до Приморско-Ахтарска?',
    a: 'Город Приморско-Ахтарск находится в 151 км северо-западнее Краснодара, на берегу Ахтарского лимана Азовского моря. КРАН-КУБАНЬ везёт технику по трассе через Тимашевск: быстромонтируемый giraFFe SMK-5.66 — одним рейсом, классический кран — несколькими рейсами с секциями мачты и стрелой.',
  },
  {
    q: 'Приморско-Ахтарский район или округ — как правильно?',
    a: 'С 19 февраля 2024 года Приморско-Ахтарский район упразднён и преобразован в муниципальный округ — отдельные поселения вошли в единое муниципальное образование без районного деления. КРАН-КУБАНЬ в блоге сохраняет привычное название «район», которым чаще ищут эту территорию, но на картах и в документах сейчас фигурирует округ.',
  },
  {
    q: 'Какой кран нужен для рыбоперерабатывающего предприятия в Приморско-Ахтарске?',
    a: 'Цеха рыбопереработки и судоремонта — это, как правило, невысокие протяжённые корпуса. КРАН-КУБАНЬ предлагает КБ-408.21 на рельсовом пути: кран с вылетом 40 м едет вдоль здания и подаёт груз в любую точку по его длине без перестановки.',
  },
  {
    q: 'Какой балл сейсмичности у Приморско-Ахтарского округа?',
    a: 'КРАН-КУБАНЬ не называет балл для округа одной цифрой. Значение берут из карт ОСР-2015 для уровня ответственности конкретного объекта и уточняют микрорайонированием площадки, а требования задают ТСН 22-302-2000 и СП 14.13330.2018.',
  },
  {
    q: 'Действует ли закон о тишине в Приморско-Ахтарске?',
    a: 'Да, закон Краснодарского края №608-КЗ действует на всей территории края, включая Приморско-Ахтарский округ. С 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. В курортный сезон у набережной КРАН-КУБАНЬ учитывает эти окна особенно строго.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Приморско-Ахтарский округ"
  published={PUBLISHED}
>
    <p slot="intro">Город Приморско-Ахтарск стоит в 151 км северо-западнее Краснодара на берегу Ахтарского лимана Азовского моря, а население всего округа на 2025 год — 55 313 человек на площади 2503,63 км². Башенный кран здесь нужен рыбопереработке, судоремонту и курортной застройке набережной, а для малоэтажного жилья КРАН-КУБАНЬ предлагает быстромонтируемый giraFFe SMK-5.66.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Приморско-Ахтарский округ занимает 2503,63 км² — второе место по площади среди территорий края, а до 19 февраля 2024 года это был Приморско-Ахтарский район, упразднённый и преобразованный в единый муниципальный округ. Население на 2025 год составляет 55 313 человек при 35 населённых пунктах — одном городе и 34 сельских. С запада территорию омывает Азовское море, с севера — Бейсугский лиман, а на суше округ граничит с Каневским, Брюховецким, Ейским, Тимашевским, Калининским и Славянским районами.</p>
    <p>Город Приморско-Ахтарск, административный центр округа, основан в 1854 году как посёлок Ахтарский, получил статус станицы в 1900 году и стал городом в 1922 году, а окончательно — в 1949 году. Город стоит на берегу Ахтарского лимана Азовского моря, в 151 км северо-западнее Краснодара, и в нём живёт 30 084 человека по данным на 2025 год. Для КРАН-КУБАНЬ это означает доставку техники по трассе через Тимашевск — тот же маршрут, что и в соседний <a href="/blog/kran-dlya-bryuhoveckogo-rayona/">Брюховецкий район</a> восточнее.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>КБ-408.21 из парка КРАН-КУБАНЬ обслуживает цеха рыбопереработки и судоремонта в Приморско-Ахтарском округе вылетом до 40 м без перестановки пути. Экономика округа держится на рыболовстве и рыбоводстве: в городе работают рыбоперерабатывающие предприятия, молочный завод, а также судостроение и судоремонт — обслуживание рыболовного флота на берегу лимана. Цеха переработки рыбы и судоремонтные мастерские — как правило, невысокие протяжённые корпуса, вытянутые вдоль береговой линии или причала, а не высотные объекты.</p>
    <p>Рельсовый путь под КБ-408.21 из парка КРАН-КУБАНЬ укладывают вдоль здания, и кран обслуживает всю его длину с одной установки пути, без перестановки на соседнюю стоянку. Там, где корпус короче и срок стройки не оправдывает подготовку пути, КРАН-КУБАНЬ переходит на giraFFe SMK-5.66 — разница между двумя подходами разобрана в статье <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или классический кран»</a>.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Объект в Приморско-Ахтарском округе</th><th>Что определяет выбор</th><th>Модель парка КРАН-КУБАНЬ</th></tr></thead>
      <tbody>
        <tr><td>Цех рыбопереработки, судоремонтная мастерская</td><td>длина здания у берега</td><td>КБ-408.21, вылет 40 м, рельсовый путь</td></tr>
        <tr><td>Молочный завод</td><td>высота силосов и цехов</td><td>Potain MDT 219 J10, крюк до 70,4 м</td></tr>
        <tr><td>Гостиница или база отдыха на набережной</td><td>соседняя застройка, граница участка</td><td>Potain MCH 175, переменный вылет</td></tr>
        <tr><td>Малоэтажный дом города</td><td>скорость монтажа</td><td>giraFFe SMK-5.66, крюк до 27 м</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Potain MCH 175 из парка КРАН-КУБАНЬ подходит новому гостиничному корпусу у набережной Приморско-Ахтарска, когда соседние здания с одной-двух сторон сокращают доступный вылет. Курортный сектор города растёт вдоль побережья лимана и моря: базы отдыха и туристическая инфраструктура соседствуют с рыболовецким портом и жилой застройкой. Маховая стрела Potain MCH 175 сокращает вылет наклоном и не нависает над соседней территорией; сравнение этой модели с приставным краном разобрано в статье <a href="/blog/kb-674a-ili-mch-175/">«КБ-674А или Potain MCH 175»</a>.</p>
    <p>Для малоэтажного жилья Приморско-Ахтарска — а в городе с населением 30 084 человека это основная часть застройки — КРАН-КУБАНЬ предлагает giraFFe SMK-5.66: опорный контур 4×4 м без фундамента и монтаж за 4–6 часов силами двух человек. Предел модели — высота дома до 27 м при горизонтальной стреле и до 41,7 м при наклоне 20°, а доставка на 151 км из Краснодара занимает один рейс.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Приморско-Ахтарск стоит в 151 км от Краснодара на равнине с близким залеганием грунтовых вод у самой кромки лимана Азовского моря. Территория округа лежит в пределах Приазово-Кубанской равнины — низменной прибрежной полосы, где несущий слой грунта под кран может залегать глубже привычного для внутренних районов края, а уровень грунтовых вод у берега меняется сильнее, чем на удалённых от воды площадках.</p>
    <p>Основание крана у лимана КРАН-КУБАНЬ рассчитывает только по изысканиям конкретной площадки — для прибрежного участка эти изыскания важнее, чем для типового поля вдалеке от воды. Порядок изысканий перед монтажом крана и то, что проверяют в первую очередь, описаны в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Балл сейсмичности Приморско-Ахтарского округа КРАН-КУБАНЬ одной цифрой не называет: его берут из карт ОСР-2015 под уровень ответственности объекта и уточняют микрорайонированием. Требования к строительству в сейсмических районах края задают ТСН 22-302-2000 и СП 14.13330.2018 — как именно определяют балл для конкретной площадки, показано в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Закон Краснодарского края №608-КЗ действует в Приморско-Ахтарске так же, как в Краснодаре: с 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. В курортный сезон у набережной КРАН-КУБАНЬ соблюдает эти окна особенно строго — рядом с базами отдыха ограничение шума ощутимее, чем на промышленной площадке. Адрес объекта в Приморско-Ахтарском округе можно прислать через <a href="/#order">форму на главной</a>: инженерная служба предложит модель, основание и график доставки. Соседние площадки разобраны в статьях о <a href="/blog/kran-dlya-bryuhoveckogo-rayona/">Брюховецком районе</a> и <a href="/blog/kran-dlya-timashevska/">Тимашевске</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9F%D1%80%D0%B8%D0%BC%D0%BE%D1%80%D1%81%D0%BA%D0%BE-%D0%90%D1%85%D1%82%D0%B0%D1%80%D1%81%D0%BA%D0%B8%D0%B9_%D1%80%D0%B0%D0%B9%D0%BE%D0%BD', label: 'ru.wikipedia.org — Приморско-Ахтарский район: дата образования, площадь, упразднение 19.02.2024, население, соседние районы' },
      { href: 'https://ru.wikipedia.org/wiki/%D0%9F%D1%80%D0%B8%D0%BC%D0%BE%D1%80%D1%81%D0%BA%D0%BE-%D0%90%D1%85%D1%82%D0%B0%D1%80%D1%81%D0%BA', label: 'ru.wikipedia.org — Приморско-Ахтарск: основание 1854 г., статус, расстояние до Краснодара, экономика' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
      { href: 'https://www.kubzsk.ru/', label: 'kubzsk.ru — Законодательное Собрание Краснодарского края: закон №608-КЗ (режим тишины)' },
    ]} />
</BlogArticleLayout>
