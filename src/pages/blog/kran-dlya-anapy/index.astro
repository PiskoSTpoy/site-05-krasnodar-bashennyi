---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 92. Двадцать седьмая статья блога — Анапа, первый разбор
// собственно анапской площадки (город уже упоминался в статье
// «Инженерные изыскания перед монтажом крана» как пример рыхлого
// песчаного грунта побережья, но отдельного разбора у него не было).
//
// Экономический слой: с 2026 года на Бугазской косе у станицы
// Благовещенской (муниципальное образование город-курорт Анапа)
// начинается стройка всесезонного курорта «Новая Анапа» — по открытым
// оценкам, крупнейший туристический инвестпроект страны (сначала
// заявлялся объём 560 млрд рублей, позже уточнён до 461 млрд, из них
// около 309 млрд — средства частных инвесторов). Оператор проекта —
// АО «Корпорация Туризм.РФ» (ИНН 9703023632, ОГРН 1207700484782,
// гендиректор Сергей Суханов), соглашение с губернатором края подписано
// в феврале 2022 года. Строительство первого гостиничного объекта
// начинается во второй половине 2026 года, ввод всего комплекса
// заявлен на 2031 год. Генеральный подрядчик строительных работ в
// открытых источниках на дату проверки не назван — названы только
// проектные организации (ГАУ МО «НИиПИ градостроительства», студия
// «Креативные технологии»), поэтому в статье не указан.
//
// Грунт: Бугазская коса — песчаная намывная коса длиной более 40 км
// между Чёрным морем, Витязевским и Кизилташским лиманами — не общий
// «песок побережья», а частный случай куда более рыхлого и подвижного
// основания, чем городской пляж Анапы, уже описанный в статье про
// изыскания. Отдельная строка Приложения Б ТСН 22-302-2000 для Анапы
// не подтвердилась отдельным запросом (docs.cntd.ru и base.garant.ru
// заблокированы egress сессии, тот же паттерн, что и в предыдущих
// волнах) — балл сейсмики для города в статье не приведён.
//
// Административная деталь сознательно не включена в статью: в мае
// 2024 года статус муниципального образования Анапы изменён с
// городского округа на муниципальный округ — это переименование формы
// местного самоуправления, а не утрата городом населённого пункта или
// курортного статуса, и к монтажу крана отношения не имеет.

const CHECKED = '19 сентября 2026 года';

const title = 'Кран для Анапы: «Новая Анапа» на песчаной косе Благовещенской';
const description = 'Анапа — крупнейший приморский курорт края: строящийся всесезонный курорт «Новая Анапа» на Бугазской косе у станицы Благовещенской и то, что песчаный грунт косы значит для монтажа башенного крана.';
const h1 = 'Кран для Анапы: «Новая Анапа» на песчаной косе Благовещенской';
const crumbTitle = 'Кран для Анапы';
const slug = 'kran-dlya-anapy';

const H2 = [
  'Анапа — курорт, который живёт не только пляжным сезоном',
  '«Новая Анапа»: круглогодичный курорт на косе у Благовещенской',
  'Кто стоит за проектом',
  'Бугазская коса: грунт, которого нет в городской части Анапы',
  'Закон о тишине действует и здесь',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Кран в Анапе нужен только на площадке «Новой Анапы»?',
    a: 'Нет. «Новая Анапа» — самый капиталоёмкий и заметный проект района на сегодня, но обычная застройка курорта — санатории, гостиницы, жильё в самом городе и в станицах округа — формирует спрос на технику независимо от одной стройки на косе.',
  },
  {
    q: 'Чем площадка на Бугазской косе отличается от городского пляжа Анапы, уже описанного в статье про изыскания?',
    a: 'Городской пляж Анапы — рыхлый песок побережья, для которого мы и без отдельного проекта на площадке привозим усиленные опорные подкладки. Бугазская коса — узкая намывная песчаная насыпь длиной более 40 км, зажатая между морем и двумя лиманами: несущая способность грунта там ещё менее предсказуема, и для конкретной площадки на косе изыскания нужны отдельно, без экстраполяции с городского участка.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Кран для Анапы', item: `${SITE}/blog/kran-dlya-anapy/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/kran-dlya-anapy/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/kran-dlya-anapy/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Блог уже упоминал Анапу — в статье об инженерных изысканиях город служил примером рыхлого прибрежного песка, из-за которого выносные опоры автокрана рискуют неравномерно просесть. Но отдельного разбора самой Анапы в блоге не было, а с 2026 года у района появился повод для него: на песчаной косе в 30–40 км от города началась стройка всесезонного курорта «Новая Анапа» — по открытым оценкам, крупнейшего туристического инвестпроекта страны.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Анапа — курортный муниципалитет на Чёрном и Азовском морях одновременно: город стоит на стыке двух побережий, а его округ включает станицы и посёлки на десятки километров вдоль берега. По данным на 2023 год, население округа Анапа — около 203,9 тыс. человек. В отличие от Сочи с его мораторием на точечную многоэтажную застройку или от Геленджика с одним доминирующим инфраструктурным проектом, экономика Анапы держится на массовом пляжном туризме и здравницах — детских лагерях и санаториях, которых в округе больше, чем в любом другом городе черноморского побережья края. До 2026 года это делало Анапу городом сезонного, а не капитального строительства: основной объём работ — реконструкция существующих объектов размещения между заездами отдыхающих, а не стройки с нуля.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Соглашение о создании курорта «Новая Анапа» губернатор края и АО «Корпорация Туризм.РФ» подписали в феврале 2022 года; площадка — узкая песчаная коса, на которой стоит станица Благовещенская, в 25–36 км северо-западнее центра Анапы (источники расходятся в точном километраже, но сходятся в направлении и порядке величины). Проект заявлен как круглогодичный курорт на 3 млн туристов в год: парковая зона на 181,3 га с тематическими локациями и круглогодичным аквацентром, гостевая яхтенная марина на 300 судов, центр ветровых видов спорта, гольф-поле, конгресс-центр и многоуровневая набережная. Число отелей по проекту — более 100, номерной фонд оценивают от 15 до 25 тысяч номеров в зависимости от источника и стадии проектирования. Общий бюджет проекта сначала называли в 560 млрд рублей, позже уточнили до 461 млрд, из которых порядка 309 млрд — деньги частных инвесторов, а не бюджета. Строительство первого гостиничного объекта начинается во второй половине 2026 года, ввод всего комплекса поэтапно растянут до 2031–2034 годов.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Оператор и инициатор проекта — АО «Корпорация Туризм.РФ» (ИНН 9703023632, ОГРН 1207700484782), федеральный институт развития туризма с уставным капиталом 47,33 млрд рублей, гендиректор с момента основания в 2020 году — Сергей Суханов. Архитектурно-градостроительные решения курорта разрабатывали ГАУ Московской области «НИиПИ градостроительства» и студия «Креативные технологии» по итогам открытого всероссийского конкурса. Кто именно выступит генеральным подрядчиком строительных работ на самой площадке, на дату проверки в открытых источниках не назван — для арендодателя техники это означает то же, что и на других крупных проектах блога: конкретный состав исполнителей и график монтажа проясняются по мере того, как на площадку заходят конкретные подрядные организации, а не единой датой старта всего проекта.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Станица Благовещенская стоит на Бугазской косе — песчаной намывной насыпи протяжённостью более 40 км, зажатой между Чёрным морем и двумя лиманами, Витязевским и Кизилташским. Это не тот же рыхлый пляжный песок городской части Анапы, для которого уже принято решение — усиленные опорные подкладки под выносные опоры автокрана, — а более крайний случай: узкая коса, со всех сторон окружённая водой, без плотного материкового основания поблизости. Для капитального строительства такого масштаба, как гостиницы и башни курорта, это означает, что инженерно-геологические изыскания на конкретной площадке косы — не формальность, а условие, без которого расчёт фундамента и самого крана невозможен; экстраполировать данные с городского участка Анапы на косу нельзя, разные основания требуют разных изысканий, как и разбирает статья «Инженерные изыскания перед монтажом крана». Отдельную строку Приложения Б ТСН 22-302-2000 с баллом сейсмичности для Анапы отдельным запросом подтвердить не удалось, поэтому в этой статье она не приведена — та же честная развилка, что и в разборах Ейска, Туапсе или Славянска-на-Кубани.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Закон Краснодарского края №608-КЗ о режиме тишины действует в Анапе так же, как и во всём крае: с 1 марта 2026 года по закону №5423-КЗ рабочие окна для шумных работ — 08:00–13:00 и 15:00–23:00 по будням, с двухчасовым дневным перерывом, а в выходные и праздничные дни утренняя граница сдвинута до 10:00. Санаторный и курортный статус округа здесь ничего не меняет — норма единая для всего края, и она же будет действовать на площадке косы, и на площадке обычного санатория в черте города. Подробный разбор часов и штрафов по статье 3.3 — в статье «Сейсмика и закон о тишине на Кубани».</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Анапа — курортный округ на Чёрном и Азовском морях, население округа — около 203,9 тыс. человек (2023); экономика держится на пляжном туризме и здравницах, а не на промышленности.</li>
      <li>«Новая Анапа» — всесезонный курорт на Бугазской косе у станицы Благовещенской, оператор — АО «Корпорация Туризм.РФ» (ИНН 9703023632), бюджет уточнён до 461 млрд рублей, первый объект — со второй половины 2026 года.</li>
      <li>Генеральный подрядчик строительных работ на площадке на дату проверки в открытых источниках не назван.</li>
      <li>Бугазская коса — намывной песок между морем и двумя лиманами, более рыхлое и менее предсказуемое основание, чем городской пляж Анапы; изыскания нужны отдельно для каждой конкретной площадки.</li>
      <li>Балл сейсмики по Приложению Б ТСН 22-302-2000 для Анапы не подтверждён и в статью не включён.</li>
      <li>Закон №608-КЗ о тишине действует в Анапе так же, как во всём крае.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/Анапа_(муниципальный_округ)', label: 'ru.wikipedia.org — Анапа: население округа, административный статус' },
      { href: 'https://www.expertsouth.ru/news/proekt-novoy-anapy-stal-krupneyshim-investproektom-v-rossiyskom-turizme/', label: 'expertsouth.ru — «Новая Анапа»: крупнейший инвестпроект в туризме, бюджет и сроки' },
      { href: 'https://kuban.rbc.ru/krasnodar/freenews/67e547a79a79476763339343', label: 'kuban.rbc.ru — старт строительства первого объекта «Новой Анапы» в 2026 году' },
      { href: 'https://www.rusprofile.ru/id/1207700484782', label: 'rusprofile.ru — АО «Корпорация Туризм.РФ», ИНН 9703023632: реквизиты, гендиректор' },
      { href: 'https://www.vokrugsveta.ru/news/ryadom-s-anapoi-postroyat-novuyu-anapu-tam-khotyat-prinimat-3-mln-turistov-v-god-11-foto-proekta-id6282143/', label: 'vokrugsveta.ru — расположение курорта у станицы Благовещенской, состав объектов' },
      { href: 'https://ru.wikipedia.org/wiki/Благовещенская_(Краснодарский_край)', label: 'ru.wikipedia.org — станица Благовещенская и Бугазская коса: география' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — закон №5423-КЗ и режим тишины с 01.03.2026' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 (СНКК 22-301-2000) Краснодарского края' },
    ]} />
</BlogArticleLayout>
