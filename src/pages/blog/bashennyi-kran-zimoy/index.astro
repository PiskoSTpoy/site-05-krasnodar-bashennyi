---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 98. Тридцать восьмая статья блога — угол (a) информационный/how-to.
// Парная к «Башенный кран в жару» (Волна 95): та про верх паспортного
// диапазона, эта — про кубанскую зиму, где опасен не мороз, а ледяной дождь
// и гололёд около нуля.
//
// Фактура (WebFetch/WebSearch 27.09.2026):
// - kuban.kp.ru, январь 2026: ледяной дождь 23–25.01.2026, фазу замерзающих
//   осадков отметили 13 метеостанций края; отложения льда — Тимашевск 30 мм,
//   Тихорецк 16 мм, Каневская 13 мм, остальные 1–8 мм; штормовое
//   предупреждение до 27 января.
// - rg.ru, 21.01.2014: ледяной дождь в Краснодаре остановил трамваи и
//   троллейбусы, повалил деревья, обрывы на ЛЭП.
// - ГОСТ 15150-69, исполнение У1: рабочий диапазон −45…+40 °C (уже
//   процитирован в статье про жару, sertrb.ru / docs.cntd.ru).
// Порогов ветра, толщины льда и температур для остановки крана НЕ приводим:
// они в паспорте и инструкции конкретной модели, общего числа нет.
// Закон №608-КЗ — окна из опубликованных страниц сайта (kommersant.ru).

const CHECKED = '27 сентября 2026 года';
const PUBLISHED = '2026-09-27';

const title = 'Башенный кран зимой на Кубани: гололёд и ледяной дождь';
const description = 'Зима на Кубани опасна для башенного крана не морозом, а ледяным дождём: в январе 2026 года в Тимашевске намёрзло 30 мм льда. Как готовить кран и площадку.';
const h1 = 'Башенный кран зимой на Кубани: что делать при гололёде и ледяном дожде';
const crumbTitle = 'Башенный кран зимой';
const slug = 'bashennyi-kran-zimoy';

const H2 = [
  'Кубанская зима: опасен не мороз, а ледяной дождь',
  'Январь 2026 года: 30 мм льда в Тимашевске',
  'Что лёд делает с башенным краном',
  'Как подготовить кран КРАН-КУБАНЬ к зиме',
  'Порядок действий при прогнозе ледяного дождя',
  'Площадка зимой: крановый путь, опоры и проходы',
  'Короткий день и закон о тишине',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Можно ли работать башенным краном при гололёде?',
    a: 'Работа башенного крана при гололёде допустима только в пределах паспорта и инструкции конкретной модели, а решение принимает ответственный за безопасное производство работ. Лёд на стреле и канатах добавляет массу и парусность, обледеневшие лестницы опасны для машиниста. Инженерная служба КРАН-КУБАНЬ после ледяного дождя сначала осматривает кран, и только потом разрешает подъёмы.',
  },
  {
    q: 'При какой температуре нельзя работать башенным краном?',
    a: 'Нижний предел задаёт паспорт крана и его климатическое исполнение. Для исполнения У1 по ГОСТ 15150-69 рабочий диапазон — от −45 до +40 °C, и кубанская зима в него укладывается с большим запасом. Поэтому на Кубани краны КРАН-КУБАНЬ зимой останавливает не температура, а ледяной дождь, гололёд и ветер.',
  },
  {
    q: 'Как часто на Кубани бывает ледяной дождь?',
    a: 'Ледяной дождь на Кубани — не ежегодное, но повторяющееся явление. В январе 2014 года он остановил электротранспорт Краснодара, а 23–25 января 2026 года фазу замерзающих осадков отметили 13 метеостанций края, и в Тимашевске намёрзло 30 мм льда. КРАН-КУБАНЬ учитывает такие эпизоды в зимнем графике работ.',
  },
  {
    q: 'Меняются ли зимой часы работы крана по закону о тишине?',
    a: 'Нет, закон Краснодарского края №608-КЗ не делит год на сезоны: шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Зимой окно для крана КРАН-КУБАНЬ сокращает не закон, а ранняя темнота и освещённость площадки.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Эксплуатация · Погода"
  published={PUBLISHED}
>
    <p slot="intro">Зимой башенный кран на Кубани останавливает не мороз, а ледяной дождь и гололёд: 23–25 января 2026 года фазу замерзающих осадков отметили 13 метеостанций края, а в Тимашевске на поверхностях намёрзло 30 мм льда. Паспортный диапазон крана исполнения У1 по ГОСТ 15150-69 начинается с −45 °C, поэтому температура для кранов КРАН-КУБАНЬ почти никогда не ограничение. Ограничение — лёд на металле, канатах и лестницах, и к нему готовят и кран, и площадку.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Башенный кран КРАН-КУБАНЬ зимой на Кубани чаще всего останавливают переходы температуры через 0 °C, а не мороз. Ледяной дождь идёт, когда капли проходят через холодный приземный слой и замерзают на любой поверхности — на стреле, противовесной консоли, канатах и ступенях мачты. Для крана КРАН-КУБАНЬ такой эпизод опаснее ровного мороза в −15 °C: мороз паспорт допускает, а слой льда меняет нагрузки и делает небезопасным подъём машиниста в кабину.</p>
    <p>Паспорт крана задаёт климатическое исполнение: для исполнения У1 по ГОСТ 15150-69 рабочий диапазон — от −45 до +40 °C. Кубанская зима укладывается в него с запасом, поэтому в зимнем графике КРАН-КУБАНЬ главный риск записан как «замерзающие осадки», а не «низкая температура». Летний край того же диапазона разобран в статье <a href="/blog/bashennyi-kran-v-zharu/">«Башенный кран в жару»</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Ледяной дождь 23–25 января 2026 года — свежий пример того, какой бывает кубанская зима для башенного крана. По сводке, которую опубликовала «Комсомольская правда — Кубань», замерзающие осадки зафиксировали 13 метеостанций края, а штормовое предупреждение действовало до 27 января. Толщина отложений льда распределилась неравномерно:</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Метеостанция</th><th>Отложение льда, январь 2026</th><th>Статья КРАН-КУБАНЬ о районе</th></tr></thead>
      <tbody>
        <tr><td>Тимашевск</td><td>30 мм</td><td><a href="/blog/kran-dlya-timashevska/">Кран для Тимашевска</a></td></tr>
        <tr><td>Тихорецк</td><td>16 мм</td><td><a href="/blog/kran-dlya-tikhoretska/">Кран для Тихорецка</a></td></tr>
        <tr><td>Каневская</td><td>13 мм</td><td><a href="/blog/kran-dlya-kanevskogo-rayona/">Кран для Каневского района</a></td></tr>
        <tr><td>Остальные станции</td><td>1–8 мм</td><td>—</td></tr>
      </tbody>
    </table></div>
    <p>Разброс от 1 до 30 мм показывает, что ледяной дождь на Кубани локален: в Тимашевске слой льда в десять раз толще, чем в соседних точках. Для площадки КРАН-КУБАНЬ это значит, что краевой прогноз — повод насторожиться, но решение об остановке крана принимают по фактическому льду на объекте. Эпизод не уникален: в январе 2014 года, по данным «Российской газеты», ледяной дождь остановил трамваи и троллейбусы Краснодара, повалил более 100 деревьев и оставил без электроэнергии тысячи жителей.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Лёд на стреле Potain MDT 219 J10 или КБ-408.21 добавляет массу, увеличивает площадь под ветер и лишает канаты сцепления. Слой льда по всей длине стрелы Potain MDT 219 J10 с вылетом 65 м или КБ-408.21 с вылетом 40 м — это дополнительная нагрузка, которой нет в таблице грузоподъёмности. Паспорт крана считает груз на крюке, а не лёд на металлоконструкции, поэтому КРАН-КУБАНЬ не поднимает груз, пока кран не очищен и не осмотрен.</p>
    <p>Обледеневшие канаты и барабаны лебёдок хуже держат сцепление, а тормоза и концевые выключатели могут сработать иначе, чем в сухую погоду. Отдельный риск — лестницы и площадки мачты: для машиниста крана КРАН-КУБАНЬ подъём по обледеневшей мачте опаснее самой работы. Сосульки на стреле при повороте и при первом подъёме срываются вниз, поэтому опасная зона под краном после ледяного дождя свободна от людей до осмотра.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Подготовка крана КРАН-КУБАНЬ к зиме начинается осенью, до первых заморозков, и опирается на паспорт конкретной модели. Порядок, который инженерная служба проходит на каждом объекте:</p>
    <ol>
      <li>Сверить климатическое исполнение крана по паспорту и допустимый диапазон температур для работы и для хранения.</li>
      <li>Заменить смазки и рабочие жидкости на зимние, если этого требует инструкция производителя модели.</li>
      <li>Проверить обогрев и утепление кабины, работу стеклоочистителей и освещения кабины.</li>
      <li>Проверить освещение площадки и прожекторы на кране — зимний рабочий день сдвигается в тёмное время.</li>
      <li>Осмотреть лестницы, настилы и ограждения мачты: зимой по ним ходят по льду.</li>
      <li>Согласовать с заказчиком, кто и чем очищает от наледи проходы, крановый путь и места строповки.</li>
    </ol>
    <p>Для giraFFe SMK-5.66 на опорном контуре 4×4 м к этому списку добавляется проверка грунта под четырьмя опорами: оттаивание после мороза меняет несущую способность верхнего слоя. КРАН-КУБАНЬ проверяет положение опор после каждой оттепели.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Штормовое предупреждение о ледяном дожде КРАН-КУБАНЬ отрабатывает заранее, а не по факту льда на стреле. Порядок действий на объекте:</p>
    <ol>
      <li>За сутки — перенести тяжёлые и крупногабаритные подъёмы на дни до или после эпизода.</li>
      <li>Перед уходом со смены — поставить кран в нерабочее положение по инструкции модели: крюк поднят, груз снят, поворотная часть свободна для флюгирования, если конструкция это предусматривает.</li>
      <li>Во время осадков — кран не работает, машинист в кабину не поднимается.</li>
      <li>После эпизода — осмотр металлоконструкций, канатов, тормозов и приборов безопасности; удаление льда с проходов и лестниц.</li>
      <li>Только после осмотра и записи о результате — первый подъём без груза, затем работа.</li>
    </ol>
    <p>Пороги ветра, после которых кран не работает, у каждой модели свои и записаны в паспорте: для Potain MCH 175 и КБ-674А они не совпадают. Зимой ледяной дождь часто идёт вместе с ветром, а на побережье — с норд-остом; порядок действий при сильном ветре КРАН-КУБАНЬ разобрал в статье <a href="/blog/kran-vo-vremya-nord-osta/">«Кран во время норд-оста»</a>.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Крановый путь КБ-408.21 зимой требует такого же внимания, как сам кран: лёд на головке рельса и в зоне тупиковых упоров мешает ходовым тележкам и концевым выключателям. Путь очищают до начала передвижения крана, а его геометрию после оттепели сверяют с актом, потому что основание под шпалами может просесть неравномерно. Требования к пути задают ГОСТ 35321-2025 и СП 12-103-2002, а КРАН-КУБАНЬ проверяет путь после каждого эпизода с замерзанием и оттаиванием.</p>
    <p>Для кранов КРАН-КУБАНЬ на монолитном фундаменте зимний риск смещается на площадку вокруг: проходы к мачте, места складирования и строповки. Стропальщик на льду с грузом на крюке — главная зимняя опасность стройплощадки, и посыпку проходов включают в зимний ППР. Почему основание крана начинается с изысканий, разобрано на этапе <a href="/etapy/izyskaniya-i-grunt/">«Изыскания и грунт»</a>.</p>

    <h2 id={headings[6].id} style="margin:36px 0 16px">{headings[6].text}</h2>
    <p>Закон Краснодарского края №608-КЗ зимой действует так же, как летом. Шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для башенного крана КРАН-КУБАНЬ на жилой площадке это 13 часов в будни, но зимой часть вечернего окна приходится на темноту. Работа крана в тёмное время требует освещения площадки, зоны строповки и места установки груза.</p>
    <p>На практике зимний график КРАН-КУБАНЬ сдвигает сложные подъёмы — монтаж металлоконструкций, панели, крупногабаритное оборудование — на светлую часть дня, а на вечер оставляет подачу бетона и материалов в освещённую зону. Окно 13:00–15:00 зимой удобно для осмотра крана после утренней наледи. Подробный разбор окон — на этапе <a href="/etapy/ekspluatatsiya-i-tishina/">«Эксплуатация и режим тишины»</a>.</p>
    <p>Если объект переходит на зиму, адрес и график работ можно прислать через <a href="/#order">форму на главной</a> — инженерная служба КРАН-КУБАНЬ подскажет, какую модель парка удобнее держать на площадке в сезон ледяных дождей.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.kuban.kp.ru/daily/27753/5201149/', label: 'kuban.kp.ru — ледяной дождь в Краснодарском крае, январь 2026: 13 метеостанций, отложения льда по станциям' },
      { href: 'https://rg.ru/2014/01/21/reg-ufo/led-anons.html', label: 'rg.ru, 21.01.2014 — в Краснодаре ледяной дождь парализовал общественный транспорт' },
      { href: 'https://docs.cntd.ru/document/1200003320', label: 'docs.cntd.ru — ГОСТ 15150-69: исполнения для различных климатических районов' },
      { href: 'https://www.sertrb.ru/laboratory/klimaticheskoe-ispolnenie-temperatury/', label: 'sertrb.ru — рабочие и предельные температуры исполнения У1 по ГОСТ 15150-69' },
      { href: 'https://base.garant.ru/413264615/', label: 'ГОСТ 35321-2025 «Пути рельсовые крановые наземные», действует с 01.01.2026' },
      { href: 'https://files.stroyinf.ru/Data1/11/11357/index.htm', label: 'files.stroyinf.ru — СП 12-103-2002 «Пути наземные рельсовые крановые»' },
      { href: 'https://www.kommersant.ru/doc/8142066', label: 'kommersant.ru — закон о тишине в Краснодарском крае с 1 марта 2026 года' },
    ]} />
</BlogArticleLayout>
