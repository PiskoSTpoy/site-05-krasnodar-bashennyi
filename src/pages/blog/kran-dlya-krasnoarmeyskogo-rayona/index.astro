---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 107. Шестьдесят восьмая статья блога — угол (c) практический/региональный.
// Красноармейский район — западный район края в дельте Кубани, рисоводство и
// переработка зерна; центр — станица Полтавская, 65 км от Краснодара.
//
// Фактура — проверена 07.10.2026 (WebFetch по Википедии):
// - район образован 31.12.1934; площадь 1897,73 км²; население 101 022 чел.
//   (2025, Росстат); муниципальный район из 10 сельских поселений;
// - специализация: рис, а также пшеница, ячмень, подсолнечник, овощи;
//   около 40 предприятий — элеваторы, консервные заводы, хлебопекарни;
// - станица Полтавская: 23 728 чел. (2025), 65 км северо-западнее Краснодара,
//   12 км южнее Славянска-на-Кубани, основана 1794 (черноморские казаки),
//   в 1933 переименована в Красноармейскую, имя возвращено в 1994, окружена
//   рисовыми чеками, ж/д станция на ветке Крымск—Тимашёвск.
// Названий предприятий не называю (источники их не дают). Балл сейсмичности НЕ
// называю (конвенция с Волны 79). Закон о тишине №608-КЗ — ред. с 1 марта 2026.
// Грунтовые условия описываю осторожно: «дельта Кубани, рисовые чеки» — вывод
// «нужны изыскания» не требует конкретных цифр.

const CHECKED = '7 октября 2026 года';
const PUBLISHED = '2026-10-07';

const title = 'Кран для Красноармейского района: башенный кран у Кубани';
const description = 'Полтавская в 65 км от Краснодара: рис, элеваторы, консервные заводы и 101 тыс. жителей района. Какой башенный кран нужен на рисовом и жилом объекте.';
const h1 = 'Кран для Красноармейского района: какой башенный кран нужен в дельте Кубани';
const crumbTitle = 'Кран для Красноармейского района';
const slug = 'kran-dlya-krasnoarmeyskogo-rayona';

const H2 = [
  'Красноармейский район: 1898 км² у Краснодара',
  'Рис и переработка зерна: какой кран нужен на элеваторе',
  'Станица Полтавская: жильё и социальные объекты',
  'Рисовые чеки и основание крана',
  'Балл сейсмичности и закон №608-КЗ',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Сколько километров от Краснодара до станицы Полтавской?',
    a: 'Станица Полтавская, центр Красноармейского района, лежит в 65 км северо-западнее Краснодара и в 12 км южнее Славянска-на-Кубани. Для КРАН-КУБАНЬ это одно из самых коротких плеч доставки на запад края: даже Potain MDT 219 J10 и КБ-408.21 приезжают с краснодарской базы в один день несколькими рейсами.',
  },
  {
    q: 'Чем живёт Красноармейский район?',
    a: 'Район специализируется на рисе и выращивает также пшеницу, ячмень, подсолнечник и овощи. По данным Википедии, в районе около 40 предприятий — элеваторы, консервные заводы и хлебопекарни. Население — 101 022 человека (2025, Росстат) на площади 1 897,73 км². КРАН-КУБАНЬ ориентируется на эти объекты.',
  },
  {
    q: 'Какой башенный кран подходит для зернового элеватора?',
    a: 'Для вертикального корпуса КРАН-КУБАНЬ рассматривает КБ-408.21 с крюком 54,0–72,7 м или приставной КБ-674А, если высота выше. Для длинного складского корпуса подходит Potain MDT 219 J10 с вылетом 65 м. Выбор делают по высоте и длине объекта, а не по виду производства.',
  },
  {
    q: 'Какой балл сейсмичности у Красноармейского района?',
    a: 'Одной цифрой балл не называют: значение берут из карт ОСР-2015 для уровня ответственности объекта и уточняют микрорайонированием площадки. Требования задают ТСН 22-302-2000 и СП 14.13330.2018. КРАН-КУБАНЬ принимает балл из проекта объекта, а не из общей карты района.',
  },
  {
    q: 'Действует ли закон о тишине в Красноармейском районе?',
    a: 'Да, закон Краснодарского края №608-КЗ действует на всей территории края. С 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. В станице Полтавской с населением 23,7 тыс. человек КРАН-КУБАНЬ проверяет расстояние до домов.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Регион · Красноармейский район"
  published={PUBLISHED}
>
    <p slot="intro">Станица Полтавская — центр Красноармейского района площадью 1 897,73 км² — лежит в 65 км северо-западнее Краснодара, а население района достигает 101 022 человек (2025). Рис, элеваторы и консервные заводы определяют облик застройки, поэтому башенный кран КРАН-КУБАНЬ здесь чаще встаёт на производственных корпусах и жилых домах станицы, чем на курортных объектах.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Красноармейский район образован 31 декабря 1934 года и занимает 1 897,73 км² в западной части края. Население по данным Росстата на 2025 год — 101 022 человека, а территория разделена на 10 сельских поселений. Для КРАН-КУБАНЬ главный довод — близость к Краснодару: кран приезжает с базы за один день, и график монтажа не зависит от многодневной доставки.</p>
    <p>Центр района — станица Полтавская, основанная в 1794 году черноморскими казаками, в 12 км южнее Славянска-на-Кубани. Станица стоит на железнодорожной ветке Крымск — Тимашёвск, что упрощает снабжение стройплощадок. Соседние районы с похожим аграрным профилем разобраны в статьях о <a href="/blog/kran-dlya-slavyanska-na-kubani/">Славянске-на-Кубани</a> и <a href="/blog/kran-dlya-timashevska/">Тимашёвске</a>.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Рис — главная культура Красноармейского района, рядом с ним растят пшеницу, ячмень, подсолнечник и овощи. По данным Википедии, в районе работают около 40 предприятий, среди которых элеваторы, консервные заводы и хлебопекарни. Для КРАН-КУБАНЬ из этого следует: основные стройки района — зерновые и складские корпуса, где важны длина фронта и высота силосов, а не этажность жилья.</p>
    <p>Для длинного склада КРАН-КУБАНЬ предлагает Potain MDT 219 J10: вылет 65 м даёт круг диаметром 130 м, и один кран подаёт материалы вдоль всего здания. Для вертикального корпуса подходит КБ-408.21 с крюком 54,0–72,7 м; если нужна высота больше, рассматривают приставной КБ-674А. Сравнение крайних моделей парка — в статье <a href="/blog/potain-mdt-219-j10-ili-giraffe-smk-5-66/">«Potain MDT 219 J10 или giraFFe SMK-5.66»</a>.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Станица Полтавская с населением 23 728 человек (2025) — главная точка жилой и социальной застройки района. Население станицы сократилось с 26 490 человек в 2010 году, и КРАН-КУБАНЬ не закладывает здесь высотную застройку без подтверждённого проекта. Для школ, детских садов и малоэтажных домов подходит giraFFe SMK-5.66: опорный контур 4×4 м, без фундамента, монтаж за 4–6 часов, крюк до 27 м с горизонтальной стрелой.</p>
    <p>Если дом выше 27 м, КРАН-КУБАНЬ переходит к КБ-408.21 или Potain MDT 219 J10. Разницу между быстромонтируемым и классическим краном разбирает статья <a href="/blog/bystromontiruemyi-ili-bashennyi-kran/">«Быстромонтируемый или башенный кран»</a>, а сравнение двух конкретных моделей — статья <a href="/blog/kb-408-21-ili-giraffe-smk-5-66/">«КБ-408.21 или giraFFe SMK-5.66»</a>.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>Станица Полтавская расположена в дельте Кубани, и рисовые чеки подступают к самой застройке, поэтому КРАН-КУБАНЬ не принимает основание «по району» и запрашивает материалы изысканий по конкретному участку. Несущая способность грунта, уровень грунтовых вод и сезонные колебания влияют на выбор между рельсовым путём и монолитным фундаментом. Перечень данных, которые нужны до монтажа, — в статье <a href="/blog/izyskaniya-pered-montazhom-krana/">«Изыскания перед монтажом крана»</a>.</p>
    <p>Для протяжённого склада удобен рельсовый путь вдоль здания, для компактного корпуса — монолитный фундамент под Potain MDT 219 J10 или КБ-408.21. Для giraFFe SMK-5.66 КРАН-КУБАНЬ проверяет грунт под четырьмя опорами контура 4×4 м. Правила выбора основания — в статье <a href="/blog/relsovyi-put-ili-fundament/">«Рельсовый путь или фундамент»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Балл сейсмичности для Красноармейского района КРАН-КУБАНЬ одной цифрой не называет: значение берут из карт общего сейсмического районирования ОСР-2015 для уровня ответственности конкретного объекта и уточняют микрорайонированием площадки. Требования для района задают ТСН 22-302-2000 и СП 14.13330.2018; как определяют балл для площадки, показано в статье <a href="/blog/seysmicheskoe-mikrorayonirovanie/">«Сейсмическое микрорайонирование»</a>.</p>
    <p>Закон Краснодарского края №608-КЗ действует в Красноармейском районе так же, как в Краснодаре: с 1 марта 2026 года шумные работы рядом с жильём разрешены в будни с 08:00 до 13:00 и с 15:00 до 23:00, в выходные — с 10:00. Для станицы Полтавской КРАН-КУБАНЬ проверяет расстояние до жилых домов заранее. Адрес объекта можно прислать через <a href="/#order">форму на главной</a>: инженерная служба предложит модель, основание и график доставки.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://ru.wikipedia.org/wiki/%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%BE%D0%B0%D1%80%D0%BC%D0%B5%D0%B9%D1%81%D0%BA%D0%B8%D0%B9_%D1%80%D0%B0%D0%B9%D0%BE%D0%BD_(%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%BE%D0%B4%D0%B0%D1%80%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B9)', label: 'ru.wikipedia.org — Красноармейский район: дата образования, площадь, население 2025 (Росстат), специализация' },
      { href: 'https://ru.wikipedia.org/wiki/%D0%9F%D0%BE%D0%BB%D1%82%D0%B0%D0%B2%D1%81%D0%BA%D0%B0%D1%8F_(%D1%81%D1%82%D0%B0%D0%BD%D0%B8%D1%86%D0%B0)', label: 'ru.wikipedia.org — станица Полтавская: население 2025, расстояние до Краснодара, история' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края «Строительство в сейсмических районах»' },
      { href: 'https://www.kubzsk.ru/', label: 'kubzsk.ru — Законодательное Собрание Краснодарского края: закон №608-КЗ (режим тишины)' },
    ]} />
</BlogArticleLayout>
