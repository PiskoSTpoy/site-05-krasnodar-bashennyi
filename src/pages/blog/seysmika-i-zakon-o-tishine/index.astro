---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

const CHECKED = '12 августа 2026 года';

const title = 'Сейсмика и закон о тишине на Кубани при монтаже крана';
const description = 'Разбор ТСН 22-302-2000 (сейсмичность Краснодарского края) и закона №608-КЗ о тишине — что это значит для монтажа и работы башенного крана.';
const h1 = 'Сейсмика и закон о тишине на Кубани — что учесть при монтаже крана';
const crumbTitle = 'Сейсмика и закон о тишине';
const slug = 'seysmika-i-zakon-o-tishine';

// Волна 11: единый источник заголовков H2 → id-slug + ToC.
const H2 = [
  'Сейсмичность Краснодарского края',
  'Что это значит конкретно для башенного крана',
  'Закон о тишине Краснодарского края',
  'Почему это особенно чувствительно в курортных зонах',
  'Как мы применяем оба фактора на практике',
  'Коротко: что запомнить',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  { q: 'Значит ли сейсмичность 8-9 баллов, что башенный кран нельзя установить?', a: 'Нет, это значит, что расчёт фундамента и анкеровки должен учитывать сейсмическую нагрузку по требованиям ТСН 22-302-2000, а не что установка невозможна. Это дополнительный инженерный этап, не запрет.' },
  { q: 'Действует ли закон о тишине на выходные и праздники по-другому?', a: 'Да. В будни утренняя граница режима тишины — 08:00, а в выходные и нерабочие праздничные дни она сдвинута до 10:00. Дневной перерыв 13:00-15:00 и ночная граница 23:00 одинаковы для всех дней недели.' },
  { q: 'Что будет, если работать с нарушением закона о тишине?', a: 'Статья 3.3 закона №608-КЗ предусматривает административный штраф: для граждан 1 000-3 000 рублей, для должностных лиц 3 000-5 000 рублей, для юридических лиц 20 000-30 000 рублей; при повторном нарушении суммы выше. Размеры приведены по редакции, действующей с 1 марта 2026 года.' },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: 'Сейсмика и закон о тишине', item: `${SITE}/blog/seysmika-i-zakon-o-tishine/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/seysmika-i-zakon-o-tishine/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path="/blog/seysmika-i-zakon-o-tishine/"
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
>
    <p>Заказчик крана в Краснодарском крае сталкивается с двумя факторами, о которых редко предупреждают заранее: сейсмичность региона, влияющая на инженерный расчёт монтажа, и региональный закон о тишине, определяющий, когда вообще можно работать. Разбираем оба по порядку.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Часть территории края, включая Сочи и прилегающие районы Черноморского побережья, относится к зоне сейсмичностью 8-9 баллов. Сегодня расчётная сейсмичность площадки определяется по картам общего сейсмического районирования ОСР-2015, входящим в СП 14.13330.2018 «Строительство в сейсмических районах» (актуализированная редакция СНиП II-7-81*, приказ Минстроя России от 24.05.2018 №309/пр): карты А, В и С отвечают средним интервалам между землетрясениями расчётной интенсивности в 500, 1000 и 5000 лет, а при отсутствии карт сейсмического микрорайонирования сейсмичность площадки для объектов по карте А принимают по таблице 4.1 этого свода правил. Поверх федерального документа в крае действуют территориальные строительные нормы ТСН 22-302-2000 (СНКК 22-301-2000) «Строительство в сейсмических районах Краснодарского края», введённые постановлением главы администрации края от 04.04.2001 №244.</p>
    <p>Нормы обязательны при проектировании, строительстве, реконструкции, усилении или восстановлении зданий и сооружений на площадках сейсмичностью 7, 8 и 9 баллов. Отдельное требование для районов 8-9 баллов — разделение крупных массивов застройки транспортными магистралями или полосами зелёных насаждений, что относится к градостроительному планированию в целом, не только к монтажу крана.</p>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Башенный кран — это высокое сооружение с собственной массой и центром тяжести, закреплённое на фундаменте на весь срок строительства. Стандартный расчёт устойчивости крана учитывает ветровую нагрузку — это универсальное требование для любого региона. В сейсмоопасной зоне к этому добавляется расчёт сейсмической нагрузки: как фундамент и анкеровка поведут себя при колебаниях грунта, а не только при сильном ветре.</p>
    <p>Практически это означает дополнительный инженерный этап при проектировании монтажа — не отказ от установки крана, а более полный расчёт, учитывающий оба типа нагрузки. Мы уточняем сейсмичность конкретного адреса на этапе заявки, чтобы заложить этот этап в график монтажа заранее, а не обнаруживать необходимость дополнительного расчёта в последний момент.</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Статья 3.3 закона Краснодарского края от 23 июля 2003 года №608-КЗ «Об административных правонарушениях» регулирует время шумных работ — земляных, строительных, погрузочно-разгрузочных и иных работ с применением механических средств. С 1 марта 2026 года она действует в новой редакции: закон края №5423-КЗ расширил режим тишины до 23:00–08:00 и 13:00–15:00 ежедневно, а в выходные и нерабочие праздничные дни добавил к нему промежуток 08:00–10:00.</p>
    <p>Это ощутимая перемена для стройки, а не косметическая правка. Раньше ориентиром служило «с 7:00 до 23:00» — одно непрерывное окно на весь день. Теперь окон два: 08:00–13:00 и 15:00–23:00 в будни, 10:00–13:00 и 15:00–23:00 в выходные. Двухчасовой дневной перерыв рвёт смену пополам, и подрядчик, который приехал в край с прежним расписанием в голове, нарушает норму примерно в обед первого же дня.</p>
    <p>Исключения из ограничений — аварийные и неотложные работы: ликвидация аварий, спасательные мероприятия. Монтаж и повседневная работа крана под эти исключения не подпадают — то есть должны укладываться в разрешённые окна, как любые другие строительные работы. Отдельного, более строгого расписания для Сочи при этом нет: статья одна на весь край, разница между Сочи и, скажем, окраиной Краснодара — не в часах, а в том, насколько быстро нарушение заметят соседи.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>В большинстве регионов сети закон о тишине — общая формальность, редко влияющая на реальное планирование. В курортных зонах Краснодарского края ситуация другая: плотное соседство строительных площадок с отельной и рекреационной инфраструктурой в высокий сезон (примерно май-сентябрь) означает, что нарушение времени работ с высокой вероятностью приведёт к жалобе отдыхающих — а значит, к проверке и штрафу, который для организации начинается от 20 000 рублей. Мы планируем график монтажа с запасом от границ окна, а не впритык к 08:00, 13:00 или 23:00, чтобы обычная получасовая задержка на объекте не превращалась в правонарушение.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>При приёме заявки на объект в крае мы уточняем два параметра: сейсмичность конкретного адреса (по картам районирования) и статус территории с точки зрения курортной чувствительности к шуму (обычный район или курортная зона в высокий сезон). Для первого — закладываем при необходимости дополнительный расчётный этап в проект монтажа. Для второго — согласовываем график работ так, чтобы не создавать риск жалоб и связанных с ними задержек.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <ul>
      <li>Часть края (включая Сочи) — зона сейсмичностью 8-9 баллов; расчётная сейсмичность площадки — по картам ОСР-2015 из СП 14.13330.2018, поверх них действуют ТСН 22-302-2000.</li>
      <li>Для монтажа башенного крана на такой площадке нужен расчёт с учётом сейсмической, а не только ветровой нагрузки.</li>
      <li>С 1 марта 2026 года режим тишины по статье 3.3 закона №608-КЗ (в редакции закона №5423-КЗ) — 23:00–08:00 и 13:00–15:00 ежедневно, в выходные и праздники с 23:00 до 10:00.</li>
      <li>Рабочие окна для крана: 08:00–13:00 и 15:00–23:00 в будни, 10:00–13:00 и 15:00–23:00 в выходные. Отдельного расписания для Сочи нет.</li>
      <li>Монтаж и работа крана не входят в исключения закона о тишине — должны укладываться в эти окна.</li>
      <li>Штраф для юридического лица — 20 000–30 000 рублей; в курортный сезон вероятность жалобы выше, поэтому график планируем с запасом.</li>
    </ul>
    <p>Документальная сторона обоих факторов — что именно оформляется при монтаже башенного крана и как график попадает в бумаги — разобрана в разделе <a href="/documents/" style="color:var(--accent)">«Документы монтажа башенного крана»</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018, карты ОСР-2015 и таблица 4.1' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — разъяснение о законе №5423-КЗ и режиме тишины с 01.03.2026' },
      { href: 'https://gogov.ru/silence-law/krd', label: 'gogov.ru — закон о тишине в Краснодарском крае, 2026' },
    ]} />
</BlogArticleLayout>
