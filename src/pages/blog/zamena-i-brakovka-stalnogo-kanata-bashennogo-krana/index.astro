---
import BlogArticleLayout from '../../../layouts/BlogArticleLayout.astro';
import Sources from '../../../components/Sources.astro';
import { slugify } from '../../../lib/slug';

// Волна 115. Восемьдесят девятая статья блога — угол (a) how-to.
// Замена и браковка стального каната башенного крана.
//
// Фактура — один источник, сырой текст (curl legalacts.ru, проверено 18.10.2026):
// Приказ Ростехнадзора от 26.11.2020 № 461 (ФНП ПС):
// - п. 191: канат при замене — по назначению, длине и диаметру из паспорта,
//   коэффициент использования по разрывному усилию не ниже установленного для группы
//   классификации механизма, сертификат изготовителя; без документов не допускается;
//   зарубежные — если назначение соответствует, диаметр равен заменяемому, коэффициент
//   не ниже; замена крестовой свивки на односторонюю запрещена; после замены и при любой
//   перепасовке — проверка запасовки и крепления концов, обтяжка грузом, равным паспортной
//   номинальной грузоподъёмности, запись в паспорте ИТР, ответственным за содержание ПС
//   в работоспособном состоянии;
// - п. 192: крепление каната — по ранее принятой конструкции;
// - п. 193: расчёт по формуле Fo, Zp, S; Zp — по таблице приложения № 1 (при отсутствии
//   группы классификации в паспорте — по приложению № 4); если в сертификате суммарное
//   разрывное усилие проволок — умножить на 0,83;
// - п. 194: браковка в эксплуатации — по ФНП; п. 270: критерии а)–з) (обрывы проволок,
//   разрыв пряди, износ, коррозия, местное уменьшение диаметра, потеря сечения,
//   деформации, температурные повреждения); уменьшение диаметра на 7 % и более —
//   браковка даже без обрывов; повреждение сердечника — 3 % у некрутящихся, 10 % у остальных.
// НЕ приводится: числа обрывов проволок из таблицы 1 (таблица в сыром тексте не разобрана),
// конкретные диаметры и марки канатов моделей парка (в реестре нет).

const CHECKED = '18 октября 2026 года';
const PUBLISHED = '2026-10-18';

const title = 'Замена каната башенного крана: пункт 191 ФНП и браковка';
const description = 'Что требует ФНП № 461 при замене каната башенного крана: паспорт, сертификат, обтяжка грузом, запись в паспорте. И когда канат бракуют: 7 % по диаметру.';
const h1 = 'Как менять стальной канат башенного крана: требования пунктов 191–194 ФНП';
const crumbTitle = 'Замена и браковка каната башенного крана';
const slug = 'zamena-i-brakovka-stalnogo-kanata-bashennogo-krana';

const H2 = [
  'Какой канат можно ставить: 3 параметра из паспорта',
  'Зарубежный канат и запрет замены свивки',
  'Как проверить запас прочности: формула пункта 193',
  'После замены: запасовка, обтяжка грузом и запись в паспорте',
  '8 критериев браковки каната по пункту 270',
  'Порог 7 % по диаметру и 3 % по сердечнику',
];
const headings = H2.map((t) => ({ id: slugify(t), text: t }));

const faqs = [
  {
    q: 'Какой канат разрешено ставить на башенный кран при замене?',
    a: 'Канат, который соответствует паспорту крана по назначению, длине и диаметру, имеет коэффициент использования не ниже нормы для группы классификации механизма и сертификат изготовителя (п. 191 ФНП № 461). Канат без этих документов к использованию не допускается.',
  },
  {
    q: 'Можно ли ставить импортный канат на башенный кран?',
    a: 'Можно, если он подходит по назначению, имеет диаметр, равный диаметру заменяемого каната, и коэффициент использования не ниже нормы для механизма (п. 191). Условие КРАН-КУБАНЬ сверх ФНП: сертификат должен быть на руках до монтажа, а не после.',
  },
  {
    q: 'Что делать после замены каната?',
    a: 'Проверить правильность запасовки и надёжность крепления концов, затем обтянуть канат грузом, равным паспортной номинальной грузоподъёмности. Запись в паспорте крана делает инженерно-технический работник, ответственный за содержание крана в работоспособном состоянии (п. 191).',
  },
  {
    q: 'При каком износе канат бракуют?',
    a: 'Если диаметр уменьшился на 7 % и более из-за износа или коррозии, канат бракуют даже без видимых обрывов проволок (п. 270). При повреждении сердечника порог — 3 % у некрутящихся канатов и 10 % у остальных. Число обрывов проволок берут из таблицы 1 ФНП.',
  },
  {
    q: 'Можно ли заменить канат крестовой свивки на односторонний?',
    a: 'Нет, пункт 191 ФНП № 461 прямо запрещает такую замену. Тип свивки определяет, как канат ведёт себя на блоках и барабане, поэтому КРАН-КУБАНЬ сверяет его с паспортом крана, а не с наличием на складе.',
  },
];

const SITE = 'https://kran-kuban.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: `${SITE}/blog/${slug}/` },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: h1,
  description,
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
  author: { '@type': 'Organization', name: 'Инженерная служба КРАН-КУБАНЬ', '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntityOfPage: `${SITE}/blog/${slug}/`,
  inLanguage: 'ru-RU',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BlogArticleLayout
  title={title}
  description={description}
  path={`/blog/${slug}/`}
  ldExtra={[breadcrumbLd, articleLd, faqLd]}
  slug={slug}
  h1={h1}
  crumbTitle={crumbTitle}
  headings={headings}
  eyebrow="Нормативы · ФНП № 461"
  published={PUBLISHED}
>
    <p slot="intro">Замена стального каната башенного крана регулируется пунктами 191–194 ФНП № 461: канат должен совпасть с паспортом по назначению, длине и диаметру, иметь сертификат изготовителя и пройти обтяжку грузом номинальной грузоподъёмности. Браковка идёт по пункту 270: износ или коррозия на 7 % диаметра и более — повод снять канат даже без обрывов проволок. КРАН-КУБАНЬ раскладывает эти требования на шаги для заказчика.</p>

    <h2 id={headings[0].id} style="margin:36px 0 16px">{headings[0].text}</h2>
    <p>Пункт 191 ФНП задаёт три параметра нового каната: назначение, длину и диаметр, и все три берутся из паспорта крана, а не из каталога поставщика. К ним добавляются коэффициент использования по разрывному усилию, не ниже нормы для группы классификации механизма, и сертификат предприятия-изготовителя. КРАН-КУБАНЬ принимает канат на площадку только с этим набором документов.</p>
    <p>Норма сформулирована жёстко: стальные канаты без указанных документов к использованию не допускаются. Для заказчика, который арендует кран КБ-408.21 или Potain MDT 219 J10, это значит, что канат подбирает и заказывает инженерная служба, а не прораб по аналогии с «похожим» тросом. Паспортные длины и диаметры по каждой модели хранятся в эксплуатационной документации, и в реестре парка их нет, поэтому статья их не приводит.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Что проверяют</th><th>Источник проверки</th><th>Основание</th></tr></thead>
      <tbody>
        <tr><td>Назначение, длина, диаметр</td><td>Паспорт крана</td><td>П. 191 ФНП</td></tr>
        <tr><td>Коэффициент использования</td><td>Сертификат каната и группа классификации механизма</td><td>Пп. 191, 193</td></tr>
        <tr><td>Происхождение и качество</td><td>Сертификат предприятия-изготовителя</td><td>П. 191</td></tr>
        <tr><td>Конструкция крепления</td><td>Ранее принятое решение на кране</td><td>П. 192</td></tr>
      </tbody>
    </table></div>

    <h2 id={headings[1].id} style="margin:36px 0 16px">{headings[1].text}</h2>
    <p>Зарубежный канат допустим при трёх условиях пункта 191: он подходит по назначению технологии использования крана, его диаметр равен диаметру заменяемого каната, а коэффициент использования не ниже нормы для механизма. Страна изготовления сама по себе не мешает, важны диаметр и разрывное усилие. КРАН-КУБАНЬ добавляет практическое правило: сертификат с переводом получают до монтажа.</p>
    <p>Отдельная строка пункта 191 — запрет заменять канаты крестовой свивки на канаты односторонней свивки. Тип свивки определяет поведение каната на блоках и барабане лебёдки, поэтому для Potain MCH 175 с маховой стрелой или КБ-674А с длинной запасовкой замена «по наличию» недопустима. Крепление каната на кране при замене сохраняют прежним (п. 192).</p>

    <h2 id={headings[2].id} style="margin:36px 0 16px">{headings[2].text}</h2>
    <p>Пункт 193 ФНП требует проверить расчётом, что выбранный канат не слабее нормы, и называет в формуле три величины: Fo — разрывное усилие каната в целом по сертификату, Zp — минимальный коэффициент использования и S — наибольшее натяжение ветви каната из паспорта крана. Смысл расчёта: отношение Fo к S не должно быть меньше Zp. Эта запись — прочтение инженерной службой КРАН-КУБАНЬ, сама формула приведена в тексте ФНП.</p>
    <p>Значение Zp зависит от группы классификации механизма и берётся из приложения № 1 к ФНП; если группы в паспорте нет, её определяют по приложению № 4. Если в сертификате указано суммарное разрывное усилие проволок, а не каната в целом, его умножают на коэффициент 0,83. Для башенного крана КБ-408.21 такой пересчёт — частая причина, по которой «сертификат на канат» и расчёт не сходятся с первой попытки.</p>

    <h2 id={headings[3].id} style="margin:36px 0 16px">{headings[3].text}</h2>
    <p>После замены изношенных грузовых, стреловых или других канатов, а также при любой перепасовке, пункт 191 требует три действия: проверить правильность запасовки, проверить надёжность крепления концов и обтянуть канаты грузом, соответствующим паспортной номинальной грузоподъёмности. Обтяжка грузом означает, что кран с новым канатом сначала работает на полном номинале в контролируемом режиме, а не сразу на подъёме бетона.</p>
    <p>Результат фиксируют записью в паспорте крана. Её делает инженерно-технический работник, ответственный за содержание крана в работоспособном состоянии, и КРАН-КУБАНЬ советует заказчику требовать копию такой записи вместе с актом. Для giraFFe SMK-5.66 с номинальным грузом 5 т обтяжка идёт этим грузом, для Potain MDT 219 J10 — грузом 10 т, как указывает паспорт каждой модели.</p>
    <p>Порядок работ, который КРАН-КУБАНЬ предлагает как рекомендацию, а не как норму ФНП: канат — документы — запасовка — осмотр крепления — обтяжка — запись — допуск к работе. Следующий ежесменный осмотр описан в статье <a href="/blog/ezhesmennyi-osmotr-bashennogo-krana/">«Ежесменный осмотр башенного крана»</a>.</p>

    <h2 id={headings[4].id} style="margin:36px 0 16px">{headings[4].text}</h2>
    <p>Пункт 194 отсылает браковку канатов к ФНП, а пункт 270 перечисляет 8 критериев оценки безопасности: обрывы проволок, разрыв пряди, поверхностный и внутренний износ, поверхностная и внутренняя коррозия, местное уменьшение диаметра, потеря сечения проволок, деформации и повреждения от температуры или дугового разряда. Для башенного крана КРАН-КУБАНЬ сводит эти критерии в таблицу осмотра.</p>
    <div class="table-wrap"><table>
      <thead><tr><th>Критерий пункта 270</th><th>Что искать на канате крана</th></tr></thead>
      <tbody>
        <tr><td>Обрывы проволок</td><td>Число, место, рост от осмотра к осмотру; у концевых заделок отдельно</td></tr>
        <tr><td>Разрыв пряди</td><td>Самостоятельный критерий оценки безопасности каната</td></tr>
        <tr><td>Износ и коррозия</td><td>Поверхностные и внутренние; сравнить диаметр с номинальным</td></tr>
        <tr><td>Деформации</td><td>Волнистость, корзинообразность, заломы, перегибы</td></tr>
        <tr><td>Термическое повреждение</td><td>Следы дуги или нагрева, например от сварки рядом с канатом</td></tr>
      </tbody>
    </table></div>
    <p>Число обрывов проволок, при котором канат бракуют, ФНП даёт в таблице 1 с учётом конструкции каната и числа проволок. КРАН-КУБАНЬ не пересказывает эту таблицу цифрами без привязки к конкретному канату: инженер берёт строку по паспорту каната и сопоставляет с видимыми обрывами на участке осмотра.</p>

    <h2 id={headings[5].id} style="margin:36px 0 16px">{headings[5].text}</h2>
    <p>Если диаметр каната уменьшился на 7 % и более по сравнению с номинальным из-за поверхностного износа или коррозии, пункт 270 требует браковки даже при отсутствии видимых обрывов проволок. Для каната номинального диаметра 20 мм порог составляет 1,4 мм; пример условный, взят для иллюстрации расчёта и не относится к паспорту какого-либо крана парка КРАН-КУБАНЬ.</p>
    <p>Внутренний износ, обмятие или разрыв сердечника считают отдельно: порог 3 % от номинального диаметра у некрутящихся канатов и 10 % у остальных. Для КБ-674А с крюком до 116–120 м при приставной схеме и для Potain MDT 219 J10 тип каната указан в паспорте, и инженерная служба КРАН-КУБАНЬ сначала определяет, некрутящийся он или нет. Диаметр, по рекомендации КРАН-КУБАНЬ, измеряют в нескольких сечениях по длине, а результаты записывают в журнал осмотров.</p>
    <p>Что делать заказчику практически: если инженерная служба КРАН-КУБАНЬ снимает канат по критерию износа, объект получает замену по пунктам 191–193, а не «подтяжку до следующего осмотра». Про техническое освидетельствование, где канаты тоже проверяют, читайте в статье <a href="/blog/tekhnicheskoe-osvidetelstvovanie-bashennogo-krana/">«Техническое освидетельствование башенного крана»</a>, а про грузовые стропы — в <a href="/blog/stropovka-gruzov-bashennym-kranom/">«Строповка грузов башенным краном»</a>. Вопрос по крану можно задать через <a href="/#order">форму на главной</a>.</p>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/', label: 'Приказ Ростехнадзора от 26.11.2020 № 461 — ФНП ПС: пп. 191–194, 270' },
      { href: 'https://kran-kuban.ru/park/', label: 'kran-kuban.ru — парк техники: модели и паспортные характеристики' },
    ]} />
</BlogArticleLayout>
