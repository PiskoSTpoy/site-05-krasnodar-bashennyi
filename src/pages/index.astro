---
import BaseLayout from '../layouts/BaseLayout.astro';
import Smeta from '../components/Smeta.astro';
import HeroCraneArt from '../components/HeroCraneArt.astro';
import DayBand from '../components/DayBand.astro';
import Sources from '../components/Sources.astro';
import { parkModels } from '../data/parkModels';

// Волна 127: три модели паркового реестра, у которых уже есть честно
// атрибутированное фото (Wikimedia Commons) — та же тройка, что перечислена
// в Sources /park/ («фото модели... есть на страницах КБ-408.21, КБ-674А и
// Potain MDT 219 J10 — 3 из 5»). Берём из общего реестра parkModels.ts, а не
// переписываем характеристики руками — единая правда, одна на весь сайт.
const trioSlugs = ['kb-408-21', 'kb-674a', 'potain-mdt-219-j10'];
const parkTrio = trioSlugs
  .map((slug) => parkModels.find((m) => m.slug === slug))
  .filter((m): m is NonNullable<typeof m> => !!m);
const parkTrioPhotos: Record<string, { src: string; w: number; h: number; alt: string }> = {
  'kb-408-21': { src: '/images/park/kb-408-21.jpg', w: 1280, h: 1707, alt: 'КБ-408.21 — фото модели, не единица нашего парка' },
  'kb-674a': { src: '/images/park/kb-674a.jpg', w: 1280, h: 960, alt: 'КБ-674А — фото модели того же семейства, не единица нашего парка' },
  'potain-mdt-219-j10': { src: '/images/park/potain-mdt-219-j10.jpg', w: 1280, h: 853, alt: 'Potain MDT 219 J10 — фото модели производителя, не единица нашего парка' },
};

// Волна 16. Главная перестроена из стопки секций общесетевого архетипа
// (hero по формуле → полосы цифр → услуги → города → шаги 01-04 → FAQ)
// в вертикальный лонгрид по жизненному циклу крана с боковой шкалой этапов.
// Причина простая и содержательная: башенный кран не заказывают «на смену»,
// его ставят на объект на месяцы, и все решения принимаются на стадии проекта.
// Четырёхшаговая цепочка «заявка → расчёт → работа → документы» описывала
// не эту услугу, а разовый выезд техники.

const title = 'Башенный кран на Кубани — от изысканий до демонтажа';
const description =
  'Проектное досье башенного крана в Краснодарском крае: изыскания, ППР, монтаж и анкеровка, работа в окнах режима тишины №608-КЗ, демонтаж и смета владения.';
const SITE = 'https://kran-kuban.ru';
const CHECKED = '12 августа 2026 года';

const stages = [
  { id: 'izyskaniya', num: 'Этап 1', name: 'Изыскания и грунт', href: '/etapy/izyskaniya-i-grunt/' },
  { id: 'proekt', num: 'Этап 2', name: 'Проект и ППР', href: '/etapy/proekt-i-ppr/' },
  { id: 'montazh', num: 'Этап 3', name: 'Монтаж и анкеровка', href: '/etapy/montazh-i-ankerovka/' },
  { id: 'ekspluatatsiya', num: 'Этап 4', name: 'Эксплуатация и тишина', href: '/etapy/ekspluatatsiya-i-tishina/' },
  { id: 'demontazh', num: 'Этап 5', name: 'Демонтаж и перебазировка', href: '/etapy/demontazh-i-perebazirovka/' },
];
const railExtra = [
  { id: 'park', name: 'Три модели из разбора' },
  { id: 'smeta', name: 'Смета владения' },
  { id: 'faq', name: 'Частые вопросы' },
  { id: 'order', name: 'Заявка' },
];

// Волна 19. Плашка «дело» — три проверяемых факта, без выдуманного масштаба
// бизнеса (оборотов, числа объектов, штата). Число нормативов сосчитано по
// самой странице: СП 14.13330.2018, ТСН 22-302-2000, ФНП №461, ГОСТ 35321-2025,
// закон №608-КЗ (в ред. №5423-КЗ), СП 12-103-2002, РД 22-28-35-99, приказ о
// предмете охраны исторического поселения Краснодар — 8 документов. РД 11-06-2007
// в счёт не идёт: страница прямо называет его недействующим, а не основой разбора.
const dossierFacts = [
  { label: 'Закон о тишине №608-КЗ', value: 'в силе с 01.03.2026', note: 'редакция закона края №5423-КЗ' },
  { label: 'Этапов в деле', value: String(stages.length), note: 'изыскания → проект → монтаж → эксплуатация → демонтаж' },
  { label: 'Нормативных документов', value: '8', note: 'СП, ТСН, ФНП, ГОСТ, РД и закон края — со ссылками внизу' },
];

const faqs = [
  {
    q: 'Что определяет стоимость месяца башенного крана, кроме месячной ставки?',
    a: 'Разовые расходы: доставка секций, монтаж, устройство и приёмка кранового пути, демонтаж и обратная перебазировка. Они не повторяются каждый месяц, но делятся на срок аренды — и чем короче срок, тем сильнее поднимают фактическую стоимость месяца. Поэтому два предложения с одинаковой ставкой за месяц могут отличаться по итогу в полтора раза. В смете на этой странице разовые строки считаются отдельно, а внизу выводится стоимость одного месяца владения.',
  },
  {
    q: 'Чем расчётная сейсмичность площадки отличается от сейсмичности города?',
    a: 'Карты ОСР-2015 из СП 14.13330.2018 дают балл для средних грунтовых условий, то есть для грунтов II категории по сейсмическим свойствам. Реальная площадка может отличаться: рыхлые пески и мягкие глинистые грунты относятся к III категории, наиболее неустойчивые к разжижению — к IV. Точное значение для участка даёт карта сейсмического микрорайонирования или отчёт по инженерным изысканиям, а не средний балл по населённому пункту.',
  },
  {
    q: 'Почему график монтажа из другого региона на Кубани не работает?',
    a: 'Его зажимают два независимых региональных ограничения. Шумные работы разрешены только в окнах 08:00–13:00 и 15:00–23:00 в будни (с 10:00 в выходные и нерабочие праздничные дни) — это статья 3.3 закона края №608-КЗ в редакции с 1 марта 2026 года. А с 20 мая по 31 августа при дневной температуре выше +32 °C движение тяжеловесного транспорта по дорогам регионального и межмуниципального значения края закрыто с 10:00 до 22:00. Летом трал с секциями крана едет ночью, а разгружать и монтировать его можно только с восьми утра.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// ItemList описывает ровно то, что видит пользователь: пять этапов в том же
// порядке, с адресами страниц. Ни рейтингов, ни отзывов, ни дат «выполнения».
const stagesLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Этапы жизненного цикла башенного крана на объекте',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: stages.length,
  itemListElement: stages.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: SITE + s.href,
  })),
};

// Услуга и её цена. Ровно те же две цифры, что видны в блоке «Смета владения»
// («Ставки — ориентир „от“: 240 000 ₽/мес за башенный кран и 4 000 ₽/час за
// автокран при восьмичасовой смене»), и с той же оговоркой: это минимум, а не
// оферта, поэтому цена размечена как minPrice, а не как price.
//
// businessFunction обязателен и стоит явно. Значение по умолчанию у Offer —
// Sell, то есть без этой строки разметка объявляла бы, что мы ПРОДАЁМ
// башенный кран за 240 000 ₽. Здесь два разных случая, и они размечены
// по-разному, а не одинаково:
//   · башенный кран — LeaseOut: техника заезжает на объект на месяцы и всё
//     это время находится у заказчика, это именно аренда;
//   · автокран посменно — ProvideService: машина приезжает с крановщиком на
//     смену и уезжает, заказчику она не передаётся, это работа с оператором.
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': SITE + '/#usluga-bashennyy-kran',
  name: 'Аренда башенного крана в Краснодарском крае',
  serviceType: 'Аренда башенного крана: изыскания, ППР, монтаж, эксплуатация, демонтаж',
  provider: { '@id': SITE + '/#organization' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Краснодарский край' },
  offers: [
    {
      '@type': 'Offer',
      name: 'Башенный кран, помесячная аренда',
      businessFunction: 'https://schema.org/LeaseOut',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'RUB',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        minPrice: 240000,
        priceCurrency: 'RUB',
        unitText: 'месяц',
        unitCode: 'MON',
      },
    },
    {
      '@type': 'Offer',
      name: 'Автокран со сменой оператора, посменно',
      businessFunction: 'https://schema.org/ProvideService',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'RUB',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        minPrice: 4000,
        priceCurrency: 'RUB',
        unitText: 'час',
        unitCode: 'HUR',
      },
    },
  ],
};
---
<BaseLayout title={title} description={description} path="/" ldExtra={[stagesLd, faqLd, serviceLd]}>
<main>
  <header class="dossier wrap">
    <!-- Волна 127: фоновое видео hero (video autoplay/muted/loop/playsinline/
         preload=none/poster/aria-hidden/tabindex=-1 + затемняющий scrim),
         встроенное в редакционный код страницы: не панель позади заголовка, а
         отдельная «обложка досье» — рамочная фотополоса НАД двухколоночным
         блоком текста, той же рамочной эстетики, что .model-photo/.park-atmo
         (1px solid var(--ink), без теней/скруглений). Заголовок и лид остаются
         на обычном бумажном фоне без текста поверх видео — редакционная
         сдержанность вместо эффектного full-bleed за текстом. Постер лежит
         CSS-фоном контейнера ПОД видео всегда — это и есть prefers-reduced-motion
         фоллбэк без единой строки JS (см. .dossier__reel-video ниже). Источник
         видео — в блоке Sources внизу страницы.

         Постер у <video> — .webp, а НЕ .jpg, и это не косметика. CSS-фон ниже
         отдаёт через image-set тот же кадр в webp; пока в poster стоял jpg,
         браузер тянул на первый экран ОБА файла — webp для фона и jpg для
         постера, 42 + 76 КБ вместо 42 (проверено в сетевой панели). Атрибут
         poster принимает ровно один URL, фоллбэка внутри себя не имеет, но он
         здесь и не нужен: у браузера без webp постер просто не загрузится, а
         под ним останется тот же кадр из image-set, у которого jpg-фоллбэк
         есть. Поэтому .jpg из public/images/hero НЕ удалён. -->

    <div class="dossier__reel">
      <div class="dossier__reel-media" aria-hidden="true">
        <video
          class="dossier__reel-video"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster="/images/hero/hero-tower-poster.webp"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src="/videos/hero-tower.mp4" type="video/mp4" />
        </video>
        <div class="dossier__reel-scrim"></div>
      </div>
      <p class="dossier__reel-tag">Иллюстративная съёмка · не наш объект и не наша техника</p>
    </div>

    <div class="dossier__inner">
      <div class="dossier__col">
        <span class="eyebrow">Проектное досье · Краснодарский край</span>
        <h1>Башенный кран на Кубани: пять этапов от изысканий до демонтажа</h1>

        <!-- Волна мобильной полировки: строка ставки. Раньше первое число в
             рублях появлялось на главной только в 7 067 px от верха (штраф за
             шум в этапе 4), а сама ставка — ещё ниже, в смете: на телефоне это
             девятый экран. Человек с телефона в руке уходил, не увидев цены.
             Здесь стоят ровно те две цифры, что уже опубликованы в смете
             (RATE_TOWER и RATE_AUTO компонента Smeta), с той же оговоркой из
             .smeta__disclaimer — ориентир «от», не оферта. Ни новых чисел, ни
             «скидок»: строка ссылается на смету, а не заменяет её.
             Набор — редакционный код сайта: тяжёлая линейка сверху (как у
             .dossier__meta и таблиц), рубрика прописными, число антиквой
             Prata табличными цифрами. Ни теней, ни скруглений. -->
        <div class="dossier__rate">
          <dl class="dossier__rate-rows">
            <div>
              <dt>Башенный кран</dt>
              <dd><b>от 240 000 ₽</b> <span>в месяц</span></dd>
            </div>
            <div>
              <dt>Автокран</dt>
              <dd><b>от 4 000 ₽</b> <span>в час, смена 8 часов</span></dd>
            </div>
          </dl>
          <p class="dossier__rate-note">
            Ориентир «от» с <time datetime="2026-08-12">12 августа 2026 года</time>, не публичная
            оферта: точная цифра зависит от модели, вылета, высоты подъёма и площадки.
            <a href="#smeta">Собрать смету владения <span aria-hidden="true">→</span></a>
          </p>
        </div>

        <p class="dossier__lead">
          Башенный кран не заказывают на смену: он приезжает на объект на месяцы и проходит 5 этапов.
        </p>
        <!-- Остаток лида не удалён, а перенесён: на телефоне он встаёт ниже
             штампа дела (см. порядок в @media ≤560px), на широком экране
             продолжает тот же абзац-лид без единого видимого изменения.
             Перечень пяти этапов ушёл сюда из первой фразы: он стоит на этой
             же странице ещё дважды — в штампе дела («изыскания → проект →
             монтаж → эксплуатация → демонтаж») и в шкале этапов, — а на 375 px
             растягивал лид с четырёх строк до семи. Слова не тронуты, вместо
             тире после «5 этапов» стоит точка. -->
        <!-- Волна мобильного взгляда. Остаток лида был ОДНИМ абзацем в 14 строк
             (420 px замером на 375) — на кадре третий экран телефона выглядел
             сплошной стеной набора, и это ровно тот дефект, ради которого лид
             и делили. Здесь он разрезан по СУЩЕСТВУЮЩЕЙ границе предложений
             на два абзаца: первый — про этапы и режим тишины, второй — про
             устройство сайта. Ни одного слова, ни одного знака препинания не
             изменено, только точка перестала быть серединой абзаца. -->
        <p class="dossier__lead dossier__lead--rest">
          Изыскания и грунт, проект и ППР, монтаж и анкеровка, эксплуатация, демонтаж и перебазировка.
          Рабочий день на Кубани при этом разрезан режимом тишины на два окна, 08:00–13:00 и
          15:00–23:00, поэтому планируют здесь не смены, а длину непрерывной операции.
        </p>
        <p class="dossier__lead dossier__lead--rest">
          Этот сайт устроен как досье по этапам, а не как витрина услуг: ниже — что происходит на
          каждом этапе, чем это установлено и что от этого меняется у заказчика.
        </p>
        <dl class="dossier__meta">
          <div>
            <dt>Техника</dt>
            <dd>Башенный кран на весь срок стройки; автокран — на монтаж и демонтаж его секций</dd>
          </div>
          <div>
            <dt>Единица планирования</dt>
            <dd>Месяц аренды и рабочее окно, а не смена: непрерывная операция обязана поместиться в окно</dd>
          </div>
          <div>
            <dt>Нормы в работе</dt>
            <dd>СП 14.13330.2018 (карты ОСР-2015) · ТСН 22-302-2000 · ФНП №461 · ГОСТ 35321-2025 · закон края №608-КЗ</dd>
          </div>
          <div>
            <dt>Фактура проверена</dt>
            <dd>{CHECKED} — ссылки на источники в конце страницы</dd>
          </div>
        </dl>
      </div>

      <div class="dossier__art">
        <!-- Волна 19: штамп дела — не декорация, обычный читаемый текст,
             три факта, которые можно проверить по ссылкам внизу страницы. -->
        <div class="dossier__stamp">
          <p class="dossier__stamp-label">Карточка дела</p>
          <dl class="dossier__stamp-facts">
            {dossierFacts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
                <span class="dossier__stamp-note">{f.note}</span>
              </div>
            ))}
          </dl>
        </div>

        <div class="dossier__illustration" data-hero-parallax>
          <HeroCraneArt />
        </div>
      </div>
    </div>
  </header>

  <div class="spine wrap">
    <nav class="spine__rail" aria-label="Этапы на этой странице">
      <div class="rail__sticky">
        <p class="rail__title">Жизненный цикл крана</p>
        <ol class="rail__list">
          {stages.map((s, i) => (
            <li><b>{String(i + 1).padStart(2, '0')}</b><a href={`#${s.id}`} data-rail-link={s.id}>{s.name}</a></li>
          ))}
          {railExtra.map((s) => (
            <li><b>·</b><a href={`#${s.id}`} data-rail-link={s.id}>{s.name}</a></li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="spine__body">
      <details class="rail-mobile">
        <summary>Этапы на этой странице <span aria-hidden="true">{stages.length + railExtra.length}</span></summary>
        <nav aria-label="Этапы на этой странице (мобильная навигация)">
          <ol class="rail__list">
            {stages.map((s, i) => (
              <li><b>{String(i + 1).padStart(2, '0')}</b><a href={`#${s.id}`}>{s.name}</a></li>
            ))}
            {railExtra.map((s) => (
              <li><b>·</b><a href={`#${s.id}`}>{s.name}</a></li>
            ))}
          </ol>
        </nav>
      </details>

      <section class="stage" id="izyskaniya">
        <span class="stage__num">Этап 1 · до договора</span>
        <h2>Изыскания и грунт: что на самом деле стоит под краном</h2>
        <p class="stage__lead">
          Первое решение по крану принимается не по грузоподъёмности, а по основанию. Башенный кран
          опирается на капитальный фундамент или рельсовый крановый путь и стоит на них месяцами —
          значит, характеристики грунта нужны до того, как подписан договор, а не после выезда техники.
        </p>
        <div class="prose">
          <p>
            Карты общего сейсмического районирования ОСР-2015 в составе СП 14.13330.2018 дают балл
            для средних грунтовых условий — грунтов II категории по сейсмическим свойствам. Реальная
            площадка сдвигает эту оценку: рыхлые пески и мягкие глинистые грунты относятся к III
            категории, склонные к разжижению разновидности — к IV. На кубанском побережье это не
            теория: прибрежный песок Анапы — типичный представитель «неудобной» категории, и площадка
            там может оказаться тяжелее, чем средний балл по городу.
          </p>
          <p>
            У автокрана капитального основания нет вовсе — он опирается на выносные опоры через
            инвентарные подкладки, и его вопрос не сейсмика, а несущая способность грунта здесь и
            сейчас. Это два разных вопроса, а не выбор из двух проверок: сейсмический расчёт не
            спасёт опору, проседающую в песок, а подкладки не заменят расчёт фундамента.
          </p>
        </div>
        <p style="margin-top:22px"><a href="/etapy/izyskaniya-i-grunt/" class="stage__more">Этап целиком: категории грунта, микрорайонирование, песок и ООПТ Анапы <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="stage" id="proekt">
        <span class="stage__num">Этап 2 · за недели до техники</span>
        <h2>Проект и ППР: почему кран нельзя заказать «на послезавтра»</h2>
        <p class="stage__lead">
          Работа грузоподъёмной техники ведётся по проекту производства работ. Ограничение по сроку
          заказа упирается не в занятость крана, а в этот документ и в приёмку основания.
        </p>
        <div class="prose">
          <p>
            Раздел VI ФНП №461 задаёт два требования, которые стоит знать заказчику наизусть:
            ППР и технологические карты утверждает эксплуатирующая кран организация и выдаёт их на
            участок до начала работ (п. 157), а ответственные работники, крановщик и стропальщики
            знакомятся с ними под подпись до первого подъёма (п. 158). Именно сбор этих подписей, а
            не занятость техники, съедает первые дни срока. Формулировки «утверждает генподрядчик» и
            «за 5 дней», которые встречаются на отраслевых сайтах, происходят из методических
            рекомендаций РД-11-06-2007 — они не применяются с 1 января 2021 года.
          </p>
          <p>
            На этом же этапе решается сам тип техники, и решает его чаще всего градостроительный
            статус участка, а не пожелание заказчика. Краснодар с июля 2015 года включён в перечень
            исторических поселений регионального значения, а предмет охраны, границы территории и
            требования к градостроительным регламентам утверждены приказом краевой администрации,
            действующим с 1 марта 2019 года: предельные высоты внутри границ задаются регламентом по
            зонам и правилами землепользования и застройки. Там, где высота ограничена, полный цикл
            башенного крана экономически не собирается — работа уходит к сменам автокрана.
          </p>
        </div>
        <p style="margin-top:22px"><a href="/etapy/proekt-i-ppr/" class="stage__more">Этап целиком: состав решений в ППР, зоны ограничения, что просим у заказчика <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="stage" id="montazh">
        <span class="stage__num">Этап 3 · дни, а не часы</span>
        <h2>Монтаж и анкеровка: приёмка основания до первого подъёма</h2>
        <p class="stage__lead">
          Монтаж башенного крана — не выгрузка техники, а сборка сооружения на площадке, у которой
          есть собственная приёмка и собственный расчёт.
        </p>
        <div class="prose">
          <p>
            Наземные рельсовые крановые пути проектируют, устраивают и эксплуатируют по СП 12-103-2002,
            а готовый путь принимают в эксплуатацию актом сдачи-приёмки по рекомендуемой форме
            РД 22-28-35-99. До подписания этого акта кран по пути не ездит, каким бы плотным ни
            выглядел балласт.
          </p>
          <p>
            Для площадки в сейсмической зоне к расчёту основания добавляется сейсмическая нагрузка —
            рядом с ветровой, а не вместо неё. Масштаб добавки задаёт балл: пиковое ускорение
            составляет 0,1g при 7 баллах, 0,2g при 8 и 0,4g при 9 на средних грунтах. То есть каждый
            дополнительный балл удваивает расчётное воздействие, и разница между «восемь» и «девять» —
            это не единица в документе, а вдвое большая горизонтальная нагрузка на анкеровку и фундамент.
          </p>
        </div>
        <p style="margin-top:22px"><a href="/etapy/montazh-i-ankerovka/" class="stage__more">Этап целиком: крановый путь, акт приёмки, сейсмический расчёт, роль автокрана <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="stage" id="ekspluatatsiya">
        <span class="stage__num">Этап 4 · месяцы</span>
        <h2>Эксплуатация: рабочий день, разрезанный законом и ветром</h2>
        <p class="stage__lead">
          Самый длинный этап и единственный, где кубанская специфика видна ежедневно: день на объекте
          состоит не из смены, а из двух окон, а на побережье из графика ещё вычитается ветер.
        </p>
        <div class="prose">
          <p>
            С 1 марта 2026 года статья 3.3 закона Краснодарского края №608-КЗ действует в редакции
            закона края №5423-КЗ: режим тишины охватывает 23:00–08:00 и 13:00–15:00 ежедневно, а в
            выходные и нерабочие праздничные дни дополнительно 08:00–10:00. Земляные, строительные и
            погрузочно-разгрузочные работы с применением механических средств названы в статье прямо.
            Рабочие окна для крана получаются 08:00–13:00 и 15:00–23:00 в будни; штраф для
            юридического лица — от 20 000 до 30 000 рублей.
          </p>
          <p>
            Второй вычет — ветер. Боры Новороссийской бухты дуют свыше 40 дней в году, один эпизод
            длится от суток до недели. Это не редкое исключение, а строка в графике: дни вынужденного
            простоя закладывают в срок монтажа заранее и отдельно, а не объясняют задним числом.
          </p>
        </div>
        <!-- Волна мобильного взгляда. На кадрах 375×812 главная от третьего
             экрана до двенадцатого шла СПЛОШНЫМ НАБОРОМ: замер между последней
             картинкой шапки (линейный кран, y≈1 640) и первой фотографией
             модели (y≈9 290) дал 7 649 px — девять экранов телефона подряд без
             единого изображения. Читать столько антиквы с телефона никто не
             станет, и до сметы человек не доходит.
             Полоса суток ставится ровно сюда, потому что абзац над ней уже
             назвал оба окна словами: «Рабочие окна для крана получаются
             08:00–13:00 и 15:00–23:00 в будни». Компонент DayBand — свой,
             сайта, он уже рисует эти же сутки на /etapy/ekspluatatsiya-i-tishina/;
             новых чисел здесь нет ни одного, а выходные 10:00–13:00 следуют
             из того же абзаца («в выходные и нерабочие праздничные дни
             дополнительно 08:00–10:00» тишины). Это единственная картинка на
             всём протяжении лонгрида — и показывает она ровно то, чем эта
             область отличается от любой другой. -->
        <DayBand
          rows={[
            { label: 'Будни, пн–пт', allowed: [{ from: 8, to: 13 }, { from: 15, to: 23 }] },
            { label: 'Выходные и праздники', allowed: [{ from: 10, to: 13 }, { from: 15, to: 23 }] },
          ]}
          caption="Терракотовым отмечены часы, когда шумные работы разрешены."
        />
        <p style="margin-top:22px"><a href="/etapy/ekspluatatsiya-i-tishina/" class="stage__more">Этап целиком: длина операции против длины окна, норд-ост, курортный сезон <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="stage" id="demontazh">
        <span class="stage__num">Этап 5 · выход с объекта</span>
        <h2>Демонтаж и перебазировка: ограничение, о котором вспоминают в июле</h2>
        <p class="stage__lead">
          Выход крана с объекта — такая же шумная работа в тех же окнах, плюс собственное дорожное
          ограничение, действующее ровно в разгар курортного сезона.
        </p>
        <div class="prose">
          <p>
            С 20 мая по 31 августа при дневной температуре воздуха выше +32 °C движение тяжеловесного
            транспорта по дорогам регионального и межмуниципального значения Краснодарского края
            закрыто с 10:00 до 22:00 — асфальт в жару не держит нагрузку. Трал с секциями крана в это
            время едет ночью. А выгружать и разбирать привезённое можно только с 08:00, когда
            заканчивается ночной режим тишины. Два ограничения смотрят в разные стороны и вместе
            сжимают окно мобилизации и демобилизации сильнее, чем каждое по отдельности.
          </p>
        </div>
        <p style="margin-top:22px"><a href="/etapy/demontazh-i-perebazirovka/" class="stage__more">Этап целиком: порядок демонтажа, летнее окно перевозки, закрывающие документы <span aria-hidden="true">→</span></a></p>
      </section>

      <!-- .stage--part: здесь кончается повествование по этапам и начинается
           справочный аппарат досье. Двойная линейка и вдвое больший воздух —
           граница ЧАСТИ, а не очередной секции; см. .stage--part в BaseLayout. -->
      <section class="stage stage--part" id="park">
        <span class="stage__num">Из этого разбора</span>
        <h2>Три модели, о которых шла речь выше</h2>
        <p class="stage__lead">
          Не абстрактные примеры: рельсовый КБ-408.21 набирает высоту секциями мачты — вопрос
          этапа «Монтаж и анкеровка»; приставной КБ-674А берёт высоту не у грунта, а у самого
          здания — вопрос «Проекта и ППР»; топлесс Potain MDT 219 J10 отвечает на высотный
          регламент исторического центра, разобранный там же.
        </p>
        <div class="park-trio">
          {parkTrio.map((m) => {
            const photo = parkTrioPhotos[m.slug];
            return (
              <a class="card-reg park-trio__card" href={m.href}>
                <span class="park-trio__photo">
                  {/* WebP рядом с оригиналом: <source> отдаёт .webp тем, кто его
                      понимает, остальным достаётся прежний JPEG из <img>.
                      width/height/alt остаются на <img> — иначе теряется
                      соотношение сторон (CLS) и подпись для скринридера.
                      Файлы .webp собирает scripts/to-webp.mjs. */}
                  <picture>
                    <source type="image/webp" srcset={photo.src.replace('.jpg', '.webp')} />
                    <img
                      src={photo.src}
                      width={photo.w}
                      height={photo.h}
                      loading="lazy"
                      decoding="async"
                      alt={photo.alt}
                    />
                  </picture>
                </span>
                <span class="park-trio__body">
                  <span class="park-trio__type">{m.type}</span>
                  <span class="park-trio__name">{m.short}</span>
                  <span class="park-trio__note">{m.hookHeight} под крюком · {m.mount}</span>
                </span>
              </a>
            );
          })}
        </div>
        <p style="margin-top:20px"><a href="/park/" class="stage__more">Все пять моделей и место автокрана <span aria-hidden="true">→</span></a></p>
      </section>

      <Smeta />

      <section class="stage stage--part" id="faq">
        <span class="stage__num">Вопросы</span>
        <h2>Три вопроса, которые задают до подписания</h2>
        <div class="faq" style="margin-top:20px;max-width:72ch">
          {faqs.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:18px;font-size:var(--t-aux);color:var(--muted)">
          Остальные кубанские вопросы — сейсмичность участка, штрафы, сроки по документам —
          на странице <a href="/faq/" style="color:var(--accent)">«Вопросы»</a>.
        </p>
      </section>

      <section class="stage stage--part" id="order">
        <span class="stage__num">Заявка</span>
        <h2 id="order-title">Назовите площадку — посчитаем этапы под неё</h2>
        <p class="stage__lead">
          Для расчёта нам нужны три вещи: адрес или район площадки, планируемая высота объекта и срок
          строительства. По ним видно, какой из этапов окажется самым длинным именно у вас.
        </p>
        <!-- Форма получила имя (aria-labelledby), autocomplete-подсказки (WCAG 1.3.5),
             видимую подпись про обязательное поле (3.3.2), собственную русскую ошибку
             вместо браузерного «пузыря» (3.3.1/3.3.3) и статус-область вместо alert() (4.1.3). -->
        <!-- Подписи полей ВИДИМЫЕ, а не только для скринридера. Раньше подпись
             существовала лишь в sr-only, а зрячий пользователь ориентировался по
             placeholder — то есть подпись исчезала ровно в тот момент, когда
             начинал печатать, и заполненная форма превращалась в три безымянных
             прямоугольника. Это классический дефект, а не мелочь: в локальной
             базе UX-правил «Placeholder-only inputs» помечено severity High.
             Ни одного нового слова не придумано: видимые подписи — это дословно
             прежние строки placeholder, а прежняя формулировка для скринридера
             («, обязательное поле») сохранена рядом в sr-only. -->
        <form class="order-form" aria-labelledby="order-title" novalidate>
          <p class="order-form__hint" id="order-form-hint">Звёздочкой отмечено обязательное поле.</p>
          <div class="order-form__field">
            <label for="order-name">Ваше имя / компания</label>
            <input type="text" name="name" id="order-name" autocomplete="name" />
          </div>
          <div class="order-form__field">
            <label for="order-phone">Телефон <span aria-hidden="true">*</span><span class="sr-only">, обязательное поле</span></label>
            <input
              type="tel"
              name="phone"
              id="order-phone"
              autocomplete="tel"
              inputmode="tel"
              required
              aria-describedby="order-form-hint order-phone-error"
            />
          </div>
          <p class="order-form__error" id="order-phone-error" role="alert" hidden></p>
          <div class="order-form__field">
            <label for="order-object">Площадка: адрес или район</label>
            <input type="text" name="object" id="order-object" autocomplete="off" />
          </div>
          <!-- Honeypot от ботов: реальным пользователям поле не видно и недоступно
               ни с клавиатуры, ни через скринридер. Человек его никогда не заполнит. -->
          <label class="sr-only" for="order-website" aria-hidden="true">Не заполняйте это поле</label>
          <input
            type="text"
            name="website"
            id="order-website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="order-form__hp"
          />
          <!-- Согласие на обработку ПД. Чекбокс НЕ предзаполнен и обязателен;
               рядом ДВЕ раздельные ссылки — на политику и на сам текст согласия,
               потому что с 01.09.2025 согласие оформляется отдельным документом,
               а не разделом политики.
               Ссылки вынесены ИЗ <label>: внутри подписи клик по ссылке
               одновременно переключал бы чекбокс, и человек, который пошёл
               читать документ, молча снимал бы отметку. Подпись связана с полем
               через for/id, поле дополнительно ссылается на свою ошибку. -->
          <div class="order-form__consent">
            <input
              type="checkbox"
              name="consent"
              id="order-consent"
              required
              aria-describedby="order-consent-error"
            />
            <label for="order-consent">Согласен на обработку персональных данных</label>
            <p class="order-form__consent-docs">
              <a href="/politika-obrabotki-personalnyh-dannyh/">Политика обработки ПД</a>
              <span aria-hidden="true">·</span>
              <a href="/soglasie-na-obrabotku-personalnyh-dannyh/">Текст согласия</a>
            </p>
          </div>
          <p class="order-form__error" id="order-consent-error" role="alert" hidden></p>
          <button class="btn" type="submit" data-order-submit>Отправить заявку <span aria-hidden="true">→</span></button>
          <p class="order-form__status" data-order-status role="status"></p>
        </form>
      </section>

      <!-- Волна 20: страница пересказывает пять этапов короче, чем их собственные
           страницы, — и раньше здесь стоял тот же полный список источников ещё раз,
           почти дословно. Теперь вместо копии — ссылки на страницы, где каждая
           цитата уже есть целиком (design-code: ссылка, а не задвоенный блок). -->
      <Sources
        checked={CHECKED}
        seeAlso={stages.map((s) => ({ href: s.href, label: s.name }))}
        note="Норма режима тишины (закон №608-КЗ в редакции №5423-КЗ) и летнее дорожное ограничение общие для трёх этапов сразу и процитированы на каждом из них."
        media={{
          text:
            'Видео фона в шапке страницы — иллюстративная съёмка (не наш объект и не наша техника): крупный план решётчатой мачты, стрелы и крюковой подвески башенного крана на фоне неба, без опознаваемых зданий или площадок. Автор Max Laurell,',
          links: [
            { href: 'https://www.pexels.com/license/', label: 'Pexels License' },
            { href: 'https://www.pexels.com/video/close-up-video-of-a-tower-crane-6475920/', label: 'страница видео' },
          ],
        }}
      />
      <p class="honest">
        Мы не публикуем отзывов, рейтингов и списка сданных объектов: проект молодой, и придумывать
        их — значит врать в первом же абзаце. Всё, что здесь есть, — нормы с ссылками и арифметика,
        которую можно перепроверить.
      </p>
    </div>
  </div>
</main>

<style>
  /* Ссылка «этап целиком» — подчёркивание, растущее слева направо, тот же
     приём, что у боковой шкалы этапов, а не служебное text-decoration. */
  .stage__more {
    color: var(--accent); font-weight: 700; font-size: var(--t-aux); font-family: var(--text); text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat; background-position: left bottom; background-size: 0% 1px;
    padding-bottom: 2px; transition: background-size .18s ease, color .14s ease;
  }
  .stage__more:hover, .stage__more:focus-visible { background-size: 100% 1px; }
  .stage__more:active { color: var(--accent-press); }
  @media (prefers-reduced-motion: reduce) { .stage__more { transition: none; } }

  /* ── Волна 127, часть A: «обложка досье» — рамочная полоса с фоновым видео,
     НАД двухколоночным заголовком, а не позади него.
     Рамка 1px solid var(--ink) — та же линия, что у .model-photo/.park-atmo,
     без теней/скруглений (design-code). isolation:isolate — свой стэкинг-
     контекст, чтобы z-index скрима/подписи не спорил со страницей. ── */
  .dossier__reel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--ink);
    height: clamp(200px, 26vw, 320px);
  }
  /* На телефоне обложка досье отдаёт 44 px первому экрану. 200 px на 375-м
     кадре — это пятая часть высоты экрана под иллюстративный кадр, который
     сам себя объявляет «не наш объект»; 156 px хватает, чтобы кран читался,
     и на эти 44 px ниже поднимается строка ставки. */
  @media (max-width: 560px) {
    .dossier__reel { height: 156px; }
  }
  .dossier__reel-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ink) center / cover no-repeat;
    /* Постер как CSS-фон контейнера — лежит ПОД видео всегда. Это и есть
       честный prefers-reduced-motion фоллбэк без единой строки JS: скрыть
       видео ниже — и на месте остаётся именно этот фон, а не пустой прямоугольник. */
    /* Постер — фон, а не <img>, поэтому <picture> здесь неприменим: WebP
       подставляется через image-set() с явным type(). Первая строка —
       обычный url() для браузеров без image-set: они просто не поймут две
       следующие и оставят JPEG. Атрибут poster у <video> ниже остаётся
       JPEG'ом сознательно — он одноформатный по спецификации. */
    background-image: url('/images/hero/hero-tower-poster.jpg');
    background-image: -webkit-image-set(url('/images/hero/hero-tower-poster.webp') type('image/webp'), url('/images/hero/hero-tower-poster.jpg') type('image/jpeg'));
    background-image: image-set(url('/images/hero/hero-tower-poster.webp') type('image/webp'), url('/images/hero/hero-tower-poster.jpg') type('image/jpeg'));
  }
  .dossier__reel-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .dossier__reel-video { display: none; }
  }
  /* Затемнение снизу — не ради текста поверх видео (заголовок остаётся на
     бумажном фоне ниже), а чтобы честная подпись-тег читалась поверх любого
     кадра клипа и чтобы яркое небо клипа не спорило цветом с тёплой кремовой
     страницей вокруг панели. */
  .dossier__reel-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(36, 31, 26, 0) 58%, rgba(36, 31, 26, .8) 100%);
  }
  .dossier__reel-tag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    margin: 0;
    padding: 10px clamp(14px, 3vw, 22px);
    font-family: var(--text);
    font-size: var(--t-rubric);
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: #FAF7F0;
  }

  /* ── Волна 127, часть B: тилт-карточки трёх моделей парка — первый тилт-
     механизм на этом сайте (design-code до сих пор нигде не использовал
     наведение с перспективой). Обратная связь при наведении — смена цвета
     рамки на акцент, БЕЗ тени/подъёма и без скруглений (design-code это
     прямо запрещает); наклон карточки — JS в конце файла. ── */
  /* minmax(min(220px,100%), 1fr) вместо minmax(220px, 1fr): вторая форма не
     умеет сжиматься ниже 220 px и на 320-пиксельном экране распирала бы
     страницу, если бы колонка когда-нибудь стала уже 220 (например, внутри
     более узкого контейнера). Проверка на 320 px — обязательная, а не
     формальная: именно так ломается вёрстка, которую на 375 не видно. */
  .park-trio { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: clamp(16px, 3vw, 24px); margin-top: 28px; }
  /* Карточка модели набрана как .card-reg (см. BaseLayout): тяжёлая линейка
     сверху, волосяная по остальным сторонам. Это тот же язык, что у полосы
     этапов и у таблиц норм, а не универсальная рамка 1px, одинаковая на
     четырёх сетках подряд. Тилт Волны 127 сохранён — он живёт в inline
     transform из JS, поэтому transform в переходе оставлен на .35s. */
  .park-trio__card {
    will-change: transform;
    transition: border-color .16s ease, transform .35s ease;
  }
  .park-trio__photo { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg); border-bottom: 1px solid var(--line); }
  .park-trio__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .park-trio__body { display: block; padding: 16px 18px 18px; }
  .park-trio__type { display: block; color: var(--accent); font-family: var(--text); font-size: var(--t-rubric); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  /* Висячая линейка под рубрикой — та же деталь, что отделяет шапку таблицы
     от строк. Она и делает карточку записью регистра, а не плашкой. */
  .park-trio__name { display: block; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); font-family: var(--display); font-size: var(--d-xs); font-weight: 400; line-height: 1.22; color: var(--ink); hyphens: auto; overflow-wrap: break-word; }
  .park-trio__note { display: block; margin-top: 8px; color: var(--muted); font-family: var(--text); font-size: var(--t-aux); line-height: 1.45; font-variant-numeric: tabular-nums; }
  .park-trio__card:hover .park-trio__name { color: var(--accent); }
  /* JS ниже уже проверяет prefers-reduced-motion перед тем, как выставлять
     transform — это правило страхует переход при mouseleave/фокусе, если
     настройка ОС переключится прямо на открытой странице. */
  @media (prefers-reduced-motion: reduce) {
    .park-trio__card { transition: border-color .16s ease; }
  }
  .order-form { display: grid; gap: 16px; max-width: 420px; margin-top: 24px; }
  .order-form__field { display: grid; gap: 6px; }
  .order-form__field > label {
    font-family: var(--text); font-size: var(--t-rubric); font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
  }
  .order-form__field > label span[aria-hidden] { color: var(--accent); }
  /* Граница полей — var(--field-line) (3.34:1 к тёплому листу): var(--line)
     давала 1.36:1 и не проходила WCAG 1.4.11 «Non-text contrast».
     :not([type="checkbox"]) — чекбокс согласия не должен получить ни падинги
     текстового поля, ни min-height 48px: это сделало бы из него прямоугольник
     размером с поле ввода.
     Наведение и фокус — линейка темнеет до чернил: у поля появилось состояние
     наведения, которого раньше не было ни у одного контрола сайта. */
  .order-form input:not([type="checkbox"]) {
    background: var(--surface); border: 1px solid var(--field-line); color: var(--ink);
    padding: 12px 14px; font-family: inherit; font-size: var(--t-body); min-height: 48px;
    transition: border-color .14s ease;
  }
  .order-form input:not([type="checkbox"]):hover { border-color: var(--ink); }
  .order-form input[aria-invalid="true"] { border-color: var(--accent); border-width: 2px; }
  /* Ошибочное поле помечено не одним цветом: подпись над ним тоже уходит в
     акцент, иначе состояние ошибки передавалось бы исключительно цветом
     рамки (WCAG 1.4.1 «Use of Color»). */
  .order-form__field:has(input[aria-invalid="true"]) > label { color: var(--accent); }

  /* Согласие на обработку ПД: отметка + подпись в строку, две ссылки на
     документы — строкой ниже, чтобы клик по ссылке не спорил с тап-таргетом
     самой отметки. */
  .order-form__consent { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 10px; margin-top: 4px; align-items: start; }
  .order-form__consent input[type="checkbox"] { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--accent); flex-shrink: 0; }
  .order-form__consent label { font-size: var(--t-aux); color: var(--ink); line-height: 1.45; cursor: pointer; }
  .order-form__consent input[aria-invalid="true"] { outline: 2px solid var(--accent); outline-offset: 2px; }
  .order-form__consent-docs { grid-column: 2; margin: 3px 0 0; font-size: var(--t-note); color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 8px; }
  .order-form__consent-docs a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .order-form__hint { font-size: var(--t-note); color: var(--muted); font-family: var(--text); }
  /* Сообщение об ошибке — акцентная линейка слева от текста, как пометка
     корректора на полях: цвет плюс форма, а не цвет один. */
  .order-form__error { font-size: var(--t-aux); font-weight: 700; color: var(--accent); font-family: var(--text); padding-left: 12px; border-left: 1px solid var(--accent); }
  .order-form__error[hidden] { display: none; }
  .order-form__status { font-size: var(--t-aux); color: var(--ink); font-family: var(--text); }
  .order-form__status:empty { display: none; }
  .order-form__status a { color: var(--accent); font-weight: 700; }
  /* Honeypot: остаётся в DOM и доступен ботам-парсерам, но не виден человеку и
     не должен участвовать в табуляции/озвучке — position:absolute + left:-9999px
     вместо display:none, иначе часть простых ботов его тоже пропустит. */
  .order-form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .btn[disabled] { opacity: .6; cursor: not-allowed; }
</style>
</BaseLayout>

<script>
  // Волна 35. Форма шлёт реальный POST на общий Cloudflare Worker lead-relay
  // (см. корневой lead-relay/worker.js и lead-relay/README.md). Воркер задеплоен
  // («ИТОГ: lead-relay задеплоен», 17.08.2026) — LEAD_ENDPOINT ниже реальный.
  // Если запрос всё же не проходит (сеть, DNS) — вместо тишины или чужого
  // alert() показываем честный фоллбэк с рабочим телефоном сайта.
  const LEAD_ENDPOINT = 'https://kran-network-leads.kran-network-leads.workers.dev/submit'; // Волна 51: убран устаревший комментарий «плейсхолдер/TODO» — деплой уже состоялся
  const SITE_PHONE = '+7 (909) 981-54-15';
  const SITE_TEL_HREF = 'tel:+79099815415';

  // Вместо alert() — собственная валидация и текстовые сообщения.
  // Ошибка валидации: role="alert" (объявляется сразу), aria-invalid на поле, фокус переводится в поле.
  // Статус отправки: role="status" (объявляется вежливо, не крадёт фокус).
  function initOrderForm() {
    const form = document.querySelector<HTMLFormElement>('.order-form');
    const name = document.getElementById('order-name') as HTMLInputElement | null;
    const phone = document.getElementById('order-phone') as HTMLInputElement | null;
    const object = document.getElementById('order-object') as HTMLInputElement | null;
    const website = document.getElementById('order-website') as HTMLInputElement | null; // honeypot
    const consent = document.getElementById('order-consent') as HTMLInputElement | null;
    const errorBox = document.getElementById('order-phone-error');
    const consentError = document.getElementById('order-consent-error');
    const statusBox = document.querySelector<HTMLElement>('[data-order-status]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-order-submit]');
    if (!form || !phone || !errorBox || !statusBox || !submitBtn) return;

    // У формы стоит novalidate (собственные русские сообщения вместо браузерного
    // «пузыря»), поэтому атрибут required сам по себе отправку НЕ остановит —
    // и телефон, и согласие проверяются здесь руками.
    // Момент открытия формы: человек физически не успеет заполнить три поля и
    // поставить отметку быстрее пары секунд, бот отправляет почти мгновенно.
    const openedAt = Date.now();
    const MIN_FILL_MS = 2000;

    function clearError() {
      errorBox!.textContent = '';
      errorBox!.hidden = true;
      phone!.removeAttribute('aria-invalid');
    }
    function clearConsentError() {
      if (!consentError) return;
      consentError.textContent = '';
      consentError.hidden = true;
      consent?.removeAttribute('aria-invalid');
    }

    phone.addEventListener('input', () => {
      if (phone.value.trim()) clearError();
    });
    consent?.addEventListener('change', () => {
      if (consent.checked) clearConsentError();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusBox.textContent = '';

      // Антиспам вместо капчи. Обе отсечки МОЛЧАЛИВЫЕ: боту нельзя показывать,
      // что его отбраковали, иначе он подберёт обход. Человек сюда не попадает —
      // ловушка ему не видна, а две секунды на заполнение он тратит гарантированно.
      // Честная оговорка: это клиентские проверки, настоящие (rate limit по IP,
      // валидация формата) обязаны жить на стороне приёмника заявок.
      if (website && website.value.trim() !== '') return;
      if (Date.now() - openedAt < MIN_FILL_MS) return;

      if (!phone.value.trim()) {
        errorBox.textContent = 'Укажите телефон — без него мы не сможем ответить на заявку.';
        errorBox.hidden = false;
        phone.setAttribute('aria-invalid', 'true');
        phone.focus();
        return;
      }
      clearError();

      if (consent && !consent.checked) {
        if (consentError) {
          consentError.textContent = 'Отметьте согласие на обработку персональных данных — без него мы не вправе принять заявку.';
          consentError.hidden = false;
        }
        consent.setAttribute('aria-invalid', 'true');
        consent.focus();
        return;
      }
      clearConsentError();

      submitBtn.disabled = true;
      const originalLabel = submitBtn.innerHTML;
      submitBtn.textContent = 'Отправляем…';
      statusBox.textContent = '';

      try {
        // ЗАЩИТА ОТ ОТПРАВКИ ТЕСТОВЫХ ЗАЯВОК В БОЕВОЙ ПРИЁМНИК.
        // Обработчик заявок пересылает каждую заявку живому человеку в мессенджер.
        // Любая проверка формы с локального dev-сервера доходила до него как
        // настоящий лид: так уже случилось трижды. Ниже запрос физически не уходит,
        // если страница открыта не на боевом домене. Вся остальная логика (статусы,
        // разблокировка кнопки, разбор ответа) работает как обычно — форму можно
        // проверять, не мусоря в чате.
        const leadRelayFetch = (url: string, init?: RequestInit): Promise<Response> => {
          const h = typeof location !== 'undefined' ? location.hostname : '';
          const isLocal =
            /^(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])$/.test(h) ||
            h.endsWith('.local') ||
            (typeof location !== 'undefined' && location.protocol === 'file:');
          if (isLocal) {
            return Promise.resolve(
              new Response(JSON.stringify({ ok: true, dryRun: true }), {
                status: 200,
                headers: { 'Content-Type': 'application/json' },
              }),
            );
          }
          return fetch(url, init);
        };
        const res = await leadRelayFetch(LEAD_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            site: 'krankuban',
            name: name?.value ?? '',
            phone: phone.value,
            comment: object?.value ?? '',
            page: location.pathname,
            website: website?.value ?? '',
            // Факт согласия уходит вместе с заявкой: иначе на стороне приёмника
            // нечем подтвердить, что отметка вообще была проставлена.
            consent: consent?.checked === true,
          }),
        });
        if (res.ok) {
          statusBox.textContent = 'Заявка отправлена, мы перезвоним.';
          form.reset();
        } else {
          statusBox.innerHTML = `Заявка не отправлена, позвоните: <a href="${SITE_TEL_HREF}">${SITE_PHONE}</a>`;
        }
      } catch {
        statusBox.innerHTML = `Заявка не отправлена, позвоните: <a href="${SITE_TEL_HREF}">${SITE_PHONE}</a>`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalLabel;
      }
    });
  }
  initOrderForm();

  // Волна 127, часть B: 3D-тилт карточек трёх моделей парка (.park-trio__card) —
  // первый тилт-механизм на этом сайте (проверено перед написанием: ни в
  // BaseLayout.astro, ни в компонентах не было ни initCardTilt, ни rotateX/
  // rotateY — design-code «экспертный редакционный» до этой волны не
  // использовал наведение с перспективой нигде). Наклон считается по позиции
  // курсора внутри карточки: ±8° — в середине диапазона 5–10° из ТЗ.
  // Живёт в самой странице (initOrderForm — рядом, тоже здесь), а не в
  // BaseLayout: эффект применяется только к разметке главной, а не сайту целиком.
  function initParkTilt() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.park-trio__card'));
    if (!cards.length) return;

    // pointer:fine — грубый, но надёжный признак «есть мышь»: на touch-only
    // устройствах mousemove почти никогда не всплывает так, как на десктопе,
    // но проверка внутри обработчика, а не только при подписке, страхует и
    // гибридные устройства (ноутбук-трансформер, тачскрин + мышь одновременно).
    const fine = window.matchMedia('(pointer: fine)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const MAX_DEG = 8;

    cards.forEach((card) => {
      card.addEventListener('mousemove', (e: MouseEvent) => {
        if (!fine.matches || reduceMotion.matches) return;
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;  // 0..1 слева направо
        const py = (e.clientY - rect.top) / rect.height;  // 0..1 сверху вниз
        const rx = (0.5 - py) * MAX_DEG * 2;
        const ry = (px - 0.5) * MAX_DEG * 2;
        card.style.transition = 'none';
        card.style.transform = `perspective(800px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transition = 'transform .35s ease';
        card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)';
      });
    });
  }
  initParkTilt();
</script>
