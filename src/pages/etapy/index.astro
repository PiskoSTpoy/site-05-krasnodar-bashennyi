---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';

// Волна 16. Новый основной раздел сайта вместо /uslugi/ и /keysy/.
// Содержание обеих удалённых веток разложено по этапам: логика выбора техники,
// разбор факторов края и документальная часть монтажа теперь живут там, где
// они реально возникают в проекте, а не в витрине услуг.

const title = 'Этапы работы башенного крана — от изысканий до демонтажа';
const description =
  'Пять этапов жизненного цикла башенного крана в Краснодарском крае: изыскания, проект и ППР, монтаж и анкеровка, эксплуатация в окнах тишины, демонтаж.';
const SITE = 'https://kran-kuban.example';
const CHECKED = '12 августа 2026 года';

const stages = [
  {
    href: '/etapy/izyskaniya-i-grunt/',
    num: '01',
    name: 'Изыскания и грунт',
    decides: 'Какая у площадки расчётная сейсмичность и выдержит ли основание кран',
    norm: 'СП 446.1325800.2019, СП 14.13330.2018 (категории грунтов, карты ОСР-2015)',
    note: 'Категория грунта сдвигает балл площадки относительно карты. Рыхлый прибрежный песок — III категория, и это меняет расчёт, а не формулировку в договоре.',
  },
  {
    href: '/etapy/proekt-i-ppr/',
    num: '02',
    name: 'Проект и ППР',
    decides: 'Тип техники, привязка крана, зоны ограничения и реальная дата выхода на площадку',
    norm: 'ФНП №461, пп. 157–158; СП 48.13330.2019; градостроительные регламенты участка',
    note: 'ППР утверждает эксплуатирующая кран организация и выдаёт на участок до начала работ, а бригаду знакомят с ним под подпись. Именно это, а не занятость крана, задаёт горизонт заказа.',
  },
  {
    href: '/etapy/montazh-i-ankerovka/',
    num: '03',
    name: 'Монтаж и анкеровка',
    decides: 'Как устроено основание и принято ли оно до первого подъёма',
    norm: 'ГОСТ 35321-2025 и СП 12-103-2002, РД 22-28-35-99, ТСН 22-302-2000 для сейсмических площадок',
    note: 'Крановый путь принимается актом, а для площадки 7–9 баллов в расчёт основания входит сейсмическая нагрузка рядом с ветровой.',
  },
  {
    href: '/etapy/ekspluatatsiya-i-tishina/',
    num: '04',
    name: 'Эксплуатация и режим тишины',
    decides: 'Сколько часов в сутки кран реально работает и сколько дней отбирает погода',
    norm: 'Ст. 3.3 закона края №608-КЗ в редакции №5423-КЗ (с 01.03.2026)',
    note: 'День разрезан пополам: 08:00–13:00 и 15:00–23:00. Планировать приходится не смены, а длину непрерывной операции.',
  },
  {
    href: '/etapy/demontazh-i-perebazirovka/',
    num: '05',
    name: 'Демонтаж и перебазировка',
    decides: 'Когда кран уедет и не упрётся ли выезд в летнее дорожное ограничение',
    norm: 'Тот же режим тишины + летнее ограничение движения тяжеловесов в крае',
    note: 'С 20 мая по 31 августа при жаре выше +32 °C трал едет только с 22:00 до 10:00, а разбирать привезённое можно с 08:00.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Этапы работы крана', item: `${SITE}/etapy/` },
  ],
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Этапы жизненного цикла башенного крана на объекте',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: stages.length,
  itemListElement: stages.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: SITE + s.href })),
};
---
<BaseLayout title={title} description={description} path="/etapy/" ldExtra={[breadcrumbLd, itemListLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Этапы работы крана</span>
  </nav>

  <header class="dossier wrap" style="padding-top:8px">
    <span class="eyebrow">Раздел</span>
    <h1>Этапы работы башенного крана на объекте</h1>
    <p class="dossier__lead">
      Башенный кран проходит на объекте 5 этапов: изыскания и грунт, проект и ППР, монтаж и
      анкеровка, эксплуатация в окнах режима тишины, демонтаж и перебазировка. Каждый опирается на
      свой документ — от СП 446.1325800.2019 на изысканиях до пп. 157–158 ФНП №461 на проекте, — и
      сорванный ранний этап сдвигает все последующие. Ниже — карта этапов целиком, а по ссылкам —
      разбор каждого.
    </p>
  </header>

  <section class="section wrap" style="padding-top:clamp(24px,3vw,32px)">
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Пять этапов: что решается, чем установлено</caption>
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader">Этап</th>
            <th scope="col" role="columnheader">Что решается</th>
            <th scope="col" role="columnheader">Чем установлено</th>
          </tr>
        </thead>
        <tbody>
          {stages.map((s) => (
            <tr role="row">
              <th scope="row" role="rowheader"><a href={s.href} style="color:var(--accent);font-weight:700">{s.num} · {s.name}</a></th>
              <td role="cell" data-label="Что решается">{s.decides}</td>
              <td role="cell" data-label="Чем установлено">{s.norm}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:18px">Этапы не идут в очередь — они тянутся друг за другом</h2>
    <p>
      Схема «сначала одно, потом другое» удобна для списка, но неверна для площадки. Два фактора
      прошивают весь цикл насквозь. Первый — сейсмичность: балл выясняется на изысканиях, попадает
      в расчёт основания при монтаже и остаётся в документах до самого демонтажа. Второй — режим
      тишины: он одинаково ограничивает и сборку крана, и его повседневную работу, и разборку, то
      есть влияет на три этапа из пяти.
    </p>
    <p>
      Отсюда практическое следствие: вопросы, которые обычно задают в конце («когда закончите?»,
      «почему так дорого выходит месяц?»), решаются в начале. Срок сдвигают не темпы работы, а
      пятидневный срок передачи ППР, приёмка кранового пути актом и число дней, вычеркнутых из
      графика ветром и жарой.
    </p>

    <h2 style="margin:36px 0 18px">Что мы просим на входе — и зачем</h2>
    <ul>
      <li><b>Адрес или район площадки.</b> От него зависит расчётная сейсмичность и то, попадает ли объект в зону, где летом ограничено движение тяжеловесов.</li>
      <li><b>Данные о грунте:</b> раздел изысканий из проектной документации или карта сейсмического микрорайонирования. Без них балл берётся по населённому пункту в целом — это оценка, а не расчёт по вашему участку.</li>
      <li><b>Планируемая высота объекта и срок строительства.</b> Именно они, а не вес отдельного груза, разводят задачу на «башенный кран помесячно» и «смены автокрана».</li>
      <li><b>Плановое время работ.</b> Чтобы сверить его с окнами режима тишины до выезда, а не после первой жалобы соседей.</li>
    </ul>

    <h2 style="margin:36px 0 18px">Где проходит граница между башенным краном и автокраном</h2>
    <p>
      Граница проходит не по весу груза, а по длительности стройки. Башенный кран — это цепочка
      «монтаж — помесячная аренда — демонтаж», которая окупается на объекте, растущем месяцами;
      автокран приезжает на смену и уезжает. Поэтому там, где высота застройки ограничена
      градостроительным регламентом, разговор почти всегда идёт про смены автокрана, а на
      городских окраинах и в приморских районах края — про башенный кран на весь срок
      строительства. На стоимость это влияет сильнее, чем ставка: разовые расходы на мобилизацию
      и демонтаж делятся на срок аренды, и на коротком сроке они бьют по итогу больнее, чем
      разница в ставке за месяц — это видно в <a href="/#smeta" style="color:var(--accent)">смете владения</a>.
    </p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">Пять разборов</span>
      <h2>Этапы по отдельности</h2>
    </div>
    <dl class="factline" style="max-width:none">
      {stages.map((s) => (
        <div>
          <dt><a href={s.href} style="color:var(--accent)">{s.num} · {s.name}</a></dt>
          <dd>{s.note}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section wrap" style="padding-top:0">
    <!-- Волна 20: это оглавление пяти страниц ниже, и раньше здесь стоял тот же
         полный список источников ещё раз — почти дословно. Вместо копии — ссылки
         на страницы, где каждая цитата уже есть целиком. -->
    <Sources
      checked={CHECKED}
      style="margin-top:0;border-top:none;padding-top:0"
      seeAlso={stages.map((s) => ({ href: s.href, label: s.name }))}
      note="Норма режима тишины (закон №608-КЗ в редакции №5423-КЗ) и летнее дорожное ограничение общие для нескольких этапов и процитированы на каждом из них."
    />
    <p style="margin-top:24px"><a class="btn" href="/#order">Назвать площадку в заявке <span aria-hidden="true">→</span></a></p>
  </section>
</main>
</BaseLayout>
