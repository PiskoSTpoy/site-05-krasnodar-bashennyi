---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StageStrip from '../../../components/StageStrip.astro';
import StageNext from '../../../components/StageNext.astro';
import DayBand from '../../../components/DayBand.astro';
import Sources from '../../../components/Sources.astro';

// Волна 16. Пятый этап, которого на сайте не было вообще: выход крана с объекта.
// Здесь же — единственный на сети разбор летнего дорожного ограничения края,
// которое накладывается на режим тишины и сжимает окно перебазировки.
// Процедура получения спецразрешения на тяжеловес закреплена реестром тем за
// site-07 — на неё стоит ссылка, а не пересказ.

const title = 'Демонтаж и перебазировка крана: летнее окно перевозки';
const description =
  'Выход башенного крана с объекта на Кубани: демонтаж в окнах режима тишины, разборка пути и летнее ограничение движения тяжеловесов при жаре выше +32 °C.';
const SITE = 'https://kran-kuban.ru';
const CHECKED = '12 августа 2026 года';

const windows = [
  { what: 'Перевозка секций тралом (лето, жара выше +32 °C)', when: '22:00 – 10:00', why: 'Днём движение тяжеловесов по региональным и межмуниципальным дорогам края закрыто с 20 мая по 31 августа' },
  { what: 'Разгрузка и разборка на площадке', when: '08:00 – 13:00 и 15:00 – 23:00', why: 'Погрузочно-разгрузочные и строительные работы попадают под режим тишины по ст. 3.3 закона №608-КЗ' },
  { what: 'Совпадение обоих окон', when: '08:00 – 10:00 и 22:00 – 23:00', why: 'Единственные часы летнего дня, когда трал может ехать, а техника на площадке — работать' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Этапы работы крана', item: `${SITE}/etapy/` },
    { '@type': 'ListItem', position: 3, name: 'Демонтаж и перебазировка', item: `${SITE}/etapy/demontazh-i-perebazirovka/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/etapy/demontazh-i-perebazirovka/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/etapy/">Этапы</a><span aria-hidden="true">/</span><span aria-current="page">Демонтаж и перебазировка</span>
  </nav>

  <div class="wrap"><StageStrip current="demontazh-i-perebazirovka" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Этап 5 из 5 · выход с объекта</span>
    <h1>Демонтаж и перебазировка: ограничение, о котором вспоминают в июле</h1>
    <p class="dossier__lead">
      Летом окно для выхода крана с объекта сжимается примерно до 3 часов в сутки: с 20 мая по
      31 августа при жаре выше +32 °C трал с секциями не пускают на региональные дороги края с 10:00
      до 22:00, а шуметь на площадке режим тишины разрешает только с 08:00 до 13:00 и с 15:00 до
      23:00. Пересечение двух ограничений даёт всего две полосы — 08:00–10:00 и 22:00–23:00, —
      поэтому летнюю демобилизацию на побережье планируют по краям дня.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Что происходит на этом этапе</h2>
    <p>
      Демонтаж башенного крана — обратная последовательность монтажа: снятие анкеровки, разборка
      секций мачты и стрелы с привлечением автокрана, погрузка на трал, разборка кранового пути или
      освобождение фундамента, приведение площадки в порядок. Это плановые работы по проекту, а не
      «сборы» — и, как и монтаж, они не относятся к аварийным и неотложным, для которых сделано
      исключение из режима тишины.
    </p>
    <p>
      Автокран на этом этапе нужен снова: секции мачты поднимает не сам башенный кран. В смете это та
      же строка, что и на монтаже, — часовая ставка и восьмичасовая смена как минимальный заказ;
      посчитать вход и выход одним расчётом можно в
      <a href="/#smeta" style="color:var(--accent)">смете владения</a>.
    </p>

    <h2 style="margin:36px 0 18px">Летнее ограничение движения: почему трал едет ночью</h2>
    <p>
      В Краснодарском крае с 20 мая по 31 августа действует летнее ограничение движения тяжеловесного
      транспорта: при дневной температуре воздуха выше +32 °C проезд по дорогам регионального и
      межмуниципального значения закрыт с 10:00 до 22:00 — разогретый асфальт не держит нагрузку.
      Перечень дорог и параметры ограничения краевой минтранс объявляет ежегодно, поэтому перед
      перебазировкой их сверяют заново, а не по прошлогодней памяти.
    </p>
    <p>
      Дальше начинается арифметика, которой нет больше нигде в сети: дорожное ограничение и режим
      тишины смотрят в разные стороны. Ночью трал ехать может, а работать на площадке — нет; днём
      наоборот. Пересечение двух разрешённых окон летом сводится к двум узким полосам.
    </p>
    <DayBand
      rows={[
        { label: 'Трал с секциями крана', allowed: [{ from: 0, to: 10 }, { from: 22, to: 24 }], hint: 'Летом при температуре выше +32 °C дневное движение тяжеловесов закрыто' },
        { label: 'Шумные работы на площадке', allowed: [{ from: 8, to: 13 }, { from: 15, to: 23 }], hint: 'Режим тишины, будни' },
        { label: 'Оба ограничения сняты', allowed: [{ from: 8, to: 10 }, { from: 22, to: 23 }], hint: 'Часы, когда техника может и приехать, и работать' },
      ]}
      caption="Нижняя полоса — пересечение двух верхних. Из полных суток на летнюю мобилизацию и демобилизацию на побережье остаётся около трёх часов, и обе полосы приходятся на края дня."
    />
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Пересечение дорожного ограничения и режима тишины в летний период</caption>
        <thead><tr role="row"><th scope="col" role="columnheader">Что делаем</th><th scope="col" role="columnheader">Когда разрешено</th><th scope="col" role="columnheader">Почему</th></tr></thead>
        <tbody>
          {windows.map((w) => (
            <tr role="row"><th scope="row" role="rowheader">{w.what}</th><td role="cell" data-label="Когда разрешено">{w.when}</td><td role="cell" data-label="Почему">{w.why}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Отсюда практическое правило для летней демобилизации на побережье: трал приходит к площадке к
      восьми утра, разгрузка и разборка идут в утреннем окне, а обратный рейс уходит после десяти
      вечера. Спланировать это можно за неделю, а вот обнаружить в день выезда — значит потерять
      сутки и оплатить простой техники.
    </p>

    <h2 style="margin:36px 0 18px">Разрешение на перевозку — отдельная процедура</h2>
    <p>
      Секции башенного крана почти всегда едут как тяжеловесный или крупногабаритный груз, а это
      значит специальное разрешение на перевозку и согласованный маршрут — статья 31 Федерального
      закона от 08.11.2007 № 257-ФЗ. Разрешение выдаётся на конкретную машину и конкретный маршрут,
      и до выдачи маршрут согласуют владельцы всех дорог, по которым он проходит. Кубанская часть
      здесь не процедура, а календарь: летние даты, температурный порог и часы, в которые маршрут
      физически открыт.
    </p>

    <h2 style="margin:36px 0 18px">Чем закрывается этап</h2>
    <ul>
      <li><b>Демонтаж кранового пути или освобождение фундамента</b> — площадка возвращается заказчику в состоянии, зафиксированном в договоре.</li>
      <li><b>Закрывающие документы по аренде.</b> Длительная аренда башенного крана закрывается помесячно, по фактическому сроку нахождения машины на объекте; месяц монтажа и месяц демонтажа закрываются отдельными документами, потому что в них попадают работы, а не стоянка. Расхождение по датам решается подписанными актами монтажа и демонтажа — они и есть точка отсчёта.</li>
      <li><b>Отдельная строка простоев.</b> Дни, вычеркнутые ветром или ограничением движения, фиксируются как объективный простой, а не растворяются в итоговой сумме.</li>
    </ul>

    <Sources checked={CHECKED} items={[
      { href: 'https://bloknot-krasnodar.ru/news/bolshegruzam-zapretyat-ezdit-v-zharu-po-dorogam-kr', label: 'летнее ограничение движения тяжеловесов в Краснодарском крае: 20 мая – 31 августа, свыше +32 °C, запрет с 10:00 до 22:00' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — режим тишины с 01.03.2026 и перечень работ под запретом' },
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/', label: 'приказ Ростехнадзора №461 от 26.11.2020 (ред. от 16.04.2026) — раздел VI, работы с применением ПС по ППР и ТК' },
    ]} />

    <StageNext current="demontazh-i-perebazirovka" />
  </section>
</main>
</BaseLayout>
