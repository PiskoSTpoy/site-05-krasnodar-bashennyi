---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StageStrip from '../../../components/StageStrip.astro';
import StageNext from '../../../components/StageNext.astro';
import Sources from '../../../components/Sources.astro';

// Волна 16. Сюда переехало содержание удалённых /geo/krasnodar/ и
// /keysy/avtokran-v-istoricheskom-centre/: градостроительный статус участка —
// это решение стадии проекта, а не «география города».
// Волна 16 также сняла с сайта цифру «не выше 21 метра»: подтвердить её
// первоисточником не удалось (см. заметку волны 15). Фактор назван без чисел,
// со ссылкой на действующий приказ по историческому поселению.

const title = 'Проект и ППР: почему кран не заказывают «на послезавтра»';
const description =
  'Что решается в ППР краном: кто утверждает проект по пп. 157–158 ФНП №461, привязка крана и зоны ограничения, влияние регламента участка на выбор техники.';
const SITE = 'https://kran-kuban.ru';
const CHECKED = '12 августа 2026 года';

const decisions = [
  { d: 'Тип техники', c: 'Башенный кран помесячно или смены автокрана — определяется высотой объекта и сроком стройки, а не весом отдельного груза' },
  { d: 'Привязка крана', c: 'Где встанет фундамент или крановый путь, какой нужен вылет — отсюда же вытекает конфигурация пути и объём подготовки основания' },
  { d: 'Зоны ограничения', c: 'Границы опасной зоны, соседние здания и проезды; на плотной городской площадке именно они чаще всего сокращают выбор моделей' },
  { d: 'График по окнам', c: 'Последовательность операций с учётом того, что рабочий день в крае разрезан режимом тишины на два окна' },
  { d: 'Дата выхода', c: 'ППР выдаётся на участок и подписывается бригадой за ознакомление до первого подъёма — эта процедура, а не занятость крана, задаёт реальный горизонт заказа' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Этапы работы крана', item: `${SITE}/etapy/` },
    { '@type': 'ListItem', position: 3, name: 'Проект и ППР', item: `${SITE}/etapy/proekt-i-ppr/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/etapy/proekt-i-ppr/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/etapy/">Этапы</a><span aria-hidden="true">/</span><span aria-current="page">Проект и ППР</span>
  </nav>

  <div class="wrap"><StageStrip current="proekt-i-ppr" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Этап 2 из 5 · за недели до техники</span>
    <h1>Проект и ППР: этап, на котором решается всё остальное</h1>
    <p class="dossier__lead">
      ППР краном утверждает эксплуатирующая кран организация и выдаёт на участок до начала работ, а
      крановщики и стропальщики расписываются за ознакомление до первого подъёма — это пп. 157–158
      раздела VI ФНП №461 (приказ Ростехнадзора от 26.11.2020, редакция от 16.04.2026). Поэтому
      горизонт заказа башенного крана измеряется неделями и упирается в документы, а не в наличие
      техники: на этом же этапе решают, какая машина встанет на площадку, где именно и в каком
      порядке пойдут операции.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Подписи, которые нельзя собрать задним числом</h2>
    <p>
      Требования к проекту производства работ с применением подъёмных сооружений стоят в разделе VI
      ФНП №461 (приказ Ростехнадзора от 26.11.2020, редакция от 16.04.2026). Для заказчика в нём важны
      два пункта. Первый: ППР и технологические карты утверждает эксплуатирующая кран организация и
      выдаёт их на участки, где кран будет работать, до начала ведения работ (п. 157). Второй:
      ответственные инженерно-технические работники, крановщики и стропальщики должны быть ознакомлены
      с ППР и ТК под подпись до начала производства работ (п. 158).
    </p>
    <p>
      Отдельно про источник, потому что по отрасли ходит другая версия. Формулировки «утверждает
      руководитель генподрядной организации» и «передаётся на площадку за 5 дней» происходят из
      методических рекомендаций РД-11-06-2007, отменённых регуляторной гильотиной с 1 января 2021 года;
      замену им не выпускали, и разрабатывают ППР сегодня по ФНП №461 и СП 48.13330.2019 «Организация
      строительства». Жёсткого пятидневного срока в действующей норме нет — но требование собрать
      подписи за ознакомление до первого подъёма никуда не делось.
    </p>
    <p>
      Поэтому реалистичный горизонт заказа башенного крана по-прежнему измеряется неделями, а не днями,
      и упирается он в документы, а не в наличие техники. Разовый выезд автокрана этой цепочки не
      требует — в этом, а не в цене за час, главная разница между двумя сценариями.
    </p>

    <h2 style="margin:36px 0 18px">Что именно решается в проекте</h2>
    <div class="rule-table-wrap">
      <table class="rule-table">
        <caption class="sr-only">Решения стадии проекта и их последствия</caption>
        <thead><tr><th scope="col">Решение</th><th scope="col">Что оно определяет дальше</th></tr></thead>
        <tbody>
          {decisions.map((r) => (
            <tr><th scope="row">{r.d}</th><td>{r.c}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <p style="margin-top:20px">
      Зоны ограничения решают не только вопрос «башенный кран или автокран» — иногда ответ на плотной
      площадке даёт сама геометрия стрелы: маховый кран из парка способен сократить вылет и не
      проходить над соседним участком, там, где кран с постоянным вылетом это сделал бы неизбежно —
      разбор на странице <a href="/park/potain-mch-175/" style="color:var(--accent)">«Potain MCH 175»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Градостроительный статус участка решает за вас</h2>
    <p>
      Выбор между башенным краном и автокраном чаще всего оказывается следствием не пожеланий
      заказчика, а статуса территории. Краснодар в июле 2015 года включён в перечень исторических
      поселений регионального значения, а предмет охраны, границы территории и требования к
      градостроительным регламентам в этих границах утверждены приказом краевой администрации,
      действующим с 1 марта 2019 года. Конкретные предельные высоты задаются регламентом по зонам и
      правилами землепользования и застройки, и проверять их нужно по адресу участка, а не по общему
      представлению о «центре города».
    </p>
    <p>
      Механика простая: там, где высота застройки ограничена, полный цикл башенного крана
      экономически не собирается. Монтаж, помесячная аренда и демонтаж окупаются на объекте, который
      растёт месяцами; для здания в несколько этажей монтаж и разгрузка занимают разовые смены, и
      работа уходит к автокрану. За пределами таких границ — на городских окраинах и в новых
      районах — картина обратная, и там башенный кран становится стандартным решением на весь срок
      строительства.
    </p>
    <p class="honest">
      Раньше на этой странице стояла конкретная цифра предельной высоты в метрах. Подтвердить её
      первоисточником при перепроверке не удалось, поэтому цифра снята: фактор остался, выдуманного
      числа рядом с ним нет.
    </p>

    <h2 style="margin:36px 0 18px">Проект и документы — не одно и то же</h2>
    <p>
      ППР отвечает на вопрос «как будем работать», а параллельно с ним собирается пакет, отвечающий
      на вопрос «чем это подтверждено»: приёмка кранового пути актом, расчёт основания с сейсмической
      нагрузкой там, где он требуется, комплект на технику и оператора. Полная цепочка с нормами и
      моментом появления каждого документа — в разделе
      <a href="/documents/" style="color:var(--accent)">«Документы монтажа башенного крана»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Что мы просим на этом этапе</h2>
    <dl class="factline">
      <div>
        <dt>Схему привязки и границы площадки</dt>
        <dd>С соседними объектами и проездами — от неё зависят и конфигурация пути, и зоны ограничения в ППР.</dd>
      </div>
      <div>
        <dt>Высоту объекта и срок строительства</dt>
        <dd>Эти два числа разводят задачу на башенный кран помесячно и смены автокрана надёжнее любого описания «нужен кран побольше».</dd>
      </div>
      <div>
        <dt>Градостроительные ограничения по адресу</dt>
        <dd>Предельная высота и особые требования регламента, если участок попадает в границы исторического поселения или иную зону с ограничениями.</dd>
      </div>
      <div>
        <dt>Плановые даты работ</dt>
        <dd>Чтобы отсчитать назад время на утверждение ППР и сбор подписей за ознакомление — и назвать честную дату, а не оптимистичную.</dd>
      </div>
    </dl>

    <Sources checked={CHECKED} items={[
      { href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/', label: 'приказ Ростехнадзора №461 от 26.11.2020 (ред. от 16.04.2026) — пп. 157 и 158 про утверждение ППР и ознакомление под подпись' },
      { href: 'https://stroydoc-abv.ru/blogs/rd-11-06-2007/', label: 'карточка РД 11-06-2007: не действует, отменён с 01.01.2021, замена не выпускалась' },
      { href: 'https://docs.cntd.ru/document/553128790', label: 'docs.cntd.ru — приказ об утверждении предмета охраны, границ территории и требований к градостроительным регламентам исторического поселения регионального значения город Краснодар' },
      { href: 'https://kuban.rbc.ru/krasnodar/10/07/2019/5d25dd119a7947829371fcc8', label: 'РБК Краснодар — включение города в перечень исторических поселений и вступление приказа в силу' },
    ]} />

    <StageNext current="proekt-i-ppr" />
  </section>
</main>
</BaseLayout>
