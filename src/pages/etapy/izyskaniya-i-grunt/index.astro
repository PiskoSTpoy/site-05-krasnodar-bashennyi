---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StageStrip from '../../../components/StageStrip.astro';
import StageNext from '../../../components/StageNext.astro';
import Sources from '../../../components/Sources.astro';

// Волна 16. Сюда переехало содержание удалённых /keysy/rabota-na-peschanom-grunte-anapa/
// и /geo/anapa/: рыхлый прибрежный песок и соседство с ООПТ — это вопросы этапа
// изысканий, а не «география» и не «пример задачи».

const title = 'Этап 1. Изыскания и грунт под башенный кран на Кубани';
const description =
  'Что определяют изыскания под башенный кран: категория грунта по сейсмическим свойствам, балл площадки, песок побережья и работа у ООПТ Анапской пересыпи.';
const SITE = 'https://kran-kuban.ru';
const CHECKED = '12 августа 2026 года';

const soils = [
  { cat: 'I категория', what: 'Скальные невыветрелые грунты, плотные крупнообломочные', crane: 'Наиболее благоприятное основание: расчётная сейсмичность площадки ниже, чем средний балл по карте' },
  { cat: 'II категория', what: 'Выветрелые скальные, плотные гравелистые пески', crane: 'Именно для этих «средних» условий даны баллы карт ОСР-2015 — точка отсчёта' },
  { cat: 'III категория', what: 'Рыхлые пески, глинистые грунты мягкой консистенции', crane: 'Типичный случай прибрежной полосы. Основание тяжелее среднего: и по сейсмическому расчёту, и по продавливанию под опорой' },
  { cat: 'IV категория', what: 'Наиболее динамически неустойчивые разновидности, склонные к разжижению', crane: 'Площадка требует отдельного решения по основанию до любого разговора о модели крана' },
];

const faqs = [
  {
    q: 'Нужно ли заказывать изыскания отдельно под кран?',
    a: 'Обычно нет. Для объекта капитального строительства инженерно-геологические изыскания уже выполнены на стадии проектирования здания и входят в состав проектной документации — этих данных о площадке, как правило, достаточно и для расчёта основания крана. Отдельная оценка нужна там, где проекта здания с изысканиями нет вовсе: разовый выезд автокрана на разгрузку, работа на временной площадке, нестандартное основание вроде рыхлого прибрежного песка.',
  },
  {
    q: 'Чем карта сейсмического микрорайонирования лучше таблицы по населённому пункту?',
    a: 'Точностью привязки. Таблица в СП 14.13330.2018 даёт балл для населённого пункта целиком и для средних грунтовых условий, а карта микрорайонирования — для конкретной площадки с её фактическими грунтами. Разница между этими двумя источниками на побережье может составлять целый балл, а балл в сейсмическом расчёте — это двукратное изменение расчётного ускорения.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Этапы работы крана', item: `${SITE}/etapy/` },
    { '@type': 'ListItem', position: 3, name: 'Изыскания и грунт', item: `${SITE}/etapy/izyskaniya-i-grunt/` },
  ],
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/etapy/izyskaniya-i-grunt/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/etapy/">Этапы</a><span aria-hidden="true">/</span><span aria-current="page">Изыскания и грунт</span>
  </nav>

  <div class="wrap"><StageStrip current="izyskaniya-i-grunt" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Этап 1 из 5 · до договора</span>
    <h1>Изыскания и грунт: что стоит под башенным краном</h1>
    <p class="dossier__lead">
      Изыскания определяют категорию грунта площадки — одну из 4 по сейсмическим свойствам, — и от
      неё расчётная сейсмичность сдвигается относительно карт ОСР-2015, где балл дан для средних
      условий II категории. Разница в один балл означает двукратное изменение расчётного ускорения
      под основанием крана, поэтому грунт выясняют до подписания договора, а не после. Башенный кран
      опирается на капитальный фундамент или рельсовый путь и стоит на них месяцами; автокран — на
      выносные опоры через подкладки, но на том же грунте.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Что дают изыскания и чем они установлены</h2>
    <p>
      Инженерно-геологические изыскания определяют фактические характеристики грунта площадки:
      плотность, несущую способность, деформационные свойства, уровень грунтовых вод. Правила
      производства таких работ задаёт СП 446.1325800.2019 «Инженерно-геологические изыскания для
      строительства». Для здания эти данные ложатся в проект фундамента, для крана — в расчёт его
      собственного основания, которое несёт технику не в статике, а в движении: с поворотом стрелы,
      подъёмом груза и ветровой нагрузкой.
    </p>
    <p>
      Сам расчёт несущей способности грунта и давления под опорой делает проектировщик по результатам
      изысканий на конкретном участке — это не та цифра, которую можно взять из статьи или прикинуть
      по типу застройки района. Наша часть начинается там, где грунт встречается с сейсмикой края.
    </p>

    <h2 style="margin:36px 0 18px">Категория грунта сдвигает балл площадки</h2>
    <p>
      Карты общего сейсмического районирования ОСР-2015 в составе СП 14.13330.2018 дают балл для
      средних грунтовых условий — то есть для грунтов II категории по сейсмическим свойствам.
      Реальная площадка почти никогда не «средняя», и её категория меняет расчётную сейсмичность
      относительно карты. Категории различают по скорости распространения поперечных сейсмических
      волн в верхней тридцатиметровой толще: чем мягче и рыхлее грунт, тем сильнее он усиливает
      колебания.
    </p>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Категории грунтов по сейсмическим свойствам и что они значат для крана</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Категория</th><th scope="col" role="columnheader">Что это за грунты</th><th scope="col" role="columnheader">Что это значит для основания крана</th></tr>
        </thead>
        <tbody>
          {soils.map((s) => (
            <tr role="row"><th scope="row" role="rowheader">{s.cat}</th><td role="cell" data-label="Что это за грунты">{s.what}</td><td role="cell" data-label="Что это значит для основания крана">{s.crane}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Практический вывод: «в этом городе восемь баллов» — не исходные данные для проекта монтажа.
      Исходные данные — балл вашей площадки с указанием, откуда он взят. Как из этого получается
      конкретное требование к основанию, разобрано в разделе
      <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны края»</a>.
    </p>

    <h2 style="margin:36px 0 18px">Три источника балла — по убыванию точности</h2>
    <ul>
      <li><b>Карта сейсмического микрорайонирования площадки</b> — самый точный источник, учитывает фактические грунты участка.</li>
      <li><b>Отчёт по инженерным изысканиям объекта</b> — есть у большинства объектов капитального строительства, обычно достаточен.</li>
      <li><b>Список населённых пунктов в СП 14.13330.2018</b> — оценка по городу в целом и по средним грунтам. Годится как ориентир на этапе заявки, но не как основание для расчёта.</li>
    </ul>

    <h2 style="margin:36px 0 18px">Прибрежный песок: почему это отдельный разговор</h2>
    <p>
      На песчаном побережье края — и особенно в Анапе с её широкой пляжевой полосой — основание
      площадки часто попадает как раз в III категорию. Для башенного крана это означает, что балл
      площадки может оказаться выше карты, а значит, тяжелее расчёт фундамента. Для автокрана
      сейсмика вообще ни при чём: у него нет капитального основания, он стоит на выносных опорах, и
      его вопрос — выдержит ли рыхлый песок точечное давление опоры. Неравномерное проседание одной
      опоры на рыхлом песке — реальный сценарий, а не страшилка, поэтому грунт под опоры оценивают
      до установки, и на явно рыхлое основание усиленные подкладки везут заранее, а не после того,
      как техника накренилась.
    </p>
    <p>
      Это два разных вопроса, а не выбор из двух проверок: сейсмический расчёт не спасёт опору,
      уходящую в песок, а подкладки не заменяют расчёт фундамента.
    </p>

    <h2 style="margin:36px 0 18px">Соседство с особо охраняемой территорией</h2>
    <p>
      Анапская пересыпь — песчаная коса между морем и лиманами — имеет статус особо охраняемой
      природной территории, и стройки соседствуют с ней вплотную. Масштаб соседства задаёт курортный
      проект «Новая Анапа»: около 1806 гектаров территории, из которых 1055 гектаров относятся к
      ООПТ пересыпи. Для техники это значит, что маршрут подачи и точки стоянки рядом с охраняемой
      зоной могут требовать отдельного согласования — вопрос, который выясняют на этапе заявки, а не
      по факту прибытия трала к границе участка.
    </p>

    <h2 style="margin:36px 0 18px">Что мы просим на этом этапе</h2>
    <dl class="factline">
      <div>
        <dt>Раздел изысканий или карту СМР</dt>
        <dd>Чтобы балл площадки был взят из документа, а не из среднего по населённому пункту.</dd>
      </div>
      <div>
        <dt>Описание основания площадки</dt>
        <dd>Твёрдое покрытие, уплотнённый грунт, песок, отсыпка. От этого зависит, повезём ли усиленные подкладки и понадобится ли подготовка основания.</dd>
      </div>
      <div>
        <dt>Статус соседних территорий</dt>
        <dd>Соседство с ООПТ, охранными зонами или береговой полосой влияет на маршрут подачи техники и точки стоянки.</dd>
      </div>
    </dl>
  </section>

  <section class="section wrap" id="voprosy-etapa" style="padding-top:0;max-width:820px">
    <h2 style="font-size:var(--d-sm);margin-bottom:16px">Вопросы по этому этапу</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://meganorm.ru/Data2/1/4293728/4293728630.htm', label: 'meganorm.ru — СП 446.1325800.2019, инженерно-геологические изыскания для строительства' },
      { href: 'https://files.stroyinf.ru/Data2/1/4293736/4293736459.htm', label: 'files.stroyinf.ru — СП 14.13330.2018: категории грунтов по сейсмическим свойствам и область применения' },
      { href: 'https://docs.cntd.ru/document/550565571', label: 'docs.cntd.ru — СП 14.13330.2018, карты ОСР-2015' },
      { href: 'https://ru.wikipedia.org/wiki/Анапская_пересыпь', label: 'Анапская пересыпь — статус особо охраняемой природной территории' },
      { href: 'https://www.kommersant.ru/doc/5938345', label: '«Коммерсантъ» — проект «Новая Анапа»: 1806 га, из них 1055 га ООПТ' },
    ]} />

    <StageNext current="izyskaniya-i-grunt" />
  </section>
</main>
</BaseLayout>
