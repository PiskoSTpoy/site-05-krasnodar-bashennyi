---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StageStrip from '../../../components/StageStrip.astro';
import StageNext from '../../../components/StageNext.astro';
import DayBand from '../../../components/DayBand.astro';
import Sources from '../../../components/Sources.astro';

// Волна 16. Сюда переехало содержание удалённых /geo/novorossiysk/,
// /keysy/ostanovka-iz-za-nord-osta/ и страницы услуги «Автокран»: и режим тишины,
// и норд-ост — это ограничения ЭКСПЛУАТАЦИИ, а не свойства города.
// Ветровой норматив как норма принадлежит site-07 по реестру тем сети:
// здесь местное явление и его влияние на график, со ссылкой на владельца темы.

const title = 'Эксплуатация крана: два рабочих окна и ветер побережья';
const description =
  'Рабочий день крана на Кубани: окна 08:00–13:00 и 15:00–23:00 по закону №608-КЗ, длина операции против окна, штрафы и простои из-за новороссийской боры.';
const SITE = 'https://kran-kuban.example';
const CHECKED = '12 августа 2026 года';

// Длительности окон — прямое следствие границ режима тишины по ст. 3.3
// закона №608-КЗ в редакции №5423-КЗ: 08:00–13:00 это 5 часов, 15:00–23:00 — 8 часов,
// в выходные утреннее окно начинается в 10:00 и сжимается до 3 часов.
const ops = [
  { len: 'До 3 часов', weekday: 'Помещается в любое окно', weekend: 'Помещается в любое окно' },
  { len: '3–5 часов', weekday: 'Утреннее окно 08:00–13:00 или вечернее', weekend: 'Только вечернее окно 15:00–23:00' },
  { len: '5–8 часов', weekday: 'Только вечернее окно 15:00–23:00', weekend: 'Только вечернее окно 15:00–23:00' },
  { len: 'Более 8 часов', weekday: 'Не помещается — операцию делят на этапы с безопасной паузой', weekend: 'Не помещается — операцию делят на этапы' },
];

const fines = [
  { who: 'Граждане', sum: '1 000 – 3 000 ₽' },
  { who: 'Должностные лица', sum: '3 000 – 5 000 ₽' },
  { who: 'Юридические лица', sum: '20 000 – 30 000 ₽' },
];

const faqs = [
  {
    q: 'Помещается ли обычная восьмичасовая смена автокрана в рабочее окно?',
    a: 'Целиком — только во второе окно, с 15:00 до 23:00. Если работы начинаются утром, смену разрывает дневной перерыв 13:00–15:00, и техника с оператором простаивают два часа прямо на объекте. Это не запрет, а выбор, который лучше сделать осознанно при согласовании заявки, а не обнаружить в обед на площадке.',
  },
  {
    q: 'Считается ли повседневная работа крана неотложными работами?',
    a: 'Нет. Исключение в статье 3.3 закона №608-КЗ сделано для аварийных и неотложных работ — ликвидации аварий и спасательных мероприятий. Плановые подъёмы, монтаж и демонтаж крана под эту категорию не подпадают и должны укладываться в разрешённые окна наравне с прочими строительными работами.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Этапы работы крана', item: `${SITE}/etapy/` },
    { '@type': 'ListItem', position: 3, name: 'Эксплуатация и режим тишины', item: `${SITE}/etapy/ekspluatatsiya-i-tishina/` },
  ],
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/etapy/ekspluatatsiya-i-tishina/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/etapy/">Этапы</a><span aria-hidden="true">/</span><span aria-current="page">Эксплуатация и режим тишины</span>
  </nav>

  <div class="wrap"><StageStrip current="ekspluatatsiya-i-tishina" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Этап 4 из 5 · месяцы</span>
    <h1>Эксплуатация: рабочий день, разрезанный законом и ветром</h1>
    <p class="dossier__lead">
      Рабочий день крана на Кубани разрезан режимом тишины на два окна: 08:00–13:00 и 15:00–23:00 в
      будни, 10:00–13:00 и 15:00–23:00 в выходные — так статья 3.3 краевого закона №608-КЗ
      действует с 1 марта 2026 года. Непрерывная операция длиннее 5 часов в утреннее окно уже не
      помещается, а на побережье из графика дополнительно вычитается норд-ост — свыше 40 дней в
      году. Обе величины считаются заранее, потому что задним числом они превращаются в срыв срока
      или в штраф.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Два окна вместо рабочего дня</h2>
    <p>
      С 1 марта 2026 года статья 3.3 закона Краснодарского края №608-КЗ «Об административных
      правонарушениях» действует в редакции закона края №5423-КЗ. Режим тишины охватывает 23:00–08:00
      и 13:00–15:00 ежедневно, а в выходные и нерабочие праздничные дни дополнительно 08:00–10:00.
      Земляные, строительные и погрузочно-разгрузочные работы с применением механических средств
      названы в статье прямо. Отсюда рабочие окна: 08:00–13:00 и 15:00–23:00 в будни, 10:00–13:00 и
      15:00–23:00 в выходные.
    </p>
    <p>
      Прежний ориентир «с 7:00 до 23:00» — одно непрерывное окно на весь день — больше не действует, и
      именно на нём спотыкаются подрядчики, приехавшие в край с чужим расписанием в голове. Меняется
      при этом не стоимость смены, а предельная длина непрерывной операции: подъём, который нельзя
      бросить на середине, обязан целиком уместиться в окно.
    </p>
    <DayBand
      rows={[
        { label: 'Будни, пн–пт', allowed: [{ from: 8, to: 13 }, { from: 15, to: 23 }] },
        { label: 'Выходные и праздники', allowed: [{ from: 10, to: 13 }, { from: 15, to: 23 }] },
      ]}
      caption="Терракотовым отмечены часы, когда шумные работы разрешены. Разрыв в середине дня — тот самый перерыв 13:00–15:00, который делает утреннее окно пятичасовым, а в выходные трёхчасовым."
    />

    <h2 style="margin:36px 0 18px">Длина операции против длины окна</h2>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Какая непрерывная операция в какое рабочее окно помещается</caption>
        <thead>
          <tr role="row"><th scope="col" role="columnheader">Непрерывная операция</th><th scope="col" role="columnheader">Будни</th><th scope="col" role="columnheader">Выходные и праздники</th></tr>
        </thead>
        <tbody>
          {ops.map((o) => (
            <tr role="row"><th scope="row" role="rowheader">{o.len}</th><td role="cell" data-label="Будни">{o.weekday}</td><td role="cell" data-label="Выходные и праздники">{o.weekend}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Таблица читается просто: утреннее окно в будни длится пять часов, вечернее — восемь, а в
      выходные утреннее сжимается до трёх. Всё, что длиннее, планируется от конца окна назад, а не от
      начала вперёд.
    </p>

    <h2 style="margin:36px 0 18px">Цена ошибки</h2>
    <div class="rule-table-wrap">
      <table class="rule-table">
        <caption class="sr-only">Административный штраф за нарушение режима тишины по ст. 3.3 закона №608-КЗ</caption>
        <thead><tr><th scope="col">Кто нарушил</th><th scope="col">Штраф по ст. 3.3</th></tr></thead>
        <tbody>
          {fines.map((f) => (
            <tr><th scope="row">{f.who}</th><td>{f.sum}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      При повторном нарушении суммы выше. Практический вывод не про деньги, а про организацию:
      «поработать ещё полчаса» не может быть устной договорённостью между прорабом и крановщиком,
      поэтому согласованное время работ мы фиксируем письменно вместе с заявкой — чтобы у обеих
      сторон был один и тот же график, а не два разных представления о нём.
    </p>
    <p>
      Отдельного, более строгого расписания для курортных городов не существует: статья одна на весь
      край. Разница между Сочи и, скажем, окраиной Краснодара не в часах, а в среде вокруг площадки.
      В высокий сезон, примерно с мая по сентябрь, стройка соседствует с плотной отельной и
      рекреационной инфраструктурой, и вышедшая за окно работа замечается почти сразу: жалоба
      отдыхающих реально превращается в проверку. Поэтому график планируют с запасом от границ окна,
      а не впритык к 08:00, 13:00 или 23:00.
    </p>

    <h2 style="margin:36px 0 18px">Ветер: побережье отбирает дни, а не часы</h2>
    <p>
      Второе ограничение эксплуатации на побережье — новороссийская бора, она же норд-ост. По справке
      Гидрометцентра России боры Новороссийской бухты дуют свыше 40 дней в году, один эпизод длится
      от суток до недели, а на Маркотхском перевале фиксировали порывы до 60 м/с. Это не редкое
      исключение из правил, а регулярный режим, который нельзя «учесть по факту»: дни вынужденного
      простоя закладывают в срок монтажа заранее и отдельной строкой.
    </p>
    <p>
      Такие дни — объективный простой, не по вине заказчика и не по вине подрядчика; мы фиксируем их
      отдельно, а не растворяем в общей сумме за период. Явление это местное: оно рождается на
      Маркотхском хребте над бухтой, и в Краснодаре, Сочи или Анапе резерв графика именно под
      норд-ост не закладывают. Предельная скорость ветра для работы конкретной машины берётся из её
      паспорта и приоритетна над любым общим числом; распространённый ориентир — 15 м/с и 10 м/с при
      подъёме груза с большой парусностью. Наша часть — не сам порог, а то, как местное явление
      ложится на график: бора держится сутками, и остановка здесь измеряется не часами, а днями. Что
      именно в этот момент происходит с самим краном — флюгирование стрелы, противоугонные захваты
      рельсового хода и разбор конкретного эпизода 2012 года — в статье
      <a href="/blog/kran-vo-vremya-nord-osta/" style="color:var(--accent)">«Кран во время норд-оста»</a>.
    </p>
  </section>

  <section class="section wrap" id="voprosy-etapa" style="padding-top:0;max-width:820px">
    <h2 style="font-size:var(--d-sm);margin-bottom:16px">Вопросы по этому этапу</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>

    <Sources checked={CHECKED} items={[
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — закон №5423-КЗ, границы режима тишины с 01.03.2026 и размеры штрафов по ст. 3.3' },
      { href: 'https://gogov.ru/silence-law/krd', label: 'gogov.ru — сводка по закону о тишине в Краснодарском крае' },
      { href: 'https://meteoinfo.ru/glossary/4652-2012-02-11-09-58-19', label: 'Гидрометцентр России — боры Новороссийской бухты: свыше 40 дней в году, до 60 м/с на Маркотхском перевале' },
    ]} />

    <StageNext current="ekspluatatsiya-i-tishina" />
  </section>
</main>
</BaseLayout>
