---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StageStrip from '../../../components/StageStrip.astro';
import StageNext from '../../../components/StageNext.astro';
import Sources from '../../../components/Sources.astro';

// Волна 16. Сюда переехало содержание удалённого /keysy/montazh-v-seysmozone-sochi/
// и часть удалённой страницы услуги «Аренда башенного крана»: что входит в монтаж
// и почему сейсмический расчёт — часть базового проекта, а не платная опция.

const title = 'Монтаж и анкеровка башенного крана: приёмка до подъёма';
const description =
  'Монтаж башенного крана на Кубани: крановый путь по СП 12-103-2002, акт приёмки по РД 22-28-35-99, расчёт основания под сейсмику и роль автокрана.';
const SITE = 'https://kran-kuban.example';
const CHECKED = '12 августа 2026 года';

const acceptance = [
  { what: 'Рельсовый крановый путь', how: 'Акт сдачи-приёмки по рекомендуемой форме РД 22-28-35-99', when: 'До первого движения крана по пути' },
  { what: 'Фундамент под стационарный кран', how: 'Освидетельствование основания — общая федеральная процедура', when: 'До установки секций мачты' },
  { what: 'Готовность крана на площадке', how: 'Подтверждается после монтажа, отдельно от исправности самой машины', when: 'До первого рабочего подъёма' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Этапы работы крана', item: `${SITE}/etapy/` },
    { '@type': 'ListItem', position: 3, name: 'Монтаж и анкеровка', item: `${SITE}/etapy/montazh-i-ankerovka/` },
  ],
};
---
<BaseLayout title={title} description={description} path="/etapy/montazh-i-ankerovka/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/etapy/">Этапы</a><span aria-hidden="true">/</span><span aria-current="page">Монтаж и анкеровка</span>
  </nav>

  <div class="wrap"><StageStrip current="montazh-i-ankerovka" /></div>

  <header class="dossier wrap" style="padding-top:clamp(26px,4vw,40px)">
    <span class="eyebrow">Этап 3 из 5 · дни, а не часы</span>
    <h1>Монтаж и анкеровка: сборка сооружения, а не выгрузка техники</h1>
    <p class="dossier__lead">
      Рельсовый крановый путь принимают актом по форме РД 22-28-35-99 до первого движения крана, а
      технические требования к нему с 1 января 2026 года задаёт ГОСТ 35321-2025. На кубанской
      площадке к ветровому расчёту основания добавляется сейсмический — 0,1g при 7 баллах, 0,2g при
      8 и 0,4g при 9, — и это часть базового проекта монтажа, а не отдельная услуга. Автокран при
      этом нужен внутри монтажа: секции мачты и стрелу поднимает не сам башенный кран.
    </p>
  </header>

  <section class="section wrap prose" style="padding-top:clamp(20px,3vw,28px);max-width:820px">
    <h2 style="margin-bottom:18px">Крановый путь: свод правил и акт</h2>
    <p>
      Башенный кран на рельсовом ходу стоит не на выносных опорах, а на наземном рельсовом крановом
      пути. Технические требования к нему с 1 января 2026 года задаёт ГОСТ 35321-2025 «Краны
      грузоподъёмные. Пути рельсовые крановые наземные», сменивший отменённый с той же даты
      ГОСТ Р 51248-99; практику проектирования, устройства и эксплуатации описывает СП 12-103-2002 «Пути наземные
      рельсовые крановые» — свод правил распространяется на пути башенных и стреловых кранов на
      рельсовом ходу с нагрузкой колеса на рельс до 325 кН. Готовый путь принимается в эксплуатацию
      актом сдачи-приёмки, рекомендуемая форма которого приведена в РД 22-28-35-99 «Конструкция,
      устройство и безопасная эксплуатация рельсовых путей башенных кранов».
    </p>
    <p>
      До подписания акта кран по пути не ездит, каким бы плотным ни выглядел балласт. Это не
      формальность: путь принимается по геометрии и по состоянию основания, а обе характеристики
      на глаз не проверяются.
    </p>
    <div class="rule-table-wrap">
      <table class="rule-table rule-table--stack" role="table">
        <caption class="sr-only">Что принимается документально до первого подъёма</caption>
        <thead><tr role="row"><th scope="col" role="columnheader">Что принимается</th><th scope="col" role="columnheader">Чем подтверждается</th><th scope="col" role="columnheader">Когда</th></tr></thead>
        <tbody>
          {acceptance.map((r) => (
            <tr role="row"><th scope="row" role="rowheader">{r.what}</th><td role="cell" data-label="Чем подтверждается">{r.how}</td><td role="cell" data-label="Когда">{r.when}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:20px">
      Сама процедура освидетельствования проста и одинакова по стране: акт подписывают представители
      заказчика, проектной и монтажной организаций, и фиксирует он соответствие выполненного
      фундамента проекту — отметки, геометрию, армирование, класс бетона. Кубанская часть — не
      процедура, а нагрузка, которую основание обязано выдержать.
    </p>

    <h2 style="margin:36px 0 18px">Сейсмическая нагрузка: рядом с ветровой, а не вместо неё</h2>
    <p>
      Стандартный расчёт устойчивости крана учитывает ветер — это универсальное требование для любого
      региона. На площадке в сейсмической зоне к нему добавляется расчёт на сейсмическое воздействие:
      как поведут себя фундамент и анкеровка при колебаниях грунта. Территориальные строительные
      нормы ТСН 22-302-2000 (СНКК 22-301-2000) «Строительство в сейсмических районах Краснодарского
      края» обязательны для площадок сейсмичностью 7, 8 и 9 баллов; федеральные требования задаёт
      СП 14.13330.2018.
    </p>
    <p>
      Масштаб добавки определяет балл, и растёт он не линейно: пиковое сейсмическое ускорение
      составляет 0,1g при 7 баллах, 0,2g при 8 и 0,4g при 9 на средних грунтах. Каждый балл — это
      удвоение расчётного воздействия, а разница между восемью и девятью баллами — вдвое большая
      горизонтальная нагрузка на анкеровку и фундамент. Как определяется балл именно вашей площадки
      и что меняется в каждой зоне, разобрано в разделе
      <a href="/seysmozony/" style="color:var(--accent)">«Сейсмические зоны края»</a>.
    </p>
    <p>
      Важное следствие для сметы: расчёт основания под сейсмическую нагрузку — не дополнительная
      услуга «для тех, кто спросил», а часть базового проекта монтажа для любой площадки в этой зоне,
      независимо от того, упомянул ли заказчик сейсмичность сам.
    </p>

    <h2 style="margin:36px 0 18px">Автокран внутри монтажа башенного</h2>
    <p>
      Секции мачты, стрелу и противовес поднимает не сам башенный кран — на этапе сборки и разборки
      на площадку выходит автокран. Поэтому автокран на кубанском объекте с башенным краном нужен
      как минимум дважды: на монтаже и на демонтаже. В смете это отдельная строка со своей
      арифметикой — часовая ставка от 4 000 ₽ и восьмичасовая смена как минимальный заказ; посчитать
      её вместе с остальными строками можно в <a href="/#smeta" style="color:var(--accent)">смете владения</a>.
    </p>

    <h2 style="margin:36px 0 18px">Монтаж — тоже шумная работа</h2>
    <p>
      Сборка крана попадает под краевой режим тишины наравне с обычной работой: строительные и
      погрузочно-разгрузочные работы с применением механических средств названы в законе прямо, а
      плановый монтаж не относится к аварийным и неотложным работам, для которых сделано исключение.
      Практически это значит, что операция, которую нельзя бросить на середине, должна целиком
      помещаться в разрешённое окно — подробности и арифметика окон на следующем этапе,
      <a href="/etapy/ekspluatatsiya-i-tishina/" style="color:var(--accent)">«Эксплуатация и режим тишины»</a>.
    </p>

    <Sources checked={CHECKED} items={[
      { href: 'https://base.garant.ru/413264615/', label: 'ГОСТ 35321-2025 — приказ Росстандарта от 17.11.2025 №1400-ст, действует с 01.01.2026 вместо ГОСТ Р 51248-99' },
      { href: 'https://files.stroyinf.ru/Data1/11/11357/index.htm', label: 'files.stroyinf.ru — СП 12-103-2002 «Пути наземные рельсовые крановые»' },
      { href: 'https://files.stroyinf.ru/Data2/1/4293850/4293850237.htm', label: 'files.stroyinf.ru — РД 22-28-35-99, рельсовые пути башенных кранов и форма акта сдачи-приёмки' },
      { href: 'https://files.stroyinf.ru/Data2/1/4293736/4293736459.htm', label: 'files.stroyinf.ru — СП 14.13330.2018: пиковые ускорения 0,1g / 0,2g / 0,4g и область применения 7–9 баллов' },
      { href: 'https://docs.cntd.ru/document/1200025575', label: 'docs.cntd.ru — ТСН 22-302-2000 Краснодарского края' },
      { href: 'https://epp.genproc.gov.ru/ru/proc_23/activity/legal-education/explain/e8476197/', label: 'прокуратура Краснодарского края — режим тишины и перечень попадающих под него работ' },
    ]} />

    <StageNext current="montazh-i-ankerovka" />
  </section>
</main>
</BaseLayout>
