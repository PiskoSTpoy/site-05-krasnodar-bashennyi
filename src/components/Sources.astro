---
// Волна 20. Единый компонент блока «Источники + дата проверки».
// До этой волны один и тот же <p class="sources"> с одинаковой структурой
// (подпись + дата + список ссылок с «;» между пунктами и «.» в конце) был
// от руки скопирован в 12 файлов — разметка идентична, но без единого места
// правки. Стиль уже задан глобально в BaseLayout (.sources — тонкая линия
// сверху, без теней/скруглений/transform, как весь редакционный дизайн-код
// сайта), компонент только собирает разметку и не добавляет своих цветов.
//
// Два режима использования:
//   items   — обычный полный список источников (большинство страниц).
//   seeAlso — короткая форма для хаб-страниц («досье» / оглавление раздела),
//             у которых часть секций дословно пересказывает страницы, где
//             те же источники уже процитированы целиком. Вместо копии
//             полного блока — ссылки на эти страницы плюс место для одной
//             fitting-фразы про сквозные документы (note). Так не задваивается
//             полный блок между /  и /etapy/*/, /seysmozony/ и /seysmozony/*-ballov/.

export interface SourceItem {
  href: string;
  label: string;
}

// Волна 127: атрибуция медиа (фото/видео) — отдельной строкой в том же блоке
// Источников, а не в собственном figcaption рядом с картинкой/видео (так на
// site-01; здесь — по прямому решению для этого сайта, «в существующем блоке
// Sources»). text — честная преамбула («иллюстративная съёмка, не наш
// объект» и т.п.), links — автор/лицензия/страница файла отдельными ссылками,
// в точности как в items/seeAlso — никогда просто вставленный HTML.
export interface MediaCredit {
  text: string;
  links: SourceItem[];
}

export interface Props {
  /** Дата последней проверки фактуры, например '12 августа 2026 года'. */
  checked: string;
  /** Полный список источников. */
  items?: SourceItem[];
  /** Ссылки на страницы, где полный список источников уже есть — вместо копии блока. */
  seeAlso?: SourceItem[];
  /** Короткая приписка после ссылок seeAlso: что общего в цитируемых документах. */
  note?: string;
  /** Атрибуция фото/видео на этой же странице — отдельной строкой после источников норм. */
  media?: MediaCredit;
  /** Подпись перед датой. По умолчанию — «Источники, проверено». */
  label?: string;
  class?: string;
  style?: string;
}

const {
  checked,
  items,
  seeAlso,
  note,
  media,
  label = 'Источники, проверено',
  class: className = '',
  style,
} = Astro.props;
---
<p class:list={['sources', className]} style={style}>
  <b>{label} {checked}:</b>{' '}
  {items && items.map((s, i) => (
    <>{i > 0 && ' '}<a href={s.href} target="_blank" rel="noopener">{s.label}</a>{i === items.length - 1 ? '.' : ';'}</>
  ))}
  {seeAlso && (
    <>
      Источники по каждому пункту целиком — на его странице:{' '}
      {seeAlso.map((s, i) => (
        <>{i > 0 && ', '}<a href={s.href}>{s.label}</a></>
      ))}.
      {note ? <>{' '}{note}</> : null}
    </>
  )}
  {media && (
    <>
      <br />
      {media.text}{' '}
      {media.links.map((s, i) => (
        <>{i > 0 && ', '}<a href={s.href} target="_blank" rel="noopener">{s.label}</a></>
      ))}.
    </>
  )}
</p>
