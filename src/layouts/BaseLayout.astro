    <!-- Два документа о персональных данных — на КАЖДОЙ странице, а не только
         рядом с формой: они и есть точка, куда посетитель идёт проверять, что
         с его телефоном будет дальше. Ссылки раздельные, потому что с
         01.09.2025 согласие не может быть частью политики. -->
    <nav class="footer__legal" aria-label="Персональные данные">
      <a href="/kontakty/">Контакты</a>
      <a href="/politika-obrabotki-personalnyh-dannyh/">Политика обработки ПД</a>
      <a href="/soglasie-na-obrabotku-personalnyh-dannyh/">Согласие на обработку ПД</a>
    </nav>
    <a href="tel:+79099815415">+7 (909) 981-54-15</a>
  </footer>

  <!-- Волна 12: закреплённая CTA-панель для мобильных. Две обычные ссылки, без JS.
       Телефон — тот же, что в шапке и подвале (+7 (909) 981-54-15). -->
  <nav class="mcta" aria-label="Быстрые действия">
    <a class="mcta__btn mcta__btn--primary" href="/#order">Заказать кран</a>
    <a class="mcta__btn mcta__btn--secondary" href="tel:+79099815415">Позвонить</a>
  </nav>
  <script>
    // Волна 16: подсветка активного этапа в боковой шкале лонгрида.
    // Прогрессивное усиление: без JS шкала остаётся обычной якорной навигацией
    // (ссылки на существующие id), подсветка — только визуальный бонус.
    function initRailHighlight() {
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
      if (!links.length || !('IntersectionObserver' in window)) return;
      const targets = links
        .map((a) => document.getElementById(a.dataset.railLink || ''))
        .filter((el): el is HTMLElement => !!el);
      if (!targets.length) return;
      const byId = new Map<string, HTMLAnchorElement[]>();
      links.forEach((a) => {
        const id = a.dataset.railLink || '';
        if (!byId.has(id)) byId.set(id, []);
        byId.get(id)!.push(a);
      });
      const visible = new Set<string>();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const id = (e.target as HTMLElement).id;
            if (!id) return;
            if (e.isIntersecting) visible.add(id);
            else visible.delete(id);
          });
          let activeId: string | null = null;
          let bestTop = Infinity;
          targets.forEach((t) => {
            if (visible.has(t.id)) {
              const top = t.getBoundingClientRect().top;
              if (top < bestTop) { bestTop = top; activeId = t.id; }
            }
          });
          if (!activeId) {
            let prev: HTMLElement | null = null;
            for (const t of targets) {
              if (t.getBoundingClientRect().top < 130) prev = t;
              else break;
            }
            if (prev) activeId = prev.id;
          }
          links.forEach((a) => { a.removeAttribute('data-rail-active'); a.removeAttribute('aria-current'); });
          if (activeId) {
            (byId.get(activeId) || []).forEach((a) => {
              a.setAttribute('data-rail-active', 'true');
              a.setAttribute('aria-current', 'location');
            });
          }
        },
        { rootMargin: '-90px 0px -55% 0px', threshold: [0, 1] }
      );
      targets.forEach((t) => io.observe(t));
    }
    initRailHighlight();

    // Волна 19: прогресс-линия боковой шкалы. Заливка растёт непрерывно —
    // от первого пункта шкалы до последнего — а не скачками по индексу
    // активного этапа, поэтому линия ведёт себя как реальный индикатор
    // прочитанного, а не как переключатель.
    function initRailProgress() {
      const rail = document.querySelector<HTMLElement>('.rail__sticky');
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
      if (!rail || links.length < 2) return;
      const targets = links
        .map((a) => document.getElementById(a.dataset.railLink || ''))
        .filter((el): el is HTMLElement => !!el);
      if (targets.length < 2) return;
      const first = targets[0];
      const last = targets[targets.length - 1];

      function update() {
        const firstTop = first.getBoundingClientRect().top + window.scrollY;
        const lastTop = last.getBoundingClientRect().top + window.scrollY;
        const span = Math.max(1, lastTop - firstTop);
        const raw = (window.scrollY + 130 - firstTop) / span;
        const progress = Math.min(1, Math.max(0, raw));
        rail!.style.setProperty('--rail-progress', String(progress));
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      }
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    }
    initRailProgress();

    // Волна 19: лёгкий скролл-параллакс hero-иллюстрации досье (техника
    // Волны 13-D — прогресс считается от собственного getBoundingClientRect()
    // секции, а не от абсолютного scrollY, поэтому не зависит от высоты шапки).
    // Только вертикальный сдвиг ±11px — «лёгкий» параллакс, без наклона.
    // prefers-reduced-motion проверяется и слушается динамически: если
    // пользователь переключит настройку ОС прямо на открытой странице,
    // эффект включится/выключится без перезагрузки.
    function initHeroParallax() {
      const el = document.querySelector<HTMLElement>('[data-hero-parallax]');
      const section = document.querySelector<HTMLElement>('.dossier');
      if (!el || !section || !('requestAnimationFrame' in window)) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let enabled = false;
      let raf = 0;

      function update() {
        raf = 0;
        const rect = section!.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        // 0 — секция только показалась снизу экрана, 1 — ушла за верх
        const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
        const amplitude = 22;
        const y = (progress - 0.5) * amplitude;
        el!.style.transform = `translateY(${y.toFixed(1)}px)`;
      }
      function onScroll() {
        if (raf) return;
        raf = requestAnimationFrame(update);
      }
      function enable() {
        if (enabled) return;
        enabled = true;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      }
      function disable() {
        if (!enabled) return;
        enabled = false;
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        el!.style.transform = '';
      }
      function sync() {
        if (reduceMotion.matches) disable(); else enable();
      }
      sync();
      reduceMotion.addEventListener('change', sync);
    }
    initHeroParallax();
  </script>
</body>
</html>
